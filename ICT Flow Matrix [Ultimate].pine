// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                      HTF DATA REQUEST                                          ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

f_getHTFTimeframe() =>
    switch i_htfTF
        "Auto" =>
            int tfMins = timeframe.in_seconds() / 60
            tfMins <= 1 ? "5" : tfMins <= 5 ? "15" : tfMins <= 15 ? "60" : tfMins <= 60 ? "240" : tfMins <= 240 ? "D" : "W"
        => i_htfTF

string htfTF = f_getHTFTimeframe()

[htfO, htfH, htfL, htfC, htfTime, htfO1, htfH1, htfL1, htfC1, htfO2, htfH2, htfL2, htfC2] = 
     request.security(syminfo.tickerid, htfTF, 
     [open, high, low, close, time, open[1], high[1], low[1], close[1], open[2], high[2], low[2], close[2]], 
     lookahead=barmerge.lookahead_on)

[htfO3, htfH3, htfL3, htfC3, htfO4, htfH4, htfL4, htfC4, htfO5, htfH5, htfL5, htfC5] = 
     request.security(syminfo.tickerid, htfTF, 
     [open[3], high[3], low[3], close[3], open[4], high[4], low[4], close[4], open[5], high[5], low[5], close[5]], 
     lookahead=barmerge.lookahead_on)

int htfSeconds    = timeframe.in_seconds(htfTF)
int elapsedSecs   = int((timenow - htfTime) / 1000)
int remainingSecs = math.max(0, htfSeconds - elapsedSecs)
string countdownStr = f_formatCountdown(remainingSecs)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                     FVG DETECTION                                              ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

bool bullFVG = low > high[2] and close[1] > open[1] and (low - high[2]) > minSize
bool bearFVG = high < low[2] and close[1] < open[1] and (low[2] - high) > minSize

if i_showFVG and bullFVG
    float _top = low
    float _bot = high[2]
    float _mid = math.avg(_top, _bot)
    int _left  = bar_index - 2
    int _right = bar_index + 3
    
    color bgCol = i_fvgStyle == "Filled" ? color.new(C_BULL, i_zoneTrans) : color.new(C_BULL, 98)
    int borderW = i_fvgStyle == "Border Only" ? 2 : 1
    
    box newBox = box.new(_left, _top, _right, _bot, bgcolor=bgCol, border_color=color.new(C_BULL, 30), border_width=borderW)
    bullFvgBox.push(newBox)
    bullFvgTop.push(_top)
    bullFvgBot.push(_bot)
    bullFvgMit.push(false)
    bullFvgBar.push(_left)
    
    if i_fvgMidLine
        bullFvgMid.push(line.new(_left, _mid, _right, _mid, color=color.new(C_BULL, 50), style=line.style_dotted, width=1))
    else
        bullFvgMid.push(na)
    
    if i_showLabels and i_showZoneLabels
        label.new(_left, _bot, "FVG▲", style=label.style_none, textcolor=color.new(C_BULL, 20), size=f_labelSize(i_labelSize))
    
    bullFvgBox.cleanupBoxes(i_fvgMax)
    if bullFvgTop.size() > i_fvgMax
        bullFvgTop.shift()
        bullFvgBot.shift()
        bullFvgMit.shift()
        bullFvgBar.shift()
        line.delete(bullFvgMid.shift())

if i_showFVG and bearFVG
    float _top = low[2]
    float _bot = high
    float _mid = math.avg(_top, _bot)
    int _left  = bar_index - 2
    int _right = bar_index + 3
    
    color bgCol = i_fvgStyle == "Filled" ? color.new(C_BEAR, i_zoneTrans) : color.new(C_BEAR, 98)
    int borderW = i_fvgStyle == "Border Only" ? 2 : 1
    
    box newBox = box.new(_left, _top, _right, _bot, bgcolor=bgCol, border_color=color.new(C_BEAR, 30), border_width=borderW)
    bearFvgBox.push(newBox)
    bearFvgTop.push(_top)
    bearFvgBot.push(_bot)
    bearFvgMit.push(false)
    bearFvgBar.push(_left)
    
    if i_fvgMidLine
        bearFvgMid.push(line.new(_left, _mid, _right, _mid, color=color.new(C_BEAR, 50), style=line.style_dotted, width=1))
    else
        bearFvgMid.push(na)
    
    if i_showLabels and i_showZoneLabels
        label.new(_left, _top, "FVG▼", style=label.style_none, textcolor=color.new(C_BEAR, 20), size=f_labelSize(i_labelSize))
    
    bearFvgBox.cleanupBoxes(i_fvgMax)
    if bearFvgTop.size() > i_fvgMax
        bearFvgTop.shift()
        bearFvgBot.shift()
        bearFvgMit.shift()
        bearFvgBar.shift()
        line.delete(bearFvgMid.shift())

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                               FVG MITIGATION & iFVG                                            ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

f_checkMitigation(float priceH, float priceL, float priceC, float zoneTop, float zoneBot, bool isBull) =>
    switch i_fvgMitType
        "Wick Touch"   => isBull ? priceL <= zoneBot : priceH >= zoneTop
        "50% (CE)"     => isBull ? priceL <= math.avg(zoneTop, zoneBot) : priceH >= math.avg(zoneTop, zoneBot)
        "Full Close"   => isBull ? priceC < zoneBot : priceC > zoneTop
        => false

if i_showFVG and i_fvgMitTrack and bullFvgBox.size() > 0
    for i = 0 to bullFvgBox.size() - 1
        if i < bullFvgMit.size() and not bullFvgMit.get(i)
            float topLvl = bullFvgTop.get(i)
            float botLvl = bullFvgBot.get(i)
            int origBar  = bullFvgBar.get(i)
            box bx       = bullFvgBox.get(i)
            line midLn   = bullFvgMid.get(i)
            
            if f_checkMitigation(high, low, close, topLvl, botLvl, true)
                bullFvgMit.set(i, true)
                if i_mitEffect
                    bx.set_bgcolor(color.new(C_NEUTRAL, 94))
                    bx.set_border_color(color.new(C_NEUTRAL, 80))
                    if not na(midLn)
                        midLn.set_color(color.new(C_NEUTRAL, 80))
                
                if i_showIFVG and close < botLvl and ifvgBox.size() < i_ifvgMax
                    box ifvg = box.new(origBar, topLvl, bar_index + 5, botLvl, 
                         bgcolor=color.new(C_IFVG, i_zoneTrans), 
                         border_color=C_IFVG, border_width=1, border_style=line.style_dashed)
                    ifvgBox.push(ifvg)
                    ifvgTop.push(topLvl)
                    ifvgBot.push(botLvl)
                    ifvgBull.push(false)
                    ifvgMit.push(false)
                    ifvgBar.push(origBar)
                    ifvgFormed := true
                    if i_showLabels
                        label.new(bar_index, math.avg(topLvl, botLvl), "iFVG▼", style=label.style_none, textcolor=C_IFVG, size=f_labelSize(i_labelSize))
            else if i_fvgExtend
                bx.set_right(bar_index + 3)
                if not na(midLn)
                    midLn.set_x2(bar_index + 3)

if i_showFVG and i_fvgMitTrack and bearFvgBox.size() > 0
    for i = 0 to bearFvgBox.size() - 1
        if i < bearFvgMit.size() and not bearFvgMit.get(i)
            float topLvl = bearFvgTop.get(i)
            float botLvl = bearFvgBot.get(i)
            int origBar  = bearFvgBar.get(i)
            box bx       = bearFvgBox.get(i)
            line midLn   = bearFvgMid.get(i)
            
            if f_checkMitigation(high, low, close, topLvl, botLvl, false)
                bearFvgMit.set(i, true)
                if i_mitEffect
                    bx.set_bgcolor(color.new(C_NEUTRAL, 94))
                    bx.set_border_color(color.new(C_NEUTRAL, 80))
                    if not na(midLn)
                        midLn.set_color(color.new(C_NEUTRAL, 80))
                
                if i_showIFVG and close > topLvl and ifvgBox.size() < i_ifvgMax
                    box ifvg = box.new(origBar, topLvl, bar_index + 5, botLvl, 
                         bgcolor=color.new(C_IFVG, i_zoneTrans), 
                         border_color=C_IFVG, border_width=1, border_style=line.style_dashed)
                    ifvgBox.push(ifvg)
                    ifvgTop.push(topLvl)
                    ifvgBot.push(botLvl)
                    ifvgBull.push(true)
                    ifvgMit.push(false)
                    ifvgBar.push(origBar)
                    ifvgFormed := true
                    if i_showLabels
                        label.new(bar_index, math.avg(topLvl, botLvl), "iFVG▲", style=label.style_none, textcolor=C_IFVG, size=f_labelSize(i_labelSize))
            else if i_fvgExtend
                bx.set_right(bar_index + 3)
                if not na(midLn)
                    midLn.set_x2(bar_index + 3)

// iFVG Management
if i_showIFVG and ifvgBox.size() > 0
    for i = 0 to ifvgBox.size() - 1
        if i < ifvgMit.size() and not ifvgMit.get(i)
            bool isBull  = ifvgBull.get(i)
            float topLvl = ifvgTop.get(i)
            float botLvl = ifvgBot.get(i)
            box bx       = ifvgBox.get(i)
            if not na(bx)
                bool shouldMit = isBull ? low <= botLvl : high >= topLvl
                if shouldMit
                    ifvgMit.set(i, true)
                    if i_mitEffect
                        bx.set_bgcolor(color.new(C_NEUTRAL, 95))
                        bx.set_border_color(color.new(C_NEUTRAL, 80))
                else
                    bx.set_right(bar_index + 5)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    ORDER BLOCK DETECTION                                       ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

bool bullishImpulse = true
bool bearishImpulse = true

for j = 1 to i_obStrength
    if close[j] <= open[j]
        bullishImpulse := false
    if close[j] >= open[j]
        bearishImpulse := false

bool lastBearish   = close[i_obStrength + 1] < open[i_obStrength + 1]
bool lastBullish   = close[i_obStrength + 1] > open[i_obStrength + 1]
bool volumeConfirm = not i_obVolFilter or volume[i_obStrength + 1] > avgVolume[i_obStrength + 1]

bool bullOB = bullishImpulse and lastBearish and close > high[i_obStrength + 1] and volumeConfirm
bool bearOB = bearishImpulse and lastBullish and close < low[i_obStrength + 1] and volumeConfirm

// Create Bullish OB
if i_showOB and bullOB
    int obBar    = bar_index - i_obStrength - 1
    float _top   = high[i_obStrength + 1]
    float _bot   = low[i_obStrength + 1]
    float _mid   = math.avg(_top, _bot)
    int _right   = bar_index + 4
    
    color bgCol = i_obStyle == "Filled" ? color.new(C_OB, i_zoneTrans) : color.new(C_OB, 98)
    int borderW = i_obStyle == "Border Only" ? 2 : 1
    
    box newBox = box.new(obBar, _top, _right, _bot, bgcolor=bgCol, border_color=color.new(C_OB, 25), border_width=borderW)
    bullOBBox.push(newBox)
    bullOBTop.push(_top)
    bullOBBot.push(_bot)
    bullOBMit.push(false)
    bullOBBar.push(obBar)
    
    if i_obMidLine
        bullOBMid.push(line.new(obBar, _mid, _right, _mid, color=color.new(C_OB, 50), style=line.style_dashed, width=1))
    else
        bullOBMid.push(na)
    
    if i_showLabels and i_showZoneLabels
        label.new(obBar, _bot, "OB▲", style=label.style_none, textcolor=color.new(C_OB, 15), size=f_labelSize(i_labelSize))
    
    bullOBBox.cleanupBoxes(i_obMax)
    if bullOBTop.size() > i_obMax
        bullOBTop.shift()
        bullOBBot.shift()
        bullOBMit.shift()
        bullOBBar.shift()
        line.delete(bullOBMid.shift())

// Create Bearish OB - FIXED
if i_showOB and bearOB
    int obBar    = bar_index - i_obStrength - 1
    float _top   = high[i_obStrength + 1]
    float _bot   = low[i_obStrength + 1]
    float _mid   = math.avg(_top, _bot)
    int _right   = bar_index + 4
    
    color obBearCol = C_BEAR  // Changed from color.orange to theme color
    color bgCol = i_obStyle == "Filled" ? color.new(obBearCol, i_zoneTrans) : color.new(obBearCol, 98)
    int borderW = i_obStyle == "Border Only" ? 2 : 1
    
    box newBox = box.new(obBar, _top, _right, _bot, bgcolor=bgCol, border_color=color.new(obBearCol, 25), border_width=borderW)
    bearOBBox.push(newBox)
    bearOBTop.push(_top)
    bearOBBot.push(_bot)
    bearOBMit.push(false)
    bearOBBar.push(obBar)
    
    if i_obMidLine
        bearOBMid.push(line.new(obBar, _mid, _right, _mid, color=color.new(obBearCol, 50), style=line.style_dashed, width=1))
    else
        bearOBMid.push(na)
    
    if i_showLabels and i_showZoneLabels
        label.new(obBar, _top, "OB▼", style=label.style_none, textcolor=color.new(obBearCol, 15), size=f_labelSize(i_labelSize))
    
    bearOBBox.cleanupBoxes(i_obMax)
    if bearOBTop.size() > i_obMax
        bearOBTop.shift()
        bearOBBot.shift()
        bearOBMit.shift()
        bearOBBar.shift()
        line.delete(bearOBMid.shift())

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                              OB MITIGATION & BREAKER CREATION                                  ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

// Bullish OB Mitigation
if i_showOB and bullOBBox.size() > 0
    for i = 0 to bullOBBox.size() - 1
        if i < bullOBMit.size() and not bullOBMit.get(i)
            float botLvl = bullOBBot.get(i)
            float topLvl = bullOBTop.get(i)
            int obBar    = bullOBBar.get(i)
            box bx       = bullOBBox.get(i)
            line midLn   = bullOBMid.get(i)
            
            if low <= botLvl
                bullOBMit.set(i, true)
                if i_mitEffect
                    bx.set_bgcolor(color.new(C_NEUTRAL, 95))
                    bx.set_border_color(color.new(C_NEUTRAL, 80))
                    if not na(midLn)
                        midLn.set_color(color.new(C_NEUTRAL, 80))
                
                // Create Bearish Breaker
                if i_showBB and bearBBBox.size() < i_bbMax
                    box bbBox = box.new(obBar, topLvl, bar_index + 6, botLvl, 
                         bgcolor=color.new(C_BB, i_zoneTrans), 
                         border_color=C_BB, border_width=1, border_style=line.style_dashed)
                    bearBBBox.push(bbBox)
                    bearBBTop.push(topLvl)
                    bearBBBot.push(botLvl)
                    bearBBMit.push(false)
                    bearBreakerFormed := true
                    if i_showLabels
                        label.new(bar_index, math.avg(topLvl, botLvl), "BB▼", style=label.style_none, textcolor=C_BB, size=f_labelSize(i_labelSize))
            else if i_obExtend
                bx.set_right(bar_index + 4)
                if not na(midLn)
                    midLn.set_x2(bar_index + 4)

// Bearish OB Mitigation
if i_showOB and bearOBBox.size() > 0
    for i = 0 to bearOBBox.size() - 1
        if i < bearOBMit.size() and not bearOBMit.get(i)
            float topLvl = bearOBTop.get(i)
            float botLvl = bearOBBot.get(i)
            int obBar    = bearOBBar.get(i)
            box bx       = bearOBBox.get(i)
            line midLn   = bearOBMid.get(i)
            
            if high >= topLvl
                bearOBMit.set(i, true)
                if i_mitEffect
                    bx.set_bgcolor(color.new(C_NEUTRAL, 95))
                    bx.set_border_color(color.new(C_NEUTRAL, 80))
                    if not na(midLn)
                        midLn.set_color(color.new(C_NEUTRAL, 80))
                
                // Create Bullish Breaker
                if i_showBB and bullBBBox.size() < i_bbMax
                    box bbBox = box.new(obBar, topLvl, bar_index + 6, botLvl, 
                         bgcolor=color.new(C_BB, i_zoneTrans), 
                         border_color=C_BB, border_width=1, border_style=line.style_dashed)
                    bullBBBox.push(bbBox)
                    bullBBTop.push(topLvl)
                    bullBBBot.push(botLvl)
                    bullBBMit.push(false)
                    bullBreakerFormed := true
                    if i_showLabels
                        label.new(bar_index, math.avg(topLvl, botLvl), "BB▲", style=label.style_none, textcolor=C_BB, size=f_labelSize(i_labelSize))
            else if i_obExtend
                bx.set_right(bar_index + 4)
                if not na(midLn)
                    midLn.set_x2(bar_index + 4)

// Breaker Block Management
if i_showBB and bullBBBox.size() > 0
    for i = 0 to bullBBBox.size() - 1
        if i < bullBBMit.size() and not bullBBMit.get(i)
            box bx = bullBBBox.get(i)
            if not na(bx)
                if low < bullBBBot.get(i)
                    bullBBMit.set(i, true)
                    if i_mitEffect
                        bx.set_bgcolor(color.new(C_NEUTRAL, 95))
                        bx.set_border_color(color.new(C_NEUTRAL, 80))
                else
                    bx.set_right(bar_index + 6)

if i_showBB and bearBBBox.size() > 0
    for i = 0 to bearBBBox.size() - 1
        if i < bearBBMit.size() and not bearBBMit.get(i)
            box bx = bearBBBox.get(i)
            if not na(bx)
                if high > bearBBTop.get(i)
                    bearBBMit.set(i, true)
                    if i_mitEffect
                        bx.set_bgcolor(color.new(C_NEUTRAL, 95))
                        bx.set_border_color(color.new(C_NEUTRAL, 80))
                else
                    bx.set_right(bar_index + 6)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    REJECTION BLOCKS                                            ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

bool bullRejection = lowerWick >= bodySize * i_rbWickRatio and lowerWick > upperWick * 2 and bodySize > 0
bool bearRejection = upperWick >= bodySize * i_rbWickRatio and upperWick > lowerWick * 2 and bodySize > 0

if i_showRB and bullRejection
    float _top = math.min(close, open)
    float _bot = low
    box rbBox = box.new(bar_index, _top, bar_index + 4, _bot, 
         bgcolor=color.new(C_BULL, i_zoneTrans + 3), 
         border_color=color.new(C_BULL, 40), border_width=1)
    bullRBBox.push(rbBox)
    bullRBTop.push(_top)
    bullRBBot.push(_bot)
    bullRBMit.push(false)
    if i_showLabels and i_showZoneLabels
        label.new(bar_index, _bot, "RB▲", style=label.style_none, textcolor=C_BULL, size=f_labelSize(i_labelSize))
    bullRBBox.cleanupBoxes(i_rbMax)
    if bullRBTop.size() > i_rbMax
        bullRBTop.shift()
        bullRBBot.shift()
        bullRBMit.shift()

if i_showRB and bearRejection
    float _top = high
    float _bot = math.max(close, open)
    box rbBox = box.new(bar_index, _top, bar_index + 4, _bot, 
         bgcolor=color.new(C_BEAR, i_zoneTrans + 3), 
         border_color=color.new(C_BEAR, 40), border_width=1)
    bearRBBox.push(rbBox)
    bearRBTop.push(_top)
    bearRBBot.push(_bot)
    bearRBMit.push(false)
    if i_showLabels and i_showZoneLabels
        label.new(bar_index, _top, "RB▼", style=label.style_none, textcolor=C_BEAR, size=f_labelSize(i_labelSize))
    bearRBBox.cleanupBoxes(i_rbMax)
    if bearRBTop.size() > i_rbMax
        bearRBTop.shift()
        bearRBBot.shift()
        bearRBMit.shift()

// RB Management
if i_showRB and bullRBBox.size() > 0
    for i = 0 to bullRBBox.size() - 1
        if i < bullRBMit.size() and not bullRBMit.get(i)
            box bx = bullRBBox.get(i)
            if not na(bx)
                if low < bullRBBot.get(i)
                    bullRBMit.set(i, true)
                    if i_mitEffect
                        bx.set_bgcolor(color.new(C_NEUTRAL, 95))
                else
                    bx.set_right(bar_index + 4)

if i_showRB and bearRBBox.size() > 0
    for i = 0 to bearRBBox.size() - 1
        if i < bearRBMit.size() and not bearRBMit.get(i)
            box bx = bearRBBox.get(i)
            if not na(bx)
                if high > bearRBTop.get(i)
                    bearRBMit.set(i, true)
                    if i_mitEffect
                        bx.set_bgcolor(color.new(C_NEUTRAL, 95))
                else
                    bx.set_right(bar_index + 4)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    VOLUME IMBALANCE                                            ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

bool vimbUp = open > close[1] and close[1] < open[1] and close > open and (open - close[1]) > minSize
bool vimbDn = open < close[1] and close[1] > open[1] and close < open and (close[1] - open) > minSize

if i_showVIMB and vimbUp
    float _top = open
    float _bot = close[1]
    box newBox = box.new(bar_index - 1, _top, bar_index + 3, _bot, 
         bgcolor=color.new(C_VIMB, i_zoneTrans), 
         border_color=C_VIMB, border_width=1, border_style=line.style_dashed)
    vimbBox.push(newBox)
    vimbTop.push(_top)
    vimbBot.push(_bot)
    vimbMit.push(false)
    vimbBull.push(true)
    if i_showLabels and i_showZoneLabels
        label.new(bar_index - 1, _bot, "VI▲", style=label.style_none, textcolor=C_VIMB, size=f_labelSize(i_labelSize))
    vimbBox.cleanupBoxes(i_vimbMax)
    if vimbTop.size() > i_vimbMax
        vimbTop.shift()
        vimbBot.shift()
        vimbMit.shift()
        vimbBull.shift()

if i_showVIMB and vimbDn
    float _top = close[1]
    float _bot = open
    box newBox = box.new(bar_index - 1, _top, bar_index + 3, _bot, 
         bgcolor=color.new(C_VIMB, i_zoneTrans), 
         border_color=C_VIMB, border_width=1, border_style=line.style_dashed)
    vimbBox.push(newBox)
    vimbTop.push(_top)
    vimbBot.push(_bot)
    vimbMit.push(false)
    vimbBull.push(false)
    if i_showLabels and i_showZoneLabels
        label.new(bar_index - 1, _top, "VI▼", style=label.style_none, textcolor=C_VIMB, size=f_labelSize(i_labelSize))
    vimbBox.cleanupBoxes(i_vimbMax)
    if vimbTop.size() > i_vimbMax
        vimbTop.shift()
        vimbBot.shift()
        vimbMit.shift()
        vimbBull.shift()

// VIMB Management
if i_showVIMB and vimbBox.size() > 0
    for i = 0 to vimbBox.size() - 1
        if i < vimbMit.size() and not vimbMit.get(i)
            bool isBull  = vimbBull.get(i)
            float topLvl = vimbTop.get(i)
            float botLvl = vimbBot.get(i)
            box bx       = vimbBox.get(i)
            if not na(bx)
                bool shouldMit = isBull ? low <= botLvl : high >= topLvl
                if shouldMit
                    vimbMit.set(i, true)
                    if i_mitEffect
                        bx.set_bgcolor(color.new(C_NEUTRAL, 94))
                        bx.set_border_color(color.new(C_NEUTRAL, 75))
                else
                    bx.set_right(bar_index + 3)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    EQUAL HIGHS / LOWS                                          ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

// EQH Detection
if i_showEQHL and not na(swingHighEQ)
    int currentBar = bar_index - 5
    bool foundMatch = false
    
    if eqhPrice.size() > 0
        for i = 0 to eqhPrice.size() - 1
            if i < eqhSwept.size() and not eqhSwept.get(i) and math.abs(swingHighEQ - eqhPrice.get(i)) <= tolerance
                if not eqhConfirmed.get(i)
                    eqhConfirmed.set(i, true)
                    line ln = eqhLine.get(i)
                    if not na(ln)
                        ln.set_style(line.style_solid)
                        ln.set_width(2)
                        ln.set_color(C_EQ)
                foundMatch := true
                break
    
    if not foundMatch
        line newLn = line.new(currentBar, swingHighEQ, bar_index + 12, swingHighEQ, 
             color=color.new(C_EQ, 45), style=line.style_dotted, width=1)
        eqhLine.push(newLn)
        eqhPrice.push(swingHighEQ)
        eqhSwept.push(false)
        eqhConfirmed.push(false)
        if i_showLabels
            label.new(bar_index + 14, swingHighEQ, "EQH", style=label.style_none, textcolor=C_EQ, size=f_labelSize(i_labelSize))
        eqhLine.cleanupLines(i_eqhlMax)
        if eqhPrice.size() > i_eqhlMax
            eqhPrice.shift()
            eqhSwept.shift()
            eqhConfirmed.shift()

// EQL Detection
if i_showEQHL and not na(swingLowEQ)
    int currentBar = bar_index - 5
    bool foundMatch = false
    
    if eqlPrice.size() > 0
        for i = 0 to eqlPrice.size() - 1
            if i < eqlSwept.size() and not eqlSwept.get(i) and math.abs(swingLowEQ - eqlPrice.get(i)) <= tolerance
                if not eqlConfirmed.get(i)
                    eqlConfirmed.set(i, true)
                    line ln = eqlLine.get(i)
                    if not na(ln)
                        ln.set_style(line.style_solid)
                        ln.set_width(2)
                        ln.set_color(C_EQ)
                foundMatch := true
                break
    
    if not foundMatch
        line newLn = line.new(currentBar, swingLowEQ, bar_index + 12, swingLowEQ, 
             color=color.new(C_EQ, 45), style=line.style_dotted, width=1)
        eqlLine.push(newLn)
        eqlPrice.push(swingLowEQ)
        eqlSwept.push(false)
        eqlConfirmed.push(false)
        if i_showLabels
            label.new(bar_index + 14, swingLowEQ, "EQL", style=label.style_none, textcolor=C_EQ, size=f_labelSize(i_labelSize))
        eqlLine.cleanupLines(i_eqhlMax)
        if eqlPrice.size() > i_eqhlMax
            eqlPrice.shift()
            eqlSwept.shift()
            eqlConfirmed.shift()

// EQH/EQL Sweep Detection
if i_showEQHL and eqhLine.size() > 0
    for i = 0 to eqhLine.size() - 1
        if i < eqhSwept.size() and not eqhSwept.get(i)
            line ln = eqhLine.get(i)
            if high > eqhPrice.get(i)
                eqhSwept.set(i, true)
                if not na(ln)
                    ln.set_color(color.new(C_NEUTRAL, 80))
                    ln.set_x2(bar_index)
                eqhSweptAlert := true
            else if not na(ln)
                ln.set_x2(bar_index + 12)

if i_showEQHL and eqlLine.size() > 0
    for i = 0 to eqlLine.size() - 1
        if i < eqlSwept.size() and not eqlSwept.get(i)
            line ln = eqlLine.get(i)
            if low < eqlPrice.get(i)
                eqlSwept.set(i, true)
                if not na(ln)
                    ln.set_color(color.new(C_NEUTRAL, 80))
                    ln.set_x2(bar_index)
                eqlSweptAlert := true
            else if not na(ln)
                ln.set_x2(bar_index + 12)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    LIQUIDITY LEVELS                                            ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

// BSL Creation
if i_showLiq and not na(pivotHi)
    int _bar = bar_index - i_liqSwingLen
    line newLn = line.new(_bar, pivotHi, bar_index + 8, pivotHi, 
         color=color.new(C_BULL, 50), style=line.style_dotted, width=1)
    bslLine.push(newLn)
    bslPrice.push(pivotHi)
    bslSwept.push(false)
    bslLine.cleanupLines(i_liqMax)
    if bslPrice.size() > i_liqMax
        bslPrice.shift()
        bslSwept.shift()

// SSL Creation
if i_showLiq and not na(pivotLo)
    int _bar = bar_index - i_liqSwingLen
    line newLn = line.new(_bar, pivotLo, bar_index + 8, pivotLo, 
         color=color.new(C_BEAR, 50), style=line.style_dotted, width=1)
    sslLine.push(newLn)
    sslPrice.push(pivotLo)
    sslSwept.push(false)
    sslLine.cleanupLines(i_liqMax)
    if sslPrice.size() > i_liqMax
        sslPrice.shift()
        sslSwept.shift()

// Liquidity Sweep Detection
if i_showLiq and bslLine.size() > 0
    for i = 0 to bslLine.size() - 1
        if i < bslSwept.size() and not bslSwept.get(i)
            line ln = bslLine.get(i)
            if high > bslPrice.get(i)
                bslSwept.set(i, true)
                if not na(ln)
                    ln.set_color(color.new(C_NEUTRAL, 80))
                    ln.set_x2(bar_index)
                bslSweptAlert := true
            else if not na(ln)
                ln.set_x2(bar_index + 8)

if i_showLiq and sslLine.size() > 0
    for i = 0 to sslLine.size() - 1
        if i < sslSwept.size() and not sslSwept.get(i)
            line ln = sslLine.get(i)
            if low < sslPrice.get(i)
                sslSwept.set(i, true)
                if not na(ln)
                    ln.set_color(color.new(C_NEUTRAL, 80))
                    ln.set_x2(bar_index)
                sslSweptAlert := true
            else if not na(ln)
                ln.set_x2(bar_index + 8)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    MARKET STRUCTURE                                            ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

if i_showMSS
    if not na(mssPivotHi)
        mssSwingH := mssPivotHi
        mssSwingHBar := bar_index - i_mssLen
    
    if not na(mssPivotLo)
        mssSwingL := mssPivotLo
        mssSwingLBar := bar_index - i_mssLen
    
    // Bullish MSS
    if mssDirection <= 0 and not na(mssSwingH) and close > mssSwingH
        bullMSS := true
        mssDirection := 1
        line.new(f_clampBar(mssSwingHBar), mssSwingH, bar_index, mssSwingH, color=C_BULL, width=2)
        if i_showLabels
            label.new(bar_index, mssSwingH, "MSS▲", style=label.style_label_down, textcolor=color.white, color=color.new(C_BULL, 70), size=size.tiny)
    
    // Bearish MSS
    if mssDirection >= 0 and not na(mssSwingL) and close < mssSwingL
        bearMSS := true
        mssDirection := -1
        line.new(f_clampBar(mssSwingLBar), mssSwingL, bar_index, mssSwingL, color=C_BEAR, width=2)
        if i_showLabels
            label.new(bar_index, mssSwingL, "MSS▼", style=label.style_label_up, textcolor=color.white, color=color.new(C_BEAR, 70), size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                  STRUCTURE TRACKING & OTE                                      ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

if not na(pivotHi)
    structHi := pivotHi
    structHiBar := bar_index - i_liqSwingLen

if not na(pivotLo)
    structLo := pivotLo
    structLoBar := bar_index - i_liqSwingLen

// Calculate OTE Zone (61.8% - 79% Retracement) - CORRECTED
if not na(structHi) and not na(structLo) and structHi > structLo
    float rng = structHi - structLo
    if mssDirection >= 0  // Bullish - looking for discount entries
        oteBot := structLo + rng * 0.21
        oteMid := structLo + rng * 0.295
        oteTop := structLo + rng * 0.382
    else  // Bearish - looking for premium entries
        oteBot := structLo + rng * 0.618
        oteMid := structLo + rng * 0.705
        oteTop := structLo + rng * 0.79

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    SESSION TRACKING                                            ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

if isNewWeek
    weeklyOpen := open
    weeklyBar := bar_index

if isNewMonth
    monthlyOpen := open
    monthlyBar := bar_index

if isNewDay
    dailyOpen := open
    dailyBar := bar_index

// Previous H/L tracking
if isNewDay
    pdh := currDayH
    pdl := currDayL
    currDayH := high
    currDayL := low
else
    currDayH := math.max(nz(currDayH, high), high)
    currDayL := math.min(nz(currDayL, low), low)

if isNewWeek
    pwh := currWeekH
    pwl := currWeekL
    currWeekH := high
    currWeekL := low
else
    currWeekH := math.max(nz(currWeekH, high), high)
    currWeekL := math.min(nz(currWeekL, low), low)

if isNewMonth
    pmh := currMonthH
    pml := currMonthL
    currMonthH := high
    currMonthL := low
else
    currMonthH := math.max(nz(currMonthH, high), high)
    currMonthL := math.min(nz(currMonthL, low), low)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    KILLZONE SESSIONS                                           ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

// Asia
if i_showKZ and i_showAsia
    if inAsia
        if not wasInAsia
            wasInAsia := true
            asiaH := high
            asiaL := low
            asiaStartBar := bar_index
            box.delete(asiaBox)
            if i_kzBoxes
                asiaBox := box.new(bar_index, high, bar_index, low, 
                     bgcolor=color.new(C_ASIA, i_zoneTrans + 5), 
                     border_color=color.new(C_ASIA, 50), border_width=1)
        else
            asiaH := math.max(asiaH, high)
            asiaL := math.min(asiaL, low)
            if i_kzBoxes and not na(asiaBox)
                asiaBox.set_right(bar_index)
                asiaBox.set_top(asiaH)
                asiaBox.set_bottom(asiaL)
    else
        wasInAsia := false

// London
if i_showKZ and i_showLondon
    if inLondon
        if not wasInLondon
            wasInLondon := true
            londonH := high
            londonL := low
            londonStartBar := bar_index
            box.delete(londonBox)
            if i_kzBoxes
                londonBox := box.new(bar_index, high, bar_index, low, 
                     bgcolor=color.new(C_LONDON, i_zoneTrans + 5), 
                     border_color=color.new(C_LONDON, 50), border_width=1)
        else
            londonH := math.max(londonH, high)
            londonL := math.min(londonL, low)
            if i_kzBoxes and not na(londonBox)
                londonBox.set_right(bar_index)
                londonBox.set_top(londonH)
                londonBox.set_bottom(londonL)
    else
        wasInLondon := false

// NY AM
if i_showKZ and i_showNYAM
    if inNYAM
        if not wasInNYAM
            wasInNYAM := true
            nyamH := high
            nyamL := low
            nyamStartBar := bar_index
            box.delete(nyamBox)
            if i_kzBoxes
                nyamBox := box.new(bar_index, high, bar_index, low, 
                     bgcolor=color.new(C_NY, i_zoneTrans + 5), 
                     border_color=color.new(C_NY, 50), border_width=1)
        else
            nyamH := math.max(nyamH, high)
            nyamL := math.min(nyamL, low)
            if i_kzBoxes and not na(nyamBox)
                nyamBox.set_right(bar_index)
                nyamBox.set_top(nyamH)
                nyamBox.set_bottom(nyamL)
    else
        wasInNYAM := false

// NY PM
if i_showKZ and i_showNYPM
    if inNYPM
        if not wasInNYPM
            wasInNYPM := true
            nypmH := high
            nypmL := low
            nypmStartBar := bar_index
            box.delete(nypmBox)
            if i_kzBoxes
                nypmBox := box.new(bar_index, high, bar_index, low, 
                     bgcolor=color.new(C_IFVG, i_zoneTrans + 5), 
                     border_color=color.new(C_IFVG, 50), border_width=1)
        else
            nypmH := math.max(nypmH, high)
            nypmL := math.min(nypmL, low)
            if i_kzBoxes and not na(nypmBox)
                nypmBox.set_right(bar_index)
                nypmBox.set_top(nypmH)
                nypmBox.set_bottom(nypmL)
    else
        wasInNYPM := false

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                  DEALING RANGE TRACKING                                        ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

int barsIn21D = timeframe.isintraday ? math.min(int(1440 / timeframe.multiplier) * 21, 5000) : 21
int barsIn3D  = timeframe.isintraday ? math.min(int(1440 / timeframe.multiplier) * 3, 5000) : 3
float dr21H   = ta.highest(high, math.min(barsIn21D, i_historyBars))
float dr21L   = ta.lowest(low, math.min(barsIn21D, i_historyBars))
float dr3H    = ta.highest(high, math.min(barsIn3D, i_historyBars))
float dr3L    = ta.lowest(low, math.min(barsIn3D, i_historyBars))

// Daily DR
if isNewDay
    dr1H := high
    dr1L := low
    dr1StartBar := bar_index
else
    dr1H := math.max(nz(dr1H, high), high)
    dr1L := math.min(nz(dr1L, low), low)

// Session DRs
if inAsia
    if not inAsia[1]
        drAsiaH := high
        drAsiaL := low
        drAsiaStartBar := bar_index
        drAsiaComplete := false
    else
        drAsiaH := math.max(drAsiaH, high)
        drAsiaL := math.min(drAsiaL, low)
else if inAsia[1]
    drAsiaComplete := true

if inLondon
    if not inLondon[1]
        drLdnH := high
        drLdnL := low
        drLdnStartBar := bar_index
        drLdnComplete := false
    else
        drLdnH := math.max(drLdnH, high)
        drLdnL := math.min(drLdnL, low)
else if inLondon[1]
    drLdnComplete := true

if inNY
    if not (inNYAM[1] or inNYPM[1])
        drNyH := high
        drNyL := low
        drNyStartBar := bar_index
        drNyComplete := false
    else
        drNyH := math.max(drNyH, high)
        drNyL := math.min(drNyL, low)
else if inNYAM[1] or inNYPM[1]
    drNyComplete := true

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    ICT MACRO TIMES DRAWING                                     ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

if i_showMacros
    float atrOffset = ta.atr(14) * 0.5
    
    // Macro just started
    if inAnyMacro and not wasInMacro
        macroStartBar := bar_index
        macroSessionHigh := high
        macroSessionLow := low
        
        float bracketY = high + atrOffset * 5
        
        // Background style
        if i_macroStyle == "Background" or i_macroStyle == "Both"
            box newBg = box.new(bar_index, high + atrOffset * 7, bar_index, low - atrOffset * 2, 
                 bgcolor=color.new(i_macroColor, i_macroBgTrans), border_color=na)
            macroBoxes.push(newBg)
        
        // Bracket style
        if i_macroStyle == "Brackets" or i_macroStyle == "Both"
            line leftBracket = line.new(bar_index, high + atrOffset, bar_index, bracketY, color=i_macroColor, width=1)
            macroLines.push(leftBracket)
            line topLine = line.new(bar_index, bracketY, bar_index, bracketY, color=i_macroColor, width=1)
            macroLines.push(topLine)
        
        // Label
        if i_macroLabels
            string lblTxt = i_macroShowTime ? "MACRO\n" + currentMacroLbl : "MACRO"
            label macroLbl = label.new(bar_index, bracketY, lblTxt, 
                 style=label.style_label_down, color=color.new(i_macroColor, 85), 
                 textcolor=i_macroColor, size=size.small)
            macroLabels.push(macroLbl)
    
    // During macro - update
    if inAnyMacro and wasInMacro
        macroSessionHigh := math.max(macroSessionHigh, high)
        macroSessionLow := math.min(macroSessionLow, low)
        
        float bracketY = macroSessionHigh + atrOffset * 5
        
        // Update background box
        if (i_macroStyle == "Background" or i_macroStyle == "Both") and macroBoxes.size() > 0
            box lastBox = macroBoxes.get(macroBoxes.size() - 1)
            lastBox.set_right(bar_index)
            lastBox.set_top(macroSessionHigh + atrOffset * 7)
            lastBox.set_bottom(macroSessionLow - atrOffset * 2)
        
        // Update bracket lines
        if (i_macroStyle == "Brackets" or i_macroStyle == "Both") and macroLines.size() >= 2
            int sz = macroLines.size()
            line leftBracket = macroLines.get(sz - 2)
            leftBracket.set_y1(macroSessionHigh + atrOffset)
            leftBracket.set_y2(bracketY)
            line topLine = macroLines.get(sz - 1)
            topLine.set_x2(bar_index)
            topLine.set_y1(bracketY)
            topLine.set_y2(bracketY)
        
        // Update label
        if i_macroLabels and macroLabels.size() > 0
            label lastLbl = macroLabels.get(macroLabels.size() - 1)
            int midX = int(math.avg(macroStartBar, bar_index))
            lastLbl.set_x(midX)
            lastLbl.set_y(bracketY)
    
    // Macro just ended
    if not inAnyMacro and wasInMacro
        float bracketY = macroSessionHigh + atrOffset * 5
        
        // Add right bracket
        if i_macroStyle == "Brackets" or i_macroStyle == "Both"
            line rightBracket = line.new(bar_index, macroSessionHigh + atrOffset, bar_index, bracketY, color=i_macroColor, width=1)
            macroLines.push(rightBracket)
            
            if macroLines.size() >= 2
                line topLine = macroLines.get(macroLines.size() - 2)
                topLine.set_x2(bar_index)
        
        // Center label
        if i_macroLabels and macroLabels.size() > 0
            label lastLbl = macroLabels.get(macroLabels.size() - 1)
            int midX = int(math.avg(macroStartBar, bar_index))
            lastLbl.set_x(midX)
    
    wasInMacro := inAnyMacro

// Macro Memory Cleanup
macroLines.cleanupLines(150)
macroBoxes.cleanupBoxes(50)
macroLabels.cleanupLabels(50)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                  CONFLUENCE DETECTION                                          ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

f_calcConfluence() =>
    int score = 0
    float priceLevel = close
    float zoneTol = nz(ta.atr(14), close * 0.01) * 0.5
    
    // Discount Zone Check
    if not na(structHi) and not na(structLo)
        float eq = structLo + (structHi - structLo) * 0.5
        if close < eq
            score += 1
    
    // OTE Zone Check
    if not na(oteTop) and not na(oteBot)
        if close >= oteBot and close <= oteTop
            score += 1
    
    // FVG Proximity - with size check
    if bullFvgBox.size() > 0
        int maxIdx = math.min(bullFvgBox.size() - 1, 4)
        for i = 0 to maxIdx
            if i < bullFvgMit.size() and not bullFvgMit.get(i)
                float top = bullFvgTop.get(i)
                float bot = bullFvgBot.get(i)
                if priceLevel >= bot - zoneTol and priceLevel <= top + zoneTol
                    score += 1
                    break
    
    // OB Proximity - with size check
    if bullOBBox.size() > 0
        int maxIdx = math.min(bullOBBox.size() - 1, 4)
        for i = 0 to maxIdx
            if i < bullOBMit.size() and not bullOBMit.get(i)
                float top = bullOBTop.get(i)
                float bot = bullOBBot.get(i)
                if priceLevel >= bot - zoneTol and priceLevel <= top + zoneTol
                    score += 1
                    break
    
    // Macro Time Bonus
    if inAnyMacro
        score += 1
    
    // EQ Level Proximity
    if not na(structHi) and not na(structLo)
        float eqLevel = structLo + (structHi - structLo) * 0.5
        if math.abs(priceLevel - eqLevel) <= zoneTol
            score += 1
    
    score

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                  DEALING RANGE DRAWER                                          ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

f_drawDealingRange(int leftBar, int rightBar, float drHigh, float drLow, color baseCol, string drName, int eqWidth) =>
    if not na(drHigh) and not na(drLow) and drHigh > drLow
        float rng  = drHigh - drLow
        float f0   = drLow
        float f50  = drLow + rng * 0.5
        float f100 = drHigh
        int cLeft  = f_clampBar(leftBar)
        int lblX   = rightBar + 2
        
        if i_drPDZones
            box.new(cLeft, f100, rightBar, f50, bgcolor=color.new(C_BEAR, i_zoneTrans + 8), border_color=na)
            box.new(cLeft, f50, rightBar, f0, bgcolor=color.new(C_BULL, i_zoneTrans + 8), border_color=na)
        
        if i_drFibs
            line.new(cLeft, f0, rightBar, f0, color=color.new(baseCol, 65), style=line.style_dotted, width=1)
            line.new(cLeft, f100, rightBar, f100, color=color.new(baseCol, 65), style=line.style_dotted, width=1)
        
        if i_drEQ
            line.new(cLeft, f50, rightBar, f50, color=color.new(baseCol, 30), width=eqWidth)
        
        if i_drLabels and i_showLabels
            string priceTxt = i_drPrice ? (" " + str.tostring(f50)) : ""
            label.new(lblX, f50, drName + " EQ" + priceTxt, style=label.style_none, textcolor=color.new(baseCol, 20), size=f_labelSize(i_labelSize))

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                       DASHBOARD DATA                                           ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

int activeBullFvg = bullFvgMit.countActive()
int activeBearFvg = bearFvgMit.countActive()
int activeVimb    = vimbMit.countActive()
int activeBullOB  = bullOBMit.countActive()
int activeBearOB  = bearOBMit.countActive()
int activeEqh     = eqhSwept.countActive()
int activeEql     = eqlSwept.countActive()
int activeBsl     = bslSwept.countActive()
int activeSsl     = sslSwept.countActive()
int activeBullBB  = bullBBMit.countActive()
int activeBearBB  = bearBBMit.countActive()
int activeBullRB  = bullRBMit.countActive()
int activeBearRB  = bearRBMit.countActive()
int activeIfvg    = ifvgMit.countActive()

// Calculate confluence BEFORE dashboard
int currentConf = i_showConf ? f_calcConfluence() : 0

if i_showConf and currentConf >= i_confThresh
    highConfAlert := true

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    LAST BAR DRAWINGS                                           ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

if barstate.islast
    // Cleanup HTF elements
    for bx in htfBody
        box.delete(bx)
    htfBody.clear()
    for ln in htfWick
        line.delete(ln)
    htfWick.clear()
    line.delete(htfOpenLn)
    line.delete(htfHighLn)
    line.delete(htfLowLn)
    label.delete(htfTimerLbl)
    
    // Cleanup structure elements
    line.delete(lnOteTop)
    line.delete(lnOteBot)
    box.delete(oteBox)
    line.delete(ln0)
    line.delete(ln50)
    line.delete(ln100)
    box.delete(premBox)
    box.delete(discBox)
    
    // ══════════════════════════════════════════════════════════════════════════════════
    //                              HTF ORDERFLOW CANDLES
    // ══════════════════════════════════════════════════════════════════════════════════
    
    if i_showHTF
        int startX = bar_index + i_htfOffset
        int candleW = 3
        int spacing = 2
        int numCandles = math.min(i_htfCount, 6)
        bool htfValid = not na(htfH) and not na(htfL) and not na(htfO) and not na(htfC)
        
        if htfValid
            // Current candle
            if numCandles >= 1 and not na(htfO)
                bool isBull = htfC >= htfO
                color bodyCol = isBull ? color.new(C_BULL, 65) : color.new(C_BEAR, 65)
                color borderCol = isBull ? C_BULL : C_BEAR
                color wickCol = isBull ? color.new(C_BULL, 40) : color.new(C_BEAR, 40)
                int leftX = startX
                int midX = leftX + 1
                
                if i_htfStyle == "Hollow" and isBull
                    bodyCol := color.new(C_BULL, 95)
                
                htfWick.push(line.new(midX, htfH, midX, htfL, color=wickCol, width=1))
                htfBody.push(box.new(leftX, math.max(htfO, htfC), leftX + candleW, math.min(htfO, htfC), bgcolor=bodyCol, border_color=borderCol, border_width=1))
            
            // Historical candles
            if numCandles >= 2 and not na(htfO1) and not na(htfH1)
                bool isBull = htfC1 >= htfO1
                color bodyCol = isBull ? color.new(C_BULL, 70) : color.new(C_BEAR, 70)
                color borderCol = isBull ? color.new(C_BULL, 30) : color.new(C_BEAR, 30)
                int leftX = startX + (candleW + spacing)
                htfWick.push(line.new(leftX + 1, htfH1, leftX + 1, htfL1, color=color.new(borderCol, 20), width=1))
                htfBody.push(box.new(leftX, math.max(htfO1, htfC1), leftX + candleW, math.min(htfO1, htfC1), bgcolor=bodyCol, border_color=borderCol, border_width=1))
            
            if numCandles >= 3 and not na(htfO2) and not na(htfH2)
                bool isBull = htfC2 >= htfO2
                color bodyCol = isBull ? color.new(C_BULL, 75) : color.new(C_BEAR, 75)
                color borderCol = isBull ? color.new(C_BULL, 35) : color.new(C_BEAR, 35)
                int leftX = startX + 2 * (candleW + spacing)
                htfWick.push(line.new(leftX + 1, htfH2, leftX + 1, htfL2, color=color.new(borderCol, 20), width=1))
                htfBody.push(box.new(leftX, math.max(htfO2, htfC2), leftX + candleW, math.min(htfO2, htfC2), bgcolor=bodyCol, border_color=borderCol, border_width=1))
            
            if numCandles >= 4 and not na(htfO3) and not na(htfH3)
                bool isBull = htfC3 >= htfO3
                color bodyCol = isBull ? color.new(C_BULL, 78) : color.new(C_BEAR, 78)
                color borderCol = isBull ? color.new(C_BULL, 40) : color.new(C_BEAR, 40)
                int leftX = startX + 3 * (candleW + spacing)
                htfWick.push(line.new(leftX + 1, htfH3, leftX + 1, htfL3, color=color.new(borderCol, 20), width=1))
                htfBody.push(box.new(leftX, math.max(htfO3, htfC3), leftX + candleW, math.min(htfO3, htfC3), bgcolor=bodyCol, border_color=borderCol, border_width=1))
            
            if numCandles >= 5 and not na(htfO4) and not na(htfH4)
                bool isBull = htfC4 >= htfO4
                color bodyCol = isBull ? color.new(C_BULL, 80) : color.new(C_BEAR, 80)
                color borderCol = isBull ? color.new(C_BULL, 45) : color.new(C_BEAR, 45)
                int leftX = startX + 4 * (candleW + spacing)
                htfWick.push(line.new(leftX + 1, htfH4, leftX + 1, htfL4, color=color.new(borderCol, 20), width=1))
                htfBody.push(box.new(leftX, math.max(htfO4, htfC4), leftX + candleW, math.min(htfO4, htfC4), bgcolor=bodyCol, border_color=borderCol, border_width=1))
            
            if numCandles >= 6 and not na(htfO5) and not na(htfH5)
                bool isBull = htfC5 >= htfO5
                color bodyCol = isBull ? color.new(C_BULL, 82) : color.new(C_BEAR, 82)
                color borderCol = isBull ? color.new(C_BULL, 50) : color.new(C_BEAR, 50)
                int leftX = startX + 5 * (candleW + spacing)
                htfWick.push(line.new(leftX + 1, htfH5, leftX + 1, htfL5, color=color.new(borderCol, 20), width=1))
                htfBody.push(box.new(leftX, math.max(htfO5, htfC5), leftX + candleW, math.min(htfO5, htfC5), bgcolor=bodyCol, border_color=borderCol, border_width=1))
            
            // O/H/L Lines
            if i_htfOHL
                int lineStart = bar_index - 40
                int lineEnd = bar_index + i_htfOffset - 3
                htfOpenLn := line.new(lineStart, htfO, lineEnd, htfO, color=color.new(C_EQ, 55), style=line.style_dotted, width=1)
                htfHighLn := line.new(lineStart, htfH, lineEnd, htfH, color=color.new(C_NEUTRAL, 55), style=line.style_dotted, width=1)
                htfLowLn := line.new(lineStart, htfL, lineEnd, htfL, color=color.new(C_NEUTRAL, 55), style=line.style_dotted, width=1)
            
            // Timer
            if i_htfTimer
                htfTimerLbl := label.new(startX + 2, htfH, htfTF + " ⏱ " + countdownStr, style=label.style_none, textcolor=C_EQ, size=f_labelSize(i_labelSize))
    
    // ══════════════════════════════════════════════════════════════════════════════════
    //                                  OTE ZONE
    // ══════════════════════════════════════════════════════════════════════════════════
    
    int structAge = bar_index - math.max(structHiBar, structLoBar)
    
    if i_showOTE and not na(oteTop) and not na(oteBot) and structAge < i_fibMaxAge
        int oteLeft = f_clampBar(math.min(structHiBar, structLoBar))
        int oteRight = bar_index + 6
        
        oteBox := box.new(oteLeft, oteTop, oteRight, oteBot, bgcolor=color.new(C_OTE, 88), border_color=na)
        lnOteTop := line.new(oteLeft, oteTop, oteRight, oteTop, color=color.new(C_OTE, 45), style=line.style_dashed, width=1)
        lnOteBot := line.new(oteLeft, oteBot, oteRight, oteBot, color=color.new(C_OTE, 45), style=line.style_dashed, width=1)
        
        if i_showLabels
            label.new(oteRight + 1, oteMid, "◈ OTE", style=label.style_none, textcolor=C_OTE, size=f_labelSize(i_labelSize))
    
    // ══════════════════════════════════════════════════════════════════════════════════
    //                                  DEALING RANGES
    // ══════════════════════════════════════════════════════════════════════════════════
    
    if i_showDR
        if i_showDR_21D and not na(dr21H) and dr21H > dr21L
            f_drawDealingRange(f_clampBar(bar_index - barsIn21D), bar_index + 6, dr21H, dr21L, C_NY, "21D", 2)
        
        if i_showDR_3D and not na(dr3H) and dr3H > dr3L
            f_drawDealingRange(f_clampBar(bar_index - barsIn3D), bar_index + 6, dr3H, dr3L, C_BB, "3D", 2)
        
        if i_showDR_1D and not na(dr1H) and dr1StartBar > 0 and dr1H > dr1L
            f_drawDealingRange(f_clampBar(dr1StartBar), bar_index + 6, dr1H, dr1L, C_DAILY, "1D", 2)
        
        if i_showDR_Asia and drAsiaComplete and not na(drAsiaH) and drAsiaH > drAsiaL
            f_drawDealingRange(f_clampBar(drAsiaStartBar), bar_index + 6, drAsiaH, drAsiaL, C_ASIA, "ASIA", 1)
        
        if i_showDR_LDN and drLdnComplete and not na(drLdnH) and drLdnH > drLdnL
            f_drawDealingRange(f_clampBar(drLdnStartBar), bar_index + 6, drLdnH, drLdnL, C_LONDON, "LDN", 1)
        
        if i_showDR_NY and drNyComplete and not na(drNyH) and drNyH > drNyL
            f_drawDealingRange(f_clampBar(drNyStartBar), bar_index + 6, drNyH, drNyL, C_NY, "NY", 1)
    
    // ══════════════════════════════════════════════════════════════════════════════════
    //                                  STRUCTURE FIBS
    // ══════════════════════════════════════════════════════════════════════════════════
    
    if i_showFibs and not na(structHi) and not na(structLo) and structHi > structLo and structAge < i_fibMaxAge
        float rng = structHi - structLo
        float f0 = structLo
        float f50 = structLo + rng * 0.5
        float f100 = structHi
        
        int leftX = f_clampBar(math.min(structHiBar, structLoBar))
        int rightX = bar_index + 6
        
        if i_showPDZones
            premBox := box.new(leftX, f100, rightX, f50, bgcolor=color.new(C_BEAR, 94), border_color=na)
            discBox := box.new(leftX, f50, rightX, f0, bgcolor=color.new(C_BULL, 94), border_color=na)
        
        ln0 := line.new(leftX, f0, rightX, f0, color=color.new(C_NEUTRAL, 60), style=line.style_dashed, width=1)
        ln50 := line.new(leftX, f50, rightX, f50, color=C_EQ, width=2)
        ln100 := line.new(leftX, f100, rightX, f100, color=color.new(C_NEUTRAL, 60), style=line.style_dashed, width=1)
        
        if i_showLabels
            label.new(rightX + 1, f0, "0%", style=label.style_none, textcolor=color.new(C_NEUTRAL, 50), size=f_labelSize(i_labelSize))
            label.new(rightX + 1, f50, "≡ EQ", style=label.style_none, textcolor=C_EQ, size=f_labelSize(i_labelSize))
            label.new(rightX + 1, f100, "100%", style=label.style_none, textcolor=color.new(C_NEUTRAL, 50), size=f_labelSize(i_labelSize))
    
    // ══════════════════════════════════════════════════════════════════════════════════
    //                                  SESSION OPENS
    // ══════════════════════════════════════════════════════════════════════════════════
    
    line.delete(wkLine)
    line.delete(moLine)
    line.delete(doLine)
    label.delete(wkLbl)
    label.delete(moLbl)
    label.delete(doLbl)
    
    if i_showSessOpens
        if i_showWO and not na(weeklyOpen) and weeklyBar > 0
            wkLine := line.new(f_clampBar(weeklyBar), weeklyOpen, bar_index + 6, weeklyOpen, 
                 color=color.new(C_WEEKLY, 35), style=line.style_dotted, width=1)
            if i_showLabels
                string txt = i_showPrices ? ("W.O " + str.tostring(weeklyOpen)) : "W.O"
                wkLbl := label.new(bar_index + 7, weeklyOpen, txt, 
                     style=label.style_label_left, color=color.new(C_WEEKLY, 85), 
                     textcolor=C_WEEKLY, size=f_labelSize(i_labelSize))
        
        if i_showMO and not na(monthlyOpen) and monthlyBar > 0
            moLine := line.new(f_clampBar(monthlyBar), monthlyOpen, bar_index + 6, monthlyOpen, 
                 color=color.new(C_MONTHLY, 35), style=line.style_dotted, width=1)
            if i_showLabels
                string txt = i_showPrices ? ("M.O " + str.tostring(monthlyOpen)) : "M.O"
                moLbl := label.new(bar_index + 7, monthlyOpen, txt, 
                     style=label.style_label_left, color=color.new(C_MONTHLY, 85), 
                     textcolor=C_MONTHLY, size=f_labelSize(i_labelSize))
        
        if i_showDO and not na(dailyOpen) and dailyBar > 0
            doLine := line.new(f_clampBar(dailyBar), dailyOpen, bar_index + 6, dailyOpen, 
                 color=color.new(C_DAILY, 35), style=line.style_dotted, width=1)
            if i_showLabels
                string txt = i_showPrices ? ("D.O " + str.tostring(dailyOpen)) : "D.O"
                doLbl := label.new(bar_index + 7, dailyOpen, txt, 
                     style=label.style_label_left, color=color.new(C_DAILY, 85), 
                     textcolor=C_DAILY, size=f_labelSize(i_labelSize))
    
    // ══════════════════════════════════════════════════════════════════════════════════
    //                                PREVIOUS HIGH/LOW
    // ══════════════════════════════════════════════════════════════════════════════════
    
    line.delete(pdhLine)
    line.delete(pdlLine)
    line.delete(pwhLine)
    line.delete(pwlLine)
    line.delete(pmhLine)
    line.delete(pmlLine)
    label.delete(pdhLbl)
    label.delete(pdlLbl)
    label.delete(pwhLbl)
    label.delete(pwlLbl)
    label.delete(pmhLbl)
    label.delete(pmlLbl)
    
    if i_showPrevHL
        if i_showPDHL and not na(pdh) and not na(pdl)
            int lineStart = bar_index - 60
            pdhLine := line.new(lineStart, pdh, bar_index + 6, pdh, color=color.new(C_NEUTRAL, 25), style=line.style_dashed, width=1)
            pdlLine := line.new(lineStart, pdl, bar_index + 6, pdl, color=color.new(C_NEUTRAL, 25), style=line.style_dashed, width=1)
            if i_showLabels
                pdhLbl := label.new(bar_index + 7, pdh, "PDH", style=label.style_none, textcolor=C_NEUTRAL, size=f_labelSize(i_labelSize))
                pdlLbl := label.new(bar_index + 7, pdl, "PDL", style=label.style_none, textcolor=C_NEUTRAL, size=f_labelSize(i_labelSize))
        
        if i_showPWHL and not na(pwh) and not na(pwl)
            int lineStart = bar_index - 120
            pwhLine := line.new(lineStart, pwh, bar_index + 6, pwh, color=color.new(C_WEEKLY, 25), style=line.style_dashed, width=1)
            pwlLine := line.new(lineStart, pwl, bar_index + 6, pwl, color=color.new(C_WEEKLY, 25), style=line.style_dashed, width=1)
            if i_showLabels
                pwhLbl := label.new(bar_index + 7, pwh, "PWH", style=label.style_none, textcolor=C_WEEKLY, size=f_labelSize(i_labelSize))
                pwlLbl := label.new(bar_index + 7, pwl, "PWL", style=label.style_none, textcolor=C_WEEKLY, size=f_labelSize(i_labelSize))
        
        if i_showPMHL and not na(pmh) and not na(pml)
            int lineStart = bar_index - 180
            pmhLine := line.new(lineStart, pmh, bar_index + 6, pmh, color=color.new(C_MONTHLY, 25), style=line.style_dashed, width=1)
            pmlLine := line.new(lineStart, pml, bar_index + 6, pml, color=color.new(C_MONTHLY, 25), style=line.style_dashed, width=1)
            if i_showLabels
                pmhLbl := label.new(bar_index + 7, pmh, "PMH", style=label.style_none, textcolor=C_MONTHLY, size=f_labelSize(i_labelSize))
                pmlLbl := label.new(bar_index + 7, pml, "PML", style=label.style_none, textcolor=C_MONTHLY, size=f_labelSize(i_labelSize))
    
    // ══════════════════════════════════════════════════════════════════════════════════
    //                              SESSION H/L LINES
    // ══════════════════════════════════════════════════════════════════════════════════
    
    line.delete(asiaHLine)
    line.delete(asiaLLine)
    line.delete(londonHLine)
    line.delete(londonLLine)
    line.delete(nyamHLine)
    line.delete(nyamLLine)
    line.delete(nypmHLine)
    line.delete(nypmLLine)
    
    if i_showKZ and i_kzHL
        if i_showAsia and not na(asiaH) and not na(asiaL)
            int rightExt = inAsia ? bar_index + 4 : (i_kzExtend ? bar_index + 12 : math.min(asiaStartBar + 40, bar_index + 6))
            asiaHLine := line.new(f_clampBar(asiaStartBar), asiaH, rightExt, asiaH, color=C_ASIA, style=line.style_solid, width=1)
            asiaLLine := line.new(f_clampBar(asiaStartBar), asiaL, rightExt, asiaL, color=C_ASIA, style=line.style_solid, width=1)
        
        if i_showLondon and not na(londonH) and not na(londonL)
            int rightExt = inLondon ? bar_index + 4 : (i_kzExtend ? bar_index + 12 : math.min(londonStartBar + 40, bar_index + 6))
            londonHLine := line.new(f_clampBar(londonStartBar), londonH, rightExt, londonH, color=C_LONDON, style=line.style_solid, width=1)
            londonLLine := line.new(f_clampBar(londonStartBar), londonL, rightExt, londonL, color=C_LONDON, style=line.style_solid, width=1)
        
        if i_showNYAM and not na(nyamH) and not na(nyamL)
            int rightExt = inNYAM ? bar_index + 4 : (i_kzExtend ? bar_index + 12 : math.min(nyamStartBar + 40, bar_index + 6))
            nyamHLine := line.new(f_clampBar(nyamStartBar), nyamH, rightExt, nyamH, color=C_NY, style=line.style_solid, width=1)
            nyamLLine := line.new(f_clampBar(nyamStartBar), nyamL, rightExt, nyamL, color=C_NY, style=line.style_solid, width=1)
        
        if i_showNYPM and not na(nypmH) and not na(nypmL)
            int rightExt = inNYPM ? bar_index + 4 : (i_kzExtend ? bar_index + 12 : math.min(nypmStartBar + 40, bar_index + 6))
            nypmHLine := line.new(f_clampBar(nypmStartBar), nypmH, rightExt, nypmH, color=C_IFVG, style=line.style_solid, width=1)
            nypmLLine := line.new(f_clampBar(nypmStartBar), nypmL, rightExt, nypmL, color=C_IFVG, style=line.style_solid, width=1)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                       DASHBOARD                                                ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

if i_showDash and barstate.islast
    // Zone
    string zone = "—"
    color zoneCol = C_NEUTRAL
    if not na(structHi) and not na(structLo)
        float eq = structLo + (structHi - structLo) * 0.5
        zone := close > eq ? "PREMIUM ⬆" : "DISCOUNT ⬇"
        zoneCol := close > eq ? C_BEAR : C_BULL
    
    // Structure
    string msBias = mssDirection == 1 ? "BULLISH ▲" : mssDirection == -1 ? "BEARISH ▼" : "NEUTRAL ◆"
    color msCol = mssDirection == 1 ? C_BULL : mssDirection == -1 ? C_BEAR : C_NEUTRAL
    
    // Session
    string currSession = inAsia ? "ASIA 🌏" : inLondon ? "LONDON 🇬🇧" : inNYAM ? "NY AM 🇺🇸" : inNYPM ? "NY PM 🌆" : "OFF"
    color sessionCol = inAsia ? C_ASIA : inLondon ? C_LONDON : inNYAM ? C_NY : inNYPM ? C_IFVG : C_NEUTRAL
    
    // OTE
    string oteStatus = "—"
    color oteStatCol = C_NEUTRAL
    if not na(oteTop) and not na(oteBot)
        if close >= oteBot and close <= oteTop
            oteStatus := "✓ IN ZONE"
            oteStatCol := C_OTE
        else if close < oteBot
            oteStatus := "↓ BELOW"
            oteStatCol := C_BULL
        else
            oteStatus := "↑ ABOVE"
            oteStatCol := C_BEAR
    
    // Confluence
    string confStatus = str.tostring(currentConf)
    color confCol = currentConf >= i_confThresh ? C_CONF : C_NEUTRAL
    
    // Macro
    string macroStat = inAnyMacro ? ("● " + currentMacroLbl) : "○ IDLE"
    color macroCol = inAnyMacro ? i_macroColor : C_NEUTRAL
    
    table.delete(dashboard)
    
    int numRows = i_dashStyle == "Minimal" ? 7 : i_dashStyle == "Compact" ? 12 : 16
    
    dashboard := table.new(f_dashPosition(i_dashPos), 2, numRows, 
         bgcolor=color.new(#131722, i_dashTrans), 
         frame_color=color.new(#363A45, 0), frame_width=1, 
         border_color=color.new(#363A45, 50), border_width=1)
    
    // Row 0: Header
    table.cell(dashboard, 0, 0, "⚡ ICT MATRIX", text_color=color.white, text_size=f_labelSize(i_dashSize), bgcolor=color.new(#2962FF, 15))
    table.cell(dashboard, 1, 0, "v6.0", text_color=color.new(#2962FF, 0), text_size=f_labelSize(i_dashSize), bgcolor=color.new(#2962FF, 15))
    
    // Row 1: Structure
    table.cell(dashboard, 0, 1, "Structure", text_color=color.new(C_NEUTRAL, 30), text_size=f_labelSize(i_dashSize))
    table.cell(dashboard, 1, 1, msBias, text_color=msCol, text_size=f_labelSize(i_dashSize))
    
    // Row 2: Zone
    table.cell(dashboard, 0, 2, "Zone", text_color=color.new(C_NEUTRAL, 30), text_size=f_labelSize(i_dashSize))
    table.cell(dashboard, 1, 2, zone, text_color=zoneCol, text_size=f_labelSize(i_dashSize))
    
    // Row 3: Session
    table.cell(dashboard, 0, 3, "Session", text_color=color.new(C_NEUTRAL, 30), text_size=f_labelSize(i_dashSize))
    table.cell(dashboard, 1, 3, currSession, text_color=sessionCol, text_size=f_labelSize(i_dashSize))
    
    // Row 4: OTE
    table.cell(dashboard, 0, 4, "OTE Zone", text_color=color.new(C_OTE, 30), text_size=f_labelSize(i_dashSize))
    table.cell(dashboard, 1, 4, oteStatus, text_color=oteStatCol, text_size=f_labelSize(i_dashSize))
    
    // Row 5: Confluence
    table.cell(dashboard, 0, 5, "Confluence", text_color=color.new(C_CONF, 30), text_size=f_labelSize(i_dashSize))
    table.cell(dashboard, 1, 5, confStatus + " / " + str.tostring(i_confThresh), text_color=confCol, text_size=f_labelSize(i_dashSize))
    
    // Row 6: Macro
    if i_showMacros
        table.cell(dashboard, 0, 6, "Macro", text_color=color.new(i_macroColor, 30), text_size=f_labelSize(i_dashSize))
        table.cell(dashboard, 1, 6, macroStat, text_color=macroCol, text_size=f_labelSize(i_dashSize))
    
    if i_dashStyle != "Minimal"
        int rowOffset = i_showMacros ? 7 : 6
        
        // FVG
        table.cell(dashboard, 0, rowOffset, "FVG ▲/▼", text_color=color.new(C_BULL, 30), text_size=f_labelSize(i_dashSize))
        table.cell(dashboard, 1, rowOffset, str.tostring(activeBullFvg) + " / " + str.tostring(activeBearFvg), text_color=C_NEUTRAL, text_size=f_labelSize(i_dashSize))
        
        // iFVG
        table.cell(dashboard, 0, rowOffset + 1, "iFVG", text_color=color.new(C_IFVG, 30), text_size=f_labelSize(i_dashSize))
        table.cell(dashboard, 1, rowOffset + 1, str.tostring(activeIfvg), text_color=C_NEUTRAL, text_size=f_labelSize(i_dashSize))
        
        // OB
        table.cell(dashboard, 0, rowOffset + 2, "OB ▲/▼", text_color=color.new(C_OB, 30), text_size=f_labelSize(i_dashSize))
        table.cell(dashboard, 1, rowOffset + 2, str.tostring(activeBullOB) + " / " + str.tostring(activeBearOB), text_color=C_NEUTRAL, text_size=f_labelSize(i_dashSize))
        
        // BB
        table.cell(dashboard, 0, rowOffset + 3, "BB ▲/▼", text_color=color.new(C_BB, 30), text_size=f_labelSize(i_dashSize))
        table.cell(dashboard, 1, rowOffset + 3, str.tostring(activeBullBB) + " / " + str.tostring(activeBearBB), text_color=C_NEUTRAL, text_size=f_labelSize(i_dashSize))
        
        // VIMB
        table.cell(dashboard, 0, rowOffset + 4, "VIMB", text_color=color.new(C_VIMB, 30), text_size=f_labelSize(i_dashSize))
        table.cell(dashboard, 1, rowOffset + 4, str.tostring(activeVimb), text_color=C_NEUTRAL, text_size=f_labelSize(i_dashSize))
    
    if i_dashStyle == "Detailed"
        int rowOffset = i_showMacros ? 12 : 11
        
        // RB
        table.cell(dashboard, 0, rowOffset, "RB ▲/▼", text_color=color.new(C_BULL, 30), text_size=f_labelSize(i_dashSize))
        table.cell(dashboard, 1, rowOffset, str.tostring(activeBullRB) + " / " + str.tostring(activeBearRB), text_color=C_NEUTRAL, text_size=f_labelSize(i_dashSize))
        
        // EQH/EQL
        table.cell(dashboard, 0, rowOffset + 1, "EQH/EQL", text_color=color.new(C_EQ, 30), text_size=f_labelSize(i_dashSize))
        table.cell(dashboard, 1, rowOffset + 1, str.tostring(activeEqh) + " / " + str.tostring(activeEql), text_color=C_NEUTRAL, text_size=f_labelSize(i_dashSize))
        
        // BSL/SSL
        table.cell(dashboard, 0, rowOffset + 2, "BSL/SSL", text_color=color.new(C_BULL, 30), text_size=f_labelSize(i_dashSize))
        table.cell(dashboard, 1, rowOffset + 2, str.tostring(activeBsl) + " / " + str.tostring(activeSsl), text_color=C_NEUTRAL, text_size=f_labelSize(i_dashSize))
        
        // HTF Timer
        if i_showHTF
            table.cell(dashboard, 0, rowOffset + 3, "HTF ⏱", text_color=color.new(C_EQ, 30), text_size=f_labelSize(i_dashSize))
            table.cell(dashboard, 1, rowOffset + 3, htfTF + " " + countdownStr, text_color=C_EQ, text_size=f_labelSize(i_dashSize))

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                  VISUAL INDICATORS                                             ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

// Confluence background
bool highConf = i_showConf and currentConf >= i_confThresh
bgcolor(highConf ? color.new(C_CONF, 94) : na, title="High Confluence Zone")

// Macro background
bgcolor(i_showMacros and inAnyMacro and i_macroStyle == "Background" ? color.new(i_macroColor, 95) : na, title="Macro Active")

// Confluence label
if barstate.islast and i_showConf and i_confShowLbl and currentConf >= i_confThresh
    label.new(bar_index + 3, close, "★ " + str.tostring(currentConf), 
         style=label.style_label_left, color=color.new(C_CONF, 75), 
         textcolor=C_CONF, size=size.small)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                        PLOT SIGNALS                                            ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

plotshape(bullMSS and i_showMSS, title="Bullish MSS", style=shape.triangleup, location=location.belowbar, color=C_BULL, size=size.tiny)
plotshape(bearMSS and i_showMSS, title="Bearish MSS", style=shape.triangledown, location=location.abovebar, color=C_BEAR, size=size.tiny)
plotshape(eqhSweptAlert and i_showEQHL, title="EQH Swept", style=shape.xcross, location=location.abovebar, color=C_EQ, size=size.tiny)
plotshape(eqlSweptAlert and i_showEQHL, title="EQL Swept", style=shape.xcross, location=location.belowbar, color=C_EQ, size=size.tiny)
plotshape(highConfAlert and i_showConf, title="High Confluence", style=shape.diamond, location=location.abovebar, color=C_CONF, size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                          ALERTS                                                ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

// FVG Alerts
alertcondition(bullFVG, title="🟢 Bullish FVG", message="Bullish Fair Value Gap detected")
alertcondition(bearFVG, title="🔴 Bearish FVG", message="Bearish Fair Value Gap detected")

// iFVG Alerts
alertcondition(ifvgFormed, title="🔷 iFVG Created", message="Inverse FVG zone formed")

// Order Block Alerts
alertcondition(bullOB, title="🔵 Bullish OB", message="Bullish Order Block identified")
alertcondition(bearOB, title="🟠 Bearish OB", message="Bearish Order Block identified")

// Breaker Block Alerts
alertcondition(bullBreakerFormed, title="💜 Bullish Breaker", message="Bullish Breaker Block formed")
alertcondition(bearBreakerFormed, title="🟣 Bearish Breaker", message="Bearish Breaker Block formed")

// Rejection Block Alerts
alertcondition(bullRejection, title="💚 Bullish Rejection", message="Bullish Rejection Block")
alertcondition(bearRejection, title="❤️ Bearish Rejection", message="Bearish Rejection Block")

// Volume Imbalance Alerts
alertcondition(vimbUp, title="🟡 Bullish VIMB", message="Bullish Volume Imbalance")
alertcondition(vimbDn, title="🟡 Bearish VIMB", message="Bearish Volume Imbalance")

// Liquidity Alerts
alertcondition(eqhSweptAlert, title="💧 EQH Swept", message="Equal Highs liquidity taken")
alertcondition(eqlSweptAlert, title="💧 EQL Swept", message="Equal Lows liquidity taken")
alertcondition(bslSweptAlert, title="🌊 BSL Swept", message="Buyside Liquidity swept")
alertcondition(sslSweptAlert, title="🌊 SSL Swept", message="Sellside Liquidity swept")

// Market Structure Alerts
alertcondition(bullMSS, title="📈 Bullish MSS", message="Bullish Market Structure Shift")
alertcondition(bearMSS, title="📉 Bearish MSS", message="Bearish Market Structure Shift")

// Confluence Alert
alertcondition(highConfAlert, title="⚡ High Confluence", message="Multiple ICT concepts aligned")

// OTE Alert
bool enteredOTE = not na(oteTop) and not na(oteBot) and close >= oteBot and close <= oteTop and (close[1] < oteBot or close[1] > oteTop)
alertcondition(enteredOTE, title="🎯 Entered OTE", message="Price entered OTE zone")

// Macro Alerts
bool macroStarted = inAnyMacro and not inAnyMacro[1]
bool macroEnded = not inAnyMacro and inAnyMacro[1]
alertcondition(macroStarted, title="⏱️ Macro Started", message="ICT Macro time window opened")
alertcondition(macroEnded, title="⏱️ Macro Ended", message="ICT Macro time window closed")

// Combo Alerts
alertcondition(bullFVG or bullOB, title="🟢 Bullish Setup", message="Bullish FVG or OB formed")
alertcondition(bearFVG or bearOB, title="🔴 Bearish Setup", message="Bearish FVG or OB formed")
alertcondition(inAnyMacro and highConfAlert, title="⚡ Macro + Confluence", message="Macro active with high confluence!")

// Session Alerts
alertcondition(inAsia and not inAsia[1], title="🌏 Asia Open", message="Asia session started")
alertcondition(inLondon and not inLondon[1], title="🇬🇧 London Open", message="London session started")
alertcondition(inNYAM and not inNYAM[1], title="🇺🇸 NY AM Open", message="NY AM session started")
alertcondition(inNYPM and not inNYPM[1], title="🇺🇸 NY PM Open", message="NY PM session started")

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                      END OF SCRIPT                                             ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════
