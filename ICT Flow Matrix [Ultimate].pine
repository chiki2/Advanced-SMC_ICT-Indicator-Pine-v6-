// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                     UTILITY FUNCTIONS                                          ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

f_labelSize(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

f_dashPosition(string pos) =>
    switch pos
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

f_inSession(string startT, string endT) =>
    int startH = int(math.floor(str.tonumber(startT) / 100))
    int startM = int(str.tonumber(startT)) % 100
    int endH   = int(math.floor(str.tonumber(endT) / 100))
    int endM   = int(str.tonumber(endT)) % 100
    int currH  = hour(time, "America/New_York")
    int currM  = minute(time, "America/New_York")
    int currMins  = currH * 60 + currM
    int startMins = startH * 60 + startM
    int endMins   = endH * 60 + endM
    endMins > startMins ? (currMins >= startMins and currMins < endMins) : (currMins >= startMins or currMins < endMins)

f_inMacroTime(int sH, int sM, int eH, int eM) =>
    int h = hour(time, "America/New_York")
    int m = minute(time, "America/New_York")
    if sH == eH
        h == sH and m >= sM and m < eM
    else
        (h == sH and m >= sM) or (h == eH and m < eM)

// Method extensions for arrays - FIXED with size checks
method countActive(array<bool> arr) =>
    int count = 0
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            if not arr.get(i)
                count += 1
    count

method cleanupLines(array<line> arr, int maxSize) =>
    while arr.size() > maxSize
        line.delete(arr.shift())

method cleanupBoxes(array<box> arr, int maxSize) =>
    while arr.size() > maxSize
        box.delete(arr.shift())

method cleanupLabels(array<label> arr, int maxSize) =>
    while arr.size() > maxSize
        label.delete(arr.shift())

f_formatCountdown(int secs) =>
    int h = secs / 3600
    int m = (secs % 3600) / 60
    int s = secs % 60
    string result = ""
    if h > 0
        result := str.tostring(h) + "h " + str.tostring(m) + "m"
    else if m > 0
        result := str.tostring(m) + "m " + str.tostring(s) + "s"
    else
        result := str.tostring(s) + "s"
    result

f_clampBar(int idx) => math.max(bar_index - i_historyBars, idx)

