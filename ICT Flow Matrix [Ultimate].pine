//@version=6
indicator("ICT Flow Matrix [Ultimate]", 
     shorttitle    = "⚡TH_ICT Matrix v6", 
     overlay       = true, 
     max_boxes_count  = 500, 
     max_lines_count  = 500, 
     max_labels_count = 500, 
     max_bars_back    = 5000,
     explicit_plot_zorder = true)

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                      CONSTANTS & TOOLTIPS                                      ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

const string TT_FVG    = "Fair Value Gaps represent price imbalances where institutional orders may rest."
const string TT_OB     = "Order Blocks are the last opposing candle before a strong impulsive move."
const string TT_BB     = "Breaker Blocks form when an Order Block fails and price breaks through."
const string TT_RB     = "Rejection Blocks identify strong wick rejections indicating institutional defense."
const string TT_VIMB   = "Volume Imbalances are gaps between candle bodies showing aggressive activity."
const string TT_IFVG   = "Inverse FVGs form when a regular FVG is violated, creating a new zone."
const string TT_EQ     = "Equal Highs/Lows represent liquidity pools where stop losses accumulate."
const string TT_LIQ    = "Liquidity levels mark swing points where stop losses cluster."
const string TT_MSS    = "Market Structure Shift occurs when price breaks a significant swing point."
const string TT_OTE    = "Optimal Trade Entry zone (61.8%-79%) represents highest probability entry area."
const string TT_CONF   = "Confluence detection scores areas where multiple ICT concepts align."
const string TT_DR     = "Dealing Ranges define the high-low range with equilibrium as key decision point."
const string TT_HTF    = "Higher Timeframe candles provide context for dominant orderflow direction."
const string TT_KZ     = "Killzones are time windows where institutional activity is highest."
const string TT_MACRO  = "ICT Macro Times are 30-minute windows where algorithms trigger significant moves."

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                         INPUT GROUPS                                           ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

const string G_DISPLAY   = "══════════ 🎨 DISPLAY SETTINGS ══════════════"
const string G_THEME     = "══════════ 🎭 COLOR THEME ══════════════"
const string G_FVG       = "══════════ 📊 FAIR VALUE GAPS ════════════"
const string G_OB        = "══════════ 🏛️ ORDER BLOCKS ═══════════════"
const string G_STRUCT    = "═══════════ 📐 STRUCTURE & LIQUIDITY ═════════"
const string G_SESSIONS  = "═══════════ ⏰ SESSIONS & KILLZONES ══════════"
const string G_DR        = "══════════ 📏 DEALING RANGES ═══════════════"
const string G_HTF       = "══════════ 🕯️ HTF ORDERFLOW ═══════════════"
const string G_MACROS    = "═════════ ⏱️ ICT MACRO TIMES ═══════════════"
const string G_DASHBOARD = "═════════ 📋 DASHBOARD ═══════════════"

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                       DISPLAY SETTINGS                                         ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

string i_labelSize     = input.string("Small", "Label Size", options=["Tiny", "Small", "Normal", "Large"], group=G_DISPLAY, inline="d1")
int    i_zoneTrans     = input.int(85, "Zone Opacity", minval=50, maxval=95, step=1, group=G_DISPLAY, inline="d1")
bool   i_showLabels    = input.bool(true, "Show Labels", group=G_DISPLAY, inline="d2")
bool   i_showZoneLabels = input.bool(false, "Zone Labels", group=G_DISPLAY, inline="d2", tooltip="Show FVG/OB/RB labels - disable to reduce clutter")
bool   i_showPrices    = input.bool(false, "Price on Labels", group=G_DISPLAY, inline="d2")
bool   i_mitEffect     = input.bool(true, "Mitigation Fade", group=G_DISPLAY, inline="d3")
int    i_historyBars   = input.int(300, "History (Bars)", minval=100, maxval=5000, step=100, group=G_DISPLAY, inline="d3")

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                         COLOR THEME                                            ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

string i_themeMode = input.string("Dark Pro", "Theme Preset", options=["Dark Pro", "Light Clean", "Neon", "Classic", "Custom"], group=G_THEME)

color i_custBull    = input.color(#00E676, "↗ Bullish", group=G_THEME, inline="c1")
color i_custBear    = input.color(#FF5252, "↘ Bearish", group=G_THEME, inline="c1")
color i_custNeutral = input.color(#78909C, "◐ Neutral", group=G_THEME, inline="c2")
color i_custEq      = input.color(#FFEB3B, "≡ Equilibrium", group=G_THEME, inline="c2")
color i_custOB      = input.color(#2196F3, "■ Order Block", group=G_THEME, inline="c3")
color i_custBB      = input.color(#9C27B0, "◈ Breaker", group=G_THEME, inline="c3")
color i_custVIMB    = input.color(#FF9800, "▤ VIMB", group=G_THEME, inline="c4")
color i_custIFVG    = input.color(#00BCD4, "◫ iFVG", group=G_THEME, inline="c4")
color i_custOTE     = input.color(#4CAF50, "▧ OTE Zone", group=G_THEME, inline="c5")
color i_custConf    = input.color(#FFD700, "★ Confluence", group=G_THEME, inline="c5")

// Theme Color Function
f_getThemeColors() =>
    color _bull = switch i_themeMode
        "Dark Pro"    => #00E676
        "Light Clean" => #26A69A
        "Neon"        => #00FF88
        "Classic"     => #089981
        "Custom"      => i_custBull
        => #00E676
    
    color _bear = switch i_themeMode
        "Dark Pro"    => #FF5252
        "Light Clean" => #EF5350
        "Neon"        => #FF0055
        "Classic"     => #F23645
        "Custom"      => i_custBear
        => #FF5252
    
    color _neutral = switch i_themeMode
        "Dark Pro"    => #78909C
        "Light Clean" => #90A4AE
        "Neon"        => #607D8B
        "Classic"     => #787B86
        "Custom"      => i_custNeutral
        => #78909C
    
    color _eq = switch i_themeMode
        "Dark Pro"    => #FFD54F
        "Light Clean" => #FFC107
        "Neon"        => #FFFF00
        "Classic"     => #FFEB3B
        "Custom"      => i_custEq
        => #FFD54F
    
    color _ob = switch i_themeMode
        "Dark Pro"    => #42A5F5
        "Light Clean" => #1E88E5
        "Neon"        => #00BFFF
        "Classic"     => #2196F3
        "Custom"      => i_custOB
        => #42A5F5
    
    color _bb = switch i_themeMode
        "Dark Pro"    => #AB47BC
        "Light Clean" => #8E24AA
        "Neon"        => #FF00FF
        "Classic"     => #9C27B0
        "Custom"      => i_custBB
        => #AB47BC
    
    color _vimb = switch i_themeMode
        "Dark Pro"    => #FFA726
        "Light Clean" => #FB8C00
        "Neon"        => #FF8800
        "Classic"     => #FF9800
        "Custom"      => i_custVIMB
        => #FFA726
    
    color _ifvg = switch i_themeMode
        "Dark Pro"    => #26C6DA
        "Light Clean" => #00ACC1
        "Neon"        => #00FFFF
        "Classic"     => #00BCD4
        "Custom"      => i_custIFVG
        => #26C6DA
    
    color _ote = switch i_themeMode
        "Dark Pro"    => #66BB6A
        "Light Clean" => #43A047
        "Neon"        => #00FF00
        "Classic"     => #4CAF50
        "Custom"      => i_custOTE
        => #66BB6A
    
    color _conf = switch i_themeMode
        "Dark Pro"    => #FFD700
        "Light Clean" => #FFC400
        "Neon"        => #FFFF00
        "Classic"     => #FFD700
        "Custom"      => i_custConf
        => #FFD700
    
    color _asia   = #FF9800
    color _london = #42A5F5
    color _ny     = #EC407A
    color _weekly = #AB47BC
    color _monthly = #EC407A
    color _daily  = #42A5F5
    
    [_bull, _bear, _neutral, _eq, _ob, _bb, _vimb, _ifvg, _ote, _conf, _asia, _london, _ny, _weekly, _monthly, _daily]

[C_BULL, C_BEAR, C_NEUTRAL, C_EQ, C_OB, C_BB, C_VIMB, C_IFVG, C_OTE, C_CONF, C_ASIA, C_LONDON, C_NY, C_WEEKLY, C_MONTHLY, C_DAILY] = f_getThemeColors()

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                      FVG SETTINGS                                              ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

bool   i_showFVG     = input.bool(true, "Enable FVG Detection", group=G_FVG, tooltip=TT_FVG)
int    i_fvgMax      = input.int(5, "Maximum Zones", minval=1, maxval=20, group=G_FVG, inline="fvg1")
string i_fvgStyle    = input.string("Filled", "Style", options=["Filled", "Border Only"], group=G_FVG, inline="fvg1")
bool   i_fvgMitTrack = input.bool(true, "Track Mitigation", group=G_FVG, inline="fvg2")
bool   i_fvgExtend   = input.bool(true, "Extend Until Mitigated", group=G_FVG, inline="fvg2")
bool   i_fvgMidLine  = input.bool(true, "Show CE Line", group=G_FVG, inline="fvg3")
string i_fvgMitType  = input.string("Wick Touch", "Mitigation Type", options=["Wick Touch", "50% (CE)", "Full Close"], group=G_FVG, inline="fvg3")
bool   i_showIFVG    = input.bool(true, "Enable Inverse FVG", group=G_FVG, inline="ifvg1", tooltip=TT_IFVG)
int    i_ifvgMax     = input.int(3, "Max iFVG", minval=1, maxval=10, group=G_FVG, inline="ifvg1")

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    ORDER BLOCK SETTINGS                                        ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

bool   i_showOB      = input.bool(true, "Enable Order Blocks", group=G_OB, tooltip=TT_OB)
int    i_obMax       = input.int(3, "Maximum Zones", minval=1, maxval=10, group=G_OB, inline="ob1")
int    i_obStrength  = input.int(3, "Impulse Strength", minval=2, maxval=10, group=G_OB, inline="ob1")
bool   i_obExtend    = input.bool(true, "Extend Until Mitigated", group=G_OB, inline="ob2")
bool   i_obMidLine   = input.bool(true, "Show 50% Level", group=G_OB, inline="ob2")
bool   i_obVolFilter = input.bool(false, "Volume Filter", group=G_OB, inline="ob3")
string i_obStyle     = input.string("Filled", "Style", options=["Filled", "Border Only"], group=G_OB, inline="ob3")

bool   i_showBB      = input.bool(true, "Enable Breaker Blocks", group=G_OB, inline="bb1", tooltip=TT_BB)
int    i_bbMax       = input.int(3, "Max Breakers", minval=1, maxval=8, group=G_OB, inline="bb1")

bool   i_showRB      = input.bool(true, "Enable Rejection Blocks", group=G_OB, inline="rb1", tooltip=TT_RB)
int    i_rbMax       = input.int(2, "Max RBs", minval=1, maxval=8, group=G_OB, inline="rb1")
float  i_rbWickRatio = input.float(2.0, "Wick Ratio", minval=1.5, maxval=5.0, step=0.5, group=G_OB, inline="rb2")

bool   i_showVIMB    = input.bool(true, "Enable Volume Imbalance", group=G_OB, inline="vimb1", tooltip=TT_VIMB)
int    i_vimbMax     = input.int(2, "Max VIMBs", minval=1, maxval=8, group=G_OB, inline="vimb1")

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                   STRUCTURE & LIQUIDITY                                        ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

bool   i_showMSS     = input.bool(true, "Market Structure Shifts", group=G_STRUCT, tooltip=TT_MSS)
int    i_mssLen      = input.int(5, "Swing Length", minval=2, maxval=20, group=G_STRUCT, inline="mss1")

bool   i_showEQHL    = input.bool(true, "Equal Highs/Lows", group=G_STRUCT, inline="eq1", tooltip=TT_EQ)
int    i_eqhlMax     = input.int(3, "Max EQ Levels", minval=1, maxval=8, group=G_STRUCT, inline="eq1")
float  i_eqhlTol     = input.float(0.1, "EQ Tolerance %", minval=0.01, maxval=1.0, step=0.01, group=G_STRUCT, inline="eq2")

bool   i_showLiq     = input.bool(true, "Liquidity Levels", group=G_STRUCT, inline="liq1", tooltip=TT_LIQ)
int    i_liqMax      = input.int(4, "Max Levels", minval=1, maxval=10, group=G_STRUCT, inline="liq1")
int    i_liqSwingLen = input.int(10, "Swing Length", minval=3, maxval=50, group=G_STRUCT, inline="liq2")

bool   i_showFibs    = input.bool(true, "Structure Fibs", group=G_STRUCT, inline="fib1")
bool   i_showPDZones = input.bool(true, "Premium/Discount BG", group=G_STRUCT, inline="fib1")
int    i_fibMaxAge   = input.int(150, "Max Structure Age", minval=50, maxval=500, group=G_STRUCT, inline="fib2", tooltip="Hide P/D zones if structure is older than X bars")

bool   i_showOTE     = input.bool(true, "OTE Zone (61.8%-79%)", group=G_STRUCT, inline="ote1", tooltip=TT_OTE)

bool   i_showConf    = input.bool(true, "Confluence Detection", group=G_STRUCT, inline="conf1", tooltip=TT_CONF)
int    i_confThresh  = input.int(3, "Min Score", minval=2, maxval=6, group=G_STRUCT, inline="conf1")
bool   i_confShowLbl = input.bool(true, "Show Score", group=G_STRUCT, inline="conf2")

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    SESSION SETTINGS                                            ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

bool i_showSessOpens = input.bool(true, "Session Open Levels", group=G_SESSIONS)
bool i_showWO        = input.bool(true, "Weekly Open", group=G_SESSIONS, inline="so1")
bool i_showMO        = input.bool(true, "Monthly Open", group=G_SESSIONS, inline="so1")
bool i_showDO        = input.bool(false, "Daily Open", group=G_SESSIONS, inline="so1")

bool i_showPrevHL    = input.bool(true, "Previous Period H/L", group=G_SESSIONS)
bool i_showPDHL      = input.bool(true, "Day", group=G_SESSIONS, inline="phl1")
bool i_showPWHL      = input.bool(true, "Week", group=G_SESSIONS, inline="phl1")
bool i_showPMHL      = input.bool(false, "Month", group=G_SESSIONS, inline="phl1")

bool i_showKZ        = input.bool(true, "Killzone Sessions", group=G_SESSIONS, tooltip=TT_KZ)
bool i_kzBoxes       = input.bool(true, "Session Boxes", group=G_SESSIONS, inline="kz1")
bool i_kzHL          = input.bool(true, "Session H/L", group=G_SESSIONS, inline="kz1")
bool i_kzExtend      = input.bool(true, "Extend H/L", group=G_SESSIONS, inline="kz1")

bool   i_showAsia    = input.bool(true, "Asia", group=G_SESSIONS, inline="kz2")
bool   i_showLondon  = input.bool(true, "London", group=G_SESSIONS, inline="kz2")
bool   i_showNYAM    = input.bool(true, "NY AM", group=G_SESSIONS, inline="kz2")
bool   i_showNYPM    = input.bool(false, "NY PM", group=G_SESSIONS, inline="kz2")

string i_asiaStart   = input.string("2000", "Asia", group=G_SESSIONS, inline="kzt1")
string i_asiaEnd     = input.string("0000", "→", group=G_SESSIONS, inline="kzt1")
string i_londonStart = input.string("0200", "London", group=G_SESSIONS, inline="kzt2")
string i_londonEnd   = input.string("0500", "→", group=G_SESSIONS, inline="kzt2")
string i_nyamStart   = input.string("0830", "NY AM", group=G_SESSIONS, inline="kzt3")
string i_nyamEnd     = input.string("1100", "→", group=G_SESSIONS, inline="kzt3")
string i_nypmStart   = input.string("1330", "NY PM", group=G_SESSIONS, inline="kzt4")
string i_nypmEnd     = input.string("1600", "→", group=G_SESSIONS, inline="kzt4")

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    DEALING RANGE SETTINGS                                      ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

bool i_showDR        = input.bool(true, "Enable Dealing Ranges", group=G_DR, tooltip=TT_DR)
bool i_drFibs        = input.bool(true, "Fib Levels", group=G_DR, inline="dr1")
bool i_drPDZones     = input.bool(true, "P/D Shading", group=G_DR, inline="dr1")
bool i_drEQ          = input.bool(true, "EQ Line", group=G_DR, inline="dr1")
bool i_drLabels      = input.bool(true, "Labels", group=G_DR, inline="dr2")
bool i_drPrice       = input.bool(false, "Price", group=G_DR, inline="dr2")

bool i_showDR_21D    = input.bool(false, "21-Day", group=G_DR, inline="drt1")
bool i_showDR_3D     = input.bool(true, "3-Day", group=G_DR, inline="drt1")
bool i_showDR_1D     = input.bool(true, "Daily", group=G_DR, inline="drt1")
bool i_showDR_Asia   = input.bool(false, "Asia", group=G_DR, inline="drt2")
bool i_showDR_LDN    = input.bool(false, "London", group=G_DR, inline="drt2")
bool i_showDR_NY     = input.bool(false, "NY", group=G_DR, inline="drt2")

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                      HTF ORDERFLOW                                             ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

bool   i_showHTF     = input.bool(true, "Show HTF Candles", group=G_HTF, tooltip=TT_HTF)
string i_htfTF       = input.string("Auto", "Timeframe", options=["Auto", "5", "15", "30", "60", "240", "D", "W"], group=G_HTF, inline="htf1")
int    i_htfCount    = input.int(5, "Count", minval=1, maxval=6, group=G_HTF, inline="htf1")
int    i_htfOffset   = input.int(20, "Offset", minval=5, maxval=100, group=G_HTF, inline="htf2")
bool   i_htfOHL      = input.bool(true, "O/H/L Lines", group=G_HTF, inline="htf3")
bool   i_htfTimer    = input.bool(true, "Timer", group=G_HTF, inline="htf3")
string i_htfStyle    = input.string("Modern", "Style", options=["Modern", "Classic", "Hollow"], group=G_HTF, inline="htf4")

// ══════════════════════════════════════════════════════════════════════════════════════════════════════
// ═══                                    ICT MACRO TIMES                                             ═══
// ══════════════════════════════════════════════════════════════════════════════════════════════════════

bool   i_showMacros    = input.bool(true, "Enable Macro Times", group=G_MACROS, tooltip=TT_MACRO)
string i_macroStyle    = input.string("Brackets", "Style", options=["Brackets", "Background", "Both"], group=G_MACROS, inline="ms1")
color  i_macroColor    = input.color(#FF6D00, "Color", group=G_MACROS, inline="ms1")
bool   i_macroLabels   = input.bool(true, "Labels", group=G_MACROS, inline="ms2")
bool   i_macroShowTime = input.bool(true, "Show Time", group=G_MACROS, inline="ms2")
int    i_macroBgTrans  = input.int(90, "BG Trans", minval=70, maxval=98, group=G_MACROS, inline="ms3")

bool i_m_0245 = input.bool(true, "02:45", group=G_MACROS, inline="m1")
bool i_m_0345 = input.bool(true, "03:45", group=G_MACROS, inline="m1")
bool i_m_0445 = input.bool(true, "04:45", group=G_MACROS, inline="m1")
bool i_m_0945 = input.bool(true, "09:45", group=G_MACROS, inline="m2")
bool i_m_1045 = input.bool(true, "10:45", group=G_MACROS, inline="m2")
