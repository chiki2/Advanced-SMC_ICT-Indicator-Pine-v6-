float minSize = syminfo.mintick * 3

bool isNewWeek  = ta.change(time("W")) != 0
bool isNewMonth = ta.change(time("M")) != 0
bool isNewDay   = ta.change(time("D")) != 0

bool inAsia   = f_inSession(i_asiaStart, i_asiaEnd)
bool inLondon = f_inSession(i_londonStart, i_londonEnd)
