bool inNYPM   = f_inSession(i_nypmStart, i_nypmEnd)
bool inNY     = inNYAM or inNYPM

float tolerance    = close * (i_eqhlTol / 100)
float swingHighEQ  = ta.pivothigh(high, 5, 5)
float swingLowEQ   = ta.pivotlow(low, 5, 5)
float pivotHi      = ta.pivothigh(high, i_liqSwingLen, i_liqSwingLen)
float pivotLo      = ta.pivotlow(low, i_liqSwingLen, i_liqSwingLen)
float mssPivotHi   = ta.pivothigh(high, i_mssLen, i_mssLen)
float mssPivotLo   = ta.pivotlow(low, i_mssLen, i_mssLen)

float bodySize   = math.abs(close - open)
float upperWick  = high - math.max(close, open)
float lowerWick  = math.min(close, open) - low
float avgVolume  = ta.sma(volume, 20)

// Macro time checks
bool macro_0245 = i_m_0245 and f_inMacroTime(2, 45, 3, 15)
bool macro_0345 = i_m_0345 and f_inMacroTime(3, 45, 4, 15)
bool macro_0445 = i_m_0445 and f_inMacroTime(4, 45, 5, 15)
bool macro_0945 = i_m_0945 and f_inMacroTime(9, 45, 10, 15)
bool macro_1045 = i_m_1045 and f_inMacroTime(10, 45, 11, 15)
bool macro_1345 = i_m_1345 and f_inMacroTime(13, 45, 14, 15)
bool macro_1445 = i_m_1445 and f_inMacroTime(14, 45, 15, 15)
bool macro_1515 = i_m_1515 and f_inMacroTime(15, 15, 15, 45)
bool macro_1545 = i_m_1545 and f_inMacroTime(15, 45, 16, 15)

bool inAnyMacro = i_showMacros and (macro_0245 or macro_0345 or macro_0445 or macro_0945 or macro_1045 or macro_1345 or macro_1445 or macro_1515 or macro_1545)

f_getCurrentMacroLabel() =>
    if macro_0245
        "02:45-03:15"
    else if macro_0345
        "03:45-04:15"
    else if macro_0445
        "04:45-05:15"
    else if macro_0945
        "09:45-10:15"
    else if macro_1045
        "10:45-11:15"
    else if macro_1345
        "13:45-14:15"
    else if macro_1445
        "14:45-15:15"
    else if macro_1515
        "15:15-15:45"
    else if macro_1545
        "15:45-16:15"
    else
        ""

string currentMacroLbl = f_getCurrentMacroLabel()

