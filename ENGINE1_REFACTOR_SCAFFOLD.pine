//@version=6
indicator("ENGINE 1 Refactor Scaffold", overlay=true, max_lines_count=1, max_labels_count=1, max_boxes_count=1)

//------------------------------------------------------------------------------
// ENGINE 1 REFACTOR SCAFFOLD
// Closed-candle MTF buffer + snapshot contract.
// This file is a standalone scaffold meant to be copied into the main script
// during the refactor. It is intentionally limited to Engine 1 only.
//------------------------------------------------------------------------------

//------------------------------------------------------------------------------
// Shared TF contract
//------------------------------------------------------------------------------
string TF_M1 = "1"
string TF_M5 = "5"
string TF_M15 = "15"
string TF_M30 = "30"
string TF_H1 = "60"
string TF_H4 = "240"
string TF_D1 = "1D"

int BUF_CAP = 300
int SWING_LEN = 3

f_ictContextHtf(float chartSeconds) =>
    na(chartSeconds) ? "" :
         chartSeconds == timeframe.in_seconds("1") ? TF_M15 :
         chartSeconds == timeframe.in_seconds("5") ? TF_M15 :
         chartSeconds == timeframe.in_seconds("15") ? TF_M30 :
         chartSeconds == timeframe.in_seconds("30") ? TF_H1 :
         chartSeconds == timeframe.in_seconds("60") ? TF_H4 : ""

f_ictNarrativeHtf(float chartSeconds) =>
    na(chartSeconds) ? "" :
         chartSeconds == timeframe.in_seconds("1") ? TF_M30 :
         chartSeconds == timeframe.in_seconds("5") ? TF_H1 :
         chartSeconds == timeframe.in_seconds("15") ? TF_H1 :
         chartSeconds == timeframe.in_seconds("30") ? TF_H4 :
         chartSeconds == timeframe.in_seconds("60") ? TF_D1 : ""

string eng_exec_tf = timeframe.main_period
string eng_ctx_tf = f_ictContextHtf(timeframe.in_seconds())
string eng_narr_tf = f_ictNarrativeHtf(timeframe.in_seconds())
bool eng_exec_valid = eng_ctx_tf != "" and eng_narr_tf != ""

//------------------------------------------------------------------------------
// Generic buffer helpers
//------------------------------------------------------------------------------
f_buf_push_int(array<int> buf, int value, int cap) =>
    if not na(value)
        array.unshift(buf, value)
        while array.size(buf) > cap
            array.pop(buf)

f_buf_push_float(array<float> buf, float value, int cap) =>
    if not na(value)
        array.unshift(buf, value)
        while array.size(buf) > cap
            array.pop(buf)

f_buf_get_float(array<float> buf, int idx) =>
    array.size(buf) > idx ? array.get(buf, idx) : na

f_buf_get_int(array<int> buf, int idx) =>
    array.size(buf) > idx ? array.get(buf, idx) : na

f_tf_closed_ohlc(string tf) =>
    [t, o, h, l, c] = request.security(syminfo.tickerid, tf, [time[1], open[1], high[1], low[1], close[1]], lookahead=barmerge.lookahead_off)
    [t, o, h, l, c]

f_tf_update_ohlc_buffer(string tf, int lastClosedTime, array<int> arrT, array<float> arrO, array<float> arrH, array<float> arrL, array<float> arrC, int cap) =>
    [closedTime, closedOpen, closedHigh, closedLow, closedClose] = f_tf_closed_ohlc(tf)
    bool newClosed = not na(closedTime) and closedTime != lastClosedTime
    int nextLastClosedTime = lastClosedTime
    if newClosed
        f_buf_push_int(arrT, closedTime, cap)
        f_buf_push_float(arrO, closedOpen, cap)
        f_buf_push_float(arrH, closedHigh, cap)
        f_buf_push_float(arrL, closedLow, cap)
        f_buf_push_float(arrC, closedClose, cap)
        nextLastClosedTime := closedTime
    [newClosed, nextLastClosedTime]

//------------------------------------------------------------------------------
// Structure / liquidity / zone skeleton helpers
// These are compile-safe scaffolds. Replace internals during refactor.
//------------------------------------------------------------------------------
f_tf_build_structure(array<int> arrT, array<float> arrH, array<float> arrL, array<float> arrC, int swingLen) =>
    float lastHigh = na
    int lastHighBar = na
    float prevHigh = na
    int prevHighBar = na
    float lastLow = na
    int lastLowBar = na
    float prevLow = na
    int prevLowBar = na
    bool bullBos = false
    bool bearBos = false
    bool bullChoch = false
    bool bearChoch = false
    int structureBias = 0
    [lastHigh, lastHighBar, prevHigh, prevHighBar, lastLow, lastLowBar, prevLow, prevLowBar, bullBos, bearBos, bullChoch, bearChoch, structureBias]

f_tf_build_liquidity(array<float> arrH, array<float> arrL, array<float> arrC) =>
    float eqh = na
    float eql = na
    float erlHigh = na
    float erlLow = na
    float irlHigh = na
    float irlLow = na
    bool eqhActive = false
    bool eqlActive = false
    [eqh, eql, erlHigh, erlLow, irlHigh, irlLow, eqhActive, eqlActive]

f_tf_build_pd_arrays(float lastHigh, float lastLow) =>
    float rangeHigh = lastHigh
    float rangeLow = lastLow
    float equilibrium = not na(rangeHigh) and not na(rangeLow) ? (rangeHigh + rangeLow) * 0.5 : na
    float oteLongTop = na
    float oteLongBottom = na
    float oteShortTop = na
    float oteShortBottom = na
    [rangeHigh, rangeLow, equilibrium, oteLongTop, oteLongBottom, oteShortTop, oteShortBottom]

f_tf_build_fvg(array<float> arrH, array<float> arrL, array<float> arrC) =>
    float bullTop = na
    float bullBottom = na
    int bullBar = na
    float bearTop = na
    float bearBottom = na
    int bearBar = na
    [bullTop, bullBottom, bullBar, bearTop, bearBottom, bearBar]

f_tf_build_ob(array<float> arrO, array<float> arrH, array<float> arrL, array<float> arrC) =>
    float bullTop = na
    float bullBottom = na
    float bullEntry = na
    int bullBar = na
    bool bullBreaker = false
    float bearTop = na
    float bearBottom = na
    float bearEntry = na
    int bearBar = na
    bool bearBreaker = false
    [bullTop, bullBottom, bullEntry, bullBar, bullBreaker, bearTop, bearBottom, bearEntry, bearBar, bearBreaker]

f_tf_build_execution(float lastHigh, float lastLow, array<float> arrH, array<float> arrL, array<float> arrC) =>
    bool bullSweep = false
    bool bearSweep = false
    bool bullDisplacement = false
    bool bearDisplacement = false
    bool bullMss = false
    bool bearMss = false
    float mssRefHigh = lastHigh
    float mssRefLow = lastLow
    [bullSweep, bearSweep, bullDisplacement, bearDisplacement, bullMss, bearMss, mssRefHigh, mssRefLow]

f_regime_bias(float closeValue, float refValue) =>
    na(closeValue) or na(refValue) ? 0 : closeValue > refValue ? 1 : closeValue < refValue ? -1 : 0

f_regime_strength_text(int bias, float closeValue, float refValue, float atrValue) =>
    if bias == 0 or na(closeValue) or na(refValue) or na(atrValue) or atrValue <= 0
        "Flat"
    else
        float distance = math.abs(closeValue - refValue)
        distance >= atrValue ? "Strong" : "Normal"

