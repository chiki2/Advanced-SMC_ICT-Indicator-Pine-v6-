f_select_narrative_snapshot(string tf) =>
    if tf == TF_M30
        narr_bias := m30_trend_bias
        narr_liq_high := m30_eqh_active ? m30_eqh : m30_last_swing_high
        narr_liq_low := m30_eql_active ? m30_eql : m30_last_swing_low
        narr_bull_sd_top := m30_bull_ob_top
        narr_bull_sd_bottom := m30_bull_ob_bottom
        narr_bear_sd_top := m30_bear_ob_top
        narr_bear_sd_bottom := m30_bear_ob_bottom
    else if tf == TF_H1
        narr_bias := h1_trend_bias
        narr_liq_high := h1_eqh_active ? h1_eqh : h1_last_swing_high
        narr_liq_low := h1_eql_active ? h1_eql : h1_last_swing_low
        narr_bull_sd_top := h1_bull_ob_top
        narr_bull_sd_bottom := h1_bull_ob_bottom
        narr_bear_sd_top := h1_bear_ob_top
        narr_bear_sd_bottom := h1_bear_ob_bottom
    else if tf == TF_H4
        narr_bias := h4_trend_bias
        narr_liq_high := h4_eqh_active ? h4_eqh : h4_last_swing_high
        narr_liq_low := h4_eql_active ? h4_eql : h4_last_swing_low
        narr_bull_sd_top := h4_bull_ob_top
        narr_bull_sd_bottom := h4_bull_ob_bottom
        narr_bear_sd_top := h4_bear_ob_top
        narr_bear_sd_bottom := h4_bear_ob_bottom
    else if tf == TF_D1
        narr_bias := d1_trend_bias
        narr_liq_high := d1_eqh_active ? d1_eqh : d1_last_swing_high
        narr_liq_low := d1_eql_active ? d1_eql : d1_last_swing_low
        narr_bull_sd_top := d1_bull_ob_top
        narr_bull_sd_bottom := d1_bull_ob_bottom
        narr_bear_sd_top := d1_bear_ob_top
        narr_bear_sd_bottom := d1_bear_ob_bottom
    narr_strength := "Normal"

f_select_context_snapshot(string tf) =>
    if tf == TF_M15
        ctx_trend_bias := m15_trend_bias
        ctx_bull_ob_top := m15_bull_ob_top
        ctx_bull_ob_bottom := m15_bull_ob_bottom
        ctx_bull_fvg_top := m15_bull_fvg_top
        ctx_bull_fvg_bottom := m15_bull_fvg_bottom
        ctx_bear_ob_top := m15_bear_ob_top
        ctx_bear_ob_bottom := m15_bear_ob_bottom
        ctx_bear_fvg_top := m15_bear_fvg_top
        ctx_bear_fvg_bottom := m15_bear_fvg_bottom
        ctx_liq_high := m15_eqh_active ? m15_eqh : m15_last_swing_high
        ctx_liq_low := m15_eql_active ? m15_eql : m15_last_swing_low
    else if tf == TF_M30
        ctx_trend_bias := m30_trend_bias
        ctx_bull_ob_top := m30_bull_ob_top
        ctx_bull_ob_bottom := m30_bull_ob_bottom
        ctx_bull_fvg_top := m30_bull_fvg_top
        ctx_bull_fvg_bottom := m30_bull_fvg_bottom
        ctx_bear_ob_top := m30_bear_ob_top
        ctx_bear_ob_bottom := m30_bear_ob_bottom
        ctx_bear_fvg_top := m30_bear_fvg_top
        ctx_bear_fvg_bottom := m30_bear_fvg_bottom
        ctx_liq_high := m30_eqh_active ? m30_eqh : m30_last_swing_high
        ctx_liq_low := m30_eql_active ? m30_eql : m30_last_swing_low
    else if tf == TF_H1
        ctx_trend_bias := h1_trend_bias
        ctx_bull_ob_top := h1_bull_ob_top
        ctx_bull_ob_bottom := h1_bull_ob_bottom
        ctx_bull_fvg_top := h1_bull_fvg_top
        ctx_bull_fvg_bottom := h1_bull_fvg_bottom
        ctx_bear_ob_top := h1_bear_ob_top
        ctx_bear_ob_bottom := h1_bear_ob_bottom
        ctx_bear_fvg_top := h1_bear_fvg_top
        ctx_bear_fvg_bottom := h1_bear_fvg_bottom
        ctx_liq_high := h1_eqh_active ? h1_eqh : h1_last_swing_high
        ctx_liq_low := h1_eql_active ? h1_eql : h1_last_swing_low
    else if tf == TF_H4
        ctx_trend_bias := h4_trend_bias
        ctx_bull_ob_top := h4_bull_ob_top
        ctx_bull_ob_bottom := h4_bull_ob_bottom
        ctx_bull_fvg_top := h4_bull_fvg_top
        ctx_bull_fvg_bottom := h4_bull_fvg_bottom
        ctx_bear_ob_top := h4_bear_ob_top
        ctx_bear_ob_bottom := h4_bear_ob_bottom
        ctx_bear_fvg_top := h4_bear_fvg_top
        ctx_bear_fvg_bottom := h4_bear_fvg_bottom
        ctx_liq_high := h4_eqh_active ? h4_eqh : h4_last_swing_high
        ctx_liq_low := h4_eql_active ? h4_eql : h4_last_swing_low
    ctx_bull_breakout := ctx_trend_bias == 1
    ctx_bear_breakout := ctx_trend_bias == -1
    ctx_bull_reversal := false
    ctx_bear_reversal := false

f_select_execution_snapshot(string tf) =>
    if tf == TF_M1
        exe_trend_bias := m1_trend_bias
        exe_bull_sweep := m1_bull_sweep
        exe_bear_sweep := m1_bear_sweep
        exe_bull_displacement := m1_bull_displacement
        exe_bear_displacement := m1_bear_displacement
        exe_bull_mss := m1_bull_mss
        exe_bear_mss := m1_bear_mss
        exe_mss_ref_high := m1_mss_ref_high
        exe_mss_ref_low := m1_mss_ref_low
    else if tf == TF_M5
        exe_trend_bias := m5_trend_bias
        exe_bull_sweep := m5_bull_sweep
        exe_bear_sweep := m5_bear_sweep
        exe_bull_displacement := m5_bull_displacement
        exe_bear_displacement := m5_bear_displacement
        exe_bull_mss := m5_bull_mss
        exe_bear_mss := m5_bear_mss
        exe_mss_ref_high := m5_mss_ref_high
        exe_mss_ref_low := m5_mss_ref_low
    else if tf == TF_M15
        exe_trend_bias := m15_trend_bias
        exe_bull_sweep := m15_bull_sweep
        exe_bear_sweep := m15_bear_sweep
        exe_bull_displacement := m15_bull_displacement
        exe_bear_displacement := m15_bear_displacement
        exe_bull_mss := m15_bull_mss
        exe_bear_mss := m15_bear_mss
        exe_mss_ref_high := m15_mss_ref_high
        exe_mss_ref_low := m15_mss_ref_low
    else if tf == TF_M30
        exe_trend_bias := m30_trend_bias
        exe_bull_sweep := m30_bull_sweep
        exe_bear_sweep := m30_bear_sweep
        exe_bull_displacement := m30_bull_displacement
        exe_bear_displacement := m30_bear_displacement
        exe_bull_mss := m30_bull_mss
        exe_bear_mss := m30_bear_mss
        exe_mss_ref_high := m30_mss_ref_high
        exe_mss_ref_low := m30_mss_ref_low
    else if tf == TF_H1
        exe_trend_bias := h1_trend_bias
        exe_bull_sweep := h1_bull_sweep
        exe_bear_sweep := h1_bear_sweep
        exe_bull_displacement := h1_bull_displacement
        exe_bear_displacement := h1_bear_displacement
        exe_bull_mss := h1_bull_mss
        exe_bear_mss := h1_bear_mss
        exe_mss_ref_high := h1_mss_ref_high
        exe_mss_ref_low := h1_mss_ref_low

//------------------------------------------------------------------------------
// Update buffers
//------------------------------------------------------------------------------
[m1_new_closed, m1_last_closed_time] := f_tf_update_ohlc_buffer(TF_M1, m1_last_closed_time, buf_m1_time, buf_m1_open, buf_m1_high, buf_m1_low, buf_m1_close, BUF_CAP)
[m5_new_closed, m5_last_closed_time] := f_tf_update_ohlc_buffer(TF_M5, m5_last_closed_time, buf_m5_time, buf_m5_open, buf_m5_high, buf_m5_low, buf_m5_close, BUF_CAP)
[m15_new_closed, m15_last_closed_time] := f_tf_update_ohlc_buffer(TF_M15, m15_last_closed_time, buf_m15_time, buf_m15_open, buf_m15_high, buf_m15_low, buf_m15_close, BUF_CAP)
[m30_new_closed, m30_last_closed_time] := f_tf_update_ohlc_buffer(TF_M30, m30_last_closed_time, buf_m30_time, buf_m30_open, buf_m30_high, buf_m30_low, buf_m30_close, BUF_CAP)
[h1_new_closed, h1_last_closed_time] := f_tf_update_ohlc_buffer(TF_H1, h1_last_closed_time, buf_h1_time, buf_h1_open, buf_h1_high, buf_h1_low, buf_h1_close, BUF_CAP)
[h4_new_closed, h4_last_closed_time] := f_tf_update_ohlc_buffer(TF_H4, h4_last_closed_time, buf_h4_time, buf_h4_open, buf_h4_high, buf_h4_low, buf_h4_close, BUF_CAP)
[d1_new_closed, d1_last_closed_time] := f_tf_update_ohlc_buffer(TF_D1, d1_last_closed_time, buf_d1_time, buf_d1_open, buf_d1_high, buf_d1_low, buf_d1_close, BUF_CAP)

//------------------------------------------------------------------------------
// Build snapshots
//------------------------------------------------------------------------------
[m1_last_swing_high, _, _, _, m1_last_swing_low, _, _, _, _, _, _, _, m1_trend_bias] = f_tf_build_structure(buf_m1_time, buf_m1_high, buf_m1_low, buf_m1_close, SWING_LEN)
[m5_last_swing_high, _, _, _, m5_last_swing_low, _, _, _, _, _, _, _, m5_trend_bias] = f_tf_build_structure(buf_m5_time, buf_m5_high, buf_m5_low, buf_m5_close, SWING_LEN)
[m15_last_swing_high, _, _, _, m15_last_swing_low, _, _, _, _, _, _, _, m15_trend_bias] = f_tf_build_structure(buf_m15_time, buf_m15_high, buf_m15_low, buf_m15_close, SWING_LEN)
[m30_last_swing_high, _, _, _, m30_last_swing_low, _, _, _, _, _, _, _, m30_trend_bias] = f_tf_build_structure(buf_m30_time, buf_m30_high, buf_m30_low, buf_m30_close, SWING_LEN)
[h1_last_swing_high, _, _, _, h1_last_swing_low, _, _, _, _, _, _, _, h1_trend_bias] = f_tf_build_structure(buf_h1_time, buf_h1_high, buf_h1_low, buf_h1_close, SWING_LEN)
[h4_last_swing_high, _, _, _, h4_last_swing_low, _, _, _, _, _, _, _, h4_trend_bias] = f_tf_build_structure(buf_h4_time, buf_h4_high, buf_h4_low, buf_h4_close, SWING_LEN)
[d1_last_swing_high, _, _, _, d1_last_swing_low, _, _, _, _, _, _, _, d1_trend_bias] = f_tf_build_structure(buf_d1_time, buf_d1_high, buf_d1_low, buf_d1_close, SWING_LEN)

[m1_eqh, m1_eql, _, _, _, _, m1_eqh_active, m1_eql_active] := f_tf_build_liquidity(buf_m1_high, buf_m1_low, buf_m1_close)
[m5_eqh, m5_eql, _, _, _, _, m5_eqh_active, m5_eql_active] := f_tf_build_liquidity(buf_m5_high, buf_m5_low, buf_m5_close)
[m15_eqh, m15_eql, _, _, _, _, m15_eqh_active, m15_eql_active] := f_tf_build_liquidity(buf_m15_high, buf_m15_low, buf_m15_close)
[m30_eqh, m30_eql, _, _, _, _, m30_eqh_active, m30_eql_active] := f_tf_build_liquidity(buf_m30_high, buf_m30_low, buf_m30_close)
[h1_eqh, h1_eql, _, _, _, _, h1_eqh_active, h1_eql_active] := f_tf_build_liquidity(buf_h1_high, buf_h1_low, buf_h1_close)
[h4_eqh, h4_eql, _, _, _, _, h4_eqh_active, h4_eql_active] := f_tf_build_liquidity(buf_h4_high, buf_h4_low, buf_h4_close)
[d1_eqh, d1_eql, _, _, _, _, d1_eqh_active, d1_eql_active] := f_tf_build_liquidity(buf_d1_high, buf_d1_low, buf_d1_close)

[m1_bull_ob_top, m1_bull_ob_bottom, _, _, _, m1_bear_ob_top, m1_bear_ob_bottom, _, _, _] = f_tf_build_ob(buf_m1_open, buf_m1_high, buf_m1_low, buf_m1_close)
[m5_bull_ob_top, m5_bull_ob_bottom, _, _, _, m5_bear_ob_top, m5_bear_ob_bottom, _, _, _] = f_tf_build_ob(buf_m5_open, buf_m5_high, buf_m5_low, buf_m5_close)
[m15_bull_ob_top, m15_bull_ob_bottom, _, _, _, m15_bear_ob_top, m15_bear_ob_bottom, _, _, _] = f_tf_build_ob(buf_m15_open, buf_m15_high, buf_m15_low, buf_m15_close)
[m30_bull_ob_top, m30_bull_ob_bottom, _, _, _, m30_bear_ob_top, m30_bear_ob_bottom, _, _, _] = f_tf_build_ob(buf_m30_open, buf_m30_high, buf_m30_low, buf_m30_close)
[h1_bull_ob_top, h1_bull_ob_bottom, _, _, _, h1_bear_ob_top, h1_bear_ob_bottom, _, _, _] = f_tf_build_ob(buf_h1_open, buf_h1_high, buf_h1_low, buf_h1_close)
[h4_bull_ob_top, h4_bull_ob_bottom, _, _, _, h4_bear_ob_top, h4_bear_ob_bottom, _, _, _] = f_tf_build_ob(buf_h4_open, buf_h4_high, buf_h4_low, buf_h4_close)
[d1_bull_ob_top, d1_bull_ob_bottom, _, _, _, d1_bear_ob_top, d1_bear_ob_bottom, _, _, _] = f_tf_build_ob(buf_d1_open, buf_d1_high, buf_d1_low, buf_d1_close)

[m1_bull_fvg_top, m1_bull_fvg_bottom, _, m1_bear_fvg_top, m1_bear_fvg_bottom, _] = f_tf_build_fvg(buf_m1_high, buf_m1_low, buf_m1_close)
[m5_bull_fvg_top, m5_bull_fvg_bottom, _, m5_bear_fvg_top, m5_bear_fvg_bottom, _] = f_tf_build_fvg(buf_m5_high, buf_m5_low, buf_m5_close)
[m15_bull_fvg_top, m15_bull_fvg_bottom, _, m15_bear_fvg_top, m15_bear_fvg_bottom, _] = f_tf_build_fvg(buf_m15_high, buf_m15_low, buf_m15_close)
[m30_bull_fvg_top, m30_bull_fvg_bottom, _, m30_bear_fvg_top, m30_bear_fvg_bottom, _] = f_tf_build_fvg(buf_m30_high, buf_m30_low, buf_m30_close)
[h1_bull_fvg_top, h1_bull_fvg_bottom, _, h1_bear_fvg_top, h1_bear_fvg_bottom, _] = f_tf_build_fvg(buf_h1_high, buf_h1_low, buf_h1_close)
[h4_bull_fvg_top, h4_bull_fvg_bottom, _, h4_bear_fvg_top, h4_bear_fvg_bottom, _] = f_tf_build_fvg(buf_h4_high, buf_h4_low, buf_h4_close)
[d1_bull_fvg_top, d1_bull_fvg_bottom, _, d1_bear_fvg_top, d1_bear_fvg_bottom, _] = f_tf_build_fvg(buf_d1_high, buf_d1_low, buf_d1_close)

[m1_bull_sweep, m1_bear_sweep, m1_bull_displacement, m1_bear_displacement, m1_bull_mss, m1_bear_mss, m1_mss_ref_high, m1_mss_ref_low] = f_tf_build_execution(m1_last_swing_high, m1_last_swing_low, buf_m1_high, buf_m1_low, buf_m1_close)
[m5_bull_sweep, m5_bear_sweep, m5_bull_displacement, m5_bear_displacement, m5_bull_mss, m5_bear_mss, m5_mss_ref_high, m5_mss_ref_low] = f_tf_build_execution(m5_last_swing_high, m5_last_swing_low, buf_m5_high, buf_m5_low, buf_m5_close)
[m15_bull_sweep, m15_bear_sweep, m15_bull_displacement, m15_bear_displacement, m15_bull_mss, m15_bear_mss, m15_mss_ref_high, m15_mss_ref_low] = f_tf_build_execution(m15_last_swing_high, m15_last_swing_low, buf_m15_high, buf_m15_low, buf_m15_close)
[m30_bull_sweep, m30_bear_sweep, m30_bull_displacement, m30_bear_displacement, m30_bull_mss, m30_bear_mss, m30_mss_ref_high, m30_mss_ref_low] = f_tf_build_execution(m30_last_swing_high, m30_last_swing_low, buf_m30_high, buf_m30_low, buf_m30_close)
[h1_bull_sweep, h1_bear_sweep, h1_bull_displacement, h1_bear_displacement, h1_bull_mss, h1_bear_mss, h1_mss_ref_high, h1_mss_ref_low] = f_tf_build_execution(h1_last_swing_high, h1_last_swing_low, buf_h1_high, buf_h1_low, buf_h1_close)
[h4_bull_sweep, h4_bear_sweep, h4_bull_displacement, h4_bear_displacement, h4_bull_mss, h4_bear_mss, h4_mss_ref_high, h4_mss_ref_low] = f_tf_build_execution(h4_last_swing_high, h4_last_swing_low, buf_h4_high, buf_h4_low, buf_h4_close)
[d1_bull_sweep, d1_bear_sweep, d1_bull_displacement, d1_bear_displacement, d1_bull_mss, d1_bear_mss, d1_mss_ref_high, d1_mss_ref_low] = f_tf_build_execution(d1_last_swing_high, d1_last_swing_low, buf_d1_high, buf_d1_low, buf_d1_close)

