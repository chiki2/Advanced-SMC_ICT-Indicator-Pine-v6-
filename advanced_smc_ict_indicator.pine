    eng1_ctx_liq_low_bar := eng1_h1_eql_active ? eng1_h1_eql_bar : eng1_h1_last_swing_low_bar
else if eng1_ctx_tf == ENG1_TF_H4
    eng1_ctx_trend_bias := eng1_h4_trend_bias
    eng1_ctx_bull_reversal := eng1_h4_bull_ob_breaker
    eng1_ctx_bear_reversal := eng1_h4_bear_ob_breaker
