    eng1_ctx_bull_ob_bar := eng1_d1_bull_ob_bar
    eng1_ctx_bull_fvg_top := eng1_d1_bull_fvg_top
    eng1_ctx_bull_fvg_bottom := eng1_d1_bull_fvg_bottom
    eng1_ctx_bull_fvg_bar := eng1_d1_bull_fvg_bar
    eng1_ctx_bear_ob_top := eng1_d1_bear_ob_top
    eng1_ctx_bear_ob_bottom := eng1_d1_bear_ob_bottom
    eng1_ctx_bear_ob_entry := eng1_d1_bear_ob_entry
    eng1_ctx_bear_ob_bar := eng1_d1_bear_ob_bar
    eng1_ctx_bear_fvg_top := eng1_d1_bear_fvg_top
    eng1_ctx_bear_fvg_bottom := eng1_d1_bear_fvg_bottom
    eng1_ctx_bear_fvg_bar := eng1_d1_bear_fvg_bar
    eng1_ctx_liq_high := eng1_d1_eqh_active ? eng1_d1_eqh : eng1_d1_last_swing_high
    eng1_ctx_liq_low := eng1_d1_eql_active ? eng1_d1_eql : eng1_d1_last_swing_low
    eng1_ctx_liq_high_bar := eng1_d1_eqh_active ? eng1_d1_eqh_bar : eng1_d1_last_swing_high_bar
    eng1_ctx_liq_low_bar := eng1_d1_eql_active ? eng1_d1_eql_bar : eng1_d1_last_swing_low_bar
eng1_ctx_bull_breakout := false
eng1_ctx_bear_breakout := false
eng1_ctx_bull_choch := false
eng1_ctx_bear_choch := false
if eng1_ctx_tf == ENG1_TF_M15
    eng1_ctx_bull_breakout := eng1_m15_bull_bos
    eng1_ctx_bear_breakout := eng1_m15_bear_bos
    eng1_ctx_bull_choch := eng1_m15_bull_choch
    eng1_ctx_bear_choch := eng1_m15_bear_choch
else if eng1_ctx_tf == ENG1_TF_M30
    eng1_ctx_bull_breakout := eng1_m30_bull_bos
    eng1_ctx_bear_breakout := eng1_m30_bear_bos
    eng1_ctx_bull_choch := eng1_m30_bull_choch
    eng1_ctx_bear_choch := eng1_m30_bear_choch
else if eng1_ctx_tf == ENG1_TF_H1
    eng1_ctx_bull_breakout := eng1_h1_bull_bos
    eng1_ctx_bear_breakout := eng1_h1_bear_bos
    eng1_ctx_bull_choch := eng1_h1_bull_choch
    eng1_ctx_bear_choch := eng1_h1_bear_choch
else if eng1_ctx_tf == ENG1_TF_H4
    eng1_ctx_bull_breakout := eng1_h4_bull_bos
    eng1_ctx_bear_breakout := eng1_h4_bear_bos
    eng1_ctx_bull_choch := eng1_h4_bull_choch
    eng1_ctx_bear_choch := eng1_h4_bear_choch
else if eng1_ctx_tf == ENG1_TF_D1
    eng1_ctx_bull_breakout := eng1_d1_bull_bos
    eng1_ctx_bear_breakout := eng1_d1_bear_bos
    eng1_ctx_bull_choch := eng1_d1_bull_choch
    eng1_ctx_bear_choch := eng1_d1_bear_choch
[eng1_exe_bull_sweep_tmp, eng1_exe_bear_sweep_tmp, eng1_exe_bull_mss_tmp, eng1_exe_bear_mss_tmp, eng1_exe_bull_displacement_tmp, eng1_exe_bear_displacement_tmp, eng1_exe_trend_bias_tmp, eng1_exe_mss_ref_high_tmp, eng1_exe_mss_ref_low_tmp] = f_eng1_select_execution_snapshot(eng1_exec_tf)
[eng1_exe_eqh_tmp, eng1_exe_eql_tmp, eng1_exe_eqh_active_tmp, eng1_exe_eql_active_tmp, eng1_exe_swing_high_tmp, eng1_exe_swing_low_tmp] = f_eng1_select_execution_snapshot_levels(eng1_exec_tf)

eng1_exe_bull_bos := false
eng1_exe_bear_bos := false
eng1_exe_bull_choch := false
eng1_exe_bear_choch := false
if eng1_exec_tf == ENG1_TF_M1
    eng1_exe_bull_bos := eng1_m1_bull_bos
    eng1_exe_bear_bos := eng1_m1_bear_bos
    eng1_exe_bull_choch := eng1_m1_bull_choch
    eng1_exe_bear_choch := eng1_m1_bear_choch
else if eng1_exec_tf == ENG1_TF_M5
    eng1_exe_bull_bos := eng1_m5_bull_bos
    eng1_exe_bear_bos := eng1_m5_bear_bos
    eng1_exe_bull_choch := eng1_m5_bull_choch
    eng1_exe_bear_choch := eng1_m5_bear_choch
else if eng1_exec_tf == ENG1_TF_M15
    eng1_exe_bull_bos := eng1_m15_bull_bos
    eng1_exe_bear_bos := eng1_m15_bear_bos
    eng1_exe_bull_choch := eng1_m15_bull_choch
    eng1_exe_bear_choch := eng1_m15_bear_choch
else if eng1_exec_tf == ENG1_TF_M30
    eng1_exe_bull_bos := eng1_m30_bull_bos
    eng1_exe_bear_bos := eng1_m30_bear_bos
    eng1_exe_bull_choch := eng1_m30_bull_choch
    eng1_exe_bear_choch := eng1_m30_bear_choch

if eng1_exec_valid
    eng1_exe_trend_bias := eng1_exe_trend_bias_tmp
    eng1_exe_bull_sweep := eng1_exe_bull_sweep_tmp
    eng1_exe_bear_sweep := eng1_exe_bear_sweep_tmp
    eng1_exe_bull_mss := eng1_exe_bull_mss_tmp
    eng1_exe_bear_mss := eng1_exe_bear_mss_tmp
    eng1_exe_bull_displacement := eng1_exe_bull_displacement_tmp
    eng1_exe_bear_displacement := eng1_exe_bear_displacement_tmp
    eng1_exe_mss_ref_high := eng1_exe_mss_ref_high_tmp
    eng1_exe_mss_ref_low := eng1_exe_mss_ref_low_tmp
    eng1_exe_liq_high := eng1_exe_eqh_active_tmp ? eng1_exe_eqh_tmp : eng1_exe_swing_high_tmp
    eng1_exe_liq_low := eng1_exe_eql_active_tmp ? eng1_exe_eql_tmp : eng1_exe_swing_low_tmp
    eng1_exe_eqh := eng1_exe_eqh_tmp
    eng1_exe_eql := eng1_exe_eql_tmp
    eng1_exe_eqh_active := eng1_exe_eqh_active_tmp
    eng1_exe_eql_active := eng1_exe_eql_active_tmp
else
    // Keep Engine 2 literal to Engine 1 ownership: unsupported execution TFs must
    // not reuse the last valid narrative/context/execution snapshot.
    eng1_narr_bias := 0
    eng1_narr_liq_high := na
    eng1_narr_liq_low := na
    eng1_narr_bull_sd_top := na
    eng1_narr_bull_sd_bottom := na
    eng1_narr_bull_sd_bar := na
    eng1_narr_bear_sd_top := na
    eng1_narr_bear_sd_bottom := na
    eng1_narr_bear_sd_bar := na
    eng1_narr_strength := "Flat"
    eng1_ctx_trend_bias := 0
    eng1_ctx_bull_breakout := false
    eng1_ctx_bear_breakout := false
    eng1_ctx_bull_choch := false
    eng1_ctx_bear_choch := false
    eng1_ctx_bull_reversal := false
    eng1_ctx_bear_reversal := false
    eng1_ctx_bull_ob_top := na
    eng1_ctx_bull_ob_bottom := na
    eng1_ctx_bull_ob_entry := na
    eng1_ctx_bull_ob_bar := na
    eng1_ctx_bull_ob_breaker := false
    eng1_ctx_bull_ob_breaker_time := na
    eng1_ctx_bull_fvg_top := na
    eng1_ctx_bull_fvg_bottom := na
    eng1_ctx_bull_fvg_bar := na
    eng1_ctx_bear_ob_top := na
    eng1_ctx_bear_ob_bottom := na
    eng1_ctx_bear_ob_entry := na
    eng1_ctx_bear_ob_bar := na
    eng1_ctx_bear_ob_breaker := false
    eng1_ctx_bear_ob_breaker_time := na
    eng1_ctx_bear_fvg_top := na
    eng1_ctx_bear_fvg_bottom := na
    eng1_ctx_bear_fvg_bar := na
    eng1_ctx_liq_high := na
    eng1_ctx_liq_low := na
    eng1_ctx_liq_high_bar := na
    eng1_ctx_liq_low_bar := na
    eng1_exe_trend_bias := 0
    eng1_exe_bull_sweep := false
    eng1_exe_bear_sweep := false
    eng1_exe_bull_bos := false
    eng1_exe_bear_bos := false
    eng1_exe_bull_choch := false
    eng1_exe_bear_choch := false
    eng1_exe_bull_mss := false
    eng1_exe_bear_mss := false
    eng1_exe_bull_displacement := false
    eng1_exe_bear_displacement := false
    eng1_exe_mss_ref_high := na
    eng1_exe_mss_ref_low := na
    eng1_exe_liq_high := na
    eng1_exe_liq_low := na
    eng1_exe_eqh := na
    eng1_exe_eql := na
    eng1_exe_eqh_active := false
    eng1_exe_eql_active := false

chartTfLabel = timeframe.main_period
chartTfSeconds = timeframe.in_seconds()
normalizationBaselineTfSeconds = timeframe.in_seconds("5")
expiryBarsEffective = f_timeNormalizedBars(setupExpiryBars, normalizationBaselineTfSeconds, chartTfSeconds, 4)
strictMssLookbackEffective = f_timeNormalizedBars(strictMssLookback, normalizationBaselineTfSeconds, chartTfSeconds, 2)
int ctxTfSeconds = eng1_ctx_tf == ENG1_TF_M15 ? timeframe.in_seconds("15") : eng1_ctx_tf == ENG1_TF_M30 ? timeframe.in_seconds("30") : eng1_ctx_tf == ENG1_TF_H1 ? timeframe.in_seconds("60") : eng1_ctx_tf == ENG1_TF_H4 ? timeframe.in_seconds("240") : eng1_ctx_tf == ENG1_TF_D1 ? timeframe.in_seconds("1D") : normalizationBaselineTfSeconds
int strictPdOwnershipWindow = f_timeNormalizedBars(2, ctxTfSeconds, chartTfSeconds, 2)
if not eng1_exec_valid
    f_trimSessionVisuals(0)
    f_trimStructureVisuals(0)
eng1InvalidTfLabel := f_eng1_sync_invalid_tf_label(eng1InvalidTfLabel, eng1_exec_valid, chartTfLabel, high, atr)

//------------------------------------------------------------------------------
// Session liquidity tracking
//------------------------------------------------------------------------------
inAsiaSession = f_inSessionWindow(asiaSessionWindow)
newAsiaSession = inAsiaSession and not inAsiaSession[1]
asiaSessionEnded = not inAsiaSession and inAsiaSession[1]
inLondonSession = f_inSessionWindow(londonSessionWindow)
newLondonSession = inLondonSession and not inLondonSession[1]
londonSessionEnded = not inLondonSession and inLondonSession[1]
inNewYorkSession = f_inSessionWindow(newYorkSessionWindow)
newNewYorkSession = inNewYorkSession and not inNewYorkSession[1]
newYorkSessionEnded = not inNewYorkSession and inNewYorkSession[1]

bool sessionRangeTrackingNeeded = timeframe.isintraday and (strictModeEnabled or (showSessionVisuals and draw_full))
if sessionRangeTrackingNeeded
    [asiaSessionHighNext, asiaSessionLowNext] = f_updateSessionRange(inAsiaSession, newAsiaSession, asiaSessionHigh, asiaSessionLow)
    [londonSessionHighNext, londonSessionLowNext] = f_updateSessionRange(inLondonSession, newLondonSession, londonSessionHigh, londonSessionLow)
    [newYorkSessionHighNext, newYorkSessionLowNext] = f_updateSessionRange(inNewYorkSession, newNewYorkSession, newYorkSessionHigh, newYorkSessionLow)
    asiaSessionHigh := asiaSessionHighNext
    asiaSessionLow := asiaSessionLowNext
    londonSessionHigh := londonSessionHighNext
    londonSessionLow := londonSessionLowNext
    newYorkSessionHigh := newYorkSessionHighNext
    newYorkSessionLow := newYorkSessionLowNext

//------------------------------------------------------------------------------
// Execution liquidity (Engine 1 owned)
//------------------------------------------------------------------------------

//------------------------------------------------------------------------------
// Calendar liquidity references (ICT naming)
//------------------------------------------------------------------------------
bool calendarLiquidityVisualsEnabled = eng1_exec_valid and showLiquidity and draw_show_htf and not compactMode and f_contextVisualByMode(draw_mode)
bool calendarLiquidityRequestEnabled = barstate.islast and calendarLiquidityVisualsEnabled
bool calendarDayFromEng1Ready = calendarLiquidityRequestEnabled and eng1_d1_active_tf and array.size(eng1_buf_d1_high) > 0 and array.size(eng1_buf_d1_low) > 0
[prevDayHighRequested, prevDayLowRequested] = f_prev_period_high_low(calendarLiquidityRequestEnabled and not calendarDayFromEng1Ready, "D")
prevDayHigh = calendarDayFromEng1Ready ? f_eng1_buf_float_at(eng1_buf_d1_high, 0) : prevDayHighRequested
prevDayLow = calendarDayFromEng1Ready ? f_eng1_buf_float_at(eng1_buf_d1_low, 0) : prevDayLowRequested
[prevWeekHigh, prevWeekLow] = f_prev_period_high_low(calendarLiquidityRequestEnabled, "W")
[prevMonthHigh, prevMonthLow] = f_prev_period_high_low(calendarLiquidityRequestEnabled, "M")

// Active bias aliases (Engine 1 owned). Keep downstream logic on these aliases
// so display, structure visuals, and setup validation read the same snapshot.
int displayExecBias = eng1_exe_trend_bias
int displayCtxBias = eng1_ctx_trend_bias
int displayNarrBias = eng1_narr_bias

//------------------------------------------------------------------------------
// Market structure state (Engine 1 owned)
// Engine 2 no longer derives market structure from chart-active pivots. This
// keeps structure visuals aligned with closed-candle Engine 1 snapshots and
// avoids local pivot churn in #main.
//------------------------------------------------------------------------------
bool eng2StructureVisualsEnabled = eng1_exec_valid and draw_show_structure
[eng2InternalSwingHigh, eng2InternalSwingHighBar, eng2InternalSwingLow, eng2InternalSwingLowBar] = f_eng1_select_execution_structure_points(eng1_exec_tf)
if not eng2StructureVisualsEnabled
    f_trimStructureVisuals(0)
    eng2StructureLastRenderBar := na
    eng2StructureRenderedTfKey := ""
    eng2StructureRenderFingerprint := ""
    eng2InternalLastEventText := ""
    eng2InternalLastEventLeftBar := na
    eng2InternalLastEventLevel := na
    eng2InternalLastEventBias := 0
    eng2SwingLastEventText := ""
    eng2SwingLastEventLeftBar := na
    eng2SwingLastEventLevel := na
    eng2SwingLastEventBias := 0
else
    string eng2ActiveStructureTfKey = eng1_exec_tf + "|" + eng1_ctx_tf
    if eng2StructureRenderedTfKey != eng2ActiveStructureTfKey
        f_trimStructureVisuals(0)
        eng2StructureLastRenderBar := na
        eng2StructureRenderedTfKey := eng2ActiveStructureTfKey
        eng2StructureRenderFingerprint := ""
        eng2InternalLastEventText := ""
        eng2InternalLastEventLeftBar := na
        eng2InternalLastEventLevel := na
        eng2InternalLastEventBias := 0
        eng2SwingLastEventText := ""
        eng2SwingLastEventLeftBar := na
        eng2SwingLastEventLevel := na
        eng2SwingLastEventBias := 0
    bool eng2ExecStructureNewClosed = (eng1_exec_tf == ENG1_TF_M1 and eng1_m1_new_closed_bar) or (eng1_exec_tf == ENG1_TF_M5 and eng1_m5_new_closed_bar) or (eng1_exec_tf == ENG1_TF_M15 and eng1_m15_new_closed_bar) or (eng1_exec_tf == ENG1_TF_M30 and eng1_m30_new_closed_bar)
    bool eng2CtxStructureNewClosed = (eng1_ctx_tf == ENG1_TF_M15 and eng1_m15_new_closed_bar) or (eng1_ctx_tf == ENG1_TF_M30 and eng1_m30_new_closed_bar) or (eng1_ctx_tf == ENG1_TF_H1 and eng1_h1_new_closed_bar) or (eng1_ctx_tf == ENG1_TF_H4 and eng1_h4_new_closed_bar) or (eng1_ctx_tf == ENG1_TF_D1 and eng1_d1_new_closed_bar)
    bool eng2InternalBullEvent = eng1_exe_bull_choch or eng1_exe_bull_mss or eng1_exe_bull_bos
    bool eng2InternalBearEvent = eng1_exe_bear_choch or eng1_exe_bear_mss or eng1_exe_bear_bos
    if eng2ExecStructureNewClosed and (eng2InternalBullEvent or eng2InternalBearEvent) and eng2InternalBullEvent != eng2InternalBearEvent
        eng2InternalLastEventText := eng1_exe_bull_choch or eng1_exe_bear_choch or eng1_exe_bull_mss or eng1_exe_bear_mss ? "MSS" : "BOS"
        eng2InternalLastEventLeftBar := eng2InternalBullEvent ? eng2InternalSwingHighBar : eng2InternalSwingLowBar
        eng2InternalLastEventLevel := eng2InternalBullEvent ? eng2InternalSwingHigh : eng2InternalSwingLow
        eng2InternalLastEventBias := eng2InternalBullEvent ? 1 : -1
    bool eng2SwingBullEvent = eng1_ctx_bull_breakout or eng1_ctx_bull_choch
    bool eng2SwingBearEvent = eng1_ctx_bear_breakout or eng1_ctx_bear_choch
    if eng2CtxStructureNewClosed and (eng2SwingBullEvent or eng2SwingBearEvent) and eng2SwingBullEvent != eng2SwingBearEvent
        eng2SwingLastEventText := eng1_ctx_bull_choch or eng1_ctx_bear_choch ? "CHoCH" : "BOS"
        eng2SwingLastEventLeftBar := eng2SwingBullEvent ? eng1_ctx_liq_high_bar : eng1_ctx_liq_low_bar
        eng2SwingLastEventLevel := eng2SwingBullEvent ? eng1_ctx_liq_high : eng1_ctx_liq_low
        eng2SwingLastEventBias := eng2SwingBullEvent ? 1 : -1
    bool eng2StructureSourceChanged = eng2ExecStructureNewClosed or eng2CtxStructureNewClosed
    if barstate.islast
        string eng2StructurePointFingerprint = eng2ActiveStructureTfKey
        eng2StructurePointFingerprint := eng2StructurePointFingerprint + "|" + str.tostring(eng2InternalSwingHighBar) + "|" + str.tostring(eng2InternalSwingHigh)
        eng2StructurePointFingerprint := eng2StructurePointFingerprint + "|" + str.tostring(eng2InternalSwingLowBar) + "|" + str.tostring(eng2InternalSwingLow)
        eng2StructurePointFingerprint := eng2StructurePointFingerprint + "|" + str.tostring(displayExecBias) + "|" + str.tostring(displayCtxBias)
        eng2StructurePointFingerprint := eng2StructurePointFingerprint + "|" + str.tostring(eng1_ctx_liq_high_bar) + "|" + str.tostring(eng1_ctx_liq_high)
        eng2StructurePointFingerprint := eng2StructurePointFingerprint + "|" + str.tostring(eng1_ctx_liq_low_bar) + "|" + str.tostring(eng1_ctx_liq_low)
        string eng2StructureEventFingerprint = eng2InternalLastEventText
        eng2StructureEventFingerprint := eng2StructureEventFingerprint + "|" + str.tostring(eng2InternalLastEventLeftBar) + "|" + str.tostring(eng2InternalLastEventLevel) + "|" + str.tostring(eng2InternalLastEventBias)
        eng2StructureEventFingerprint := eng2StructureEventFingerprint + "|" + eng2SwingLastEventText + "|" + str.tostring(eng2SwingLastEventLeftBar)
        eng2StructureEventFingerprint := eng2StructureEventFingerprint + "|" + str.tostring(eng2SwingLastEventLevel) + "|" + str.tostring(eng2SwingLastEventBias)
        string eng2StructureSnapshotFingerprint = eng2StructurePointFingerprint + "|" + eng2StructureEventFingerprint
        bool eng2StructureSnapshotChanged = eng2StructureRenderFingerprint != eng2StructureSnapshotFingerprint
        bool eng2StructureNeedsRender = na(eng2StructureLastRenderBar) or (eng2StructureSourceChanged and eng2StructureSnapshotChanged)
        if eng2StructureNeedsRender
            f_trimStructureVisuals(0)
            int eng2ExecNodeCap = draw_full ? (freeSafeMode ? (eng1_exec_tf == "1" ? 8 : eng1_exec_tf == "5" ? 10 : 12) : (eng1_exec_tf == "1" ? 14 : eng1_exec_tf == "5" ? 18 : 22)) : (eng1_exec_tf == "1" ? 10 : eng1_exec_tf == "5" ? 14 : 20)
            int eng2ExecEventCap = draw_full ? (freeSafeMode ? (eng1_exec_tf == "1" ? 4 : eng1_exec_tf == "5" ? 5 : 6) : (eng1_exec_tf == "1" ? 8 : eng1_exec_tf == "5" ? 10 : 12)) : (eng1_exec_tf == "1" ? 6 : eng1_exec_tf == "5" ? 8 : 12)
            int eng2SwingNodeCap = freeSafeMode ? 8 : 14
            int eng2SwingEventCap = freeSafeMode ? 4 : 6
            int eng2ExecScanCap = draw_full ? (freeSafeMode ? 120 : 200) : (freeSafeMode ? 90 : 150)
            int eng2CtxScanCap = draw_full ? (freeSafeMode ? 80 : 160) : (freeSafeMode ? 70 : 120)
            if eng1_exec_tf == ENG1_TF_M1
                f_eng2_backfill_structure_from_buffer(true, eng1_buf_m1_time, eng1_buf_m1_high, eng1_buf_m1_low, eng1_buf_m1_close, ENG1_SWING_LEN, eng2ExecScanCap, eng2ExecNodeCap, eng2ExecEventCap)
            else if eng1_exec_tf == ENG1_TF_M5
                f_eng2_backfill_structure_from_buffer(true, eng1_buf_m5_time, eng1_buf_m5_high, eng1_buf_m5_low, eng1_buf_m5_close, ENG1_SWING_LEN, eng2ExecScanCap, eng2ExecNodeCap, eng2ExecEventCap)
            else if eng1_exec_tf == ENG1_TF_M15
                f_eng2_backfill_structure_from_buffer(true, eng1_buf_m15_time, eng1_buf_m15_high, eng1_buf_m15_low, eng1_buf_m15_close, ENG1_SWING_LEN, eng2ExecScanCap, eng2ExecNodeCap, eng2ExecEventCap)
            else if eng1_exec_tf == ENG1_TF_M30
                f_eng2_backfill_structure_from_buffer(true, eng1_buf_m30_time, eng1_buf_m30_high, eng1_buf_m30_low, eng1_buf_m30_close, ENG1_SWING_LEN, eng2ExecScanCap, eng2ExecNodeCap, eng2ExecEventCap)
            if eng1_ctx_tf == ENG1_TF_M15
                f_eng2_backfill_structure_from_buffer(false, eng1_buf_m15_time, eng1_buf_m15_high, eng1_buf_m15_low, eng1_buf_m15_close, ENG1_SWING_LEN, eng2CtxScanCap, eng2SwingNodeCap, eng2SwingEventCap)
            else if eng1_ctx_tf == ENG1_TF_M30
                f_eng2_backfill_structure_from_buffer(false, eng1_buf_m30_time, eng1_buf_m30_high, eng1_buf_m30_low, eng1_buf_m30_close, ENG1_SWING_LEN, eng2CtxScanCap, eng2SwingNodeCap, eng2SwingEventCap)
            else if eng1_ctx_tf == ENG1_TF_H1
                f_eng2_backfill_structure_from_buffer(false, eng1_buf_h1_time, eng1_buf_h1_high, eng1_buf_h1_low, eng1_buf_h1_close, ENG1_SWING_LEN, eng2CtxScanCap, eng2SwingNodeCap, eng2SwingEventCap)
            else if eng1_ctx_tf == ENG1_TF_H4
                f_eng2_backfill_structure_from_buffer(false, eng1_buf_h4_time, eng1_buf_h4_high, eng1_buf_h4_low, eng1_buf_h4_close, ENG1_SWING_LEN, eng2CtxScanCap, eng2SwingNodeCap, eng2SwingEventCap)
            else if eng1_ctx_tf == ENG1_TF_D1
                f_eng2_backfill_structure_from_buffer(false, eng1_buf_d1_time, eng1_buf_d1_high, eng1_buf_d1_low, eng1_buf_d1_close, ENG1_SWING_LEN, eng2CtxScanCap, eng2SwingNodeCap, eng2SwingEventCap)
            // Safety net: when the historical backfill window has too few confirmed
            // pivots, still render the latest Engine 1 snapshots so Full mode never
            // looks like market structure is disabled.
            if array.size(eng2InternalStructureNodeHistory) == 0
                f_eng2_backfill_structure_node(true, eng2InternalSwingHighBar, eng2InternalSwingHigh, displayExecBias == -1 ? "LH" : displayExecBias == 1 ? "HH" : "H", true, eng2ExecNodeCap)
                f_eng2_backfill_structure_node(true, eng2InternalSwingLowBar, eng2InternalSwingLow, displayExecBias == 1 ? "HL" : displayExecBias == -1 ? "LL" : "L", false, eng2ExecNodeCap)
            if array.size(eng2SwingStructureNodeHistory) == 0
                f_eng2_backfill_structure_node(false, eng1_ctx_liq_high_bar, eng1_ctx_liq_high, displayCtxBias == -1 ? "LH" : displayCtxBias == 1 ? "HH" : "H", true, eng2SwingNodeCap)
                f_eng2_backfill_structure_node(false, eng1_ctx_liq_low_bar, eng1_ctx_liq_low, displayCtxBias == 1 ? "HL" : displayCtxBias == -1 ? "LL" : "L", false, eng2SwingNodeCap)
            if array.size(eng2InternalStructureEventHistory) == 0 and eng2InternalLastEventText != "" and not na(eng2InternalLastEventLeftBar) and not na(eng2InternalLastEventLevel)
                int internalEventRightTime = f_eng1_select_execution_time(eng1_exec_tf)
                int internalEventLeftTime = eng2InternalLastEventLeftBar
                f_eng2_backfill_structure_event(true, internalEventLeftTime, internalEventRightTime, eng2InternalLastEventLevel, eng2InternalLastEventText, eng2InternalLastEventBias, eng2ExecEventCap)
            if array.size(eng2SwingStructureEventHistory) == 0 and eng2SwingLastEventText != "" and not na(eng2SwingLastEventLeftBar) and not na(eng2SwingLastEventLevel)
                int swingEventRightTime = time
                int swingEventLeftTime = eng2SwingLastEventLeftBar
                f_eng2_backfill_structure_event(false, swingEventLeftTime, swingEventRightTime, eng2SwingLastEventLevel, eng2SwingLastEventText, eng2SwingLastEventBias, eng2SwingEventCap)
            eng2StructureRenderFingerprint := eng2StructureSnapshotFingerprint
            eng2StructureLastRenderBar := bar_index
        else if eng2StructureSourceChanged
            int latestInternalEventRightTime = f_eng1_select_execution_time(eng1_exec_tf)
            f_eng2_extend_latest_structure_event(eng2InternalStructureEventHistory, eng2InternalStructureEventLineHistory, latestInternalEventRightTime)
            f_eng2_extend_latest_structure_event(eng2SwingStructureEventHistory, eng2SwingStructureEventLineHistory, time)

//------------------------------------------------------------------------------
// Higher timeframe structure context (Engine 1 owned)
//------------------------------------------------------------------------------

bool eng1CtxRangeReady = eng1_exec_valid and not na(eng1_ctx_liq_high) and not na(eng1_ctx_liq_low) and eng1_ctx_liq_high > eng1_ctx_liq_low
float eng1CtxRangeHigh = eng1CtxRangeReady ? eng1_ctx_liq_high : na
float eng1CtxRangeLow = eng1CtxRangeReady ? eng1_ctx_liq_low : na
float eng1CtxRangeSize = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeLow : na
float eng1CtxEquilibrium = eng1CtxRangeReady ? (eng1CtxRangeHigh + eng1CtxRangeLow) * 0.5 : na
float eng1CtxOteLongTop = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeSize * 0.62 : na
float eng1CtxOteLongBottom = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeSize * 0.79 : na
float eng1CtxOteShortTop = eng1CtxRangeReady ? eng1CtxRangeLow + eng1CtxRangeSize * 0.79 : na
float eng1CtxOteShortBottom = eng1CtxRangeReady ? eng1CtxRangeLow + eng1CtxRangeSize * 0.62 : na
[eng3ExecOpen, eng3ExecHigh, eng3ExecLow, eng3ExecClose, eng3ExecPrevClose, eng3ClosedFallbackAllowed] = f_eng1_select_exec_closed_ohlc(eng1_exec_tf)
float eng3SignalHigh = eng3ClosedFallbackAllowed ? eng3ExecHigh : na
float eng3SignalLow = eng3ClosedFallbackAllowed ? eng3ExecLow : na
float eng3SignalClose = eng3ClosedFallbackAllowed ? eng3ExecClose : na

// Dealing Range (location layer): derived from Engine 1 context snapshot so it stays aligned with MTF ownership.
int eng2DealHighBarSafe = f_createdBarFromTime(eng1_ctx_liq_high_bar)
int eng2DealLowBarSafe = f_createdBarFromTime(eng1_ctx_liq_low_bar)
float eng2DealHighCandidate = eng1CtxRangeReady ? eng1CtxRangeHigh : na
float eng2DealLowCandidate = eng1CtxRangeReady ? eng1CtxRangeLow : na
bool eng2DealMappedBarsReady = not na(eng2DealHighBarSafe) and not na(eng2DealLowBarSafe)
int eng2DealLeftCandidate = eng2DealMappedBarsReady ? math.min(eng2DealHighBarSafe, eng2DealLowBarSafe) : na
bool eng2DealReady = eng1CtxRangeReady and not na(eng2DealLeftCandidate) and not na(eng2DealHighCandidate) and not na(eng2DealLowCandidate) and eng2DealHighCandidate > eng2DealLowCandidate
bool eng2DealSignificant = eng2DealReady and not na(eng2DealHighCandidate) and not na(eng2DealLowCandidate) and (eng2DealHighCandidate - eng2DealLowCandidate) >= atr * 0.75
if not eng2DealSignificant
    eng2DealHigh := na
    eng2DealLow := na
    eng2DealLeftBar := na
    eng2DealBroken := false
else
    if (eng1CtxRangeReady and (na(eng2DealHigh) or na(eng2DealLow) or not f_levelsClose(eng2DealHigh, eng2DealHighCandidate, math.max(atr * equalToleranceAtr, syminfo.mintick * 2.0)) or not f_levelsClose(eng2DealLow, eng2DealLowCandidate, math.max(atr * equalToleranceAtr, syminfo.mintick * 2.0)))) or eng2DealLeftBar != eng2DealLeftCandidate
        eng2DealHigh := eng2DealHighCandidate
        eng2DealLow := eng2DealLowCandidate
        eng2DealLeftBar := eng2DealLeftCandidate
        eng2DealBroken := false
    if not eng2DealBroken and eng3ClosedFallbackAllowed and not na(eng2DealHigh) and not na(eng2DealLow) and (eng3ExecClose > eng2DealHigh or eng3ExecClose < eng2DealLow)
        eng2DealBroken := true
bool ipdaAsiaKillzoneActive = f_inIpdaWindow(ipdaAsiaKillzoneSession)
bool ipdaLondonKillzoneActive = f_inIpdaWindow(ipdaLondonKillzoneSession)
bool ipdaNewYorkKillzoneActive = f_inIpdaWindow(ipdaNewYorkKillzoneSession)
bool strictKillzoneActive = ipdaAsiaKillzoneActive or ipdaLondonKillzoneActive or ipdaNewYorkKillzoneActive
bool ipdaMainKillzoneActive = ipdaLondonKillzoneActive or ipdaNewYorkKillzoneActive
string ipdaWindowSummary = ipdaNewYorkKillzoneActive ? "NY KZ" : ipdaLondonKillzoneActive ? "LDN KZ" : ipdaAsiaKillzoneActive ? "AS KZ" : strictModeEnabled and f_inIpdaWindow(ipdaObservationSession) ? "Observe" : "Off"
liquiditySessionSummary = "Sess " + f_sessionCode(inNewYorkSession ? "New York" : inLondonSession ? "London" : inAsiaSession ? "Asia" : "Inter-session") + ">" + f_sessionCode(inNewYorkSession ? "Asia" : inLondonSession ? "New York" : inAsiaSession ? "London" : "Asia")
timezoneSummary = "UTC"
float effectiveOteLongTop = eng1CtxRangeReady and displayNarrBias != -1 and (displayCtxBias == 1 or eng1_ctx_bull_reversal) ? eng1CtxOteLongTop : na
float effectiveOteLongBottom = eng1CtxRangeReady and displayNarrBias != -1 and (displayCtxBias == 1 or eng1_ctx_bull_reversal) ? eng1CtxOteLongBottom : na
float effectiveOteShortTop = eng1CtxRangeReady and displayNarrBias != 1 and (displayCtxBias == -1 or eng1_ctx_bear_reversal) ? eng1CtxOteShortTop : na
float effectiveOteShortBottom = eng1CtxRangeReady and displayNarrBias != 1 and (displayCtxBias == -1 or eng1_ctx_bear_reversal) ? eng1CtxOteShortBottom : na
bool effectiveLongOteReady = not na(effectiveOteLongTop) and not na(effectiveOteLongBottom)
bool effectiveShortOteReady = not na(effectiveOteShortTop) and not na(effectiveOteShortBottom)

//------------------------------------------------------------------------------
// ENGINE 3 (SETUP ENGINE)
// MAIN_CONTRACT order 5-7: build context OB/FVG zone, validate confirmations, then
// build/update trade plan + lifecycle.
//------------------------------------------------------------------------------
bool eng1BullContextAllowed = f_eng3_validate_narrative_side(true, eng1_exec_valid, displayNarrBias, displayCtxBias, eng1_ctx_bull_reversal, eng1_ctx_bear_reversal)
bool eng1BearContextAllowed = f_eng3_validate_narrative_side(false, eng1_exec_valid, displayNarrBias, displayCtxBias, eng1_ctx_bull_reversal, eng1_ctx_bear_reversal)
bool eng1HasBullObContext = eng1BullContextAllowed and not na(eng1_ctx_bull_ob_entry)
bool eng1HasBullFvgContext = eng1BullContextAllowed and not na(eng1_ctx_bull_fvg_top) and not na(eng1_ctx_bull_fvg_bottom)
bool eng1HasBearObContext = eng1BearContextAllowed and not na(eng1_ctx_bear_ob_entry)
bool eng1HasBearFvgContext = eng1BearContextAllowed and not na(eng1_ctx_bear_fvg_top) and not na(eng1_ctx_bear_fvg_bottom)
int eng1BullObCreatedBar = f_createdBarFromTime(eng1_ctx_bull_ob_bar)
int eng1BullFvgCreatedBar = f_createdBarFromTime(eng1_ctx_bull_fvg_bar)
int eng1BearObCreatedBar = f_createdBarFromTime(eng1_ctx_bear_ob_bar)
int eng1BearFvgCreatedBar = f_createdBarFromTime(eng1_ctx_bear_fvg_bar)
bool eng3BullObTrackValid = eng1HasBullObContext and not na(eng1_ctx_bull_ob_top) and not na(eng1_ctx_bull_ob_bottom) and not na(eng1BullObCreatedBar)
bool eng3BullFvgTrackValid = eng1HasBullFvgContext and not na(eng1_ctx_bull_fvg_top) and not na(eng1_ctx_bull_fvg_bottom) and not na(eng1BullFvgCreatedBar)
bool eng3BearObTrackValid = eng1HasBearObContext and not na(eng1_ctx_bear_ob_top) and not na(eng1_ctx_bear_ob_bottom) and not na(eng1BearObCreatedBar)
bool eng3BearFvgTrackValid = eng1HasBearFvgContext and not na(eng1_ctx_bear_fvg_top) and not na(eng1_ctx_bear_fvg_bottom) and not na(eng1BearFvgCreatedBar)

bool eng3BullObTrackChanged = eng3BullObTrackValid and (na(eng3BullObTouchBar) or eng3BullObTouchBar != eng1BullObCreatedBar or na(eng3BullObTouchTop) or eng3BullObTouchTop != eng1_ctx_bull_ob_top or na(eng3BullObTouchBottom) or eng3BullObTouchBottom != eng1_ctx_bull_ob_bottom)
bool eng3BullFvgTrackChanged = eng3BullFvgTrackValid and (na(eng3BullFvgTouchBar) or eng3BullFvgTouchBar != eng1BullFvgCreatedBar or na(eng3BullFvgTouchTop) or eng3BullFvgTouchTop != eng1_ctx_bull_fvg_top or na(eng3BullFvgTouchBottom) or eng3BullFvgTouchBottom != eng1_ctx_bull_fvg_bottom)
bool eng3BearObTrackChanged = eng3BearObTrackValid and (na(eng3BearObTouchBar) or eng3BearObTouchBar != eng1BearObCreatedBar or na(eng3BearObTouchTop) or eng3BearObTouchTop != eng1_ctx_bear_ob_top or na(eng3BearObTouchBottom) or eng3BearObTouchBottom != eng1_ctx_bear_ob_bottom)
bool eng3BearFvgTrackChanged = eng3BearFvgTrackValid and (na(eng3BearFvgTouchBar) or eng3BearFvgTouchBar != eng1BearFvgCreatedBar or na(eng3BearFvgTouchTop) or eng3BearFvgTouchTop != eng1_ctx_bear_fvg_top or na(eng3BearFvgTouchBottom) or eng3BearFvgTouchBottom != eng1_ctx_bear_fvg_bottom)

bool strictLongRawSweepSignal = strictModeEnabled and (eng1_exe_bull_sweep or (eng3ClosedFallbackAllowed and ((ipdaMainKillzoneActive and not na(asiaSessionLow) and eng3ExecLow < asiaSessionLow and eng3ExecClose > asiaSessionLow) or (ipdaNewYorkKillzoneActive and not na(londonSessionLow) and eng3ExecLow < londonSessionLow and eng3ExecClose > londonSessionLow) or (not na(eng1_d1_lb20_low) and eng3ExecLow < eng1_d1_lb20_low and eng3ExecClose > eng1_d1_lb20_low) or (not na(eng1_d1_lb40_low) and eng3ExecLow < eng1_d1_lb40_low and eng3ExecClose > eng1_d1_lb40_low) or (not na(eng1_d1_lb60_low) and eng3ExecLow < eng1_d1_lb60_low and eng3ExecClose > eng1_d1_lb60_low))))
bool strictShortRawSweepSignal = strictModeEnabled and (eng1_exe_bear_sweep or (eng3ClosedFallbackAllowed and ((ipdaMainKillzoneActive and not na(asiaSessionHigh) and eng3ExecHigh > asiaSessionHigh and eng3ExecClose < asiaSessionHigh) or (ipdaNewYorkKillzoneActive and not na(londonSessionHigh) and eng3ExecHigh > londonSessionHigh and eng3ExecClose < londonSessionHigh) or (not na(eng1_d1_lb20_high) and eng3ExecHigh > eng1_d1_lb20_high and eng3ExecClose < eng1_d1_lb20_high) or (not na(eng1_d1_lb40_high) and eng3ExecHigh > eng1_d1_lb40_high and eng3ExecClose < eng1_d1_lb40_high) or (not na(eng1_d1_lb60_high) and eng3ExecHigh > eng1_d1_lb60_high and eng3ExecClose < eng1_d1_lb60_high))))
float strictLongSweepExtreme = ta.valuewhen(strictLongRawSweepSignal, eng3ExecLow, 0)
float strictShortSweepExtreme = ta.valuewhen(strictShortRawSweepSignal, eng3ExecHigh, 0)
int strictLongSweepAge = ta.barssince(strictLongRawSweepSignal)
int strictShortSweepAge = ta.barssince(strictShortRawSweepSignal)
int strictLongMssAge = ta.barssince(strictModeEnabled and eng1_exe_bull_mss)
int strictShortMssAge = ta.barssince(strictModeEnabled and eng1_exe_bear_mss)
int strictLongDisplacementAge = ta.barssince(strictModeEnabled and eng1_exe_bull_displacement)
int strictShortDisplacementAge = ta.barssince(strictModeEnabled and eng1_exe_bear_displacement)
bool bullObStrictPdOwned = eng1HasBullObContext and f_eng3_strict_pd_array_owned(false, eng1BullObCreatedBar, strictLongSweepAge, strictLongMssAge, strictLongDisplacementAge, strictPdOwnershipWindow)
bool bullFvgStrictPdOwned = eng1HasBullFvgContext and f_eng3_strict_pd_array_owned(true, eng1BullFvgCreatedBar, strictLongSweepAge, strictLongMssAge, strictLongDisplacementAge, strictPdOwnershipWindow)
bool bearObStrictPdOwned = eng1HasBearObContext and f_eng3_strict_pd_array_owned(false, eng1BearObCreatedBar, strictShortSweepAge, strictShortMssAge, strictShortDisplacementAge, strictPdOwnershipWindow)
bool bearFvgStrictPdOwned = eng1HasBearFvgContext and f_eng3_strict_pd_array_owned(true, eng1BearFvgCreatedBar, strictShortSweepAge, strictShortMssAge, strictShortDisplacementAge, strictPdOwnershipWindow)

// Engine 3 state machine: zone touch latches are incremental and reset only when
// the tracked context zone identity changes or disappears.
if not eng3BullObTrackValid
    eng3BullObTouchedState := false
    eng3BullObTouchBar := na
    eng3BullObTouchTop := na
    eng3BullObTouchBottom := na
else if eng3BullObTrackChanged
    eng3BullObTouchedState := not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bull_ob_bottom and eng3SignalLow <= eng1_ctx_bull_ob_top
    eng3BullObTouchBar := eng1BullObCreatedBar
    eng3BullObTouchTop := eng1_ctx_bull_ob_top
    eng3BullObTouchBottom := eng1_ctx_bull_ob_bottom
else if not eng3BullObTouchedState and not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bull_ob_bottom and eng3SignalLow <= eng1_ctx_bull_ob_top
    eng3BullObTouchedState := true

if not eng3BullFvgTrackValid
    eng3BullFvgTouchedState := false
    eng3BullFvgTouchBar := na
    eng3BullFvgTouchTop := na
    eng3BullFvgTouchBottom := na
else if eng3BullFvgTrackChanged
    eng3BullFvgTouchedState := not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bull_fvg_bottom and eng3SignalLow <= eng1_ctx_bull_fvg_top
    eng3BullFvgTouchBar := eng1BullFvgCreatedBar
    eng3BullFvgTouchTop := eng1_ctx_bull_fvg_top
    eng3BullFvgTouchBottom := eng1_ctx_bull_fvg_bottom
else if not eng3BullFvgTouchedState and not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bull_fvg_bottom and eng3SignalLow <= eng1_ctx_bull_fvg_top
    eng3BullFvgTouchedState := true

if not eng3BearObTrackValid
    eng3BearObTouchedState := false
    eng3BearObTouchBar := na
    eng3BearObTouchTop := na
    eng3BearObTouchBottom := na
else if eng3BearObTrackChanged
    eng3BearObTouchedState := not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bear_ob_bottom and eng3SignalLow <= eng1_ctx_bear_ob_top
    eng3BearObTouchBar := eng1BearObCreatedBar
    eng3BearObTouchTop := eng1_ctx_bear_ob_top
    eng3BearObTouchBottom := eng1_ctx_bear_ob_bottom
else if not eng3BearObTouchedState and not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bear_ob_bottom and eng3SignalLow <= eng1_ctx_bear_ob_top
    eng3BearObTouchedState := true

if not eng3BearFvgTrackValid
    eng3BearFvgTouchedState := false
    eng3BearFvgTouchBar := na
    eng3BearFvgTouchTop := na
    eng3BearFvgTouchBottom := na
else if eng3BearFvgTrackChanged
    eng3BearFvgTouchedState := not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bear_fvg_bottom and eng3SignalLow <= eng1_ctx_bear_fvg_top
    eng3BearFvgTouchBar := eng1BearFvgCreatedBar
    eng3BearFvgTouchTop := eng1_ctx_bear_fvg_top
    eng3BearFvgTouchBottom := eng1_ctx_bear_fvg_bottom
else if not eng3BearFvgTouchedState and not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bear_fvg_bottom and eng3SignalLow <= eng1_ctx_bear_fvg_top
    eng3BearFvgTouchedState := true

bool eng1BullObTouched = eng3BullObTouchedState
bool eng1BullFvgTouched = eng3BullFvgTouchedState
bool eng1BearObTouched = eng3BearObTouchedState
bool eng1BearFvgTouched = eng3BearFvgTouchedState

// Context zone sources (Engine 1 owned). Keep them explicit so Engine 3 never
// accidentally pulls from execution-only state.
float ctxBullObTop = eng1HasBullObContext ? eng1_ctx_bull_ob_top : na
float ctxBullObBottom = eng1HasBullObContext ? eng1_ctx_bull_ob_bottom : na
float ctxBullObEntry = eng1HasBullObContext ? eng1_ctx_bull_ob_entry : na
bool ctxBullObBreaker = eng1HasBullObContext ? eng1_ctx_bull_ob_breaker : false
int ctxBullObCreatedBar = eng1HasBullObContext ? eng1BullObCreatedBar : na
bool ctxBullObTouched = eng1HasBullObContext ? eng1BullObTouched : false
float ctxBullFvgTop = eng1HasBullFvgContext ? eng1_ctx_bull_fvg_top : na
float ctxBullFvgBottom = eng1HasBullFvgContext ? eng1_ctx_bull_fvg_bottom : na
int ctxBullFvgCreatedBar = eng1HasBullFvgContext ? eng1BullFvgCreatedBar : na
bool ctxBullFvgTouched = eng1HasBullFvgContext ? eng1BullFvgTouched : false

float ctxBearObTop = eng1HasBearObContext ? eng1_ctx_bear_ob_top : na
float ctxBearObBottom = eng1HasBearObContext ? eng1_ctx_bear_ob_bottom : na
float ctxBearObEntry = eng1HasBearObContext ? eng1_ctx_bear_ob_entry : na
bool ctxBearObBreaker = eng1HasBearObContext ? eng1_ctx_bear_ob_breaker : false
int ctxBearObCreatedBar = eng1HasBearObContext ? eng1BearObCreatedBar : na
bool ctxBearObTouched = eng1HasBearObContext ? eng1BearObTouched : false
float ctxBearFvgTop = eng1HasBearFvgContext ? eng1_ctx_bear_fvg_top : na
float ctxBearFvgBottom = eng1HasBearFvgContext ? eng1_ctx_bear_fvg_bottom : na
int ctxBearFvgCreatedBar = eng1HasBearFvgContext ? eng1BearFvgCreatedBar : na
bool ctxBearFvgTouched = eng1HasBearFvgContext ? eng1BearFvgTouched : false

bool hasBullOb = eng1HasBullObContext
bool hasBullFvg = eng1HasBullFvgContext
bool hasBearOb = eng1HasBearObContext
bool hasBearFvg = eng1HasBearFvgContext

bool bullObPdPass = hasBullOb and eng1CtxRangeReady and f_zoneMid(ctxBullObTop, ctxBullObBottom) < eng1CtxEquilibrium
bool bullFvgPdPass = hasBullFvg and eng1CtxRangeReady and f_zoneMid(ctxBullFvgTop, ctxBullFvgBottom) < eng1CtxEquilibrium
bool bearObPdPass = hasBearOb and eng1CtxRangeReady and f_zoneMid(ctxBearObTop, ctxBearObBottom) > eng1CtxEquilibrium
bool bearFvgPdPass = hasBearFvg and eng1CtxRangeReady and f_zoneMid(ctxBearFvgTop, ctxBearFvgBottom) > eng1CtxEquilibrium
bool bullObOtePass = hasBullOb and effectiveLongOteReady and f_zoneIntersects(ctxBullObTop, ctxBullObBottom, effectiveOteLongTop, effectiveOteLongBottom)
bool bullFvgOtePass = hasBullFvg and effectiveLongOteReady and f_zoneIntersects(ctxBullFvgTop, ctxBullFvgBottom, effectiveOteLongTop, effectiveOteLongBottom)
bool bearObOtePass = hasBearOb and effectiveShortOteReady and f_zoneIntersects(ctxBearObTop, ctxBearObBottom, effectiveOteShortTop, effectiveOteShortBottom)
bool bearFvgOtePass = hasBearFvg and effectiveShortOteReady and f_zoneIntersects(ctxBearFvgTop, ctxBearFvgBottom, effectiveOteShortTop, effectiveOteShortBottom)

bool bullObZoneConfirmPass = bullObPdPass and bullObOtePass
bool bullFvgZoneConfirmPass = bullFvgPdPass and bullFvgOtePass
bool bearObZoneConfirmPass = bearObPdPass and bearObOtePass
bool bearFvgZoneConfirmPass = bearFvgPdPass and bearFvgOtePass
bool bullFvgInZone = hasBullFvg and not na(eng3SignalClose) and eng3SignalClose >= ctxBullFvgBottom and eng3SignalClose <= ctxBullFvgTop
bool bullObInZone = hasBullOb and not na(eng3SignalClose) and eng3SignalClose >= ctxBullObBottom and eng3SignalClose <= ctxBullObTop
bool bearFvgInZone = hasBearFvg and not na(eng3SignalClose) and eng3SignalClose >= ctxBearFvgBottom and eng3SignalClose <= ctxBearFvgTop
bool bearObInZone = hasBearOb and not na(eng3SignalClose) and eng3SignalClose >= ctxBearObBottom and eng3SignalClose <= ctxBearObTop

[preferBullOb, preferBullFvg] = f_eng3_select_poi_preference(strictModeEnabled, hasBullOb, hasBullFvg, bullObZoneConfirmPass, bullFvgZoneConfirmPass, bullObInZone, bullFvgInZone, bullObStrictPdOwned, bullFvgStrictPdOwned)
[preferBearOb, preferBearFvg] = f_eng3_select_poi_preference(strictModeEnabled, hasBearOb, hasBearFvg, bearObZoneConfirmPass, bearFvgZoneConfirmPass, bearObInZone, bearFvgInZone, bearObStrictPdOwned, bearFvgStrictPdOwned)

[poi_long_candidate_valid, poi_long_type, poi_long_top, poi_long_bottom, poi_long_entry, poi_long_bar, poi_long_touched] = f_eng3_select_context_poi(preferBullOb, preferBullFvg, ctxBullObBreaker, ctxBullObTop, ctxBullObBottom, ctxBullObEntry, ctxBullObCreatedBar, ctxBullObTouched, ctxBullFvgTop, ctxBullFvgBottom, ctxBullFvgCreatedBar, ctxBullFvgTouched)
[poi_short_candidate_valid, poi_short_type, poi_short_top, poi_short_bottom, poi_short_entry, poi_short_bar, poi_short_touched] = f_eng3_select_context_poi(preferBearOb, preferBearFvg, ctxBearObBreaker, ctxBearObTop, ctxBearObBottom, ctxBearObEntry, ctxBearObCreatedBar, ctxBearObTouched, ctxBearFvgTop, ctxBearFvgBottom, ctxBearFvgCreatedBar, ctxBearFvgTouched)
eng3LongActivePoiIdentity := f_eng3_poi_identity("L", poi_long_type, poi_long_bar, poi_long_top, poi_long_bottom)
eng3ShortActivePoiIdentity := f_eng3_poi_identity("S", poi_short_type, poi_short_bar, poi_short_top, poi_short_bottom)
bool eng3LongActivePoiReady = eng3LongActivePoiIdentity != ""
bool eng3ShortActivePoiReady = eng3ShortActivePoiIdentity != ""
bool strictLongPdArrayOwned = not strictModeEnabled or (poi_long_type == "FVG" and bullFvgStrictPdOwned) or ((poi_long_type == "OB" or poi_long_type == "Breaker") and bullObStrictPdOwned)
bool strictShortPdArrayOwned = not strictModeEnabled or (poi_short_type == "FVG" and bearFvgStrictPdOwned) or ((poi_short_type == "OB" or poi_short_type == "Breaker") and bearObStrictPdOwned)
bool poi_long_contract_valid = eng1BullContextAllowed and poi_long_candidate_valid and eng3LongActivePoiReady and strictLongPdArrayOwned and eng3LongActivePoiIdentity != eng3LongConsumedPoiIdentity
bool poi_short_contract_valid = eng1BearContextAllowed and poi_short_candidate_valid and eng3ShortActivePoiReady and strictShortPdArrayOwned and eng3ShortActivePoiIdentity != eng3ShortConsumedPoiIdentity

[tradeLongEntry, tradeLongStop, tradeLongTarget, tradeLongSetup, tradeLongValidTop, tradeLongValidBottom, tradeLongIsOb, tradeLongIsFvg, tradeLongCreatedBar, tradeLongTouched] = f_eng3_build_trade_plan(true, poi_long_contract_valid, poi_long_type, poi_long_top, poi_long_bottom, poi_long_entry, poi_long_bar, poi_long_touched, strictLongSweepExtreme, eng1_exe_liq_high, eng1_exe_liq_low, eng1_exe_eqh_active ? eng1_exe_eqh : na, eng1_exe_eql_active ? eng1_exe_eql : na, eng1CtxRangeHigh, eng1CtxRangeLow)
[tradeShortEntry, tradeShortStop, tradeShortTarget, tradeShortSetup, tradeShortValidTop, tradeShortValidBottom, tradeShortIsOb, tradeShortIsFvg, tradeShortCreatedBar, tradeShortTouched] = f_eng3_build_trade_plan(false, poi_short_contract_valid, poi_short_type, poi_short_top, poi_short_bottom, poi_short_entry, poi_short_bar, poi_short_touched, strictShortSweepExtreme, eng1_exe_liq_high, eng1_exe_liq_low, eng1_exe_eqh_active ? eng1_exe_eqh : na, eng1_exe_eql_active ? eng1_exe_eql : na, eng1CtxRangeHigh, eng1CtxRangeLow)

bool ipdaLongDolAvailable = strictModeEnabled and (not na(eng1_narr_liq_high) or not na(eng1_d1_lb20_high) or not na(eng1_d1_lb40_high) or not na(eng1_d1_lb60_high) or not na(eng1_narr_bear_sd_top) or not na(eng1_narr_bear_sd_bottom))
bool ipdaShortDolAvailable = strictModeEnabled and (not na(eng1_narr_liq_low) or not na(eng1_d1_lb20_low) or not na(eng1_d1_lb40_low) or not na(eng1_d1_lb60_low) or not na(eng1_narr_bull_sd_top) or not na(eng1_narr_bull_sd_bottom))
float longDolExternal = strictModeEnabled and not na(tradeLongEntry) ? f_nearestAbove(tradeLongEntry, eng1_narr_liq_high, eng1_d1_lb20_high, eng1_d1_lb40_high, eng1_d1_lb60_high, eng1CtxRangeHigh, eng1_narr_bear_sd_bottom, eng1_narr_bear_sd_top) : na
float shortDolExternal = strictModeEnabled and not na(tradeShortEntry) ? f_nearestBelow(tradeShortEntry, eng1_narr_liq_low, eng1_d1_lb20_low, eng1_d1_lb40_low, eng1_d1_lb60_low, eng1CtxRangeLow, eng1_narr_bull_sd_top, eng1_narr_bull_sd_bottom) : na
bool longQualifiedExternalDol = not na(longDolExternal) and not na(tradeLongEntry) and not na(tradeLongStop) and tradeLongEntry > tradeLongStop and longDolExternal - tradeLongEntry >= tradeLongEntry - tradeLongStop
bool shortQualifiedExternalDol = not na(shortDolExternal) and not na(tradeShortEntry) and not na(tradeShortStop) and tradeShortStop > tradeShortEntry and tradeShortEntry - shortDolExternal >= tradeShortStop - tradeShortEntry
bool longUsesExternalDolTarget = strictModeEnabled and longQualifiedExternalDol
bool shortUsesExternalDolTarget = strictModeEnabled and shortQualifiedExternalDol
float activeLongTarget = longUsesExternalDolTarget ? longDolExternal : tradeLongTarget
float activeShortTarget = shortUsesExternalDolTarget ? shortDolExternal : tradeShortTarget
bool exe_long_pd_pass = tradeLongIsOb ? bullObPdPass : tradeLongIsFvg ? bullFvgPdPass : false
bool exe_short_pd_pass = tradeShortIsOb ? bearObPdPass : tradeShortIsFvg ? bearFvgPdPass : false
bool exe_long_ote_pass = tradeLongIsOb ? bullObOtePass : tradeLongIsFvg ? bullFvgOtePass : false
bool exe_short_ote_pass = tradeShortIsOb ? bearObOtePass : tradeShortIsFvg ? bearFvgOtePass : false
bool exe_long_dol_pass = strictModeEnabled ? longQualifiedExternalDol : not na(activeLongTarget)
bool exe_short_dol_pass = strictModeEnabled ? shortQualifiedExternalDol : not na(activeShortTarget)

float longRisk = not na(tradeLongEntry) and not na(tradeLongStop) ? tradeLongEntry - tradeLongStop : na
bool longPriceInZone = not na(tradeLongValidBottom) and not na(eng3SignalClose) and eng3SignalClose >= tradeLongValidBottom and eng3SignalClose <= tradeLongValidTop
bool longPriceNearZone = not na(tradeLongEntry) and not na(eng3SignalClose) and math.abs(eng3SignalClose - tradeLongEntry) <= atr * 0.25
int longSetupAge = not na(tradeLongCreatedBar) ? bar_index - tradeLongCreatedBar : na
string currentLongSetupTag = f_eng3_setup_tag(tradeLongSetup, tradeLongCreatedBar, tradeLongValidTop, tradeLongValidBottom)
bool longSetupMissing = currentLongSetupTag == ""
bool longSetupChanged = not longSetupMissing and currentLongSetupTag != lastLongSetupTag
if longSetupMissing or longSetupChanged
    longPoiTappedLatched := false
    longPoiMitigatedLatched := false
    longPoiInvalidatedLatched := false
    longArmedLatched := false
    eng2LongTappedEventTag := ""
    eng2LongMitigatedEventTag := ""
if not longSetupMissing
    longPoiMitigatedLatched := longPoiMitigatedLatched or f_eng3_poi_ce_touched(true, poi_long_type, tradeLongValidTop, tradeLongValidBottom, tradeLongEntry, eng3SignalHigh, eng3SignalLow) or f_eng3_poi_full_filled(true, tradeLongValidTop, tradeLongValidBottom, eng3SignalHigh, eng3SignalLow)
    longPoiTappedLatched := longPoiTappedLatched or tradeLongTouched or longPoiMitigatedLatched
    longPoiInvalidatedLatched := longPoiInvalidatedLatched or f_eng3_poi_invalidated(true, tradeLongValidTop, tradeLongValidBottom, eng3SignalClose)
bool longChased = not longPoiMitigatedLatched and not na(tradeLongValidTop) and not na(eng3SignalClose) and eng3SignalClose > tradeLongValidTop + atr * setupChaseAtr
float execBarRange = eng3ClosedFallbackAllowed ? eng3ExecHigh - eng3ExecLow : na
float execBarBodyShare = eng3ClosedFallbackAllowed ? f_eng1_body_share(eng3ExecOpen, eng3ExecHigh, eng3ExecLow, eng3ExecClose) : na
bool longDirectionalFallback = displayExecBias == 0 and ((eng1_exe_bull_mss and not eng1_exe_bear_mss) or (eng1_exe_bull_displacement and not eng1_exe_bear_displacement))
bool shortDirectionalFallback = displayExecBias == 0 and ((eng1_exe_bear_mss and not eng1_exe_bull_mss) or (eng1_exe_bear_displacement and not eng1_exe_bull_displacement))
bool effectiveLongDirectional = displayExecBias == 1 or longDirectionalFallback
bool effectiveLongSweepSeen = strictModeEnabled ? strictLongRawSweepSignal : eng1_exe_bull_sweep
bool longMssFallbackBreak = eng3ClosedFallbackAllowed and not na(eng1_exe_mss_ref_high) and not na(eng3ExecPrevClose) and eng3ExecClose > eng1_exe_mss_ref_high and eng3ExecPrevClose <= eng1_exe_mss_ref_high
int longMssFallbackAge = ta.barssince(longMssFallbackBreak)
bool longMssFallbackRecent = not na(longMssFallbackAge) and longMssFallbackAge <= strictMssLookbackEffective
bool longDispFallbackBreak = eng3ClosedFallbackAllowed and eng3ExecClose > eng3ExecOpen and execBarRange >= atr * 0.80 and execBarBodyShare >= 0.50
int longDispFallbackAge = ta.barssince(longDispFallbackBreak)
bool longDispFallbackRecent = not na(longDispFallbackAge) and longDispFallbackAge <= strictMssLookbackEffective
bool longDispFallbackContext = eng1_exe_bull_sweep or longMssFallbackRecent or eng1_exe_bull_mss
bool longDispFallback = not strictModeEnabled and longDispFallbackRecent and longDispFallbackContext
bool effectiveLongMssSeen = eng1_exe_bull_mss or longMssFallbackRecent
bool effectiveLongDisplacementSeen = eng1_exe_bull_displacement or longDispFallback
bool effectiveLongStructureInvalidated = longPoiInvalidatedLatched or (displayExecBias == -1 and (displayCtxBias == -1 or eng1_ctx_bear_reversal or eng1_exe_bear_mss))
bool normalLongDirectionalContext = displayCtxBias != -1 and (displayExecBias == 1 or effectiveLongDirectional or eng1_ctx_bull_reversal or eng1_ctx_bull_breakout)
bool normalLongBiasPass = eng1_exec_valid and displayNarrBias != -1 and normalLongDirectionalContext
bool normalLongContextPass = (tradeLongIsOb or tradeLongIsFvg) and normalLongDirectionalContext
bool normalLongTargetPass = not na(activeLongTarget)
// Strict IPDA map, aligned with IPDA_SOP.md and Resume_Strategi_Trading.md:
// Stage 1 = NY time, Stage 2 = Bias TF narrative/DOL,
// Stage 3 = Context TF OB/FVG, Stage 4-5 = Execution raid/MSS/displacement/risk.
// Non-strict deliberately stays normal: OB/FVG zone + direction + MSS /
// displacement + retest. No IPDA time, DOL lookback, Judas, or OTE mandate.
bool strictLongBiasPass = not strictModeEnabled or (displayNarrBias == 1 and ipdaLongDolAvailable)
bool strictLongContextTfPass = not strictModeEnabled or ((displayCtxBias == 1 or eng1_ctx_bull_reversal or eng1_ctx_bull_breakout or (displayCtxBias == 0 and effectiveLongDirectional)) and (tradeLongIsOb or tradeLongIsFvg))
bool exe_long_sweep_signal = strictModeEnabled ? strictLongRawSweepSignal : (eng1_exe_bull_sweep or longPriceInZone or longPriceNearZone or tradeLongTouched)
bool exe_long_mss_signal = strictModeEnabled ? eng1_exe_bull_mss : effectiveLongMssSeen
bool exe_long_displacement_signal = strictModeEnabled ? eng1_exe_bull_displacement : effectiveLongDisplacementSeen
bool strictLongSweepPass = not strictModeEnabled or exe_long_sweep_signal
bool strictLongMssPass = not strictModeEnabled or (exe_long_mss_signal and effectiveLongDirectional)
bool strictLongDisplacementPass = not strictModeEnabled or exe_long_displacement_signal
bool strictLongPdPass = not strictModeEnabled or exe_long_pd_pass
bool strictLongOtePass = not strictModeEnabled or exe_long_ote_pass
bool strictLongDolPass = not strictModeEnabled or exe_long_dol_pass
bool strictLongKillzonePass = not strictModeEnabled or strictKillzoneActive
bool longPoiRetestPass = longPriceInZone or longPriceNearZone or tradeLongTouched
bool longEvidencePass = exe_long_mss_signal or exe_long_displacement_signal
bool longHardSignalGate = strictModeEnabled ? (not na(tradeLongEntry) and strictLongBiasPass and strictLongContextTfPass and strictLongPdPass and strictLongOtePass and strictLongDolPass and strictLongKillzonePass and not longPoiInvalidatedLatched) : (not na(tradeLongEntry) and normalLongBiasPass and normalLongContextPass and normalLongTargetPass and longPoiRetestPass and longEvidencePass and not longPoiInvalidatedLatched)
bool longScoreTargetClear = longHardSignalGate ? f_eng3_target_liquidity_clear(activeLongTarget, eng1_exe_liq_high, eng1_exe_eqh_active ? eng1_exe_eqh : na, eng1CtxRangeHigh, longUsesExternalDolTarget) : false
bool longScoreHtfPenalty = longHardSignalGate ? (eng1_narr_strength == "Strong" and displayNarrBias == -1) : false
bool longScorePdPenalty = longHardSignalGate ? (not na(tradeLongEntry) and eng1CtxRangeReady and not na(eng1CtxEquilibrium) and tradeLongEntry > eng1CtxEquilibrium) : false
bool longScoreFvgPenalty = longHardSignalGate ? (tradeLongIsFvg and (longPoiMitigatedLatched or longChased)) : false
int longSignalScore = longHardSignalGate ? f_eng3_dynamic_signal_score(effectiveLongSweepSeen, exe_long_displacement_signal, exe_long_mss_signal, hasBullFvg, exe_long_pd_pass, strictKillzoneActive, longScoreTargetClear, longScoreHtfPenalty, longScorePdPenalty, longScoreFvgPenalty) : 0
bool exe_long_contract_confirm = strictModeEnabled ? (strictLongBiasPass and strictLongContextTfPass and strictLongSweepPass and strictLongMssPass and strictLongDisplacementPass and strictLongPdPass and strictLongOtePass and strictLongDolPass and strictLongKillzonePass) : longSignalScore >= 6
bool exe_long_confirm = not na(tradeLongEntry) and exe_long_contract_confirm
longArmedLatched := longArmedLatched or exe_long_confirm
bool longManagedHit = longArmedLatched and longPoiMitigatedLatched and not na(longRisk) and not na(eng3SignalHigh) and eng3SignalHigh >= tradeLongEntry + longRisk * setupManagedR
bool longStopHit = longArmedLatched and not na(tradeLongStop) and not na(eng3SignalLow) and eng3SignalLow <= tradeLongStop
bool longTpHit = longArmedLatched and longPoiMitigatedLatched and not na(activeLongTarget) and not na(eng3SignalHigh) and eng3SignalHigh >= activeLongTarget

// Engine 3 state machine: lifecycle latches keep terminal states stable until
// the setup identity changes.
[nextLastLongSetupTag, nextLongManagedLatched, nextLongCompletedLatched, nextLongAmbiguousLatched, nextLongInvalidatedLatched, longManaged, longCompleted, longAmbiguous, longInvalidated, longExpired] = f_eng3_update_trade_lifecycle(currentLongSetupTag, lastLongSetupTag, longManagedLatched, longCompletedLatched, longAmbiguousLatched, longInvalidatedLatched, longArmedLatched and longPoiMitigatedLatched, longManagedHit, longStopHit, longTpHit, longArmedLatched and effectiveLongStructureInvalidated, longSetupAge, expiryBarsEffective)
lastLongSetupTag := nextLastLongSetupTag
longManagedLatched := nextLongManagedLatched
longCompletedLatched := nextLongCompletedLatched
longAmbiguousLatched := nextLongAmbiguousLatched
longInvalidatedLatched := nextLongInvalidatedLatched

float shortRisk = not na(tradeShortEntry) and not na(tradeShortStop) ? tradeShortStop - tradeShortEntry : na
bool shortPriceInZone = not na(tradeShortValidBottom) and not na(eng3SignalClose) and eng3SignalClose >= tradeShortValidBottom and eng3SignalClose <= tradeShortValidTop
bool shortPriceNearZone = not na(tradeShortEntry) and not na(eng3SignalClose) and math.abs(eng3SignalClose - tradeShortEntry) <= atr * 0.25
int shortSetupAge = not na(tradeShortCreatedBar) ? bar_index - tradeShortCreatedBar : na
string currentShortSetupTag = f_eng3_setup_tag(tradeShortSetup, tradeShortCreatedBar, tradeShortValidTop, tradeShortValidBottom)
bool shortSetupMissing = currentShortSetupTag == ""
bool shortSetupChanged = not shortSetupMissing and currentShortSetupTag != lastShortSetupTag
if shortSetupMissing or shortSetupChanged
    shortPoiTappedLatched := false
    shortPoiMitigatedLatched := false
    shortPoiInvalidatedLatched := false
    shortArmedLatched := false
    eng2ShortTappedEventTag := ""
    eng2ShortMitigatedEventTag := ""
if not shortSetupMissing
    shortPoiMitigatedLatched := shortPoiMitigatedLatched or f_eng3_poi_ce_touched(false, poi_short_type, tradeShortValidTop, tradeShortValidBottom, tradeShortEntry, eng3SignalHigh, eng3SignalLow) or f_eng3_poi_full_filled(false, tradeShortValidTop, tradeShortValidBottom, eng3SignalHigh, eng3SignalLow)
    shortPoiTappedLatched := shortPoiTappedLatched or tradeShortTouched or shortPoiMitigatedLatched
    shortPoiInvalidatedLatched := shortPoiInvalidatedLatched or f_eng3_poi_invalidated(false, tradeShortValidTop, tradeShortValidBottom, eng3SignalClose)
bool shortChased = not shortPoiMitigatedLatched and not na(tradeShortValidBottom) and not na(eng3SignalClose) and eng3SignalClose < tradeShortValidBottom - atr * setupChaseAtr
bool effectiveShortDirectional = displayExecBias == -1 or shortDirectionalFallback
bool effectiveShortSweepSeen = strictModeEnabled ? strictShortRawSweepSignal : eng1_exe_bear_sweep
bool shortMssFallbackBreak = eng3ClosedFallbackAllowed and not na(eng1_exe_mss_ref_low) and not na(eng3ExecPrevClose) and eng3ExecClose < eng1_exe_mss_ref_low and eng3ExecPrevClose >= eng1_exe_mss_ref_low
int shortMssFallbackAge = ta.barssince(shortMssFallbackBreak)
bool shortMssFallbackRecent = not na(shortMssFallbackAge) and shortMssFallbackAge <= strictMssLookbackEffective
bool shortDispFallbackBreak = eng3ClosedFallbackAllowed and eng3ExecClose < eng3ExecOpen and execBarRange >= atr * 0.80 and execBarBodyShare >= 0.50
int shortDispFallbackAge = ta.barssince(shortDispFallbackBreak)
bool shortDispFallbackRecent = not na(shortDispFallbackAge) and shortDispFallbackAge <= strictMssLookbackEffective
bool shortDispFallbackContext = eng1_exe_bear_sweep or shortMssFallbackRecent or eng1_exe_bear_mss
bool shortDispFallback = not strictModeEnabled and shortDispFallbackRecent and shortDispFallbackContext
bool effectiveShortMssSeen = eng1_exe_bear_mss or shortMssFallbackRecent
bool effectiveShortDisplacementSeen = eng1_exe_bear_displacement or shortDispFallback
bool effectiveShortStructureInvalidated = shortPoiInvalidatedLatched or (displayExecBias == 1 and (displayCtxBias == 1 or eng1_ctx_bull_reversal or eng1_exe_bull_mss))
bool normalShortDirectionalContext = displayCtxBias != 1 and (displayExecBias == -1 or effectiveShortDirectional or eng1_ctx_bear_reversal or eng1_ctx_bear_breakout)
bool normalShortBiasPass = eng1_exec_valid and displayNarrBias != 1 and normalShortDirectionalContext
bool normalShortContextPass = (tradeShortIsOb or tradeShortIsFvg) and normalShortDirectionalContext
bool normalShortTargetPass = not na(activeShortTarget)
bool strictShortBiasPass = not strictModeEnabled or (displayNarrBias == -1 and ipdaShortDolAvailable)
bool strictShortContextTfPass = not strictModeEnabled or ((displayCtxBias == -1 or eng1_ctx_bear_reversal or eng1_ctx_bear_breakout or (displayCtxBias == 0 and effectiveShortDirectional)) and (tradeShortIsOb or tradeShortIsFvg))
bool exe_short_sweep_signal = strictModeEnabled ? strictShortRawSweepSignal : (eng1_exe_bear_sweep or shortPriceInZone or shortPriceNearZone or tradeShortTouched)
bool exe_short_mss_signal = strictModeEnabled ? eng1_exe_bear_mss : effectiveShortMssSeen
bool exe_short_displacement_signal = strictModeEnabled ? eng1_exe_bear_displacement : effectiveShortDisplacementSeen
bool strictShortSweepPass = not strictModeEnabled or exe_short_sweep_signal
bool strictShortMssPass = not strictModeEnabled or (exe_short_mss_signal and effectiveShortDirectional)
bool strictShortDisplacementPass = not strictModeEnabled or exe_short_displacement_signal
bool strictShortPdPass = not strictModeEnabled or exe_short_pd_pass
bool strictShortOtePass = not strictModeEnabled or exe_short_ote_pass
bool strictShortDolPass = not strictModeEnabled or exe_short_dol_pass
bool strictShortKillzonePass = not strictModeEnabled or strictKillzoneActive
bool shortPoiRetestPass = shortPriceInZone or shortPriceNearZone or tradeShortTouched
bool shortEvidencePass = exe_short_mss_signal or exe_short_displacement_signal
bool shortHardSignalGate = strictModeEnabled ? (not na(tradeShortEntry) and strictShortBiasPass and strictShortContextTfPass and strictShortPdPass and strictShortOtePass and strictShortDolPass and strictShortKillzonePass and not shortPoiInvalidatedLatched) : (not na(tradeShortEntry) and normalShortBiasPass and normalShortContextPass and normalShortTargetPass and shortPoiRetestPass and shortEvidencePass and not shortPoiInvalidatedLatched)
bool shortScoreTargetClear = shortHardSignalGate ? f_eng3_target_liquidity_clear(activeShortTarget, eng1_exe_liq_low, eng1_exe_eql_active ? eng1_exe_eql : na, eng1CtxRangeLow, shortUsesExternalDolTarget) : false
bool shortScoreHtfPenalty = shortHardSignalGate ? (eng1_narr_strength == "Strong" and displayNarrBias == 1) : false
bool shortScorePdPenalty = shortHardSignalGate ? (not na(tradeShortEntry) and eng1CtxRangeReady and not na(eng1CtxEquilibrium) and tradeShortEntry < eng1CtxEquilibrium) : false
bool shortScoreFvgPenalty = shortHardSignalGate ? (tradeShortIsFvg and (shortPoiMitigatedLatched or shortChased)) : false
int shortSignalScore = shortHardSignalGate ? f_eng3_dynamic_signal_score(effectiveShortSweepSeen, exe_short_displacement_signal, exe_short_mss_signal, hasBearFvg, exe_short_pd_pass, strictKillzoneActive, shortScoreTargetClear, shortScoreHtfPenalty, shortScorePdPenalty, shortScoreFvgPenalty) : 0
bool exe_short_contract_confirm = strictModeEnabled ? (strictShortBiasPass and strictShortContextTfPass and strictShortSweepPass and strictShortMssPass and strictShortDisplacementPass and strictShortPdPass and strictShortOtePass and strictShortDolPass and strictShortKillzonePass) : shortSignalScore >= 6
bool exe_short_confirm = not na(tradeShortEntry) and exe_short_contract_confirm
shortArmedLatched := shortArmedLatched or exe_short_confirm
bool shortManagedHit = shortArmedLatched and shortPoiMitigatedLatched and not na(shortRisk) and not na(eng3SignalLow) and eng3SignalLow <= tradeShortEntry - shortRisk * setupManagedR
bool shortStopHit = shortArmedLatched and not na(tradeShortStop) and not na(eng3SignalHigh) and eng3SignalHigh >= tradeShortStop
bool shortTpHit = shortArmedLatched and shortPoiMitigatedLatched and not na(activeShortTarget) and not na(eng3SignalLow) and eng3SignalLow <= activeShortTarget
[nextLastShortSetupTag, nextShortManagedLatched, nextShortCompletedLatched, nextShortAmbiguousLatched, nextShortInvalidatedLatched, shortManaged, shortCompleted, shortAmbiguous, shortInvalidated, shortExpired] = f_eng3_update_trade_lifecycle(currentShortSetupTag, lastShortSetupTag, shortManagedLatched, shortCompletedLatched, shortAmbiguousLatched, shortInvalidatedLatched, shortArmedLatched and shortPoiMitigatedLatched, shortManagedHit, shortStopHit, shortTpHit, shortArmedLatched and effectiveShortStructureInvalidated, shortSetupAge, expiryBarsEffective)
lastShortSetupTag := nextLastShortSetupTag
shortManagedLatched := nextShortManagedLatched
shortCompletedLatched := nextShortCompletedLatched
shortAmbiguousLatched := nextShortAmbiguousLatched
shortInvalidatedLatched := nextShortInvalidatedLatched

bool dashLongTriggerSweepOk = strictModeEnabled ? strictLongSweepPass : effectiveLongSweepSeen
bool dashShortTriggerSweepOk = strictModeEnabled ? strictShortSweepPass : effectiveShortSweepSeen
bool dashLongTriggerMssOk = strictModeEnabled ? strictLongMssPass : (effectiveLongMssSeen and effectiveLongDirectional)
bool dashShortTriggerMssOk = strictModeEnabled ? strictShortMssPass : (effectiveShortMssSeen and effectiveShortDirectional)
bool dashLongTriggerDisplacementOk = strictModeEnabled ? strictLongDisplacementPass : effectiveLongDisplacementSeen
bool dashShortTriggerDisplacementOk = strictModeEnabled ? strictShortDisplacementPass : effectiveShortDisplacementSeen

// Dynamic signal grading is intentionally small: hard gates protect validity,
// while the score only ranks confluence quality. Volume and value acceptance
// are one-point bonuses, not mandatory AVP-style gates, so normal mode remains
// simple and non-overfit.
bool longZoneQualityResponsePass = strictModeEnabled ? (exe_long_pd_pass and exe_long_ote_pass) : (longPriceInZone or longPriceNearZone or tradeLongTouched or exe_long_pd_pass)
bool shortZoneQualityResponsePass = strictModeEnabled ? (exe_short_pd_pass and exe_short_ote_pass) : (shortPriceInZone or shortPriceNearZone or tradeShortTouched or exe_short_pd_pass)
bool longLifecycleBasePass = longArmedLatched or (not na(tradeLongEntry) and effectiveLongDirectional and effectiveLongMssSeen and (effectiveLongSweepSeen or longPriceInZone or longPriceNearZone))
bool shortLifecycleBasePass = shortArmedLatched or (not na(tradeShortEntry) and effectiveShortDirectional and effectiveShortMssSeen and (effectiveShortSweepSeen or shortPriceInZone or shortPriceNearZone))
float contextDepartureRange = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeLow : na
bool longZoneOverlapBonus = (tradeLongIsOb or tradeLongIsFvg) and hasBullOb and hasBullFvg and f_zoneIntersects(ctxBullObTop, ctxBullObBottom, ctxBullFvgTop, ctxBullFvgBottom)
bool shortZoneOverlapBonus = (tradeShortIsOb or tradeShortIsFvg) and hasBearOb and hasBearFvg and f_zoneIntersects(ctxBearObTop, ctxBearObBottom, ctxBearFvgTop, ctxBearFvgBottom)
int longZoneResponseScore = (not na(tradeLongEntry) ? (longZoneQualityResponsePass ? 2 : 1) : 0) + (longZoneOverlapBonus ? 1 : 0)
int shortZoneResponseScore = (not na(tradeShortEntry) ? (shortZoneQualityResponsePass ? 2 : 1) : 0) + (shortZoneOverlapBonus ? 1 : 0)
int longZoneDisplacementScore = effectiveLongDisplacementSeen ? 2 : 0
int shortZoneDisplacementScore = effectiveShortDisplacementSeen ? 2 : 0
int zoneAtrExpansionScore = na(contextDepartureRange) or na(atr) or atr <= 0 ? 0 : contextDepartureRange >= atr * 2.0 ? 2 : contextDepartureRange >= atr ? 1 : 0
string longQualityTier = f_zoneQualityTier(not na(tradeLongEntry), longZoneResponseScore, longZoneDisplacementScore, zoneAtrExpansionScore)
string shortQualityTier = f_zoneQualityTier(not na(tradeShortEntry), shortZoneResponseScore, shortZoneDisplacementScore, zoneAtrExpansionScore)
string longExecutionState = f_setupExecutionState(not na(tradeLongEntry), longAmbiguous, longInvalidated, longExpired, longChased, longCompleted, longManaged, longLifecycleBasePass, exe_long_confirm or longArmedLatched, effectiveLongMssSeen or longArmedLatched, effectiveLongDisplacementSeen or longArmedLatched, longPriceInZone or longPoiMitigatedLatched, longPriceNearZone)
string shortExecutionState = f_setupExecutionState(not na(tradeShortEntry), shortAmbiguous, shortInvalidated, shortExpired, shortChased, shortCompleted, shortManaged, shortLifecycleBasePass, exe_short_confirm or shortArmedLatched, effectiveShortMssSeen or shortArmedLatched, effectiveShortDisplacementSeen or shortArmedLatched, shortPriceInZone or shortPoiMitigatedLatched, shortPriceNearZone)
bool longRiskVisible = f_executionRiskVisible(longExecutionState)
bool shortRiskVisible = f_executionRiskVisible(shortExecutionState)
bool longExecutionTerminal = f_executionTerminal(longExecutionState)
bool shortExecutionTerminal = f_executionTerminal(shortExecutionState)
bool longExecutionActive = longExecutionState == "Active"
bool shortExecutionActive = shortExecutionState == "Active"
bool longLifecycleRetired = f_eng4_retired_state(longExecutionState, longSetupAge, longPoiMitigatedLatched, expiryBarsEffective)
bool shortLifecycleRetired = f_eng4_retired_state(shortExecutionState, shortSetupAge, shortPoiMitigatedLatched, expiryBarsEffective)
bool longLifecycleStaleRetired = longLifecycleRetired and not longCompleted and not longInvalidated and not longExpired and not longChased and not longPoiInvalidatedLatched
bool shortLifecycleStaleRetired = shortLifecycleRetired and not shortCompleted and not shortInvalidated and not shortExpired and not shortChased and not shortPoiInvalidatedLatched
string longPoiRetireReason = f_eng3_poi_retire_reason(longCompleted, longInvalidated or longPoiInvalidatedLatched, longExpired, longChased, longLifecycleStaleRetired)
string shortPoiRetireReason = f_eng3_poi_retire_reason(shortCompleted, shortInvalidated or shortPoiInvalidatedLatched, shortExpired, shortChased, shortLifecycleStaleRetired)
if eng3LongActivePoiIdentity != "" and (longPoiInvalidatedLatched or longLifecycleRetired)
    eng3LongConsumedPoiIdentity := eng3LongActivePoiIdentity
if eng3ShortActivePoiIdentity != "" and (shortPoiInvalidatedLatched or shortLifecycleRetired)
    eng3ShortConsumedPoiIdentity := eng3ShortActivePoiIdentity
string longPoiLifecycle = f_eng3_poi_lifecycle(poi_long_contract_valid, poi_long_type, longPoiTappedLatched, longPoiMitigatedLatched, longPoiInvalidatedLatched)
string shortPoiLifecycle = f_eng3_poi_lifecycle(poi_short_contract_valid, poi_short_type, shortPoiTappedLatched, shortPoiMitigatedLatched, shortPoiInvalidatedLatched)
bool longPoiActionable = f_eng3_poi_actionable(longPoiLifecycle)
bool shortPoiActionable = f_eng3_poi_actionable(shortPoiLifecycle)
bool longPoiMitigated = longPoiLifecycle == "Mitigated"
bool shortPoiMitigated = shortPoiLifecycle == "Mitigated"
bool longPoiEventReached = longPoiTappedLatched or longPoiMitigatedLatched
bool shortPoiEventReached = shortPoiTappedLatched or shortPoiMitigatedLatched

string longZoneQualityText = poi_long_contract_valid and longPoiActionable and not na(tradeLongEntry) ? longQualityTier : "-"
string shortZoneQualityText = poi_short_contract_valid and shortPoiActionable and not na(tradeShortEntry) ? shortQualityTier : "-"

// Selected POI stays visible through Fresh/Tapped/Mitigated, but Engine 2 only
// promotes it to SetupReady after Engine 3 has an armed/active risk state.
bool longSelectedVisualActive = not na(tradeLongEntry) and (longPoiActionable or longPoiMitigated) and not longExecutionTerminal
bool shortSelectedVisualActive = not na(tradeShortEntry) and (shortPoiActionable or shortPoiMitigated) and not shortExecutionTerminal
string eng2VisualState = (longRiskVisible or shortRiskVisible) ? "SetupReady" : ((poi_long_contract_valid and longPoiActionable) or (poi_short_contract_valid and shortPoiActionable)) ? "POIReady" : eng2DealReady ? "DRReady" : "StructureOnly"
bool eng2SignalEventsStateReady = eng2VisualState == "POIReady" or eng2VisualState == "SetupReady"
bool eng2SignalRawStateReady = eng1_exec_valid and eng2SignalEventsStateReady
string preferredDirection = "Wait"
bool longPreferredReady = longRiskVisible
bool shortPreferredReady = shortRiskVisible
bool longPriorityCandidate = not na(tradeLongEntry) and not longLifecycleRetired
bool shortPriorityCandidate = not na(tradeShortEntry) and not shortLifecycleRetired
if longPreferredReady and not shortPreferredReady
    preferredDirection := "Long"
else if shortPreferredReady and not longPreferredReady
    preferredDirection := "Short"
else if longPreferredReady and shortPreferredReady
    preferredDirection := "Balanced"

bool compactUseLong = preferredDirection == "Long"
if preferredDirection == "Short"
    compactUseLong := false
else
    if longPriorityCandidate and not shortPriorityCandidate
        compactUseLong := true
    else if shortPriorityCandidate and not longPriorityCandidate
        compactUseLong := false
    else if not na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := tradeLongCreatedBar >= tradeShortCreatedBar
    else if na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := false

//------------------------------------------------------------------------------
// ENGINE 2
// MAIN_CONTRACT order 8: render chart from snapshots only, after Engine 3 has
// produced zone, confirmations, trade plan, and lifecycle snapshots.
//------------------------------------------------------------------------------

bool draw_long_selected = longSelectedVisualActive and ((tradeLongIsOb and showOb) or (tradeLongIsFvg and showFvg))
bool draw_short_selected = shortSelectedVisualActive and ((tradeShortIsOb and showOb) or (tradeShortIsFvg and showFvg))
float draw_long_zone_top = draw_long_selected ? tradeLongValidTop : na
float draw_long_zone_bottom = draw_long_selected ? tradeLongValidBottom : na
float draw_short_zone_top = draw_short_selected ? tradeShortValidTop : na
float draw_short_zone_bottom = draw_short_selected ? tradeShortValidBottom : na
string draw_long_zone_type = draw_long_selected ? (tradeLongIsOb ? "OB" : tradeLongIsFvg ? "FVG" : "") : ""
string draw_short_zone_type = draw_short_selected ? (tradeShortIsOb ? "OB" : tradeShortIsFvg ? "FVG" : "") : ""
bool showEng2LongLiveZone = draw_long_selected and f_draw_zone_visible(draw_mode, true, true, preferredDirection)
bool showEng2ShortLiveZone = draw_short_selected and f_draw_zone_visible(draw_mode, true, false, preferredDirection)

bool longTerminalSnapshot = longExecutionTerminal and not longSetupMissing and eng2LongHistoryTag != currentLongSetupTag
bool shortTerminalSnapshot = shortExecutionTerminal and not shortSetupMissing and eng2ShortHistoryTag != currentShortSetupTag
if longTerminalSnapshot
    eng2LongHistoryTag := currentLongSetupTag
    eng2LongHistoryLeftBar := f_createdBarFallback(tradeLongCreatedBar)
    eng2LongHistoryRightBar := bar_index
    eng2LongHistoryTop := tradeLongValidTop
    eng2LongHistoryBottom := tradeLongValidBottom
    eng2LongHistoryIsOb := tradeLongIsOb
    eng2LongHistoryIsFvg := tradeLongIsFvg
if shortTerminalSnapshot
    eng2ShortHistoryTag := currentShortSetupTag
    eng2ShortHistoryLeftBar := f_createdBarFallback(tradeShortCreatedBar)
    eng2ShortHistoryRightBar := bar_index
    eng2ShortHistoryTop := tradeShortValidTop
    eng2ShortHistoryBottom := tradeShortValidBottom
    eng2ShortHistoryIsOb := tradeShortIsOb
    eng2ShortHistoryIsFvg := tradeShortIsFvg

bool historyZonesEnabled = eng1_exec_valid and draw_full and (showOb or showFvg) and not compactMode
// Context zones start only when Engine 3 has a POI; before that, chart stays in
// StructureOnly/DRReady so users do not read raw context as a tradable setup.
bool eng2ContextZonesEnabled = eng1_exec_valid and draw_full and (showOb or showFvg) and not compactMode and eng2SignalEventsStateReady
bool longCtxReplacementBase = eng2ContextZonesEnabled and poi_long_contract_valid
bool shortCtxReplacementBase = eng2ContextZonesEnabled and poi_short_contract_valid
bool longLiveBlocksBullOb = showEng2LongLiveZone and tradeLongIsOb and f_eng2_same_zone_visual(eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng1BullObCreatedBar, draw_long_zone_top, draw_long_zone_bottom, tradeLongCreatedBar)
bool longLiveBlocksBullFvg = showEng2LongLiveZone and tradeLongIsFvg and f_eng2_same_zone_visual(eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng1BullFvgCreatedBar, draw_long_zone_top, draw_long_zone_bottom, tradeLongCreatedBar)
bool shortLiveBlocksBearOb = showEng2ShortLiveZone and tradeShortIsOb and f_eng2_same_zone_visual(eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng1BearObCreatedBar, draw_short_zone_top, draw_short_zone_bottom, tradeShortCreatedBar)
bool shortLiveBlocksBearFvg = showEng2ShortLiveZone and tradeShortIsFvg and f_eng2_same_zone_visual(eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng1BearFvgCreatedBar, draw_short_zone_top, draw_short_zone_bottom, tradeShortCreatedBar)
bool longCtxBullObReplacementCandidate = longCtxReplacementBase and showOb and not tradeLongIsOb and not na(eng1_ctx_bull_ob_top) and not na(eng1_ctx_bull_ob_bottom) and not longLiveBlocksBullOb
bool longCtxBullFvgReplacementCandidate = longCtxReplacementBase and showFvg and not tradeLongIsFvg and not na(eng1_ctx_bull_fvg_top) and not na(eng1_ctx_bull_fvg_bottom) and not longLiveBlocksBullFvg
bool shortCtxBearObReplacementCandidate = shortCtxReplacementBase and showOb and not tradeShortIsOb and not na(eng1_ctx_bear_ob_top) and not na(eng1_ctx_bear_ob_bottom) and not shortLiveBlocksBearOb
bool shortCtxBearFvgReplacementCandidate = shortCtxReplacementBase and showFvg and not tradeShortIsFvg and not na(eng1_ctx_bear_fvg_top) and not na(eng1_ctx_bear_fvg_bottom) and not shortLiveBlocksBearFvg
// Active/current context owns the right edge. If the same OB/FVG is still live
// in Engine 1, hide the stale terminal snapshot so the active zone can continue
// to the current bar instead of looking visually cut off.
bool longHistoryDrawableType = (eng2LongHistoryIsOb and showOb) or (eng2LongHistoryIsFvg and showFvg)
bool shortHistoryDrawableType = (eng2ShortHistoryIsOb and showOb) or (eng2ShortHistoryIsFvg and showFvg)
bool longHistoryZoneCandidate = historyZonesEnabled and eng2LongHistoryTag != "" and not na(eng2LongHistoryTop) and not na(eng2LongHistoryBottom) and longHistoryDrawableType
bool longHistoryMatchesLiveZone = f_eng2_matches_history_zone(showEng2LongLiveZone, (eng2LongHistoryIsOb and tradeLongIsOb) or (eng2LongHistoryIsFvg and tradeLongIsFvg), draw_long_zone_top, draw_long_zone_bottom, tradeLongCreatedBar, eng2LongHistoryTop, eng2LongHistoryBottom, eng2LongHistoryLeftBar)
bool longHistoryMatchesCtxBullOb = f_eng2_matches_history_zone(longCtxBullObReplacementCandidate and eng2LongHistoryIsOb, true, eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng1BullObCreatedBar, eng2LongHistoryTop, eng2LongHistoryBottom, eng2LongHistoryLeftBar)
bool longHistoryMatchesCtxBullFvg = f_eng2_matches_history_zone(longCtxBullFvgReplacementCandidate and eng2LongHistoryIsFvg, true, eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng1BullFvgCreatedBar, eng2LongHistoryTop, eng2LongHistoryBottom, eng2LongHistoryLeftBar)
bool longHistoryHiddenByActiveZone = longHistoryMatchesLiveZone or longHistoryMatchesCtxBullOb or longHistoryMatchesCtxBullFvg
bool showEng2LongHistoryZone = longHistoryZoneCandidate and not longHistoryHiddenByActiveZone
bool shortHistoryZoneCandidate = historyZonesEnabled and eng2ShortHistoryTag != "" and not na(eng2ShortHistoryTop) and not na(eng2ShortHistoryBottom) and shortHistoryDrawableType
bool shortHistoryMatchesLiveZone = f_eng2_matches_history_zone(showEng2ShortLiveZone, (eng2ShortHistoryIsOb and tradeShortIsOb) or (eng2ShortHistoryIsFvg and tradeShortIsFvg), draw_short_zone_top, draw_short_zone_bottom, tradeShortCreatedBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, eng2ShortHistoryLeftBar)
bool shortHistoryMatchesCtxBearOb = f_eng2_matches_history_zone(shortCtxBearObReplacementCandidate and eng2ShortHistoryIsOb, true, eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng1BearObCreatedBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, eng2ShortHistoryLeftBar)
bool shortHistoryMatchesCtxBearFvg = f_eng2_matches_history_zone(shortCtxBearFvgReplacementCandidate and eng2ShortHistoryIsFvg, true, eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng1BearFvgCreatedBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, eng2ShortHistoryLeftBar)
bool shortHistoryHiddenByActiveZone = shortHistoryMatchesLiveZone or shortHistoryMatchesCtxBearOb or shortHistoryMatchesCtxBearFvg
bool showEng2ShortHistoryZone = shortHistoryZoneCandidate and not shortHistoryHiddenByActiveZone
// Keep terminal history snapshots frozen; only the draw call receives a moving
// right edge so history remains visual-only and cannot become live state.
int eng2LongHistoryVisualRightBar = showEng2LongHistoryZone ? bar_index : eng2LongHistoryRightBar
int eng2ShortHistoryVisualRightBar = showEng2ShortHistoryZone ? bar_index : eng2ShortHistoryRightBar
string eng2LongZoneBadge = f_executionStateBadge(longExecutionState, compactMode)
string eng2ShortZoneBadge = f_executionStateBadge(shortExecutionState, compactMode)
string eng2LongZoneBaseLabel = draw_long_zone_type == "OB" ? f_obLabelText(true, eng1_ctx_bull_ob_breaker) : draw_long_zone_type == "FVG" ? f_fvgLabelText(true) : ""
string eng2ShortZoneBaseLabel = draw_short_zone_type == "OB" ? f_obLabelText(false, eng1_ctx_bear_ob_breaker) : draw_short_zone_type == "FVG" ? f_fvgLabelText(false) : ""
string longPoiLifecycleText = f_poiLifecycleDisplayText(longPoiLifecycle, poi_long_type)
string shortPoiLifecycleText = f_poiLifecycleDisplayText(shortPoiLifecycle, poi_short_type)
string eng2LongZoneLabelCore = eng2LongZoneBadge != "" ? eng2LongZoneBaseLabel + " | " + longPoiLifecycleText + " | " + eng2LongZoneBadge : eng2LongZoneBaseLabel + " | " + longPoiLifecycleText
string eng2ShortZoneLabelCore = eng2ShortZoneBadge != "" ? eng2ShortZoneBaseLabel + " | " + shortPoiLifecycleText + " | " + eng2ShortZoneBadge : eng2ShortZoneBaseLabel + " | " + shortPoiLifecycleText
string eng2LongZoneLabelText = eng2LongZoneBaseLabel == "" ? "" : eng2LongZoneLabelCore + f_zoneQualityLabelSuffix(longZoneQualityText)
string eng2ShortZoneLabelText = eng2ShortZoneBaseLabel == "" ? "" : eng2ShortZoneLabelCore + f_zoneQualityLabelSuffix(shortZoneQualityText)
int eng2LongZoneBorderWidth = longPoiMitigated ? 1 : math.max(f_zoneQualityBorderWidth(longZoneQualityText), longExecutionActive ? 3 : 2)
int eng2ShortZoneBorderWidth = shortPoiMitigated ? 1 : math.max(f_zoneQualityBorderWidth(shortZoneQualityText), shortExecutionActive ? 3 : 2)
color eng2LongZoneBorder = color.new(bullColor, longPoiMitigated ? 70 : f_zoneQualityBorderAlpha(longZoneQualityText, longExecutionState))
color eng2ShortZoneBorder = color.new(bearColor, shortPoiMitigated ? 70 : f_zoneQualityBorderAlpha(shortZoneQualityText, shortExecutionState))
color eng2LongZoneFill = color.new(bullColor, longPoiMitigated ? 92 : f_executionSelectedFillAlpha(longExecutionState))
color eng2ShortZoneFill = color.new(bearColor, shortPoiMitigated ? 92 : f_executionSelectedFillAlpha(shortExecutionState))

bool longHistoryBlocksBullOb = f_eng2_matches_history_zone(showEng2LongHistoryZone, eng2LongHistoryIsOb, eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng1BullObCreatedBar, eng2LongHistoryTop, eng2LongHistoryBottom, eng2LongHistoryLeftBar)
bool longHistoryBlocksBullFvg = f_eng2_matches_history_zone(showEng2LongHistoryZone, eng2LongHistoryIsFvg, eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng1BullFvgCreatedBar, eng2LongHistoryTop, eng2LongHistoryBottom, eng2LongHistoryLeftBar)
bool shortHistoryBlocksBearOb = f_eng2_matches_history_zone(showEng2ShortHistoryZone, eng2ShortHistoryIsOb, eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng1BearObCreatedBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, eng2ShortHistoryLeftBar)
bool shortHistoryBlocksBearFvg = f_eng2_matches_history_zone(showEng2ShortHistoryZone, eng2ShortHistoryIsFvg, eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng1BearFvgCreatedBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, eng2ShortHistoryLeftBar)
bool showEng2CtxBullOb = longCtxBullObReplacementCandidate and not longHistoryBlocksBullOb
bool showEng2CtxBullFvg = longCtxBullFvgReplacementCandidate and not longHistoryBlocksBullFvg
bool showEng2CtxBearOb = shortCtxBearObReplacementCandidate and not shortHistoryBlocksBearOb
bool showEng2CtxBearFvg = shortCtxBearFvgReplacementCandidate and not shortHistoryBlocksBearFvg
// Empty passive context paths skip sync work; existing handles still clear here.
bool eng2AnyPassiveCtxZoneVisible = showEng2CtxBullOb or showEng2CtxBullFvg or showEng2CtxBearOb or showEng2CtxBearFvg
bool eng2PassiveCtxVisualsHaveHandles = not na(eng2CtxBullObBox) or not na(eng2CtxBullObLabel) or not na(eng2CtxBullFvgBox) or not na(eng2CtxBullFvgLabel) or not na(eng2CtxBearObBox) or not na(eng2CtxBearObLabel) or not na(eng2CtxBearFvgBox) or not na(eng2CtxBearFvgLabel)
bool eng2PassiveCtxVisualsNeedSync = eng2AnyPassiveCtxZoneVisible or eng2PassiveCtxVisualsHaveHandles
if eng2PassiveCtxVisualsNeedSync
    [eng2CtxBullObBoxTmp, eng2CtxBullObLabelTmp] = f_eng2_syncPassiveZoneVisual(eng2CtxBullObBox, eng2CtxBullObLabel, showEng2CtxBullOb, eng1BullObCreatedBar, eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, color.new(bullColor, 72), color.new(bullColor, 97))
    [eng2CtxBullFvgBoxTmp, eng2CtxBullFvgLabelTmp] = f_eng2_syncPassiveZoneVisual(eng2CtxBullFvgBox, eng2CtxBullFvgLabel, showEng2CtxBullFvg, eng1BullFvgCreatedBar, eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, color.new(bullColor, 82), color.new(bullColor, 98))
    [eng2CtxBearObBoxTmp, eng2CtxBearObLabelTmp] = f_eng2_syncPassiveZoneVisual(eng2CtxBearObBox, eng2CtxBearObLabel, showEng2CtxBearOb, eng1BearObCreatedBar, eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, color.new(bearColor, 72), color.new(bearColor, 97))
    [eng2CtxBearFvgBoxTmp, eng2CtxBearFvgLabelTmp] = f_eng2_syncPassiveZoneVisual(eng2CtxBearFvgBox, eng2CtxBearFvgLabel, showEng2CtxBearFvg, eng1BearFvgCreatedBar, eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, color.new(bearColor, 82), color.new(bearColor, 98))
    eng2CtxBullObBox := eng2CtxBullObBoxTmp
    eng2CtxBullObLabel := eng2CtxBullObLabelTmp
    eng2CtxBullFvgBox := eng2CtxBullFvgBoxTmp
    eng2CtxBullFvgLabel := eng2CtxBullFvgLabelTmp
    eng2CtxBearObBox := eng2CtxBearObBoxTmp
    eng2CtxBearObLabel := eng2CtxBearObLabelTmp
    eng2CtxBearFvgBox := eng2CtxBearFvgBoxTmp
    eng2CtxBearFvgLabel := eng2CtxBearFvgLabelTmp

// Empty live setup paths skip sync work; existing objects still clear here.
bool eng2LongLiveZoneNeedsSync = showEng2LongLiveZone or not na(eng2LongZoneBox) or not na(eng2LongZoneLine) or not na(eng2LongZoneLabel)
bool eng2ShortLiveZoneNeedsSync = showEng2ShortLiveZone or not na(eng2ShortZoneBox) or not na(eng2ShortZoneLine) or not na(eng2ShortZoneLabel)
if eng2LongLiveZoneNeedsSync
    [eng2LongZoneBoxTmp, eng2LongZoneLineTmp, eng2LongZoneLabelTmp] = f_eng2_syncSetupZoneVisual(eng2LongZoneBox, eng2LongZoneLine, eng2LongZoneLabel, showEng2LongLiveZone, tradeLongCreatedBar, draw_long_zone_top, draw_long_zone_bottom, tradeLongEntry, eng2LongZoneLabelText, tradeLongIsOb ? label.style_label_right : label.style_label_left, eng2LongZoneBorder, eng2LongZoneFill, eng2LongZoneBorderWidth, tradeLongIsOb or tradeLongIsFvg, longExecutionState)
    eng2LongZoneBox := eng2LongZoneBoxTmp
    eng2LongZoneLine := eng2LongZoneLineTmp
    eng2LongZoneLabel := eng2LongZoneLabelTmp
if eng2ShortLiveZoneNeedsSync
    [eng2ShortZoneBoxTmp, eng2ShortZoneLineTmp, eng2ShortZoneLabelTmp] = f_eng2_syncSetupZoneVisual(eng2ShortZoneBox, eng2ShortZoneLine, eng2ShortZoneLabel, showEng2ShortLiveZone, tradeShortCreatedBar, draw_short_zone_top, draw_short_zone_bottom, tradeShortEntry, eng2ShortZoneLabelText, tradeShortIsOb ? label.style_label_right : label.style_label_left, eng2ShortZoneBorder, eng2ShortZoneFill, eng2ShortZoneBorderWidth, tradeShortIsOb or tradeShortIsFvg, shortExecutionState)
    eng2ShortZoneBox := eng2ShortZoneBoxTmp
    eng2ShortZoneLine := eng2ShortZoneLineTmp
    eng2ShortZoneLabel := eng2ShortZoneLabelTmp

// History boxes should stay visible, but feel lighter than the live / selected zone.
// Empty history paths skip sync work; existing boxes still clear here.
bool eng2LongHistoryZoneNeedsSync = showEng2LongHistoryZone or not na(eng2LongHistoryBox)
bool eng2ShortHistoryZoneNeedsSync = showEng2ShortHistoryZone or not na(eng2ShortHistoryBox)
if eng2LongHistoryZoneNeedsSync
    eng2LongHistoryBox := f_eng2_syncHistoryZoneBox(eng2LongHistoryBox, showEng2LongHistoryZone, eng2LongHistoryLeftBar, eng2LongHistoryVisualRightBar, eng2LongHistoryTop, eng2LongHistoryBottom, color.new(bullColor, 80), color.new(bullColor, 98), 1)
if eng2ShortHistoryZoneNeedsSync
    eng2ShortHistoryBox := f_eng2_syncHistoryZoneBox(eng2ShortHistoryBox, showEng2ShortHistoryZone, eng2ShortHistoryLeftBar, eng2ShortHistoryVisualRightBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, color.new(bearColor, 80), color.new(bearColor, 98), 1)

bool eng2AnySetupZoneVisible = showEng2LongLiveZone or showEng2ShortLiveZone
bool eng2LongSetupEventAllowed = draw_show_setup_events and eng2SignalEventsStateReady and showEng2LongLiveZone
bool eng2ShortSetupEventAllowed = draw_show_setup_events and eng2SignalEventsStateReady and showEng2ShortLiveZone
bool eng2FullLabelBudgetTight = freeSafeMode and draw_full
bool eng2RawEventLabelsAllowed = eng2SignalRawStateReady and not eng2AnySetupZoneVisible and not eng2FullLabelBudgetTight
bool eng2KeepSweepLabels = displaySweepMarkers and eng2RawEventLabelsAllowed
bool eng2KeepSetupLabels = eng2LongSetupEventAllowed or eng2ShortSetupEventAllowed
int eng2EventKeepCap = eng2KeepSweepLabels or eng2KeepSetupLabels ? f_eng2_signal_event_cap() : 0
f_eng2_trim_signal_event_history(eng2EventKeepCap)
if not eng2LongSetupEventAllowed and (eng2LongTappedEventTag != "" or eng2LongMitigatedEventTag != "")
    eng2LongTappedEventTag := ""
    eng2LongMitigatedEventTag := ""
if not eng2ShortSetupEventAllowed and (eng2ShortTappedEventTag != "" or eng2ShortMitigatedEventTag != "")
    eng2ShortTappedEventTag := ""
    eng2ShortMitigatedEventTag := ""
if not eng2KeepSweepLabels and (not na(eng2LastLongSweepLabelBar) or not na(eng2LastShortSweepLabelBar) or not na(eng2LastBullDispLabelBar) or not na(eng2LastBearDispLabelBar))
    eng2LastLongSweepLabelBar := na
    eng2LastShortSweepLabelBar := na
    eng2LastBullDispLabelBar := na
    eng2LastBearDispLabelBar := na

bool eng2EventCreateAllowed = barstate.isnew
bool eng2RawEventCreateReady = eng2EventCreateAllowed and eng2RawEventLabelsAllowed
bool eng2LongSetupEventStateReady = eng2EventCreateAllowed and eng2LongSetupEventAllowed
bool eng2ShortSetupEventStateReady = eng2EventCreateAllowed and eng2ShortSetupEventAllowed
bool eng2AnyEventCreateReady = eng2RawEventCreateReady or eng2LongSetupEventStateReady or eng2ShortSetupEventStateReady
if eng2AnyEventCreateReady
    int eng2EventTime = nz(f_eng1_select_execution_time(eng1_exec_tf), time)
    float eng2EventLow = nz(eng3SignalLow, low)
    float eng2EventHigh = nz(eng3SignalHigh, high)
    bool eng2SweepEventStateReady = eng2RawEventCreateReady and displaySweepMarkers and eng1_exec_valid
    bool eng2StructureEventStateReady = eng2RawEventCreateReady and draw_show_structure
    bool eng2RawPayloadReady = eng2SweepEventStateReady or eng2StructureEventStateReady
    if eng2RawPayloadReady
        int eng2RawEventCooldownBars = chartTfSeconds <= 60 ? 8 : chartTfSeconds <= 300 ? 5 : chartTfSeconds <= 900 ? 3 : 2
        if eng2SweepEventStateReady
            bool eng2LongSweepEvent = (na(eng2LastLongSweepLabelBar) or bar_index - eng2LastLongSweepLabelBar >= eng2RawEventCooldownBars) and effectiveLongSweepSeen and not effectiveLongSweepSeen[1]
            bool eng2ShortSweepEvent = (na(eng2LastShortSweepLabelBar) or bar_index - eng2LastShortSweepLabelBar >= eng2RawEventCooldownBars) and effectiveShortSweepSeen and not effectiveShortSweepSeen[1]
            if eng2LongSweepEvent
                eng2LastLongSweepLabelBar := bar_index
                f_eng2_emitSignalEvent(true, eng2EventTime, eng2EventLow, eng1_exe_eql_active ? "EQL Sweep" : "SSL Sweep", color.new(bullColor, 12), false, 0.98)
            if eng2ShortSweepEvent
                eng2LastShortSweepLabelBar := bar_index
                f_eng2_emitSignalEvent(true, eng2EventTime, eng2EventHigh, eng1_exe_eqh_active ? "EQH Sweep" : "BSL Sweep", color.new(bearColor, 12), true, 0.98)
        if eng2StructureEventStateReady
            bool eng2BullDispEvent = eng1_exe_bull_displacement and not eng1_exe_bull_displacement[1] or longDispFallback and not longDispFallback[1]
            bool eng2BearDispEvent = eng1_exe_bear_displacement and not eng1_exe_bear_displacement[1] or shortDispFallback and not shortDispFallback[1]
            bool eng2BullDispLabelEvent = (na(eng2LastBullDispLabelBar) or bar_index - eng2LastBullDispLabelBar >= eng2RawEventCooldownBars) and eng2BullDispEvent
            bool eng2BearDispLabelEvent = (na(eng2LastBearDispLabelBar) or bar_index - eng2LastBearDispLabelBar >= eng2RawEventCooldownBars) and eng2BearDispEvent
            if eng2BullDispLabelEvent
                eng2LastBullDispLabelBar := bar_index
                f_eng2_emitSignalEvent(true, eng2EventTime, eng2EventLow, "Disp+", color.new(bullColor, 15), false, 1.26)
            if eng2BearDispLabelEvent
                eng2LastBearDispLabelBar := bar_index
                f_eng2_emitSignalEvent(true, eng2EventTime, eng2EventHigh, "Disp-", color.new(bearColor, 15), true, 1.26)
    bool eng2SetupPayloadReady = eng2LongSetupEventStateReady or eng2ShortSetupEventStateReady
    if eng2SetupPayloadReady
        bool eng2LongSetupLabelReady = eng2LongSetupEventStateReady and not longSetupMissing
        bool eng2ShortSetupLabelReady = eng2ShortSetupEventStateReady and not shortSetupMissing
        bool eng2ShowLongTappedLabel = eng2LongSetupLabelReady and longPoiTappedLatched and eng2LongTappedEventTag != currentLongSetupTag
        bool eng2ShowLongCeLabel = eng2LongSetupLabelReady and longPoiMitigatedLatched and eng2LongMitigatedEventTag != currentLongSetupTag
        bool eng2ShowShortTappedLabel = eng2ShortSetupLabelReady and shortPoiTappedLatched and eng2ShortTappedEventTag != currentShortSetupTag
        bool eng2ShowShortCeLabel = eng2ShortSetupLabelReady and shortPoiMitigatedLatched and eng2ShortMitigatedEventTag != currentShortSetupTag
        if eng2ShowLongTappedLabel
            eng2LongTappedEventTag := currentLongSetupTag
            f_eng2_emitSignalEvent(true, eng2EventTime, nz(tradeLongEntry, eng2EventLow), "Tapped", color.new(bullColor, 5), false, 1.50)
        if eng2ShowLongCeLabel
            eng2LongMitigatedEventTag := currentLongSetupTag
            f_eng2_emitSignalEvent(true, eng2EventTime, nz(tradeLongEntry, eng2EventLow), "CE Mitigated", color.new(bullColor, 0), false, 1.72)
        if eng2ShowShortTappedLabel
            eng2ShortTappedEventTag := currentShortSetupTag
            f_eng2_emitSignalEvent(true, eng2EventTime, nz(tradeShortEntry, eng2EventHigh), "Tapped", color.new(bearColor, 5), true, 1.50)
        if eng2ShowShortCeLabel
            eng2ShortMitigatedEventTag := currentShortSetupTag
            f_eng2_emitSignalEvent(true, eng2EventTime, nz(tradeShortEntry, eng2EventHigh), "CE Mitigated", color.new(bearColor, 0), true, 1.72)
        bool eng2SetupExtraLabelsAllowed = not eng2FullLabelBudgetTight
        bool eng2LongContReady = eng2SetupExtraLabelsAllowed and eng2LongSetupEventStateReady and not longExecutionTerminal and not na(tradeLongEntry) and longPoiEventReached
        bool eng2ShortContReady = eng2SetupExtraLabelsAllowed and eng2ShortSetupEventStateReady and not shortExecutionTerminal and not na(tradeShortEntry) and shortPoiEventReached
        if eng2LongContReady or eng2ShortContReady
            bool eng2BullInternalContinuationEvent = eng1_exe_bull_bos and not eng1_exe_bull_bos[1] or eng1_exe_bull_mss and not eng1_exe_bull_mss[1] or eng1_exe_bull_choch and not eng1_exe_bull_choch[1]
            bool eng2BearInternalContinuationEvent = eng1_exe_bear_bos and not eng1_exe_bear_bos[1] or eng1_exe_bear_mss and not eng1_exe_bear_mss[1] or eng1_exe_bear_choch and not eng1_exe_bear_choch[1]
            bool eng2BullSwingContinuationEvent = eng1_ctx_bull_breakout and not eng1_ctx_bull_breakout[1] or eng1_ctx_bull_choch and not eng1_ctx_bull_choch[1]
            bool eng2BearSwingContinuationEvent = eng1_ctx_bear_breakout and not eng1_ctx_bear_breakout[1] or eng1_ctx_bear_choch and not eng1_ctx_bear_choch[1]
            if eng2LongContReady and eng2BullInternalContinuationEvent
                f_eng2_emitSignalEvent(true, eng2EventTime, eng2EventLow, (eng1_exe_bull_mss or eng1_exe_bull_choch) ? "iMSS Cont" : "iBOS Cont", color.new(bullColor, 0), false, 1.94)
            if eng2ShortContReady and eng2BearInternalContinuationEvent
                f_eng2_emitSignalEvent(true, eng2EventTime, eng2EventHigh, (eng1_exe_bear_mss or eng1_exe_bear_choch) ? "iMSS Cont" : "iBOS Cont", color.new(bearColor, 0), true, 1.94)
            if eng2LongContReady and eng2BullSwingContinuationEvent
                f_eng2_emitSignalEvent(true, eng2EventTime, eng2EventLow, eng1_ctx_bull_choch ? "sMSS Cont" : "sBOS Cont", color.new(bullColor, 0), false, 2.18)
            if eng2ShortContReady and eng2BearSwingContinuationEvent
                f_eng2_emitSignalEvent(true, eng2EventTime, eng2EventHigh, eng1_ctx_bear_choch ? "sMSS Cont" : "sBOS Cont", color.new(bearColor, 0), true, 2.18)
        if showOb and eng2SetupExtraLabelsAllowed and (eng2LongSetupEventStateReady or eng2ShortSetupEventStateReady)
            int eng2BullBreakerLabelTime = nz(eng1_ctx_bull_ob_breaker_time, eng1_ctx_bull_ob_bar)
            int eng2BearBreakerLabelTime = nz(eng1_ctx_bear_ob_breaker_time, eng1_ctx_bear_ob_bar)
            int eng2BullBreakerPrevLabelTime = nz(eng1_ctx_bull_ob_breaker_time[1], eng1_ctx_bull_ob_bar[1])
            int eng2BearBreakerPrevLabelTime = nz(eng1_ctx_bear_ob_breaker_time[1], eng1_ctx_bear_ob_bar[1])
            bool eng2BullBreakerEvent = eng1_ctx_bull_ob_breaker and not na(eng2BullBreakerLabelTime) and eng2BullBreakerLabelTime != nz(eng2BullBreakerPrevLabelTime, -1)
            bool eng2BearBreakerEvent = eng1_ctx_bear_ob_breaker and not na(eng2BearBreakerLabelTime) and eng2BearBreakerLabelTime != nz(eng2BearBreakerPrevLabelTime, -1)
            bool eng2BullBreakerLabelEvent = eng2LongSetupEventStateReady and eng2BullBreakerEvent
            bool eng2BearBreakerLabelEvent = eng2ShortSetupEventStateReady and eng2BearBreakerEvent
            if eng2BullBreakerLabelEvent
                float eng2BullBreakerLevel = not na(eng1_ctx_bull_ob_top) and not na(eng1_ctx_bull_ob_bottom) ? f_zoneMid(eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom) : eng2EventLow
                f_eng2_emitSignalEvent(true, nz(eng2BullBreakerLabelTime, time), eng2BullBreakerLevel, "Bull Breaker", color.new(bullColor, 0), false, 2.42)
            if eng2BearBreakerLabelEvent
                float eng2BearBreakerLevel = not na(eng1_ctx_bear_ob_top) and not na(eng1_ctx_bear_ob_bottom) ? f_zoneMid(eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom) : eng2EventHigh
                f_eng2_emitSignalEvent(true, nz(eng2BearBreakerLabelTime, time), eng2BearBreakerLevel, "Bear Breaker", color.new(bearColor, 0), true, 2.42)

//------------------------------------------------------------------------------
// Session range visuals
//------------------------------------------------------------------------------
bool sessionVisualsEnabled = showSessionVisuals and draw_full and timeframe.isintraday

bool sessionArchiveNeedsClear = not sessionVisualsEnabled and (array.size(sessionRangeBoxes) > 0 or array.size(sessionRangeLabels) > 0 or array.size(sessionRangeHighLines) > 0 or array.size(sessionRangeLowLines) > 0 or array.size(sessionRangeNames) > 0 or not na(eng2SessionArchiveStyledCount))
if sessionArchiveNeedsClear
    f_trimSessionVisuals(0)
    eng2SessionArchiveStyledCount := na

bool sessionLaneNeedsSync = sessionVisualsEnabled or not na(activeAsiaSessionBox) or not na(activeAsiaSessionLabel) or not na(activeAsiaSessionHighLine) or not na(activeAsiaSessionLowLine) or not na(activeAsiaSessionStartBar) or not na(activeLondonSessionBox) or not na(activeLondonSessionLabel) or not na(activeLondonSessionHighLine) or not na(activeLondonSessionLowLine) or not na(activeLondonSessionStartBar) or not na(activeNewYorkSessionBox) or not na(activeNewYorkSessionLabel) or not na(activeNewYorkSessionHighLine) or not na(activeNewYorkSessionLowLine) or not na(activeNewYorkSessionStartBar)
if sessionLaneNeedsSync
    [activeAsiaSessionBoxTmp, activeAsiaSessionLabelTmp, activeAsiaSessionHighLineTmp, activeAsiaSessionLowLineTmp, activeAsiaSessionStartBarTmp] = f_eng2_syncSessionLane(sessionVisualsEnabled, inAsiaSession, newAsiaSession, asiaSessionEnded, activeAsiaSessionBox, activeAsiaSessionLabel, activeAsiaSessionHighLine, activeAsiaSessionLowLine, activeAsiaSessionStartBar, "Asia", asiaSessionHigh, asiaSessionLow)
    activeAsiaSessionBox := activeAsiaSessionBoxTmp
    activeAsiaSessionLabel := activeAsiaSessionLabelTmp
    activeAsiaSessionHighLine := activeAsiaSessionHighLineTmp
    activeAsiaSessionLowLine := activeAsiaSessionLowLineTmp
    activeAsiaSessionStartBar := activeAsiaSessionStartBarTmp

    [activeLondonSessionBoxTmp, activeLondonSessionLabelTmp, activeLondonSessionHighLineTmp, activeLondonSessionLowLineTmp, activeLondonSessionStartBarTmp] = f_eng2_syncSessionLane(sessionVisualsEnabled, inLondonSession, newLondonSession, londonSessionEnded, activeLondonSessionBox, activeLondonSessionLabel, activeLondonSessionHighLine, activeLondonSessionLowLine, activeLondonSessionStartBar, "London", londonSessionHigh, londonSessionLow)
    activeLondonSessionBox := activeLondonSessionBoxTmp
    activeLondonSessionLabel := activeLondonSessionLabelTmp
    activeLondonSessionHighLine := activeLondonSessionHighLineTmp
    activeLondonSessionLowLine := activeLondonSessionLowLineTmp
    activeLondonSessionStartBar := activeLondonSessionStartBarTmp

    [activeNewYorkSessionBoxTmp, activeNewYorkSessionLabelTmp, activeNewYorkSessionHighLineTmp, activeNewYorkSessionLowLineTmp, activeNewYorkSessionStartBarTmp] = f_eng2_syncSessionLane(sessionVisualsEnabled, inNewYorkSession, newNewYorkSession, newYorkSessionEnded, activeNewYorkSessionBox, activeNewYorkSessionLabel, activeNewYorkSessionHighLine, activeNewYorkSessionLowLine, activeNewYorkSessionStartBar, "New York", newYorkSessionHigh, newYorkSessionLow)
    activeNewYorkSessionBox := activeNewYorkSessionBoxTmp
    activeNewYorkSessionLabel := activeNewYorkSessionLabelTmp
    activeNewYorkSessionHighLine := activeNewYorkSessionHighLineTmp
    activeNewYorkSessionLowLine := activeNewYorkSessionLowLineTmp
    activeNewYorkSessionStartBar := activeNewYorkSessionStartBarTmp

int sessionArchiveCount = array.size(sessionRangeBoxes)
bool sessionArchiveChanged = sessionVisualsEnabled and (asiaSessionEnded or londonSessionEnded or newYorkSessionEnded)
bool sessionArchiveStyleRefresh = barstate.islast and sessionVisualsEnabled and sessionArchiveCount > 0 and (na(eng2SessionArchiveStyledCount) or eng2SessionArchiveStyledCount != sessionArchiveCount or sessionArchiveChanged)
if sessionArchiveStyleRefresh
    for i = 0 to sessionArchiveCount - 1
        sessionBox = array.get(sessionRangeBoxes, i)
        sessionLabel = i < array.size(sessionRangeLabels) ? array.get(sessionRangeLabels, i) : na
        sessionName = i < array.size(sessionRangeNames) ? array.get(sessionRangeNames, i) : "Session"
        sessionHighLine = i < array.size(sessionRangeHighLines) ? array.get(sessionRangeHighLines, i) : na
        sessionLowLine = i < array.size(sessionRangeLowLines) ? array.get(sessionRangeLowLines, i) : na
        color archivedFillColor = f_sessionFillColor(sessionName)
        color archivedBorderColor = f_sessionBorderColor(sessionName)
        color archivedTextColor = f_sessionTextColor(sessionName)
        color archivedHighLineColor = f_sessionLineColor(sessionName, true)
        color archivedLowLineColor = f_sessionLineColor(sessionName, false)
        if not na(sessionBox)
            box.set_bgcolor(sessionBox, archivedFillColor)
            box.set_border_color(sessionBox, archivedBorderColor)
            box.set_border_width(sessionBox, 1)
        if not na(sessionHighLine)
            line.set_color(sessionHighLine, archivedHighLineColor)
        if not na(sessionLowLine)
            line.set_color(sessionLowLine, archivedLowLineColor)
        if not na(sessionLabel)
            label.set_text(sessionLabel, sessionName)
            label.set_textcolor(sessionLabel, archivedTextColor)
            label.set_style(sessionLabel, label.style_label_center)
            label.set_color(sessionLabel, color.new(color.black, 86))
            label.set_size(sessionLabel, size.small)
    eng2SessionArchiveStyledCount := sessionArchiveCount

//------------------------------------------------------------------------------
// Narrative zones: supply/demand from the narrative HTF snapshot.
// Full mode only to avoid clutter on execution charts.
//------------------------------------------------------------------------------
// HTF S/D is narrative context, not setup-owned POI. Keep it alive in Full mode
// so the box continues to the active bar even when the current POI is retired.
bool eng2NarrativeZonesEnabled = eng1_exec_valid and draw_full and draw_show_htf and not compactMode
bool showEng2NarrBullSd = eng2NarrativeZonesEnabled and not na(eng1_narr_bull_sd_top) and not na(eng1_narr_bull_sd_bottom)
bool showEng2NarrBearSd = eng2NarrativeZonesEnabled and not na(eng1_narr_bear_sd_top) and not na(eng1_narr_bear_sd_bottom)
bool eng2NarrBullSdNeedsSync = showEng2NarrBullSd or not na(eng2NarrBullSdBox) or not na(eng2NarrBullSdLabel)
bool eng2NarrBearSdNeedsSync = showEng2NarrBearSd or not na(eng2NarrBearSdBox) or not na(eng2NarrBearSdLabel)
if eng2NarrBullSdNeedsSync
    [eng2NarrBullSdBoxTmp, eng2NarrBullSdLabelTmp] = f_eng2_syncHtfSdVisual(eng2NarrBullSdBox, eng2NarrBullSdLabel, showEng2NarrBullSd, eng1_narr_bull_sd_bar, eng1_narr_bull_sd_top, eng1_narr_bull_sd_bottom, compactMode ? "SD+" : "HTF SD+", color.new(bullColor, 78), color.new(bullColor, 98))
    eng2NarrBullSdBox := eng2NarrBullSdBoxTmp
    eng2NarrBullSdLabel := eng2NarrBullSdLabelTmp
if eng2NarrBearSdNeedsSync
    [eng2NarrBearSdBoxTmp, eng2NarrBearSdLabelTmp] = f_eng2_syncHtfSdVisual(eng2NarrBearSdBox, eng2NarrBearSdLabel, showEng2NarrBearSd, eng1_narr_bear_sd_bar, eng1_narr_bear_sd_top, eng1_narr_bear_sd_bottom, compactMode ? "SD-" : "HTF SD-", color.new(bearColor, 78), color.new(bearColor, 98))
    eng2NarrBearSdBox := eng2NarrBearSdBoxTmp
    eng2NarrBearSdLabel := eng2NarrBearSdLabelTmp

float bullStop = not na(tradeLongStop) ? tradeLongStop : not na(eng1_exe_liq_low) ? eng1_exe_liq_low - atr * stopAtrBuffer : na
float bearStop = not na(tradeShortStop) ? tradeShortStop : not na(eng1_exe_liq_high) ? eng1_exe_liq_high + atr * stopAtrBuffer : na

//------------------------------------------------------------------------------
// Zone visual policy
// Live OB/FVG zones are selected by Engine 3. Engine 2 only renders the selected
// active zone plus non-duplicated context/range levels allowed by draw_mode.
//------------------------------------------------------------------------------
// Liquidity labels are semantic: EQH/EQL are equal-high/low pools, BSL/SSL are
// execution swing pools, ERL marks dealing-range extremes, and PD/PW/PM levels
// mark previous period liquidity; internal engine aliases stay off the chart.
bool draw_eq_high_primary = f_preferredLevelMatch(eng1_exe_liq_high, preferredDirection == "Balanced", compactUseLong, activeLongTarget, activeShortTarget)
bool draw_eq_low_primary = f_preferredLevelMatch(eng1_exe_liq_low, preferredDirection == "Balanced", compactUseLong, activeLongTarget, activeShortTarget)
showEqHighVisual = showLiquidity and not compactMode and f_draw_level_visible(draw_mode, draw_eq_high_primary, true, preferredDirection)
showEqLowVisual = showLiquidity and not compactMode and f_draw_level_visible(draw_mode, draw_eq_low_primary, false, preferredDirection)
showRangeVisual = showLiquidity and displayInternalRange and f_contextVisualByMode(draw_mode)
showOteVisual = strictShowOte and (draw_full or draw_focused) and draw_mode != "Minimal"
showCalendarLiquidityVisual = calendarLiquidityRequestEnabled
showLongRiskVisual = showRisk and not compactMode and f_executionVisualByMode(draw_mode, longRiskVisible, preferredDirection, true, compactUseLong)
showShortRiskVisual = showRisk and not compactMode and f_executionVisualByMode(draw_mode, shortRiskVisible, preferredDirection, false, compactUseLong)

if not draw_full
    showEqHighVisual := f_uniqueLevelVisual(showEqHighVisual, eng1_exe_liq_high, false, na, false, na, false, na, false, na, false, na)
    showEqLowVisual := f_uniqueLevelVisual(showEqLowVisual, eng1_exe_liq_low, false, na, false, na, false, na, false, na, false, na)

//------------------------------------------------------------------------------
// Active Levels (single-instance lines)
// Keep these non-historical to avoid scattered segments when levels update.
//------------------------------------------------------------------------------
eqHighLevel = showEqHighVisual ? eng1_exe_liq_high : na
eqLowLevel = showEqLowVisual ? eng1_exe_liq_low : na
bool showDealingRangeVisual = showRangeVisual and not eng2DealBroken and not na(eng2DealHigh) and not na(eng2DealLow) and not na(eng2DealLeftBar) and eng2DealHigh > eng2DealLow
float dealingRangeHighLevel = showDealingRangeVisual ? eng2DealHigh : na
float dealingRangeLowLevel = showDealingRangeVisual ? eng2DealLow : na
float dealingRangeEqLevel = showDealingRangeVisual ? (eng2DealHigh + eng2DealLow) * 0.5 : na
float dealingRangeSize = showDealingRangeVisual ? eng2DealHigh - eng2DealLow : na
float dealingRangeQ25 = showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.25 : na
float dealingRangeQ75 = showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.75 : na
float dealingBuyOteTop = showDealingRangeVisual ? eng2DealHigh - dealingRangeSize * 0.618 : na
float dealingBuyOteBottom = showDealingRangeVisual ? eng2DealHigh - dealingRangeSize * 0.786 : na
float dealingSellOteTop = showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.786 : na
float dealingSellOteBottom = showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.618 : na
riskLongEntryLevel = showLongRiskVisual ? tradeLongEntry : na
riskShortEntryLevel = showShortRiskVisual ? tradeShortEntry : na
riskBullStopLevel = showLongRiskVisual ? bullStop : na
riskBearStopLevel = showShortRiskVisual ? bearStop : na
riskLongTargetLevel = showLongRiskVisual ? activeLongTarget : na
riskShortTargetLevel = showShortRiskVisual ? activeShortTarget : na
oteLongTopLevel = showOteVisual and showDealingRangeVisual ? dealingBuyOteTop : na
oteLongBottomLevel = showOteVisual and showDealingRangeVisual ? dealingBuyOteBottom : na
oteShortTopLevel = showOteVisual and showDealingRangeVisual ? dealingSellOteTop : na
oteShortBottomLevel = showOteVisual and showDealingRangeVisual ? dealingSellOteBottom : na
rightEdgeLabelTolerance = not na(atr) ? atr * 0.15 : syminfo.mintick * 10.0
pdhLevel = showCalendarLiquidityVisual ? prevDayHigh : na
pdlLevel = showCalendarLiquidityVisual ? prevDayLow : na
pwhLevel = showCalendarLiquidityVisual and not f_levelsClose(prevWeekHigh, pdhLevel, rightEdgeLabelTolerance) ? prevWeekHigh : na
pwlLevel = showCalendarLiquidityVisual and not f_levelsClose(prevWeekLow, pdlLevel, rightEdgeLabelTolerance) ? prevWeekLow : na
pmhLevel = showCalendarLiquidityVisual and not f_levelsClose(prevMonthHigh, pdhLevel, rightEdgeLabelTolerance) and not f_levelsClose(prevMonthHigh, pwhLevel, rightEdgeLabelTolerance) ? prevMonthHigh : na
pmlLevel = showCalendarLiquidityVisual and not f_levelsClose(prevMonthLow, pdlLevel, rightEdgeLabelTolerance) and not f_levelsClose(prevMonthLow, pwlLevel, rightEdgeLabelTolerance) ? prevMonthLow : na
showPdhVisual = not na(pdhLevel)
showPdlVisual = not na(pdlLevel)
showPwhVisual = not na(pwhLevel)
showPwlVisual = not na(pwlLevel)
showPmhVisual = not na(pmhLevel)
showPmlVisual = not na(pmlLevel)
bool eqHighOverlapsCalendar = showCalendarLiquidityVisual and (f_levelsClose(eqHighLevel, pdhLevel, rightEdgeLabelTolerance) or f_levelsClose(eqHighLevel, pwhLevel, rightEdgeLabelTolerance) or f_levelsClose(eqHighLevel, pmhLevel, rightEdgeLabelTolerance))
bool eqLowOverlapsCalendar = showCalendarLiquidityVisual and (f_levelsClose(eqLowLevel, pdlLevel, rightEdgeLabelTolerance) or f_levelsClose(eqLowLevel, pwlLevel, rightEdgeLabelTolerance) or f_levelsClose(eqLowLevel, pmlLevel, rightEdgeLabelTolerance))
showShortStopRightLabel = draw_show_right_labels and showShortRiskVisual and not na(riskBearStopLevel)
showLongStopRightLabel = draw_show_right_labels and showLongRiskVisual and not na(riskBullStopLevel)
showEqHighRightLabel = draw_show_right_labels and showEqHighVisual and not eqHighOverlapsCalendar and not f_levelsClose(eqHighLevel, riskBearStopLevel, rightEdgeLabelTolerance)
showEqLowRightLabel = draw_show_right_labels and showEqLowVisual and not eqLowOverlapsCalendar and not f_levelsClose(eqLowLevel, riskBullStopLevel, rightEdgeLabelTolerance)

if barstate.islast
    // Lines (single instance per level)
    bool showExecEqHighLine = showEqHighVisual and not showDealingRangeVisual and not eqHighOverlapsCalendar
    bool showExecEqLowLine = showEqLowVisual and not showDealingRangeVisual and not eqLowOverlapsCalendar
    bool eng2ThinLineNeedsSync = showExecEqHighLine or showExecEqLowLine or showPdhVisual or showPdlVisual or showPwhVisual or showPwlVisual or showPmhVisual or showPmlVisual or not na(eng2BslLine) or not na(eng2SslLine) or not na(eng2PdhLine) or not na(eng2PdlLine) or not na(eng2PwhLine) or not na(eng2PwlLine) or not na(eng2PmhLine) or not na(eng2PmlLine)
    if eng2ThinLineNeedsSync
        eng2BslLine := f_eng2_syncThinLevelLine(eng2BslLine, eqHighLevel, color.new(liqHighColor, 12), line.style_solid, showExecEqHighLine)
        eng2SslLine := f_eng2_syncThinLevelLine(eng2SslLine, eqLowLevel, color.new(liqLowColor, 12), line.style_solid, showExecEqLowLine)
        eng2PdhLine := f_eng2_syncThinLevelLine(eng2PdhLine, pdhLevel, color.new(liqHighColor, 28), line.style_dashed, showPdhVisual)
        eng2PdlLine := f_eng2_syncThinLevelLine(eng2PdlLine, pdlLevel, color.new(liqLowColor, 28), line.style_dashed, showPdlVisual)
        eng2PwhLine := f_eng2_syncThinLevelLine(eng2PwhLine, pwhLevel, color.new(color.fuchsia, 32), line.style_dashed, showPwhVisual)
        eng2PwlLine := f_eng2_syncThinLevelLine(eng2PwlLine, pwlLevel, color.new(color.fuchsia, 32), line.style_dashed, showPwlVisual)
        eng2PmhLine := f_eng2_syncThinLevelLine(eng2PmhLine, pmhLevel, color.new(color.silver, 38), line.style_dotted, showPmhVisual)
        eng2PmlLine := f_eng2_syncThinLevelLine(eng2PmlLine, pmlLevel, color.new(color.silver, 38), line.style_dotted, showPmlVisual)

    int dealingLeftBar = showDealingRangeVisual ? eng2DealLeftBar : na
    int dealingRightBar = bar_index
    bool eng2DealingRangeCoreHasHandles = not na(eng2RangeHighLine) or not na(eng2RangeLowLine) or not na(eng2RangeEqLine) or not na(eng2RangeQ25Line) or not na(eng2RangeQ75Line) or not na(eng2RangePremiumFill) or not na(eng2RangeDiscountFill)
    bool eng2DealingRangeCoreNeedsSync = showDealingRangeVisual or eng2DealingRangeCoreHasHandles
    if eng2DealingRangeCoreNeedsSync
        color rangeBoundaryColor = eng2DealBroken ? color.new(color.silver, 78) : color.new(color.silver, 35)
        color rangeEqColor = eng2DealBroken ? color.new(color.silver, 78) : decisionEqColor
        color rangeQuarterColor = color.new(color.silver, eng2DealBroken ? 86 : 78)
        string rangeBoundaryStyle = eng2DealBroken ? line.style_dotted : line.style_solid
        string rangeEqStyle = eng2DealBroken ? line.style_dotted : line.style_dashed
        color rangePremiumColor = eng2DealBroken ? color.new(color.silver, 94) : decisionPremiumFillColor
        color rangeDiscountColor = eng2DealBroken ? color.new(color.silver, 94) : decisionDiscountFillColor
        eng2RangeHighLine := f_eng2_syncSegmentHLine(eng2RangeHighLine, dealingLeftBar, dealingRightBar, dealingRangeHighLevel, rangeBoundaryColor, 1, rangeBoundaryStyle, showDealingRangeVisual)
        eng2RangeLowLine := f_eng2_syncSegmentHLine(eng2RangeLowLine, dealingLeftBar, dealingRightBar, dealingRangeLowLevel, rangeBoundaryColor, 1, rangeBoundaryStyle, showDealingRangeVisual)
        eng2RangeEqLine := f_eng2_syncSegmentHLine(eng2RangeEqLine, dealingLeftBar, dealingRightBar, dealingRangeEqLevel, rangeEqColor, 2, rangeEqStyle, showDealingRangeVisual)
        eng2RangeQ25Line := f_eng2_syncSegmentHLine(eng2RangeQ25Line, dealingLeftBar, dealingRightBar, dealingRangeQ25, rangeQuarterColor, 1, line.style_dotted, showDealingRangeVisual)
        eng2RangeQ75Line := f_eng2_syncSegmentHLine(eng2RangeQ75Line, dealingLeftBar, dealingRightBar, dealingRangeQ75, rangeQuarterColor, 1, line.style_dotted, showDealingRangeVisual)
        eng2RangePremiumFill := f_eng2_syncLineFill(eng2RangePremiumFill, eng2RangeHighLine, eng2RangeEqLine, rangePremiumColor, showDealingRangeVisual)
        eng2RangeDiscountFill := f_eng2_syncLineFill(eng2RangeDiscountFill, eng2RangeEqLine, eng2RangeLowLine, rangeDiscountColor, showDealingRangeVisual)

    bool showDealingOte = showOteVisual and showDealingRangeVisual
    bool eng2DealingOteCoreHasHandles = not na(eng2OteLongTopLine) or not na(eng2OteLongBottomLine) or not na(eng2OteLongFill) or not na(eng2OteShortTopLine) or not na(eng2OteShortBottomLine) or not na(eng2OteShortFill)
    bool eng2DealingOteCoreNeedsSync = showDealingOte or eng2DealingOteCoreHasHandles
    if eng2DealingOteCoreNeedsSync
        color oteBullLineColor = color.new(bullColor, eng2DealBroken ? 80 : 40)
        color oteBearLineColor = color.new(bearColor, eng2DealBroken ? 80 : 40)
        color oteBullFillColor = eng2DealBroken ? color.new(color.silver, 94) : color.new(bullColor, 92)
        color oteBearFillColor = eng2DealBroken ? color.new(color.silver, 94) : color.new(bearColor, 92)
        string oteBandStyle = eng2DealBroken ? line.style_dotted : line.style_solid
        eng2OteLongTopLine := f_eng2_syncSegmentHLine(eng2OteLongTopLine, dealingLeftBar, dealingRightBar, oteLongTopLevel, oteBullLineColor, 1, oteBandStyle, showDealingOte)
        eng2OteLongBottomLine := f_eng2_syncSegmentHLine(eng2OteLongBottomLine, dealingLeftBar, dealingRightBar, oteLongBottomLevel, oteBullLineColor, 1, oteBandStyle, showDealingOte)
        eng2OteLongFill := f_eng2_syncLineFill(eng2OteLongFill, eng2OteLongTopLine, eng2OteLongBottomLine, oteBullFillColor, showDealingOte)
        eng2OteShortTopLine := f_eng2_syncSegmentHLine(eng2OteShortTopLine, dealingLeftBar, dealingRightBar, oteShortTopLevel, oteBearLineColor, 1, oteBandStyle, showDealingOte)
        eng2OteShortBottomLine := f_eng2_syncSegmentHLine(eng2OteShortBottomLine, dealingLeftBar, dealingRightBar, oteShortBottomLevel, oteBearLineColor, 1, oteBandStyle, showDealingOte)
        eng2OteShortFill := f_eng2_syncLineFill(eng2OteShortFill, eng2OteShortTopLine, eng2OteShortBottomLine, oteBearFillColor, showDealingOte)

    bool eng2RiskNeedsSync = showLongRiskVisual or showShortRiskVisual or not na(eng2RiskLongEntryLine) or not na(eng2RiskShortEntryLine) or not na(eng2RiskLongStopLine) or not na(eng2RiskShortStopLine) or not na(eng2RiskLongTargetLine) or not na(eng2RiskShortTargetLine)
    if eng2RiskNeedsSync
        eng2RiskLongEntryLine := f_eng2_syncRiskLevelLine(eng2RiskLongEntryLine, riskLongEntryLevel, color.new(bullColor, 0), 2, showLongRiskVisual)
        eng2RiskShortEntryLine := f_eng2_syncRiskLevelLine(eng2RiskShortEntryLine, riskShortEntryLevel, color.new(bearColor, 0), 2, showShortRiskVisual)
        eng2RiskLongStopLine := f_eng2_syncRiskLevelLine(eng2RiskLongStopLine, riskBullStopLevel, color.new(bearColor, 0), 1, showLongRiskVisual)
        eng2RiskShortStopLine := f_eng2_syncRiskLevelLine(eng2RiskShortStopLine, riskBearStopLevel, color.new(bullColor, 0), 1, showShortRiskVisual)
        eng2RiskLongTargetLine := f_eng2_syncRiskLevelLine(eng2RiskLongTargetLine, riskLongTargetLevel, color.new(liqHighColor, 0), 1, showLongRiskVisual)
        eng2RiskShortTargetLine := f_eng2_syncRiskLevelLine(eng2RiskShortTargetLine, riskShortTargetLevel, color.new(liqLowColor, 0), 1, showShortRiskVisual)

    // Right-edge labels
    float bslLabelLevel = showDealingRangeVisual ? dealingRangeHighLevel : eqHighLevel
    float sslLabelLevel = showDealingRangeVisual ? dealingRangeLowLevel : eqLowLevel
    bool dealingBslOverlapsCalendar = draw_show_right_labels and showDealingRangeVisual and (f_levelsClose(bslLabelLevel, pdhLevel, rightEdgeLabelTolerance) or f_levelsClose(bslLabelLevel, pwhLevel, rightEdgeLabelTolerance) or f_levelsClose(bslLabelLevel, pmhLevel, rightEdgeLabelTolerance))
    bool dealingSslOverlapsCalendar = draw_show_right_labels and showDealingRangeVisual and (f_levelsClose(sslLabelLevel, pdlLevel, rightEdgeLabelTolerance) or f_levelsClose(sslLabelLevel, pwlLevel, rightEdgeLabelTolerance) or f_levelsClose(sslLabelLevel, pmlLevel, rightEdgeLabelTolerance))
    bool showDealingBslLabel = draw_show_right_labels and showDealingRangeVisual and not dealingBslOverlapsCalendar
    bool showDealingSslLabel = draw_show_right_labels and showDealingRangeVisual and not dealingSslOverlapsCalendar
    bool showExecBslLabel = showEqHighRightLabel and not showDealingRangeVisual
    bool showExecSslLabel = showEqLowRightLabel and not showDealingRangeVisual
    bool eng2RightLabelNeedsSync = showDealingBslLabel or showDealingSslLabel or showExecBslLabel or showExecSslLabel or (draw_show_right_labels and (showDealingRangeVisual or showPdhVisual or showPdlVisual or showPwhVisual or showPwlVisual or showPmhVisual or showPmlVisual)) or showLongStopRightLabel or showShortStopRightLabel or not na(eqHighLabel) or not na(eqLowLabel) or not na(eng2DealEqLabel) or not na(pdhLabel) or not na(pdlLabel) or not na(pwhLabel) or not na(pwlLabel) or not na(pmhLabel) or not na(pmlLabel) or not na(longStopLabel) or not na(shortStopLabel)
    if eng2RightLabelNeedsSync
        eqHighLabel := f_eng2_syncRightLevelLabel(eqHighLabel, bslLabelLevel, showDealingRangeVisual ? f_rangeLiquidityLabel(true) : eng1_exe_eqh_active ? "EQH" : "BSL", color.new(liqHighColor, 12), showDealingBslLabel or showExecBslLabel)
        eqLowLabel := f_eng2_syncRightLevelLabel(eqLowLabel, sslLabelLevel, showDealingRangeVisual ? f_rangeLiquidityLabel(false) : eng1_exe_eql_active ? "EQL" : "SSL", color.new(liqLowColor, 12), showDealingSslLabel or showExecSslLabel)
        eng2DealEqLabel := f_eng2_syncRightLevelLabel(eng2DealEqLabel, dealingRangeEqLevel, "EQ", color.new(decisionEqColor, 0), draw_show_right_labels and showDealingRangeVisual)
        pdhLabel := f_eng2_syncRightLevelLabel(pdhLabel, pdhLevel, "PDH", color.new(liqHighColor, 10), draw_show_right_labels and showPdhVisual)
        pdlLabel := f_eng2_syncRightLevelLabel(pdlLabel, pdlLevel, "PDL", color.new(liqLowColor, 10), draw_show_right_labels and showPdlVisual)
        pwhLabel := f_eng2_syncRightLevelLabel(pwhLabel, pwhLevel, "PWH", color.new(color.fuchsia, 15), draw_show_right_labels and showPwhVisual)
        pwlLabel := f_eng2_syncRightLevelLabel(pwlLabel, pwlLevel, "PWL", color.new(color.fuchsia, 15), draw_show_right_labels and showPwlVisual)
        pmhLabel := f_eng2_syncRightLevelLabel(pmhLabel, pmhLevel, "PMH", color.new(color.silver, 35), draw_show_right_labels and showPmhVisual)
        pmlLabel := f_eng2_syncRightLevelLabel(pmlLabel, pmlLevel, "PML", color.new(color.silver, 35), draw_show_right_labels and showPmlVisual)
        longStopLabel := f_eng2_syncRightLevelLabel(longStopLabel, riskBullStopLevel, "SL L", color.new(bearColor, 0), showLongStopRightLabel)
        shortStopLabel := f_eng2_syncRightLevelLabel(shortStopLabel, riskBearStopLevel, "SL S", color.new(bullColor, 0), showShortStopRightLabel)

// Bias tint should follow the MTF narrative chain: Narrative -> Context -> Execution.
int backdropBias = displayNarrBias != 0 ? displayNarrBias : (eng1CtxRangeReady and displayCtxBias != 0 ? displayCtxBias : displayExecBias)
color backdropColor = backdropBias == 1 ? bullColor : backdropBias == -1 ? bearColor : neutralColor
// Keep bias tint subtle so it doesn't overpower zones/candles.
int backdropAlpha = backdropBias == 0 ? 95 : 92
chartBackdrop = showTrendBackground and not compactMode ? color.new(backdropColor, backdropAlpha) : na
bgcolor(chartBackdrop)

f_eng4_render_dashboard() =>
    bool showFull = barstate.islast and showDashboard and not compactDashboardMode
    bool showCompact = barstate.islast and showDashboard and compactDashboardMode
    bool clearDash = barstate.islast and not showDashboard
    if showFull or showCompact
        bool compactBalanced = preferredDirection == "Balanced"
        bool compactWaiting = preferredDirection == "Wait"
        bool compactNeutral = compactBalanced or compactWaiting
        bool longRetired = longCompleted or longInvalidated or (not longAmbiguous and longLifecycleRetired)
        bool shortRetired = shortCompleted or shortInvalidated or (not shortAmbiguous and shortLifecycleRetired)
        bool waitBuySide = displayCtxBias == -1 or (displayCtxBias == 0 and displayNarrBias == -1)
        string waitName = waitBuySide ? (eng1_exe_eqh_active ? "EQH" : "BSL") : (eng1_exe_eql_active ? "EQL" : "SSL")
        float waitLevel = waitBuySide ? eng1_exe_liq_high : eng1_exe_liq_low
        bool poiUseLong = compactUseLong
        if compactWaiting
            if poi_long_contract_valid and not poi_short_contract_valid
                poiUseLong := true
            else if poi_short_contract_valid and not poi_long_contract_valid
                poiUseLong := false
            else
                poiUseLong := not waitBuySide
        bool dashboardUseLong = compactWaiting ? poiUseLong : compactUseLong
        string executionState = dashboardUseLong ? longExecutionState : shortExecutionState
        float entryLevel = dashboardUseLong ? tradeLongEntry : tradeShortEntry
        float stopLevel = dashboardUseLong ? tradeLongStop : tradeShortStop
        float targetLevel = dashboardUseLong ? activeLongTarget : activeShortTarget
        bool retiredState = dashboardUseLong ? longRetired : shortRetired
        color accentColor = compactNeutral ? color.new(neutralColor, 12) : dashboardUseLong ? color.new(bullColor, 12) : color.new(bearColor, 12)
        bool poiValid = poiUseLong ? poi_long_contract_valid : poi_short_contract_valid
        string poiType = poiUseLong ? poi_long_type : poi_short_type
        float poiEntry = poiUseLong ? poi_long_entry : poi_short_entry
        string poiLifecycle = poiUseLong ? longPoiLifecycle : shortPoiLifecycle
        bool poiContextAllowed = poiUseLong ? eng1BullContextAllowed : eng1BearContextAllowed
        bool poiHasZone = poiUseLong ? (hasBullOb or hasBullFvg) : (hasBearOb or hasBearFvg)
        bool poiCandidateValid = poiUseLong ? poi_long_candidate_valid : poi_short_candidate_valid
        bool poiIdentityReady = poiUseLong ? eng3LongActivePoiReady : eng3ShortActivePoiReady
        bool poiStrictOwned = poiUseLong ? strictLongPdArrayOwned : strictShortPdArrayOwned
        bool poiConsumed = poiUseLong ? eng3LongActivePoiIdentity == eng3LongConsumedPoiIdentity : eng3ShortActivePoiIdentity == eng3ShortConsumedPoiIdentity
        string poiSideText = poiUseLong ? "L " : "S "
        string poiWaitReason = not poiContextAllowed ? "No POI: Gate" : not poiHasZone ? "No POI: Zone" : not poiCandidateValid ? "No POI: Select" : not poiIdentityReady ? "No POI: Map" : not poiStrictOwned ? "No POI: Own" : poiConsumed ? "No POI: Used" : "No POI"
        string poiRetireReason = poiUseLong ? longPoiRetireReason : shortPoiRetireReason
        bool poiRetired = poiUseLong ? longRetired : shortRetired
        bool poiActive = poiValid and not poiRetired
        bool sweepOk = poiUseLong ? dashLongTriggerSweepOk : dashShortTriggerSweepOk
        bool mssOk = poiUseLong ? dashLongTriggerMssOk : dashShortTriggerMssOk
        bool dispOk = poiUseLong ? dashLongTriggerDisplacementOk : dashShortTriggerDisplacementOk
        bool dashboardBiasAligned = displayExecBias != 0 and displayCtxBias != 0 and displayExecBias == displayCtxBias
        bool dashboardBiasMixed = displayExecBias != 0 and displayCtxBias != 0 and displayExecBias != displayCtxBias
        string biasText = (dashboardBiasAligned ? "Aligned " + (displayExecBias == 1 ? "Bullish" : "Bearish") : dashboardBiasMixed ? "Mixed" : "Building") + " | MTF " + f_biasShort(displayNarrBias) + "/" + f_biasShort(displayCtxBias) + "/" + f_biasShort(displayExecBias)
        string compactBiasText = (dashboardBiasAligned ? "Al " + f_eng4_compact_bias_token(displayExecBias) : dashboardBiasMixed ? "Mix" : "Bld") + " | " + f_eng4_compact_bias_token(displayNarrBias) + "/" + f_eng4_compact_bias_token(displayCtxBias) + "/" + f_eng4_compact_bias_token(displayExecBias)
        string sessionText = liquiditySessionSummary + " | " + timezoneSummary + " | " + (strictModeEnabled ? (ipdaWindowSummary == "Off" ? "Strict KZ Off" : "Strict " + ipdaWindowSummary) : "Normal")
        string nextText = compactWaiting ? "Wait " + waitName + " " + f_formatLevel(waitLevel) : executionState == "Active" ? "Entry active" : executionState == "Armed" ? "Monitor retest" : executionState == "Confirming" ? "Wait confirm" : executionState == "Managed" ? "Manage" : executionState == "Ambiguous" ? "Review" : executionState == "Completed" ? "Next setup" : executionState == "Expired" or executionState == "Invalidated" ? "Stand down" : "Wait trigger"
        string pxText = syminfo.ticker + " " + timeframe.period + " | Px " + f_formatLevel(not na(eng3SignalClose) ? eng3SignalClose : close)
        string setupText = compactWaiting ? "Wait " + waitName + " " + f_formatLevel(waitLevel) : compactBalanced ? "Both POI L " + f_formatLevel(tradeLongEntry) + " / S " + f_formatLevel(tradeShortEntry) : (dashboardUseLong ? "Long " : "Short ") + executionState + " " + f_formatLevel(entryLevel)
        string compactSetupText = compactWaiting ? waitName + " " + f_formatLevel(waitLevel) : compactBalanced ? "Both L " + f_formatLevel(tradeLongEntry) + " / S " + f_formatLevel(tradeShortEntry) : (dashboardUseLong ? "L " : "S ") + executionState + " " + f_formatLevel(entryLevel)
        bool orderPlanAvailable = not retiredState and not na(entryLevel)
        bool orderRiskReady = orderPlanAvailable and f_executionRiskVisible(executionState)
        string orderPrefix = orderRiskReady ? "E " : "Plan E "
        string compactOrderPrefix = orderRiskReady ? "E " : "Plan E "
        string orderText = not orderPlanAvailable ? "No pending order" : orderPrefix + f_formatLevel(entryLevel) + " | SL " + f_formatLevel(stopLevel) + " | TP " + f_formatLevel(targetLevel)
        orderText := compactBalanced ? "Focus " + (dashboardUseLong ? "Long" : "Short") + " | " + orderText : orderText
        string compactOrderText = not orderPlanAvailable ? "No order" : (compactBalanced ? (dashboardUseLong ? "Foc L " : "Foc S ") : "") + compactOrderPrefix + f_formatLevel(entryLevel) + " SL " + f_formatLevel(stopLevel) + " TP " + f_formatLevel(targetLevel)
        string triggerProgressText = poiSideText + (not sweepOk ? "Need Sweep" : not mssOk ? "Need MSS" : not dispOk ? "Need Disp" : "Trigger OK")
        string triggerText = not poiValid ? poiSideText + poiWaitReason : poiRetired ? poiSideText + (poiRetireReason == "" ? "POI Retired" : "POI " + poiRetireReason) : triggerProgressText
        string poiText = not poiValid ? poiSideText + poiWaitReason : poiRetired ? poiSideText + (poiRetireReason == "" ? "Retired" : "Retired: " + poiRetireReason) : poiSideText + (poiType == "Breaker" ? "BRK" : poiType) + " " + f_formatLevel(poiEntry) + " | " + f_poiLifecycleDisplayText(poiLifecycle, poiType)
        bool triggerReady = poiActive and sweepOk and mssOk and dispOk
        color dashboardNeutralBg = color.new(neutralColor, 18)
        color dashboardSetupBg = compactWaiting ? dashboardNeutralBg : accentColor
        color dashboardBiasBg = dashboardBiasAligned ? accentColor : dashboardNeutralBg
        color dashboardPoiBg = poiActive ? accentColor : panelCellBg
        color dashboardOrderBg = orderRiskReady ? accentColor : panelCellBg
        color dashboardTriggerBg = triggerReady ? accentColor : panelCellBg
        color dashboardTimingBg = color.new(strictModeEnabled ? color.teal : neutralColor, 15)
        color dashboardNextBg = compactWaiting ? dashboardNeutralBg : accentColor
        if showCompact
            f_prepareDashboardTable(dashboardCompact, 6, dashboard, 10)
            f_setCell(dashboardCompact, 0, 1, "TRADE", color.white, panelHeaderBg)
            f_setCell(dashboardCompact, 1, 1, pxText, color.white, accentColor)
            f_setCell(dashboardCompact, 0, 2, "Setup", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 2, compactSetupText, color.white, dashboardSetupBg)
            f_setCell(dashboardCompact, 0, 3, "Bias", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 3, compactBiasText, color.white, panelCellBg)
            f_setCell(dashboardCompact, 0, 4, "POI", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 4, poiText, color.white, dashboardPoiBg)
            f_setCell(dashboardCompact, 0, 5, "Order", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 5, compactOrderText, color.white, dashboardOrderBg)
            f_setCell(dashboardCompact, 0, 6, "Next", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 6, nextText, color.white, dashboardNextBg)
        else
            f_prepareDashboardTable(dashboard, 10, dashboardCompact, 6)
            f_setCell(dashboard, 0, 1, "TRADE MAP", color.white, panelHeaderBg)
            f_setCell(dashboard, 1, 1, pxText, color.white, accentColor)
            f_setCell(dashboard, 0, 2, "Setup", color.white, panelCellBg)
            f_setCell(dashboard, 1, 2, setupText, color.white, dashboardSetupBg)
            f_setCell(dashboard, 0, 3, "Bias", color.white, panelCellBg)
            f_setCell(dashboard, 1, 3, biasText, color.white, dashboardBiasBg)
            f_setCell(dashboard, 0, 4, "Liquidity", color.white, panelCellBg)
            f_setCell(dashboard, 1, 4, (eng1_exe_eqh_active ? "EQH " : "BSL ") + f_formatLevel(eng1_exe_liq_high) + " | " + (eng1_exe_eql_active ? "EQL " : "SSL ") + f_formatLevel(eng1_exe_liq_low), color.white, panelCellBg)
            f_setCell(dashboard, 0, 5, "POI", color.white, panelCellBg)
            f_setCell(dashboard, 1, 5, poiText, color.white, dashboardPoiBg)
            f_setCell(dashboard, 0, 6, "Order", color.white, panelCellBg)
            f_setCell(dashboard, 1, 6, orderText, color.white, dashboardOrderBg)
            f_setCell(dashboard, 0, 7, "Trigger", color.white, panelCellBg)
            f_setCell(dashboard, 1, 7, triggerText, color.white, dashboardTriggerBg)
            f_setCell(dashboard, 0, 8, "Timing", color.white, panelCellBg)
            f_setCell(dashboard, 1, 8, sessionText, color.white, dashboardTimingBg)
            f_setCell(dashboard, 0, 9, "Next", color.white, panelCellBg)
            f_setCell(dashboard, 1, 9, nextText, color.white, dashboardNextBg)
    else if clearDash
        f_clearDashboardTable(dashboardCompact, 6)
        f_clearDashboardTable(dashboard, 10)
    true

//------------------------------------------------------------------------------
// ENGINE 4 (DASHBOARD SNAPSHOT)
// MAIN_CONTRACT order 9: render dashboard from snapshots only.
// Keep table rendering dumb: rows read these snapshots instead of rebuilding
// engine logic inline. This follows MAIN_CONTRACT and makes future pruning safer.
//------------------------------------------------------------------------------
f_eng4_render_dashboard()
