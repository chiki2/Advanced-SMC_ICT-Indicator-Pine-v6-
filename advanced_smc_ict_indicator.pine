f_eng1_regime_strength_from_buffer(int bias, array<float> arrC, array<float> arrH, array<float> arrL) =>
    string strength = "Flat"
    int closeSize = array.size(arrC)
    if closeSize > 0
        float currentClose = array.get(arrC, 0)
        int refIdx = math.min(closeSize - 1, regimeMomentumLookbackBars)
        float refClose = array.get(arrC, refIdx)
        float atrApprox = f_eng1_avg_range(arrH, arrL, 14)
        strength := bias == 0 or na(currentClose) or na(refClose) or na(atrApprox) or atrApprox <= 0 ? "Flat" : math.abs(currentClose - refClose) >= atrApprox * regimeStrongAtrThreshold ? "Strong" : "Normal"
    strength

f_eng1_select_execution_trend_bias(string tf) =>
    int exeTrendBias = 0
    if tf == ENG1_TF_M1
        exeTrendBias := eng1_m1_trend_bias
    else if tf == ENG1_TF_M5
        exeTrendBias := eng1_m5_trend_bias
    else if tf == ENG1_TF_M15
        exeTrendBias := eng1_m15_trend_bias
    else if tf == ENG1_TF_M30
        exeTrendBias := eng1_m30_trend_bias
    exeTrendBias

f_eng1_select_execution_structure_points(string tf) =>
    float exeHigh = na
    int exeHighBar = na
    float exeLow = na
    int exeLowBar = na
    if tf == ENG1_TF_M1
        exeHigh := eng1_m1_last_swing_high
        exeHighBar := eng1_m1_last_swing_high_bar
        exeLow := eng1_m1_last_swing_low
        exeLowBar := eng1_m1_last_swing_low_bar
    else if tf == ENG1_TF_M5
        exeHigh := eng1_m5_last_swing_high
        exeHighBar := eng1_m5_last_swing_high_bar
        exeLow := eng1_m5_last_swing_low
        exeLowBar := eng1_m5_last_swing_low_bar
    else if tf == ENG1_TF_M15
        exeHigh := eng1_m15_last_swing_high
        exeHighBar := eng1_m15_last_swing_high_bar
        exeLow := eng1_m15_last_swing_low
        exeLowBar := eng1_m15_last_swing_low_bar
    else if tf == ENG1_TF_M30
        exeHigh := eng1_m30_last_swing_high
        exeHighBar := eng1_m30_last_swing_high_bar
        exeLow := eng1_m30_last_swing_low
        exeLowBar := eng1_m30_last_swing_low_bar
    [exeHigh, exeHighBar, exeLow, exeLowBar]

f_eng1_select_execution_time(string tf) =>
    int exeTime = na
    if tf == ENG1_TF_M1
        exeTime := f_eng1_buf_int_at(eng1_buf_m1_time, 0)
    else if tf == ENG1_TF_M5
        exeTime := f_eng1_buf_int_at(eng1_buf_m5_time, 0)
    else if tf == ENG1_TF_M15
        exeTime := f_eng1_buf_int_at(eng1_buf_m15_time, 0)
    else if tf == ENG1_TF_M30
        exeTime := f_eng1_buf_int_at(eng1_buf_m30_time, 0)
    exeTime

f_eng1_select_execution_snapshot(string tf) =>
    bool exeBullSweep = false
    bool exeBearSweep = false
    bool exeBullMss = false
    bool exeBearMss = false
    bool exeBullDisplacement = false
    bool exeBearDisplacement = false
    float exeProtectedHigh = na
    float exeProtectedLow = na
    if tf == ENG1_TF_M1
        exeBullSweep := eng1_m1_bull_sweep
        exeBearSweep := eng1_m1_bear_sweep
        exeBullMss := eng1_m1_bull_mss
        exeBearMss := eng1_m1_bear_mss
        exeBullDisplacement := eng1_m1_bull_displacement
        exeBearDisplacement := eng1_m1_bear_displacement
        exeProtectedHigh := eng1_m1_protected_high
        exeProtectedLow := eng1_m1_protected_low
    else if tf == ENG1_TF_M5
        exeBullSweep := eng1_m5_bull_sweep
        exeBearSweep := eng1_m5_bear_sweep
        exeBullMss := eng1_m5_bull_mss
        exeBearMss := eng1_m5_bear_mss
        exeBullDisplacement := eng1_m5_bull_displacement
        exeBearDisplacement := eng1_m5_bear_displacement
        exeProtectedHigh := eng1_m5_protected_high
        exeProtectedLow := eng1_m5_protected_low
    else if tf == ENG1_TF_M15
        exeBullSweep := eng1_m15_bull_sweep
        exeBearSweep := eng1_m15_bear_sweep
        exeBullMss := eng1_m15_bull_mss
        exeBearMss := eng1_m15_bear_mss
        exeBullDisplacement := eng1_m15_bull_displacement
        exeBearDisplacement := eng1_m15_bear_displacement
        exeProtectedHigh := eng1_m15_protected_high
        exeProtectedLow := eng1_m15_protected_low
    else if tf == ENG1_TF_M30
        exeBullSweep := eng1_m30_bull_sweep
        exeBearSweep := eng1_m30_bear_sweep
        exeBullMss := eng1_m30_bull_mss
        exeBearMss := eng1_m30_bear_mss
        exeBullDisplacement := eng1_m30_bull_displacement
        exeBearDisplacement := eng1_m30_bear_displacement
