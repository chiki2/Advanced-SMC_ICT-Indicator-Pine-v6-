        exeProtectedLow := eng1_m30_protected_low
    [exeBullSweep, exeBearSweep, exeBullMss, exeBearMss, exeBullDisplacement, exeBearDisplacement, exeProtectedHigh, exeProtectedLow]

f_eng1_select_execution_snapshot_levels(string tf) =>
    float exeEqh = na
    float exeEql = na
    bool exeEqhActive = false
    bool exeEqlActive = false
    float exeSwingHigh = na
    float exeSwingLow = na
    if tf == ENG1_TF_M1
        exeEqh := eng1_m1_eqh
        exeEql := eng1_m1_eql
        exeEqhActive := eng1_m1_eqh_active
        exeEqlActive := eng1_m1_eql_active
        exeSwingHigh := eng1_m1_last_swing_high
        exeSwingLow := eng1_m1_last_swing_low
    else if tf == ENG1_TF_M5
        exeEqh := eng1_m5_eqh
        exeEql := eng1_m5_eql
        exeEqhActive := eng1_m5_eqh_active
        exeEqlActive := eng1_m5_eql_active
        exeSwingHigh := eng1_m5_last_swing_high
        exeSwingLow := eng1_m5_last_swing_low
    else if tf == ENG1_TF_M15
        exeEqh := eng1_m15_eqh
        exeEql := eng1_m15_eql
        exeEqhActive := eng1_m15_eqh_active
        exeEqlActive := eng1_m15_eql_active
        exeSwingHigh := eng1_m15_last_swing_high
        exeSwingLow := eng1_m15_last_swing_low
    else if tf == ENG1_TF_M30
        exeEqh := eng1_m30_eqh
        exeEql := eng1_m30_eql
        exeEqhActive := eng1_m30_eqh_active
        exeEqlActive := eng1_m30_eql_active
        exeSwingHigh := eng1_m30_last_swing_high
        exeSwingLow := eng1_m30_last_swing_low
    [exeEqh, exeEql, exeEqhActive, exeEqlActive, exeSwingHigh, exeSwingLow]

// MAIN_CONTRACT order 2: update raw closed-candle buffers for all fixed TFs.
[eng1_m1_new_closed_bar_tmp, eng1_m1_last_closed_time_tmp] = f_eng1_update_ohlc_buffer(ENG1_TF_M1, eng1_m1_last_closed_time, eng1_buf_m1_time, eng1_buf_m1_open, eng1_buf_m1_high, eng1_buf_m1_low, eng1_buf_m1_close, ENG1_BUF_CAP)
