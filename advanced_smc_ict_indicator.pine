f_eng1_regime_strength_from_buffer(int bias, array<float> arrC, array<float> arrH, array<float> arrL) =>
    string strength = "Flat"
    int closeSize = array.size(arrC)
    if closeSize > 0
        float currentClose = array.get(arrC, 0)
        int refIdx = math.min(closeSize - 1, regimeMomentumLookbackBars)
        float refClose = array.get(arrC, refIdx)
        float atrApprox = f_eng1_avg_range(arrH, arrL, 14)
        strength := bias == 0 or na(currentClose) or na(refClose) or na(atrApprox) or atrApprox <= 0 ? "Flat" : math.abs(currentClose - refClose) >= atrApprox * regimeStrongAtrThreshold ? "Strong" : "Normal"
    strength

f_eng1_select_execution_structure_points(string tf) =>
    float exeHigh = na
    int exeHighBar = na
    float exeLow = na
    int exeLowBar = na
    if tf == ENG1_TF_M1
        exeHigh := eng1_m1_last_swing_high
        exeHighBar := eng1_m1_last_swing_high_bar
        exeLow := eng1_m1_last_swing_low
        exeLowBar := eng1_m1_last_swing_low_bar
    else if tf == ENG1_TF_M5
        exeHigh := eng1_m5_last_swing_high
        exeHighBar := eng1_m5_last_swing_high_bar
        exeLow := eng1_m5_last_swing_low
        exeLowBar := eng1_m5_last_swing_low_bar
    else if tf == ENG1_TF_M15
        exeHigh := eng1_m15_last_swing_high
        exeHighBar := eng1_m15_last_swing_high_bar
        exeLow := eng1_m15_last_swing_low
        exeLowBar := eng1_m15_last_swing_low_bar
    else if tf == ENG1_TF_M30
        exeHigh := eng1_m30_last_swing_high
        exeHighBar := eng1_m30_last_swing_high_bar
        exeLow := eng1_m30_last_swing_low
        exeLowBar := eng1_m30_last_swing_low_bar
    else if tf == ENG1_TF_H1
        exeHigh := eng1_h1_last_swing_high
        exeHighBar := eng1_h1_last_swing_high_bar
        exeLow := eng1_h1_last_swing_low
        exeLowBar := eng1_h1_last_swing_low_bar
    [exeHigh, exeHighBar, exeLow, exeLowBar]

f_eng1_select_execution_time(string tf) =>
    int exeTime = na
    if tf == ENG1_TF_M1
        exeTime := f_eng1_buf_int_at(eng1_buf_m1_time, 0)
    else if tf == ENG1_TF_M5
        exeTime := f_eng1_buf_int_at(eng1_buf_m5_time, 0)
    else if tf == ENG1_TF_M15
        exeTime := f_eng1_buf_int_at(eng1_buf_m15_time, 0)
    else if tf == ENG1_TF_M30
        exeTime := f_eng1_buf_int_at(eng1_buf_m30_time, 0)
    else if tf == ENG1_TF_H1
        exeTime := f_eng1_buf_int_at(eng1_buf_h1_time, 0)
    else if tf == ENG1_TF_H4
        exeTime := f_eng1_buf_int_at(eng1_buf_h4_time, 0)
    else if tf == ENG1_TF_D1
        exeTime := f_eng1_buf_int_at(eng1_buf_d1_time, 0)
    exeTime

f_eng1_select_execution_snapshot(string tf) =>
    bool exeBullSweep = false
    bool exeBearSweep = false
    bool exeBullMss = false
    bool exeBearMss = false
    bool exeBullDisplacement = false
    bool exeBearDisplacement = false
    if tf == ENG1_TF_M1
        exeBullSweep := eng1_m1_bull_sweep
        exeBearSweep := eng1_m1_bear_sweep
        exeBullMss := eng1_m1_bull_mss
        exeBearMss := eng1_m1_bear_mss
        exeBullDisplacement := eng1_m1_bull_displacement
        exeBearDisplacement := eng1_m1_bear_displacement
    else if tf == ENG1_TF_M5
        exeBullSweep := eng1_m5_bull_sweep
        exeBearSweep := eng1_m5_bear_sweep
        exeBullMss := eng1_m5_bull_mss
        exeBearMss := eng1_m5_bear_mss
        exeBullDisplacement := eng1_m5_bull_displacement
        exeBearDisplacement := eng1_m5_bear_displacement
    else if tf == ENG1_TF_M15
        exeBullSweep := eng1_m15_bull_sweep
        exeBearSweep := eng1_m15_bear_sweep
        exeBullMss := eng1_m15_bull_mss
        exeBearMss := eng1_m15_bear_mss
        exeBullDisplacement := eng1_m15_bull_displacement
        exeBearDisplacement := eng1_m15_bear_displacement
    else if tf == ENG1_TF_M30
        exeBullSweep := eng1_m30_bull_sweep
        exeBearSweep := eng1_m30_bear_sweep
        exeBullMss := eng1_m30_bull_mss
        exeBearMss := eng1_m30_bear_mss
        exeBullDisplacement := eng1_m30_bull_displacement
        exeBearDisplacement := eng1_m30_bear_displacement
    else if tf == ENG1_TF_H1
        exeBullSweep := eng1_h1_bull_sweep
        exeBearSweep := eng1_h1_bear_sweep
        exeBullMss := eng1_h1_bull_mss
        exeBearMss := eng1_h1_bear_mss
        exeBullDisplacement := eng1_h1_bull_displacement
        exeBearDisplacement := eng1_h1_bear_displacement
    [exeBullSweep, exeBearSweep, exeBullMss, exeBearMss, exeBullDisplacement, exeBearDisplacement]

f_eng1_select_execution_snapshot_levels(string tf) =>
    float exeEqh = na
    float exeEql = na
    float exeSwingHigh = na
    float exeSwingLow = na
    if tf == ENG1_TF_M1
        exeEqh := eng1_m1_eqh
        exeEql := eng1_m1_eql
        exeSwingHigh := eng1_m1_last_swing_high
        exeSwingLow := eng1_m1_last_swing_low
    else if tf == ENG1_TF_M5
        exeEqh := eng1_m5_eqh
        exeEql := eng1_m5_eql
        exeSwingHigh := eng1_m5_last_swing_high
        exeSwingLow := eng1_m5_last_swing_low
    else if tf == ENG1_TF_M15
        exeEqh := eng1_m15_eqh
        exeEql := eng1_m15_eql
        exeSwingHigh := eng1_m15_last_swing_high
        exeSwingLow := eng1_m15_last_swing_low
    else if tf == ENG1_TF_M30
        exeEqh := eng1_m30_eqh
        exeEql := eng1_m30_eql
        exeSwingHigh := eng1_m30_last_swing_high
        exeSwingLow := eng1_m30_last_swing_low
    else if tf == ENG1_TF_H1
        exeEqh := eng1_h1_eqh
        exeEql := eng1_h1_eql
        exeSwingHigh := eng1_h1_last_swing_high
        exeSwingLow := eng1_h1_last_swing_low
    [exeEqh, exeEql, exeSwingHigh, exeSwingLow]

// MAIN_CONTRACT order 2: update raw closed-candle buffers only for active TFs.
[eng1_m1_new_closed_bar_tmp, eng1_m1_last_closed_time_tmp] = f_eng1_update_ohlc_buffer(eng1_m1_active_tf, ENG1_TF_M1, eng1_m1_last_closed_time, eng1_buf_m1_time, eng1_buf_m1_open, eng1_buf_m1_high, eng1_buf_m1_low, eng1_buf_m1_close, ENG1_BUF_CAP)
[eng1_m5_new_closed_bar_tmp, eng1_m5_last_closed_time_tmp] = f_eng1_update_ohlc_buffer(eng1_m5_active_tf, ENG1_TF_M5, eng1_m5_last_closed_time, eng1_buf_m5_time, eng1_buf_m5_open, eng1_buf_m5_high, eng1_buf_m5_low, eng1_buf_m5_close, ENG1_BUF_CAP)
[eng1_m15_new_closed_bar_tmp, eng1_m15_last_closed_time_tmp] = f_eng1_update_ohlc_buffer(eng1_m15_active_tf, ENG1_TF_M15, eng1_m15_last_closed_time, eng1_buf_m15_time, eng1_buf_m15_open, eng1_buf_m15_high, eng1_buf_m15_low, eng1_buf_m15_close, ENG1_BUF_CAP)
[eng1_m30_new_closed_bar_tmp, eng1_m30_last_closed_time_tmp] = f_eng1_update_ohlc_buffer(eng1_m30_active_tf, ENG1_TF_M30, eng1_m30_last_closed_time, eng1_buf_m30_time, eng1_buf_m30_open, eng1_buf_m30_high, eng1_buf_m30_low, eng1_buf_m30_close, ENG1_BUF_CAP)
[eng1_h1_new_closed_bar_tmp, eng1_h1_last_closed_time_tmp] = f_eng1_update_ohlc_buffer(eng1_h1_active_tf, ENG1_TF_H1, eng1_h1_last_closed_time, eng1_buf_h1_time, eng1_buf_h1_open, eng1_buf_h1_high, eng1_buf_h1_low, eng1_buf_h1_close, ENG1_BUF_CAP)
[eng1_h4_new_closed_bar_tmp, eng1_h4_last_closed_time_tmp] = f_eng1_update_ohlc_buffer(eng1_h4_active_tf, ENG1_TF_H4, eng1_h4_last_closed_time, eng1_buf_h4_time, eng1_buf_h4_open, eng1_buf_h4_high, eng1_buf_h4_low, eng1_buf_h4_close, ENG1_BUF_CAP)
[eng1_d1_new_closed_bar_tmp, eng1_d1_last_closed_time_tmp] = f_eng1_update_ohlc_buffer(eng1_d1_active_tf, ENG1_TF_D1, eng1_d1_last_closed_time, eng1_buf_d1_time, eng1_buf_d1_open, eng1_buf_d1_high, eng1_buf_d1_low, eng1_buf_d1_close, ENG1_BUF_CAP)
eng1_m1_last_closed_time := eng1_m1_last_closed_time_tmp
eng1_m5_last_closed_time := eng1_m5_last_closed_time_tmp
eng1_m15_last_closed_time := eng1_m15_last_closed_time_tmp
eng1_m30_last_closed_time := eng1_m30_last_closed_time_tmp
eng1_h1_last_closed_time := eng1_h1_last_closed_time_tmp
eng1_h4_last_closed_time := eng1_h4_last_closed_time_tmp
eng1_d1_last_closed_time := eng1_d1_last_closed_time_tmp
eng1_m1_new_closed_bar := eng1_m1_new_closed_bar_tmp
eng1_m5_new_closed_bar := eng1_m5_new_closed_bar_tmp
eng1_m15_new_closed_bar := eng1_m15_new_closed_bar_tmp
eng1_m30_new_closed_bar := eng1_m30_new_closed_bar_tmp
eng1_h1_new_closed_bar := eng1_h1_new_closed_bar_tmp
eng1_h4_new_closed_bar := eng1_h4_new_closed_bar_tmp
eng1_d1_new_closed_bar := eng1_d1_new_closed_bar_tmp
bool eng1_any_new_closed_bar = (eng1_m1_active_tf and eng1_m1_new_closed_bar) or (eng1_m5_active_tf and eng1_m5_new_closed_bar) or (eng1_m15_active_tf and eng1_m15_new_closed_bar) or (eng1_m30_active_tf and eng1_m30_new_closed_bar) or (eng1_h1_active_tf and eng1_h1_new_closed_bar) or (eng1_h4_active_tf and eng1_h4_new_closed_bar) or (eng1_d1_active_tf and eng1_d1_new_closed_bar)
// Rebuild only the active execution/context/narrative TFs for the current chart.
// This keeps startup cost lower on Basic/Free while preserving selected signals.
bool recalc_m1 = eng1_m1_active_tf and (eng1_m1_new_closed_bar or barstate.isfirst)
bool recalc_m5 = eng1_m5_active_tf and (eng1_m5_new_closed_bar or barstate.isfirst)
bool recalc_m15 = eng1_m15_active_tf and (eng1_m15_new_closed_bar or barstate.isfirst)
bool recalc_m30 = eng1_m30_active_tf and (eng1_m30_new_closed_bar or barstate.isfirst)
bool recalc_h1 = eng1_h1_active_tf and (eng1_h1_new_closed_bar or barstate.isfirst)
bool recalc_h4 = eng1_h4_active_tf and (eng1_h4_new_closed_bar or barstate.isfirst)
bool recalc_d1 = eng1_d1_active_tf and (eng1_d1_new_closed_bar or barstate.isfirst)

// MAIN_CONTRACT order 3: build per-TF structure/liquidity/PD/zone snapshots.
if eng1_any_new_closed_bar or barstate.isfirst
    int eng1_m1_prior_trend_bias = eng1_m1_trend_bias
    int eng1_m5_prior_trend_bias = eng1_m5_trend_bias
    int eng1_m15_prior_trend_bias = eng1_m15_trend_bias
    int eng1_m30_prior_trend_bias = eng1_m30_trend_bias
    int eng1_h1_prior_trend_bias = eng1_h1_trend_bias
    int eng1_h4_prior_trend_bias = eng1_h4_trend_bias
    int eng1_d1_prior_trend_bias = eng1_d1_trend_bias
    if recalc_m1
        [eng1_m1_last_swing_high_tmp, eng1_m1_last_swing_high_bar_tmp, eng1_m1_last_swing_low_tmp, eng1_m1_last_swing_low_bar_tmp, eng1_m1_trend_bias_tmp, eng1_m1_eqh_tmp, _, eng1_m1_eql_tmp, _] = f_eng1_build_structure_liquidity(eng1_buf_m1_time, eng1_buf_m1_high, eng1_buf_m1_low, eng1_buf_m1_close, ENG1_SWING_LEN)
        eng1_m1_last_swing_high := eng1_m1_last_swing_high_tmp
        eng1_m1_last_swing_high_bar := eng1_m1_last_swing_high_bar_tmp
        eng1_m1_last_swing_low := eng1_m1_last_swing_low_tmp
        eng1_m1_last_swing_low_bar := eng1_m1_last_swing_low_bar_tmp
        eng1_m1_trend_bias := eng1_m1_trend_bias_tmp
        eng1_m1_eqh := eng1_m1_eqh_tmp
        eng1_m1_eql := eng1_m1_eql_tmp

    if recalc_m5
        [eng1_m5_last_swing_high_tmp, eng1_m5_last_swing_high_bar_tmp, eng1_m5_last_swing_low_tmp, eng1_m5_last_swing_low_bar_tmp, eng1_m5_trend_bias_tmp, eng1_m5_eqh_tmp, _, eng1_m5_eql_tmp, _] = f_eng1_build_structure_liquidity(eng1_buf_m5_time, eng1_buf_m5_high, eng1_buf_m5_low, eng1_buf_m5_close, ENG1_SWING_LEN)
        eng1_m5_last_swing_high := eng1_m5_last_swing_high_tmp
        eng1_m5_last_swing_high_bar := eng1_m5_last_swing_high_bar_tmp
        eng1_m5_last_swing_low := eng1_m5_last_swing_low_tmp
        eng1_m5_last_swing_low_bar := eng1_m5_last_swing_low_bar_tmp
        eng1_m5_trend_bias := eng1_m5_trend_bias_tmp
        eng1_m5_eqh := eng1_m5_eqh_tmp
        eng1_m5_eql := eng1_m5_eql_tmp

    if recalc_m15
        [eng1_m15_last_swing_high_tmp, eng1_m15_last_swing_high_bar_tmp, eng1_m15_last_swing_low_tmp, eng1_m15_last_swing_low_bar_tmp, eng1_m15_trend_bias_tmp, eng1_m15_eqh_tmp, eng1_m15_eqh_bar_tmp, eng1_m15_eql_tmp, eng1_m15_eql_bar_tmp] = f_eng1_build_structure_liquidity(eng1_buf_m15_time, eng1_buf_m15_high, eng1_buf_m15_low, eng1_buf_m15_close, ENG1_SWING_LEN)
        eng1_m15_last_swing_high := eng1_m15_last_swing_high_tmp
        eng1_m15_last_swing_high_bar := eng1_m15_last_swing_high_bar_tmp
        eng1_m15_last_swing_low := eng1_m15_last_swing_low_tmp
        eng1_m15_last_swing_low_bar := eng1_m15_last_swing_low_bar_tmp
        eng1_m15_trend_bias := eng1_m15_trend_bias_tmp
        eng1_m15_eqh := eng1_m15_eqh_tmp
