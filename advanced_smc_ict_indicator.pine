    eng1_ctx_bear_ob_top := eng1_h4_bear_ob_top
    eng1_ctx_bear_ob_bottom := eng1_h4_bear_ob_bottom
    eng1_ctx_bear_ob_entry := eng1_h4_bear_ob_entry
    eng1_ctx_bear_ob_bar := eng1_h4_bear_ob_bar
