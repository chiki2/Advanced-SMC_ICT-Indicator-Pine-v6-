float contextDepartureRange = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeLow : na
string longQualityTier = f_zoneQualityTier(not na(tradeLongEntry), f_zoneResponseScore(not na(tradeLongEntry), longZoneConfirmPass) + ((tradeLongIsOb or tradeLongIsFvg) and hasBullOb and hasBullFvg and f_zoneIntersects(ctxBullObTop, ctxBullObBottom, ctxBullFvgTop, ctxBullFvgBottom) ? 1 : 0), f_zoneDisplacementScore(longDisplacementSeen), f_zoneAtrExpansionScore(contextDepartureRange, atr))
string shortQualityTier = f_zoneQualityTier(not na(tradeShortEntry), f_zoneResponseScore(not na(tradeShortEntry), shortZoneConfirmPass) + ((tradeShortIsOb or tradeShortIsFvg) and hasBearOb and hasBearFvg and f_zoneIntersects(ctxBearObTop, ctxBearObBottom, ctxBearFvgTop, ctxBearFvgBottom) ? 1 : 0), f_zoneDisplacementScore(shortDisplacementSeen), f_zoneAtrExpansionScore(contextDepartureRange, atr))
string longExecutionState = f_setupExecutionState(not na(tradeLongEntry), longAmbiguous, longInvalidated, longExpired, longChased, longCompleted, longManaged, exe_long_base_confirm or longArmedLatched, longConfirmationPass or longArmedLatched, longExecutionFreshPass or longArmedLatched, longDisplacementSeen or longArmedLatched, longPriceInZone or longPoiMitigatedLatched, longPriceNearZone)
string shortExecutionState = f_setupExecutionState(not na(tradeShortEntry), shortAmbiguous, shortInvalidated, shortExpired, shortChased, shortCompleted, shortManaged, exe_short_base_confirm or shortArmedLatched, shortConfirmationPass or shortArmedLatched, shortExecutionFreshPass or shortArmedLatched, shortDisplacementSeen or shortArmedLatched, shortPriceInZone or shortPoiMitigatedLatched, shortPriceNearZone)
string longPoiLifecycle = f_eng3_poi_lifecycle(poi_long_contract_valid, poi_long_type, longPoiTappedLatched, longPoiMitigatedLatched, longPoiInvalidatedLatched)
string shortPoiLifecycle = f_eng3_poi_lifecycle(poi_short_contract_valid, poi_short_type, shortPoiTappedLatched, shortPoiMitigatedLatched, shortPoiInvalidatedLatched)

string longZoneQualityText = poi_long_contract_valid and f_eng3_poi_actionable(longPoiLifecycle) and not na(tradeLongEntry) ? longQualityTier : "-"
string shortZoneQualityText = poi_short_contract_valid and f_eng3_poi_actionable(shortPoiLifecycle) and not na(tradeShortEntry) ? shortQualityTier : "-"

// Selected POI stays visible through Fresh/Tapped/Mitigated, but Engine 2 only
// promotes it to SetupReady after Engine 3 has an armed/active risk state.
bool longSelectedVisualActive = not na(tradeLongEntry) and (f_eng3_poi_actionable(longPoiLifecycle) or longPoiLifecycle == "Mitigated") and not f_executionTerminal(longExecutionState)
bool shortSelectedVisualActive = not na(tradeShortEntry) and (f_eng3_poi_actionable(shortPoiLifecycle) or shortPoiLifecycle == "Mitigated") and not f_executionTerminal(shortExecutionState)
string eng2VisualState = (f_executionRiskVisible(longExecutionState) or f_executionRiskVisible(shortExecutionState)) ? "SetupReady" : ((poi_long_contract_valid and f_eng3_poi_actionable(longPoiLifecycle)) or (poi_short_contract_valid and f_eng3_poi_actionable(shortPoiLifecycle))) ? "POIReady" : eng2DealReady ? "DRReady" : "StructureOnly"
bool eng2SignalEventsStateReady = eng2VisualState == "POIReady" or eng2VisualState == "SetupReady"
bool eng2SignalRawStateReady = eng1_exec_valid and eng2SignalEventsStateReady
string preferredDirection = "Wait"
bool longPreferredReady = f_executionRiskVisible(longExecutionState)
bool shortPreferredReady = f_executionRiskVisible(shortExecutionState)
bool longPriorityCandidate = not na(tradeLongEntry) and not f_eng4_retired_state(longExecutionState, longSetupAge, longPoiMitigatedLatched, expiryBarsEffective)
bool shortPriorityCandidate = not na(tradeShortEntry) and not f_eng4_retired_state(shortExecutionState, shortSetupAge, shortPoiMitigatedLatched, expiryBarsEffective)
if longPreferredReady and not shortPreferredReady
    preferredDirection := "Long"
else if shortPreferredReady and not longPreferredReady
    preferredDirection := "Short"
else if longPreferredReady and shortPreferredReady
    preferredDirection := "Balanced"

bool compactUseLong = preferredDirection == "Long"
if preferredDirection == "Short"
    compactUseLong := false
else if preferredDirection == "Balanced"
    if longPriorityCandidate and not shortPriorityCandidate
        compactUseLong := true
    else if shortPriorityCandidate and not longPriorityCandidate
        compactUseLong := false
    else if not na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := tradeLongCreatedBar >= tradeShortCreatedBar
    else if na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := false
else
    if longPriorityCandidate and not shortPriorityCandidate
        compactUseLong := true
    else if shortPriorityCandidate and not longPriorityCandidate
        compactUseLong := false
    else if not na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := tradeLongCreatedBar >= tradeShortCreatedBar
    else if na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := false

//------------------------------------------------------------------------------
// ENGINE 2
// MAIN_CONTRACT order 8: render chart from snapshots only, after Engine 3 has
// produced zone, confirmations, trade plan, and lifecycle snapshots.
//------------------------------------------------------------------------------

bool draw_long_selected = longSelectedVisualActive and ((tradeLongIsOb and showOb) or (tradeLongIsFvg and showFvg))
bool draw_short_selected = shortSelectedVisualActive and ((tradeShortIsOb and showOb) or (tradeShortIsFvg and showFvg))
float draw_long_zone_top = draw_long_selected ? tradeLongValidTop : na
float draw_long_zone_bottom = draw_long_selected ? tradeLongValidBottom : na
float draw_short_zone_top = draw_short_selected ? tradeShortValidTop : na
float draw_short_zone_bottom = draw_short_selected ? tradeShortValidBottom : na
string draw_long_zone_type = draw_long_selected ? (tradeLongIsOb ? "OB" : tradeLongIsFvg ? "FVG" : "") : ""
string draw_short_zone_type = draw_short_selected ? (tradeShortIsOb ? "OB" : tradeShortIsFvg ? "FVG" : "") : ""
bool showEng2LongLiveZone = draw_long_selected and f_draw_zone_visible(draw_mode, true, true, preferredDirection)
bool showEng2ShortLiveZone = draw_short_selected and f_draw_zone_visible(draw_mode, true, false, preferredDirection)

bool longTerminalNow = f_executionTerminal(longExecutionState)
bool shortTerminalNow = f_executionTerminal(shortExecutionState)
bool longTerminalSnapshot = longTerminalNow and currentLongSetupTag != "" and eng2LongHistoryTag != currentLongSetupTag
bool shortTerminalSnapshot = shortTerminalNow and currentShortSetupTag != "" and eng2ShortHistoryTag != currentShortSetupTag
if longTerminalSnapshot
    eng2LongHistoryTag := currentLongSetupTag
    eng2LongHistoryLeftBar := f_createdBarFallback(tradeLongCreatedBar)
    eng2LongHistoryRightBar := bar_index
    eng2LongHistoryTop := tradeLongValidTop
    eng2LongHistoryBottom := tradeLongValidBottom
    eng2LongHistoryEntry := tradeLongEntry
    eng2LongHistoryIsOb := tradeLongIsOb
    eng2LongHistoryIsFvg := tradeLongIsFvg
    eng2LongHistoryMitigated := longPoiLifecycle == "Mitigated"
if shortTerminalSnapshot
    eng2ShortHistoryTag := currentShortSetupTag
    eng2ShortHistoryLeftBar := f_createdBarFallback(tradeShortCreatedBar)
    eng2ShortHistoryRightBar := bar_index
    eng2ShortHistoryTop := tradeShortValidTop
    eng2ShortHistoryBottom := tradeShortValidBottom
    eng2ShortHistoryEntry := tradeShortEntry
    eng2ShortHistoryIsOb := tradeShortIsOb
    eng2ShortHistoryIsFvg := tradeShortIsFvg
    eng2ShortHistoryMitigated := shortPoiLifecycle == "Mitigated"

bool historyZonesEnabled = eng1_exec_valid and draw_full and (showOb or showFvg) and not compactMode
// Active/current context owns the right edge. If the same OB/FVG is still live
// in Engine 1, hide the stale terminal snapshot so the active zone can continue
// to the current bar instead of looking visually cut off.
bool showEng2LongHistoryZone = historyZonesEnabled and eng2LongHistoryTag != "" and not na(eng2LongHistoryTop) and not na(eng2LongHistoryBottom) and ((eng2LongHistoryIsOb and showOb) or (eng2LongHistoryIsFvg and showFvg))
showEng2LongHistoryZone := showEng2LongHistoryZone and not f_eng2_matches_history_zone(showEng2LongLiveZone, (eng2LongHistoryIsOb and tradeLongIsOb) or (eng2LongHistoryIsFvg and tradeLongIsFvg), draw_long_zone_top, draw_long_zone_bottom, tradeLongCreatedBar, eng2LongHistoryTop, eng2LongHistoryBottom, eng2LongHistoryLeftBar)
showEng2LongHistoryZone := showEng2LongHistoryZone and not f_eng2_matches_history_zone(eng2LongHistoryIsOb and not na(eng1_ctx_bull_ob_top) and not na(eng1_ctx_bull_ob_bottom), true, eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng1BullObCreatedBar, eng2LongHistoryTop, eng2LongHistoryBottom, eng2LongHistoryLeftBar)
showEng2LongHistoryZone := showEng2LongHistoryZone and not f_eng2_matches_history_zone(eng2LongHistoryIsFvg and not na(eng1_ctx_bull_fvg_top) and not na(eng1_ctx_bull_fvg_bottom), true, eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng1BullFvgCreatedBar, eng2LongHistoryTop, eng2LongHistoryBottom, eng2LongHistoryLeftBar)
if showEng2LongHistoryZone and not eng2LongHistoryMitigated
    if (not na(eng2LongHistoryEntry) and not na(eng3SignalLow) and eng3SignalLow <= eng2LongHistoryEntry) or (not na(eng2LongHistoryBottom) and not na(eng3SignalLow) and eng3SignalLow <= eng2LongHistoryBottom)
        eng2LongHistoryMitigated := true
    eng2LongHistoryRightBar := bar_index
bool showEng2ShortHistoryZone = historyZonesEnabled and eng2ShortHistoryTag != "" and not na(eng2ShortHistoryTop) and not na(eng2ShortHistoryBottom) and ((eng2ShortHistoryIsOb and showOb) or (eng2ShortHistoryIsFvg and showFvg))
showEng2ShortHistoryZone := showEng2ShortHistoryZone and not f_eng2_matches_history_zone(showEng2ShortLiveZone, (eng2ShortHistoryIsOb and tradeShortIsOb) or (eng2ShortHistoryIsFvg and tradeShortIsFvg), draw_short_zone_top, draw_short_zone_bottom, tradeShortCreatedBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, eng2ShortHistoryLeftBar)
showEng2ShortHistoryZone := showEng2ShortHistoryZone and not f_eng2_matches_history_zone(eng2ShortHistoryIsOb and not na(eng1_ctx_bear_ob_top) and not na(eng1_ctx_bear_ob_bottom), true, eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng1BearObCreatedBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, eng2ShortHistoryLeftBar)
showEng2ShortHistoryZone := showEng2ShortHistoryZone and not f_eng2_matches_history_zone(eng2ShortHistoryIsFvg and not na(eng1_ctx_bear_fvg_top) and not na(eng1_ctx_bear_fvg_bottom), true, eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng1BearFvgCreatedBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, eng2ShortHistoryLeftBar)
if showEng2ShortHistoryZone and not eng2ShortHistoryMitigated
    if (not na(eng2ShortHistoryEntry) and not na(eng3SignalHigh) and eng3SignalHigh >= eng2ShortHistoryEntry) or (not na(eng2ShortHistoryTop) and not na(eng3SignalHigh) and eng3SignalHigh >= eng2ShortHistoryTop)
        eng2ShortHistoryMitigated := true
    eng2ShortHistoryRightBar := bar_index
string eng2LongZoneBadge = f_executionStateBadge(longExecutionState, compactMode)
string eng2ShortZoneBadge = f_executionStateBadge(shortExecutionState, compactMode)
string eng2LongZoneBaseLabel = draw_long_zone_type == "OB" ? f_obLabelText(true, eng1_ctx_bull_ob_breaker) : draw_long_zone_type == "FVG" ? f_fvgLabelText(true) : ""
string eng2ShortZoneBaseLabel = draw_short_zone_type == "OB" ? f_obLabelText(false, eng1_ctx_bear_ob_breaker) : draw_short_zone_type == "FVG" ? f_fvgLabelText(false) : ""
string eng2LongZoneLabelCore = eng2LongZoneBadge != "" ? eng2LongZoneBaseLabel + " | " + f_poiLifecycleDisplayText(longPoiLifecycle, poi_long_type) + " | " + eng2LongZoneBadge : eng2LongZoneBaseLabel + " | " + f_poiLifecycleDisplayText(longPoiLifecycle, poi_long_type)
string eng2ShortZoneLabelCore = eng2ShortZoneBadge != "" ? eng2ShortZoneBaseLabel + " | " + f_poiLifecycleDisplayText(shortPoiLifecycle, poi_short_type) + " | " + eng2ShortZoneBadge : eng2ShortZoneBaseLabel + " | " + f_poiLifecycleDisplayText(shortPoiLifecycle, poi_short_type)
string eng2LongZoneLabelText = eng2LongZoneBaseLabel == "" ? "" : eng2LongZoneLabelCore + f_zoneQualityLabelSuffix(longZoneQualityText)
string eng2ShortZoneLabelText = eng2ShortZoneBaseLabel == "" ? "" : eng2ShortZoneLabelCore + f_zoneQualityLabelSuffix(shortZoneQualityText)
int eng2LongZoneBorderWidth = longPoiLifecycle == "Mitigated" ? 1 : math.max(f_zoneQualityBorderWidth(longZoneQualityText), longExecutionState == "Active" ? 3 : 2)
int eng2ShortZoneBorderWidth = shortPoiLifecycle == "Mitigated" ? 1 : math.max(f_zoneQualityBorderWidth(shortZoneQualityText), shortExecutionState == "Active" ? 3 : 2)
color eng2LongZoneBorder = color.new(bullColor, longPoiLifecycle == "Mitigated" ? 70 : f_zoneQualityBorderAlpha(longZoneQualityText, longExecutionState))
color eng2ShortZoneBorder = color.new(bearColor, shortPoiLifecycle == "Mitigated" ? 70 : f_zoneQualityBorderAlpha(shortZoneQualityText, shortExecutionState))
color eng2LongZoneFill = color.new(bullColor, longPoiLifecycle == "Mitigated" ? 92 : f_executionSelectedFillAlpha(longExecutionState))
color eng2ShortZoneFill = color.new(bearColor, shortPoiLifecycle == "Mitigated" ? 92 : f_executionSelectedFillAlpha(shortExecutionState))

// Context zones start only when Engine 3 has a POI; before that, chart stays in
// StructureOnly/DRReady so users do not read raw context as a tradable setup.
bool eng2ContextZonesEnabled = eng1_exec_valid and draw_full and (showOb or showFvg) and not compactMode and (eng2VisualState == "POIReady" or eng2VisualState == "SetupReady")
bool showEng2CtxBullOb = eng2ContextZonesEnabled and poi_long_contract_valid and showOb and not tradeLongIsOb and not f_eng2_matches_history_zone(showEng2LongHistoryZone, eng2LongHistoryIsOb, eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng1BullObCreatedBar, eng2LongHistoryTop, eng2LongHistoryBottom, eng2LongHistoryLeftBar) and not na(eng1_ctx_bull_ob_top) and not na(eng1_ctx_bull_ob_bottom) and not (showEng2LongLiveZone and tradeLongIsOb and f_eng2_same_zone_visual(eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng1BullObCreatedBar, draw_long_zone_top, draw_long_zone_bottom, tradeLongCreatedBar))
bool showEng2CtxBullFvg = eng2ContextZonesEnabled and poi_long_contract_valid and showFvg and not tradeLongIsFvg and not f_eng2_matches_history_zone(showEng2LongHistoryZone, eng2LongHistoryIsFvg, eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng1BullFvgCreatedBar, eng2LongHistoryTop, eng2LongHistoryBottom, eng2LongHistoryLeftBar) and not na(eng1_ctx_bull_fvg_top) and not na(eng1_ctx_bull_fvg_bottom) and not (showEng2LongLiveZone and tradeLongIsFvg and f_eng2_same_zone_visual(eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng1BullFvgCreatedBar, draw_long_zone_top, draw_long_zone_bottom, tradeLongCreatedBar))
bool showEng2CtxBearOb = eng2ContextZonesEnabled and poi_short_contract_valid and showOb and not tradeShortIsOb and not f_eng2_matches_history_zone(showEng2ShortHistoryZone, eng2ShortHistoryIsOb, eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng1BearObCreatedBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, eng2ShortHistoryLeftBar) and not na(eng1_ctx_bear_ob_top) and not na(eng1_ctx_bear_ob_bottom) and not (showEng2ShortLiveZone and tradeShortIsOb and f_eng2_same_zone_visual(eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng1BearObCreatedBar, draw_short_zone_top, draw_short_zone_bottom, tradeShortCreatedBar))
bool showEng2CtxBearFvg = eng2ContextZonesEnabled and poi_short_contract_valid and showFvg and not tradeShortIsFvg and not f_eng2_matches_history_zone(showEng2ShortHistoryZone, eng2ShortHistoryIsFvg, eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng1BearFvgCreatedBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, eng2ShortHistoryLeftBar) and not na(eng1_ctx_bear_fvg_top) and not na(eng1_ctx_bear_fvg_bottom) and not (showEng2ShortLiveZone and tradeShortIsFvg and f_eng2_same_zone_visual(eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng1BearFvgCreatedBar, draw_short_zone_top, draw_short_zone_bottom, tradeShortCreatedBar))
[eng2CtxBullObBoxTmp, eng2CtxBullObLabelTmp] = f_eng2_syncPassiveZoneVisual(eng2CtxBullObBox, eng2CtxBullObLabel, showEng2CtxBullOb, eng1BullObCreatedBar, eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, "", color.new(bullColor, 72), color.new(bullColor, 97))
[eng2CtxBullFvgBoxTmp, eng2CtxBullFvgLabelTmp] = f_eng2_syncPassiveZoneVisual(eng2CtxBullFvgBox, eng2CtxBullFvgLabel, showEng2CtxBullFvg, eng1BullFvgCreatedBar, eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, "", color.new(bullColor, 82), color.new(bullColor, 98))
[eng2CtxBearObBoxTmp, eng2CtxBearObLabelTmp] = f_eng2_syncPassiveZoneVisual(eng2CtxBearObBox, eng2CtxBearObLabel, showEng2CtxBearOb, eng1BearObCreatedBar, eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, "", color.new(bearColor, 72), color.new(bearColor, 97))
[eng2CtxBearFvgBoxTmp, eng2CtxBearFvgLabelTmp] = f_eng2_syncPassiveZoneVisual(eng2CtxBearFvgBox, eng2CtxBearFvgLabel, showEng2CtxBearFvg, eng1BearFvgCreatedBar, eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, "", color.new(bearColor, 82), color.new(bearColor, 98))
eng2CtxBullObBox := eng2CtxBullObBoxTmp
eng2CtxBullObLabel := eng2CtxBullObLabelTmp
eng2CtxBullFvgBox := eng2CtxBullFvgBoxTmp
eng2CtxBullFvgLabel := eng2CtxBullFvgLabelTmp
eng2CtxBearObBox := eng2CtxBearObBoxTmp
eng2CtxBearObLabel := eng2CtxBearObLabelTmp
eng2CtxBearFvgBox := eng2CtxBearFvgBoxTmp
eng2CtxBearFvgLabel := eng2CtxBearFvgLabelTmp

[eng2LongZoneBoxTmp, eng2LongZoneLineTmp, eng2LongZoneLabelTmp] = f_eng2_syncSetupZoneVisual(eng2LongZoneBox, eng2LongZoneLine, eng2LongZoneLabel, showEng2LongLiveZone, tradeLongCreatedBar, draw_long_zone_top, draw_long_zone_bottom, tradeLongEntry, eng2LongZoneLabelText, tradeLongIsOb ? label.style_label_right : label.style_label_left, eng2LongZoneBorder, eng2LongZoneFill, eng2LongZoneBorderWidth, tradeLongIsOb or tradeLongIsFvg, longExecutionState)
[eng2ShortZoneBoxTmp, eng2ShortZoneLineTmp, eng2ShortZoneLabelTmp] = f_eng2_syncSetupZoneVisual(eng2ShortZoneBox, eng2ShortZoneLine, eng2ShortZoneLabel, showEng2ShortLiveZone, tradeShortCreatedBar, draw_short_zone_top, draw_short_zone_bottom, tradeShortEntry, eng2ShortZoneLabelText, tradeShortIsOb ? label.style_label_right : label.style_label_left, eng2ShortZoneBorder, eng2ShortZoneFill, eng2ShortZoneBorderWidth, tradeShortIsOb or tradeShortIsFvg, shortExecutionState)
eng2LongZoneBox := eng2LongZoneBoxTmp
eng2LongZoneLine := eng2LongZoneLineTmp
eng2LongZoneLabel := eng2LongZoneLabelTmp
eng2ShortZoneBox := eng2ShortZoneBoxTmp
eng2ShortZoneLine := eng2ShortZoneLineTmp
eng2ShortZoneLabel := eng2ShortZoneLabelTmp

// History boxes should stay visible, but feel lighter than the live / selected zone.
eng2LongHistoryBox := f_eng2_syncHistoryZoneBox(eng2LongHistoryBox, showEng2LongHistoryZone, eng2LongHistoryLeftBar, eng2LongHistoryRightBar, eng2LongHistoryTop, eng2LongHistoryBottom, color.new(bullColor, 80), color.new(bullColor, 98), 1)
eng2ShortHistoryBox := f_eng2_syncHistoryZoneBox(eng2ShortHistoryBox, showEng2ShortHistoryZone, eng2ShortHistoryLeftBar, eng2ShortHistoryRightBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, color.new(bearColor, 80), color.new(bearColor, 98), 1)

bool eng2RawEventLabelsAllowed = eng2SignalRawStateReady and not (draw_long_selected or draw_short_selected)
bool eng2KeepSweepLabels = displaySweepMarkers and eng2RawEventLabelsAllowed
bool eng2KeepSetupLabels = draw_show_setup_events and eng2SignalEventsStateReady
int eng2EventKeepCap = eng2KeepSweepLabels or eng2KeepSetupLabels ? f_eng2_signal_event_cap() : 0
while array.size(eng2SignalEventLabelHistory) > eng2EventKeepCap
    label eventLabel = array.shift(eng2SignalEventLabelHistory)
    if not na(eventLabel)
        label.delete(eventLabel)
if not eng2KeepSetupLabels
    eng2LongTappedEventTag := ""
    eng2LongMitigatedEventTag := ""
    eng2ShortTappedEventTag := ""
    eng2ShortMitigatedEventTag := ""
if not eng2KeepSweepLabels
    eng2LastLongSweepLabelBar := na
    eng2LastShortSweepLabelBar := na
    eng2LastBullDispLabelBar := na
    eng2LastBearDispLabelBar := na

bool eng2EventCreateAllowed = barstate.isnew
int eng2EventTime = nz(eng3SignalTime, time)
float eng2EventLow = nz(eng3SignalLow, low)
float eng2EventHigh = nz(eng3SignalHigh, high)
int eng2RawEventCooldownBars = chartTfSeconds <= 60 ? 8 : chartTfSeconds <= 300 ? 5 : chartTfSeconds <= 900 ? 3 : 2
bool eng2LongSetupEventAllowed = draw_show_setup_events and eng2SignalEventsStateReady and draw_long_selected
bool eng2ShortSetupEventAllowed = draw_show_setup_events and eng2SignalEventsStateReady and draw_short_selected
bool eng2BullInternalContinuationEvent = eng1_exe_bull_bos and not eng1_exe_bull_bos[1] or eng1_exe_bull_mss and not eng1_exe_bull_mss[1] or eng1_exe_bull_choch and not eng1_exe_bull_choch[1]
bool eng2BearInternalContinuationEvent = eng1_exe_bear_bos and not eng1_exe_bear_bos[1] or eng1_exe_bear_mss and not eng1_exe_bear_mss[1] or eng1_exe_bear_choch and not eng1_exe_bear_choch[1]
bool eng2BullSwingContinuationEvent = eng1_ctx_bull_breakout and not eng1_ctx_bull_breakout[1] or eng1_ctx_bull_choch and not eng1_ctx_bull_choch[1]
bool eng2BearSwingContinuationEvent = eng1_ctx_bear_breakout and not eng1_ctx_bear_breakout[1] or eng1_ctx_bear_choch and not eng1_ctx_bear_choch[1]
bool eng2LongContReady = eng2EventCreateAllowed and eng2LongSetupEventAllowed and not f_executionTerminal(longExecutionState) and not na(tradeLongEntry) and (longPoiTappedLatched or longPoiMitigatedLatched)
bool eng2ShortContReady = eng2EventCreateAllowed and eng2ShortSetupEventAllowed and not f_executionTerminal(shortExecutionState) and not na(tradeShortEntry) and (shortPoiTappedLatched or shortPoiMitigatedLatched)
int eng2BullBreakerLabelTime = nz(eng1_ctx_bull_ob_breaker_time, eng1_ctx_bull_ob_bar)
int eng2BearBreakerLabelTime = nz(eng1_ctx_bear_ob_breaker_time, eng1_ctx_bear_ob_bar)
bool eng2BullBreakerEvent = eng1_ctx_bull_ob_breaker and not na(eng2BullBreakerLabelTime) and eng2BullBreakerLabelTime != nz(eng2BullBreakerLabelTime[1], -1)
bool eng2BearBreakerEvent = eng1_ctx_bear_ob_breaker and not na(eng2BearBreakerLabelTime) and eng2BearBreakerLabelTime != nz(eng2BearBreakerLabelTime[1], -1)
bool eng2BullDispEvent = eng1_exe_bull_displacement and not eng1_exe_bull_displacement[1] or longDispFallback and not longDispFallback[1]
bool eng2BearDispEvent = eng1_exe_bear_displacement and not eng1_exe_bear_displacement[1] or shortDispFallback and not shortDispFallback[1]
bool eng2ShowLongTappedLabel = eng2EventCreateAllowed and eng2LongSetupEventAllowed and currentLongSetupTag != "" and longPoiTappedLatched and eng2LongTappedEventTag != currentLongSetupTag
bool eng2ShowLongCeLabel = eng2EventCreateAllowed and eng2LongSetupEventAllowed and currentLongSetupTag != "" and longPoiMitigatedLatched and eng2LongMitigatedEventTag != currentLongSetupTag
bool eng2ShowShortTappedLabel = eng2EventCreateAllowed and eng2ShortSetupEventAllowed and currentShortSetupTag != "" and shortPoiTappedLatched and eng2ShortTappedEventTag != currentShortSetupTag
bool eng2ShowShortCeLabel = eng2EventCreateAllowed and eng2ShortSetupEventAllowed and currentShortSetupTag != "" and shortPoiMitigatedLatched and eng2ShortMitigatedEventTag != currentShortSetupTag
if eng2ShowLongTappedLabel
    eng2LongTappedEventTag := currentLongSetupTag
if eng2ShowLongCeLabel
    eng2LongMitigatedEventTag := currentLongSetupTag
if eng2ShowShortTappedLabel
    eng2ShortTappedEventTag := currentShortSetupTag
if eng2ShowShortCeLabel
    eng2ShortMitigatedEventTag := currentShortSetupTag
bool eng2LongSweepEvent = eng2EventCreateAllowed and eng2RawEventLabelsAllowed and displaySweepMarkers and eng1_exec_valid and (na(eng2LastLongSweepLabelBar) or bar_index - eng2LastLongSweepLabelBar >= eng2RawEventCooldownBars) and effectiveLongSweepSeen and not effectiveLongSweepSeen[1]
bool eng2ShortSweepEvent = eng2EventCreateAllowed and eng2RawEventLabelsAllowed and displaySweepMarkers and eng1_exec_valid and (na(eng2LastShortSweepLabelBar) or bar_index - eng2LastShortSweepLabelBar >= eng2RawEventCooldownBars) and effectiveShortSweepSeen and not effectiveShortSweepSeen[1]
bool eng2BullDispLabelEvent = eng2EventCreateAllowed and eng2RawEventLabelsAllowed and draw_show_structure and (na(eng2LastBullDispLabelBar) or bar_index - eng2LastBullDispLabelBar >= eng2RawEventCooldownBars) and eng2BullDispEvent
bool eng2BearDispLabelEvent = eng2EventCreateAllowed and eng2RawEventLabelsAllowed and draw_show_structure and (na(eng2LastBearDispLabelBar) or bar_index - eng2LastBearDispLabelBar >= eng2RawEventCooldownBars) and eng2BearDispEvent
bool eng2BullBreakerLabelEvent = eng2EventCreateAllowed and eng2LongSetupEventAllowed and showOb and eng2BullBreakerEvent
bool eng2BearBreakerLabelEvent = eng2EventCreateAllowed and eng2ShortSetupEventAllowed and showOb and eng2BearBreakerEvent
if eng2LongSweepEvent
    eng2LastLongSweepLabelBar := bar_index
if eng2ShortSweepEvent
    eng2LastShortSweepLabelBar := bar_index
if eng2BullDispLabelEvent
    eng2LastBullDispLabelBar := bar_index
if eng2BearDispLabelEvent
    eng2LastBearDispLabelBar := bar_index
string eng2LongSweepText = eng1_exe_eql_active ? "EQL Sweep" : "SSL Sweep"
string eng2ShortSweepText = eng1_exe_eqh_active ? "EQH Sweep" : "BSL Sweep"
string eng2LongInternalContText = (eng1_exe_bull_mss or eng1_exe_bull_choch) ? "iMSS Cont" : "iBOS Cont"
string eng2ShortInternalContText = (eng1_exe_bear_mss or eng1_exe_bear_choch) ? "iMSS Cont" : "iBOS Cont"
string eng2LongSwingContText = eng1_ctx_bull_choch ? "sMSS Cont" : "sBOS Cont"
string eng2ShortSwingContText = eng1_ctx_bear_choch ? "sMSS Cont" : "sBOS Cont"
float eng2BullBreakerLevel = not na(eng1_ctx_bull_ob_top) and not na(eng1_ctx_bull_ob_bottom) ? f_zoneMid(eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom) : eng2EventLow
float eng2BearBreakerLevel = not na(eng1_ctx_bear_ob_top) and not na(eng1_ctx_bear_ob_bottom) ? f_zoneMid(eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom) : eng2EventHigh
int eng2BullBreakerTime = nz(eng2BullBreakerLabelTime, time)
int eng2BearBreakerTime = nz(eng2BearBreakerLabelTime, time)
f_eng2_emitSignalEvent(eng2LongSweepEvent, eng2EventTime, eng2EventLow, eng2LongSweepText, color.new(bullColor, 12), false, 0.98)
f_eng2_emitSignalEvent(eng2ShortSweepEvent, eng2EventTime, eng2EventHigh, eng2ShortSweepText, color.new(bearColor, 12), true, 0.98)
f_eng2_emitSignalEvent(eng2BullDispLabelEvent, eng2EventTime, eng2EventLow, "Disp+", color.new(bullColor, 15), false, 1.26)
f_eng2_emitSignalEvent(eng2BearDispLabelEvent, eng2EventTime, eng2EventHigh, "Disp-", color.new(bearColor, 15), true, 1.26)
f_eng2_emitSignalEvent(eng2ShowLongTappedLabel, eng2EventTime, nz(tradeLongEntry, eng2EventLow), "Tapped", color.new(bullColor, 5), false, 1.50)
f_eng2_emitSignalEvent(eng2ShowLongCeLabel, eng2EventTime, nz(tradeLongEntry, eng2EventLow), "CE Mitigated", color.new(bullColor, 0), false, 1.72)
f_eng2_emitSignalEvent(eng2ShowShortTappedLabel, eng2EventTime, nz(tradeShortEntry, eng2EventHigh), "Tapped", color.new(bearColor, 5), true, 1.50)
f_eng2_emitSignalEvent(eng2ShowShortCeLabel, eng2EventTime, nz(tradeShortEntry, eng2EventHigh), "CE Mitigated", color.new(bearColor, 0), true, 1.72)
f_eng2_emitSignalEvent(eng2LongContReady and eng2BullInternalContinuationEvent, eng2EventTime, eng2EventLow, eng2LongInternalContText, color.new(bullColor, 0), false, 1.94)
f_eng2_emitSignalEvent(eng2ShortContReady and eng2BearInternalContinuationEvent, eng2EventTime, eng2EventHigh, eng2ShortInternalContText, color.new(bearColor, 0), true, 1.94)
f_eng2_emitSignalEvent(eng2LongContReady and eng2BullSwingContinuationEvent, eng2EventTime, eng2EventLow, eng2LongSwingContText, color.new(bullColor, 0), false, 2.18)
f_eng2_emitSignalEvent(eng2ShortContReady and eng2BearSwingContinuationEvent, eng2EventTime, eng2EventHigh, eng2ShortSwingContText, color.new(bearColor, 0), true, 2.18)
f_eng2_emitSignalEvent(eng2BullBreakerLabelEvent, eng2BullBreakerTime, eng2BullBreakerLevel, "Bull Breaker", color.new(bullColor, 0), false, 2.42)
f_eng2_emitSignalEvent(eng2BearBreakerLabelEvent, eng2BearBreakerTime, eng2BearBreakerLevel, "Bear Breaker", color.new(bearColor, 0), true, 2.42)

//------------------------------------------------------------------------------
// Session range visuals
//------------------------------------------------------------------------------
bool sessionVisualsEnabled = showSessionVisuals and draw_full and timeframe.isintraday

if not sessionVisualsEnabled
    f_trimSessionVisuals(0)

[activeAsiaSessionBoxTmp, activeAsiaSessionLabelTmp, activeAsiaSessionHighLineTmp, activeAsiaSessionLowLineTmp, activeAsiaSessionStartBarTmp] = f_eng2_syncSessionLane(sessionVisualsEnabled, inAsiaSession, newAsiaSession, asiaSessionEnded, activeAsiaSessionBox, activeAsiaSessionLabel, activeAsiaSessionHighLine, activeAsiaSessionLowLine, activeAsiaSessionStartBar, "Asia", asiaSessionHigh, asiaSessionLow)
activeAsiaSessionBox := activeAsiaSessionBoxTmp
activeAsiaSessionLabel := activeAsiaSessionLabelTmp
activeAsiaSessionHighLine := activeAsiaSessionHighLineTmp
activeAsiaSessionLowLine := activeAsiaSessionLowLineTmp
activeAsiaSessionStartBar := activeAsiaSessionStartBarTmp

[activeLondonSessionBoxTmp, activeLondonSessionLabelTmp, activeLondonSessionHighLineTmp, activeLondonSessionLowLineTmp, activeLondonSessionStartBarTmp] = f_eng2_syncSessionLane(sessionVisualsEnabled, inLondonSession, newLondonSession, londonSessionEnded, activeLondonSessionBox, activeLondonSessionLabel, activeLondonSessionHighLine, activeLondonSessionLowLine, activeLondonSessionStartBar, "London", londonSessionHigh, londonSessionLow)
activeLondonSessionBox := activeLondonSessionBoxTmp
activeLondonSessionLabel := activeLondonSessionLabelTmp
activeLondonSessionHighLine := activeLondonSessionHighLineTmp
activeLondonSessionLowLine := activeLondonSessionLowLineTmp
activeLondonSessionStartBar := activeLondonSessionStartBarTmp

[activeNewYorkSessionBoxTmp, activeNewYorkSessionLabelTmp, activeNewYorkSessionHighLineTmp, activeNewYorkSessionLowLineTmp, activeNewYorkSessionStartBarTmp] = f_eng2_syncSessionLane(sessionVisualsEnabled, inNewYorkSession, newNewYorkSession, newYorkSessionEnded, activeNewYorkSessionBox, activeNewYorkSessionLabel, activeNewYorkSessionHighLine, activeNewYorkSessionLowLine, activeNewYorkSessionStartBar, "New York", newYorkSessionHigh, newYorkSessionLow)
activeNewYorkSessionBox := activeNewYorkSessionBoxTmp
activeNewYorkSessionLabel := activeNewYorkSessionLabelTmp
activeNewYorkSessionHighLine := activeNewYorkSessionHighLineTmp
activeNewYorkSessionLowLine := activeNewYorkSessionLowLineTmp
activeNewYorkSessionStartBar := activeNewYorkSessionStartBarTmp

if barstate.islast and sessionVisualsEnabled and array.size(sessionRangeBoxes) > 0
    for i = 0 to array.size(sessionRangeBoxes) - 1
        sessionBox = array.get(sessionRangeBoxes, i)
        sessionLabel = i < array.size(sessionRangeLabels) ? array.get(sessionRangeLabels, i) : na
        sessionName = i < array.size(sessionRangeNames) ? array.get(sessionRangeNames, i) : "Session"
        sessionHighLine = i < array.size(sessionRangeHighLines) ? array.get(sessionRangeHighLines, i) : na
        sessionLowLine = i < array.size(sessionRangeLowLines) ? array.get(sessionRangeLowLines, i) : na
        f_eng2_styleArchivedSessionVisual(sessionBox, sessionLabel, sessionHighLine, sessionLowLine, sessionName)

//------------------------------------------------------------------------------
// Narrative zones: supply/demand from the narrative HTF snapshot.
// Full mode only to avoid clutter on execution charts.
//------------------------------------------------------------------------------
// HTF S/D is narrative context, not setup-owned POI. Keep it alive in Full mode
// so the box continues to the active bar even when the current POI is retired.
bool eng2NarrativeZonesEnabled = eng1_exec_valid and draw_full and draw_show_htf and not compactMode
bool showEng2NarrBullSd = eng2NarrativeZonesEnabled and not na(eng1_narr_bull_sd_top) and not na(eng1_narr_bull_sd_bottom)
bool showEng2NarrBearSd = eng2NarrativeZonesEnabled and not na(eng1_narr_bear_sd_top) and not na(eng1_narr_bear_sd_bottom)
[eng2NarrBullSdBoxTmp, eng2NarrBullSdLabelTmp] = f_eng2_syncHtfSdVisual(eng2NarrBullSdBox, eng2NarrBullSdLabel, showEng2NarrBullSd, eng1_narr_bull_sd_bar, eng1_narr_bull_sd_top, eng1_narr_bull_sd_bottom, compactMode ? "SD+" : "HTF SD+", color.new(bullColor, 78), color.new(bullColor, 98))
[eng2NarrBearSdBoxTmp, eng2NarrBearSdLabelTmp] = f_eng2_syncHtfSdVisual(eng2NarrBearSdBox, eng2NarrBearSdLabel, showEng2NarrBearSd, eng1_narr_bear_sd_bar, eng1_narr_bear_sd_top, eng1_narr_bear_sd_bottom, compactMode ? "SD-" : "HTF SD-", color.new(bearColor, 78), color.new(bearColor, 98))
eng2NarrBullSdBox := eng2NarrBullSdBoxTmp
eng2NarrBullSdLabel := eng2NarrBullSdLabelTmp
eng2NarrBearSdBox := eng2NarrBearSdBoxTmp
eng2NarrBearSdLabel := eng2NarrBearSdLabelTmp

float bullStop = not na(tradeLongStop) ? tradeLongStop : not na(eng1_exe_liq_low) ? eng1_exe_liq_low - atr * stopAtrBuffer : na
float bearStop = not na(tradeShortStop) ? tradeShortStop : not na(eng1_exe_liq_high) ? eng1_exe_liq_high + atr * stopAtrBuffer : na

//------------------------------------------------------------------------------
// Zone visual policy
// Live OB/FVG zones are selected by Engine 3. Engine 2 only renders the selected
// active zone plus non-duplicated context/range levels allowed by draw_mode.
//------------------------------------------------------------------------------
// Liquidity labels are semantic: EQH/EQL are equal-high/low pools, BSL/SSL are
// execution swing pools, ERL marks dealing-range extremes, and PD/PW/PM levels
// mark previous period liquidity; internal engine aliases stay off the chart.
bool draw_eq_high_primary = f_preferredLevelMatch(eng1_exe_liq_high, preferredDirection == "Balanced", compactUseLong, activeLongTarget, activeShortTarget)
bool draw_eq_low_primary = f_preferredLevelMatch(eng1_exe_liq_low, preferredDirection == "Balanced", compactUseLong, activeLongTarget, activeShortTarget)
showEqHighVisual = showLiquidity and not compactMode and f_draw_level_visible(draw_mode, draw_eq_high_primary, true, preferredDirection)
showEqLowVisual = showLiquidity and not compactMode and f_draw_level_visible(draw_mode, draw_eq_low_primary, false, preferredDirection)
showRangeVisual = showLiquidity and displayInternalRange and f_contextVisualByMode(draw_mode)
showOteVisual = strictShowOte and (draw_full or draw_focused) and not draw_minimal
showCalendarLiquidityVisual = showLiquidity and draw_show_htf and not compactMode and f_contextVisualByMode(draw_mode)
showLongRiskVisual = showRisk and not compactMode and f_executionVisualByMode(draw_mode, f_executionRiskVisible(longExecutionState), preferredDirection, true, compactUseLong)
showShortRiskVisual = showRisk and not compactMode and f_executionVisualByMode(draw_mode, f_executionRiskVisible(shortExecutionState), preferredDirection, false, compactUseLong)

if not draw_full
    showEqHighVisual := f_uniqueLevelVisual(showEqHighVisual, eng1_exe_liq_high, false, na, false, na, false, na, false, na, false, na)
    showEqLowVisual := f_uniqueLevelVisual(showEqLowVisual, eng1_exe_liq_low, false, na, false, na, false, na, false, na, false, na)

//------------------------------------------------------------------------------
// Active Levels (single-instance lines)
// Keep these non-historical to avoid scattered segments when levels update.
//------------------------------------------------------------------------------
eqHighLevel = showEqHighVisual ? eng1_exe_liq_high : na
eqLowLevel = showEqLowVisual ? eng1_exe_liq_low : na
bool showDealingRangeVisual = showRangeVisual and not eng2DealBroken and not na(eng2DealHigh) and not na(eng2DealLow) and not na(eng2DealLeftBar) and eng2DealHigh > eng2DealLow
float dealingRangeHighLevel = showDealingRangeVisual ? eng2DealHigh : na
float dealingRangeLowLevel = showDealingRangeVisual ? eng2DealLow : na
float dealingRangeEqLevel = showDealingRangeVisual ? (eng2DealHigh + eng2DealLow) * 0.5 : na
float dealingRangeSize = showDealingRangeVisual ? eng2DealHigh - eng2DealLow : na
float dealingRangeQ25 = showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.25 : na
float dealingRangeQ75 = showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.75 : na
float dealingBuyOteTop = showDealingRangeVisual ? eng2DealHigh - dealingRangeSize * 0.618 : na
float dealingBuyOteBottom = showDealingRangeVisual ? eng2DealHigh - dealingRangeSize * 0.786 : na
float dealingSellOteTop = showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.786 : na
float dealingSellOteBottom = showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.618 : na
riskLongEntryLevel = showLongRiskVisual ? tradeLongEntry : na
riskShortEntryLevel = showShortRiskVisual ? tradeShortEntry : na
riskBullStopLevel = showLongRiskVisual ? bullStop : na
riskBearStopLevel = showShortRiskVisual ? bearStop : na
riskLongTargetLevel = showLongRiskVisual ? activeLongTarget : na
riskShortTargetLevel = showShortRiskVisual ? activeShortTarget : na
oteLongTopLevel = showOteVisual and showDealingRangeVisual ? dealingBuyOteTop : na
oteLongBottomLevel = showOteVisual and showDealingRangeVisual ? dealingBuyOteBottom : na
oteShortTopLevel = showOteVisual and showDealingRangeVisual ? dealingSellOteTop : na
oteShortBottomLevel = showOteVisual and showDealingRangeVisual ? dealingSellOteBottom : na
rightEdgeLabelTolerance = not na(atr) ? atr * 0.15 : syminfo.mintick * 10.0
pdhLevel = showCalendarLiquidityVisual ? prevDayHigh : na
pdlLevel = showCalendarLiquidityVisual ? prevDayLow : na
pwhLevel = showCalendarLiquidityVisual and not f_levelsClose(prevWeekHigh, pdhLevel, rightEdgeLabelTolerance) ? prevWeekHigh : na
pwlLevel = showCalendarLiquidityVisual and not f_levelsClose(prevWeekLow, pdlLevel, rightEdgeLabelTolerance) ? prevWeekLow : na
pmhLevel = showCalendarLiquidityVisual and not f_levelsClose(prevMonthHigh, pdhLevel, rightEdgeLabelTolerance) and not f_levelsClose(prevMonthHigh, pwhLevel, rightEdgeLabelTolerance) ? prevMonthHigh : na
pmlLevel = showCalendarLiquidityVisual and not f_levelsClose(prevMonthLow, pdlLevel, rightEdgeLabelTolerance) and not f_levelsClose(prevMonthLow, pwlLevel, rightEdgeLabelTolerance) ? prevMonthLow : na
showPdhVisual = not na(pdhLevel)
showPdlVisual = not na(pdlLevel)
showPwhVisual = not na(pwhLevel)
showPwlVisual = not na(pwlLevel)
showPmhVisual = not na(pmhLevel)
showPmlVisual = not na(pmlLevel)
bool eqHighOverlapsCalendar = f_levelsClose(eqHighLevel, pdhLevel, rightEdgeLabelTolerance) or f_levelsClose(eqHighLevel, pwhLevel, rightEdgeLabelTolerance) or f_levelsClose(eqHighLevel, pmhLevel, rightEdgeLabelTolerance)
bool eqLowOverlapsCalendar = f_levelsClose(eqLowLevel, pdlLevel, rightEdgeLabelTolerance) or f_levelsClose(eqLowLevel, pwlLevel, rightEdgeLabelTolerance) or f_levelsClose(eqLowLevel, pmlLevel, rightEdgeLabelTolerance)
showShortStopRightLabel = draw_show_right_labels and showShortRiskVisual and not na(riskBearStopLevel)
showLongStopRightLabel = draw_show_right_labels and showLongRiskVisual and not na(riskBullStopLevel)
showEqHighRightLabel = draw_show_right_labels and showEqHighVisual and not eqHighOverlapsCalendar and not f_levelsClose(eqHighLevel, riskBearStopLevel, rightEdgeLabelTolerance)
showEqLowRightLabel = draw_show_right_labels and showEqLowVisual and not eqLowOverlapsCalendar and not f_levelsClose(eqLowLevel, riskBullStopLevel, rightEdgeLabelTolerance)

if barstate.islast
    // Lines (single instance per level)
    bool showExecEqHighLine = showEqHighVisual and not showDealingRangeVisual and not eqHighOverlapsCalendar
    bool showExecEqLowLine = showEqLowVisual and not showDealingRangeVisual and not eqLowOverlapsCalendar
    eng2BslLine := f_eng2_syncThinLevelLine(eng2BslLine, eqHighLevel, color.new(liqHighColor, 12), line.style_solid, showExecEqHighLine)
    eng2SslLine := f_eng2_syncThinLevelLine(eng2SslLine, eqLowLevel, color.new(liqLowColor, 12), line.style_solid, showExecEqLowLine)
    eng2PdhLine := f_eng2_syncThinLevelLine(eng2PdhLine, pdhLevel, color.new(liqHighColor, 28), line.style_dashed, showPdhVisual)
    eng2PdlLine := f_eng2_syncThinLevelLine(eng2PdlLine, pdlLevel, color.new(liqLowColor, 28), line.style_dashed, showPdlVisual)
    eng2PwhLine := f_eng2_syncThinLevelLine(eng2PwhLine, pwhLevel, color.new(color.fuchsia, 32), line.style_dashed, showPwhVisual)
    eng2PwlLine := f_eng2_syncThinLevelLine(eng2PwlLine, pwlLevel, color.new(color.fuchsia, 32), line.style_dashed, showPwlVisual)
    eng2PmhLine := f_eng2_syncThinLevelLine(eng2PmhLine, pmhLevel, color.new(color.silver, 38), line.style_dotted, showPmhVisual)
    eng2PmlLine := f_eng2_syncThinLevelLine(eng2PmlLine, pmlLevel, color.new(color.silver, 38), line.style_dotted, showPmlVisual)

    int dealingLeftBar = showDealingRangeVisual ? eng2DealLeftBar : na
    int dealingRightBar = bar_index
    [eng2RangeHighLineTmp, eng2RangeLowLineTmp, eng2RangeEqLineTmp, eng2RangeQ25LineTmp, eng2RangeQ75LineTmp, eng2RangePremiumFillTmp, eng2RangeDiscountFillTmp] = f_eng2_syncDealingRangeCore(eng2RangeHighLine, eng2RangeLowLine, eng2RangeEqLine, eng2RangeQ25Line, eng2RangeQ75Line, eng2RangePremiumFill, eng2RangeDiscountFill, dealingLeftBar, dealingRightBar, dealingRangeHighLevel, dealingRangeLowLevel, dealingRangeEqLevel, dealingRangeQ25, dealingRangeQ75, decisionEqColor, decisionPremiumFillColor, decisionDiscountFillColor, eng2DealBroken, showDealingRangeVisual)
    eng2RangeHighLine := eng2RangeHighLineTmp
    eng2RangeLowLine := eng2RangeLowLineTmp
    eng2RangeEqLine := eng2RangeEqLineTmp
    eng2RangeQ25Line := eng2RangeQ25LineTmp
    eng2RangeQ75Line := eng2RangeQ75LineTmp
    eng2RangePremiumFill := eng2RangePremiumFillTmp
    eng2RangeDiscountFill := eng2RangeDiscountFillTmp

    bool showDealingOte = showOteVisual and showDealingRangeVisual
    [eng2OteLongTopLineTmp, eng2OteLongBottomLineTmp, eng2OteLongFillTmp, eng2OteShortTopLineTmp, eng2OteShortBottomLineTmp, eng2OteShortFillTmp] = f_eng2_syncDealingOteCore(eng2OteLongTopLine, eng2OteLongBottomLine, eng2OteLongFill, eng2OteShortTopLine, eng2OteShortBottomLine, eng2OteShortFill, dealingLeftBar, dealingRightBar, oteLongTopLevel, oteLongBottomLevel, oteShortTopLevel, oteShortBottomLevel, eng2DealBroken, showDealingOte)
    eng2OteLongTopLine := eng2OteLongTopLineTmp
    eng2OteLongBottomLine := eng2OteLongBottomLineTmp
    eng2OteLongFill := eng2OteLongFillTmp
    eng2OteShortTopLine := eng2OteShortTopLineTmp
    eng2OteShortBottomLine := eng2OteShortBottomLineTmp
    eng2OteShortFill := eng2OteShortFillTmp

    eng2RiskLongEntryLine := f_eng2_syncRiskLevelLine(eng2RiskLongEntryLine, riskLongEntryLevel, color.new(bullColor, 0), 2, showLongRiskVisual)
    eng2RiskShortEntryLine := f_eng2_syncRiskLevelLine(eng2RiskShortEntryLine, riskShortEntryLevel, color.new(bearColor, 0), 2, showShortRiskVisual)
    eng2RiskLongStopLine := f_eng2_syncRiskLevelLine(eng2RiskLongStopLine, riskBullStopLevel, color.new(bearColor, 0), 1, showLongRiskVisual)
    eng2RiskShortStopLine := f_eng2_syncRiskLevelLine(eng2RiskShortStopLine, riskBearStopLevel, color.new(bullColor, 0), 1, showShortRiskVisual)
    eng2RiskLongTargetLine := f_eng2_syncRiskLevelLine(eng2RiskLongTargetLine, riskLongTargetLevel, color.new(liqHighColor, 0), 1, showLongRiskVisual)
    eng2RiskShortTargetLine := f_eng2_syncRiskLevelLine(eng2RiskShortTargetLine, riskShortTargetLevel, color.new(liqLowColor, 0), 1, showShortRiskVisual)

    // Right-edge labels
    float bslLabelLevel = showDealingRangeVisual ? dealingRangeHighLevel : eqHighLevel
    float sslLabelLevel = showDealingRangeVisual ? dealingRangeLowLevel : eqLowLevel
    bool dealingBslOverlapsCalendar = f_levelsClose(bslLabelLevel, pdhLevel, rightEdgeLabelTolerance) or f_levelsClose(bslLabelLevel, pwhLevel, rightEdgeLabelTolerance) or f_levelsClose(bslLabelLevel, pmhLevel, rightEdgeLabelTolerance)
    bool dealingSslOverlapsCalendar = f_levelsClose(sslLabelLevel, pdlLevel, rightEdgeLabelTolerance) or f_levelsClose(sslLabelLevel, pwlLevel, rightEdgeLabelTolerance) or f_levelsClose(sslLabelLevel, pmlLevel, rightEdgeLabelTolerance)
    bool showDealingBslLabel = draw_show_right_labels and showDealingRangeVisual and not dealingBslOverlapsCalendar
    bool showDealingSslLabel = draw_show_right_labels and showDealingRangeVisual and not dealingSslOverlapsCalendar
    bool showExecBslLabel = showEqHighRightLabel and not showDealingRangeVisual
    bool showExecSslLabel = showEqLowRightLabel and not showDealingRangeVisual
    eqHighLabel := f_eng2_syncRightLevelLabel(eqHighLabel, bslLabelLevel, showDealingRangeVisual ? f_rangeLiquidityLabel(true) : eng1_exe_eqh_active ? "EQH" : "BSL", color.new(liqHighColor, 12), showDealingBslLabel or showExecBslLabel)
    eqLowLabel := f_eng2_syncRightLevelLabel(eqLowLabel, sslLabelLevel, showDealingRangeVisual ? f_rangeLiquidityLabel(false) : eng1_exe_eql_active ? "EQL" : "SSL", color.new(liqLowColor, 12), showDealingSslLabel or showExecSslLabel)
    eng2DealEqLabel := f_eng2_syncRightLevelLabel(eng2DealEqLabel, dealingRangeEqLevel, "EQ", color.new(decisionEqColor, 0), draw_show_right_labels and showDealingRangeVisual)
    pdhLabel := f_eng2_syncRightLevelLabel(pdhLabel, pdhLevel, "PDH", color.new(liqHighColor, 10), draw_show_right_labels and showPdhVisual)
    pdlLabel := f_eng2_syncRightLevelLabel(pdlLabel, pdlLevel, "PDL", color.new(liqLowColor, 10), draw_show_right_labels and showPdlVisual)
    pwhLabel := f_eng2_syncRightLevelLabel(pwhLabel, pwhLevel, "PWH", color.new(color.fuchsia, 15), draw_show_right_labels and showPwhVisual)
    pwlLabel := f_eng2_syncRightLevelLabel(pwlLabel, pwlLevel, "PWL", color.new(color.fuchsia, 15), draw_show_right_labels and showPwlVisual)
    pmhLabel := f_eng2_syncRightLevelLabel(pmhLabel, pmhLevel, "PMH", color.new(color.silver, 35), draw_show_right_labels and showPmhVisual)
    pmlLabel := f_eng2_syncRightLevelLabel(pmlLabel, pmlLevel, "PML", color.new(color.silver, 35), draw_show_right_labels and showPmlVisual)
    longStopLabel := f_eng2_syncRightLevelLabel(longStopLabel, riskBullStopLevel, "SL L", color.new(bearColor, 0), showLongStopRightLabel)
    shortStopLabel := f_eng2_syncRightLevelLabel(shortStopLabel, riskBearStopLevel, "SL S", color.new(bullColor, 0), showShortStopRightLabel)

// Bias tint should follow the MTF narrative chain: Narrative -> Context -> Execution.
int backdropBias = displayNarrBias != 0 ? displayNarrBias : (eng1CtxRangeReady and displayCtxBias != 0 ? displayCtxBias : displayExecBias)
color backdropColor = backdropBias == 1 ? bullColor : backdropBias == -1 ? bearColor : neutralColor
// Keep bias tint subtle so it doesn't overpower zones/candles.
int backdropAlpha = backdropBias == 0 ? 95 : 92
chartBackdrop = showTrendBackground and not compactMode ? color.new(backdropColor, backdropAlpha) : na
bgcolor(chartBackdrop)

f_eng4_render_dashboard() =>
    bool showFull = barstate.islast and showDashboard and not compactDashboardMode
    bool showCompact = barstate.islast and showDashboard and compactDashboardMode
    bool clearDash = barstate.islast and not showDashboard
    if showFull or showCompact
        bool compactBalanced = preferredDirection == "Balanced"
        bool compactWaiting = preferredDirection == "Wait"
        bool compactNeutral = compactBalanced or compactWaiting
        bool useLongSide = compactUseLong
        string executionState = useLongSide ? longExecutionState : shortExecutionState
        float entryLevel = useLongSide ? tradeLongEntry : tradeShortEntry
        float stopLevel = useLongSide ? tradeLongStop : tradeShortStop
        float targetLevel = useLongSide ? activeLongTarget : activeShortTarget
        bool longRetired = longCompleted or longInvalidated or (not longAmbiguous and f_eng4_retired_state(longExecutionState, longSetupAge, longPoiMitigatedLatched, expiryBarsEffective))
        bool shortRetired = shortCompleted or shortInvalidated or (not shortAmbiguous and f_eng4_retired_state(shortExecutionState, shortSetupAge, shortPoiMitigatedLatched, expiryBarsEffective))
        bool retiredState = useLongSide ? longRetired : shortRetired
        color accentColor = compactNeutral ? color.new(neutralColor, 12) : useLongSide ? color.new(bullColor, 12) : color.new(bearColor, 12)
        bool waitBuySide = displayCtxBias == -1 or (displayCtxBias == 0 and displayNarrBias == -1)
        string waitName = waitBuySide ? (eng1_exe_eqh_active ? "EQH" : "BSL") : (eng1_exe_eql_active ? "EQL" : "SSL")
        float waitLevel = waitBuySide ? eng1_exe_liq_high : eng1_exe_liq_low
        bool poiUseLong = useLongSide
        if compactWaiting
            if poi_long_contract_valid and not poi_short_contract_valid
                poiUseLong := true
            else if poi_short_contract_valid and not poi_long_contract_valid
                poiUseLong := false
            else
                poiUseLong := not waitBuySide
        bool poiValid = poiUseLong ? poi_long_contract_valid : poi_short_contract_valid
        string poiType = poiUseLong ? poi_long_type : poi_short_type
        float poiEntry = poiUseLong ? poi_long_entry : poi_short_entry
        string poiLifecycle = poiUseLong ? longPoiLifecycle : shortPoiLifecycle
        bool poiRetired = poiUseLong ? longRetired : shortRetired
        bool poiActive = poiValid and not poiRetired
        bool sweepOk = poiUseLong ? eng3LongSweepPass : eng3ShortSweepPass
        bool mssOk = poiUseLong ? eng3LongMssPass : eng3ShortMssPass
        bool dispOk = poiUseLong ? eng3LongDisplacementPass : eng3ShortDisplacementPass
        string signalGrade = poiUseLong ? longSignalGrade : shortSignalGrade
        string gradeSuffix = signalGrade == "Invalid" ? "" : " | " + signalGrade
        string biasText = (eng2InternalTrend != 0 and eng2SwingTrend != 0 and eng2InternalTrend == eng2SwingTrend ? "Aligned " + (eng2InternalTrend == 1 ? "Bullish" : "Bearish") : eng2InternalTrend != 0 and eng2SwingTrend != 0 ? "Mixed" : "Building") + " | MTF " + f_biasShort(displayNarrBias) + "/" + f_biasShort(displayCtxBias) + "/" + f_biasShort(displayExecBias)
        string sessionText = liquiditySessionSummary + " | " + timezoneSummary + " | " + (strictModeEnabled ? "Strict " + ipdaWindowSummary : "Normal")
        string nextLongText = strictModeEnabled ? f_ipdaNextActionText(not na(tradeLongEntry), longExecutionState, effectiveLongDirectional, effectiveLongSweepSeen, effectiveLongMssSeen, effectiveLongDisplacementSeen, ipdaLongCyclePhase, true) : (not na(tradeLongEntry) ? f_entryActionText(longExecutionState) : "Wait OB/FVG long")
        string nextShortText = strictModeEnabled ? f_ipdaNextActionText(not na(tradeShortEntry), shortExecutionState, effectiveShortDirectional, effectiveShortSweepSeen, effectiveShortMssSeen, effectiveShortDisplacementSeen, ipdaShortCyclePhase, false) : (not na(tradeShortEntry) ? f_entryActionText(shortExecutionState) : "Wait OB/FVG short")
        string nextText = compactWaiting ? "Wait " + waitName + " " + f_formatLevel(waitLevel) : useLongSide ? nextLongText : nextShortText
        string pxText = syminfo.ticker + " " + timeframe.period + " | Px " + f_formatLevel(not na(eng3SignalClose) ? eng3SignalClose : close)
        string setupText = (compactWaiting ? "Wait " + waitName + " " + f_formatLevel(waitLevel) : compactBalanced ? "Both POI L " + f_formatLevel(tradeLongEntry) + " / S " + f_formatLevel(tradeShortEntry) : (useLongSide ? "Long " : "Short ") + executionState + " " + f_formatLevel(entryLevel)) + gradeSuffix
        string orderText = compactBalanced ? "Focus " + (useLongSide ? "Long" : "Short") + " | " + f_eng4_order_prices(entryLevel, stopLevel, targetLevel, retiredState) : f_eng4_order_prices(entryLevel, stopLevel, targetLevel, retiredState)
        string triggerText = not poiValid ? "No POI" : poiRetired ? "POI Retired" : (sweepOk ? "Sweep OK" : "Need Sweep") + " | " + (mssOk ? "MSS OK" : "Need MSS") + " | " + (dispOk ? "Disp OK" : "Need Disp")
        color setupBg = compactWaiting ? color.new(neutralColor, 18) : accentColor
        color orderBg = not na(entryLevel) and not retiredState ? accentColor : panelCellBg
        color nextBg = compactWaiting ? color.new(neutralColor, 18) : accentColor
        if showCompact
            table.clear(dashboard, 0, 0, 1, 10)
            table.clear(dashboardCompact, 0, 0, 1, 6)
            table.cell(dashboardCompact, 0, 0, "", text_color=color.new(color.white, 100), bgcolor=color.new(color.black, 100), text_size=size.tiny)
            table.cell(dashboardCompact, 1, 0, "", text_color=color.new(color.white, 100), bgcolor=color.new(color.black, 100), text_size=size.tiny)
            f_setCell(dashboardCompact, 0, 1, "TRADE", color.white, panelHeaderBg)
            f_setCell(dashboardCompact, 1, 1, pxText, color.white, accentColor)
            f_setCell(dashboardCompact, 0, 2, "Setup", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 2, setupText, color.white, setupBg)
            f_setCell(dashboardCompact, 0, 3, "Bias", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 3, biasText, color.white, panelCellBg)
            f_setCell(dashboardCompact, 0, 4, "POI", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 4, f_eng4_poi_text(poiValid, poiUseLong, poiType, poiEntry, poiLifecycle, poiRetired), color.white, poiActive ? accentColor : panelCellBg)
            f_setCell(dashboardCompact, 0, 5, "Order", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 5, orderText, color.white, orderBg)
            f_setCell(dashboardCompact, 0, 6, "Next", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 6, nextText, color.white, nextBg)
        else
            table.clear(dashboardCompact, 0, 0, 1, 6)
            table.clear(dashboard, 0, 0, 1, 10)
            table.cell(dashboard, 0, 0, "", text_color=color.new(color.white, 100), bgcolor=color.new(color.black, 100), text_size=size.tiny)
            table.cell(dashboard, 1, 0, "", text_color=color.new(color.white, 100), bgcolor=color.new(color.black, 100), text_size=size.tiny)
            f_setCell(dashboard, 0, 1, "TRADE MAP", color.white, panelHeaderBg)
            f_setCell(dashboard, 1, 1, pxText, color.white, accentColor)
            f_setCell(dashboard, 0, 2, "Setup", color.white, panelCellBg)
            f_setCell(dashboard, 1, 2, setupText, color.white, setupBg)
            f_setCell(dashboard, 0, 3, "Bias", color.white, panelCellBg)
            f_setCell(dashboard, 1, 3, biasText, color.white, eng2InternalTrend != 0 and eng2SwingTrend != 0 and eng2InternalTrend == eng2SwingTrend ? accentColor : color.new(neutralColor, 18))
            f_setCell(dashboard, 0, 4, "Liquidity", color.white, panelCellBg)
            f_setCell(dashboard, 1, 4, (eng1_exe_eqh_active ? "EQH " : "BSL ") + f_formatLevel(eng1_exe_liq_high) + " | " + (eng1_exe_eql_active ? "EQL " : "SSL ") + f_formatLevel(eng1_exe_liq_low), color.white, panelCellBg)
            f_setCell(dashboard, 0, 5, "POI", color.white, panelCellBg)
            f_setCell(dashboard, 1, 5, f_eng4_poi_text(poiValid, poiUseLong, poiType, poiEntry, poiLifecycle, poiRetired), color.white, poiActive ? accentColor : panelCellBg)
            f_setCell(dashboard, 0, 6, "Order", color.white, panelCellBg)
            f_setCell(dashboard, 1, 6, orderText, color.white, orderBg)
            f_setCell(dashboard, 0, 7, "Trigger", color.white, panelCellBg)
            f_setCell(dashboard, 1, 7, triggerText, color.white, (poiActive and sweepOk and mssOk and dispOk) ? accentColor : panelCellBg)
            f_setCell(dashboard, 0, 8, "Timing", color.white, panelCellBg)
            f_setCell(dashboard, 1, 8, sessionText, color.white, color.new(strictModeEnabled ? color.teal : neutralColor, 15))
            f_setCell(dashboard, 0, 9, "Next", color.white, panelCellBg)
            f_setCell(dashboard, 1, 9, nextText, color.white, nextBg)
    else if clearDash
        table.clear(dashboardCompact, 0, 0, 1, 6)
        table.clear(dashboard, 0, 0, 1, 10)
    true

//------------------------------------------------------------------------------
// ENGINE 4 (DASHBOARD SNAPSHOT)
// MAIN_CONTRACT order 9: render dashboard from snapshots only.
// Keep table rendering dumb: rows read these snapshots instead of rebuilding
// engine logic inline. This follows MAIN_CONTRACT and makes future pruning safer.
//------------------------------------------------------------------------------
f_eng4_render_dashboard()
