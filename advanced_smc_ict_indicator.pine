freshBarsEffective = f_timeNormalizedBars(setupFreshBars, normalizationBaselineTfSeconds, chartTfSeconds, 2)
expiryBarsEffective = f_timeNormalizedBars(setupExpiryBars, normalizationBaselineTfSeconds, chartTfSeconds, 4)
strictMssLookbackEffective = f_timeNormalizedBars(strictMssLookback, normalizationBaselineTfSeconds, chartTfSeconds, 2)
var label eng1InvalidTfLabel = na
if not eng1_exec_valid
    f_draw_cleanup_hidden_objects()
    if barstate.islast
        string msg = "SMC/ICT: Unsupported chart TF " + chartTfLabel + ". Use M1, M5, M15, or M30."
        float y = high + atr * 0.8
        int x = bar_index + 1
        if na(eng1InvalidTfLabel)
            eng1InvalidTfLabel := label.new(x=x, y=y, xloc=xloc.bar_index, yloc=yloc.price, text=msg, style=label.style_label_left, color=color.new(color.black, 0), textcolor=color.white, size=size.small)
        else
            label.set_x(eng1InvalidTfLabel, x)
            label.set_y(eng1InvalidTfLabel, y)
            label.set_text(eng1InvalidTfLabel, msg)
            label.set_style(eng1InvalidTfLabel, label.style_label_left)
            label.set_color(eng1InvalidTfLabel, color.new(color.black, 0))
            label.set_textcolor(eng1InvalidTfLabel, color.white)
            label.set_size(eng1InvalidTfLabel, size.small)
else if not na(eng1InvalidTfLabel)
    label.delete(eng1InvalidTfLabel)
    eng1InvalidTfLabel := na

f_eng2_syncSetupZoneVisual(box currentBox, line currentLine, label currentLabel, bool enabled, int createdBar, float zoneTop, float zoneBottom, float zoneEntry, string labelText, string labelStyle, color borderColor, color fillColor, int borderWidth, bool showEntryLine, string executionState) =>
    box nextBox = currentBox
    line nextLine = currentLine
    label nextLabel = currentLabel
    if enabled and not na(zoneTop) and not na(zoneBottom)
        int leftBar = f_safeBarIndexX(not na(createdBar) ? createdBar : bar_index)
        if na(nextBox)
            nextBox := box.new(left=leftBar, top=zoneTop, right=bar_index, bottom=zoneBottom, xloc=xloc.bar_index, extend=extend.none, bgcolor=fillColor, border_color=borderColor)
        else
            box.set_left(nextBox, leftBar)
            box.set_right(nextBox, bar_index)
            box.set_top(nextBox, zoneTop)
            box.set_bottom(nextBox, zoneBottom)
            box.set_bgcolor(nextBox, fillColor)
            box.set_border_color(nextBox, borderColor)
        box.set_border_width(nextBox, borderWidth)
        if showEntryLine and not na(zoneEntry)
            if na(nextLine)
                nextLine := line.new(x1=leftBar, y1=zoneEntry, x2=bar_index, y2=zoneEntry, xloc=xloc.bar_index, extend=extend.none, color=borderColor, width=f_executionSelectedLineWidth(executionState), style=line.style_dotted)
            else
                line.set_x1(nextLine, leftBar)
                line.set_x2(nextLine, bar_index)
                line.set_y1(nextLine, zoneEntry)
                line.set_y2(nextLine, zoneEntry)
                line.set_extend(nextLine, extend.none)
                line.set_color(nextLine, borderColor)
                line.set_width(nextLine, f_executionSelectedLineWidth(executionState))
                line.set_style(nextLine, line.style_dotted)
        else if not na(nextLine)
            line.delete(nextLine)
            nextLine := na
        if labelText != ""
            if na(nextLabel)
                nextLabel := label.new(x=bar_index, y=f_zoneMid(zoneTop, zoneBottom), xloc=xloc.bar_index, text=labelText, style=labelStyle, color=color.new(borderColor, 0), textcolor=color.white, size=size.tiny)
            else
                label.set_x(nextLabel, bar_index)
                label.set_y(nextLabel, f_zoneMid(zoneTop, zoneBottom))
                label.set_text(nextLabel, labelText)
                label.set_style(nextLabel, labelStyle)
                label.set_color(nextLabel, color.new(borderColor, 0))
                label.set_textcolor(nextLabel, color.white)
                label.set_size(nextLabel, size.tiny)
        else if not na(nextLabel)
            label.delete(nextLabel)
            nextLabel := na
    else
        if not na(nextBox)
            box.delete(nextBox)
            nextBox := na
        if not na(nextLine)
            line.delete(nextLine)
            nextLine := na
        if not na(nextLabel)
            label.delete(nextLabel)
            nextLabel := na
    [nextBox, nextLine, nextLabel]

f_draw_zone_box(box bx, label lb, float top, float bottom, string zoneType, bool isBull, bool selected, bool terminal) =>
    bool enabled = not terminal and f_draw_zone_visible(draw_mode, selected, isBull, "Wait")
    string labelText = zoneType
    string labelStyle = isBull ? label.style_label_right : label.style_label_left
    color borderColor = isBull ? color.new(bullColor, 20) : color.new(bearColor, 20)
    color fillColor = isBull ? color.new(bullColor, 88) : color.new(bearColor, 88)
    int borderWidth = selected ? 2 : 1
    [nextBox, _, nextLabel] = f_eng2_syncSetupZoneVisual(bx, na, lb, enabled, bar_index, top, bottom, na, labelText, labelStyle, borderColor, fillColor, borderWidth, false, terminal ? "Completed" : "Waiting")
    [nextBox, nextLabel]

f_eng2_syncHistoryZoneBox(box currentBox, bool enabled, int leftBar, int rightBar, float zoneTop, float zoneBottom, color borderColor, color fillColor, int borderWidth) =>
    box nextBox = currentBox
    if enabled and not na(leftBar) and not na(rightBar) and not na(zoneTop) and not na(zoneBottom)
        int safeLeftBar = f_safeBarIndexX(leftBar)
        int safeRightBar = f_safeBarIndexX(f_eng2_active_right_bar(rightBar))
        if na(nextBox)
            nextBox := box.new(left=safeLeftBar, top=zoneTop, right=safeRightBar, bottom=zoneBottom, xloc=xloc.bar_index, extend=extend.none, bgcolor=fillColor, border_color=borderColor)
        else
            box.set_left(nextBox, safeLeftBar)
            box.set_right(nextBox, safeRightBar)
            box.set_top(nextBox, zoneTop)
            box.set_bottom(nextBox, zoneBottom)
            box.set_bgcolor(nextBox, fillColor)
            box.set_border_color(nextBox, borderColor)
        box.set_border_width(nextBox, borderWidth)
    else if not na(nextBox)
        box.delete(nextBox)
        nextBox := na
    nextBox

//------------------------------------------------------------------------------
// Session liquidity tracking
//------------------------------------------------------------------------------
inAsiaSession = f_inSessionWindow(asiaSessionWindow)
newAsiaSession = inAsiaSession and not inAsiaSession[1]
asiaSessionEnded = not inAsiaSession and inAsiaSession[1]
inLondonSession = f_inSessionWindow(londonSessionWindow)
newLondonSession = inLondonSession and not inLondonSession[1]
londonSessionEnded = not inLondonSession and inLondonSession[1]
inNyAmSession = f_inSessionWindow(nyAmSessionWindow)
inNyPmSession = f_inSessionWindow(nyPmSessionWindow)
newNyAmSession = inNyAmSession and not inNyAmSession[1]
nyAmSessionEnded = not inNyAmSession and inNyAmSession[1]
newNyPmSession = inNyPmSession and not inNyPmSession[1]
nyPmSessionEnded = not inNyPmSession and inNyPmSession[1]

var float asiaSessionHigh = na
var float asiaSessionLow = na
var float londonSessionHigh = na
var float londonSessionLow = na
var float newYorkAmSessionHigh = na
var float newYorkAmSessionLow = na
var float newYorkPmSessionHigh = na
var float newYorkPmSessionLow = na

[asiaSessionHighNext, asiaSessionLowNext] = f_updateSessionRange(inAsiaSession, newAsiaSession, asiaSessionHigh, asiaSessionLow)
[londonSessionHighNext, londonSessionLowNext] = f_updateSessionRange(inLondonSession, newLondonSession, londonSessionHigh, londonSessionLow)
[newYorkAmSessionHighNext, newYorkAmSessionLowNext] = f_updateSessionRange(inNyAmSession, newNyAmSession, newYorkAmSessionHigh, newYorkAmSessionLow)
[newYorkPmSessionHighNext, newYorkPmSessionLowNext] = f_updateSessionRange(inNyPmSession, newNyPmSession, newYorkPmSessionHigh, newYorkPmSessionLow)
asiaSessionHigh := asiaSessionHighNext
asiaSessionLow := asiaSessionLowNext
londonSessionHigh := londonSessionHighNext
londonSessionLow := londonSessionLowNext
newYorkAmSessionHigh := newYorkAmSessionHighNext
newYorkAmSessionLow := newYorkAmSessionLowNext
newYorkPmSessionHigh := newYorkPmSessionHighNext
newYorkPmSessionLow := newYorkPmSessionLowNext

string currentSessionBlock = inNyPmSession ? "New York PM" : inNyAmSession ? "New York AM" : inLondonSession ? "London" : inAsiaSession ? "Asia" : "Inter-session"
string liquiditySessionLabel = inNyPmSession ? "New York AM" : inNyAmSession ? "London" : inLondonSession ? "Asia" : "New York Composite"

//------------------------------------------------------------------------------
// Session range visuals
//------------------------------------------------------------------------------
bool sessionVisualsEnabled = draw_show_sessions

if not sessionVisualsEnabled
    f_trimSessionVisuals(0)
    activeAsiaSessionBox := na
    activeAsiaSessionLabel := na
    activeAsiaSessionHighLine := na
    activeAsiaSessionLowLine := na
    activeAsiaSessionStartBar := na
    activeLondonSessionBox := na
    activeLondonSessionLabel := na
    activeLondonSessionHighLine := na
    activeLondonSessionLowLine := na
    activeLondonSessionStartBar := na
    activeNewYorkSessionBox := na
    activeNewYorkSessionLabel := na
    activeNewYorkSessionHighLine := na
    activeNewYorkSessionLowLine := na
    activeNewYorkSessionStartBar := na
    activeNewYorkPmSessionBox := na
    activeNewYorkPmSessionLabel := na
    activeNewYorkPmSessionHighLine := na
    activeNewYorkPmSessionLowLine := na
    activeNewYorkPmSessionStartBar := na

[activeAsiaSessionBoxTmp, activeAsiaSessionLabelTmp, activeAsiaSessionHighLineTmp, activeAsiaSessionLowLineTmp, activeAsiaSessionStartBarTmp] = f_draw_session_box(sessionVisualsEnabled, inAsiaSession, newAsiaSession, asiaSessionEnded, activeAsiaSessionBox, activeAsiaSessionLabel, activeAsiaSessionHighLine, activeAsiaSessionLowLine, activeAsiaSessionStartBar, "Asia", asiaSessionHigh, asiaSessionLow)
activeAsiaSessionBox := activeAsiaSessionBoxTmp
activeAsiaSessionLabel := activeAsiaSessionLabelTmp
activeAsiaSessionHighLine := activeAsiaSessionHighLineTmp
activeAsiaSessionLowLine := activeAsiaSessionLowLineTmp
activeAsiaSessionStartBar := activeAsiaSessionStartBarTmp

[activeLondonSessionBoxTmp, activeLondonSessionLabelTmp, activeLondonSessionHighLineTmp, activeLondonSessionLowLineTmp, activeLondonSessionStartBarTmp] = f_draw_session_box(sessionVisualsEnabled, inLondonSession, newLondonSession, londonSessionEnded, activeLondonSessionBox, activeLondonSessionLabel, activeLondonSessionHighLine, activeLondonSessionLowLine, activeLondonSessionStartBar, "London", londonSessionHigh, londonSessionLow)
activeLondonSessionBox := activeLondonSessionBoxTmp
activeLondonSessionLabel := activeLondonSessionLabelTmp
activeLondonSessionHighLine := activeLondonSessionHighLineTmp
activeLondonSessionLowLine := activeLondonSessionLowLineTmp
activeLondonSessionStartBar := activeLondonSessionStartBarTmp

[activeNewYorkSessionBoxTmp, activeNewYorkSessionLabelTmp, activeNewYorkSessionHighLineTmp, activeNewYorkSessionLowLineTmp, activeNewYorkSessionStartBarTmp] = f_draw_session_box(sessionVisualsEnabled, inNyAmSession, newNyAmSession, nyAmSessionEnded, activeNewYorkSessionBox, activeNewYorkSessionLabel, activeNewYorkSessionHighLine, activeNewYorkSessionLowLine, activeNewYorkSessionStartBar, "New York AM", newYorkAmSessionHigh, newYorkAmSessionLow)
activeNewYorkSessionBox := activeNewYorkSessionBoxTmp
activeNewYorkSessionLabel := activeNewYorkSessionLabelTmp
activeNewYorkSessionHighLine := activeNewYorkSessionHighLineTmp
activeNewYorkSessionLowLine := activeNewYorkSessionLowLineTmp
activeNewYorkSessionStartBar := activeNewYorkSessionStartBarTmp

[activeNewYorkPmSessionBoxTmp, activeNewYorkPmSessionLabelTmp, activeNewYorkPmSessionHighLineTmp, activeNewYorkPmSessionLowLineTmp, activeNewYorkPmSessionStartBarTmp] = f_draw_session_box(sessionVisualsEnabled, inNyPmSession, newNyPmSession, nyPmSessionEnded, activeNewYorkPmSessionBox, activeNewYorkPmSessionLabel, activeNewYorkPmSessionHighLine, activeNewYorkPmSessionLowLine, activeNewYorkPmSessionStartBar, "New York PM", newYorkPmSessionHigh, newYorkPmSessionLow)
activeNewYorkPmSessionBox := activeNewYorkPmSessionBoxTmp
activeNewYorkPmSessionLabel := activeNewYorkPmSessionLabelTmp
activeNewYorkPmSessionHighLine := activeNewYorkPmSessionHighLineTmp
activeNewYorkPmSessionLowLine := activeNewYorkPmSessionLowLineTmp
activeNewYorkPmSessionStartBar := activeNewYorkPmSessionStartBarTmp

if barstate.islast and sessionVisualsEnabled and array.size(sessionRangeBoxes) > 0
    for i = 0 to array.size(sessionRangeBoxes) - 1
        sessionBox = array.get(sessionRangeBoxes, i)
        sessionLabel = i < array.size(sessionRangeLabels) ? array.get(sessionRangeLabels, i) : na
        sessionName = i < array.size(sessionRangeNames) ? array.get(sessionRangeNames, i) : "Session"
        sessionHighLine = i < array.size(sessionRangeHighLines) ? array.get(sessionRangeHighLines, i) : na
        sessionLowLine = i < array.size(sessionRangeLowLines) ? array.get(sessionRangeLowLines, i) : na
        fillColor = f_sessionFillColor(sessionName)
        borderColor = f_sessionBorderColor(sessionName)
        textColor = f_sessionTextColor(sessionName)
        highLineColor = f_sessionLineColor(sessionName, true)
        lowLineColor = f_sessionLineColor(sessionName, false)
        if not na(sessionBox)
            box.set_bgcolor(sessionBox, fillColor)
            box.set_border_color(sessionBox, borderColor)
            box.set_border_width(sessionBox, 1)
        if not na(sessionHighLine)
            line.set_color(sessionHighLine, highLineColor)
        if not na(sessionLowLine)
            line.set_color(sessionLowLine, lowLineColor)
        if not na(sessionLabel)
            label.set_text(sessionLabel, sessionName)
            label.set_textcolor(sessionLabel, textColor)
            label.set_style(sessionLabel, label.style_label_center)
            label.set_color(sessionLabel, color.new(color.black, 86))
            label.set_size(sessionLabel, size.small)

//------------------------------------------------------------------------------
// Execution liquidity (Engine 1 owned)
//------------------------------------------------------------------------------
float effectiveExecLiqHigh = eng1_exe_liq_high
float effectiveExecLiqLow = eng1_exe_liq_low
float effectiveExecEqHigh = eng1_exe_eqh_active ? eng1_exe_eqh : na
float effectiveExecEqLow = eng1_exe_eql_active ? eng1_exe_eql : na

plotshape(displaySweepMarkers and eng1_exe_bull_sweep, title="Sell-side liquidity sweep", style=shape.triangleup, location=location.belowbar, color=bullColor, size=size.tiny, text="")
plotshape(displaySweepMarkers and eng1_exe_bear_sweep, title="Buy-side liquidity sweep", style=shape.triangledown, location=location.abovebar, color=bearColor, size=size.tiny, text="")

//------------------------------------------------------------------------------
// Market structure labels (chart TF, pivot-confirmed)
// Note: Engine 1 intentionally does not output BOS/CHOCH history yet to stay lean.
// This renderer provides trader-facing HH/HL/LH/LL + BOS/MSS markers without
// coupling setup ownership to chart-local pivot markers.
//------------------------------------------------------------------------------
int eng2SwingLen = math.max(1, structureSwingLen * 3)
float eng2PivotHigh = ta.pivothigh(high, structureSwingLen, structureSwingLen)
float eng2PivotLow = ta.pivotlow(low, structureSwingLen, structureSwingLen)
float eng2SwingPivotHigh = ta.pivothigh(high, eng2SwingLen, eng2SwingLen)
float eng2SwingPivotLow = ta.pivotlow(low, eng2SwingLen, eng2SwingLen)

// Follow MAIN_CONTRACT: structure labels are Full-mode only and must stay under
// Engine 1 ownership, so unsupported execution TFs do not draw stale local state.
bool eng2StructureVisualsEnabled = eng1_exec_valid and draw_show_structure
// Keep the structure label queue reasonably small to avoid scattered clutter on the chart.
// This is intentionally lower than max_* limits to reduce "label/line carpet" in long sessions.
int eng2StructureLabelCap = 42
int eng2StructureLineCap = 54
float eng2StructTol = math.max(atr * equalToleranceAtr, syminfo.mintick * 2.0)
float eng2PivotLabelOffset = math.max(atr * 0.18, syminfo.mintick * 8.0)
f_draw_structure_markers(eng2StructureVisualsEnabled, eng2StructureLabelCap, eng2StructureLineCap)

// Make the toggle literal: when disabled, clear all structure visuals.
if not eng2StructureVisualsEnabled
    // Reset internal structure state so switching back to Full recomputes cleanly.
    eng2StructLastHigh := na
    eng2StructLastLow := na
    eng2StructHighBroken := false
    eng2StructLowBroken := false
    eng2InternalTrend := 0
    eng2InternalLastEventLevel := na
    eng2InternalLastEventBar := na
    eng2InternalLastEventText := ""
    eng2StructLastHighBar := na
    eng2StructLastLowBar := na
    // Swing event markers are Full-only, so reset their tracking when leaving Full.
    eng2SwingTrend := 0
    eng2SwingLastEventLevel := na
    eng2SwingLastEventBar := na
    eng2SwingLastEventText := ""
    // Swing state is Full-only: clear it aggressively to prevent silent overlap with Focused visuals.
    eng2SwingLastHigh := na
    eng2SwingLastLow := na
    eng2SwingHighBroken := false
    eng2SwingLowBroken := false
    eng2SwingLastHighBar := na
    eng2SwingLastLowBar := na
    array.clear(eng2SwingEventLevels)
    array.clear(eng2InternalEventLevels)

// Swing pivots (major structure). We don't label them by default to avoid clutter,
// but we do use them to gate major BOS/MSS and avoid internal spam.
if eng2StructureVisualsEnabled and not na(eng2SwingPivotHigh)
    int pivotBar = f_safeBarIndexX(bar_index - eng2SwingLen)
    bool isEq = not na(eng2SwingLastHigh) and math.abs(eng2SwingPivotHigh - eng2SwingLastHigh) <= eng2StructTol
    if not isEq or na(eng2SwingLastHigh)
        eng2SwingLastHigh := eng2SwingPivotHigh
        eng2SwingLastHighBar := pivotBar
        eng2SwingHighBroken := false

if eng2StructureVisualsEnabled and not na(eng2SwingPivotLow)
    int pivotBar = f_safeBarIndexX(bar_index - eng2SwingLen)
    bool isEq = not na(eng2SwingLastLow) and math.abs(eng2SwingPivotLow - eng2SwingLastLow) <= eng2StructTol
    if not isEq or na(eng2SwingLastLow)
        eng2SwingLastLow := eng2SwingPivotLow
        eng2SwingLastLowBar := pivotBar
        eng2SwingLowBroken := false

// Internal pivots (minor structure). These are the HH/HL/LH/LL labels traders expect.
if eng2StructureVisualsEnabled and not na(eng2PivotHigh)
    int pivotBar = f_safeBarIndexX(bar_index - structureSwingLen)
    bool isEq = not na(eng2StructLastHigh) and math.abs(eng2PivotHigh - eng2StructLastHigh) <= eng2StructTol
    string pivotTextRaw = na(eng2StructLastHigh) ? "H" : isEq ? "EQH" : eng2PivotHigh > eng2StructLastHigh ? "HH" : "LH"
    bool pivotLabelAllowed = pivotTextRaw == "HH" or pivotTextRaw == "LH"
    if pivotLabelAllowed
        color pivotTextColor = pivotTextRaw == "HH" ? bullColor : bearColor
        float pivotLabelY = eng2PivotHigh + eng2PivotLabelOffset
        label pivotLabel = label.new(x=pivotBar, y=pivotLabelY, xloc=xloc.bar_index, yloc=yloc.price, text=pivotTextRaw, style=label.style_none, color=color.new(color.black, 100), textcolor=pivotTextColor, size=size.tiny, textalign=text.align_center)
        f_pushLabel(eng2StructureLabels, pivotLabel, eng2StructureLabelCap)
    // Important: EQH should not reset the "broken" latch. Otherwise BOS/MSS can spam
    // the same horizontal level each time we see another equal pivot.
    if not isEq or na(eng2StructLastHigh)
        eng2StructLastHigh := eng2PivotHigh
        eng2StructLastHighBar := pivotBar
        eng2StructHighBroken := false

if eng2StructureVisualsEnabled and not na(eng2PivotLow)
    int pivotBar = f_safeBarIndexX(bar_index - structureSwingLen)
    bool isEq = not na(eng2StructLastLow) and math.abs(eng2PivotLow - eng2StructLastLow) <= eng2StructTol
    string pivotTextRaw = na(eng2StructLastLow) ? "L" : isEq ? "EQL" : eng2PivotLow < eng2StructLastLow ? "LL" : "HL"
    bool pivotLabelAllowed = pivotTextRaw == "LL" or pivotTextRaw == "HL"
    if pivotLabelAllowed
        color pivotTextColor = pivotTextRaw == "LL" ? bearColor : bullColor
        float pivotLabelY = eng2PivotLow - eng2PivotLabelOffset
        label pivotLabel = label.new(x=pivotBar, y=pivotLabelY, xloc=xloc.bar_index, yloc=yloc.price, text=pivotTextRaw, style=label.style_none, color=color.new(color.black, 100), textcolor=pivotTextColor, size=size.tiny, textalign=text.align_center)
        f_pushLabel(eng2StructureLabels, pivotLabel, eng2StructureLabelCap)
    if not isEq or na(eng2StructLastLow)
        eng2StructLastLow := eng2PivotLow
        eng2StructLastLowBar := pivotBar
        eng2StructLowBroken := false

// Break logic:
// - Internal breaks: BOS / CHoCH based on last internal trend.
// - Swing breaks: BOS / MSS based on last swing trend.
// This separation prevents silent overlap between minor and major structure.
// Important: evaluate crossover/crossunder on each bar for consistent historical behavior.
bool eng2SwingCrossUp = ta.crossover(close, eng2SwingLastHigh)
bool eng2SwingCrossDn = ta.crossunder(close, eng2SwingLastLow)
bool eng2InternalCrossUp = ta.crossover(close, eng2StructLastHigh)
bool eng2InternalCrossDn = ta.crossunder(close, eng2StructLastLow)

bool eng2SwingBreakUp = eng2StructureVisualsEnabled and not na(eng2SwingLastHigh) and eng2SwingCrossUp and not eng2SwingHighBroken
bool eng2SwingBreakDn = eng2StructureVisualsEnabled and not na(eng2SwingLastLow) and eng2SwingCrossDn and not eng2SwingLowBroken
bool eng2InternalBreakUp = eng2StructureVisualsEnabled and not na(eng2StructLastHigh) and eng2InternalCrossUp and not eng2StructHighBroken
bool eng2InternalBreakDn = eng2StructureVisualsEnabled and not na(eng2StructLastLow) and eng2InternalCrossDn and not eng2StructLowBroken

// Swing breaks first (major has priority).
if eng2SwingBreakUp
    bool isMss = eng2SwingTrend == -1
    string eventText = isMss ? "MSS" : "BOS"
    // Dedupe: don't stamp the same label on the same level multiple times.
    bool levelSeen = f_eng2_level_seen(eng2SwingEventLevels, eng2SwingLastHigh, eng2StructTol)
    bool allow = not levelSeen and (not f_levelsClose(eng2SwingLastEventLevel, eng2SwingLastHigh, eng2StructTol) or (bar_index - nz(eng2SwingLastEventBar, bar_index)) > eng2SwingLen or eng2SwingLastEventText != eventText)
    if allow
        int originBar = f_safeBarIndexX(nz(eng2SwingLastHighBar, bar_index))
        float labelOffset = eng2PivotLabelOffset * 0.35
        float labelY = eng2SwingLastHigh - labelOffset
        string eventLineStyle = isMss ? line.style_dashed : line.style_solid
        line eventLine = line.new(x1=originBar, y1=eng2SwingLastHigh, x2=bar_index, y2=eng2SwingLastHigh, xloc=xloc.bar_index, extend=extend.none, color=color.new(bullColor, 0), style=eventLineStyle, width=2)
        f_pushLine(eng2StructureLines, eventLine, eng2StructureLineCap)
        // Label is placed on the break bar (not midpoint) to match common ICT structure visuals.
        label eventLabel = label.new(x=bar_index, y=labelY, xloc=xloc.bar_index, yloc=yloc.price, text=eventText, style=label.style_none, color=color.new(color.black, 100), textcolor=color.new(bullColor, 0), size=size.small, textalign=text.align_center)
        f_pushLabel(eng2StructureLabels, eventLabel, eng2StructureLabelCap)
        eng2SwingLastEventLevel := eng2SwingLastHigh
        eng2SwingLastEventBar := bar_index
        eng2SwingLastEventText := eventText
        f_eng2_level_remember(eng2SwingEventLevels, eng2SwingLastHigh, eng2EventLevelCap)
    eng2SwingHighBroken := true
    eng2SwingTrend := 1
    // If internal and swing share the same broken level, keep internal latched too
    // so we don't print a second BOS/CHoCH later on a retest.
    if f_levelsClose(eng2SwingLastHigh, eng2StructLastHigh, eng2StructTol)
        eng2StructHighBroken := true
        eng2InternalTrend := 1

if eng2SwingBreakDn
    bool isMss = eng2SwingTrend == 1
    string eventText = isMss ? "MSS" : "BOS"
    bool levelSeen = f_eng2_level_seen(eng2SwingEventLevels, eng2SwingLastLow, eng2StructTol)
    bool allow = not levelSeen and (not f_levelsClose(eng2SwingLastEventLevel, eng2SwingLastLow, eng2StructTol) or (bar_index - nz(eng2SwingLastEventBar, bar_index)) > eng2SwingLen or eng2SwingLastEventText != eventText)
    if allow
        int originBar = f_safeBarIndexX(nz(eng2SwingLastLowBar, bar_index))
        float labelOffset = eng2PivotLabelOffset * 0.35
        float labelY = eng2SwingLastLow + labelOffset
        string eventLineStyle = isMss ? line.style_dashed : line.style_solid
        line eventLine = line.new(x1=originBar, y1=eng2SwingLastLow, x2=bar_index, y2=eng2SwingLastLow, xloc=xloc.bar_index, extend=extend.none, color=color.new(bearColor, 0), style=eventLineStyle, width=2)
        f_pushLine(eng2StructureLines, eventLine, eng2StructureLineCap)
        label eventLabel = label.new(x=bar_index, y=labelY, xloc=xloc.bar_index, yloc=yloc.price, text=eventText, style=label.style_none, color=color.new(color.black, 100), textcolor=color.new(bearColor, 0), size=size.small, textalign=text.align_center)
        f_pushLabel(eng2StructureLabels, eventLabel, eng2StructureLabelCap)
        eng2SwingLastEventLevel := eng2SwingLastLow
        eng2SwingLastEventBar := bar_index
        eng2SwingLastEventText := eventText
        f_eng2_level_remember(eng2SwingEventLevels, eng2SwingLastLow, eng2EventLevelCap)
    eng2SwingLowBroken := true
    eng2SwingTrend := -1
    if f_levelsClose(eng2SwingLastLow, eng2StructLastLow, eng2StructTol)
        eng2StructLowBroken := true
        eng2InternalTrend := -1

// Internal breaks (skip if swing break already stamped at same level on this bar).
bool eng2SkipInternalUp = eng2SwingBreakUp and f_levelsClose(eng2SwingLastHigh, eng2StructLastHigh, eng2StructTol)
bool eng2SkipInternalDn = eng2SwingBreakDn and f_levelsClose(eng2SwingLastLow, eng2StructLastLow, eng2StructTol)

if eng2InternalBreakUp and not eng2SkipInternalUp
    bool isMss = eng2InternalTrend == -1
    string eventText = isMss ? "CHoCH" : "BOS"
    bool levelSeen = f_eng2_level_seen(eng2InternalEventLevels, eng2StructLastHigh, eng2StructTol)
    bool allow = not levelSeen and (not f_levelsClose(eng2InternalLastEventLevel, eng2StructLastHigh, eng2StructTol) or (bar_index - nz(eng2InternalLastEventBar, bar_index)) > structureSwingLen or eng2InternalLastEventText != eventText)
    if allow
        int originBar = f_safeBarIndexX(nz(eng2StructLastHighBar, bar_index))
        float labelOffset = eng2PivotLabelOffset * 0.35
        float labelY = eng2StructLastHigh - labelOffset
        color lineColor = color.new(bullColor, isMss ? 0 : 15)
        string eventLineStyle = isMss ? line.style_dashed : line.style_solid
        line eventLine = line.new(x1=originBar, y1=eng2StructLastHigh, x2=bar_index, y2=eng2StructLastHigh, xloc=xloc.bar_index, extend=extend.none, color=lineColor, style=eventLineStyle, width=1)
        f_pushLine(eng2StructureLines, eventLine, eng2StructureLineCap)
        label eventLabel = label.new(x=bar_index, y=labelY, xloc=xloc.bar_index, yloc=yloc.price, text=eventText, style=label.style_none, color=color.new(color.black, 100), textcolor=lineColor, size=size.tiny, textalign=text.align_center)
        f_pushLabel(eng2StructureLabels, eventLabel, eng2StructureLabelCap)
        eng2InternalLastEventLevel := eng2StructLastHigh
        eng2InternalLastEventBar := bar_index
        eng2InternalLastEventText := eventText
        f_eng2_level_remember(eng2InternalEventLevels, eng2StructLastHigh, eng2EventLevelCap)
    eng2StructHighBroken := true
    eng2InternalTrend := 1

if eng2InternalBreakDn and not eng2SkipInternalDn
    bool isMss = eng2InternalTrend == 1
    string eventText = isMss ? "CHoCH" : "BOS"
    bool levelSeen = f_eng2_level_seen(eng2InternalEventLevels, eng2StructLastLow, eng2StructTol)
    bool allow = not levelSeen and (not f_levelsClose(eng2InternalLastEventLevel, eng2StructLastLow, eng2StructTol) or (bar_index - nz(eng2InternalLastEventBar, bar_index)) > structureSwingLen or eng2InternalLastEventText != eventText)
    if allow
        int originBar = f_safeBarIndexX(nz(eng2StructLastLowBar, bar_index))
        float labelOffset = eng2PivotLabelOffset * 0.35
        float labelY = eng2StructLastLow + labelOffset
        color lineColor = color.new(bearColor, isMss ? 0 : 15)
        string eventLineStyle = isMss ? line.style_dashed : line.style_solid
        line eventLine = line.new(x1=originBar, y1=eng2StructLastLow, x2=bar_index, y2=eng2StructLastLow, xloc=xloc.bar_index, extend=extend.none, color=lineColor, style=eventLineStyle, width=1)
        f_pushLine(eng2StructureLines, eventLine, eng2StructureLineCap)
        label eventLabel = label.new(x=bar_index, y=labelY, xloc=xloc.bar_index, yloc=yloc.price, text=eventText, style=label.style_none, color=color.new(color.black, 100), textcolor=lineColor, size=size.tiny, textalign=text.align_center)
        f_pushLabel(eng2StructureLabels, eventLabel, eng2StructureLabelCap)
        eng2InternalLastEventLevel := eng2StructLastLow
        eng2InternalLastEventBar := bar_index
        eng2InternalLastEventText := eventText
        f_eng2_level_remember(eng2InternalEventLevels, eng2StructLastLow, eng2EventLevelCap)
    eng2StructLowBroken := true
    eng2InternalTrend := -1

//------------------------------------------------------------------------------
// Higher timeframe structure context (Engine 1 owned)
//------------------------------------------------------------------------------

int displayExecBias = f_eng1_select_execution_trend_bias(eng1_exec_tf)
int displayCtxBias = eng1_ctx_trend_bias
int displayNarrBias = eng1_narr_bias

bool eng1CtxRangeReady = eng1_exec_valid and not na(eng1_ctx_liq_high) and not na(eng1_ctx_liq_low) and eng1_ctx_liq_high > eng1_ctx_liq_low
float eng1CtxRangeHigh = eng1CtxRangeReady ? eng1_ctx_liq_high : na
float eng1CtxRangeLow = eng1CtxRangeReady ? eng1_ctx_liq_low : na
float eng1CtxRangeSize = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeLow : na
float eng1CtxEquilibrium = eng1CtxRangeReady ? (eng1CtxRangeHigh + eng1CtxRangeLow) * 0.5 : na
float eng1CtxOteLongTop = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeSize * 0.62 : na
float eng1CtxOteLongBottom = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeSize * 0.79 : na
float eng1CtxOteShortTop = eng1CtxRangeReady ? eng1CtxRangeLow + eng1CtxRangeSize * 0.79 : na
float eng1CtxOteShortBottom = eng1CtxRangeReady ? eng1CtxRangeLow + eng1CtxRangeSize * 0.62 : na

// Dealing Range (location layer): derived from Engine 1 context snapshot so it stays aligned with MTF ownership.
int eng2DealHighBarChart = f_timeToChartBar(eng1_ctx_liq_high_bar)
int eng2DealLowBarChart = f_timeToChartBar(eng1_ctx_liq_low_bar)
float eng2DealHighCandidate = eng1CtxRangeReady ? eng1CtxRangeHigh : na
float eng2DealLowCandidate = eng1CtxRangeReady ? eng1CtxRangeLow : na
bool eng2DealRangeChanged = eng1CtxRangeReady and (na(eng2DealHigh) or na(eng2DealLow) or not f_levelsClose(eng2DealHigh, eng2DealHighCandidate, eng2StructTol) or not f_levelsClose(eng2DealLow, eng2DealLowCandidate, eng2StructTol))
bool eng2DealMappedBarsReady = not na(eng2DealHighBarChart) and not na(eng2DealLowBarChart)
int eng2DealLeftCandidate = eng2DealMappedBarsReady ? math.min(eng2DealHighBarChart, eng2DealLowBarChart) : na
bool eng2DealReady = eng1CtxRangeReady and not na(eng2DealLeftCandidate) and not na(eng2DealHighCandidate) and not na(eng2DealLowCandidate) and eng2DealHighCandidate > eng2DealLowCandidate
float eng2DealSizeCandidate = eng2DealReady ? (eng2DealHighCandidate - eng2DealLowCandidate) : na
bool eng2DealSignificant = eng2DealReady and not na(eng2DealSizeCandidate) and eng2DealSizeCandidate >= atr * 0.75
bool eng2DealChanged = eng2DealSignificant and (eng2DealRangeChanged or eng2DealLeftBar != eng2DealLeftCandidate)
if not eng2DealSignificant
    eng2DealHigh := na
    eng2DealLow := na
    eng2DealLeftBar := na
    eng2DealBroken := false
else
    if eng2DealChanged
        eng2DealHigh := eng2DealHighCandidate
        eng2DealLow := eng2DealLowCandidate
        eng2DealLeftBar := eng2DealLeftCandidate
        eng2DealBroken := false
    if not eng2DealBroken and not na(eng2DealHigh) and not na(eng2DealLow) and (close > eng2DealHigh or close < eng2DealLow)
        eng2DealBroken := true

int ipdaNyDay = dayofmonth(time, ipdaTimeTimezone)
bool ipdaNyNewDay = bar_index > 0 and ipdaNyDay != ipdaNyDay[1]
int ipdaNyMonth = month(time, ipdaTimeTimezone)
int ipdaQuarter = ipdaNyMonth <= 3 ? 1 : ipdaNyMonth <= 6 ? 2 : ipdaNyMonth <= 9 ? 3 : 4
var bool ipdaAmTargetReached = false
if ipdaNyNewDay
    ipdaAmTargetReached := false

bool ipdaObservationActive = f_inIpdaWindow(ipdaObservationSession)
bool ipdaAmKillzoneActive = f_inIpdaWindow(ipdaAmKillzoneSession)
bool ipdaPmKillzoneActive = f_inIpdaWindow(ipdaPmKillzoneSession)
bool ipdaPmReversalContext = eng1_ctx_bull_reversal or eng1_ctx_bear_reversal or (displayExecBias != 0 and displayCtxBias != 0 and displayExecBias != displayCtxBias)
bool ipdaPmTradeAllowed = ipdaPmKillzoneActive and (not ipdaAmTargetReached or ipdaPmReversalContext)
bool strictKillzoneActive = ipdaAmKillzoneActive or ipdaPmTradeAllowed
string ipdaWindowSummary = ipdaAmKillzoneActive ? "AM KZ" : ipdaPmKillzoneActive ? (ipdaPmTradeAllowed ? "PM KZ" : "PM blk") : ipdaObservationActive ? "Observe" : "Off"
liquiditySessionSummary = "Sess " + f_sessionCode(currentSessionBlock) + ">" + f_sessionCode(liquiditySessionLabel)
timezoneSummary = "NY/UTC"
float effectiveProtectedHigh = eng1_exe_protected_high
float effectiveProtectedLow = eng1_exe_protected_low
float effectiveContextHigh = eng1CtxRangeHigh
float effectiveContextLow = eng1CtxRangeLow
float effectiveRangeEquilibrium = eng1CtxRangeReady ? eng1CtxEquilibrium : na
float effectiveOteLongTop = eng1CtxRangeReady and eng1_narr_bias != -1 and (eng1_ctx_trend_bias == 1 or eng1_ctx_bull_reversal) ? eng1CtxOteLongTop : na
float effectiveOteLongBottom = eng1CtxRangeReady and eng1_narr_bias != -1 and (eng1_ctx_trend_bias == 1 or eng1_ctx_bull_reversal) ? eng1CtxOteLongBottom : na
float effectiveOteShortTop = eng1CtxRangeReady and eng1_narr_bias != 1 and (eng1_ctx_trend_bias == -1 or eng1_ctx_bear_reversal) ? eng1CtxOteShortTop : na
float effectiveOteShortBottom = eng1CtxRangeReady and eng1_narr_bias != 1 and (eng1_ctx_trend_bias == -1 or eng1_ctx_bear_reversal) ? eng1CtxOteShortBottom : na
bool effectiveLongOteReady = not na(effectiveOteLongTop) and not na(effectiveOteLongBottom)
bool effectiveShortOteReady = not na(effectiveOteShortTop) and not na(effectiveOteShortBottom)
bool eng1NarrativeReady = eng1_exec_valid and (eng1_narr_bias != 0 or not na(eng1_narr_liq_high) or not na(eng1_narr_liq_low))
bool eng1ContextReady = eng1_exec_valid and eng1CtxRangeReady
bool eng1ExecutionReady = eng1_exec_valid and (not na(effectiveExecLiqHigh) or not na(effectiveExecLiqLow) or not na(effectiveProtectedHigh) or not na(effectiveProtectedLow))
string eng1StageSummary = (eng1NarrativeReady ? "N" : "n") + "/" + (eng1ContextReady ? "C" : "c") + "/" + (eng1ExecutionReady ? "E" : "e") + "/" + (eng1_any_new_closed_bar ? "U" : "-")

//------------------------------------------------------------------------------
// ENGINE 3 (SETUP ENGINE)
// Resolve context POI, validate execution confirmations, and manage lifecycle.
//------------------------------------------------------------------------------
int eng1ContextTouchScan = math.max(expiryBarsEffective, freshBarsEffective) + strictMssLookbackEffective + 10
bool eng1BullContextAllowed = f_eng3_validate_narrative_side(true, eng1_exec_valid, eng1_narr_bias, eng1_ctx_trend_bias, eng1_ctx_bull_reversal, eng1_ctx_bear_reversal)
bool eng1BearContextAllowed = f_eng3_validate_narrative_side(false, eng1_exec_valid, eng1_narr_bias, eng1_ctx_trend_bias, eng1_ctx_bull_reversal, eng1_ctx_bear_reversal)
bool eng1HasBullObContext = eng1BullContextAllowed and not na(eng1_ctx_bull_ob_entry)
bool eng1HasBullFvgContext = eng1BullContextAllowed and not na(eng1_ctx_bull_fvg_top) and not na(eng1_ctx_bull_fvg_bottom)
bool eng1HasBearObContext = eng1BearContextAllowed and not na(eng1_ctx_bear_ob_entry)
bool eng1HasBearFvgContext = eng1BearContextAllowed and not na(eng1_ctx_bear_fvg_top) and not na(eng1_ctx_bear_fvg_bottom)
int eng1BullObCreatedBarRaw = f_timeToChartBar(eng1_ctx_bull_ob_bar)
int eng1BullFvgCreatedBarRaw = f_timeToChartBar(eng1_ctx_bull_fvg_bar)
int eng1BearObCreatedBarRaw = f_timeToChartBar(eng1_ctx_bear_ob_bar)
int eng1BearFvgCreatedBarRaw = f_timeToChartBar(eng1_ctx_bear_fvg_bar)
int eng1BullObCreatedBar = not na(eng1_ctx_bull_ob_bar) ? nz(eng1BullObCreatedBarRaw, bar_index) : na
int eng1BullFvgCreatedBar = not na(eng1_ctx_bull_fvg_bar) ? nz(eng1BullFvgCreatedBarRaw, bar_index) : na
int eng1BearObCreatedBar = not na(eng1_ctx_bear_ob_bar) ? nz(eng1BearObCreatedBarRaw, bar_index) : na
int eng1BearFvgCreatedBar = not na(eng1_ctx_bear_fvg_bar) ? nz(eng1BearFvgCreatedBarRaw, bar_index) : na
bool eng1BullObTouched = f_zoneTouchedSinceBar(eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng1BullObCreatedBar, eng1ContextTouchScan)
bool eng1BullFvgTouched = f_zoneTouchedSinceBar(eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng1BullFvgCreatedBar, eng1ContextTouchScan)
bool eng1BearObTouched = f_zoneTouchedSinceBar(eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng1BearObCreatedBar, eng1ContextTouchScan)
bool eng1BearFvgTouched = f_zoneTouchedSinceBar(eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng1BearFvgCreatedBar, eng1ContextTouchScan)

// Context POI sources (Engine 1 owned). Keep them explicit so Engine 3 never
// accidentally pulls from execution-only state.
float ctxBullObTop = eng1HasBullObContext ? eng1_ctx_bull_ob_top : na
float ctxBullObBottom = eng1HasBullObContext ? eng1_ctx_bull_ob_bottom : na
float ctxBullObEntry = eng1HasBullObContext ? eng1_ctx_bull_ob_entry : na
bool ctxBullObBreaker = eng1HasBullObContext ? eng1_ctx_bull_reversal : false
int ctxBullObCreatedBar = eng1HasBullObContext ? eng1BullObCreatedBar : na
bool ctxBullObTouched = eng1HasBullObContext ? eng1BullObTouched : false
float ctxBullFvgTop = eng1HasBullFvgContext ? eng1_ctx_bull_fvg_top : na
float ctxBullFvgBottom = eng1HasBullFvgContext ? eng1_ctx_bull_fvg_bottom : na
int ctxBullFvgCreatedBar = eng1HasBullFvgContext ? eng1BullFvgCreatedBar : na
bool ctxBullFvgTouched = eng1HasBullFvgContext ? eng1BullFvgTouched : false

float ctxBearObTop = eng1HasBearObContext ? eng1_ctx_bear_ob_top : na
float ctxBearObBottom = eng1HasBearObContext ? eng1_ctx_bear_ob_bottom : na
float ctxBearObEntry = eng1HasBearObContext ? eng1_ctx_bear_ob_entry : na
bool ctxBearObBreaker = eng1HasBearObContext ? eng1_ctx_bear_reversal : false
int ctxBearObCreatedBar = eng1HasBearObContext ? eng1BearObCreatedBar : na
bool ctxBearObTouched = eng1HasBearObContext ? eng1BearObTouched : false
float ctxBearFvgTop = eng1HasBearFvgContext ? eng1_ctx_bear_fvg_top : na
float ctxBearFvgBottom = eng1HasBearFvgContext ? eng1_ctx_bear_fvg_bottom : na
int ctxBearFvgCreatedBar = eng1HasBearFvgContext ? eng1BearFvgCreatedBar : na
bool ctxBearFvgTouched = eng1HasBearFvgContext ? eng1BearFvgTouched : false

bool hasBullOb = eng1HasBullObContext
bool hasBullFvg = eng1HasBullFvgContext
bool hasBearOb = eng1HasBearObContext
bool hasBearFvg = eng1HasBearFvgContext

bool bullObPdPass = hasBullOb and not na(effectiveRangeEquilibrium) and f_zoneMid(ctxBullObTop, ctxBullObBottom) < effectiveRangeEquilibrium
bool bullFvgPdPass = hasBullFvg and not na(effectiveRangeEquilibrium) and f_zoneMid(ctxBullFvgTop, ctxBullFvgBottom) < effectiveRangeEquilibrium
bool bearObPdPass = hasBearOb and not na(effectiveRangeEquilibrium) and f_zoneMid(ctxBearObTop, ctxBearObBottom) > effectiveRangeEquilibrium
bool bearFvgPdPass = hasBearFvg and not na(effectiveRangeEquilibrium) and f_zoneMid(ctxBearFvgTop, ctxBearFvgBottom) > effectiveRangeEquilibrium
bool bullObOtePass = hasBullOb and effectiveLongOteReady and f_zoneIntersects(ctxBullObTop, ctxBullObBottom, effectiveOteLongTop, effectiveOteLongBottom)
bool bullFvgOtePass = hasBullFvg and effectiveLongOteReady and f_zoneIntersects(ctxBullFvgTop, ctxBullFvgBottom, effectiveOteLongTop, effectiveOteLongBottom)
bool bearObOtePass = hasBearOb and effectiveShortOteReady and f_zoneIntersects(ctxBearObTop, ctxBearObBottom, effectiveOteShortTop, effectiveOteShortBottom)
bool bearFvgOtePass = hasBearFvg and effectiveShortOteReady and f_zoneIntersects(ctxBearFvgTop, ctxBearFvgBottom, effectiveOteShortTop, effectiveOteShortBottom)

bool bullObZoneConfirmPass = bullObPdPass and bullObOtePass
bool bullFvgZoneConfirmPass = bullFvgPdPass and bullFvgOtePass
bool bearObZoneConfirmPass = bearObPdPass and bearObOtePass
bool bearFvgZoneConfirmPass = bearFvgPdPass and bearFvgOtePass
bool bullFvgInZone = hasBullFvg and close >= ctxBullFvgBottom and close <= ctxBullFvgTop
bool bullObInZone = hasBullOb and close >= ctxBullObBottom and close <= ctxBullObTop
bool bearFvgInZone = hasBearFvg and close >= ctxBearFvgBottom and close <= ctxBearFvgTop
bool bearObInZone = hasBearOb and close >= ctxBearObBottom and close <= ctxBearObTop

[preferBullOb, preferBullFvg] = f_eng3_select_poi_preference(strictModeEnabled, hasBullOb, hasBullFvg, bullObZoneConfirmPass, bullFvgZoneConfirmPass, bullObInZone, bullFvgInZone)
[preferBearOb, preferBearFvg] = f_eng3_select_poi_preference(strictModeEnabled, hasBearOb, hasBearFvg, bearObZoneConfirmPass, bearFvgZoneConfirmPass, bearObInZone, bearFvgInZone)

[poi_long_valid, poi_long_type, poi_long_top, poi_long_bottom, poi_long_entry, poi_long_bar, poi_long_touched] = f_eng3_select_context_poi(preferBullOb, preferBullFvg, ctxBullObBreaker, ctxBullObTop, ctxBullObBottom, ctxBullObEntry, ctxBullObCreatedBar, ctxBullObTouched, ctxBullFvgTop, ctxBullFvgBottom, ctxBullFvgCreatedBar, ctxBullFvgTouched)
[poi_short_valid, poi_short_type, poi_short_top, poi_short_bottom, poi_short_entry, poi_short_bar, poi_short_touched] = f_eng3_select_context_poi(preferBearOb, preferBearFvg, ctxBearObBreaker, ctxBearObTop, ctxBearObBottom, ctxBearObEntry, ctxBearObCreatedBar, ctxBearObTouched, ctxBearFvgTop, ctxBearFvgBottom, ctxBearFvgCreatedBar, ctxBearFvgTouched)
bool poi_long_contract_valid = eng1BullContextAllowed and poi_long_valid
bool poi_short_contract_valid = eng1BearContextAllowed and poi_short_valid
poi_long_valid := poi_long_contract_valid
poi_short_valid := poi_short_contract_valid

[tradeLongEntry, tradeLongStop, tradeLongTarget, longTargetIsLiquidity, tradeLongSetup, tradeLongValidTop, tradeLongValidBottom, tradeLongIsOb, tradeLongIsFvg, tradeLongCreatedBar, tradeLongTouched] = f_eng3_build_trade_plan(true, poi_long_contract_valid, poi_long_type, poi_long_top, poi_long_bottom, poi_long_entry, poi_long_bar, poi_long_touched, atr, stopAtrBuffer, effectiveExecLiqHigh, effectiveExecLiqLow, effectiveExecEqHigh, effectiveExecEqLow, effectiveContextHigh, effectiveContextLow)
[tradeShortEntry, tradeShortStop, tradeShortTarget, shortTargetIsLiquidity, tradeShortSetup, tradeShortValidTop, tradeShortValidBottom, tradeShortIsOb, tradeShortIsFvg, tradeShortCreatedBar, tradeShortTouched] = f_eng3_build_trade_plan(false, poi_short_contract_valid, poi_short_type, poi_short_top, poi_short_bottom, poi_short_entry, poi_short_bar, poi_short_touched, atr, stopAtrBuffer, effectiveExecLiqHigh, effectiveExecLiqLow, effectiveExecEqHigh, effectiveExecEqLow, effectiveContextHigh, effectiveContextLow)

float ipdaLookback20High = f_eng1_window_high_safe(eng1_buf_d1_high, 20)
float ipdaLookback20Low = f_eng1_window_low_safe(eng1_buf_d1_low, 20)
float ipdaLookback40High = f_eng1_window_high_safe(eng1_buf_d1_high, 40)
float ipdaLookback40Low = f_eng1_window_low_safe(eng1_buf_d1_low, 40)
float ipdaLookback60High = f_eng1_window_high_safe(eng1_buf_d1_high, 60)
float ipdaLookback60Low = f_eng1_window_low_safe(eng1_buf_d1_low, 60)
bool ipdaLongDolAvailable = not na(eng1_narr_liq_high) or not na(ipdaLookback20High) or not na(ipdaLookback40High) or not na(ipdaLookback60High) or not na(eng1_narr_bear_sd_top) or not na(eng1_narr_bear_sd_bottom)
bool ipdaShortDolAvailable = not na(eng1_narr_liq_low) or not na(ipdaLookback20Low) or not na(ipdaLookback40Low) or not na(ipdaLookback60Low) or not na(eng1_narr_bull_sd_top) or not na(eng1_narr_bull_sd_bottom)
float longDolExternal = not na(tradeLongEntry) ? f_nearestAbove(tradeLongEntry, eng1_narr_liq_high, ipdaLookback20High, ipdaLookback40High, ipdaLookback60High, effectiveContextHigh, eng1_narr_bear_sd_bottom, eng1_narr_bear_sd_top) : na
float shortDolExternal = not na(tradeShortEntry) ? f_nearestBelow(tradeShortEntry, eng1_narr_liq_low, ipdaLookback20Low, ipdaLookback40Low, ipdaLookback60Low, effectiveContextLow, eng1_narr_bull_sd_top, eng1_narr_bull_sd_bottom) : na
bool longQualifiedExternalDol = not na(longDolExternal) and not na(tradeLongEntry) and not na(tradeLongStop) and tradeLongEntry > tradeLongStop and longDolExternal - tradeLongEntry >= tradeLongEntry - tradeLongStop
bool shortQualifiedExternalDol = not na(shortDolExternal) and not na(tradeShortEntry) and not na(tradeShortStop) and tradeShortStop > tradeShortEntry and tradeShortEntry - shortDolExternal >= tradeShortStop - tradeShortEntry
bool longUsesExternalDolTarget = longQualifiedExternalDol
bool shortUsesExternalDolTarget = shortQualifiedExternalDol
float activeLongTarget = longUsesExternalDolTarget ? longDolExternal : tradeLongTarget
float activeShortTarget = shortUsesExternalDolTarget ? shortDolExternal : tradeShortTarget
bool exe_long_pd_pass = tradeLongIsOb ? bullObPdPass : tradeLongIsFvg ? bullFvgPdPass : false
bool exe_short_pd_pass = tradeShortIsOb ? bearObPdPass : tradeShortIsFvg ? bearFvgPdPass : false
bool exe_long_ote_pass = tradeLongIsOb ? bullObOtePass : tradeLongIsFvg ? bullFvgOtePass : false
bool exe_short_ote_pass = tradeShortIsOb ? bearObOtePass : tradeShortIsFvg ? bearFvgOtePass : false
bool exe_long_kz_pass = not strictModeEnabled or strictKillzoneActive
bool exe_short_kz_pass = not strictModeEnabled or strictKillzoneActive
bool exe_long_dol_pass = strictModeEnabled ? longQualifiedExternalDol : not na(activeLongTarget)
bool exe_short_dol_pass = strictModeEnabled ? shortQualifiedExternalDol : not na(activeShortTarget)

float longRisk = not na(tradeLongEntry) and not na(tradeLongStop) ? tradeLongEntry - tradeLongStop : na
float longReward = not na(tradeLongEntry) and not na(activeLongTarget) ? activeLongTarget - tradeLongEntry : na
float longRr = not na(longRisk) and longRisk > 0 and not na(longReward) ? longReward / longRisk : na
bool longPriceInZone = not na(tradeLongValidBottom) and close >= tradeLongValidBottom and close <= tradeLongValidTop
bool longPriceNearZone = not na(tradeLongEntry) and math.abs(close - tradeLongEntry) <= atr * 0.25
int longSetupAge = not na(tradeLongCreatedBar) ? bar_index - tradeLongCreatedBar : na
bool longChased = not tradeLongTouched and not na(tradeLongValidTop) and close > tradeLongValidTop + atr * setupChaseAtr
float execBarRange = high - low
float execBarBodyShare = f_eng1_body_share(open, high, low, close)
bool longDispFallback = close > open and execBarRange >= atr * 0.80 and execBarBodyShare >= 0.50
bool shortDispFallback = close < open and execBarRange >= atr * 0.80 and execBarBodyShare >= 0.50
bool longDirectionalFallback = displayExecBias == 0 and ((eng1_exe_bull_mss and not eng1_exe_bear_mss) or (eng1_exe_bull_displacement and not eng1_exe_bear_displacement))
bool shortDirectionalFallback = displayExecBias == 0 and ((eng1_exe_bear_mss and not eng1_exe_bull_mss) or (eng1_exe_bear_displacement and not eng1_exe_bull_displacement))
bool effectiveLongDirectional = displayExecBias == 1 or longDirectionalFallback
bool ipdaLongAsiaRaid = ipdaAmKillzoneActive and not na(asiaSessionLow) and low < asiaSessionLow and close > asiaSessionLow
bool ipdaLongPmRaid = ipdaPmTradeAllowed and not na(newYorkAmSessionLow) and low < newYorkAmSessionLow and close > newYorkAmSessionLow
bool ipdaLongLookbackRaid = (not na(ipdaLookback20Low) and low < ipdaLookback20Low and close > ipdaLookback20Low) or (not na(ipdaLookback40Low) and low < ipdaLookback40Low and close > ipdaLookback40Low) or (not na(ipdaLookback60Low) and low < ipdaLookback60Low and close > ipdaLookback60Low)
bool effectiveLongSweepSeen = eng1_exe_bull_sweep or ipdaLongAsiaRaid or ipdaLongPmRaid or ipdaLongLookbackRaid
bool longMssFallbackBreak = not na(effectiveProtectedHigh) and close > effectiveProtectedHigh and close[1] <= effectiveProtectedHigh
int longMssFallbackAge = ta.barssince(longMssFallbackBreak)
bool longMssFallbackRecent = not na(longMssFallbackAge) and longMssFallbackAge <= strictMssLookbackEffective
bool effectiveLongMssSeen = eng1_exe_bull_mss or longMssFallbackRecent
bool effectiveLongDisplacementSeen = eng1_exe_bull_displacement or longDispFallback
bool effectiveLongStructureInvalidated = displayExecBias == -1 and ((eng1_ctx_trend_bias == -1) or eng1_ctx_bear_reversal or eng1_exe_bear_mss)
bool ipdaLongTimePriorityPass = not timeframe.isintraday or ipdaObservationActive or ipdaAmKillzoneActive or ipdaPmKillzoneActive
bool ipdaLongExpansionPhase = effectiveLongDisplacementSeen and (eng2DealBroken or (not na(effectiveRangeEquilibrium) and close > effectiveRangeEquilibrium))
bool ipdaLongRetracementPhase = (longPriceInZone or longPriceNearZone) and (tradeLongIsOb or tradeLongIsFvg)
bool ipdaLongReversalPhase = eng1_ctx_bull_reversal or (displayCtxBias == -1 and displayExecBias == 1)
bool ipdaLongAccumulationPhase = eng2DealReady and not eng2DealBroken and not ipdaLongExpansionPhase and not ipdaLongRetracementPhase and not ipdaLongReversalPhase
string ipdaLongCyclePhase = f_ipdaCyclePhaseText(ipdaLongAccumulationPhase, ipdaLongExpansionPhase, ipdaLongRetracementPhase, ipdaLongReversalPhase)
bool ipdaLongDirectionalContext = displayCtxBias == 1 or displayExecBias == 1 or effectiveLongDirectional or eng1_ctx_bull_reversal or eng1_ctx_bull_breakout
bool ipdaLongAlgorithmBiasPass = displayNarrBias != -1 and ipdaLongDirectionalContext
bool ipdaLongAlgorithmContextPass = (tradeLongIsOb or tradeLongIsFvg) and ipdaLongDirectionalContext
bool ipdaLongAlgorithmDolPass = exe_long_dol_pass or ipdaLongDolAvailable
// Strict IPDA map: Stage 1 = NY time, Stage 2 = Bias TF narrative/DOL,
// Stage 3 = Context TF POI, Stage 4-5 = Execution raid/MSS/displacement/risk.
bool strictLongBiasPass = not strictModeEnabled or (displayNarrBias == 1 and ipdaLongDolAvailable)
bool strictLongContextTfPass = not strictModeEnabled or ((displayCtxBias == 1 or eng1_ctx_bull_reversal or eng1_ctx_bull_breakout or (displayCtxBias == 0 and effectiveLongDirectional)) and (tradeLongIsOb or tradeLongIsFvg))
bool exe_long_sweep_signal = strictModeEnabled ? eng1_exe_bull_sweep : effectiveLongSweepSeen
bool exe_long_mss_signal = strictModeEnabled ? eng1_exe_bull_mss : effectiveLongMssSeen
bool exe_long_displacement_signal = strictModeEnabled ? eng1_exe_bull_displacement : effectiveLongDisplacementSeen
bool strictLongSweepPass = not strictModeEnabled or exe_long_sweep_signal
bool strictLongMssPass = not strictModeEnabled or (exe_long_mss_signal and effectiveLongDirectional)
bool strictLongDisplacementPass = not strictModeEnabled or exe_long_displacement_signal
bool strictLongPdPass = not strictModeEnabled or exe_long_pd_pass
bool strictLongOtePass = not strictModeEnabled or exe_long_ote_pass
bool strictLongDolPass = not strictModeEnabled or exe_long_dol_pass
bool strictLongKillzonePass = exe_long_kz_pass
bool exe_long_base_confirm = not na(tradeLongEntry) and effectiveLongDirectional and effectiveLongMssSeen and (effectiveLongSweepSeen or longPriceInZone or longPriceNearZone)
bool exe_long_contract_confirm = f_eng3_validate_execution_side(exe_long_sweep_signal, exe_long_mss_signal, exe_long_displacement_signal, exe_long_pd_pass, exe_long_ote_pass, exe_long_dol_pass, exe_long_kz_pass)
bool exe_long_confirm = not na(tradeLongEntry) and exe_long_contract_confirm
bool longConfirmationPass = exe_long_confirm
bool longExecutionFreshPass = effectiveLongMssSeen
var string lastLongSetupTag = ""
var bool longManagedLatched = false
var bool longCompletedLatched = false
var bool longAmbiguousLatched = false
string currentLongSetupTag = not na(tradeLongCreatedBar) ? tradeLongSetup + "|" + str.tostring(tradeLongCreatedBar) : ""
bool longManagedHit = tradeLongTouched and not na(longRisk) and high >= tradeLongEntry + longRisk * setupManagedR
bool longStopHit = not na(tradeLongStop) and low <= tradeLongStop
bool longTpHit = tradeLongTouched and not na(activeLongTarget) and high >= activeLongTarget
[nextLastLongSetupTag, nextLongManagedLatched, nextLongCompletedLatched, nextLongAmbiguousLatched, longManaged, longCompleted, longAmbiguous, longInvalidated, longExpired] = f_eng3_update_trade_lifecycle(currentLongSetupTag, lastLongSetupTag, longManagedLatched, longCompletedLatched, longAmbiguousLatched, tradeLongTouched, longManagedHit, longStopHit, longTpHit, effectiveLongStructureInvalidated, longSetupAge, expiryBarsEffective)
lastLongSetupTag := nextLastLongSetupTag
longManagedLatched := nextLongManagedLatched
longCompletedLatched := nextLongCompletedLatched
longAmbiguousLatched := nextLongAmbiguousLatched

float shortRisk = not na(tradeShortEntry) and not na(tradeShortStop) ? tradeShortStop - tradeShortEntry : na
float shortReward = not na(tradeShortEntry) and not na(activeShortTarget) ? tradeShortEntry - activeShortTarget : na
float shortRr = not na(shortRisk) and shortRisk > 0 and not na(shortReward) ? shortReward / shortRisk : na
bool shortPriceInZone = not na(tradeShortValidBottom) and close >= tradeShortValidBottom and close <= tradeShortValidTop
bool shortPriceNearZone = not na(tradeShortEntry) and math.abs(close - tradeShortEntry) <= atr * 0.25
int shortSetupAge = not na(tradeShortCreatedBar) ? bar_index - tradeShortCreatedBar : na
bool shortChased = not tradeShortTouched and not na(tradeShortValidBottom) and close < tradeShortValidBottom - atr * setupChaseAtr
bool effectiveShortDirectional = displayExecBias == -1 or shortDirectionalFallback
bool ipdaShortAsiaRaid = ipdaAmKillzoneActive and not na(asiaSessionHigh) and high > asiaSessionHigh and close < asiaSessionHigh
bool ipdaShortPmRaid = ipdaPmTradeAllowed and not na(newYorkAmSessionHigh) and high > newYorkAmSessionHigh and close < newYorkAmSessionHigh
bool ipdaShortLookbackRaid = (not na(ipdaLookback20High) and high > ipdaLookback20High and close < ipdaLookback20High) or (not na(ipdaLookback40High) and high > ipdaLookback40High and close < ipdaLookback40High) or (not na(ipdaLookback60High) and high > ipdaLookback60High and close < ipdaLookback60High)
bool effectiveShortSweepSeen = eng1_exe_bear_sweep or ipdaShortAsiaRaid or ipdaShortPmRaid or ipdaShortLookbackRaid
bool shortMssFallbackBreak = not na(effectiveProtectedLow) and close < effectiveProtectedLow and close[1] >= effectiveProtectedLow
int shortMssFallbackAge = ta.barssince(shortMssFallbackBreak)
bool shortMssFallbackRecent = not na(shortMssFallbackAge) and shortMssFallbackAge <= strictMssLookbackEffective
bool effectiveShortMssSeen = eng1_exe_bear_mss or shortMssFallbackRecent
bool effectiveShortDisplacementSeen = eng1_exe_bear_displacement or shortDispFallback
bool effectiveShortStructureInvalidated = displayExecBias == 1 and ((eng1_ctx_trend_bias == 1) or eng1_ctx_bull_reversal or eng1_exe_bull_mss)
bool ipdaShortTimePriorityPass = not timeframe.isintraday or ipdaObservationActive or ipdaAmKillzoneActive or ipdaPmKillzoneActive
bool ipdaShortExpansionPhase = effectiveShortDisplacementSeen and (eng2DealBroken or (not na(effectiveRangeEquilibrium) and close < effectiveRangeEquilibrium))
bool ipdaShortRetracementPhase = (shortPriceInZone or shortPriceNearZone) and (tradeShortIsOb or tradeShortIsFvg)
bool ipdaShortReversalPhase = eng1_ctx_bear_reversal or (displayCtxBias == 1 and displayExecBias == -1)
bool ipdaShortAccumulationPhase = eng2DealReady and not eng2DealBroken and not ipdaShortExpansionPhase and not ipdaShortRetracementPhase and not ipdaShortReversalPhase
string ipdaShortCyclePhase = f_ipdaCyclePhaseText(ipdaShortAccumulationPhase, ipdaShortExpansionPhase, ipdaShortRetracementPhase, ipdaShortReversalPhase)
bool ipdaShortDirectionalContext = displayCtxBias == -1 or displayExecBias == -1 or effectiveShortDirectional or eng1_ctx_bear_reversal or eng1_ctx_bear_breakout
bool ipdaShortAlgorithmBiasPass = displayNarrBias != 1 and ipdaShortDirectionalContext
bool ipdaShortAlgorithmContextPass = (tradeShortIsOb or tradeShortIsFvg) and ipdaShortDirectionalContext
bool ipdaShortAlgorithmDolPass = exe_short_dol_pass or ipdaShortDolAvailable
bool strictShortBiasPass = not strictModeEnabled or (displayNarrBias == -1 and ipdaShortDolAvailable)
bool strictShortContextTfPass = not strictModeEnabled or ((displayCtxBias == -1 or eng1_ctx_bear_reversal or eng1_ctx_bear_breakout or (displayCtxBias == 0 and effectiveShortDirectional)) and (tradeShortIsOb or tradeShortIsFvg))
bool exe_short_sweep_signal = strictModeEnabled ? eng1_exe_bear_sweep : effectiveShortSweepSeen
bool exe_short_mss_signal = strictModeEnabled ? eng1_exe_bear_mss : effectiveShortMssSeen
bool exe_short_displacement_signal = strictModeEnabled ? eng1_exe_bear_displacement : effectiveShortDisplacementSeen
bool strictShortSweepPass = not strictModeEnabled or exe_short_sweep_signal
bool strictShortMssPass = not strictModeEnabled or (exe_short_mss_signal and effectiveShortDirectional)
bool strictShortDisplacementPass = not strictModeEnabled or exe_short_displacement_signal
bool strictShortPdPass = not strictModeEnabled or exe_short_pd_pass
bool strictShortOtePass = not strictModeEnabled or exe_short_ote_pass
bool strictShortDolPass = not strictModeEnabled or exe_short_dol_pass
bool strictShortKillzonePass = exe_short_kz_pass
bool exe_short_base_confirm = not na(tradeShortEntry) and effectiveShortDirectional and effectiveShortMssSeen and (effectiveShortSweepSeen or shortPriceInZone or shortPriceNearZone)
bool exe_short_contract_confirm = f_eng3_validate_execution_side(exe_short_sweep_signal, exe_short_mss_signal, exe_short_displacement_signal, exe_short_pd_pass, exe_short_ote_pass, exe_short_dol_pass, exe_short_kz_pass)
bool exe_short_confirm = not na(tradeShortEntry) and exe_short_contract_confirm
bool shortConfirmationPass = exe_short_confirm
bool shortExecutionFreshPass = effectiveShortMssSeen
var string lastShortSetupTag = ""
var bool shortManagedLatched = false
var bool shortCompletedLatched = false
var bool shortAmbiguousLatched = false
string currentShortSetupTag = not na(tradeShortCreatedBar) ? tradeShortSetup + "|" + str.tostring(tradeShortCreatedBar) : ""
bool shortManagedHit = tradeShortTouched and not na(shortRisk) and low <= tradeShortEntry - shortRisk * setupManagedR
bool shortStopHit = not na(tradeShortStop) and high >= tradeShortStop
bool shortTpHit = tradeShortTouched and not na(activeShortTarget) and low <= activeShortTarget
[nextLastShortSetupTag, nextShortManagedLatched, nextShortCompletedLatched, nextShortAmbiguousLatched, shortManaged, shortCompleted, shortAmbiguous, shortInvalidated, shortExpired] = f_eng3_update_trade_lifecycle(currentShortSetupTag, lastShortSetupTag, shortManagedLatched, shortCompletedLatched, shortAmbiguousLatched, tradeShortTouched, shortManagedHit, shortStopHit, shortTpHit, effectiveShortStructureInvalidated, shortSetupAge, expiryBarsEffective)
lastShortSetupTag := nextLastShortSetupTag
shortManagedLatched := nextShortManagedLatched
shortCompletedLatched := nextShortCompletedLatched
shortAmbiguousLatched := nextShortAmbiguousLatched

if ipdaAmKillzoneActive and (longCompleted or shortCompleted)
    ipdaAmTargetReached := true

bool eng3LongTimePass = strictModeEnabled ? strictLongKillzonePass : ipdaLongTimePriorityPass
bool eng3ShortTimePass = strictModeEnabled ? strictShortKillzonePass : ipdaShortTimePriorityPass
bool eng3LongBiasPass = strictModeEnabled ? strictLongBiasPass : ipdaLongAlgorithmBiasPass
bool eng3ShortBiasPass = strictModeEnabled ? strictShortBiasPass : ipdaShortAlgorithmBiasPass
bool eng3LongContextPass = strictModeEnabled ? strictLongContextTfPass : ipdaLongAlgorithmContextPass
bool eng3ShortContextPass = strictModeEnabled ? strictShortContextTfPass : ipdaShortAlgorithmContextPass
bool eng3LongSweepPass = strictModeEnabled ? strictLongSweepPass : effectiveLongSweepSeen
bool eng3ShortSweepPass = strictModeEnabled ? strictShortSweepPass : effectiveShortSweepSeen
bool eng3LongMssPass = strictModeEnabled ? strictLongMssPass : (effectiveLongMssSeen and effectiveLongDirectional)
bool eng3ShortMssPass = strictModeEnabled ? strictShortMssPass : (effectiveShortMssSeen and effectiveShortDirectional)
bool eng3LongDisplacementPass = strictModeEnabled ? strictLongDisplacementPass : effectiveLongDisplacementSeen
bool eng3ShortDisplacementPass = strictModeEnabled ? strictShortDisplacementPass : effectiveShortDisplacementSeen
bool eng3LongPdPass = strictModeEnabled ? strictLongPdPass : (exe_long_pd_pass or longPriceInZone or longPriceNearZone)
bool eng3ShortPdPass = strictModeEnabled ? strictShortPdPass : (exe_short_pd_pass or shortPriceInZone or shortPriceNearZone)
bool eng3LongOtePass = strictModeEnabled ? strictLongOtePass : (exe_long_ote_pass or ipdaLongRetracementPhase)
bool eng3ShortOtePass = strictModeEnabled ? strictShortOtePass : (exe_short_ote_pass or ipdaShortRetracementPhase)
bool eng3LongDolPass = strictModeEnabled ? strictLongDolPass : ipdaLongAlgorithmDolPass
bool eng3ShortDolPass = strictModeEnabled ? strictShortDolPass : ipdaShortAlgorithmDolPass

// Keep setup scoring intentionally simple to reduce overtuning.
bool longBiasAligned = displayExecBias == 1
bool shortBiasAligned = displayExecBias == -1
bool longHtfAligned = strictModeEnabled ? (displayCtxBias == 1 and displayNarrBias != -1) : (ipdaLongAlgorithmBiasPass and ipdaLongAlgorithmContextPass)
bool shortHtfAligned = strictModeEnabled ? (displayCtxBias == -1 and displayNarrBias != 1) : (ipdaShortAlgorithmBiasPass and ipdaShortAlgorithmContextPass)
bool longDisplacementSeen = effectiveLongDisplacementSeen
bool shortDisplacementSeen = effectiveShortDisplacementSeen
bool longPoiConfirmPass = strictModeEnabled ? (exe_long_pd_pass and exe_long_ote_pass) : (ipdaLongRetracementPhase or exe_long_pd_pass or exe_long_ote_pass)
bool shortPoiConfirmPass = strictModeEnabled ? (exe_short_pd_pass and exe_short_ote_pass) : (ipdaShortRetracementPhase or exe_short_pd_pass or exe_short_ote_pass)
float contextDepartureRange = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeLow : na
string longQualityTier = f_zoneQualityTier(not na(tradeLongEntry), f_zoneResponseScore(not na(tradeLongEntry), longPoiConfirmPass), f_zoneDisplacementScore(longDisplacementSeen), f_zoneAtrExpansionScore(contextDepartureRange, atr))
string shortQualityTier = f_zoneQualityTier(not na(tradeShortEntry), f_zoneResponseScore(not na(tradeShortEntry), shortPoiConfirmPass), f_zoneDisplacementScore(shortDisplacementSeen), f_zoneAtrExpansionScore(contextDepartureRange, atr))
string longExecutionState = f_setupExecutionState(not na(tradeLongEntry), longAmbiguous, longInvalidated, longExpired, longChased, longCompleted, longManaged, exe_long_base_confirm, longConfirmationPass, longExecutionFreshPass, longDisplacementSeen, longPriceInZone, longPriceNearZone)
string shortExecutionState = f_setupExecutionState(not na(tradeShortEntry), shortAmbiguous, shortInvalidated, shortExpired, shortChased, shortCompleted, shortManaged, exe_short_base_confirm, shortConfirmationPass, shortExecutionFreshPass, shortDisplacementSeen, shortPriceInZone, shortPriceNearZone)
string longSetupDisplay = f_setupQualityText(tradeLongSetup, longQualityTier, not na(tradeLongEntry))
string shortSetupDisplay = f_setupQualityText(tradeShortSetup, shortQualityTier, not na(tradeShortEntry))

float longConfidence = f_setupScore(not na(tradeLongEntry), longBiasAligned, longHtfAligned, longPriceInZone, longPriceNearZone, longRr, longChased, longExpired, longInvalidated)

float shortConfidence = f_setupScore(not na(tradeShortEntry), shortBiasAligned, shortHtfAligned, shortPriceInZone, shortPriceNearZone, shortRr, shortChased, shortExpired, shortInvalidated)
string longZoneQualityText = poi_long_contract_valid and not na(tradeLongEntry) ? longQualityTier : "-"
string shortZoneQualityText = poi_short_contract_valid and not na(tradeShortEntry) ? shortQualityTier : "-"

//------------------------------------------------------------------------------
// ENGINE 3 CONTRACT ALIASES (MAIN_CONTRACT)
// Keep canonical Engine 3 snapshot names explicit for cross-engine connectors.
//------------------------------------------------------------------------------
string stp_long_state = longExecutionState
string stp_short_state = shortExecutionState
float stp_long_entry = tradeLongEntry
float stp_long_stop = tradeLongStop
float stp_long_target = activeLongTarget
float stp_short_entry = tradeShortEntry
float stp_short_stop = tradeShortStop
float stp_short_target = activeShortTarget
float stp_long_rr = longRr
float stp_short_rr = shortRr
bool stp_long_touched = tradeLongTouched
bool stp_short_touched = tradeShortTouched
bool stp_long_completed = longCompleted
bool stp_short_completed = shortCompleted
bool stp_long_invalidated = longInvalidated
bool stp_short_invalidated = shortInvalidated
bool stp_long_ambiguous = longAmbiguous
bool stp_short_ambiguous = shortAmbiguous
int stp_long_age = longSetupAge
int stp_short_age = shortSetupAge

bool longSelectedVisualActive = not f_executionTerminal(longExecutionState)
bool shortSelectedVisualActive = not f_executionTerminal(shortExecutionState)
string preferredDirection = "Wait"
bool longPreferredReady = f_executionRiskVisible(longExecutionState)
bool shortPreferredReady = f_executionRiskVisible(shortExecutionState)
bool longPriorityCandidate = not na(tradeLongEntry) and not f_eng4_retired_state(longExecutionState, longSetupAge, tradeLongTouched, expiryBarsEffective)
bool shortPriorityCandidate = not na(tradeShortEntry) and not f_eng4_retired_state(shortExecutionState, shortSetupAge, tradeShortTouched, expiryBarsEffective)
if longPreferredReady and not shortPreferredReady
    preferredDirection := "Long"
else if shortPreferredReady and not longPreferredReady
    preferredDirection := "Short"
else if longPreferredReady and shortPreferredReady
    preferredDirection := "Balanced"

bool compactUseLong = preferredDirection == "Long"
if preferredDirection == "Short"
    compactUseLong := false
else if preferredDirection == "Balanced"
    if longPriorityCandidate and not shortPriorityCandidate
        compactUseLong := true
    else if shortPriorityCandidate and not longPriorityCandidate
        compactUseLong := false
    else if not na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := tradeLongCreatedBar >= tradeShortCreatedBar
    else if na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := false
else
    if longPriorityCandidate and not shortPriorityCandidate
        compactUseLong := true
    else if shortPriorityCandidate and not longPriorityCandidate
        compactUseLong := false
    else if not na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := tradeLongCreatedBar >= tradeShortCreatedBar
    else if na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := false

string ipdaCycleMarketText = preferredDirection == "Long" ? f_ipdaCyclePhaseShort(ipdaLongCyclePhase) : preferredDirection == "Short" ? f_ipdaCyclePhaseShort(ipdaShortCyclePhase) : ipdaLongCyclePhase == ipdaShortCyclePhase ? f_ipdaCyclePhaseShort(ipdaLongCyclePhase) : f_ipdaCyclePhaseShort(ipdaLongCyclePhase) + "/" + f_ipdaCyclePhaseShort(ipdaShortCyclePhase)
string ipdaCycleMarketFullText = "IPDA " + ipdaCycleMarketText + " Q" + str.tostring(ipdaQuarter)

bool eng2LongZoneTypeVisible = (tradeLongIsOb and showOb) or (tradeLongIsFvg and showFvg)
bool eng2ShortZoneTypeVisible = (tradeShortIsOb and showOb) or (tradeShortIsFvg and showFvg)
bool draw_long_selected = longSelectedVisualActive and eng2LongZoneTypeVisible
bool draw_short_selected = shortSelectedVisualActive and eng2ShortZoneTypeVisible
float draw_long_zone_top = draw_long_selected ? tradeLongValidTop : na
float draw_long_zone_bottom = draw_long_selected ? tradeLongValidBottom : na
float draw_short_zone_top = draw_short_selected ? tradeShortValidTop : na
float draw_short_zone_bottom = draw_short_selected ? tradeShortValidBottom : na
string draw_long_zone_type = draw_long_selected ? (tradeLongIsOb ? "OB" : tradeLongIsFvg ? "FVG" : "") : ""
string draw_short_zone_type = draw_short_selected ? (tradeShortIsOb ? "OB" : tradeShortIsFvg ? "FVG" : "") : ""
bool showEng2LongLiveZone = draw_long_selected and f_draw_zone_visible(draw_mode, true, true, preferredDirection)
bool showEng2ShortLiveZone = draw_short_selected and f_draw_zone_visible(draw_mode, true, false, preferredDirection)

bool longTerminalNow = f_executionTerminal(longExecutionState)
bool shortTerminalNow = f_executionTerminal(shortExecutionState)
bool longTerminalSnapshot = longTerminalNow and currentLongSetupTag != "" and eng2LongHistoryTag != currentLongSetupTag
bool shortTerminalSnapshot = shortTerminalNow and currentShortSetupTag != "" and eng2ShortHistoryTag != currentShortSetupTag
if longTerminalSnapshot
    eng2LongHistoryTag := currentLongSetupTag
    eng2LongHistoryLeftBar := nz(tradeLongCreatedBar, bar_index)
    eng2LongHistoryRightBar := bar_index
    eng2LongHistoryTop := tradeLongValidTop
    eng2LongHistoryBottom := tradeLongValidBottom
    eng2LongHistoryIsOb := tradeLongIsOb
    eng2LongHistoryIsFvg := tradeLongIsFvg
if shortTerminalSnapshot
    eng2ShortHistoryTag := currentShortSetupTag
    eng2ShortHistoryLeftBar := nz(tradeShortCreatedBar, bar_index)
    eng2ShortHistoryRightBar := bar_index
    eng2ShortHistoryTop := tradeShortValidTop
    eng2ShortHistoryBottom := tradeShortValidBottom
    eng2ShortHistoryIsOb := tradeShortIsOb
    eng2ShortHistoryIsFvg := tradeShortIsFvg

bool historyZonesEnabled = eng1_exec_valid and draw_full and (showOb or showFvg) and not compactMode
bool showEng2LongHistoryZone = historyZonesEnabled and eng2LongHistoryTag != "" and not na(eng2LongHistoryTop) and not na(eng2LongHistoryBottom) and ((eng2LongHistoryIsOb and showOb) or (eng2LongHistoryIsFvg and showFvg))
bool showEng2ShortHistoryZone = historyZonesEnabled and eng2ShortHistoryTag != "" and not na(eng2ShortHistoryTop) and not na(eng2ShortHistoryBottom) and ((eng2ShortHistoryIsOb and showOb) or (eng2ShortHistoryIsFvg and showFvg))
string eng2LongZoneBadge = f_executionStateBadge(longExecutionState, compactMode)
string eng2ShortZoneBadge = f_executionStateBadge(shortExecutionState, compactMode)
string eng2LongZoneBaseLabel = tradeLongIsOb ? f_obLabelText(true, eng1_ctx_bull_reversal) : tradeLongIsFvg ? f_fvgLabelText(true) : ""
string eng2ShortZoneBaseLabel = tradeShortIsOb ? f_obLabelText(false, eng1_ctx_bear_reversal) : tradeShortIsFvg ? f_fvgLabelText(false) : ""
string eng2LongZoneLabelCore = eng2LongZoneBadge != "" ? eng2LongZoneBaseLabel + " | " + eng2LongZoneBadge : eng2LongZoneBaseLabel
string eng2ShortZoneLabelCore = eng2ShortZoneBadge != "" ? eng2ShortZoneBaseLabel + " | " + eng2ShortZoneBadge : eng2ShortZoneBaseLabel
string eng2LongZoneLabelText = eng2LongZoneBaseLabel == "" ? "" : eng2LongZoneLabelCore + f_zoneQualityLabelSuffix(longZoneQualityText)
string eng2ShortZoneLabelText = eng2ShortZoneBaseLabel == "" ? "" : eng2ShortZoneLabelCore + f_zoneQualityLabelSuffix(shortZoneQualityText)
int eng2LongZoneBorderWidth = f_zoneQualityBorderWidth(longZoneQualityText)
int eng2ShortZoneBorderWidth = f_zoneQualityBorderWidth(shortZoneQualityText)
color eng2LongZoneBorder = color.new(bullColor, f_zoneQualityBorderAlpha(longZoneQualityText, longExecutionState))
color eng2ShortZoneBorder = color.new(bearColor, f_zoneQualityBorderAlpha(shortZoneQualityText, shortExecutionState))
color eng2LongZoneFill = color.new(bullColor, f_executionSelectedFillAlpha(longExecutionState))
color eng2ShortZoneFill = color.new(bearColor, f_executionSelectedFillAlpha(shortExecutionState))

// Context zones (Full mode): show the snapshot OB/FVG even when no setup is selected yet.
bool eng2ContextZonesEnabled = eng1_exec_valid and draw_full and (showOb or showFvg) and not compactMode
bool showEng2CtxBullOb = eng2ContextZonesEnabled and showOb and not na(eng1_ctx_bull_ob_top) and not na(eng1_ctx_bull_ob_bottom) and not (showEng2LongLiveZone and tradeLongIsOb)
bool showEng2CtxBullFvg = eng2ContextZonesEnabled and showFvg and not na(eng1_ctx_bull_fvg_top) and not na(eng1_ctx_bull_fvg_bottom) and not (showEng2LongLiveZone and tradeLongIsFvg)
bool showEng2CtxBearOb = eng2ContextZonesEnabled and showOb and not na(eng1_ctx_bear_ob_top) and not na(eng1_ctx_bear_ob_bottom) and not (showEng2ShortLiveZone and tradeShortIsOb)
bool showEng2CtxBearFvg = eng2ContextZonesEnabled and showFvg and not na(eng1_ctx_bear_fvg_top) and not na(eng1_ctx_bear_fvg_bottom) and not (showEng2ShortLiveZone and tradeShortIsFvg)
string eng2CtxBullObText = "Ctx " + (eng1_ctx_bull_reversal ? "BRK+" : "OB+")
string eng2CtxBearObText = "Ctx " + (eng1_ctx_bear_reversal ? "BRK-" : "OB-")
string eng2CtxBullFvgText = "Ctx FVG+"
string eng2CtxBearFvgText = "Ctx FVG-"
color eng2CtxBullObBorder = color.new(bullColor, 40)
color eng2CtxBearObBorder = color.new(bearColor, 40)
color eng2CtxBullFvgBorder = color.new(bullColor, 55)
color eng2CtxBearFvgBorder = color.new(bearColor, 55)
color eng2CtxBullObFill = color.new(bullColor, 92)
color eng2CtxBearObFill = color.new(bearColor, 92)
color eng2CtxBullFvgFill = color.new(bullColor, 95)
color eng2CtxBearFvgFill = color.new(bearColor, 95)
[eng2CtxBullObBoxTmp, _, eng2CtxBullObLabelTmp] = f_eng2_syncSetupZoneVisual(eng2CtxBullObBox, na, eng2CtxBullObLabel, showEng2CtxBullOb, eng1BullObCreatedBar, eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, na, eng2CtxBullObText, label.style_label_right, eng2CtxBullObBorder, eng2CtxBullObFill, 1, false, "Waiting")
[eng2CtxBullFvgBoxTmp, _, eng2CtxBullFvgLabelTmp] = f_eng2_syncSetupZoneVisual(eng2CtxBullFvgBox, na, eng2CtxBullFvgLabel, showEng2CtxBullFvg, eng1BullFvgCreatedBar, eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, na, eng2CtxBullFvgText, label.style_label_right, eng2CtxBullFvgBorder, eng2CtxBullFvgFill, 1, false, "Waiting")
[eng2CtxBearObBoxTmp, _, eng2CtxBearObLabelTmp] = f_eng2_syncSetupZoneVisual(eng2CtxBearObBox, na, eng2CtxBearObLabel, showEng2CtxBearOb, eng1BearObCreatedBar, eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, na, eng2CtxBearObText, label.style_label_right, eng2CtxBearObBorder, eng2CtxBearObFill, 1, false, "Waiting")
[eng2CtxBearFvgBoxTmp, _, eng2CtxBearFvgLabelTmp] = f_eng2_syncSetupZoneVisual(eng2CtxBearFvgBox, na, eng2CtxBearFvgLabel, showEng2CtxBearFvg, eng1BearFvgCreatedBar, eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, na, eng2CtxBearFvgText, label.style_label_right, eng2CtxBearFvgBorder, eng2CtxBearFvgFill, 1, false, "Waiting")
eng2CtxBullObBox := eng2CtxBullObBoxTmp
eng2CtxBullObLabel := eng2CtxBullObLabelTmp
eng2CtxBullFvgBox := eng2CtxBullFvgBoxTmp
eng2CtxBullFvgLabel := eng2CtxBullFvgLabelTmp
eng2CtxBearObBox := eng2CtxBearObBoxTmp
eng2CtxBearObLabel := eng2CtxBearObLabelTmp
eng2CtxBearFvgBox := eng2CtxBearFvgBoxTmp
eng2CtxBearFvgLabel := eng2CtxBearFvgLabelTmp

string eng2LongLabelStyle = tradeLongIsOb ? label.style_label_right : label.style_label_left
string eng2ShortLabelStyle = tradeShortIsOb ? label.style_label_right : label.style_label_left
[eng2LongZoneBoxTmp, eng2LongZoneLineTmp, eng2LongZoneLabelTmp] = f_eng2_syncSetupZoneVisual(eng2LongZoneBox, eng2LongZoneLine, eng2LongZoneLabel, showEng2LongLiveZone, tradeLongCreatedBar, tradeLongValidTop, tradeLongValidBottom, tradeLongEntry, eng2LongZoneLabelText, eng2LongLabelStyle, eng2LongZoneBorder, eng2LongZoneFill, eng2LongZoneBorderWidth, tradeLongIsOb, longExecutionState)
[eng2ShortZoneBoxTmp, eng2ShortZoneLineTmp, eng2ShortZoneLabelTmp] = f_eng2_syncSetupZoneVisual(eng2ShortZoneBox, eng2ShortZoneLine, eng2ShortZoneLabel, showEng2ShortLiveZone, tradeShortCreatedBar, tradeShortValidTop, tradeShortValidBottom, tradeShortEntry, eng2ShortZoneLabelText, eng2ShortLabelStyle, eng2ShortZoneBorder, eng2ShortZoneFill, eng2ShortZoneBorderWidth, tradeShortIsOb, shortExecutionState)
eng2LongZoneBox := eng2LongZoneBoxTmp
eng2LongZoneLine := eng2LongZoneLineTmp
eng2LongZoneLabel := eng2LongZoneLabelTmp
eng2ShortZoneBox := eng2ShortZoneBoxTmp
eng2ShortZoneLine := eng2ShortZoneLineTmp
eng2ShortZoneLabel := eng2ShortZoneLabelTmp

// History boxes should stay visible, but feel lighter than the live / selected zone.
color eng2LongHistoryBorder = color.new(bullColor, 80)
color eng2ShortHistoryBorder = color.new(bearColor, 80)
color eng2LongHistoryFill = color.new(bullColor, 98)
color eng2ShortHistoryFill = color.new(bearColor, 98)
eng2LongHistoryBox := f_eng2_syncHistoryZoneBox(eng2LongHistoryBox, showEng2LongHistoryZone, eng2LongHistoryLeftBar, eng2LongHistoryRightBar, eng2LongHistoryTop, eng2LongHistoryBottom, eng2LongHistoryBorder, eng2LongHistoryFill, 1)
eng2ShortHistoryBox := f_eng2_syncHistoryZoneBox(eng2ShortHistoryBox, showEng2ShortHistoryZone, eng2ShortHistoryLeftBar, eng2ShortHistoryRightBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, eng2ShortHistoryBorder, eng2ShortHistoryFill, 1)

//------------------------------------------------------------------------------
// ENGINE 2
// Narrative zones: supply/demand from the narrative HTF snapshot.
// Full mode only to avoid clutter on execution charts.
//------------------------------------------------------------------------------
bool eng2NarrativeZonesEnabled = eng1_exec_valid and draw_full and draw_show_htf and showOb and not compactMode
int eng2NarrBullSdCreatedBarRaw = f_timeToChartBar(eng1_narr_bull_sd_bar)
int eng2NarrBearSdCreatedBarRaw = f_timeToChartBar(eng1_narr_bear_sd_bar)
int eng2NarrBullSdCreatedBar = not na(eng1_narr_bull_sd_bar) ? nz(eng2NarrBullSdCreatedBarRaw, bar_index) : na
int eng2NarrBearSdCreatedBar = not na(eng1_narr_bear_sd_bar) ? nz(eng2NarrBearSdCreatedBarRaw, bar_index) : na
string eng2NarrBullSdText = compactMode ? "SD+" : "Narr SD+"
string eng2NarrBearSdText = compactMode ? "SD-" : "Narr SD-"
color eng2NarrBullBorder = color.new(bullColor, 38)
color eng2NarrBearBorder = color.new(bearColor, 38)
color eng2NarrBullFill = color.new(bullColor, 94)
color eng2NarrBearFill = color.new(bearColor, 94)
[eng2NarrBullSdBoxTmp, _, eng2NarrBullSdLabelTmp] = f_eng2_syncSetupZoneVisual(eng2NarrBullSdBox, na, eng2NarrBullSdLabel, eng2NarrativeZonesEnabled, eng2NarrBullSdCreatedBar, eng1_narr_bull_sd_top, eng1_narr_bull_sd_bottom, na, eng2NarrBullSdText, label.style_label_right, eng2NarrBullBorder, eng2NarrBullFill, 1, false, "Waiting")
[eng2NarrBearSdBoxTmp, _, eng2NarrBearSdLabelTmp] = f_eng2_syncSetupZoneVisual(eng2NarrBearSdBox, na, eng2NarrBearSdLabel, eng2NarrativeZonesEnabled, eng2NarrBearSdCreatedBar, eng1_narr_bear_sd_top, eng1_narr_bear_sd_bottom, na, eng2NarrBearSdText, label.style_label_right, eng2NarrBearBorder, eng2NarrBearFill, 1, false, "Waiting")
eng2NarrBullSdBox := eng2NarrBullSdBoxTmp
eng2NarrBullSdLabel := eng2NarrBullSdLabelTmp
eng2NarrBearSdBox := eng2NarrBearSdBoxTmp
eng2NarrBearSdLabel := eng2NarrBearSdLabelTmp

string compactSetup = compactUseLong ? longSetupDisplay : shortSetupDisplay
string compactExecutionState = compactUseLong ? longExecutionState : shortExecutionState
float compactZoneTop = compactUseLong ? tradeLongValidTop : tradeShortValidTop
float compactZoneBottom = compactUseLong ? tradeLongValidBottom : tradeShortValidBottom
float compactEntry = compactUseLong ? tradeLongEntry : tradeShortEntry
float compactStop = compactUseLong ? tradeLongStop : tradeShortStop
float compactTarget = compactUseLong ? activeLongTarget : activeShortTarget
float compactRr = compactUseLong ? longRr : shortRr
float compactConfidence = compactUseLong ? longConfidence : shortConfidence
bool compactBalanced = preferredDirection == "Balanced"
bool compactWaiting = preferredDirection == "Wait"
bool compactNeutral = compactBalanced or compactWaiting
bool compactActionable = longPreferredReady or shortPreferredReady
bool compactContextOnly = compactNeutral and not compactActionable
bool eng4LongRetired = f_eng4_retired_state(longExecutionState, longSetupAge, tradeLongTouched, expiryBarsEffective)
bool eng4ShortRetired = f_eng4_retired_state(shortExecutionState, shortSetupAge, tradeShortTouched, expiryBarsEffective)
color compactAccent = compactNeutral ? color.new(neutralColor, 12) : compactUseLong ? color.new(bullColor, 12) : color.new(bearColor, 12)
bool compactCandidateHasSetup = not na(compactEntry)
bool compactCandidateRetired = compactUseLong ? eng4LongRetired : eng4ShortRetired
float bullStop = not na(tradeLongStop) ? tradeLongStop : not na(effectiveExecLiqLow) ? effectiveExecLiqLow - atr * stopAtrBuffer : na
float bearStop = not na(tradeShortStop) ? tradeShortStop : not na(effectiveExecLiqHigh) ? effectiveExecLiqHigh + atr * stopAtrBuffer : na

//------------------------------------------------------------------------------
// Zone visual policy matrix
// Fresh / live FVG, OB, Breaker:
//   Engine: keep if actionable
//   Full: show
//   Focused: show only selected active zone
//   Minimal: show only selected zone in preferred direction
// Failed OB:
//   Engine: ephemeral state only (no legacy carryover)
//   Full: show muted
//   Focused / Minimal: hide
// Retired FVG / deleted OB / swept EQH-EQL:
//   Engine: remove / deactivate
//   Visual: never show
// Liquidity targets:
//   Session/calendar liquidity stays engine-only
//   Chart uses session range boxes + extended H/L lines instead
// Context ranges:
//   Full / Focused: show
//   Minimal: keep only protected levels
//------------------------------------------------------------------------------
float eng4LongDrawLevel = longUsesExternalDolTarget ? longDolExternal : na
float eng4ShortDrawLevel = shortUsesExternalDolTarget ? shortDolExternal : na
float eng4PrimaryDrawLevel = compactUseLong ? eng4LongDrawLevel : eng4ShortDrawLevel
// BSL/SSL should reflect current execution swing liquidity without keeping a
// separate alias layer between Engine 1 levels and Engine 2 visibility.
bool draw_eq_high_primary = f_preferredLevelMatch(effectiveExecLiqHigh, compactBalanced, compactUseLong, activeLongTarget, activeShortTarget)
bool draw_eq_low_primary = f_preferredLevelMatch(effectiveExecLiqLow, compactBalanced, compactUseLong, activeLongTarget, activeShortTarget)
showEqHighVisual = showLiquidity and not compactMode and f_draw_level_visible(draw_mode, draw_eq_high_primary, true, preferredDirection)
showEqLowVisual = showLiquidity and not compactMode and f_draw_level_visible(draw_mode, draw_eq_low_primary, false, preferredDirection)
showProtectedHighVisual = draw_show_protected and not na(effectiveProtectedHigh)
showProtectedLowVisual = draw_show_protected and not na(effectiveProtectedLow)
showRangeVisual = showLiquidity and displayInternalRange and f_contextVisualByMode(draw_mode)
showOteVisual = draw_show_ote
showHtfHighVisual = draw_show_htf and not na(effectiveContextHigh) and f_contextVisualByMode(draw_mode)
showHtfLowVisual = draw_show_htf and not na(effectiveContextLow) and f_contextVisualByMode(draw_mode)
showLongRiskVisual = showRisk and not compactMode and f_executionVisualByMode(draw_mode, f_executionRiskVisible(longExecutionState), preferredDirection, true, compactUseLong)
showShortRiskVisual = showRisk and not compactMode and f_executionVisualByMode(draw_mode, f_executionRiskVisible(shortExecutionState), preferredDirection, false, compactUseLong)

if not draw_full
    showEqHighVisual := f_uniqueLevelVisual(showEqHighVisual, effectiveExecLiqHigh, showHtfHighVisual, effectiveContextHigh, false, na, false, na, false, na, false, na)
    showEqLowVisual := f_uniqueLevelVisual(showEqLowVisual, effectiveExecLiqLow, showHtfLowVisual, effectiveContextLow, false, na, false, na, false, na, false, na)

//------------------------------------------------------------------------------
// Active Levels (single-instance lines)
// Keep these non-historical to avoid scattered segments when levels update.
//------------------------------------------------------------------------------
eqHighLevel = showEqHighVisual ? effectiveExecLiqHigh : na
eqLowLevel = showEqLowVisual ? effectiveExecLiqLow : na
protectedHighLevel = showProtectedHighVisual ? effectiveProtectedHigh : na
protectedLowLevel = showProtectedLowVisual ? effectiveProtectedLow : na
bool showDealingRangeVisual = showRangeVisual and not eng2DealBroken and not na(eng2DealHigh) and not na(eng2DealLow) and not na(eng2DealLeftBar) and eng2DealHigh > eng2DealLow
float dealingRangeHighLevel = showDealingRangeVisual ? eng2DealHigh : na
float dealingRangeLowLevel = showDealingRangeVisual ? eng2DealLow : na
float dealingRangeEqLevel = showDealingRangeVisual ? (eng2DealHigh + eng2DealLow) * 0.5 : na
float dealingRangeSize = showDealingRangeVisual ? eng2DealHigh - eng2DealLow : na
float dealingRangeQ25 = showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.25 : na
float dealingRangeQ75 = showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.75 : na
float dealingBuyOteTop = showDealingRangeVisual ? eng2DealHigh - dealingRangeSize * 0.618 : na
float dealingBuyOteBottom = showDealingRangeVisual ? eng2DealHigh - dealingRangeSize * 0.786 : na
float dealingSellOteTop = showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.786 : na
float dealingSellOteBottom = showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.618 : na
htfStructureHighLevel = showHtfHighVisual ? effectiveContextHigh : na
htfStructureLowLevel = showHtfLowVisual ? effectiveContextLow : na
riskLongEntryLevel = showLongRiskVisual ? tradeLongEntry : na
riskShortEntryLevel = showShortRiskVisual ? tradeShortEntry : na
riskBullStopLevel = showLongRiskVisual ? bullStop : na
riskBearStopLevel = showShortRiskVisual ? bearStop : na
riskLongTargetLevel = showLongRiskVisual ? activeLongTarget : na
riskShortTargetLevel = showShortRiskVisual ? activeShortTarget : na
oteLongTopLevel = showOteVisual and showDealingRangeVisual ? dealingBuyOteTop : na
oteLongBottomLevel = showOteVisual and showDealingRangeVisual ? dealingBuyOteBottom : na
oteShortTopLevel = showOteVisual and showDealingRangeVisual ? dealingSellOteTop : na
oteShortBottomLevel = showOteVisual and showDealingRangeVisual ? dealingSellOteBottom : na
string dealingRangeStatusText = f_dealingRangeStatusText(showDealingRangeVisual, eng2DealBroken, eng1CtxRangeReady)
string dealingRangeZoneText = f_dealingRangeZoneText(showDealingRangeVisual, close, dealingRangeEqLevel)
int dealingRangeIrlCount = (not na(oteLongTopLevel) and not na(oteLongBottomLevel) ? 1 : 0) + (not na(oteShortTopLevel) and not na(oteShortBottomLevel) ? 1 : 0)
string dealingRangeIrlText = showDealingRangeVisual ? str.tostring(dealingRangeIrlCount) + " active" : "-"
rightEdgeLabelTolerance = atr * 0.15
showShortStopRightLabel = draw_show_right_labels and showShortRiskVisual and not na(riskBearStopLevel)
showLongStopRightLabel = draw_show_right_labels and showLongRiskVisual and not na(riskBullStopLevel)
showHtfHighRightLabel = draw_show_right_labels and showHtfHighVisual and not f_levelsClose(htfStructureHighLevel, riskBearStopLevel, rightEdgeLabelTolerance)
showHtfLowRightLabel = draw_show_right_labels and showHtfLowVisual and not f_levelsClose(htfStructureLowLevel, riskBullStopLevel, rightEdgeLabelTolerance)
showProtectedHighRightLabel = draw_show_right_labels and showProtectedHighVisual and not f_levelsClose(protectedHighLevel, riskBearStopLevel, rightEdgeLabelTolerance) and not f_levelsClose(protectedHighLevel, htfStructureHighLevel, rightEdgeLabelTolerance)
showProtectedLowRightLabel = draw_show_right_labels and showProtectedLowVisual and not f_levelsClose(protectedLowLevel, riskBullStopLevel, rightEdgeLabelTolerance) and not f_levelsClose(protectedLowLevel, htfStructureLowLevel, rightEdgeLabelTolerance)
showEqHighRightLabel = draw_show_right_labels and showEqHighVisual and not f_levelsClose(eqHighLevel, riskBearStopLevel, rightEdgeLabelTolerance) and not f_levelsClose(eqHighLevel, protectedHighLevel, rightEdgeLabelTolerance) and not f_levelsClose(eqHighLevel, htfStructureHighLevel, rightEdgeLabelTolerance)
showEqLowRightLabel = draw_show_right_labels and showEqLowVisual and not f_levelsClose(eqLowLevel, riskBullStopLevel, rightEdgeLabelTolerance) and not f_levelsClose(eqLowLevel, protectedLowLevel, rightEdgeLabelTolerance) and not f_levelsClose(eqLowLevel, htfStructureLowLevel, rightEdgeLabelTolerance)
showNarrHighRightLabel = showLiquidity and draw_show_right_labels and draw_show_htf and not compactMode and draw_full and not na(eng1_narr_liq_high) and not f_levelsClose(eng1_narr_liq_high, htfStructureHighLevel, rightEdgeLabelTolerance) and not f_levelsClose(eng1_narr_liq_high, protectedHighLevel, rightEdgeLabelTolerance) and not f_levelsClose(eng1_narr_liq_high, eqHighLevel, rightEdgeLabelTolerance)
showNarrLowRightLabel = showLiquidity and draw_show_right_labels and draw_show_htf and not compactMode and draw_full and not na(eng1_narr_liq_low) and not f_levelsClose(eng1_narr_liq_low, htfStructureLowLevel, rightEdgeLabelTolerance) and not f_levelsClose(eng1_narr_liq_low, protectedLowLevel, rightEdgeLabelTolerance) and not f_levelsClose(eng1_narr_liq_low, eqLowLevel, rightEdgeLabelTolerance)

if barstate.islast
    // Lines (single instance per level)
    bool showExecEqHighLine = showEqHighVisual and not showDealingRangeVisual
    bool showExecEqLowLine = showEqLowVisual and not showDealingRangeVisual
    eng2BslLine := f_eng2_syncBoundedHLine(eng2BslLine, eqHighLevel, color.new(liqHighColor, 12), 1, line.style_solid, showExecEqHighLine)
    eng2SslLine := f_eng2_syncBoundedHLine(eng2SslLine, eqLowLevel, color.new(liqLowColor, 12), 1, line.style_solid, showExecEqLowLine)
    eng2ProtectedHighLine := f_eng2_syncBoundedHLine(eng2ProtectedHighLine, protectedHighLevel, color.new(liqHighColor, 8), 2, line.style_solid, showProtectedHighVisual)
    eng2ProtectedLowLine := f_eng2_syncBoundedHLine(eng2ProtectedLowLine, protectedLowLevel, color.new(liqLowColor, 8), 2, line.style_solid, showProtectedLowVisual)
    eng2CtxHighLine := f_eng2_syncBoundedHLine(eng2CtxHighLine, htfStructureHighLevel, color.new(color.fuchsia, 15), 2, line.style_solid, showHtfHighVisual)
    eng2CtxLowLine := f_eng2_syncBoundedHLine(eng2CtxLowLine, htfStructureLowLevel, color.new(color.fuchsia, 15), 2, line.style_solid, showHtfLowVisual)

    int dealingLeftBar = showDealingRangeVisual ? eng2DealLeftBar : na
    int dealingRightBar = bar_index
    color dealingBoundaryColor = eng2DealBroken ? color.new(color.silver, 78) : color.new(color.silver, 35)
    color dealingEqColor = eng2DealBroken ? color.new(color.silver, 78) : decisionEqColor
    string dealingBoundaryStyle = eng2DealBroken ? line.style_dotted : line.style_solid
    string dealingEqStyle = eng2DealBroken ? line.style_dotted : line.style_dashed
    color dealingPremiumFill = eng2DealBroken ? color.new(color.silver, 94) : decisionPremiumFillColor
    color dealingDiscountFill = eng2DealBroken ? color.new(color.silver, 94) : decisionDiscountFillColor

    eng2RangeHighLine := f_eng2_syncSegmentHLine(eng2RangeHighLine, dealingLeftBar, dealingRightBar, dealingRangeHighLevel, dealingBoundaryColor, 1, dealingBoundaryStyle, showDealingRangeVisual)
    eng2RangeLowLine := f_eng2_syncSegmentHLine(eng2RangeLowLine, dealingLeftBar, dealingRightBar, dealingRangeLowLevel, dealingBoundaryColor, 1, dealingBoundaryStyle, showDealingRangeVisual)
    eng2RangeEqLine := f_eng2_syncSegmentHLine(eng2RangeEqLine, dealingLeftBar, dealingRightBar, dealingRangeEqLevel, dealingEqColor, 2, dealingEqStyle, showDealingRangeVisual)
    eng2RangeQ25Line := f_eng2_syncSegmentHLine(eng2RangeQ25Line, dealingLeftBar, dealingRightBar, dealingRangeQ25, color.new(color.silver, eng2DealBroken ? 86 : 78), 1, line.style_dotted, showDealingRangeVisual)
    eng2RangeQ75Line := f_eng2_syncSegmentHLine(eng2RangeQ75Line, dealingLeftBar, dealingRightBar, dealingRangeQ75, color.new(color.silver, eng2DealBroken ? 86 : 78), 1, line.style_dotted, showDealingRangeVisual)
    eng2RangePremiumFill := f_eng2_syncLineFill(eng2RangePremiumFill, eng2RangeHighLine, eng2RangeEqLine, dealingPremiumFill, showDealingRangeVisual)
    eng2RangeDiscountFill := f_eng2_syncLineFill(eng2RangeDiscountFill, eng2RangeEqLine, eng2RangeLowLine, dealingDiscountFill, showDealingRangeVisual)

    bool showDealingOte = showOteVisual and showDealingRangeVisual
    color oteBullLineColor = color.new(bullColor, eng2DealBroken ? 80 : 40)
    color oteBearLineColor = color.new(bearColor, eng2DealBroken ? 80 : 40)
    color oteBullFillColor = eng2DealBroken ? color.new(color.silver, 94) : color.new(bullColor, 92)
    color oteBearFillColor = eng2DealBroken ? color.new(color.silver, 94) : color.new(bearColor, 92)
    string oteStyle = eng2DealBroken ? line.style_dotted : line.style_solid
    eng2OteLongTopLine := f_eng2_syncSegmentHLine(eng2OteLongTopLine, dealingLeftBar, dealingRightBar, oteLongTopLevel, oteBullLineColor, 1, oteStyle, showDealingOte)
    eng2OteLongBottomLine := f_eng2_syncSegmentHLine(eng2OteLongBottomLine, dealingLeftBar, dealingRightBar, oteLongBottomLevel, oteBullLineColor, 1, oteStyle, showDealingOte)
    eng2OteLongFill := f_eng2_syncLineFill(eng2OteLongFill, eng2OteLongTopLine, eng2OteLongBottomLine, oteBullFillColor, showDealingOte)
    eng2OteShortTopLine := f_eng2_syncSegmentHLine(eng2OteShortTopLine, dealingLeftBar, dealingRightBar, oteShortTopLevel, oteBearLineColor, 1, oteStyle, showDealingOte)
    eng2OteShortBottomLine := f_eng2_syncSegmentHLine(eng2OteShortBottomLine, dealingLeftBar, dealingRightBar, oteShortBottomLevel, oteBearLineColor, 1, oteStyle, showDealingOte)
    eng2OteShortFill := f_eng2_syncLineFill(eng2OteShortFill, eng2OteShortTopLine, eng2OteShortBottomLine, oteBearFillColor, showDealingOte)

    eng2RiskLongEntryLine := f_eng2_syncBoundedHLine(eng2RiskLongEntryLine, riskLongEntryLevel, color.new(bullColor, 0), 2, line.style_solid, showLongRiskVisual)
    eng2RiskShortEntryLine := f_eng2_syncBoundedHLine(eng2RiskShortEntryLine, riskShortEntryLevel, color.new(bearColor, 0), 2, line.style_solid, showShortRiskVisual)
    eng2RiskLongStopLine := f_eng2_syncBoundedHLine(eng2RiskLongStopLine, riskBullStopLevel, color.new(bearColor, 0), 1, line.style_solid, showLongRiskVisual)
    eng2RiskShortStopLine := f_eng2_syncBoundedHLine(eng2RiskShortStopLine, riskBearStopLevel, color.new(bullColor, 0), 1, line.style_solid, showShortRiskVisual)
    eng2RiskLongTargetLine := f_eng2_syncBoundedHLine(eng2RiskLongTargetLine, riskLongTargetLevel, color.new(liqHighColor, 0), 1, line.style_solid, showLongRiskVisual)
    eng2RiskShortTargetLine := f_eng2_syncBoundedHLine(eng2RiskShortTargetLine, riskShortTargetLevel, color.new(liqLowColor, 0), 1, line.style_solid, showShortRiskVisual)

    // Right-edge labels
    bool showDealingBslLabel = draw_show_right_labels and showDealingRangeVisual
    bool showDealingSslLabel = draw_show_right_labels and showDealingRangeVisual
    bool showExecBslLabel = showEqHighRightLabel and not showDealingRangeVisual
    bool showExecSslLabel = showEqLowRightLabel and not showDealingRangeVisual
    float bslLabelLevel = showDealingRangeVisual ? dealingRangeHighLevel : eqHighLevel
    float sslLabelLevel = showDealingRangeVisual ? dealingRangeLowLevel : eqLowLevel
    eqHighLabel := f_draw_right_edge_label(eqHighLabel, bslLabelLevel, "BSL", color.new(liqHighColor, 12), color.white, showDealingBslLabel or showExecBslLabel)
    eqLowLabel := f_draw_right_edge_label(eqLowLabel, sslLabelLevel, "SSL", color.new(liqLowColor, 12), color.white, showDealingSslLabel or showExecSslLabel)
    eng2DealEqLabel := f_draw_right_edge_label(eng2DealEqLabel, dealingRangeEqLevel, "EQ", color.new(decisionEqColor, 0), color.white, draw_show_right_labels and showDealingRangeVisual)
    protectedHighLabel := f_draw_right_edge_label(protectedHighLabel, protectedHighLevel, "Prot H", color.new(liqHighColor, 8), color.white, showProtectedHighRightLabel)
    protectedLowLabel := f_draw_right_edge_label(protectedLowLabel, protectedLowLevel, "Prot L", color.new(liqLowColor, 8), color.white, showProtectedLowRightLabel)
    htfHighLabel := f_draw_right_edge_label(htfHighLabel, htfStructureHighLevel, "Ctx H", color.new(color.fuchsia, 15), color.white, showHtfHighRightLabel)
    htfLowLabel := f_draw_right_edge_label(htfLowLabel, htfStructureLowLevel, "Ctx L", color.new(color.fuchsia, 15), color.white, showHtfLowRightLabel)
    eng2NarrHighLabel := f_draw_right_edge_label(eng2NarrHighLabel, eng1_narr_liq_high, "Nar H", color.new(color.silver, 55), color.white, showNarrHighRightLabel)
    eng2NarrLowLabel := f_draw_right_edge_label(eng2NarrLowLabel, eng1_narr_liq_low, "Nar L", color.new(color.silver, 55), color.white, showNarrLowRightLabel)
    longStopLabel := f_draw_right_edge_label(longStopLabel, riskBullStopLevel, "SL L", color.new(bearColor, 0), color.white, showLongStopRightLabel)
    shortStopLabel := f_draw_right_edge_label(shortStopLabel, riskBearStopLevel, "SL S", color.new(bullColor, 0), color.white, showShortStopRightLabel)

// Bias tint should follow the MTF narrative chain: Narrative -> Context -> Execution.
int backdropBias = displayNarrBias != 0 ? displayNarrBias : (eng1CtxRangeReady and displayCtxBias != 0 ? displayCtxBias : displayExecBias)
color backdropColor = backdropBias == 1 ? bullColor : backdropBias == -1 ? bearColor : neutralColor
// Keep bias tint subtle so it doesn't overpower zones/candles.
int backdropAlpha = backdropBias == 0 ? 95 : 92
chartBackdrop = showTrendBackground and not compactMode ? color.new(backdropColor, backdropAlpha) : na
bgcolor(chartBackdrop)

//------------------------------------------------------------------------------
// ENGINE 4 (DASHBOARD SNAPSHOT)
// Keep table rendering dumb: rows read these snapshots instead of rebuilding
// engine logic inline. This follows MAIN_CONTRACT and makes future pruning safer.
//------------------------------------------------------------------------------
string eng4_exec_market = "Px " + f_formatLevel(close)
string eng4_exec_long = longExecutionState
string eng4_exec_short = shortExecutionState
string eng4_bias_market = f_biasSummary(displayExecBias, eng1CtxRangeReady, displayCtxBias, displayNarrBias, eng1_exec_valid ? eng1_narr_strength : "Flat")
string eng4_bias_long = (eng1CtxRangeReady ? f_alignmentShortText(true, displayExecBias, displayCtxBias) : "G") + " / " + f_regimeSideShortText(true, displayNarrBias, eng1_exec_valid ? eng1_narr_strength : "Flat")
string eng4_bias_short = (eng1CtxRangeReady ? f_alignmentShortText(false, displayExecBias, displayCtxBias) : "G") + " / " + f_regimeSideShortText(false, displayNarrBias, eng1_exec_valid ? eng1_narr_strength : "Flat")
string eng4_pref_market = f_preferredExecutionText(preferredDirection, longExecutionState, shortExecutionState, false)
string eng4_setup_long = f_eng4_setup_text(longSetupDisplay, eng4LongRetired)
string eng4_setup_short = f_eng4_setup_text(shortSetupDisplay, eng4ShortRetired)
string eng4_zone_long = f_eng4_zone_text(tradeLongValidTop, tradeLongValidBottom, tradeLongEntry, eng4LongRetired)
string eng4_zone_short = f_eng4_zone_text(tradeShortValidTop, tradeShortValidBottom, tradeShortEntry, eng4ShortRetired)
string eng4_target_market = f_eng4_market_summary(f_targetModeText(not na(activeLongTarget), longUsesExternalDolTarget, longTargetIsLiquidity), eng4LongRetired, f_targetModeText(not na(activeShortTarget), shortUsesExternalDolTarget, shortTargetIsLiquidity), eng4ShortRetired)
string eng4_risk_long = f_eng4_risk_text(tradeLongStop, activeLongTarget, eng4LongRetired)
string eng4_risk_short = f_eng4_risk_text(tradeShortStop, activeShortTarget, eng4ShortRetired)
string eng4_rr_long = f_eng4_rr_text(longRr, longConfidence, eng4LongRetired)
string eng4_rr_short = f_eng4_rr_text(shortRr, shortConfidence, eng4ShortRetired)
string eng4_draw_long = f_eng4_level_text(eng4LongDrawLevel, eng4LongRetired)
string eng4_draw_short = f_eng4_level_text(eng4ShortDrawLevel, eng4ShortRetired)
string eng4_life_long = f_eng4_life_text(longSetupAge, tradeLongTouched, eng4LongRetired)
string eng4_life_short = f_eng4_life_text(shortSetupAge, tradeShortTouched, eng4ShortRetired)
string eng4_session_market = f_eng4_session_text(liquiditySessionSummary, timezoneSummary, strictModeEnabled, ipdaWindowSummary)
string eng4_confirm_long = f_eng4_confirmation_text(not na(tradeLongEntry), strictModeEnabled, eng3LongTimePass, eng3LongBiasPass, eng3LongContextPass, eng3LongSweepPass, eng3LongMssPass, eng3LongDisplacementPass, eng3LongPdPass, eng3LongOtePass, eng3LongDolPass, tradeLongIsFvg, tradeLongIsOb, longUsesExternalDolTarget, longExecutionState, eng4LongRetired)
string eng4_confirm_short = f_eng4_confirmation_text(not na(tradeShortEntry), strictModeEnabled, eng3ShortTimePass, eng3ShortBiasPass, eng3ShortContextPass, eng3ShortSweepPass, eng3ShortMssPass, eng3ShortDisplacementPass, eng3ShortPdPass, eng3ShortOtePass, eng3ShortDolPass, tradeShortIsFvg, tradeShortIsOb, shortUsesExternalDolTarget, shortExecutionState, eng4ShortRetired)
string eng4_next_market = ipdaCycleMarketFullText + " | " + eng1StageSummary
string eng4_next_long = f_ipdaNextActionText(not na(tradeLongEntry), longExecutionState, effectiveLongDirectional, effectiveLongSweepSeen, effectiveLongMssSeen, effectiveLongDisplacementSeen, ipdaLongCyclePhase, true)
string eng4_next_short = f_ipdaNextActionText(not na(tradeShortEntry), shortExecutionState, effectiveShortDirectional, effectiveShortSweepSeen, effectiveShortMssSeen, effectiveShortDisplacementSeen, ipdaShortCyclePhase, false)
string eng4_deal_status = dealingRangeStatusText
string eng4_deal_zone = dealingRangeZoneText
string eng4_deal_range = f_formatRange(dealingRangeHighLevel, dealingRangeLowLevel)
string eng4_deal_eq = f_formatLevel(dealingRangeEqLevel)
string eng4_ote_market = "IRL " + dealingRangeIrlText
string eng4_ote_long = f_formatRange(oteLongTopLevel, oteLongBottomLevel)
string eng4_ote_short = f_formatRange(oteShortTopLevel, oteShortBottomLevel)
bool eng4_compact_retired = compactUseLong ? eng4LongRetired : eng4ShortRetired
string eng4_compact_header = f_preferredExecutionText(preferredDirection, longExecutionState, shortExecutionState, true)
string eng4_compact_biases = f_biasShort(displayNarrBias) + "/" + (eng1CtxRangeReady ? f_biasShort(displayCtxBias) : "Guard") + "/" + f_biasShort(displayExecBias)
string eng4_compact_setup = compactBalanced ? "Both active" : compactWaiting and compactExecutionState == "Ambiguous" ? f_eng4_setup_text(compactSetup, eng4_compact_retired) + " | Ambg" : compactWaiting and compactContextOnly and compactCandidateHasSetup and not compactCandidateRetired ? f_eng4_setup_text(compactSetup, eng4_compact_retired) + " | Ctx" : compactWaiting ? "Scan both" : f_eng4_setup_text(compactSetup, eng4_compact_retired)
string eng4_compact_zone = compactNeutral ? "-" : f_eng4_detail_text(f_formatRange(compactZoneTop, compactZoneBottom), eng4_compact_retired)
string eng4_compact_plan = compactNeutral ? "-" : f_eng4_plan_text(compactEntry, compactStop, compactTarget, eng4_compact_retired)
string eng4_compact_exec = compactBalanced ? "Mixed" : compactWaiting and compactExecutionState == "Ambiguous" ? f_executionStateCompact(compactExecutionState) : compactWaiting and compactContextOnly and compactCandidateHasSetup and not compactCandidateRetired ? "Ctx" : compactWaiting ? "Scan" : f_executionStateCompact(compactExecutionState)
string eng4_compact_conf_label = compactNeutral ? (compactContextOnly ? "Ctx L/S" : "Conf L/S") : "Conf"
string eng4_compact_conf = compactNeutral ? "L " + f_eng4_detail_text(f_formatPercent(longConfidence), eng4LongRetired) + " / S " + f_eng4_detail_text(f_formatPercent(shortConfidence), eng4ShortRetired) : f_eng4_detail_text(f_formatPercent(compactConfidence), eng4_compact_retired)
string eng4_compact_draw = compactNeutral ? "-" : f_eng4_rr_draw_text(compactRr, eng4PrimaryDrawLevel, eng4_compact_retired)
string eng4_compact_life = compactBalanced ? "Mixed" : compactWaiting and compactContextOnly and compactCandidateHasSetup and not compactCandidateRetired ? f_eng4_detail_text(f_compactLifecycleText(compactUseLong, longSetupAge, tradeLongTouched, shortSetupAge, tradeShortTouched), eng4_compact_retired) : compactWaiting ? "Scan" : f_eng4_detail_text(f_compactLifecycleText(compactUseLong, longSetupAge, tradeLongTouched, shortSetupAge, tradeShortTouched), eng4_compact_retired)
string eng4_compact_mode = usagePreset + " | " + ipdaCycleMarketText + " | " + eng1StageSummary
string eng4_compact_sessions = eng4_session_market
bool eng4_show_full_dashboard = barstate.islast and showDashboard and not compactDashboardMode
bool eng4_show_compact_dashboard = barstate.islast and showDashboard and compactDashboardMode
bool eng4_clear_dashboard = barstate.islast and not showDashboard

//------------------------------------------------------------------------------
// Dashboard render
//------------------------------------------------------------------------------
var table dashboard = table.new(position.top_right, 4, 15, border_width=1)
var table dashboardCompact = table.new(position.bottom_right, 2, 11, border_width=1)
var table structureDashboard = table.new(position.bottom_right, 2, 5, border_width=1)

//------------------------------------------------------------------------------
// Market structure mini panel
//------------------------------------------------------------------------------
bool showStructureDashboard = barstate.islast and showDashboard and showMarketStructure and eng2StructureVisualsEnabled and not compactDashboardMode
bool swingSignalIsLatest = not na(eng2SwingLastEventBar) and (na(eng2InternalLastEventBar) or eng2SwingLastEventBar >= eng2InternalLastEventBar)
string structureLastSignalText = swingSignalIsLatest ? f_structureSignalText(eng2SwingLastEventText, eng2SwingTrend, eng2SwingLastEventBar) : f_structureSignalText(eng2InternalLastEventText, eng2InternalTrend, eng2InternalLastEventBar)
int structureLastSignalBias = swingSignalIsLatest ? eng2SwingTrend : eng2InternalTrend

if showStructureDashboard
    f_setCellSmall(structureDashboard, 0, 0, "MARKET", color.white, panelHeaderBg)
    f_setCellSmall(structureDashboard, 1, 0, "STRUCTURE", color.white, panelHeaderBg)
    f_setCellSmall(structureDashboard, 0, 1, "Internal", color.new(color.white, 25), panelCellBg)
    f_setCellSmall(structureDashboard, 1, 1, f_structureSideText(eng2InternalTrend) + " " + f_structureArrowText(eng2InternalTrend), color.white, f_structureTone(eng2InternalTrend))
    f_setCellSmall(structureDashboard, 0, 2, "Swing", color.new(color.white, 25), panelCellBg)
    f_setCellSmall(structureDashboard, 1, 2, f_structureSideText(eng2SwingTrend) + " " + f_structureArrowText(eng2SwingTrend), color.white, f_structureTone(eng2SwingTrend))
    f_setCellSmall(structureDashboard, 0, 3, "Alignment", color.new(color.white, 25), panelCellBg)
    f_setCellSmall(structureDashboard, 1, 3, f_structureAlignmentText(eng2InternalTrend, eng2SwingTrend), color.white, eng2InternalTrend != 0 and eng2InternalTrend == eng2SwingTrend ? f_structureTone(eng2InternalTrend) : color.new(neutralColor, 25))
    f_setCellSmall(structureDashboard, 0, 4, "Last Signal", color.new(color.white, 25), panelCellBg)
    f_setCellSmall(structureDashboard, 1, 4, structureLastSignalText, color.white, f_structureTone(structureLastSignalBias))
else if barstate.islast
    table.clear(structureDashboard, 0, 0, 1, 4)

if eng4_show_full_dashboard
    table.clear(dashboardCompact, 0, 0, 1, 10)
    f_setCell(dashboard, 0, 0, "Field", color.white, panelHeaderBg)
    f_setCell(dashboard, 1, 0, "Market", color.white, panelHeaderBg)
    f_setCell(dashboard, 2, 0, "Long", color.white, color.new(bullColor, 5))
    f_setCell(dashboard, 3, 0, "Short", color.white, color.new(bearColor, 5))

    f_setCell(dashboard, 0, 1, "Exec", color.white, panelCellBg)
    f_setCell(dashboard, 1, 1, eng4_exec_market, color.white, panelCellBg)
    f_setCell(dashboard, 2, 1, eng4_exec_long, color.white, panelBullBg)
    f_setCell(dashboard, 3, 1, eng4_exec_short, color.white, panelBearBg)

    f_setCell(dashboard, 0, 2, "Bias", color.white, panelCellBg)
    f_setCell(dashboard, 1, 2, eng4_bias_market, color.white, panelCellBg)
    f_setCell(dashboard, 2, 2, eng4_bias_long, color.white, panelBullBg)
    f_setCell(dashboard, 3, 2, eng4_bias_short, color.white, panelBearBg)

    f_setCell(dashboard, 0, 3, "Pref", color.white, panelCellBg)
    f_setCell(dashboard, 1, 3, eng4_pref_market, color.white, color.new(preferredDirection == "Long" ? bullColor : preferredDirection == "Short" ? bearColor : neutralColor, 15))
    f_setCell(dashboard, 2, 3, eng4_setup_long, color.white, panelBullBg)
    f_setCell(dashboard, 3, 3, eng4_setup_short, color.white, panelBearBg)

    f_setCell(dashboard, 0, 4, "Z / E", color.white, panelCellBg)
    f_setCell(dashboard, 1, 4, "POI | trig", color.white, panelCellBg)
    f_setCell(dashboard, 2, 4, eng4_zone_long, color.white, panelBullBg)
    f_setCell(dashboard, 3, 4, eng4_zone_short, color.white, panelBearBg)

    f_setCell(dashboard, 0, 5, "SL / TP", color.white, panelCellBg)
    f_setCell(dashboard, 1, 5, eng4_target_market, color.white, panelCellBg)
    f_setCell(dashboard, 2, 5, eng4_risk_long, color.white, panelBullBg)
    f_setCell(dashboard, 3, 5, eng4_risk_short, color.white, panelBearBg)

    f_setCell(dashboard, 0, 6, "RR / Cf", color.white, panelCellBg)
    f_setCell(dashboard, 1, 6, "RR | conf", color.white, panelCellBg)
    f_setCell(dashboard, 2, 6, eng4_rr_long, color.white, panelBullBg)
    f_setCell(dashboard, 3, 6, eng4_rr_short, color.white, panelBearBg)

    f_setCell(dashboard, 0, 7, "Draw", color.white, panelCellBg)
    f_setCell(dashboard, 1, 7, "DOL", color.white, panelCellBg)
    f_setCell(dashboard, 2, 7, eng4_draw_long, color.white, panelBullBg)
    f_setCell(dashboard, 3, 7, eng4_draw_short, color.white, panelBearBg)

    f_setCell(dashboard, 0, 8, "Life", color.white, panelCellBg)
    f_setCell(dashboard, 1, 8, "Age / touch", color.white, panelCellBg)
    f_setCell(dashboard, 2, 8, eng4_life_long, color.white, panelBullBg)
    f_setCell(dashboard, 3, 8, eng4_life_short, color.white, panelBearBg)

    f_setCell(dashboard, 0, 9, "Sess/Cfm", color.white, panelCellBg)
    f_setCell(dashboard, 1, 9, eng4_session_market, color.white, color.new(strictModeEnabled ? color.teal : neutralColor, 15))
    f_setCell(dashboard, 2, 9, eng4_confirm_long, color.white, panelBullBg)
    f_setCell(dashboard, 3, 9, eng4_confirm_short, color.white, panelBearBg)

    f_setCell(dashboard, 0, 10, "Next", color.white, panelCellBg)
    f_setCell(dashboard, 1, 10, eng4_next_market, color.white, panelCellBg)
    f_setCell(dashboard, 2, 10, eng4_next_long, color.white, panelBullBg)
    f_setCell(dashboard, 3, 10, eng4_next_short, color.white, panelBearBg)

    f_setCell(dashboard, 0, 11, "DR", color.white, panelCellBg)
    f_setCell(dashboard, 1, 11, "Status | zone", color.white, panelCellBg)
    f_setCell(dashboard, 2, 11, eng4_deal_status, color.white, color.new(showDealingRangeVisual ? bullColor : eng2DealBroken ? bearColor : neutralColor, 18))
    f_setCell(dashboard, 3, 11, eng4_deal_zone, color.white, color.new(eng4_deal_zone == "Discount" ? bullColor : eng4_deal_zone == "Premium" ? bearColor : neutralColor, 18))

    f_setCell(dashboard, 0, 12, "Range", color.white, panelCellBg)
    f_setCell(dashboard, 1, 12, "Low-High | EQ", color.white, panelCellBg)
    f_setCell(dashboard, 2, 12, eng4_deal_range, color.white, panelBullBg)
    f_setCell(dashboard, 3, 12, eng4_deal_eq, color.white, panelBearBg)

    f_setCell(dashboard, 0, 13, "OTE", color.white, panelCellBg)
    f_setCell(dashboard, 1, 13, eng4_ote_market, color.white, panelCellBg)
    f_setCell(dashboard, 2, 13, eng4_ote_long, color.white, panelBullBg)
    f_setCell(dashboard, 3, 13, eng4_ote_short, color.white, panelBearBg)
else if eng4_show_compact_dashboard
    table.clear(dashboard, 0, 0, 3, 14)
    f_setCell(dashboardCompact, 0, 0, "SMC Compact", color.white, panelHeaderBg)
    f_setCell(dashboardCompact, 1, 0, eng4_compact_header, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 1, "Biases", color.white, panelCellBg)
    // Order is Narrative / Context / Execution to match the top-down workflow.
    f_setCell(dashboardCompact, 1, 1, eng4_compact_biases, color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 2, "Setup", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 2, eng4_compact_setup, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 3, "Zone", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 3, eng4_compact_zone, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 4, "E / SL / TP", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 4, eng4_compact_plan, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 5, "Exec", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 5, eng4_compact_exec, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 6, eng4_compact_conf_label, color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 6, eng4_compact_conf, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 7, "R / DOL", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 7, eng4_compact_draw, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 8, "Life", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 8, eng4_compact_life, color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 9, "Mode", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 9, eng4_compact_mode, color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 10, "Sessions", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 10, eng4_compact_sessions, color.white, panelCellBg)
else if eng4_clear_dashboard
    table.clear(dashboardCompact, 0, 0, 1, 10)
    table.clear(dashboard, 0, 0, 3, 14)
