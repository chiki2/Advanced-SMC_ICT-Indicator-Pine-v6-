    eng1_ctx_liq_high := eng1_h4_eqh_active ? eng1_h4_eqh : eng1_h4_last_swing_high
    eng1_ctx_liq_low := eng1_h4_eql_active ? eng1_h4_eql : eng1_h4_last_swing_low
