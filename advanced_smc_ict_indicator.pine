    eng1_exe_bear_choch := eng1_m5_bear_choch
else if eng1_exec_tf == ENG1_TF_M15
    eng1_exe_trend_bias := eng1_m15_trend_bias
    eng1_exe_bull_bos := eng1_m15_bull_bos
    eng1_exe_bear_bos := eng1_m15_bear_bos
    eng1_exe_bull_choch := eng1_m15_bull_choch
    eng1_exe_bear_choch := eng1_m15_bear_choch
else if eng1_exec_tf == ENG1_TF_M30
    eng1_exe_trend_bias := eng1_m30_trend_bias
    eng1_exe_bull_bos := eng1_m30_bull_bos
    eng1_exe_bear_bos := eng1_m30_bear_bos
    eng1_exe_bull_choch := eng1_m30_bull_choch
    eng1_exe_bear_choch := eng1_m30_bear_choch
else if eng1_exec_tf == ENG1_TF_H1
    eng1_exe_trend_bias := eng1_h1_trend_bias
    eng1_exe_bull_bos := eng1_h1_bull_bos
    eng1_exe_bear_bos := eng1_h1_bear_bos
    eng1_exe_bull_choch := eng1_h1_bull_choch
    eng1_exe_bear_choch := eng1_h1_bear_choch

if eng1_exec_valid
    eng1_exe_bull_sweep := eng1_exe_bull_sweep_tmp
    eng1_exe_bear_sweep := eng1_exe_bear_sweep_tmp
    eng1_exe_bull_mss := eng1_exe_bull_mss_tmp
    eng1_exe_bear_mss := eng1_exe_bear_mss_tmp
    eng1_exe_bull_displacement := eng1_exe_bull_displacement_tmp
    eng1_exe_bear_displacement := eng1_exe_bear_displacement_tmp
    eng1_exe_mss_ref_high := eng1_exe_swing_high_tmp
    eng1_exe_mss_ref_low := eng1_exe_swing_low_tmp
    eng1_exe_eqh_active := not na(eng1_exe_eqh_tmp)
    eng1_exe_eql_active := not na(eng1_exe_eql_tmp)
    eng1_exe_liq_high := eng1_exe_eqh_active ? eng1_exe_eqh_tmp : eng1_exe_swing_high_tmp
    eng1_exe_liq_low := eng1_exe_eql_active ? eng1_exe_eql_tmp : eng1_exe_swing_low_tmp
else
    // Keep Engine 2 literal to Engine 1 ownership: unsupported execution TFs must
    // not reuse the last valid narrative/context/execution snapshot.
    eng1_narr_bias := 0
    eng1_narr_liq_high := na
    eng1_narr_liq_low := na
    eng1_narr_bull_sd_top := na
    eng1_narr_bull_sd_bottom := na
    eng1_narr_bear_sd_top := na
    eng1_narr_bear_sd_bottom := na
    eng1_narr_strength := "Flat"
    eng1_ctx_trend_bias := 0
    eng1_ctx_bull_breakout := false
    eng1_ctx_bear_breakout := false
    eng1_ctx_bull_choch := false
    eng1_ctx_bear_choch := false
    eng1_ctx_bull_ob_top := na
    eng1_ctx_bull_ob_bottom := na
    eng1_ctx_bull_ob_entry := na
    eng1_ctx_bull_ob_bar := na
    eng1_ctx_bull_ob_breaker := false
    eng1_ctx_bull_ob_breaker_time := na
    eng1_ctx_bull_fvg_top := na
    eng1_ctx_bull_fvg_bottom := na
    eng1_ctx_bull_fvg_bar := na
    eng1_ctx_bear_ob_top := na
    eng1_ctx_bear_ob_bottom := na
    eng1_ctx_bear_ob_entry := na
    eng1_ctx_bear_ob_bar := na
    eng1_ctx_bear_ob_breaker := false
    eng1_ctx_bear_ob_breaker_time := na
    eng1_ctx_bear_fvg_top := na
    eng1_ctx_bear_fvg_bottom := na
    eng1_ctx_bear_fvg_bar := na
    eng1_ctx_liq_high := na
    eng1_ctx_liq_low := na
    eng1_ctx_liq_high_bar := na
    eng1_ctx_liq_low_bar := na
    eng1_exe_trend_bias := 0
    eng1_exe_bull_sweep := false
    eng1_exe_bear_sweep := false
    eng1_exe_bull_bos := false
    eng1_exe_bear_bos := false
    eng1_exe_bull_choch := false
    eng1_exe_bear_choch := false
    eng1_exe_bull_mss := false
    eng1_exe_bear_mss := false
    eng1_exe_bull_displacement := false
    eng1_exe_bear_displacement := false
    eng1_exe_mss_ref_high := na
    eng1_exe_mss_ref_low := na
    eng1_exe_liq_high := na
    eng1_exe_liq_low := na
    eng1_exe_eqh_active := false
    eng1_exe_eql_active := false

chartTfLabel = timeframe.main_period
chartTfSeconds = timeframe.in_seconds()
normalizationBaselineTfSeconds = timeframe.in_seconds("5")
expiryBarsEffective = f_timeNormalizedBars(setupExpiryBars, normalizationBaselineTfSeconds, chartTfSeconds, 4)
strictMssLookbackEffective = f_timeNormalizedBars(strictMssLookback, normalizationBaselineTfSeconds, chartTfSeconds, 2)
int ctxTfSeconds = eng1_ctx_tf == ENG1_TF_M15 ? timeframe.in_seconds("15") : eng1_ctx_tf == ENG1_TF_M30 ? timeframe.in_seconds("30") : eng1_ctx_tf == ENG1_TF_H1 ? timeframe.in_seconds("60") : eng1_ctx_tf == ENG1_TF_H4 ? timeframe.in_seconds("240") : eng1_ctx_tf == ENG1_TF_D1 ? timeframe.in_seconds("1D") : normalizationBaselineTfSeconds
int strictPdOwnershipWindow = f_timeNormalizedBars(2, ctxTfSeconds, chartTfSeconds, 2)
if not eng1_exec_valid
    f_trimSessionVisuals(0)
    f_trimStructureVisuals(0)
eng1InvalidTfLabel := f_eng1_sync_invalid_tf_label(eng1InvalidTfLabel, eng1_exec_valid, chartTfLabel, high, atrSafe)

//------------------------------------------------------------------------------
// Session liquidity tracking
//------------------------------------------------------------------------------
inAsiaSession = f_inSessionWindow(asiaSessionWindow)
newAsiaSession = inAsiaSession and not inAsiaSession[1]
asiaSessionEnded = not inAsiaSession and inAsiaSession[1]
inLondonSession = f_inSessionWindow(londonSessionWindow)
newLondonSession = inLondonSession and not inLondonSession[1]
londonSessionEnded = not inLondonSession and inLondonSession[1]
inNewYorkSession = f_inSessionWindow(newYorkSessionWindow)
newNewYorkSession = inNewYorkSession and not inNewYorkSession[1]
newYorkSessionEnded = not inNewYorkSession and inNewYorkSession[1]
vAsOn = inAsiaSession and not inLondonSession and not inNewYorkSession
vAsNew = vAsOn and not vAsOn[1]
vAsEnd = not vAsOn and vAsOn[1]
vLdOn = inLondonSession and not inNewYorkSession
vLdNew = vLdOn and not vLdOn[1]
vLdEnd = not vLdOn and vLdOn[1]
vNyOn = inNewYorkSession
vNyNew = vNyOn and not vNyOn[1]
vNyEnd = not vNyOn and vNyOn[1]

if timeframe.isintraday
    [asiaSessionHighNext, asiaSessionLowNext] = f_updateSessionRange(inAsiaSession, newAsiaSession, asiaSessionHigh, asiaSessionLow)
    [londonSessionHighNext, londonSessionLowNext] = f_updateSessionRange(inLondonSession, newLondonSession, londonSessionHigh, londonSessionLow)
    [newYorkSessionHighNext, newYorkSessionLowNext] = f_updateSessionRange(inNewYorkSession, newNewYorkSession, newYorkSessionHigh, newYorkSessionLow)
    [vAsHiNext, vAsLoNext] = f_updateSessionRange(vAsOn, vAsNew, vAsHi, vAsLo)
    [vLdHiNext, vLdLoNext] = f_updateSessionRange(vLdOn, vLdNew, vLdHi, vLdLo)
    [vNyHiNext, vNyLoNext] = f_updateSessionRange(vNyOn, vNyNew, vNyHi, vNyLo)
    if vAsEnd and not na(atrSafe[1])
        sessRefAtr := atrSafe[1]
        sessRefCode := "AS"
    if vLdEnd and not na(atrSafe[1])
        sessRefAtr := atrSafe[1]
        sessRefCode := "LDN"
    if vNyEnd and not na(atrSafe[1])
        sessRefAtr := atrSafe[1]
        sessRefCode := "NY"
    asiaSessionHigh := asiaSessionHighNext
    asiaSessionLow := asiaSessionLowNext
    londonSessionHigh := londonSessionHighNext
    londonSessionLow := londonSessionLowNext
    newYorkSessionHigh := newYorkSessionHighNext
    newYorkSessionLow := newYorkSessionLowNext
    vAsHi := vAsHiNext
    vAsLo := vAsLoNext
    vLdHi := vLdHiNext
    vLdLo := vLdLoNext
    vNyHi := vNyHiNext
    vNyLo := vNyLoNext

//------------------------------------------------------------------------------
// Execution liquidity (Engine 1 owned)
//------------------------------------------------------------------------------

//------------------------------------------------------------------------------
// Calendar liquidity references (ICT naming)
//------------------------------------------------------------------------------
bool calendarLiquidityVisualsEnabled = eng1_exec_valid and showLiquidity and draw_show_htf and not compactMode and draw_mode != "Minimal"
bool calendarLiquidityRequestEnabled = lastBar and calendarLiquidityVisualsEnabled
bool calendarDayFromEng1Ready = calendarLiquidityRequestEnabled and eng1_d1_active_tf and array.size(eng1_buf_d1_high) > 0 and array.size(eng1_buf_d1_low) > 0
[prevDayHighRequested, prevDayLowRequested] = f_prev_period_high_low(calendarLiquidityRequestEnabled and not calendarDayFromEng1Ready, "D")
prevDayHigh = calendarDayFromEng1Ready ? f_eng1_buf_float_at(eng1_buf_d1_high, 0) : prevDayHighRequested
prevDayLow = calendarDayFromEng1Ready ? f_eng1_buf_float_at(eng1_buf_d1_low, 0) : prevDayLowRequested
[prevWeekHigh, prevWeekLow] = f_prev_period_high_low(calendarLiquidityRequestEnabled, "W")
[prevMonthHigh, prevMonthLow] = f_prev_period_high_low(calendarLiquidityRequestEnabled, "M")

// Active bias aliases (Engine 1 owned). Keep downstream logic on these aliases
// so display, structure visuals, and setup validation read the same snapshot.
int displayExecBias = eng1_exe_trend_bias
int displayCtxBias = eng1_ctx_trend_bias
int displayNarrBias = eng1_narr_bias

//------------------------------------------------------------------------------
// Market structure state (Engine 1 owned)
// Engine 2 no longer derives market structure from chart-active pivots. This
// keeps structure visuals aligned with closed-candle Engine 1 snapshots and
// avoids local pivot churn in #main.
//------------------------------------------------------------------------------
bool eng2StructureVisualsEnabled = eng1_exec_valid and draw_show_structure
[eng2InternalSwingHigh, eng2InternalSwingHighBar, eng2InternalSwingLow, eng2InternalSwingLowBar] = f_eng1_select_execution_structure_points(eng1_exec_tf)
if not eng2StructureVisualsEnabled
    f_trimStructureVisuals(0)
    eng2StructureLastRenderBar := na
    eng2StructureRenderedTfKey := ""
    eng2StructureRenderFingerprint := ""
else
    string eng2ActiveStructureTfKey = eng1_exec_tf + "|" + eng1_ctx_tf
    if eng2StructureRenderedTfKey != eng2ActiveStructureTfKey
        f_trimStructureVisuals(0)
        eng2StructureLastRenderBar := na
        eng2StructureRenderedTfKey := eng2ActiveStructureTfKey
        eng2StructureRenderFingerprint := ""
    bool eng2ExecStructureNewClosed = (eng1_exec_tf == ENG1_TF_M1 and eng1_m1_new_closed_bar) or (eng1_exec_tf == ENG1_TF_M5 and eng1_m5_new_closed_bar) or (eng1_exec_tf == ENG1_TF_M15 and eng1_m15_new_closed_bar) or (eng1_exec_tf == ENG1_TF_M30 and eng1_m30_new_closed_bar) or (eng1_exec_tf == ENG1_TF_H1 and eng1_h1_new_closed_bar)
    bool eng2CtxStructureNewClosed = (eng1_ctx_tf == ENG1_TF_M15 and eng1_m15_new_closed_bar) or (eng1_ctx_tf == ENG1_TF_M30 and eng1_m30_new_closed_bar) or (eng1_ctx_tf == ENG1_TF_H1 and eng1_h1_new_closed_bar) or (eng1_ctx_tf == ENG1_TF_H4 and eng1_h4_new_closed_bar) or (eng1_ctx_tf == ENG1_TF_D1 and eng1_d1_new_closed_bar)
    bool eng2StructureSourceChanged = eng2ExecStructureNewClosed or eng2CtxStructureNewClosed
    if lastBar
        bool mayRenderStruct = na(eng2StructureLastRenderBar) or eng2StructureSourceChanged
        if mayRenderStruct
            bool iBullEv = eng1_exe_bull_choch or eng1_exe_bull_mss or eng1_exe_bull_bos
            bool iBearEv = eng1_exe_bear_choch or eng1_exe_bear_mss or eng1_exe_bear_bos
            bool sBullEv = eng1_ctx_bull_breakout or eng1_ctx_bull_choch
            bool sBearEv = eng1_ctx_bear_breakout or eng1_ctx_bear_choch
            string pointFp = eng2ActiveStructureTfKey
            pointFp := pointFp + "|" + str.tostring(eng2InternalSwingHighBar) + "|" + str.tostring(eng2InternalSwingHigh)
            pointFp := pointFp + "|" + str.tostring(eng2InternalSwingLowBar) + "|" + str.tostring(eng2InternalSwingLow)
            pointFp := pointFp + "|" + str.tostring(displayExecBias) + "|" + str.tostring(displayCtxBias)
            pointFp := pointFp + "|" + str.tostring(eng1_ctx_liq_high_bar) + "|" + str.tostring(eng1_ctx_liq_high)
            pointFp := pointFp + "|" + str.tostring(eng1_ctx_liq_low_bar) + "|" + str.tostring(eng1_ctx_liq_low)
            string eventFp = str.tostring(iBullEv) + "|" + str.tostring(iBearEv) + "|" + str.tostring(sBullEv) + "|" + str.tostring(sBearEv)
            string snapFp = pointFp + "|" + eventFp
            bool needsStructRender = na(eng2StructureLastRenderBar) or eng2StructureRenderFingerprint != snapFp
            if needsStructRender
                f_trimStructureVisuals(0)
                int eng2ExecNodeCap = draw_full ? (freeSafeMode ? (eng1_exec_tf == "1" ? 5 : eng1_exec_tf == "5" ? 6 : 8) : (eng1_exec_tf == "1" ? 12 : eng1_exec_tf == "5" ? 16 : 20)) : (eng1_exec_tf == "1" ? 10 : eng1_exec_tf == "5" ? 14 : 20)
                int eng2ExecEventCap = draw_full ? (freeSafeMode ? (eng1_exec_tf == "1" ? 2 : eng1_exec_tf == "5" ? 3 : 4) : (eng1_exec_tf == "1" ? 6 : eng1_exec_tf == "5" ? 8 : 10)) : (eng1_exec_tf == "1" ? 6 : eng1_exec_tf == "5" ? 8 : 12)
                int eng2SwingNodeCap = freeSafeMode ? 4 : 12
                int eng2SwingEventCap = freeSafeMode ? 2 : 5
                int eng2ExecScanCap = draw_full ? (freeSafeMode ? 60 : 180) : (freeSafeMode ? 90 : 150)
                int eng2CtxScanCap = draw_full ? (freeSafeMode ? 35 : 140) : (freeSafeMode ? 70 : 120)
                if eng1_exec_tf == ENG1_TF_M1
                    f_eng2_backfill_structure_from_buffer(true, eng1_buf_m1_time, eng1_buf_m1_high, eng1_buf_m1_low, eng1_buf_m1_close, ENG1_SWING_LEN, eng2ExecScanCap, eng2ExecNodeCap, eng2ExecEventCap)
                else if eng1_exec_tf == ENG1_TF_M5
                    f_eng2_backfill_structure_from_buffer(true, eng1_buf_m5_time, eng1_buf_m5_high, eng1_buf_m5_low, eng1_buf_m5_close, ENG1_SWING_LEN, eng2ExecScanCap, eng2ExecNodeCap, eng2ExecEventCap)
                else if eng1_exec_tf == ENG1_TF_M15
                    f_eng2_backfill_structure_from_buffer(true, eng1_buf_m15_time, eng1_buf_m15_high, eng1_buf_m15_low, eng1_buf_m15_close, ENG1_SWING_LEN, eng2ExecScanCap, eng2ExecNodeCap, eng2ExecEventCap)
                else if eng1_exec_tf == ENG1_TF_M30
                    f_eng2_backfill_structure_from_buffer(true, eng1_buf_m30_time, eng1_buf_m30_high, eng1_buf_m30_low, eng1_buf_m30_close, ENG1_SWING_LEN, eng2ExecScanCap, eng2ExecNodeCap, eng2ExecEventCap)
                else if eng1_exec_tf == ENG1_TF_H1
                    f_eng2_backfill_structure_from_buffer(true, eng1_buf_h1_time, eng1_buf_h1_high, eng1_buf_h1_low, eng1_buf_h1_close, ENG1_SWING_LEN, eng2ExecScanCap, eng2ExecNodeCap, eng2ExecEventCap)
                if eng1_ctx_tf == ENG1_TF_M15
                    f_eng2_backfill_structure_from_buffer(false, eng1_buf_m15_time, eng1_buf_m15_high, eng1_buf_m15_low, eng1_buf_m15_close, ENG1_SWING_LEN, eng2CtxScanCap, eng2SwingNodeCap, eng2SwingEventCap)
                else if eng1_ctx_tf == ENG1_TF_M30
                    f_eng2_backfill_structure_from_buffer(false, eng1_buf_m30_time, eng1_buf_m30_high, eng1_buf_m30_low, eng1_buf_m30_close, ENG1_SWING_LEN, eng2CtxScanCap, eng2SwingNodeCap, eng2SwingEventCap)
                else if eng1_ctx_tf == ENG1_TF_H1
                    f_eng2_backfill_structure_from_buffer(false, eng1_buf_h1_time, eng1_buf_h1_high, eng1_buf_h1_low, eng1_buf_h1_close, ENG1_SWING_LEN, eng2CtxScanCap, eng2SwingNodeCap, eng2SwingEventCap)
                else if eng1_ctx_tf == ENG1_TF_H4
                    f_eng2_backfill_structure_from_buffer(false, eng1_buf_h4_time, eng1_buf_h4_high, eng1_buf_h4_low, eng1_buf_h4_close, ENG1_SWING_LEN, eng2CtxScanCap, eng2SwingNodeCap, eng2SwingEventCap)
                else if eng1_ctx_tf == ENG1_TF_D1
                    f_eng2_backfill_structure_from_buffer(false, eng1_buf_d1_time, eng1_buf_d1_high, eng1_buf_d1_low, eng1_buf_d1_close, ENG1_SWING_LEN, eng2CtxScanCap, eng2SwingNodeCap, eng2SwingEventCap)
                // Safety net: when the historical backfill window has too few confirmed
                // pivots, still render the latest Engine 1 snapshots so Full mode never
                // looks like market structure is disabled.
                if array.size(eng2InternalStructureNodeHistory) == 0
                    f_eng2_backfill_structure_node(true, eng2InternalSwingHighBar, eng2InternalSwingHigh, displayExecBias == -1 ? "LH" : displayExecBias == 1 ? "HH" : "H", true, eng2ExecNodeCap)
                    f_eng2_backfill_structure_node(true, eng2InternalSwingLowBar, eng2InternalSwingLow, displayExecBias == 1 ? "HL" : displayExecBias == -1 ? "LL" : "L", false, eng2ExecNodeCap)
                if array.size(eng2SwingStructureNodeHistory) == 0
                    f_eng2_backfill_structure_node(false, eng1_ctx_liq_high_bar, eng1_ctx_liq_high, displayCtxBias == -1 ? "LH" : displayCtxBias == 1 ? "HH" : "H", true, eng2SwingNodeCap)
                    f_eng2_backfill_structure_node(false, eng1_ctx_liq_low_bar, eng1_ctx_liq_low, displayCtxBias == 1 ? "HL" : displayCtxBias == -1 ? "LL" : "L", false, eng2SwingNodeCap)
                eng2StructureRenderFingerprint := snapFp
                eng2StructureLastRenderBar := bar_index

//------------------------------------------------------------------------------
// Higher timeframe structure context (Engine 1 owned)
//------------------------------------------------------------------------------

bool eng1CtxRangeReady = eng1_exec_valid and not na(eng1_ctx_liq_high) and not na(eng1_ctx_liq_low) and eng1_ctx_liq_high > eng1_ctx_liq_low
float eng1CtxRangeHigh = eng1CtxRangeReady ? eng1_ctx_liq_high : na
float eng1CtxRangeLow = eng1CtxRangeReady ? eng1_ctx_liq_low : na
float eng1CtxRangeSize = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeLow : na
float eng1CtxEquilibrium = eng1CtxRangeReady ? (eng1CtxRangeHigh + eng1CtxRangeLow) * 0.5 : na
float eng1CtxOteLongTop = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeSize * 0.62 : na
float eng1CtxOteLongBottom = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeSize * 0.79 : na
float eng1CtxOteShortTop = eng1CtxRangeReady ? eng1CtxRangeLow + eng1CtxRangeSize * 0.79 : na
float eng1CtxOteShortBottom = eng1CtxRangeReady ? eng1CtxRangeLow + eng1CtxRangeSize * 0.62 : na
[eng3ExecOpen, eng3ExecHigh, eng3ExecLow, eng3ExecClose, eng3ExecPrevClose, eng3ClosedFallbackAllowed] = f_eng1_select_exec_closed_ohlc(eng1_exec_tf)
float eng3SignalHigh = eng3ClosedFallbackAllowed ? eng3ExecHigh : na
float eng3SignalLow = eng3ClosedFallbackAllowed ? eng3ExecLow : na
float eng3SignalClose = eng3ClosedFallbackAllowed ? eng3ExecClose : na

// Dealing Range (location layer): derived from Engine 1 context snapshot so it stays aligned with MTF ownership.
int eng2DealHighBarSafe = f_createdBarFromTime(eng1_ctx_liq_high_bar)
int eng2DealLowBarSafe = f_createdBarFromTime(eng1_ctx_liq_low_bar)
float eng2DealHighCandidate = eng1CtxRangeReady ? eng1CtxRangeHigh : na
float eng2DealLowCandidate = eng1CtxRangeReady ? eng1CtxRangeLow : na
bool eng2DealMappedBarsReady = not na(eng2DealHighBarSafe) and not na(eng2DealLowBarSafe)
int eng2DealLeftCandidate = eng2DealMappedBarsReady ? math.min(eng2DealHighBarSafe, eng2DealLowBarSafe) : eng1CtxRangeReady ? f_safeBarIndexX(bar_index - 240) : na
bool eng2DealReady = eng1CtxRangeReady and not na(eng2DealLeftCandidate) and not na(eng2DealHighCandidate) and not na(eng2DealLowCandidate) and eng2DealHighCandidate > eng2DealLowCandidate
bool eng2DealSignificant = eng2DealReady and not na(eng2DealHighCandidate) and not na(eng2DealLowCandidate) and (eng2DealHighCandidate - eng2DealLowCandidate) >= atrSafe * 0.75
if not eng2DealSignificant
    eng2DealHigh := na
    eng2DealLow := na
    eng2DealLeftBar := na
    eng2DealBroken := false
else
    if (eng1CtxRangeReady and (na(eng2DealHigh) or na(eng2DealLow) or not f_levelsClose(eng2DealHigh, eng2DealHighCandidate, atrTolerance) or not f_levelsClose(eng2DealLow, eng2DealLowCandidate, atrTolerance))) or eng2DealLeftBar != eng2DealLeftCandidate
        eng2DealHigh := eng2DealHighCandidate
        eng2DealLow := eng2DealLowCandidate
        eng2DealLeftBar := eng2DealLeftCandidate
        eng2DealBroken := false
    if not eng2DealBroken and eng3ClosedFallbackAllowed and not na(eng2DealHigh) and not na(eng2DealLow) and (eng3ExecClose > eng2DealHigh or eng3ExecClose < eng2DealLow)
        eng2DealBroken := true
bool ipdaAsiaKillzoneActive = f_inIpdaWindow(ipdaAsiaKillzoneSession)
bool ipdaLondonKillzoneActive = f_inIpdaWindow(ipdaLondonKillzoneSession)
bool ipdaNewYorkKillzoneActive = f_inIpdaWindow(ipdaNewYorkKillzoneSession)
bool strictKillzoneActive = ipdaAsiaKillzoneActive or ipdaLondonKillzoneActive or ipdaNewYorkKillzoneActive
bool ipdaMainKillzoneActive = ipdaLondonKillzoneActive or ipdaNewYorkKillzoneActive
string ipdaWindowSummary = ipdaNewYorkKillzoneActive ? "NY KZ" : ipdaLondonKillzoneActive ? "LDN KZ" : ipdaAsiaKillzoneActive ? "AS KZ" : strictModeEnabled and f_inIpdaWindow(ipdaObservationSession) ? "Observe" : "Off"
liquiditySessionSummary = "Sess " + (vNyOn ? "NY" : vLdOn ? "LDN" : vAsOn ? "AS" : "INT") + ">" + (vNyOn ? "AS" : vLdOn ? "NY" : vAsOn ? "LDN" : "AS")
timezoneSummary = "UTC"
float effectiveOteLongTop = eng1CtxRangeReady and displayNarrBias != -1 and (displayCtxBias == 1 or eng1_ctx_bull_ob_breaker) ? eng1CtxOteLongTop : na
float effectiveOteLongBottom = eng1CtxRangeReady and displayNarrBias != -1 and (displayCtxBias == 1 or eng1_ctx_bull_ob_breaker) ? eng1CtxOteLongBottom : na
float effectiveOteShortTop = eng1CtxRangeReady and displayNarrBias != 1 and (displayCtxBias == -1 or eng1_ctx_bear_ob_breaker) ? eng1CtxOteShortTop : na
float effectiveOteShortBottom = eng1CtxRangeReady and displayNarrBias != 1 and (displayCtxBias == -1 or eng1_ctx_bear_ob_breaker) ? eng1CtxOteShortBottom : na
bool effectiveLongOteReady = not na(effectiveOteLongTop) and not na(effectiveOteLongBottom)
bool effectiveShortOteReady = not na(effectiveOteShortTop) and not na(effectiveOteShortBottom)

//------------------------------------------------------------------------------
// ENGINE 3 (SETUP ENGINE)
// MAIN_CONTRACT order 5-7: build context OB/FVG zone, validate confirmations, then
// build/update trade plan + lifecycle.
//------------------------------------------------------------------------------
bool eng1BullContextAllowed = f_eng3_validate_narrative_side(true, eng1_exec_valid, displayNarrBias, displayCtxBias, eng1_ctx_bull_ob_breaker, eng1_ctx_bear_ob_breaker)
bool eng1BearContextAllowed = f_eng3_validate_narrative_side(false, eng1_exec_valid, displayNarrBias, displayCtxBias, eng1_ctx_bull_ob_breaker, eng1_ctx_bear_ob_breaker)
bool eng1HasBullObContext = eng1BullContextAllowed and not na(eng1_ctx_bull_ob_entry)
bool eng1HasBullFvgContext = eng1BullContextAllowed and not na(eng1_ctx_bull_fvg_top) and not na(eng1_ctx_bull_fvg_bottom)
bool eng1HasBearObContext = eng1BearContextAllowed and not na(eng1_ctx_bear_ob_entry)
bool eng1HasBearFvgContext = eng1BearContextAllowed and not na(eng1_ctx_bear_fvg_top) and not na(eng1_ctx_bear_fvg_bottom)
int eng1BullObCreatedBar = f_createdBarFromTime(eng1_ctx_bull_ob_bar)
int eng1BullFvgCreatedBar = f_createdBarFromTime(eng1_ctx_bull_fvg_bar)
int eng1BearObCreatedBar = f_createdBarFromTime(eng1_ctx_bear_ob_bar)
int eng1BearFvgCreatedBar = f_createdBarFromTime(eng1_ctx_bear_fvg_bar)
int eng3BullObBar = strictModeEnabled ? f_eng3_bar(eng1_ctx_bull_ob_bar) : eng1BullObCreatedBar
int eng3BullFvgBar = strictModeEnabled ? f_eng3_bar(eng1_ctx_bull_fvg_bar) : eng1BullFvgCreatedBar
int eng3BearObBar = strictModeEnabled ? f_eng3_bar(eng1_ctx_bear_ob_bar) : eng1BearObCreatedBar
int eng3BearFvgBar = strictModeEnabled ? f_eng3_bar(eng1_ctx_bear_fvg_bar) : eng1BearFvgCreatedBar
bool eng3BullObTrackValid = f_eng3_ready(eng1HasBullObContext, eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng3BullObBar)
bool eng3BullFvgTrackValid = f_eng3_ready(eng1HasBullFvgContext, eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng3BullFvgBar)
bool eng3BearObTrackValid = f_eng3_ready(eng1HasBearObContext, eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng3BearObBar)
bool eng3BearFvgTrackValid = f_eng3_ready(eng1HasBearFvgContext, eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng3BearFvgBar)

bool eng3BullObTrackChanged = f_eng3_changed(eng3BullObTrackValid, eng3BullObTouchBar, eng3BullObBar, eng3BullObTouchTop, eng1_ctx_bull_ob_top, eng3BullObTouchBottom, eng1_ctx_bull_ob_bottom)
bool eng3BullFvgTrackChanged = f_eng3_changed(eng3BullFvgTrackValid, eng3BullFvgTouchBar, eng3BullFvgBar, eng3BullFvgTouchTop, eng1_ctx_bull_fvg_top, eng3BullFvgTouchBottom, eng1_ctx_bull_fvg_bottom)
bool eng3BearObTrackChanged = f_eng3_changed(eng3BearObTrackValid, eng3BearObTouchBar, eng3BearObBar, eng3BearObTouchTop, eng1_ctx_bear_ob_top, eng3BearObTouchBottom, eng1_ctx_bear_ob_bottom)
bool eng3BearFvgTrackChanged = f_eng3_changed(eng3BearFvgTrackValid, eng3BearFvgTouchBar, eng3BearFvgBar, eng3BearFvgTouchTop, eng1_ctx_bear_fvg_top, eng3BearFvgTouchBottom, eng1_ctx_bear_fvg_bottom)

bool strictLongFallbackSweep = eng3ClosedFallbackAllowed and ((ipdaMainKillzoneActive and f_eng3_sweep_below(asiaSessionLow, eng3ExecLow, eng3ExecClose)) or (ipdaNewYorkKillzoneActive and f_eng3_sweep_below(londonSessionLow, eng3ExecLow, eng3ExecClose)) or f_eng3_sweep_below(eng1_d1_lb20_low, eng3ExecLow, eng3ExecClose) or f_eng3_sweep_below(eng1_d1_lb40_low, eng3ExecLow, eng3ExecClose) or f_eng3_sweep_below(eng1_d1_lb60_low, eng3ExecLow, eng3ExecClose))
bool strictShortFallbackSweep = eng3ClosedFallbackAllowed and ((ipdaMainKillzoneActive and f_eng3_sweep_above(asiaSessionHigh, eng3ExecHigh, eng3ExecClose)) or (ipdaNewYorkKillzoneActive and f_eng3_sweep_above(londonSessionHigh, eng3ExecHigh, eng3ExecClose)) or f_eng3_sweep_above(eng1_d1_lb20_high, eng3ExecHigh, eng3ExecClose) or f_eng3_sweep_above(eng1_d1_lb40_high, eng3ExecHigh, eng3ExecClose) or f_eng3_sweep_above(eng1_d1_lb60_high, eng3ExecHigh, eng3ExecClose))
bool strictLongRawSweepSignal = strictModeEnabled and (eng1_exe_bull_sweep or strictLongFallbackSweep)
bool strictShortRawSweepSignal = strictModeEnabled and (eng1_exe_bear_sweep or strictShortFallbackSweep)
int strictLongSweepAge = ta.barssince(strictLongRawSweepSignal)
int strictShortSweepAge = ta.barssince(strictShortRawSweepSignal)
int strictLongMssAge = ta.barssince(strictModeEnabled and eng1_exe_bull_mss)
int strictShortMssAge = ta.barssince(strictModeEnabled and eng1_exe_bear_mss)
int strictLongDisplacementAge = ta.barssince(strictModeEnabled and eng1_exe_bull_displacement)
int strictShortDisplacementAge = ta.barssince(strictModeEnabled and eng1_exe_bear_displacement)
int strictCycleMemoryWindow = math.max(strictMssLookbackEffective, strictPdOwnershipWindow)
bool strictLongSweepMemoryPass = not na(strictLongSweepAge) and strictLongSweepAge <= strictCycleMemoryWindow
bool strictShortSweepMemoryPass = not na(strictShortSweepAge) and strictShortSweepAge <= strictCycleMemoryWindow
bool strictLongMssMemoryPass = f_eng3_strict_cycle_stage_pass(strictLongSweepAge, strictLongMssAge, strictCycleMemoryWindow)
bool strictShortMssMemoryPass = f_eng3_strict_cycle_stage_pass(strictShortSweepAge, strictShortMssAge, strictCycleMemoryWindow)
bool strictLongDisplacementMemoryPass = f_eng3_strict_cycle_stage_pass(strictLongSweepAge, strictLongDisplacementAge, strictCycleMemoryWindow)
bool strictShortDisplacementMemoryPass = f_eng3_strict_cycle_stage_pass(strictShortSweepAge, strictShortDisplacementAge, strictCycleMemoryWindow)
bool bullObStrictPdOwned = eng1HasBullObContext and f_eng3_strict_pd_array_owned(false, eng3BullObBar, strictLongSweepAge, strictLongMssAge, strictLongDisplacementAge, strictPdOwnershipWindow)
bool bullFvgStrictPdOwned = eng1HasBullFvgContext and f_eng3_strict_pd_array_owned(true, eng3BullFvgBar, strictLongSweepAge, strictLongMssAge, strictLongDisplacementAge, strictPdOwnershipWindow)
bool bearObStrictPdOwned = eng1HasBearObContext and f_eng3_strict_pd_array_owned(false, eng3BearObBar, strictShortSweepAge, strictShortMssAge, strictShortDisplacementAge, strictPdOwnershipWindow)
bool bearFvgStrictPdOwned = eng1HasBearFvgContext and f_eng3_strict_pd_array_owned(true, eng3BearFvgBar, strictShortSweepAge, strictShortMssAge, strictShortDisplacementAge, strictPdOwnershipWindow)

// Engine 3 state machine: zone touch latches are incremental and reset only when
// the tracked context zone identity changes or disappears.
if not eng3BullObTrackValid
    eng3BullObTouchedState := false
    eng3BullObTouchBar := na
    eng3BullObTouchTop := na
    eng3BullObTouchBottom := na
else if eng3BullObTrackChanged
    eng3BullObTouchedState := not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bull_ob_bottom and eng3SignalLow <= eng1_ctx_bull_ob_top
    eng3BullObTouchBar := eng3BullObBar
    eng3BullObTouchTop := eng1_ctx_bull_ob_top
    eng3BullObTouchBottom := eng1_ctx_bull_ob_bottom
else if not eng3BullObTouchedState and not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bull_ob_bottom and eng3SignalLow <= eng1_ctx_bull_ob_top
    eng3BullObTouchedState := true

if not eng3BullFvgTrackValid
    eng3BullFvgTouchedState := false
    eng3BullFvgTouchBar := na
    eng3BullFvgTouchTop := na
    eng3BullFvgTouchBottom := na
else if eng3BullFvgTrackChanged
    eng3BullFvgTouchedState := not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bull_fvg_bottom and eng3SignalLow <= eng1_ctx_bull_fvg_top
    eng3BullFvgTouchBar := eng3BullFvgBar
    eng3BullFvgTouchTop := eng1_ctx_bull_fvg_top
    eng3BullFvgTouchBottom := eng1_ctx_bull_fvg_bottom
else if not eng3BullFvgTouchedState and not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bull_fvg_bottom and eng3SignalLow <= eng1_ctx_bull_fvg_top
    eng3BullFvgTouchedState := true

if not eng3BearObTrackValid
    eng3BearObTouchedState := false
    eng3BearObTouchBar := na
    eng3BearObTouchTop := na
    eng3BearObTouchBottom := na
else if eng3BearObTrackChanged
    eng3BearObTouchedState := not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bear_ob_bottom and eng3SignalLow <= eng1_ctx_bear_ob_top
    eng3BearObTouchBar := eng3BearObBar
    eng3BearObTouchTop := eng1_ctx_bear_ob_top
    eng3BearObTouchBottom := eng1_ctx_bear_ob_bottom
else if not eng3BearObTouchedState and not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bear_ob_bottom and eng3SignalLow <= eng1_ctx_bear_ob_top
    eng3BearObTouchedState := true

if not eng3BearFvgTrackValid
    eng3BearFvgTouchedState := false
    eng3BearFvgTouchBar := na
    eng3BearFvgTouchTop := na
    eng3BearFvgTouchBottom := na
else if eng3BearFvgTrackChanged
    eng3BearFvgTouchedState := not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bear_fvg_bottom and eng3SignalLow <= eng1_ctx_bear_fvg_top
    eng3BearFvgTouchBar := eng3BearFvgBar
    eng3BearFvgTouchTop := eng1_ctx_bear_fvg_top
    eng3BearFvgTouchBottom := eng1_ctx_bear_fvg_bottom
else if not eng3BearFvgTouchedState and not na(eng3SignalHigh) and not na(eng3SignalLow) and eng3SignalHigh >= eng1_ctx_bear_fvg_bottom and eng3SignalLow <= eng1_ctx_bear_fvg_top
    eng3BearFvgTouchedState := true

bool eng1BullObTouched = eng3BullObTouchedState
bool eng1BullFvgTouched = eng3BullFvgTouchedState
bool eng1BearObTouched = eng3BearObTouchedState
bool eng1BearFvgTouched = eng3BearFvgTouchedState

// Context zone sources (Engine 1 owned). Keep them explicit so Engine 3 never
// accidentally pulls from execution-only state.
float ctxBullObTop = eng1HasBullObContext ? eng1_ctx_bull_ob_top : na
float ctxBullObBottom = eng1HasBullObContext ? eng1_ctx_bull_ob_bottom : na
float ctxBullObEntry = eng1HasBullObContext ? eng1_ctx_bull_ob_entry : na
bool ctxBullObBreaker = eng1HasBullObContext ? eng1_ctx_bull_ob_breaker : false
int ctxBullObCreatedBar = eng1HasBullObContext ? eng3BullObBar : na
bool ctxBullObTouched = eng1HasBullObContext ? eng1BullObTouched : false
float ctxBullFvgTop = eng1HasBullFvgContext ? eng1_ctx_bull_fvg_top : na
float ctxBullFvgBottom = eng1HasBullFvgContext ? eng1_ctx_bull_fvg_bottom : na
int ctxBullFvgCreatedBar = eng1HasBullFvgContext ? eng3BullFvgBar : na
bool ctxBullFvgTouched = eng1HasBullFvgContext ? eng1BullFvgTouched : false

float ctxBearObTop = eng1HasBearObContext ? eng1_ctx_bear_ob_top : na
float ctxBearObBottom = eng1HasBearObContext ? eng1_ctx_bear_ob_bottom : na
float ctxBearObEntry = eng1HasBearObContext ? eng1_ctx_bear_ob_entry : na
bool ctxBearObBreaker = eng1HasBearObContext ? eng1_ctx_bear_ob_breaker : false
int ctxBearObCreatedBar = eng1HasBearObContext ? eng3BearObBar : na
bool ctxBearObTouched = eng1HasBearObContext ? eng1BearObTouched : false
float ctxBearFvgTop = eng1HasBearFvgContext ? eng1_ctx_bear_fvg_top : na
float ctxBearFvgBottom = eng1HasBearFvgContext ? eng1_ctx_bear_fvg_bottom : na
int ctxBearFvgCreatedBar = eng1HasBearFvgContext ? eng3BearFvgBar : na
bool ctxBearFvgTouched = eng1HasBearFvgContext ? eng1BearFvgTouched : false

bool hasBullOb = eng1HasBullObContext
bool hasBullFvg = eng1HasBullFvgContext
bool hasBearOb = eng1HasBearObContext
bool hasBearFvg = eng1HasBearFvgContext

bool bullObPdPass = hasBullOb and eng1CtxRangeReady and f_zoneMid(ctxBullObTop, ctxBullObBottom) < eng1CtxEquilibrium
bool bullFvgPdPass = hasBullFvg and eng1CtxRangeReady and f_zoneMid(ctxBullFvgTop, ctxBullFvgBottom) < eng1CtxEquilibrium
bool bearObPdPass = hasBearOb and eng1CtxRangeReady and f_zoneMid(ctxBearObTop, ctxBearObBottom) > eng1CtxEquilibrium
bool bearFvgPdPass = hasBearFvg and eng1CtxRangeReady and f_zoneMid(ctxBearFvgTop, ctxBearFvgBottom) > eng1CtxEquilibrium
bool bullObOtePass = hasBullOb and effectiveLongOteReady and f_zoneIntersects(ctxBullObTop, ctxBullObBottom, effectiveOteLongTop, effectiveOteLongBottom)
bool bullFvgOtePass = hasBullFvg and effectiveLongOteReady and f_zoneIntersects(ctxBullFvgTop, ctxBullFvgBottom, effectiveOteLongTop, effectiveOteLongBottom)
bool bearObOtePass = hasBearOb and effectiveShortOteReady and f_zoneIntersects(ctxBearObTop, ctxBearObBottom, effectiveOteShortTop, effectiveOteShortBottom)
bool bearFvgOtePass = hasBearFvg and effectiveShortOteReady and f_zoneIntersects(ctxBearFvgTop, ctxBearFvgBottom, effectiveOteShortTop, effectiveOteShortBottom)

bool bullObZoneConfirmPass = bullObPdPass and bullObOtePass
bool bullFvgZoneConfirmPass = bullFvgPdPass and bullFvgOtePass
bool bearObZoneConfirmPass = bearObPdPass and bearObOtePass
bool bearFvgZoneConfirmPass = bearFvgPdPass and bearFvgOtePass
bool bullFvgInZone = hasBullFvg and not na(eng3SignalClose) and eng3SignalClose >= ctxBullFvgBottom and eng3SignalClose <= ctxBullFvgTop
bool bullObInZone = hasBullOb and not na(eng3SignalClose) and eng3SignalClose >= ctxBullObBottom and eng3SignalClose <= ctxBullObTop
bool bearFvgInZone = hasBearFvg and not na(eng3SignalClose) and eng3SignalClose >= ctxBearFvgBottom and eng3SignalClose <= ctxBearFvgTop
bool bearObInZone = hasBearOb and not na(eng3SignalClose) and eng3SignalClose >= ctxBearObBottom and eng3SignalClose <= ctxBearObTop

[preferBullOb, preferBullFvg] = f_eng3_select_poi_preference(strictModeEnabled, hasBullOb, hasBullFvg, bullObZoneConfirmPass, bullFvgZoneConfirmPass, bullObInZone, bullFvgInZone, bullObStrictPdOwned, bullFvgStrictPdOwned)
[preferBearOb, preferBearFvg] = f_eng3_select_poi_preference(strictModeEnabled, hasBearOb, hasBearFvg, bearObZoneConfirmPass, bearFvgZoneConfirmPass, bearObInZone, bearFvgInZone, bearObStrictPdOwned, bearFvgStrictPdOwned)

[poi_long_type, poi_long_top, poi_long_bottom, poi_long_entry, poi_long_bar, poi_long_touched] = f_eng3_select_context_poi(preferBullOb, preferBullFvg, ctxBullObBreaker, ctxBullObTop, ctxBullObBottom, ctxBullObEntry, ctxBullObCreatedBar, ctxBullObTouched, ctxBullFvgTop, ctxBullFvgBottom, ctxBullFvgCreatedBar, ctxBullFvgTouched)
[poi_short_type, poi_short_top, poi_short_bottom, poi_short_entry, poi_short_bar, poi_short_touched] = f_eng3_select_context_poi(preferBearOb, preferBearFvg, ctxBearObBreaker, ctxBearObTop, ctxBearObBottom, ctxBearObEntry, ctxBearObCreatedBar, ctxBearObTouched, ctxBearFvgTop, ctxBearFvgBottom, ctxBearFvgCreatedBar, ctxBearFvgTouched)
eng3LongActivePoiIdentity := f_eng3_poi_identity("L", poi_long_type, poi_long_bar, poi_long_top, poi_long_bottom)
eng3ShortActivePoiIdentity := f_eng3_poi_identity("S", poi_short_type, poi_short_bar, poi_short_top, poi_short_bottom)
bool eng3LongActivePoiReady = eng3LongActivePoiIdentity != ""
bool eng3ShortActivePoiReady = eng3ShortActivePoiIdentity != ""
bool strictLongPdArrayOwned = not strictModeEnabled or (poi_long_type == "FVG" and bullFvgStrictPdOwned) or ((poi_long_type == "OB" or poi_long_type == "Breaker") and bullObStrictPdOwned)
bool strictShortPdArrayOwned = not strictModeEnabled or (poi_short_type == "FVG" and bearFvgStrictPdOwned) or ((poi_short_type == "OB" or poi_short_type == "Breaker") and bearObStrictPdOwned)
bool poi_long_contract_valid = eng1BullContextAllowed and poi_long_type != "" and eng3LongActivePoiReady and strictLongPdArrayOwned and eng3LongActivePoiIdentity != eng3LongConsumedPoiIdentity
bool poi_short_contract_valid = eng1BearContextAllowed and poi_short_type != "" and eng3ShortActivePoiReady and strictShortPdArrayOwned and eng3ShortActivePoiIdentity != eng3ShortConsumedPoiIdentity

[tradeLongEntry, tradeLongStop, tradeLongTarget] = f_eng3_build_trade_plan(true, poi_long_contract_valid ? poi_long_entry : na, eng1_exe_liq_high, eng1_exe_liq_low, eng1_exe_eqh_active ? eng1_exe_liq_high : na, eng1_exe_eql_active ? eng1_exe_liq_low : na, eng1CtxRangeHigh, eng1CtxRangeLow)
[tradeShortEntry, tradeShortStop, tradeShortTarget] = f_eng3_build_trade_plan(false, poi_short_contract_valid ? poi_short_entry : na, eng1_exe_liq_high, eng1_exe_liq_low, eng1_exe_eqh_active ? eng1_exe_liq_high : na, eng1_exe_eql_active ? eng1_exe_liq_low : na, eng1CtxRangeHigh, eng1CtxRangeLow)
float tradeLongValidTop = poi_long_contract_valid ? poi_long_top : na
float tradeLongValidBottom = poi_long_contract_valid ? poi_long_bottom : na
int tradeLongCreatedBar = poi_long_contract_valid ? poi_long_bar : na
float tradeShortValidTop = poi_short_contract_valid ? poi_short_top : na
float tradeShortValidBottom = poi_short_contract_valid ? poi_short_bottom : na
int tradeShortCreatedBar = poi_short_contract_valid ? poi_short_bar : na
bool lOb = poi_long_contract_valid and (poi_long_type == "OB" or poi_long_type == "Breaker")
bool lFvg = poi_long_contract_valid and poi_long_type == "FVG"
bool lTch = poi_long_contract_valid and poi_long_touched
bool sOb = poi_short_contract_valid and (poi_short_type == "OB" or poi_short_type == "Breaker")
bool sFvg = poi_short_contract_valid and poi_short_type == "FVG"
bool sTch = poi_short_contract_valid and poi_short_touched

bool ipdaLongDolAvailable = strictModeEnabled and (not na(eng1_narr_liq_high) or not na(eng1_d1_lb20_high) or not na(eng1_d1_lb40_high) or not na(eng1_d1_lb60_high) or not na(eng1_narr_bear_sd_top) or not na(eng1_narr_bear_sd_bottom))
bool ipdaShortDolAvailable = strictModeEnabled and (not na(eng1_narr_liq_low) or not na(eng1_d1_lb20_low) or not na(eng1_d1_lb40_low) or not na(eng1_d1_lb60_low) or not na(eng1_narr_bull_sd_top) or not na(eng1_narr_bull_sd_bottom))
float longDolExternal = strictModeEnabled and not na(tradeLongEntry) ? f_nearestAbove(tradeLongEntry, eng1_narr_liq_high, eng1_d1_lb20_high, eng1_d1_lb40_high, eng1_d1_lb60_high, eng1CtxRangeHigh, eng1_narr_bear_sd_bottom, eng1_narr_bear_sd_top) : na
float shortDolExternal = strictModeEnabled and not na(tradeShortEntry) ? f_nearestBelow(tradeShortEntry, eng1_narr_liq_low, eng1_d1_lb20_low, eng1_d1_lb40_low, eng1_d1_lb60_low, eng1CtxRangeLow, eng1_narr_bull_sd_top, eng1_narr_bull_sd_bottom) : na
bool longQualifiedExternalDol = not na(longDolExternal) and not na(tradeLongEntry) and not na(tradeLongStop) and tradeLongEntry > tradeLongStop and longDolExternal - tradeLongEntry >= tradeLongEntry - tradeLongStop
bool shortQualifiedExternalDol = not na(shortDolExternal) and not na(tradeShortEntry) and not na(tradeShortStop) and tradeShortStop > tradeShortEntry and tradeShortEntry - shortDolExternal >= tradeShortStop - tradeShortEntry
bool longUsesExternalDolTarget = strictModeEnabled and longQualifiedExternalDol
bool shortUsesExternalDolTarget = strictModeEnabled and shortQualifiedExternalDol
float activeLongTarget = longUsesExternalDolTarget ? longDolExternal : tradeLongTarget
float activeShortTarget = shortUsesExternalDolTarget ? shortDolExternal : tradeShortTarget
bool exe_long_pd_pass = lOb ? bullObPdPass : lFvg ? bullFvgPdPass : false
bool exe_short_pd_pass = sOb ? bearObPdPass : sFvg ? bearFvgPdPass : false
bool exe_long_ote_pass = lOb ? bullObOtePass : lFvg ? bullFvgOtePass : false
bool exe_short_ote_pass = sOb ? bearObOtePass : sFvg ? bearFvgOtePass : false
bool exe_long_dol_pass = strictModeEnabled ? longQualifiedExternalDol : not na(activeLongTarget)
bool exe_short_dol_pass = strictModeEnabled ? shortQualifiedExternalDol : not na(activeShortTarget)

float longRisk = not na(tradeLongEntry) and not na(tradeLongStop) ? tradeLongEntry - tradeLongStop : na
bool longPriceInZone = not na(tradeLongValidBottom) and not na(eng3SignalClose) and eng3SignalClose >= tradeLongValidBottom and eng3SignalClose <= tradeLongValidTop
bool longPriceNearZone = not na(tradeLongEntry) and not na(eng3SignalClose) and math.abs(eng3SignalClose - tradeLongEntry) <= atrSafe * 0.25
int longSetupAge = not na(tradeLongCreatedBar) ? bar_index - tradeLongCreatedBar : na
string currentLongSetupTag = not na(tradeLongCreatedBar) ? eng3LongActivePoiIdentity : ""
bool longSetupMissing = currentLongSetupTag == ""
bool longSetupChanged = not longSetupMissing and currentLongSetupTag != lastLongSetupTag
if longSetupMissing or longSetupChanged
    longPoiTappedLatched := false
    longPoiMitigatedLatched := false
    longPoiInvalidatedLatched := false
    longArmedLatched := false
    eng2LongTappedEventTag := ""
    eng2LongMitigatedEventTag := ""
if not longSetupMissing
    longPoiMitigatedLatched := longPoiMitigatedLatched or f_eng3_poi_ce_touched(true, poi_long_type, tradeLongValidTop, tradeLongValidBottom, tradeLongEntry, eng3SignalHigh, eng3SignalLow) or f_eng3_poi_full_filled(true, tradeLongValidTop, tradeLongValidBottom, eng3SignalHigh, eng3SignalLow)
    longPoiTappedLatched := longPoiTappedLatched or lTch or longPoiMitigatedLatched
    longPoiInvalidatedLatched := longPoiInvalidatedLatched or f_eng3_poi_invalidated(true, tradeLongValidTop, tradeLongValidBottom, eng3SignalClose)
bool longChased = not longPoiMitigatedLatched and not na(tradeLongValidTop) and not na(eng3SignalClose) and eng3SignalClose > tradeLongValidTop + atrSafe * setupChaseAtr
float execBarRange = eng3ClosedFallbackAllowed ? eng3ExecHigh - eng3ExecLow : na
float execBarBodyShare = eng3ClosedFallbackAllowed ? f_eng1_body_share(eng3ExecOpen, eng3ExecHigh, eng3ExecLow, eng3ExecClose) : na
bool longDirectionalFallback = displayExecBias == 0 and ((eng1_exe_bull_mss and not eng1_exe_bear_mss) or (eng1_exe_bull_displacement and not eng1_exe_bear_displacement))
bool shortDirectionalFallback = displayExecBias == 0 and ((eng1_exe_bear_mss and not eng1_exe_bull_mss) or (eng1_exe_bear_displacement and not eng1_exe_bull_displacement))
bool effectiveLongDirectional = displayExecBias == 1 or longDirectionalFallback
bool effectiveLongSweepSeen = strictModeEnabled ? strictLongSweepMemoryPass : eng1_exe_bull_sweep
bool longMssFallbackBreak = eng3ClosedFallbackAllowed and not na(eng1_exe_mss_ref_high) and not na(eng3ExecPrevClose) and eng3ExecClose > eng1_exe_mss_ref_high and eng3ExecPrevClose <= eng1_exe_mss_ref_high
int longMssFallbackAge = ta.barssince(longMssFallbackBreak)
bool longMssFallbackRecent = not na(longMssFallbackAge) and longMssFallbackAge <= strictMssLookbackEffective
bool longDispFallbackBreak = eng3ClosedFallbackAllowed and eng3ExecClose > eng3ExecOpen and execBarRange >= atrSafe * 0.80 and execBarBodyShare >= 0.50
int longDispFallbackAge = ta.barssince(longDispFallbackBreak)
bool longDispFallbackRecent = not na(longDispFallbackAge) and longDispFallbackAge <= strictMssLookbackEffective
bool longDispFallbackContext = eng1_exe_bull_sweep or longMssFallbackRecent or eng1_exe_bull_mss
bool longDispFallback = not strictModeEnabled and longDispFallbackRecent and longDispFallbackContext
bool effectiveLongMssSeen = strictModeEnabled ? strictLongMssMemoryPass : (eng1_exe_bull_mss or longMssFallbackRecent)
bool effectiveLongDisplacementSeen = strictModeEnabled ? strictLongDisplacementMemoryPass : (eng1_exe_bull_displacement or longDispFallback)
bool effectiveLongStructureInvalidated = longPoiInvalidatedLatched or (displayExecBias == -1 and (displayCtxBias == -1 or eng1_ctx_bear_ob_breaker or eng1_exe_bear_mss))
bool normalLongDirectionalContext = displayCtxBias != -1 and (displayExecBias == 1 or effectiveLongDirectional or eng1_ctx_bull_ob_breaker or eng1_ctx_bull_breakout)
bool normalLongBiasPass = eng1_exec_valid
bool normalLongContextPass = (lOb or lFvg) and normalLongDirectionalContext
bool normalLongTargetPass = not na(activeLongTarget)
// Strict adds IPDA timing/DOL/OTE; normal stays OB/FVG + direction + MSS/disp + retest.
bool strictLongBiasPass = not strictModeEnabled or (displayNarrBias == 1 and ipdaLongDolAvailable)
bool strictLongDirectionalPass = not strictModeEnabled or displayExecBias == 1 or (displayExecBias == 0 and (strictLongMssMemoryPass or strictLongDisplacementMemoryPass))
bool strictLongContextTfPass = not strictModeEnabled or ((displayCtxBias == 1 or eng1_ctx_bull_ob_breaker or eng1_ctx_bull_breakout or (displayCtxBias == 0 and strictLongDirectionalPass)) and (lOb or lFvg))
bool exe_long_mss_signal = strictModeEnabled ? strictLongMssMemoryPass : effectiveLongMssSeen
bool exe_long_displacement_signal = strictModeEnabled ? strictLongDisplacementMemoryPass : effectiveLongDisplacementSeen
bool strictLongSweepPass = not strictModeEnabled or strictLongSweepMemoryPass
bool strictLongMssPass = not strictModeEnabled or (strictLongMssMemoryPass and strictLongDirectionalPass)
bool strictLongDisplacementPass = not strictModeEnabled or exe_long_displacement_signal
bool strictLongPdPass = not strictModeEnabled or exe_long_pd_pass
bool strictLongOtePass = not strictModeEnabled or exe_long_ote_pass
bool strictLongDolPass = not strictModeEnabled or exe_long_dol_pass
bool strictLongKillzonePass = not strictModeEnabled or strictKillzoneActive
bool longPoiRetestPass = longPriceInZone or longPriceNearZone or lTch
bool longEvidencePass = exe_long_mss_signal or exe_long_displacement_signal
bool longHardSignalGate = strictModeEnabled ? (not na(tradeLongEntry) and strictLongBiasPass and strictLongContextTfPass and strictLongPdPass and strictLongOtePass and strictLongDolPass and strictLongKillzonePass and not longPoiInvalidatedLatched) : (not na(tradeLongEntry) and normalLongBiasPass and normalLongContextPass and normalLongTargetPass and longPoiRetestPass and longEvidencePass and not longPoiInvalidatedLatched)
bool longScoreTargetClear = longHardSignalGate ? f_eng3_target_liquidity_clear(activeLongTarget, eng1_exe_liq_high, eng1_exe_eqh_active ? eng1_exe_liq_high : na, eng1CtxRangeHigh, longUsesExternalDolTarget) : false
bool scoreVolDrop = not na(volume) and not na(volume[1]) and volume < volume[1]
bool longScoreHtfPenalty = longHardSignalGate ? (eng1_narr_strength == "Strong" and displayNarrBias == -1) : false
bool longScorePdPenalty = longHardSignalGate ? (not na(tradeLongEntry) and eng1CtxRangeReady and not na(eng1CtxEquilibrium) and tradeLongEntry > eng1CtxEquilibrium) : false
bool longScoreFvgPenalty = longHardSignalGate ? (lFvg and (longPoiMitigatedLatched or longChased)) : false
bool longScoreVolumeBonus = longHardSignalGate and longPoiRetestPass and scoreVolDrop
int longSignalScore = longHardSignalGate ? f_eng3_dynamic_signal_score(effectiveLongSweepSeen, exe_long_displacement_signal, exe_long_mss_signal, hasBullFvg, exe_long_pd_pass, strictKillzoneActive, longScoreTargetClear, longScoreHtfPenalty, longScorePdPenalty, longScoreFvgPenalty) + (longScoreVolumeBonus ? 1 : 0) : 0
bool exe_long_contract_confirm = strictModeEnabled ? (strictLongBiasPass and strictLongContextTfPass and strictLongSweepPass and strictLongMssPass and strictLongDisplacementPass and strictLongPdPass and strictLongOtePass and strictLongDolPass and strictLongKillzonePass) : longSignalScore >= 6
bool exe_long_confirm = eng1_exec_valid and not na(tradeLongEntry) and exe_long_contract_confirm
longArmedLatched := longArmedLatched or exe_long_confirm
bool longManagedHit = longArmedLatched and longPoiMitigatedLatched and not na(longRisk) and not na(eng3SignalHigh) and eng3SignalHigh >= tradeLongEntry + longRisk * setupManagedR
bool longStopHit = longArmedLatched and not na(tradeLongStop) and not na(eng3SignalLow) and eng3SignalLow <= tradeLongStop
bool longTpHit = longArmedLatched and longPoiMitigatedLatched and not na(activeLongTarget) and not na(eng3SignalHigh) and eng3SignalHigh >= activeLongTarget

// Engine 3 state machine: lifecycle latches keep terminal states stable until
// the setup identity changes.
[nextLongManagedLatched, nextLongCompletedLatched, nextLongAmbiguousLatched, nextLongInvalidatedLatched, longManaged, longCompleted, longAmbiguous, longInvalidated, longExpired] = f_eng3_update_trade_lifecycle(currentLongSetupTag, lastLongSetupTag, longManagedLatched, longCompletedLatched, longAmbiguousLatched, longInvalidatedLatched, longArmedLatched and longPoiMitigatedLatched, longManagedHit, longStopHit, longTpHit, longArmedLatched and effectiveLongStructureInvalidated, longSetupAge, expiryBarsEffective)
lastLongSetupTag := currentLongSetupTag
longManagedLatched := nextLongManagedLatched
longCompletedLatched := nextLongCompletedLatched
longAmbiguousLatched := nextLongAmbiguousLatched
longInvalidatedLatched := nextLongInvalidatedLatched

float shortRisk = not na(tradeShortEntry) and not na(tradeShortStop) ? tradeShortStop - tradeShortEntry : na
bool shortPriceInZone = not na(tradeShortValidBottom) and not na(eng3SignalClose) and eng3SignalClose >= tradeShortValidBottom and eng3SignalClose <= tradeShortValidTop
bool shortPriceNearZone = not na(tradeShortEntry) and not na(eng3SignalClose) and math.abs(eng3SignalClose - tradeShortEntry) <= atrSafe * 0.25
int shortSetupAge = not na(tradeShortCreatedBar) ? bar_index - tradeShortCreatedBar : na
string currentShortSetupTag = not na(tradeShortCreatedBar) ? eng3ShortActivePoiIdentity : ""
bool shortSetupMissing = currentShortSetupTag == ""
bool shortSetupChanged = not shortSetupMissing and currentShortSetupTag != lastShortSetupTag
if shortSetupMissing or shortSetupChanged
    shortPoiTappedLatched := false
    shortPoiMitigatedLatched := false
    shortPoiInvalidatedLatched := false
    shortArmedLatched := false
    eng2ShortTappedEventTag := ""
    eng2ShortMitigatedEventTag := ""
if not shortSetupMissing
    shortPoiMitigatedLatched := shortPoiMitigatedLatched or f_eng3_poi_ce_touched(false, poi_short_type, tradeShortValidTop, tradeShortValidBottom, tradeShortEntry, eng3SignalHigh, eng3SignalLow) or f_eng3_poi_full_filled(false, tradeShortValidTop, tradeShortValidBottom, eng3SignalHigh, eng3SignalLow)
    shortPoiTappedLatched := shortPoiTappedLatched or sTch or shortPoiMitigatedLatched
    shortPoiInvalidatedLatched := shortPoiInvalidatedLatched or f_eng3_poi_invalidated(false, tradeShortValidTop, tradeShortValidBottom, eng3SignalClose)
bool shortChased = not shortPoiMitigatedLatched and not na(tradeShortValidBottom) and not na(eng3SignalClose) and eng3SignalClose < tradeShortValidBottom - atrSafe * setupChaseAtr
bool effectiveShortDirectional = displayExecBias == -1 or shortDirectionalFallback
bool effectiveShortSweepSeen = strictModeEnabled ? strictShortSweepMemoryPass : eng1_exe_bear_sweep
bool shortMssFallbackBreak = eng3ClosedFallbackAllowed and not na(eng1_exe_mss_ref_low) and not na(eng3ExecPrevClose) and eng3ExecClose < eng1_exe_mss_ref_low and eng3ExecPrevClose >= eng1_exe_mss_ref_low
int shortMssFallbackAge = ta.barssince(shortMssFallbackBreak)
bool shortMssFallbackRecent = not na(shortMssFallbackAge) and shortMssFallbackAge <= strictMssLookbackEffective
bool shortDispFallbackBreak = eng3ClosedFallbackAllowed and eng3ExecClose < eng3ExecOpen and execBarRange >= atrSafe * 0.80 and execBarBodyShare >= 0.50
int shortDispFallbackAge = ta.barssince(shortDispFallbackBreak)
bool shortDispFallbackRecent = not na(shortDispFallbackAge) and shortDispFallbackAge <= strictMssLookbackEffective
bool shortDispFallbackContext = eng1_exe_bear_sweep or shortMssFallbackRecent or eng1_exe_bear_mss
bool shortDispFallback = not strictModeEnabled and shortDispFallbackRecent and shortDispFallbackContext
bool effectiveShortMssSeen = strictModeEnabled ? strictShortMssMemoryPass : (eng1_exe_bear_mss or shortMssFallbackRecent)
bool effectiveShortDisplacementSeen = strictModeEnabled ? strictShortDisplacementMemoryPass : (eng1_exe_bear_displacement or shortDispFallback)
bool effectiveShortStructureInvalidated = shortPoiInvalidatedLatched or (displayExecBias == 1 and (displayCtxBias == 1 or eng1_ctx_bull_ob_breaker or eng1_exe_bull_mss))
bool normalShortDirectionalContext = displayCtxBias != 1 and (displayExecBias == -1 or effectiveShortDirectional or eng1_ctx_bear_ob_breaker or eng1_ctx_bear_breakout)
bool normalShortBiasPass = eng1_exec_valid
bool normalShortContextPass = (sOb or sFvg) and normalShortDirectionalContext
bool normalShortTargetPass = not na(activeShortTarget)
bool strictShortBiasPass = not strictModeEnabled or (displayNarrBias == -1 and ipdaShortDolAvailable)
bool strictShortDirectionalPass = not strictModeEnabled or displayExecBias == -1 or (displayExecBias == 0 and (strictShortMssMemoryPass or strictShortDisplacementMemoryPass))
bool strictShortContextTfPass = not strictModeEnabled or ((displayCtxBias == -1 or eng1_ctx_bear_ob_breaker or eng1_ctx_bear_breakout or (displayCtxBias == 0 and strictShortDirectionalPass)) and (sOb or sFvg))
bool exe_short_mss_signal = strictModeEnabled ? strictShortMssMemoryPass : effectiveShortMssSeen
bool exe_short_displacement_signal = strictModeEnabled ? strictShortDisplacementMemoryPass : effectiveShortDisplacementSeen
bool strictShortSweepPass = not strictModeEnabled or strictShortSweepMemoryPass
bool strictShortMssPass = not strictModeEnabled or (strictShortMssMemoryPass and strictShortDirectionalPass)
bool strictShortDisplacementPass = not strictModeEnabled or exe_short_displacement_signal
bool strictShortPdPass = not strictModeEnabled or exe_short_pd_pass
bool strictShortOtePass = not strictModeEnabled or exe_short_ote_pass
bool strictShortDolPass = not strictModeEnabled or exe_short_dol_pass
bool strictShortKillzonePass = not strictModeEnabled or strictKillzoneActive
bool shortPoiRetestPass = shortPriceInZone or shortPriceNearZone or sTch
bool shortEvidencePass = exe_short_mss_signal or exe_short_displacement_signal
bool shortHardSignalGate = strictModeEnabled ? (not na(tradeShortEntry) and strictShortBiasPass and strictShortContextTfPass and strictShortPdPass and strictShortOtePass and strictShortDolPass and strictShortKillzonePass and not shortPoiInvalidatedLatched) : (not na(tradeShortEntry) and normalShortBiasPass and normalShortContextPass and normalShortTargetPass and shortPoiRetestPass and shortEvidencePass and not shortPoiInvalidatedLatched)
bool shortScoreTargetClear = shortHardSignalGate ? f_eng3_target_liquidity_clear(activeShortTarget, eng1_exe_liq_low, eng1_exe_eql_active ? eng1_exe_liq_low : na, eng1CtxRangeLow, shortUsesExternalDolTarget) : false
bool shortScoreHtfPenalty = shortHardSignalGate ? (eng1_narr_strength == "Strong" and displayNarrBias == 1) : false
bool shortScorePdPenalty = shortHardSignalGate ? (not na(tradeShortEntry) and eng1CtxRangeReady and not na(eng1CtxEquilibrium) and tradeShortEntry < eng1CtxEquilibrium) : false
bool shortScoreFvgPenalty = shortHardSignalGate ? (sFvg and (shortPoiMitigatedLatched or shortChased)) : false
bool shortScoreVolumeBonus = shortHardSignalGate and shortPoiRetestPass and scoreVolDrop
int shortSignalScore = shortHardSignalGate ? f_eng3_dynamic_signal_score(effectiveShortSweepSeen, exe_short_displacement_signal, exe_short_mss_signal, hasBearFvg, exe_short_pd_pass, strictKillzoneActive, shortScoreTargetClear, shortScoreHtfPenalty, shortScorePdPenalty, shortScoreFvgPenalty) + (shortScoreVolumeBonus ? 1 : 0) : 0
bool exe_short_contract_confirm = strictModeEnabled ? (strictShortBiasPass and strictShortContextTfPass and strictShortSweepPass and strictShortMssPass and strictShortDisplacementPass and strictShortPdPass and strictShortOtePass and strictShortDolPass and strictShortKillzonePass) : shortSignalScore >= 6
bool exe_short_confirm = eng1_exec_valid and not na(tradeShortEntry) and exe_short_contract_confirm
shortArmedLatched := shortArmedLatched or exe_short_confirm
bool shortManagedHit = shortArmedLatched and shortPoiMitigatedLatched and not na(shortRisk) and not na(eng3SignalLow) and eng3SignalLow <= tradeShortEntry - shortRisk * setupManagedR
bool shortStopHit = shortArmedLatched and not na(tradeShortStop) and not na(eng3SignalHigh) and eng3SignalHigh >= tradeShortStop
bool shortTpHit = shortArmedLatched and shortPoiMitigatedLatched and not na(activeShortTarget) and not na(eng3SignalLow) and eng3SignalLow <= activeShortTarget
[nextShortManagedLatched, nextShortCompletedLatched, nextShortAmbiguousLatched, nextShortInvalidatedLatched, shortManaged, shortCompleted, shortAmbiguous, shortInvalidated, shortExpired] = f_eng3_update_trade_lifecycle(currentShortSetupTag, lastShortSetupTag, shortManagedLatched, shortCompletedLatched, shortAmbiguousLatched, shortInvalidatedLatched, shortArmedLatched and shortPoiMitigatedLatched, shortManagedHit, shortStopHit, shortTpHit, shortArmedLatched and effectiveShortStructureInvalidated, shortSetupAge, expiryBarsEffective)
lastShortSetupTag := currentShortSetupTag
shortManagedLatched := nextShortManagedLatched
shortCompletedLatched := nextShortCompletedLatched
shortAmbiguousLatched := nextShortAmbiguousLatched
shortInvalidatedLatched := nextShortInvalidatedLatched

bool dashLongTriggerSweepOk = strictModeEnabled ? strictLongSweepPass : effectiveLongSweepSeen
bool dashShortTriggerSweepOk = strictModeEnabled ? strictShortSweepPass : effectiveShortSweepSeen
bool dashLongTriggerMssOk = strictModeEnabled ? strictLongMssPass : (effectiveLongMssSeen and effectiveLongDirectional)
bool dashShortTriggerMssOk = strictModeEnabled ? strictShortMssPass : (effectiveShortMssSeen and effectiveShortDirectional)
bool dashLongTriggerDisplacementOk = strictModeEnabled ? strictLongDisplacementPass : effectiveLongDisplacementSeen
bool dashShortTriggerDisplacementOk = strictModeEnabled ? strictShortDisplacementPass : effectiveShortDisplacementSeen

// Dynamic signal grading is intentionally small: hard gates protect validity,
// while the score only ranks confluence quality. Volume and value acceptance
// are one-point bonuses, not mandatory AVP-style gates, so normal mode remains
// simple and non-overfit.
bool longZoneQualityResponsePass = strictModeEnabled ? (exe_long_pd_pass and exe_long_ote_pass) : (longPriceInZone or longPriceNearZone or lTch or exe_long_pd_pass)
bool shortZoneQualityResponsePass = strictModeEnabled ? (exe_short_pd_pass and exe_short_ote_pass) : (shortPriceInZone or shortPriceNearZone or sTch or exe_short_pd_pass)
bool longLifecycleDirectionalPass = strictModeEnabled ? strictLongDirectionalPass : effectiveLongDirectional
bool shortLifecycleDirectionalPass = strictModeEnabled ? strictShortDirectionalPass : effectiveShortDirectional
bool longLifecycleBasePass = longArmedLatched or (not na(tradeLongEntry) and longLifecycleDirectionalPass and effectiveLongMssSeen and (effectiveLongSweepSeen or longPriceInZone or longPriceNearZone))
bool shortLifecycleBasePass = shortArmedLatched or (not na(tradeShortEntry) and shortLifecycleDirectionalPass and effectiveShortMssSeen and (effectiveShortSweepSeen or shortPriceInZone or shortPriceNearZone))
float contextDepartureRange = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeLow : na
bool longZoneOverlapBonus = (lOb or lFvg) and hasBullOb and hasBullFvg and f_zoneIntersects(ctxBullObTop, ctxBullObBottom, ctxBullFvgTop, ctxBullFvgBottom)
bool shortZoneOverlapBonus = (sOb or sFvg) and hasBearOb and hasBearFvg and f_zoneIntersects(ctxBearObTop, ctxBearObBottom, ctxBearFvgTop, ctxBearFvgBottom)
int longZoneResponseScore = (not na(tradeLongEntry) ? (longZoneQualityResponsePass ? 2 : 1) : 0) + (longZoneOverlapBonus ? 1 : 0)
int shortZoneResponseScore = (not na(tradeShortEntry) ? (shortZoneQualityResponsePass ? 2 : 1) : 0) + (shortZoneOverlapBonus ? 1 : 0)
int longZoneDisplacementScore = effectiveLongDisplacementSeen ? 2 : 0
int shortZoneDisplacementScore = effectiveShortDisplacementSeen ? 2 : 0
int zoneAtrExpansionScore = na(contextDepartureRange) ? 0 : contextDepartureRange >= atrSafe * 2.0 ? 2 : contextDepartureRange >= atrSafe ? 1 : 0
string longQualityTier = f_zoneQualityTier(not na(tradeLongEntry), longZoneResponseScore, longZoneDisplacementScore, zoneAtrExpansionScore)
string shortQualityTier = f_zoneQualityTier(not na(tradeShortEntry), shortZoneResponseScore, shortZoneDisplacementScore, zoneAtrExpansionScore)
string longExecutionState = f_setupExecutionState(not na(tradeLongEntry), longAmbiguous, longInvalidated, longExpired, longChased, longCompleted, longManaged, longLifecycleBasePass, exe_long_confirm or longArmedLatched, effectiveLongMssSeen or longArmedLatched, effectiveLongDisplacementSeen or longArmedLatched, longPriceInZone or longPoiMitigatedLatched, longPriceNearZone)
string shortExecutionState = f_setupExecutionState(not na(tradeShortEntry), shortAmbiguous, shortInvalidated, shortExpired, shortChased, shortCompleted, shortManaged, shortLifecycleBasePass, exe_short_confirm or shortArmedLatched, effectiveShortMssSeen or shortArmedLatched, effectiveShortDisplacementSeen or shortArmedLatched, shortPriceInZone or shortPoiMitigatedLatched, shortPriceNearZone)
bool longRiskVisible = f_executionRiskVisible(longExecutionState)
bool shortRiskVisible = f_executionRiskVisible(shortExecutionState)
bool longExecutionTerminal = f_executionTerminal(longExecutionState)
bool shortExecutionTerminal = f_executionTerminal(shortExecutionState)
bool longExecutionActive = longExecutionState == "Active"
bool shortExecutionActive = shortExecutionState == "Active"
bool longLifecycleRetired = f_eng4_retired_state(longExecutionState, longSetupAge, longPoiMitigatedLatched, expiryBarsEffective)
bool shortLifecycleRetired = f_eng4_retired_state(shortExecutionState, shortSetupAge, shortPoiMitigatedLatched, expiryBarsEffective)
bool longLifecycleStaleRetired = longLifecycleRetired and not longCompleted and not longInvalidated and not longExpired and not longChased and not longPoiInvalidatedLatched
bool shortLifecycleStaleRetired = shortLifecycleRetired and not shortCompleted and not shortInvalidated and not shortExpired and not shortChased and not shortPoiInvalidatedLatched
string longPoiRetireReason = f_eng3_poi_retire_reason(longCompleted, longInvalidated or longPoiInvalidatedLatched, longExpired, longChased, longLifecycleStaleRetired)
string shortPoiRetireReason = f_eng3_poi_retire_reason(shortCompleted, shortInvalidated or shortPoiInvalidatedLatched, shortExpired, shortChased, shortLifecycleStaleRetired)
if eng3LongActivePoiIdentity != "" and (longPoiInvalidatedLatched or longLifecycleRetired)
    eng3LongConsumedPoiIdentity := eng3LongActivePoiIdentity
if eng3ShortActivePoiIdentity != "" and (shortPoiInvalidatedLatched or shortLifecycleRetired)
    eng3ShortConsumedPoiIdentity := eng3ShortActivePoiIdentity
string longPoiLifecycle = f_eng3_poi_lifecycle(poi_long_contract_valid, poi_long_type, longPoiTappedLatched, longPoiMitigatedLatched, longPoiInvalidatedLatched)
string shortPoiLifecycle = f_eng3_poi_lifecycle(poi_short_contract_valid, poi_short_type, shortPoiTappedLatched, shortPoiMitigatedLatched, shortPoiInvalidatedLatched)
bool longPoiActionable = longPoiLifecycle == "Fresh" or longPoiLifecycle == "Tapped" or longPoiLifecycle == "Breaker"
bool shortPoiActionable = shortPoiLifecycle == "Fresh" or shortPoiLifecycle == "Tapped" or shortPoiLifecycle == "Breaker"
bool longPoiMitigated = longPoiLifecycle == "Mitigated"
bool shortPoiMitigated = shortPoiLifecycle == "Mitigated"
bool longPoiEventReached = longPoiTappedLatched or longPoiMitigatedLatched
bool shortPoiEventReached = shortPoiTappedLatched or shortPoiMitigatedLatched

string longZoneQualityText = poi_long_contract_valid and longPoiActionable and not na(tradeLongEntry) ? longQualityTier : "-"
string shortZoneQualityText = poi_short_contract_valid and shortPoiActionable and not na(tradeShortEntry) ? shortQualityTier : "-"

// Selected POI stays visible through Fresh/Tapped/Mitigated, but Engine 2 only
// promotes it to SetupReady after Engine 3 has an armed/active risk state.
bool longSelectedVisualActive = not na(tradeLongEntry) and (longPoiActionable or longPoiMitigated) and not longExecutionTerminal
bool shortSelectedVisualActive = not na(tradeShortEntry) and (shortPoiActionable or shortPoiMitigated) and not shortExecutionTerminal
bool eng2SignalEventsStateReady = longRiskVisible or shortRiskVisible or (poi_long_contract_valid and longPoiActionable) or (poi_short_contract_valid and shortPoiActionable)
string preferredDirection = "Wait"
bool longPriorityCandidate = not na(tradeLongEntry) and not longLifecycleRetired
bool shortPriorityCandidate = not na(tradeShortEntry) and not shortLifecycleRetired
if longRiskVisible and not shortRiskVisible
    preferredDirection := "Long"
else if shortRiskVisible and not longRiskVisible
    preferredDirection := "Short"
else if longRiskVisible and shortRiskVisible
    preferredDirection := "Balanced"

bool compactUseLong = preferredDirection == "Long"
if preferredDirection == "Short"
    compactUseLong := false
else
    if longPriorityCandidate and not shortPriorityCandidate
        compactUseLong := true
    else if shortPriorityCandidate and not longPriorityCandidate
        compactUseLong := false
    else if not na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := tradeLongCreatedBar >= tradeShortCreatedBar
    else if na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := false

//------------------------------------------------------------------------------
// ENGINE 2
// MAIN_CONTRACT order 8: render chart from snapshots only, after Engine 3 has
// produced zone, confirmations, trade plan, and lifecycle snapshots.
//------------------------------------------------------------------------------

bool longDrawSel = longSelectedVisualActive and ((lOb and showOb) or (lFvg and showFvg))
bool shortDrawSel = shortSelectedVisualActive and ((sOb and showOb) or (sFvg and showFvg))
float longZoneTop = longDrawSel ? tradeLongValidTop : na
float longZoneBot = longDrawSel ? tradeLongValidBottom : na
float shortZoneTop = shortDrawSel ? tradeShortValidTop : na
float shortZoneBot = shortDrawSel ? tradeShortValidBottom : na
bool showLongLiveZone = longDrawSel and f_draw_zone_visible(draw_mode, true, true, preferredDirection)
bool showShortLiveZone = shortDrawSel and f_draw_zone_visible(draw_mode, true, false, preferredDirection)

if longExecutionTerminal and not longSetupMissing and eng2LongHistoryTag != currentLongSetupTag
    eng2LongHistoryTag := currentLongSetupTag
    eng2LongHistoryLeftBar := f_createdBarFallback(tradeLongCreatedBar)
    eng2LongHistoryRightBar := bar_index
    eng2LongHistoryTop := tradeLongValidTop
    eng2LongHistoryBottom := tradeLongValidBottom
    eng2LongHistoryIsOb := lOb
    eng2LongHistoryIsFvg := lFvg
if shortExecutionTerminal and not shortSetupMissing and eng2ShortHistoryTag != currentShortSetupTag
    eng2ShortHistoryTag := currentShortSetupTag
    eng2ShortHistoryLeftBar := f_createdBarFallback(tradeShortCreatedBar)
    eng2ShortHistoryRightBar := bar_index
    eng2ShortHistoryTop := tradeShortValidTop
    eng2ShortHistoryBottom := tradeShortValidBottom
    eng2ShortHistoryIsOb := sOb
    eng2ShortHistoryIsFvg := sFvg

bool histOn = eng1_exec_valid and draw_full and (showOb or showFvg) and not compactMode
// Full audit can show raw context OB/FVG, but Engine 3 remains the sole POI owner.
bool lLiveBO = showLongLiveZone and lOb and f_eng2_same_zone_visual(eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng1BullObCreatedBar, longZoneTop, longZoneBot, tradeLongCreatedBar)
bool lLiveBF = showLongLiveZone and lFvg and f_eng2_same_zone_visual(eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng1BullFvgCreatedBar, longZoneTop, longZoneBot, tradeLongCreatedBar)
bool sLiveBO = showShortLiveZone and sOb and f_eng2_same_zone_visual(eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng1BearObCreatedBar, shortZoneTop, shortZoneBot, tradeShortCreatedBar)
bool sLiveBF = showShortLiveZone and sFvg and f_eng2_same_zone_visual(eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng1BearFvgCreatedBar, shortZoneTop, shortZoneBot, tradeShortCreatedBar)
bool lCtxBO = histOn and showOb and not na(eng1_ctx_bull_ob_top) and not na(eng1_ctx_bull_ob_bottom) and not lLiveBO
bool lCtxBF = histOn and showFvg and not na(eng1_ctx_bull_fvg_top) and not na(eng1_ctx_bull_fvg_bottom) and not lLiveBF
bool sCtxBO = histOn and showOb and not na(eng1_ctx_bear_ob_top) and not na(eng1_ctx_bear_ob_bottom) and not sLiveBO
bool sCtxBF = histOn and showFvg and not na(eng1_ctx_bear_fvg_top) and not na(eng1_ctx_bear_fvg_bottom) and not sLiveBF
// Active/current context owns the right edge. If the same OB/FVG is still live
// in Engine 1, hide the stale terminal snapshot so the active zone can continue
// to the current bar instead of looking visually cut off.
float lHTop = eng2LongHistoryTop
float lHBot = eng2LongHistoryBottom
float sHTop = eng2ShortHistoryTop
float sHBot = eng2ShortHistoryBottom
int lHBar = eng2LongHistoryLeftBar
int sHBar = eng2ShortHistoryLeftBar
bool lHistCand = histOn and eng2LongHistoryTag != "" and not na(lHTop) and not na(lHBot) and ((eng2LongHistoryIsOb and showOb) or (eng2LongHistoryIsFvg and showFvg)) and not f_eng3_poi_invalidated(true, lHTop, lHBot, eng3SignalClose)
bool showLHistZone = f_eng2_hist_zone_visible(lHistCand, showLongLiveZone, (eng2LongHistoryIsOb and lOb) or (eng2LongHistoryIsFvg and lFvg), longZoneTop, longZoneBot, tradeLongCreatedBar, lCtxBO and eng2LongHistoryIsOb, eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng1BullObCreatedBar, lCtxBF and eng2LongHistoryIsFvg, eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng1BullFvgCreatedBar, lHTop, lHBot, lHBar)
bool sHistCand = histOn and eng2ShortHistoryTag != "" and not na(sHTop) and not na(sHBot) and ((eng2ShortHistoryIsOb and showOb) or (eng2ShortHistoryIsFvg and showFvg)) and not f_eng3_poi_invalidated(false, sHTop, sHBot, eng3SignalClose)
bool showSHistZone = f_eng2_hist_zone_visible(sHistCand, showShortLiveZone, (eng2ShortHistoryIsOb and sOb) or (eng2ShortHistoryIsFvg and sFvg), shortZoneTop, shortZoneBot, tradeShortCreatedBar, sCtxBO and eng2ShortHistoryIsOb, eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng1BearObCreatedBar, sCtxBF and eng2ShortHistoryIsFvg, eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng1BearFvgCreatedBar, sHTop, sHBot, sHBar)
// Keep terminal history snapshots frozen so old zones do not read as live POI.
string lzText = f_eng2_zone_label_text(longDrawSel ? (lOb ? f_obLabelText(true, eng1_ctx_bull_ob_breaker) : lFvg ? "FVG" : "") : "", longPoiLifecycle, poi_long_type, f_executionStateBadge(longExecutionState, compactMode), longZoneQualityText)
string szText = f_eng2_zone_label_text(shortDrawSel ? (sOb ? f_obLabelText(false, eng1_ctx_bear_ob_breaker) : sFvg ? "FVG" : "") : "", shortPoiLifecycle, poi_short_type, f_executionStateBadge(shortExecutionState, compactMode), shortZoneQualityText)
int lzBw = longPoiMitigated ? 1 : math.max(longZoneQualityText == "Q3" ? 3 : 2, longExecutionActive ? 3 : 2)
int szBw = shortPoiMitigated ? 1 : math.max(shortZoneQualityText == "Q3" ? 3 : 2, shortExecutionActive ? 3 : 2)
color lzBrd = color.new(bullColor, longPoiMitigated ? 70 : f_zoneQualityBorderAlpha(longZoneQualityText, longExecutionState))
color szBrd = color.new(bearColor, shortPoiMitigated ? 70 : f_zoneQualityBorderAlpha(shortZoneQualityText, shortExecutionState))
color lzFill = color.new(bullColor, longPoiMitigated ? 92 : f_executionSelectedFillAlpha(longExecutionState))
color szFill = color.new(bearColor, shortPoiMitigated ? 92 : f_executionSelectedFillAlpha(shortExecutionState))

bool showCtxBO = f_eng2_ctx_zone_visible(lCtxBO, showLHistZone, eng2LongHistoryIsOb, eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng1BullObCreatedBar, lHTop, lHBot, lHBar, true, eng3SignalClose)
bool showCtxBF = f_eng2_ctx_zone_visible(lCtxBF, showLHistZone, eng2LongHistoryIsFvg, eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng1BullFvgCreatedBar, lHTop, lHBot, lHBar, true, eng3SignalClose)
bool showCtxSO = f_eng2_ctx_zone_visible(sCtxBO, showSHistZone, eng2ShortHistoryIsOb, eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng1BearObCreatedBar, sHTop, sHBot, sHBar, false, eng3SignalClose)
bool showCtxSF = f_eng2_ctx_zone_visible(sCtxBF, showSHistZone, eng2ShortHistoryIsFvg, eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng1BearFvgCreatedBar, sHTop, sHBot, sHBar, false, eng3SignalClose)
// Empty passive context paths skip sync work; existing handles still clear here.
if lastBar and (showCtxBO or showCtxBF or showCtxSO or showCtxSF or not na(eng2CtxBullObBox) or not na(eng2CtxBullObLabel) or not na(eng2CtxBullFvgBox) or not na(eng2CtxBullFvgLabel) or not na(eng2CtxBearObBox) or not na(eng2CtxBearObLabel) or not na(eng2CtxBearFvgBox) or not na(eng2CtxBearFvgLabel))
    [cboB, cboL] = f_eng2_syncCtxZone(eng2CtxBullObBox, eng2CtxBullObLabel, showCtxBO, eng1BullObCreatedBar, eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, "AUD " + f_obLabelText(true, eng1_ctx_bull_ob_breaker), color.new(bullColor, 72), color.new(bullColor, 97))
    [cbfB, cbfL] = f_eng2_syncCtxZone(eng2CtxBullFvgBox, eng2CtxBullFvgLabel, showCtxBF, eng1BullFvgCreatedBar, eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, "AUD FVG+", color.new(bullColor, 82), color.new(bullColor, 98))
    [csoB, csoL] = f_eng2_syncCtxZone(eng2CtxBearObBox, eng2CtxBearObLabel, showCtxSO, eng1BearObCreatedBar, eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, "AUD " + f_obLabelText(false, eng1_ctx_bear_ob_breaker), color.new(bearColor, 72), color.new(bearColor, 97))
    [csfB, csfL] = f_eng2_syncCtxZone(eng2CtxBearFvgBox, eng2CtxBearFvgLabel, showCtxSF, eng1BearFvgCreatedBar, eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, "AUD FVG-", color.new(bearColor, 82), color.new(bearColor, 98))
    eng2CtxBullObBox := cboB
    eng2CtxBullObLabel := cboL
    eng2CtxBullFvgBox := cbfB
    eng2CtxBullFvgLabel := cbfL
    eng2CtxBearObBox := csoB
    eng2CtxBearObLabel := csoL
    eng2CtxBearFvgBox := csfB
    eng2CtxBearFvgLabel := csfL

// Empty live setup paths skip sync work; existing objects still clear here.
if lastBar and (showLongLiveZone or f_liveZoneHasHandles(eng2LongZoneBox, eng2LongZoneLine, eng2LongZoneLabel))
    [lzb, lzl, lzlab] = f_eng2_syncLiveZone(eng2LongZoneBox, eng2LongZoneLine, eng2LongZoneLabel, showLongLiveZone, tradeLongCreatedBar, longZoneTop, longZoneBot, tradeLongEntry, lzText, lOb ? label.style_label_right : label.style_label_left, lzBrd, lzFill, lzBw, lOb or lFvg, longExecutionState)
    eng2LongZoneBox := lzb
    eng2LongZoneLine := lzl
    eng2LongZoneLabel := lzlab
if lastBar and (showShortLiveZone or f_liveZoneHasHandles(eng2ShortZoneBox, eng2ShortZoneLine, eng2ShortZoneLabel))
    [szb, szl, szlab] = f_eng2_syncLiveZone(eng2ShortZoneBox, eng2ShortZoneLine, eng2ShortZoneLabel, showShortLiveZone, tradeShortCreatedBar, shortZoneTop, shortZoneBot, tradeShortEntry, szText, sOb ? label.style_label_right : label.style_label_left, szBrd, szFill, szBw, sOb or sFvg, shortExecutionState)
    eng2ShortZoneBox := szb
    eng2ShortZoneLine := szl
    eng2ShortZoneLabel := szlab

// History boxes should stay visible, but feel lighter than the live / selected zone.
// Empty history paths skip sync work; existing boxes still clear here.
if lastBar and (showLHistZone or not na(eng2LongHistoryBox))
    eng2LongHistoryBox := f_eng2_syncHistBox(eng2LongHistoryBox, showLHistZone, lHBar, eng2LongHistoryRightBar, lHTop, lHBot, color.new(bullColor, 80), color.new(bullColor, 98), 1)
if lastBar and (showSHistZone or not na(eng2ShortHistoryBox))
    eng2ShortHistoryBox := f_eng2_syncHistBox(eng2ShortHistoryBox, showSHistZone, sHBar, eng2ShortHistoryRightBar, sHTop, sHBot, color.new(bearColor, 80), color.new(bearColor, 98), 1)

bool eng2LongSetupEventAllowed = draw_show_setup_events and eng2SignalEventsStateReady and showLongLiveZone
bool eng2ShortSetupEventAllowed = draw_show_setup_events and eng2SignalEventsStateReady and showShortLiveZone
bool eng2FullLabelBudgetTight = freeSafeMode and draw_full
bool eng2RawEventLabelsAllowed = eng1_exec_valid and eng2SignalEventsStateReady and not (showLongLiveZone or showShortLiveZone) and not eng2FullLabelBudgetTight
bool eng2KeepSweepLabels = displaySweepMarkers and eng2RawEventLabelsAllowed
int eng2EventTfSeconds = timeframe.in_seconds()
int eng2EventKeepCap = eng2KeepSweepLabels or eng2LongSetupEventAllowed or eng2ShortSetupEventAllowed ? (freeSafeMode ? (draw_full ? (eng2EventTfSeconds <= 60 ? 3 : eng2EventTfSeconds <= 300 ? 4 : 5) : 5) : draw_full ? (eng2EventTfSeconds <= 60 ? 6 : eng2EventTfSeconds <= 300 ? 8 : 10) : 10) : 0
f_eng2_trim_label_history(eng2SignalEventLabelHistory, eng2EventKeepCap)
if not eng2LongSetupEventAllowed and (eng2LongTappedEventTag != "" or eng2LongMitigatedEventTag != "")
    eng2LongTappedEventTag := ""
    eng2LongMitigatedEventTag := ""
if not eng2ShortSetupEventAllowed and (eng2ShortTappedEventTag != "" or eng2ShortMitigatedEventTag != "")
    eng2ShortTappedEventTag := ""
    eng2ShortMitigatedEventTag := ""
if not eng2KeepSweepLabels and (not na(eng2LastLongSweepLabelBar) or not na(eng2LastShortSweepLabelBar) or not na(eng2LastBullDispLabelBar) or not na(eng2LastBearDispLabelBar))
    eng2LastLongSweepLabelBar := na
    eng2LastShortSweepLabelBar := na
    eng2LastBullDispLabelBar := na
    eng2LastBearDispLabelBar := na

bool eng2EventCreateAllowed = barstate.isnew
bool eng2RawEventCreateReady = eng2EventCreateAllowed and eng2RawEventLabelsAllowed
bool eng2LongSetupEventStateReady = eng2EventCreateAllowed and eng2LongSetupEventAllowed
bool eng2ShortSetupEventStateReady = eng2EventCreateAllowed and eng2ShortSetupEventAllowed
if eng2RawEventCreateReady or eng2LongSetupEventStateReady or eng2ShortSetupEventStateReady
    int eng2EventTime = nz(f_eng1_select_execution_time(eng1_exec_tf), time)
    float eng2EventLow = nz(eng3SignalLow, low)
    float eng2EventHigh = nz(eng3SignalHigh, high)
    bool eng2SweepEventStateReady = eng2RawEventCreateReady and displaySweepMarkers and eng1_exec_valid
    bool eng2StructureEventStateReady = eng2RawEventCreateReady and draw_show_structure
    if eng2SweepEventStateReady or eng2StructureEventStateReady
        int eng2RawEventCooldownBars = chartTfSeconds <= 60 ? 8 : chartTfSeconds <= 300 ? 5 : chartTfSeconds <= 900 ? 3 : 2
        if eng2SweepEventStateReady
            if (na(eng2LastLongSweepLabelBar) or bar_index - eng2LastLongSweepLabelBar >= eng2RawEventCooldownBars) and effectiveLongSweepSeen and not effectiveLongSweepSeen[1]
                eng2LastLongSweepLabelBar := bar_index
                f_eng2_emitSignalEvent(eng2EventTime, eng2EventLow, eng1_exe_eql_active ? "EQL Sweep" : "SSL Sweep", color.new(bullColor, 12), false, 0.98)
            if (na(eng2LastShortSweepLabelBar) or bar_index - eng2LastShortSweepLabelBar >= eng2RawEventCooldownBars) and effectiveShortSweepSeen and not effectiveShortSweepSeen[1]
                eng2LastShortSweepLabelBar := bar_index
                f_eng2_emitSignalEvent(eng2EventTime, eng2EventHigh, eng1_exe_eqh_active ? "EQH Sweep" : "BSL Sweep", color.new(bearColor, 12), true, 0.98)
        if eng2StructureEventStateReady
            if (na(eng2LastBullDispLabelBar) or bar_index - eng2LastBullDispLabelBar >= eng2RawEventCooldownBars) and ((eng1_exe_bull_displacement and not eng1_exe_bull_displacement[1]) or (longDispFallback and not longDispFallback[1]))
                eng2LastBullDispLabelBar := bar_index
                f_eng2_emitSignalEvent(eng2EventTime, eng2EventLow, "Disp+", color.new(bullColor, 15), false, 1.26)
            if (na(eng2LastBearDispLabelBar) or bar_index - eng2LastBearDispLabelBar >= eng2RawEventCooldownBars) and ((eng1_exe_bear_displacement and not eng1_exe_bear_displacement[1]) or (shortDispFallback and not shortDispFallback[1]))
                eng2LastBearDispLabelBar := bar_index
                f_eng2_emitSignalEvent(eng2EventTime, eng2EventHigh, "Disp-", color.new(bearColor, 15), true, 1.26)
    if eng2LongSetupEventStateReady or eng2ShortSetupEventStateReady
        bool eng2LongSetupLabelReady = eng2LongSetupEventStateReady and not longSetupMissing
        bool eng2ShortSetupLabelReady = eng2ShortSetupEventStateReady and not shortSetupMissing
        if eng2LongSetupLabelReady and longPoiTappedLatched and eng2LongTappedEventTag != currentLongSetupTag
            eng2LongTappedEventTag := currentLongSetupTag
            f_eng2_emitSignalEvent(eng2EventTime, nz(tradeLongEntry, eng2EventLow), "Tapped", color.new(bullColor, 5), false, 1.50)
        if eng2LongSetupLabelReady and longPoiMitigatedLatched and eng2LongMitigatedEventTag != currentLongSetupTag
            eng2LongMitigatedEventTag := currentLongSetupTag
            f_eng2_emitSignalEvent(eng2EventTime, nz(tradeLongEntry, eng2EventLow), "CE Hit", color.new(bullColor, 0), false, 1.72)
        if eng2ShortSetupLabelReady and shortPoiTappedLatched and eng2ShortTappedEventTag != currentShortSetupTag
            eng2ShortTappedEventTag := currentShortSetupTag
            f_eng2_emitSignalEvent(eng2EventTime, nz(tradeShortEntry, eng2EventHigh), "Tapped", color.new(bearColor, 5), true, 1.50)
        if eng2ShortSetupLabelReady and shortPoiMitigatedLatched and eng2ShortMitigatedEventTag != currentShortSetupTag
            eng2ShortMitigatedEventTag := currentShortSetupTag
            f_eng2_emitSignalEvent(eng2EventTime, nz(tradeShortEntry, eng2EventHigh), "CE Hit", color.new(bearColor, 0), true, 1.72)
        bool eng2SetupExtraLabelsAllowed = not eng2FullLabelBudgetTight
        bool eng2LongContReady = eng2SetupExtraLabelsAllowed and eng2LongSetupEventStateReady and not longExecutionTerminal and not na(tradeLongEntry) and longPoiEventReached
        bool eng2ShortContReady = eng2SetupExtraLabelsAllowed and eng2ShortSetupEventStateReady and not shortExecutionTerminal and not na(tradeShortEntry) and shortPoiEventReached
        if eng2LongContReady or eng2ShortContReady
            if eng2LongContReady and ((eng1_exe_bull_bos and not eng1_exe_bull_bos[1]) or (eng1_exe_bull_mss and not eng1_exe_bull_mss[1]) or (eng1_exe_bull_choch and not eng1_exe_bull_choch[1]))
                f_eng2_emitSignalEvent(eng2EventTime, eng2EventLow, (eng1_exe_bull_mss or eng1_exe_bull_choch) ? "iMSS Cont" : "iBOS Cont", color.new(bullColor, 0), false, 1.94)
            if eng2ShortContReady and ((eng1_exe_bear_bos and not eng1_exe_bear_bos[1]) or (eng1_exe_bear_mss and not eng1_exe_bear_mss[1]) or (eng1_exe_bear_choch and not eng1_exe_bear_choch[1]))
                f_eng2_emitSignalEvent(eng2EventTime, eng2EventHigh, (eng1_exe_bear_mss or eng1_exe_bear_choch) ? "iMSS Cont" : "iBOS Cont", color.new(bearColor, 0), true, 1.94)
            if eng2LongContReady and ((eng1_ctx_bull_breakout and not eng1_ctx_bull_breakout[1]) or (eng1_ctx_bull_choch and not eng1_ctx_bull_choch[1]))
                f_eng2_emitSignalEvent(eng2EventTime, eng2EventLow, eng1_ctx_bull_choch ? "sMSS Cont" : "sBOS Cont", color.new(bullColor, 0), false, 2.18)
            if eng2ShortContReady and ((eng1_ctx_bear_breakout and not eng1_ctx_bear_breakout[1]) or (eng1_ctx_bear_choch and not eng1_ctx_bear_choch[1]))
                f_eng2_emitSignalEvent(eng2EventTime, eng2EventHigh, eng1_ctx_bear_choch ? "sMSS Cont" : "sBOS Cont", color.new(bearColor, 0), true, 2.18)
        if showOb and eng2SetupExtraLabelsAllowed and (eng2LongSetupEventStateReady or eng2ShortSetupEventStateReady)
            int eng2BullBreakerLabelTime = nz(eng1_ctx_bull_ob_breaker_time, eng1_ctx_bull_ob_bar)
            int eng2BearBreakerLabelTime = nz(eng1_ctx_bear_ob_breaker_time, eng1_ctx_bear_ob_bar)
            if eng2LongSetupEventStateReady and eng1_ctx_bull_ob_breaker and not na(eng2BullBreakerLabelTime) and eng2BullBreakerLabelTime != nz(eng1_ctx_bull_ob_breaker_time[1], eng1_ctx_bull_ob_bar[1])
                f_eng2_emitSignalEvent(nz(eng2BullBreakerLabelTime, time), not na(eng1_ctx_bull_ob_top) and not na(eng1_ctx_bull_ob_bottom) ? f_zoneMid(eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom) : eng2EventLow, "BRK+", color.new(bullColor, 0), false, 2.42)
            if eng2ShortSetupEventStateReady and eng1_ctx_bear_ob_breaker and not na(eng2BearBreakerLabelTime) and eng2BearBreakerLabelTime != nz(eng1_ctx_bear_ob_breaker_time[1], eng1_ctx_bear_ob_bar[1])
                f_eng2_emitSignalEvent(nz(eng2BearBreakerLabelTime, time), not na(eng1_ctx_bear_ob_top) and not na(eng1_ctx_bear_ob_bottom) ? f_zoneMid(eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom) : eng2EventHigh, "BRK-", color.new(bearColor, 0), true, 2.42)
    f_eng2_trim_label_history(eng2SignalEventLabelHistory, eng2EventKeepCap)

//------------------------------------------------------------------------------
// Session range visuals
//------------------------------------------------------------------------------
bool sessOn = showSessionVisuals and draw_full and timeframe.isintraday

if not sessOn and (array.size(sessionRangeBoxes) > 0 or array.size(sessionRangeLabels) > 0 or array.size(sessionRangeHighLines) > 0 or array.size(sessionRangeLowLines) > 0 or array.size(sessionRangeNames) > 0)
    f_trimSessionVisuals(0)

if f_sessLaneHasHandles(activeAsiaSessionBox, activeAsiaSessionLabel, activeAsiaSessionHighLine, activeAsiaSessionLowLine, activeAsiaSessionStartBar) or (sessOn and (vAsOn or vAsNew or vAsEnd))
    [aBox, aLab, aHi, aLo, aSt] = f_eng2_syncSessLane(sessOn, vAsOn, vAsNew, vAsEnd, activeAsiaSessionBox, activeAsiaSessionLabel, activeAsiaSessionHighLine, activeAsiaSessionLowLine, activeAsiaSessionStartBar, "Asia", vAsHi, vAsLo)
    activeAsiaSessionBox := aBox
    activeAsiaSessionLabel := aLab
    activeAsiaSessionHighLine := aHi
    activeAsiaSessionLowLine := aLo
    activeAsiaSessionStartBar := aSt

if f_sessLaneHasHandles(activeLondonSessionBox, activeLondonSessionLabel, activeLondonSessionHighLine, activeLondonSessionLowLine, activeLondonSessionStartBar) or (sessOn and (vLdOn or vLdNew or vLdEnd))
    [lBox, lLab, lHi, lLo, lSt] = f_eng2_syncSessLane(sessOn, vLdOn, vLdNew, vLdEnd, activeLondonSessionBox, activeLondonSessionLabel, activeLondonSessionHighLine, activeLondonSessionLowLine, activeLondonSessionStartBar, "London", vLdHi, vLdLo)
    activeLondonSessionBox := lBox
    activeLondonSessionLabel := lLab
    activeLondonSessionHighLine := lHi
    activeLondonSessionLowLine := lLo
    activeLondonSessionStartBar := lSt

if f_sessLaneHasHandles(activeNewYorkSessionBox, activeNewYorkSessionLabel, activeNewYorkSessionHighLine, activeNewYorkSessionLowLine, activeNewYorkSessionStartBar) or (sessOn and (vNyOn or vNyNew or vNyEnd))
    [nBox, nLab, nHi, nLo, nSt] = f_eng2_syncSessLane(sessOn, vNyOn, vNyNew, vNyEnd, activeNewYorkSessionBox, activeNewYorkSessionLabel, activeNewYorkSessionHighLine, activeNewYorkSessionLowLine, activeNewYorkSessionStartBar, "New York", vNyHi, vNyLo)
    activeNewYorkSessionBox := nBox
    activeNewYorkSessionLabel := nLab
    activeNewYorkSessionHighLine := nHi
    activeNewYorkSessionLowLine := nLo
    activeNewYorkSessionStartBar := nSt

int sessCnt = array.size(sessionRangeBoxes)
if lastBar and sessOn and sessCnt > 0
    for i = 0 to sessCnt - 1
        sessionHighLine = i < array.size(sessionRangeHighLines) ? array.get(sessionRangeHighLines, i) : na
        sessionLowLine = i < array.size(sessionRangeLowLines) ? array.get(sessionRangeLowLines, i) : na
        if not na(sessionHighLine)
            line.set_x2(sessionHighLine, bar_index)
        if not na(sessionLowLine)
            line.set_x2(sessionLowLine, bar_index)

//------------------------------------------------------------------------------
// Zone visual policy
// Live OB/FVG zones are selected by Engine 3. Engine 2 only renders the selected
// active zone plus non-duplicated context/range levels allowed by draw_mode.
//------------------------------------------------------------------------------
// Liquidity labels are semantic: EQH/EQL are equal-high/low pools, BSL/SSL are
// execution swing pools, ERL marks dealing-range extremes, and PD/PW/PM levels
// mark previous period liquidity; internal engine aliases stay off the chart.
showEqHighVisual = showLiquidity and not compactMode and f_draw_level_visible(draw_mode, f_preferredLevelMatch(eng1_exe_liq_high, preferredDirection == "Balanced", compactUseLong, activeLongTarget, activeShortTarget), true, preferredDirection)
showEqLowVisual = showLiquidity and not compactMode and f_draw_level_visible(draw_mode, f_preferredLevelMatch(eng1_exe_liq_low, preferredDirection == "Balanced", compactUseLong, activeLongTarget, activeShortTarget), false, preferredDirection)
showOteVisual = strictShowOte and (draw_full or draw_focused) and draw_mode != "Minimal"
showLongRiskVisual = showRisk and not compactMode and f_executionVisualByMode(draw_mode, longRiskVisible, preferredDirection, true, compactUseLong)
showShortRiskVisual = showRisk and not compactMode and f_executionVisualByMode(draw_mode, shortRiskVisible, preferredDirection, false, compactUseLong)

if not draw_full
    showEqHighVisual := f_uniqueLevelVisual(showEqHighVisual, eng1_exe_liq_high, false, na, false, na, false, na, false, na, false, na)
    showEqLowVisual := f_uniqueLevelVisual(showEqLowVisual, eng1_exe_liq_low, false, na, false, na, false, na, false, na, false, na)

//------------------------------------------------------------------------------
// Active Levels (single-instance lines)
// Keep these non-historical to avoid scattered segments when levels update.
//------------------------------------------------------------------------------
eqHighLevel = showEqHighVisual ? eng1_exe_liq_high : na
eqLowLevel = showEqLowVisual ? eng1_exe_liq_low : na
bool dealingRangeValid = not na(eng2DealHigh) and not na(eng2DealLow) and not na(eng2DealLeftBar) and eng2DealHigh > eng2DealLow
bool showDealingRangeVisual = showLiquidity and showInternalRange and not compactMode and draw_mode != "Minimal" and dealingRangeValid and not eng2DealBroken
float dealingRangeHighLevel = showDealingRangeVisual ? eng2DealHigh : na
float dealingRangeLowLevel = showDealingRangeVisual ? eng2DealLow : na
float dealingRangeEqLevel = showDealingRangeVisual ? (eng2DealHigh + eng2DealLow) * 0.5 : na
float dealingRangeSize = dealingRangeValid ? eng2DealHigh - eng2DealLow : na
riskBullStopLevel = showLongRiskVisual ? tradeLongStop : na
riskBearStopLevel = showShortRiskVisual ? tradeShortStop : na
oteLongTopLevel = showOteVisual and dealingRangeValid ? eng2DealHigh - dealingRangeSize * 0.62 : na
oteLongBottomLevel = showOteVisual and dealingRangeValid ? eng2DealHigh - dealingRangeSize * 0.79 : na
oteShortTopLevel = showOteVisual and dealingRangeValid ? eng2DealLow + dealingRangeSize * 0.79 : na
oteShortBottomLevel = showOteVisual and dealingRangeValid ? eng2DealLow + dealingRangeSize * 0.62 : na
rightEdgeLabelTolerance = atrSafe * 0.25
pdhLevel = calendarLiquidityRequestEnabled ? prevDayHigh : na
pdlLevel = calendarLiquidityRequestEnabled ? prevDayLow : na
pwhLevel = calendarLiquidityRequestEnabled and not f_levelsClose(prevWeekHigh, pdhLevel, rightEdgeLabelTolerance) ? prevWeekHigh : na
pwlLevel = calendarLiquidityRequestEnabled and not f_levelsClose(prevWeekLow, pdlLevel, rightEdgeLabelTolerance) ? prevWeekLow : na
pmhLevel = calendarLiquidityRequestEnabled and not f_levelsClose(prevMonthHigh, pdhLevel, rightEdgeLabelTolerance) and not f_levelsClose(prevMonthHigh, pwhLevel, rightEdgeLabelTolerance) ? prevMonthHigh : na
pmlLevel = calendarLiquidityRequestEnabled and not f_levelsClose(prevMonthLow, pdlLevel, rightEdgeLabelTolerance) and not f_levelsClose(prevMonthLow, pwlLevel, rightEdgeLabelTolerance) ? prevMonthLow : na
showPdhVisual = not na(pdhLevel)
showPdlVisual = not na(pdlLevel)
showPwhVisual = not na(pwhLevel)
showPwlVisual = not na(pwlLevel)
showPmhVisual = not na(pmhLevel)
showPmlVisual = not na(pmlLevel)
bool eqHighOverlapsCalendar = calendarLiquidityRequestEnabled and (f_levelsClose(eqHighLevel, pdhLevel, rightEdgeLabelTolerance) or f_levelsClose(eqHighLevel, pwhLevel, rightEdgeLabelTolerance) or f_levelsClose(eqHighLevel, pmhLevel, rightEdgeLabelTolerance))
bool eqLowOverlapsCalendar = calendarLiquidityRequestEnabled and (f_levelsClose(eqLowLevel, pdlLevel, rightEdgeLabelTolerance) or f_levelsClose(eqLowLevel, pwlLevel, rightEdgeLabelTolerance) or f_levelsClose(eqLowLevel, pmlLevel, rightEdgeLabelTolerance))
showShortStopRightLabel = draw_show_right_labels and showShortRiskVisual and not na(riskBearStopLevel)
showLongStopRightLabel = draw_show_right_labels and showLongRiskVisual and not na(riskBullStopLevel)
showEqHighRightLabel = draw_show_right_labels and showEqHighVisual and not eqHighOverlapsCalendar and not f_levelsClose(eqHighLevel, riskBearStopLevel, rightEdgeLabelTolerance)
showEqLowRightLabel = draw_show_right_labels and showEqLowVisual and not eqLowOverlapsCalendar and not f_levelsClose(eqLowLevel, riskBullStopLevel, rightEdgeLabelTolerance)

if lastBar
    // Lines (single instance per level)
    bool showExecEqHighLine = showEqHighVisual and not showDealingRangeVisual and not eqHighOverlapsCalendar
    bool showExecEqLowLine = showEqLowVisual and not showDealingRangeVisual and not eqLowOverlapsCalendar
    if showExecEqHighLine or showExecEqLowLine or showPdhVisual or showPdlVisual or showPwhVisual or showPwlVisual or showPmhVisual or showPmlVisual or not na(eng2BslLine) or not na(eng2SslLine) or not na(eng2PdhLine) or not na(eng2PdlLine) or not na(eng2PwhLine) or not na(eng2PwlLine) or not na(eng2PmhLine) or not na(eng2PmlLine)
        eng2BslLine := f_e2_thin_if(eng2BslLine, eqHighLevel, color.new(liqHighColor, 12), line.style_solid, showExecEqHighLine)
        eng2SslLine := f_e2_thin_if(eng2SslLine, eqLowLevel, color.new(liqLowColor, 12), line.style_solid, showExecEqLowLine)
        eng2PdhLine := f_e2_thin_if(eng2PdhLine, pdhLevel, color.new(liqHighColor, 28), line.style_dashed, showPdhVisual)
        eng2PdlLine := f_e2_thin_if(eng2PdlLine, pdlLevel, color.new(liqLowColor, 28), line.style_dashed, showPdlVisual)
        eng2PwhLine := f_e2_thin_if(eng2PwhLine, pwhLevel, color.new(color.fuchsia, 32), line.style_dashed, showPwhVisual)
        eng2PwlLine := f_e2_thin_if(eng2PwlLine, pwlLevel, color.new(color.fuchsia, 32), line.style_dashed, showPwlVisual)
        eng2PmhLine := f_e2_thin_if(eng2PmhLine, pmhLevel, color.new(color.silver, 38), line.style_dotted, showPmhVisual)
        eng2PmlLine := f_e2_thin_if(eng2PmlLine, pmlLevel, color.new(color.silver, 38), line.style_dotted, showPmlVisual)

    bool showDealingOte = showOteVisual and dealingRangeValid
    int dealingLeftBar = showDealingRangeVisual or showDealingOte ? eng2DealLeftBar : na
    if showDealingRangeVisual or not na(eng2RangeHighLine) or not na(eng2RangeLowLine) or not na(eng2RangeEqLine) or not na(eng2RangeQ25Line) or not na(eng2RangeQ75Line) or not na(eng2RangePremiumFill) or not na(eng2RangeDiscountFill)
        color rangeBoundaryColor = eng2DealBroken ? color.new(color.silver, 78) : color.new(color.silver, 35)
        color rangeQuarterColor = color.new(color.silver, eng2DealBroken ? 86 : 78)
        string rangeBoundaryStyle = eng2DealBroken ? line.style_dotted : line.style_solid
        eng2RangeHighLine := f_eng2_syncSegmentHLine(eng2RangeHighLine, dealingLeftBar, bar_index, dealingRangeHighLevel, rangeBoundaryColor, 1, rangeBoundaryStyle, showDealingRangeVisual)
        eng2RangeLowLine := f_eng2_syncSegmentHLine(eng2RangeLowLine, dealingLeftBar, bar_index, dealingRangeLowLevel, rangeBoundaryColor, 1, rangeBoundaryStyle, showDealingRangeVisual)
        eng2RangeEqLine := f_eng2_syncSegmentHLine(eng2RangeEqLine, dealingLeftBar, bar_index, dealingRangeEqLevel, eng2DealBroken ? color.new(color.silver, 78) : decisionEqColor, 2, eng2DealBroken ? line.style_dotted : line.style_dashed, showDealingRangeVisual)
        eng2RangeQ25Line := f_eng2_syncSegmentHLine(eng2RangeQ25Line, dealingLeftBar, bar_index, showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.25 : na, rangeQuarterColor, 1, line.style_dotted, showDealingRangeVisual)
        eng2RangeQ75Line := f_eng2_syncSegmentHLine(eng2RangeQ75Line, dealingLeftBar, bar_index, showDealingRangeVisual ? eng2DealLow + dealingRangeSize * 0.75 : na, rangeQuarterColor, 1, line.style_dotted, showDealingRangeVisual)
        eng2RangePremiumFill := f_eng2_syncLineFill(eng2RangePremiumFill, eng2RangeHighLine, eng2RangeEqLine, eng2DealBroken ? color.new(color.silver, 94) : decisionPremiumFillColor, showDealingRangeVisual)
        eng2RangeDiscountFill := f_eng2_syncLineFill(eng2RangeDiscountFill, eng2RangeEqLine, eng2RangeLowLine, eng2DealBroken ? color.new(color.silver, 94) : decisionDiscountFillColor, showDealingRangeVisual)

    if showDealingOte or not na(eng2OteLongTopLine) or not na(eng2OteLongBottomLine) or not na(eng2OteLongFill) or not na(eng2OteShortTopLine) or not na(eng2OteShortBottomLine) or not na(eng2OteShortFill)
        color oteBullLineColor = color.new(bullColor, eng2DealBroken ? 45 : 18)
        color oteBearLineColor = color.new(bearColor, eng2DealBroken ? 45 : 18)
        string oteBandStyle = eng2DealBroken ? line.style_dotted : line.style_solid
        eng2OteLongTopLine := f_eng2_syncSegmentHLine(eng2OteLongTopLine, dealingLeftBar, bar_index, oteLongTopLevel, oteBullLineColor, 2, oteBandStyle, showDealingOte)
        eng2OteLongBottomLine := f_eng2_syncSegmentHLine(eng2OteLongBottomLine, dealingLeftBar, bar_index, oteLongBottomLevel, oteBullLineColor, 2, oteBandStyle, showDealingOte)
        eng2OteLongFill := f_eng2_syncLineFill(eng2OteLongFill, eng2OteLongTopLine, eng2OteLongBottomLine, color.new(bullColor, eng2DealBroken ? 90 : 86), showDealingOte)
        eng2OteShortTopLine := f_eng2_syncSegmentHLine(eng2OteShortTopLine, dealingLeftBar, bar_index, oteShortTopLevel, oteBearLineColor, 2, oteBandStyle, showDealingOte)
        eng2OteShortBottomLine := f_eng2_syncSegmentHLine(eng2OteShortBottomLine, dealingLeftBar, bar_index, oteShortBottomLevel, oteBearLineColor, 2, oteBandStyle, showDealingOte)
        eng2OteShortFill := f_eng2_syncLineFill(eng2OteShortFill, eng2OteShortTopLine, eng2OteShortBottomLine, color.new(bearColor, eng2DealBroken ? 90 : 86), showDealingOte)

    if showLongRiskVisual or showShortRiskVisual or not na(eng2RiskLongEntryLine) or not na(eng2RiskShortEntryLine) or not na(eng2RiskLongStopLine) or not na(eng2RiskShortStopLine) or not na(eng2RiskLongTargetLine) or not na(eng2RiskShortTargetLine)
        eng2RiskLongEntryLine := f_e2_risk_if(eng2RiskLongEntryLine, tradeLongEntry, color.new(bullColor, 0), 2, showLongRiskVisual)
        eng2RiskShortEntryLine := f_e2_risk_if(eng2RiskShortEntryLine, tradeShortEntry, color.new(bearColor, 0), 2, showShortRiskVisual)
        eng2RiskLongStopLine := f_e2_risk_if(eng2RiskLongStopLine, riskBullStopLevel, color.new(bearColor, 0), 1, showLongRiskVisual)
        eng2RiskShortStopLine := f_e2_risk_if(eng2RiskShortStopLine, riskBearStopLevel, color.new(bullColor, 0), 1, showShortRiskVisual)
        eng2RiskLongTargetLine := f_e2_risk_if(eng2RiskLongTargetLine, activeLongTarget, color.new(liqHighColor, 0), 1, showLongRiskVisual)
        eng2RiskShortTargetLine := f_e2_risk_if(eng2RiskShortTargetLine, activeShortTarget, color.new(liqLowColor, 0), 1, showShortRiskVisual)

    // Right-edge labels
    float bslLbl = showDealingRangeVisual ? dealingRangeHighLevel : eqHighLevel
    float sslLbl = showDealingRangeVisual ? dealingRangeLowLevel : eqLowLevel
    bool rLbl = draw_show_right_labels
    bool bslLblOn = (rLbl and showDealingRangeVisual and not (f_levelsClose(bslLbl, pdhLevel, rightEdgeLabelTolerance) or f_levelsClose(bslLbl, pwhLevel, rightEdgeLabelTolerance) or f_levelsClose(bslLbl, pmhLevel, rightEdgeLabelTolerance))) or (showEqHighRightLabel and not showDealingRangeVisual)
    bool sslLblOn = (rLbl and showDealingRangeVisual and not (f_levelsClose(sslLbl, pdlLevel, rightEdgeLabelTolerance) or f_levelsClose(sslLbl, pwlLevel, rightEdgeLabelTolerance) or f_levelsClose(sslLbl, pmlLevel, rightEdgeLabelTolerance))) or (showEqLowRightLabel and not showDealingRangeVisual)
    eqHighLabel := f_e2_lbl_if(eqHighLabel, bslLbl, showDealingRangeVisual ? "ERL BSL" : eng1_exe_eqh_active ? "EQH" : "BSL", color.new(liqHighColor, 12), bslLblOn)
    eqLowLabel := f_e2_lbl_if(eqLowLabel, sslLbl, showDealingRangeVisual ? "ERL SSL" : eng1_exe_eql_active ? "EQL" : "SSL", color.new(liqLowColor, 12), sslLblOn)
    eng2DealEqLabel := f_e2_lbl_if(eng2DealEqLabel, dealingRangeEqLevel, "EQ", color.new(decisionEqColor, 0), rLbl and showDealingRangeVisual)
    pdhLabel := f_e2_lbl_if(pdhLabel, pdhLevel, "PDH", color.new(liqHighColor, 10), rLbl and showPdhVisual)
    pdlLabel := f_e2_lbl_if(pdlLabel, pdlLevel, "PDL", color.new(liqLowColor, 10), rLbl and showPdlVisual)
    pwhLabel := f_e2_lbl_if(pwhLabel, pwhLevel, "PWH", color.new(color.fuchsia, 15), rLbl and showPwhVisual)
    pwlLabel := f_e2_lbl_if(pwlLabel, pwlLevel, "PWL", color.new(color.fuchsia, 15), rLbl and showPwlVisual)
    pmhLabel := f_e2_lbl_if(pmhLabel, pmhLevel, "PMH", color.new(color.silver, 35), rLbl and showPmhVisual)
    pmlLabel := f_e2_lbl_if(pmlLabel, pmlLevel, "PML", color.new(color.silver, 35), rLbl and showPmlVisual)
    longStopLabel := f_e2_lbl_if(longStopLabel, riskBullStopLevel, "SL L", color.new(bearColor, 0), showLongStopRightLabel)
    shortStopLabel := f_e2_lbl_if(shortStopLabel, riskBearStopLevel, "SL S", color.new(bullColor, 0), showShortStopRightLabel)

// Bias tint should follow the MTF narrative chain: Narrative -> Context -> Execution.
int backdropBias = displayNarrBias != 0 ? displayNarrBias : (eng1CtxRangeReady and displayCtxBias != 0 ? displayCtxBias : displayExecBias)
// Keep bias tint subtle so it doesn't overpower zones/candles.
bgcolor(showTrendBackground and not compactMode ? color.new(backdropBias == 1 ? bullColor : backdropBias == -1 ? bearColor : neutralColor, backdropBias == 0 ? 95 : 92) : na)

f_eng4_render_dashboard() =>
    if lastBar and showDashboard
        bool cBoth = preferredDirection == "Balanced"
        bool cWait = preferredDirection == "Wait"
        bool sMode = strictModeEnabled
        bool longRetired = longCompleted or longInvalidated or (not longAmbiguous and longLifecycleRetired)
        bool shortRetired = shortCompleted or shortInvalidated or (not shortAmbiguous and shortLifecycleRetired)
        int nBias = displayNarrBias
        int cBias = displayCtxBias
        int eBias = displayExecBias
        bool waitBuy = cBias == -1 or (cBias == 0 and nBias == -1)
        string waitName = waitBuy ? (eng1_exe_eqh_active ? "EQH" : "BSL") : (eng1_exe_eql_active ? "EQL" : "SSL")
        float waitLvl = waitBuy ? eng1_exe_liq_high : eng1_exe_liq_low
        bool longPoiLive = poi_long_contract_valid and not longRetired
        bool shortPoiLive = poi_short_contract_valid and not shortRetired
        bool pLong = compactUseLong
        if cWait
            if longPoiLive and not shortPoiLive
                pLong := true
            else if shortPoiLive and not longPoiLive
                pLong := false
            else if longPoiLive and shortPoiLive
                pLong := compactUseLong
            else
                pLong := not waitBuy
        bool dLong = cWait ? pLong : compactUseLong
        string eState = dLong ? longExecutionState : shortExecutionState
        float eLvl = dLong ? tradeLongEntry : tradeShortEntry
        float tpLvl = dLong ? activeLongTarget : activeShortTarget
        color aCol = cBoth or cWait ? color.new(neutralColor, 12) : dLong ? color.new(bullColor, 12) : color.new(bearColor, 12)
        bool pValid = pLong ? poi_long_contract_valid : poi_short_contract_valid
        string pType = pLong ? poi_long_type : poi_short_type
        string pLife = pLong ? longPoiLifecycle : shortPoiLifecycle
        bool poiCtxOk = pLong ? eng1BullContextAllowed : eng1BearContextAllowed
        bool poiZoneOk = pLong ? (hasBullOb or hasBullFvg) : (hasBearOb or hasBearFvg)
        bool poiMapOk = pLong ? (eng3BullObTrackValid or eng3BullFvgTrackValid) : (eng3BearObTrackValid or eng3BearFvgTrackValid)
        bool poiLegOk = not sMode or (pLong ? (bullObStrictPdOwned or bullFvgStrictPdOwned) : (bearObStrictPdOwned or bearFvgStrictPdOwned))
        bool poiPickOk = pType != ""
        bool poiIdOk = pLong ? eng3LongActivePoiReady : eng3ShortActivePoiReady
        bool pStrictOk = pLong ? strictLongPdArrayOwned : strictShortPdArrayOwned
        bool poiUsed = pLong ? eng3LongActivePoiIdentity == eng3LongConsumedPoiIdentity : eng3ShortActivePoiIdentity == eng3ShortConsumedPoiIdentity
        string pSide = pLong ? "L " : "S "
        string pWhy = not poiCtxOk ? "No POI: Gate" : not poiZoneOk ? "No POI: Zone" : not poiMapOk ? "No POI: Map" : not poiLegOk ? "Need Leg" : not poiPickOk ? "No POI: Select" : not poiIdOk ? "No POI: Sync" : not pStrictOk ? "Need Leg" : poiUsed ? "No POI: Used" : "No POI"
        string pRetWhy = pLong ? longPoiRetireReason : shortPoiRetireReason
        bool pRetired = pLong ? longRetired : shortRetired
        bool pActive = pValid and not pRetired
        bool idleNoLivePoi = cWait and not longPoiLive and not shortPoiLive
        bool showRetiredPoi = pValid and pRetired and not idleNoLivePoi
        string idlePoiReason = pRetWhy != "" ? pRetWhy : not pValid and pWhy != "No POI" ? pWhy : ""
        string idlePoiText = pSide + "No live" + (idlePoiReason == "" ? "" : " | " + idlePoiReason)
        bool sweepOk = pLong ? dashLongTriggerSweepOk : dashShortTriggerSweepOk
        bool mssOk = pLong ? dashLongTriggerMssOk : dashShortTriggerMssOk
        bool dispOk = pLong ? dashLongTriggerDisplacementOk : dashShortTriggerDisplacementOk
        bool sBiasOk = pLong ? strictLongBiasPass : strictShortBiasPass
        bool sCtxOk = pLong ? strictLongContextTfPass : strictShortContextTfPass
        bool sPdOk = pLong ? strictLongPdPass : strictShortPdPass
        bool sOteOk = pLong ? strictLongOtePass : strictShortOtePass
        bool sDolOk = pLong ? strictLongDolPass : strictShortDolPass
        bool sKzOk = pLong ? strictLongKillzonePass : strictShortKillzonePass
        bool strictOk = sBiasOk and sCtxOk and sPdOk and sOteOk and sDolOk and sKzOk
        float dPx = not na(eng3SignalClose) ? eng3SignalClose : close
        string waitTxt = not na(waitLvl) and (waitBuy ? waitLvl > dPx : waitLvl < dPx) ? waitName + " " + f_formatLevel(waitLvl) : "New " + waitName
        bool bAlign = nBias != 0 and nBias == cBias and cBias == eBias
        bool bNarr = nBias != 0 and cBias != 0 and eBias != 0 and cBias == eBias and nBias != eBias
        bool bMixed = (nBias != 0 and cBias != 0 and nBias != cBias) or (nBias != 0 and eBias != 0 and nBias != eBias) or (cBias != 0 and eBias != 0 and cBias != eBias)
        string sGate = not sBiasOk ? "Need Bias" : not sCtxOk ? "Need Ctx" : not sPdOk ? "Need PD" : not sOteOk ? "Need OTE" : not sDolOk ? "Need DOL" : not sKzOk ? "Need KZ" : "Strict OK"
        string stepTxt = not sweepOk ? "Need Sweep" : not mssOk ? "Need MSS" : not dispOk ? "Need Disp" : sGate
        bool waitLeg = not pRetired and not pValid and poiZoneOk and poiMapOk and (not poiLegOk or not pStrictOk)
        string nextText = waitLeg ? "Need Leg" : cWait ? "Watch " + waitTxt : eState == "Active" ? "Trigger" : eState == "Armed" ? "Retest" : eState == "Confirming" ? (sMode ? stepTxt : "Confirm") : eState == "Managed" ? "Manage" : eState == "Ambiguous" ? "Review" : eState == "Completed" ? "Next" : eState == "Expired" or eState == "Invalidated" ? "Wait" : sMode and pValid and not pRetired ? stepTxt : "Wait"
        string pxText = syminfo.ticker + " " + timeframe.period + " | Px " + f_formatLevel(dPx)
        string sideFull = dLong ? "Long " : "Short "
        string sideMini = dLong ? "L " : "S "
        string setupTxt = cWait ? "Idle " + waitTxt : cBoth ? "Both POI L " + f_formatLevel(tradeLongEntry) + " / S " + f_formatLevel(tradeShortEntry) : sideFull + eState + " " + f_formatLevel(eLvl)
        string setupMini = cWait ? waitTxt : cBoth ? "Both POI" : sideMini + eState
        bool planOk = (dLong ? not longRetired : not shortRetired) and not na(eLvl)
        bool ordOk = not sMode or (sweepOk and mssOk and dispOk and strictOk)
        bool ordGate = sMode and planOk and not ordOk
        setupTxt := ordGate ? (cBoth ? "Focus " + sideFull : sideFull) + "Gate " + stepTxt + " " + f_formatLevel(eLvl) : setupTxt
        setupMini := ordGate ? sideMini + "Gate " + stepTxt : setupMini
        bool riskOk = planOk and f_executionRiskVisible(eState) and ordOk
        string ordText = waitLeg ? "Need Leg" : not planOk ? "No order" : (ordGate ? "Gate " + stepTxt + " | Plan E " : riskOk ? "E " : "Plan E ") + f_formatLevel(eLvl) + " | SL " + f_formatLevel(dLong ? tradeLongStop : tradeShortStop) + " | TP " + f_formatLevel(tpLvl)
        ordText := cBoth ? "Focus " + sideFull + "| " + ordText : ordText
        bool pGate = sMode and pActive and not (sweepOk and mssOk and dispOk and strictOk)
        string pText = idleNoLivePoi ? idlePoiText : not pValid ? pSide + pWhy : showRetiredPoi ? pSide + (pRetWhy == "" ? "Retired" : "Retired: " + pRetWhy) : pSide + (pType == "Breaker" ? "BRK" : pType == "OB" ? "bOB" : pType) + " " + f_formatLevel(pLong ? poi_long_entry : poi_short_entry) + " | " + (pType == "FVG" and pLife == "Mitigated" ? "CE Hit" : pLife)
        pText := pGate ? pText + " | " + stepTxt : pText
        bool triggerReady = pActive and sweepOk and mssOk and dispOk and (not sMode or strictOk)
        color dNeu = color.new(neutralColor, 18)
        color dBias = bAlign ? aCol : dNeu
        color dSetup = cWait ? dNeu : ordGate ? panelCellBg : aCol
        color dPoi = pActive and not pGate ? aCol : panelCellBg
        color dOrder = riskOk ? aCol : panelCellBg
        color dNext = waitLeg ? panelCellBg : cWait ? dNeu : sMode ? (triggerReady ? aCol : panelCellBg) : aCol
        if compactDashboardMode
            f_prepareDashboardTable(dashboardCompact, 6, dashboard, 10)
            f_setCell(dashboardCompact, 0, 1, "TRADE", color.white, panelHeaderBg)
            f_setCell(dashboardCompact, 1, 1, pxText, color.white, aCol)
            f_setCell(dashboardCompact, 0, 2, "Setup", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 2, setupMini, color.white, dSetup)
            f_setCell(dashboardCompact, 0, 3, "Bias", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 3, bAlign ? "Al " + (eBias == 1 ? "Bu" : "Be") : bNarr ? "Nar!" : bMixed ? "Mix" : "Bld", color.white, dBias)
            f_setCell(dashboardCompact, 0, 4, "POI", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 4, pText, color.white, dPoi)
            f_setCell(dashboardCompact, 0, 5, "Order", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 5, waitLeg ? "Need Leg" : not planOk ? "No order" : ordGate ? "Gate " + stepTxt : riskOk ? "Ready" : "Plan", color.white, dOrder)
            f_setCell(dashboardCompact, 0, 6, "Next", color.white, panelCellBg)
            f_setCell(dashboardCompact, 1, 6, nextText, color.white, dNext)
        else
            f_prepareDashboardTable(dashboard, 10, dashboardCompact, 6)
            f_setCell(dashboard, 0, 1, "TRADE MAP", color.white, panelHeaderBg)
            f_setCell(dashboard, 1, 1, pxText, color.white, aCol)
            f_setCell(dashboard, 0, 2, "Setup", color.white, panelCellBg)
            f_setCell(dashboard, 1, 2, setupTxt, color.white, dSetup)
            f_setCell(dashboard, 0, 3, "Bias", color.white, panelCellBg)
            f_setCell(dashboard, 1, 3, (bAlign ? "Aligned " + (eBias == 1 ? "Bullish" : "Bearish") : bNarr ? "Narr Conflict" : bMixed ? "Mixed" : "Building") + " | TF " + eng1_exec_tf + ">" + eng1_ctx_tf + "/" + eng1_narr_tf, color.white, dBias)
            f_setCell(dashboard, 0, 4, "Liquidity", color.white, panelCellBg)
            f_setCell(dashboard, 1, 4, ((dLong ? longUsesExternalDolTarget : shortUsesExternalDolTarget) and not na(tpLvl) ? "DOL " + f_formatLevel(tpLvl) + " | " : "") + (eng1_exe_eqh_active ? "EQH " : "BSL ") + f_formatLevel(eng1_exe_liq_high) + " | " + (eng1_exe_eql_active ? "EQL " : "SSL ") + f_formatLevel(eng1_exe_liq_low), color.white, panelCellBg)
            f_setCell(dashboard, 0, 5, "POI", color.white, panelCellBg)
            f_setCell(dashboard, 1, 5, pText, color.white, dPoi)
            f_setCell(dashboard, 0, 6, "Order", color.white, panelCellBg)
            f_setCell(dashboard, 1, 6, ordText, color.white, dOrder)
            f_setCell(dashboard, 0, 7, "Trigger", color.white, panelCellBg)
            f_setCell(dashboard, 1, 7, idleNoLivePoi ? pSide + "Wait POI" : not pValid ? pSide + pWhy : showRetiredPoi ? pSide + (pRetWhy == "" ? "Retired" : pRetWhy) : pSide + (sMode ? stepTxt : not sweepOk ? "Need Sweep" : not mssOk ? "Need MSS" : not dispOk ? "Need Disp" : "Ready"), color.white, triggerReady ? aCol : panelCellBg)
            f_setCell(dashboard, 0, 8, "Timing", color.white, panelCellBg)
            f_setCell(dashboard, 1, 8, liquiditySessionSummary + " | " + timezoneSummary + " | " + (not na(sessRefAtr) and sessRefCode != "" ? "ATR " + sessRefCode + " " + f_formatLevel(sessRefAtr) : "ATR -") + " | " + (sMode ? (sKzOk ? "Strict " + ipdaWindowSummary : "Need KZ") : "Normal"), color.white, sMode ? (sKzOk ? color.new(color.teal, 15) : panelCellBg) : color.new(neutralColor, 15))
            f_setCell(dashboard, 0, 9, "Next", color.white, panelCellBg)
            f_setCell(dashboard, 1, 9, nextText, color.white, dNext)
    else if lastBar and not showDashboard
        f_clearDashboardTable(dashboardCompact, 6)
        f_clearDashboardTable(dashboard, 10)
    true

//------------------------------------------------------------------------------
// ENGINE 4 (DASHBOARD SNAPSHOT)
// MAIN_CONTRACT order 9: render dashboard from snapshots only.
// Keep table rendering dumb: rows read these snapshots instead of rebuilding
// engine logic inline. This follows MAIN_CONTRACT and makes future pruning safer.
//------------------------------------------------------------------------------
f_eng4_render_dashboard()
