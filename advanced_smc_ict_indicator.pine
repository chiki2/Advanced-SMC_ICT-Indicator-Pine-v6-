[eng1_ctx_trend_bias_tmp, eng1_ctx_bull_breakout_tmp, eng1_ctx_bear_breakout_tmp, eng1_ctx_bull_reversal_tmp, eng1_ctx_bear_reversal_tmp, eng1_ctx_bull_ob_top_tmp, eng1_ctx_bull_ob_bottom_tmp, eng1_ctx_bull_ob_entry_tmp, eng1_ctx_bull_ob_bar_tmp, eng1_ctx_bull_fvg_top_tmp, eng1_ctx_bull_fvg_bottom_tmp, eng1_ctx_bull_fvg_bar_tmp, eng1_ctx_bear_ob_top_tmp, eng1_ctx_bear_ob_bottom_tmp, eng1_ctx_bear_ob_entry_tmp, eng1_ctx_bear_ob_bar_tmp, eng1_ctx_bear_fvg_top_tmp, eng1_ctx_bear_fvg_bottom_tmp, eng1_ctx_bear_fvg_bar_tmp, eng1_ctx_liq_high_tmp, eng1_ctx_liq_low_tmp] = f_eng1_select_context_snapshot(eng1_ctx_tf)
[eng1_exe_bull_sweep_tmp, eng1_exe_bear_sweep_tmp, eng1_exe_bull_mss_tmp, eng1_exe_bear_mss_tmp, eng1_exe_bull_displacement_tmp, eng1_exe_bear_displacement_tmp, eng1_exe_protected_high_tmp, eng1_exe_protected_low_tmp] = f_eng1_select_execution_snapshot(eng1_exec_tf)
[eng1_exe_liq_high_tmp, eng1_exe_liq_low_tmp] = f_eng1_select_execution_levels(eng1_exec_tf)
[eng1_exe_eqh_tmp, eng1_exe_eql_tmp, eng1_exe_eqh_active_tmp, eng1_exe_eql_active_tmp] = f_eng1_select_execution_liquidity(eng1_exec_tf)

if eng1_exec_valid
    eng1_narr_bias := eng1_narr_bias_tmp
    eng1_narr_liq_high := eng1_narr_liq_high_tmp
    eng1_narr_liq_low := eng1_narr_liq_low_tmp
    eng1_narr_bull_sd_top := eng1_narr_bull_sd_top_tmp
    eng1_narr_bull_sd_bottom := eng1_narr_bull_sd_bottom_tmp
    eng1_narr_bear_sd_top := eng1_narr_bear_sd_top_tmp
    eng1_narr_bear_sd_bottom := eng1_narr_bear_sd_bottom_tmp
    eng1_narr_strength := eng1_narr_strength_tmp
    eng1_ctx_trend_bias := eng1_ctx_trend_bias_tmp
    eng1_ctx_bull_breakout := eng1_ctx_bull_breakout_tmp
    eng1_ctx_bear_breakout := eng1_ctx_bear_breakout_tmp
    eng1_ctx_bull_reversal := eng1_ctx_bull_reversal_tmp
    eng1_ctx_bear_reversal := eng1_ctx_bear_reversal_tmp
    eng1_ctx_bull_ob_top := eng1_ctx_bull_ob_top_tmp
    eng1_ctx_bull_ob_bottom := eng1_ctx_bull_ob_bottom_tmp
    eng1_ctx_bull_ob_entry := eng1_ctx_bull_ob_entry_tmp
    eng1_ctx_bull_ob_bar := eng1_ctx_bull_ob_bar_tmp
    eng1_ctx_bull_fvg_top := eng1_ctx_bull_fvg_top_tmp
    eng1_ctx_bull_fvg_bottom := eng1_ctx_bull_fvg_bottom_tmp
    eng1_ctx_bull_fvg_bar := eng1_ctx_bull_fvg_bar_tmp
    eng1_ctx_bear_ob_top := eng1_ctx_bear_ob_top_tmp
    eng1_ctx_bear_ob_bottom := eng1_ctx_bear_ob_bottom_tmp
    eng1_ctx_bear_ob_entry := eng1_ctx_bear_ob_entry_tmp
    eng1_ctx_bear_ob_bar := eng1_ctx_bear_ob_bar_tmp
    eng1_ctx_bear_fvg_top := eng1_ctx_bear_fvg_top_tmp
    eng1_ctx_bear_fvg_bottom := eng1_ctx_bear_fvg_bottom_tmp
    eng1_ctx_bear_fvg_bar := eng1_ctx_bear_fvg_bar_tmp
    eng1_ctx_liq_high := eng1_ctx_liq_high_tmp
    eng1_ctx_liq_low := eng1_ctx_liq_low_tmp
    eng1_exe_bull_sweep := eng1_exe_bull_sweep_tmp
    eng1_exe_bear_sweep := eng1_exe_bear_sweep_tmp
    eng1_exe_bull_mss := eng1_exe_bull_mss_tmp
    eng1_exe_bear_mss := eng1_exe_bear_mss_tmp
    eng1_exe_bull_displacement := eng1_exe_bull_displacement_tmp
    eng1_exe_bear_displacement := eng1_exe_bear_displacement_tmp
    eng1_exe_protected_high := eng1_exe_protected_high_tmp
    eng1_exe_protected_low := eng1_exe_protected_low_tmp
    eng1_exe_liq_high := eng1_exe_liq_high_tmp
    eng1_exe_liq_low := eng1_exe_liq_low_tmp
    eng1_exe_eqh := eng1_exe_eqh_tmp
    eng1_exe_eql := eng1_exe_eql_tmp
    eng1_exe_eqh_active := eng1_exe_eqh_active_tmp
    eng1_exe_eql_active := eng1_exe_eql_active_tmp

chartTfLabel = timeframe.main_period
chartTfSeconds = timeframe.in_seconds()
normalizationBaselineTfSeconds = timeframe.in_seconds("5")
freshBarsEffective = f_timeNormalizedBars(setupFreshBars, normalizationBaselineTfSeconds, chartTfSeconds, 2)
expiryBarsEffective = f_timeNormalizedBars(setupExpiryBars, normalizationBaselineTfSeconds, chartTfSeconds, 4)
strictMssLookbackEffective = f_timeNormalizedBars(strictMssLookback, normalizationBaselineTfSeconds, chartTfSeconds, 2)
contextHtfTf = f_ictContextHtf(chartTfSeconds)
narrativeHtfTf = f_ictNarrativeHtf(chartTfSeconds)
executionTfValid = contextHtfTf != "" and narrativeHtfTf != ""
effectiveHtfTf = executionTfValid ? contextHtfTf : timeframe.main_period
narrativeRequestTf = executionTfValid ? narrativeHtfTf : timeframe.main_period
effectiveHtfSeconds = executionTfValid ? timeframe.in_seconds(effectiveHtfTf) : na
narrativeHtfSeconds = executionTfValid ? timeframe.in_seconds(narrativeHtfTf) : na
htfContextReady = executionTfValid and not na(effectiveHtfSeconds) and effectiveHtfSeconds > chartTfSeconds
narrativeHtfReady = executionTfValid and not na(narrativeHtfSeconds) and narrativeHtfSeconds > effectiveHtfSeconds
tfPairInvalid = not executionTfValid

if tfPairInvalid
    runtime.error("Invalid ICT execution timeframe: " + chartTfLabel + ". Use M1, M5, M15, or M30.")

f_syncEng1ContextVisual(box currentBox, line currentLine, label currentLabel, bool enabled, int createdBar, float zoneTop, float zoneBottom, float zoneEntry, string labelText, color borderColor, color fillColor, bool showEntryLine, bool useObStyle, string executionState) =>
    box nextBox = currentBox
    line nextLine = currentLine
    label nextLabel = currentLabel
    if enabled and not na(zoneTop) and not na(zoneBottom)
        int leftBar = f_safeBarIndexX(not na(createdBar) ? createdBar : bar_index)
        if na(nextBox)
            nextBox := box.new(left=leftBar, top=zoneTop, right=bar_index, bottom=zoneBottom, xloc=xloc.bar_index, extend=extend.right, bgcolor=fillColor, border_color=borderColor)
        else
            box.set_left(nextBox, leftBar)
            box.set_right(nextBox, bar_index)
            box.set_top(nextBox, zoneTop)
            box.set_bottom(nextBox, zoneBottom)
            box.set_bgcolor(nextBox, fillColor)
            box.set_border_color(nextBox, borderColor)
        if showEntryLine and not na(zoneEntry)
            if na(nextLine)
                nextLine := line.new(x1=leftBar, y1=zoneEntry, x2=bar_index, y2=zoneEntry, xloc=xloc.bar_index, extend=extend.right, color=borderColor, width=f_executionSelectedLineWidth(executionState), style=line.style_dotted)
            else
                line.set_x1(nextLine, leftBar)
                line.set_x2(nextLine, bar_index)
                line.set_y1(nextLine, zoneEntry)
                line.set_y2(nextLine, zoneEntry)
                line.set_color(nextLine, borderColor)
                line.set_width(nextLine, f_executionSelectedLineWidth(executionState))
                line.set_style(nextLine, line.style_dotted)
        else if not na(nextLine)
            line.delete(nextLine)
            nextLine := na
        if na(nextLabel)
            nextLabel := label.new(x=bar_index, y=f_zoneMid(zoneTop, zoneBottom), xloc=xloc.bar_index, text=labelText, style=useObStyle ? f_obLabelStyle() : f_fvgLabelStyle(), color=color.new(borderColor, 0), textcolor=color.white, size=size.tiny)
        else
            label.set_x(nextLabel, bar_index)
            label.set_y(nextLabel, f_zoneMid(zoneTop, zoneBottom))
            label.set_text(nextLabel, labelText)
            label.set_style(nextLabel, useObStyle ? f_obLabelStyle() : f_fvgLabelStyle())
            label.set_color(nextLabel, color.new(borderColor, 0))
            label.set_textcolor(nextLabel, color.white)
    else
        if not na(nextBox)
            box.delete(nextBox)
            nextBox := na
        if not na(nextLine)
            line.delete(nextLine)
            nextLine := na
        if not na(nextLabel)
            label.delete(nextLabel)
            nextLabel := na
    [nextBox, nextLine, nextLabel]

//------------------------------------------------------------------------------
// Session liquidity tracking
//------------------------------------------------------------------------------
inAsiaSession = f_inSessionWindow(asiaSessionWindow)
newAsiaSession = inAsiaSession and not inAsiaSession[1]
asiaSessionEnded = not inAsiaSession and inAsiaSession[1]
inLondonSession = f_inSessionWindow(londonSessionWindow)
newLondonSession = inLondonSession and not inLondonSession[1]
londonSessionEnded = not inLondonSession and inLondonSession[1]
inNyAmSession = f_inSessionWindow(nyAmSessionWindow)
newNyAmSession = inNyAmSession and not inNyAmSession[1]
nyAmSessionEnded = not inNyAmSession and inNyAmSession[1]
inNyPmSession = f_inSessionWindow(nyPmSessionWindow)
newNyPmSession = inNyPmSession and not inNyPmSession[1]
nyPmSessionEnded = not inNyPmSession and inNyPmSession[1]
inNewYorkSessionVisual = inNyAmSession or inNyPmSession
newNewYorkSessionVisual = inNewYorkSessionVisual and not inNewYorkSessionVisual[1]
newYorkSessionVisualEnded = not inNewYorkSessionVisual and inNewYorkSessionVisual[1]

var float asiaSessionHigh = na
var float asiaSessionLow = na
var float londonSessionHigh = na
var float londonSessionLow = na
var float nyAmSessionHigh = na
var float nyAmSessionLow = na
var float nyPmSessionHigh = na
var float nyPmSessionLow = na
var float lastAsiaHigh = na
var float lastAsiaLow = na
var float lastLondonHigh = na
var float lastLondonLow = na
var float lastNyAmHigh = na
var float lastNyAmLow = na
var float lastNyPmHigh = na
var float lastNyPmLow = na
var float newYorkSessionVisualHigh = na
var float newYorkSessionVisualLow = na

[asiaSessionHighNext, asiaSessionLowNext, lastAsiaHighNext, lastAsiaLowNext] = f_updateSessionRange(inAsiaSession, newAsiaSession, asiaSessionEnded, asiaSessionHigh, asiaSessionLow, lastAsiaHigh, lastAsiaLow)
[londonSessionHighNext, londonSessionLowNext, lastLondonHighNext, lastLondonLowNext] = f_updateSessionRange(inLondonSession, newLondonSession, londonSessionEnded, londonSessionHigh, londonSessionLow, lastLondonHigh, lastLondonLow)
[nyAmSessionHighNext, nyAmSessionLowNext, lastNyAmHighNext, lastNyAmLowNext] = f_updateSessionRange(inNyAmSession, newNyAmSession, nyAmSessionEnded, nyAmSessionHigh, nyAmSessionLow, lastNyAmHigh, lastNyAmLow)
[nyPmSessionHighNext, nyPmSessionLowNext, lastNyPmHighNext, lastNyPmLowNext] = f_updateSessionRange(inNyPmSession, newNyPmSession, nyPmSessionEnded, nyPmSessionHigh, nyPmSessionLow, lastNyPmHigh, lastNyPmLow)
asiaSessionHigh := asiaSessionHighNext
asiaSessionLow := asiaSessionLowNext
lastAsiaHigh := lastAsiaHighNext
lastAsiaLow := lastAsiaLowNext
londonSessionHigh := londonSessionHighNext
londonSessionLow := londonSessionLowNext
lastLondonHigh := lastLondonHighNext
lastLondonLow := lastLondonLowNext
nyAmSessionHigh := nyAmSessionHighNext
nyAmSessionLow := nyAmSessionLowNext
lastNyAmHigh := lastNyAmHighNext
lastNyAmLow := lastNyAmLowNext
nyPmSessionHigh := nyPmSessionHighNext
nyPmSessionLow := nyPmSessionLowNext
lastNyPmHigh := lastNyPmHighNext
lastNyPmLow := lastNyPmLowNext

if newNewYorkSessionVisual
    newYorkSessionVisualHigh := high
    newYorkSessionVisualLow := low
else if inNewYorkSessionVisual
    newYorkSessionVisualHigh := na(newYorkSessionVisualHigh) ? high : math.max(newYorkSessionVisualHigh, high)
    newYorkSessionVisualLow := na(newYorkSessionVisualLow) ? low : math.min(newYorkSessionVisualLow, low)

string currentSessionBlock = inAsiaSession ? "Asia" : inLondonSession ? "London" : inNyAmSession ? "New York AM" : inNyPmSession ? "New York PM" : "Inter-session"
string liquiditySessionLabel = inLondonSession ? "Asia" : inNyAmSession ? "London" : inNyPmSession ? "New York AM" : "New York Composite"

//------------------------------------------------------------------------------
// Session range visuals
//------------------------------------------------------------------------------
bool sessionVisualsEnabled = showSessionVisuals and not compactMode and effectiveZoneDisplayMode == "Full" and timeframe.isintraday

if not sessionVisualsEnabled and array.size(sessionRangeBoxes) > 0
    f_clearSessionVisuals()
    activeAsiaSessionBox := na
    activeAsiaSessionLabel := na
    activeAsiaSessionHighLine := na
    activeAsiaSessionLowLine := na
    activeLondonSessionBox := na
    activeLondonSessionLabel := na
    activeLondonSessionHighLine := na
    activeLondonSessionLowLine := na
    activeNewYorkSessionBox := na
    activeNewYorkSessionLabel := na
    activeNewYorkSessionHighLine := na
    activeNewYorkSessionLowLine := na

if newAsiaSession
    activeAsiaSessionStartBar := bar_index
if sessionVisualsEnabled and inAsiaSession and na(activeAsiaSessionBox)
    activeAsiaSessionStartBar := na(activeAsiaSessionStartBar) ? bar_index : activeAsiaSessionStartBar
    [newAsiaSessionBox, newAsiaSessionLabel, newAsiaSessionHighLine, newAsiaSessionLowLine] = f_addSessionVisual("Asia", activeAsiaSessionStartBar, asiaSessionHigh, asiaSessionLow)
    activeAsiaSessionBox := newAsiaSessionBox
    activeAsiaSessionLabel := newAsiaSessionLabel
    activeAsiaSessionHighLine := newAsiaSessionHighLine
    activeAsiaSessionLowLine := newAsiaSessionLowLine

if inAsiaSession
    if sessionVisualsEnabled
        f_syncSessionVisual(activeAsiaSessionBox, activeAsiaSessionLabel, activeAsiaSessionHighLine, activeAsiaSessionLowLine, activeAsiaSessionStartBar, asiaSessionHigh, asiaSessionLow, "Asia")
else if asiaSessionEnded
    activeAsiaSessionBox := na
    activeAsiaSessionLabel := na
    activeAsiaSessionHighLine := na
    activeAsiaSessionLowLine := na
    activeAsiaSessionStartBar := na

if newLondonSession
    activeLondonSessionStartBar := bar_index
if sessionVisualsEnabled and inLondonSession and na(activeLondonSessionBox)
    activeLondonSessionStartBar := na(activeLondonSessionStartBar) ? bar_index : activeLondonSessionStartBar
    [newLondonSessionBox, newLondonSessionLabel, newLondonSessionHighLine, newLondonSessionLowLine] = f_addSessionVisual("London", activeLondonSessionStartBar, londonSessionHigh, londonSessionLow)
    activeLondonSessionBox := newLondonSessionBox
    activeLondonSessionLabel := newLondonSessionLabel
    activeLondonSessionHighLine := newLondonSessionHighLine
    activeLondonSessionLowLine := newLondonSessionLowLine

if inLondonSession
    if sessionVisualsEnabled
        f_syncSessionVisual(activeLondonSessionBox, activeLondonSessionLabel, activeLondonSessionHighLine, activeLondonSessionLowLine, activeLondonSessionStartBar, londonSessionHigh, londonSessionLow, "London")
else if londonSessionEnded
    activeLondonSessionBox := na
    activeLondonSessionLabel := na
    activeLondonSessionHighLine := na
    activeLondonSessionLowLine := na
    activeLondonSessionStartBar := na

if newNewYorkSessionVisual
    activeNewYorkSessionStartBar := bar_index
if sessionVisualsEnabled and inNewYorkSessionVisual and na(activeNewYorkSessionBox)
    activeNewYorkSessionStartBar := na(activeNewYorkSessionStartBar) ? bar_index : activeNewYorkSessionStartBar
    [newNewYorkSessionBox, newNewYorkSessionLabel, newNewYorkSessionHighLine, newNewYorkSessionLowLine] = f_addSessionVisual("New York", activeNewYorkSessionStartBar, newYorkSessionVisualHigh, newYorkSessionVisualLow)
    activeNewYorkSessionBox := newNewYorkSessionBox
    activeNewYorkSessionLabel := newNewYorkSessionLabel
    activeNewYorkSessionHighLine := newNewYorkSessionHighLine
    activeNewYorkSessionLowLine := newNewYorkSessionLowLine

if inNewYorkSessionVisual
    if sessionVisualsEnabled
        f_syncSessionVisual(activeNewYorkSessionBox, activeNewYorkSessionLabel, activeNewYorkSessionHighLine, activeNewYorkSessionLowLine, activeNewYorkSessionStartBar, newYorkSessionVisualHigh, newYorkSessionVisualLow, "New York")
else if newYorkSessionVisualEnded
    activeNewYorkSessionBox := na
    activeNewYorkSessionLabel := na
    activeNewYorkSessionHighLine := na
    activeNewYorkSessionLowLine := na
    activeNewYorkSessionStartBar := na

if sessionVisualsEnabled and array.size(sessionRangeBoxes) > 0
    for i = 0 to array.size(sessionRangeBoxes) - 1
        sessionBox = array.get(sessionRangeBoxes, i)
        sessionLabel = array.get(sessionRangeLabels, i)
        sessionName = array.get(sessionRangeNames, i)
        sessionHighLine = array.get(sessionRangeHighLines, i)
        sessionLowLine = array.get(sessionRangeLowLines, i)
        fillColor = f_sessionFillColor(sessionName)
        borderColor = f_sessionBorderColor(sessionName)
        textColor = f_sessionTextColor(sessionName)
        highLineColor = f_sessionLineColor(sessionName, true)
        lowLineColor = f_sessionLineColor(sessionName, false)
        if not na(sessionBox)
            box.set_bgcolor(sessionBox, fillColor)
            box.set_border_color(sessionBox, borderColor)
        if not na(sessionHighLine)
            line.set_x2(sessionHighLine, bar_index)
            line.set_color(sessionHighLine, highLineColor)
        if not na(sessionLowLine)
            line.set_x2(sessionLowLine, bar_index)
            line.set_color(sessionLowLine, lowLineColor)
        if not na(sessionLabel)
            label.set_text(sessionLabel, sessionName)
            label.set_textcolor(sessionLabel, textColor)
            label.set_color(sessionLabel, color.new(color.black, 100))
            label.set_size(sessionLabel, size.normal)

//------------------------------------------------------------------------------
// Execution liquidity (Engine 1 owned)
//------------------------------------------------------------------------------
float effectiveExecLiqHigh = eng1_exe_liq_high
float effectiveExecLiqLow = eng1_exe_liq_low
float effectiveExecEqHigh = eng1_exe_eqh_active ? eng1_exe_eqh : na
float effectiveExecEqLow = eng1_exe_eql_active ? eng1_exe_eql : na

plotshape(displaySweepMarkers and eng1_exe_bull_sweep, title="Sell-side liquidity sweep", style=shape.triangleup, location=location.belowbar, color=bullColor, size=size.tiny, text="")
plotshape(displaySweepMarkers and eng1_exe_bear_sweep, title="Buy-side liquidity sweep", style=shape.triangledown, location=location.abovebar, color=bearColor, size=size.tiny, text="")
//------------------------------------------------------------------------------
// Higher timeframe structure context
//------------------------------------------------------------------------------
[htfPivotHigh, htfPivotLow, htfClose] = request.security(syminfo.tickerid, effectiveHtfTf, [ta.pivothigh(high, htfSwingLen, htfSwingLen), ta.pivotlow(low, htfSwingLen, htfSwingLen), close], lookahead=barmerge.lookahead_off)
[narrativeClose, narrativeMomentumRef, narrativeAtr] = request.security(syminfo.tickerid, narrativeRequestTf, [close, close[regimeMomentumLookbackBars], ta.atr(14)], lookahead=barmerge.lookahead_off)

var float htfStructureHigh = na
var float htfStructureLow = na
var int htfBias = 0

if not eng1_exec_valid and htfContextReady
    if not na(htfPivotHigh)
        htfStructureHigh := htfPivotHigh
    if not na(htfPivotLow)
        htfStructureLow := htfPivotLow
    if not na(htfStructureHigh) and htfClose > htfStructureHigh
        htfBias := 1
    else if not na(htfStructureLow) and htfClose < htfStructureLow
        htfBias := -1
else
    htfStructureHigh := na
    htfStructureLow := na
    htfBias := 0

int displayExecBias = eng1_ctx_trend_bias
int displayCtxBias = eng1_ctx_trend_bias
int displayNarrBias = eng1_narr_bias

bool eng1CtxRangeReady = eng1_exec_valid and not na(eng1_ctx_liq_high) and not na(eng1_ctx_liq_low) and eng1_ctx_liq_high > eng1_ctx_liq_low
float eng1CtxRangeHigh = eng1CtxRangeReady ? eng1_ctx_liq_high : na
float eng1CtxRangeLow = eng1CtxRangeReady ? eng1_ctx_liq_low : na
float eng1CtxRangeSize = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeLow : na
float eng1CtxEquilibrium = eng1CtxRangeReady ? (eng1CtxRangeHigh + eng1CtxRangeLow) * 0.5 : na
float eng1CtxOteLongTop = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeSize * 0.62 : na
float eng1CtxOteLongBottom = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeSize * 0.79 : na
float eng1CtxOteShortTop = eng1CtxRangeReady ? eng1CtxRangeLow + eng1CtxRangeSize * 0.79 : na
float eng1CtxOteShortBottom = eng1CtxRangeReady ? eng1CtxRangeLow + eng1CtxRangeSize * 0.62 : na

strictKillzoneActive = timeframe.isintraday and not na(time(timeframe.period, strictKillzoneSession, ictSessionTimezone))
liquiditySessionSummary = "A-ICT " + f_sessionCode(currentSessionBlock) + ">" + f_sessionCode(liquiditySessionLabel)
timezoneSummary = "NY TZ"
mtfSummary = "TF " + chartTfLabel + "/" + effectiveHtfTf + "/" + narrativeHtfTf
float effectiveProtectedHigh = eng1_exe_protected_high
float effectiveProtectedLow = eng1_exe_protected_low
float effectiveContextHigh = eng1CtxRangeReady ? eng1CtxRangeHigh : htfStructureHigh
float effectiveContextLow = eng1CtxRangeReady ? eng1CtxRangeLow : htfStructureLow
float effectiveBullEquilibrium = eng1CtxRangeReady ? eng1CtxEquilibrium : na
float effectiveBearEquilibrium = eng1CtxRangeReady ? eng1CtxEquilibrium : na
float effectiveRangeHigh = eng1CtxRangeReady ? eng1CtxRangeHigh : na
float effectiveRangeLow = eng1CtxRangeReady ? eng1CtxRangeLow : na
float effectiveRangeEquilibrium = eng1CtxRangeReady ? eng1CtxEquilibrium : na
float effectiveOteLongTop = eng1CtxRangeReady and eng1_narr_bias != -1 and (eng1_ctx_trend_bias == 1 or eng1_ctx_bull_breakout or eng1_ctx_bull_reversal) ? eng1CtxOteLongTop : na
float effectiveOteLongBottom = eng1CtxRangeReady and eng1_narr_bias != -1 and (eng1_ctx_trend_bias == 1 or eng1_ctx_bull_breakout or eng1_ctx_bull_reversal) ? eng1CtxOteLongBottom : na
float effectiveOteShortTop = eng1CtxRangeReady and eng1_narr_bias != 1 and (eng1_ctx_trend_bias == -1 or eng1_ctx_bear_breakout or eng1_ctx_bear_reversal) ? eng1CtxOteShortTop : na
float effectiveOteShortBottom = eng1CtxRangeReady and eng1_narr_bias != 1 and (eng1_ctx_trend_bias == -1 or eng1_ctx_bear_breakout or eng1_ctx_bear_reversal) ? eng1CtxOteShortBottom : na
bool effectiveLongOteReady = not na(effectiveOteLongTop) and not na(effectiveOteLongBottom)
bool effectiveShortOteReady = not na(effectiveOteShortTop) and not na(effectiveOteShortBottom)

//------------------------------------------------------------------------------
// Risk cues from latest live zone or structure
//------------------------------------------------------------------------------
float latestBullFvgTop = na
float latestBullFvgBottom = na
float latestBearFvgTop = na
float latestBearFvgBottom = na
int latestBullFvgCreatedBar = na
int latestBearFvgCreatedBar = na
bool latestBullFvgTouched = false
bool latestBearFvgTouched = false
bool latestBullFvgFromEng1 = false
bool latestBearFvgFromEng1 = false

int eng1ContextTouchScan = math.max(expiryBarsEffective, freshBarsEffective) + strictMssLookbackEffective + 10
bool eng1BullContextAllowed = eng1_exec_valid and eng1_narr_bias != -1 and (eng1_ctx_trend_bias == 1 or eng1_ctx_bull_breakout or eng1_ctx_bull_reversal)
bool eng1BearContextAllowed = eng1_exec_valid and eng1_narr_bias != 1 and (eng1_ctx_trend_bias == -1 or eng1_ctx_bear_breakout or eng1_ctx_bear_reversal)
bool eng1HasBullObContext = eng1BullContextAllowed and not na(eng1_ctx_bull_ob_entry)
bool eng1HasBullFvgContext = eng1BullContextAllowed and not na(eng1_ctx_bull_fvg_top) and not na(eng1_ctx_bull_fvg_bottom)
bool eng1HasBearObContext = eng1BearContextAllowed and not na(eng1_ctx_bear_ob_entry)
bool eng1HasBearFvgContext = eng1BearContextAllowed and not na(eng1_ctx_bear_fvg_top) and not na(eng1_ctx_bear_fvg_bottom)
int eng1BullObCreatedBar = not na(eng1_ctx_bull_ob_bar) ? nz(f_timeToChartBar(eng1_ctx_bull_ob_bar), bar_index) : na
int eng1BullFvgCreatedBar = not na(eng1_ctx_bull_fvg_bar) ? nz(f_timeToChartBar(eng1_ctx_bull_fvg_bar), bar_index) : na
int eng1BearObCreatedBar = not na(eng1_ctx_bear_ob_bar) ? nz(f_timeToChartBar(eng1_ctx_bear_ob_bar), bar_index) : na
int eng1BearFvgCreatedBar = not na(eng1_ctx_bear_fvg_bar) ? nz(f_timeToChartBar(eng1_ctx_bear_fvg_bar), bar_index) : na
bool eng1BullObTouched = f_zoneTouchedSinceBar(eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng1BullObCreatedBar, eng1ContextTouchScan)
bool eng1BullFvgTouched = f_zoneTouchedSinceBar(eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng1BullFvgCreatedBar, eng1ContextTouchScan)
bool eng1BearObTouched = f_zoneTouchedSinceBar(eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng1BearObCreatedBar, eng1ContextTouchScan)
bool eng1BearFvgTouched = f_zoneTouchedSinceBar(eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng1BearFvgCreatedBar, eng1ContextTouchScan)

float latestBullZoneTop = na
float latestBullZoneBottom = na
float latestBullEntry = na
bool latestBullZoneIsBreaker = false
int latestBullZoneCreatedBar = na
bool latestBullZoneTouched = false
bool latestBullZoneFromEng1 = false
float latestBearZoneBottom = na
float latestBearZoneTop = na
float latestBearEntry = na
bool latestBearZoneIsBreaker = false
int latestBearZoneCreatedBar = na
bool latestBearZoneTouched = false
bool latestBearZoneFromEng1 = false
if na(latestBullZoneBottom) and eng1HasBullObContext
    latestBullZoneTop := eng1_ctx_bull_ob_top
    latestBullZoneBottom := eng1_ctx_bull_ob_bottom
    latestBullEntry := eng1_ctx_bull_ob_entry
    latestBullZoneIsBreaker := eng1_ctx_bull_reversal
    latestBullZoneCreatedBar := eng1BullObCreatedBar
    latestBullZoneTouched := eng1BullObTouched
    latestBullZoneFromEng1 := true

if na(latestBullFvgTop) and eng1HasBullFvgContext
    latestBullFvgTop := eng1_ctx_bull_fvg_top
    latestBullFvgBottom := eng1_ctx_bull_fvg_bottom
    latestBullFvgCreatedBar := eng1BullFvgCreatedBar
    latestBullFvgTouched := eng1BullFvgTouched
    latestBullFvgFromEng1 := true

if na(latestBearZoneTop) and eng1HasBearObContext
    latestBearZoneBottom := eng1_ctx_bear_ob_bottom
    latestBearZoneTop := eng1_ctx_bear_ob_top
    latestBearEntry := eng1_ctx_bear_ob_entry
    latestBearZoneIsBreaker := eng1_ctx_bear_reversal
    latestBearZoneCreatedBar := eng1BearObCreatedBar
    latestBearZoneTouched := eng1BearObTouched
    latestBearZoneFromEng1 := true

if na(latestBearFvgTop) and eng1HasBearFvgContext
    latestBearFvgTop := eng1_ctx_bear_fvg_top
    latestBearFvgBottom := eng1_ctx_bear_fvg_bottom
    latestBearFvgCreatedBar := eng1BearFvgCreatedBar
    latestBearFvgTouched := eng1BearFvgTouched
    latestBearFvgFromEng1 := true

bool bullObPdPass = not na(latestBullZoneTop) and not na(effectiveBullEquilibrium) and f_zoneMid(latestBullZoneTop, latestBullZoneBottom) < effectiveBullEquilibrium
bool bullFvgPdPass = not na(latestBullFvgTop) and not na(effectiveBullEquilibrium) and f_zoneMid(latestBullFvgTop, latestBullFvgBottom) < effectiveBullEquilibrium
bool bearObPdPass = not na(latestBearZoneTop) and not na(effectiveBearEquilibrium) and f_zoneMid(latestBearZoneTop, latestBearZoneBottom) > effectiveBearEquilibrium
bool bearFvgPdPass = not na(latestBearFvgTop) and not na(effectiveBearEquilibrium) and f_zoneMid(latestBearFvgTop, latestBearFvgBottom) > effectiveBearEquilibrium
bool bullObOtePass = effectiveLongOteReady and f_zoneIntersects(latestBullZoneTop, latestBullZoneBottom, effectiveOteLongTop, effectiveOteLongBottom)
bool bullFvgOtePass = effectiveLongOteReady and f_zoneIntersects(latestBullFvgTop, latestBullFvgBottom, effectiveOteLongTop, effectiveOteLongBottom)
bool bearObOtePass = effectiveShortOteReady and f_zoneIntersects(latestBearZoneTop, latestBearZoneBottom, effectiveOteShortTop, effectiveOteShortBottom)
bool bearFvgOtePass = effectiveShortOteReady and f_zoneIntersects(latestBearFvgTop, latestBearFvgBottom, effectiveOteShortTop, effectiveOteShortBottom)
bool hasBullOb = not na(latestBullEntry)
bool hasBullFvg = not na(latestBullFvgTop) and not na(latestBullFvgBottom)
bool hasBearOb = not na(latestBearEntry)
bool hasBearFvg = not na(latestBearFvgTop) and not na(latestBearFvgBottom)
bool bullObZoneConfirmPass = bullObPdPass and bullObOtePass
bool bullFvgZoneConfirmPass = bullFvgPdPass and bullFvgOtePass
bool bearObZoneConfirmPass = bearObPdPass and bearObOtePass
bool bearFvgZoneConfirmPass = bearFvgPdPass and bearFvgOtePass
bool preferBullOb = false
bool preferBullFvg = false
bool preferBearOb = false
bool preferBearFvg = false

if strictModeEnabled
    // In strict ICT mode, prefer FVG first after the ERL sweep.
    if hasBullFvg and bullFvgZoneConfirmPass
        preferBullFvg := true
    else if hasBullOb and bullObZoneConfirmPass
        preferBullOb := true
    else
        preferBullFvg := hasBullFvg
        preferBullOb := not preferBullFvg and hasBullOb

    if hasBearFvg and bearFvgZoneConfirmPass
        preferBearFvg := true
    else if hasBearOb and bearObZoneConfirmPass
        preferBearOb := true
    else
        preferBearFvg := hasBearFvg
        preferBearOb := not preferBearFvg and hasBearOb
else
    // In standard mode, keep selection explicit and lean:
    // confirmed candidate wins; otherwise in-zone candidate wins; otherwise OB wins.
    bool bullFvgConfirmed = hasBullFvg and bullFvgZoneConfirmPass
    bool bullObConfirmed = hasBullOb and bullObZoneConfirmPass
    bool bearFvgConfirmed = hasBearFvg and bearFvgZoneConfirmPass
    bool bearObConfirmed = hasBearOb and bearObZoneConfirmPass
    bool bullFvgInZone = hasBullFvg and close >= latestBullFvgBottom and close <= latestBullFvgTop
    bool bullObInZone = hasBullOb and close >= latestBullZoneBottom and close <= latestBullZoneTop
    bool bearFvgInZone = hasBearFvg and close >= latestBearFvgBottom and close <= latestBearFvgTop
    bool bearObInZone = hasBearOb and close >= latestBearZoneBottom and close <= latestBearZoneTop

    if bullFvgConfirmed and not bullObConfirmed
        preferBullFvg := true
    else if bullObConfirmed and not bullFvgConfirmed
        preferBullOb := true
    else if bullFvgInZone and not bullObInZone
        preferBullFvg := true
    else if bullObInZone and not bullFvgInZone
        preferBullOb := true
    else if hasBullOb
        preferBullOb := true
    else
        preferBullFvg := hasBullFvg

    if bearFvgConfirmed and not bearObConfirmed
        preferBearFvg := true
    else if bearObConfirmed and not bearFvgConfirmed
        preferBearOb := true
    else if bearFvgInZone and not bearObInZone
        preferBearFvg := true
    else if bearObInZone and not bearFvgInZone
        preferBearOb := true
    else if hasBearOb
        preferBearOb := true
    else
        preferBearFvg := hasBearFvg

float tradeLongEntry = na
float tradeLongStop = na
float tradeLongTarget = na
bool longTargetIsLiquidity = false
string tradeLongSetup = "Waiting"
float tradeLongValidTop = na
float tradeLongValidBottom = na
bool tradeLongIsOb = false
bool tradeLongIsFvg = false
bool tradeLongFromEng1 = false
int tradeLongCreatedBar = na
bool tradeLongTouched = false

if preferBullOb
    tradeLongEntry := latestBullEntry
    float structuralLongStop = latestBullZoneBottom - atr * stopAtrBuffer
    tradeLongStop := structuralLongStop
    tradeLongSetup := latestBullZoneIsBreaker ? "Bullish Breaker" : "Bullish OB"
    tradeLongValidTop := latestBullZoneTop
    tradeLongValidBottom := latestBullZoneBottom
    tradeLongIsOb := true
    tradeLongFromEng1 := latestBullZoneFromEng1
    tradeLongCreatedBar := latestBullZoneCreatedBar
    tradeLongTouched := latestBullZoneTouched
else if preferBullFvg
    tradeLongEntry := f_zoneMid(latestBullFvgTop, latestBullFvgBottom)
    float structuralLongStop = latestBullFvgBottom - atr * stopAtrBuffer
    tradeLongStop := structuralLongStop
    tradeLongSetup := "Bullish FVG"
    tradeLongValidTop := latestBullFvgTop
    tradeLongValidBottom := latestBullFvgBottom
    tradeLongIsFvg := true
    tradeLongFromEng1 := latestBullFvgFromEng1
    tradeLongCreatedBar := latestBullFvgCreatedBar
    tradeLongTouched := latestBullFvgTouched

if not na(tradeLongEntry)
    tradeLongTarget := f_nearestAbove(tradeLongEntry, effectiveExecLiqHigh, effectiveExecEqHigh, effectiveContextHigh, na, na, na, na)
    longTargetIsLiquidity := not na(tradeLongTarget)
    float tempLongRisk = not na(tradeLongStop) ? tradeLongEntry - tradeLongStop : na
    if na(tradeLongTarget) and not na(tempLongRisk) and tempLongRisk > 0
        tradeLongTarget := tradeLongEntry + tempLongRisk * 2.0

float tradeShortEntry = na
float tradeShortStop = na
float tradeShortTarget = na
bool shortTargetIsLiquidity = false
string tradeShortSetup = "Waiting"
float tradeShortValidTop = na
float tradeShortValidBottom = na
bool tradeShortIsOb = false
bool tradeShortIsFvg = false
bool tradeShortFromEng1 = false
int tradeShortCreatedBar = na
bool tradeShortTouched = false

if preferBearOb
    tradeShortEntry := latestBearEntry
    float structuralShortStop = latestBearZoneTop + atr * stopAtrBuffer
    tradeShortStop := structuralShortStop
    tradeShortSetup := latestBearZoneIsBreaker ? "Bearish Breaker" : "Bearish OB"
    tradeShortValidTop := latestBearZoneTop
    tradeShortValidBottom := latestBearZoneBottom
    tradeShortIsOb := true
    tradeShortFromEng1 := latestBearZoneFromEng1
    tradeShortCreatedBar := latestBearZoneCreatedBar
    tradeShortTouched := latestBearZoneTouched
else if preferBearFvg
    tradeShortEntry := f_zoneMid(latestBearFvgTop, latestBearFvgBottom)
    float structuralShortStop = latestBearFvgTop + atr * stopAtrBuffer
    tradeShortStop := structuralShortStop
    tradeShortSetup := "Bearish FVG"
    tradeShortValidTop := latestBearFvgTop
    tradeShortValidBottom := latestBearFvgBottom
    tradeShortIsFvg := true
    tradeShortFromEng1 := latestBearFvgFromEng1
    tradeShortCreatedBar := latestBearFvgCreatedBar
    tradeShortTouched := latestBearFvgTouched

if not na(tradeShortEntry)
    tradeShortTarget := f_nearestBelow(tradeShortEntry, effectiveExecLiqLow, effectiveExecEqLow, effectiveContextLow, na, na, na, na)
    shortTargetIsLiquidity := not na(tradeShortTarget)
    float tempShortRisk = not na(tradeShortStop) ? tradeShortStop - tradeShortEntry : na
    if na(tradeShortTarget) and not na(tempShortRisk) and tempShortRisk > 0
        tradeShortTarget := tradeShortEntry - tempShortRisk * 2.0

float longDolExternal = not na(tradeLongEntry) ? f_nearestAbove(tradeLongEntry, effectiveContextHigh, na, na, na, na, na, na) : na
float shortDolExternal = not na(tradeShortEntry) ? f_nearestBelow(tradeShortEntry, effectiveContextLow, na, na, na, na, na, na) : na
bool longQualifiedExternalDol = not na(longDolExternal) and not na(tradeLongEntry) and not na(tradeLongStop) and tradeLongEntry > tradeLongStop and longDolExternal - tradeLongEntry >= tradeLongEntry - tradeLongStop
bool shortQualifiedExternalDol = not na(shortDolExternal) and not na(tradeShortEntry) and not na(tradeShortStop) and tradeShortStop > tradeShortEntry and tradeShortEntry - shortDolExternal >= tradeShortStop - tradeShortEntry
bool longUsesExternalDolTarget = strictModeEnabled and longQualifiedExternalDol
bool shortUsesExternalDolTarget = strictModeEnabled and shortQualifiedExternalDol
float activeLongTarget = longUsesExternalDolTarget ? longDolExternal : tradeLongTarget
float activeShortTarget = shortUsesExternalDolTarget ? shortDolExternal : tradeShortTarget

float longRisk = not na(tradeLongEntry) and not na(tradeLongStop) ? tradeLongEntry - tradeLongStop : na
float longReward = not na(tradeLongEntry) and not na(activeLongTarget) ? activeLongTarget - tradeLongEntry : na
float longRr = not na(longRisk) and longRisk > 0 and not na(longReward) ? longReward / longRisk : na
bool longPriceInZone = not na(tradeLongValidBottom) and close >= tradeLongValidBottom and close <= tradeLongValidTop
bool longPriceNearZone = not na(tradeLongEntry) and math.abs(close - tradeLongEntry) <= atr * 0.25
int longSetupAge = not na(tradeLongCreatedBar) ? bar_index - tradeLongCreatedBar : na
bool longExpiredUntouched = not tradeLongTouched and not na(longSetupAge) and longSetupAge > expiryBarsEffective
bool longChased = not tradeLongTouched and not na(tradeLongValidTop) and close > tradeLongValidTop + atr * setupChaseAtr
bool effectiveLongDirectional = displayExecBias == 1
bool effectiveLongSweepSeen = eng1_exe_bull_sweep
bool effectiveLongMssSeen = eng1_exe_bull_mss
bool effectiveLongDisplacementSeen = eng1_exe_bull_displacement
bool effectiveLongMssFresh = eng1_exe_bull_mss
bool effectiveLongStructureInvalidated = displayExecBias == -1 and (eng1_ctx_bear_breakout or eng1_ctx_bear_reversal or eng1_exe_bear_mss)
bool strictLongBiasPass = not strictModeEnabled or (displayExecBias == 1 and displayCtxBias == 1 and displayNarrBias != -1)
bool strictLongSweepPass = not strictModeEnabled or effectiveLongSweepSeen
bool strictLongMssPass = not strictModeEnabled or (effectiveLongMssSeen and effectiveLongMssFresh and effectiveLongDirectional)
bool strictLongPdPass = not strictModeEnabled or (not na(tradeLongValidTop) and not na(effectiveBullEquilibrium) and f_zoneMid(tradeLongValidTop, tradeLongValidBottom) < effectiveBullEquilibrium)
bool strictLongOtePass = not strictModeEnabled or (effectiveLongOteReady and f_zoneIntersects(tradeLongValidTop, tradeLongValidBottom, effectiveOteLongTop, effectiveOteLongBottom))
bool strictLongDolPass = not strictModeEnabled or longQualifiedExternalDol
bool strictLongKillzonePass = not strictModeEnabled or strictKillzoneActive
bool strictLongContextPass = strictLongBiasPass and strictLongSweepPass and strictLongMssPass and strictLongPdPass and strictLongOtePass and strictLongDolPass
bool longConfirmationPass = not strictModeEnabled or (strictLongContextPass and strictLongKillzonePass)
bool longExecutionFreshPass = strictModeEnabled ? effectiveLongMssFresh : effectiveLongMssSeen
var string lastLongSetupTag = ""
var bool longManagedLatched = false
var bool longCompletedLatched = false
var bool longAmbiguousLatched = false
string currentLongSetupTag = not na(tradeLongCreatedBar) ? tradeLongSetup + "|" + str.tostring(tradeLongCreatedBar) : ""
if currentLongSetupTag == ""
    longManagedLatched := false
    longCompletedLatched := false
    longAmbiguousLatched := false
else if currentLongSetupTag != lastLongSetupTag
    longManagedLatched := false
    longCompletedLatched := false
    longAmbiguousLatched := false
bool longManagedHit = tradeLongTouched and not na(longRisk) and high >= tradeLongEntry + longRisk * setupManagedR
if longManagedHit
    longManagedLatched := true
bool longManagedLatchedState = currentLongSetupTag != "" and longManagedLatched
bool longStopHit = not na(tradeLongStop) and low <= tradeLongStop
bool longTpHit = tradeLongTouched and not na(activeLongTarget) and high >= activeLongTarget
bool longAmbiguousNow = currentLongSetupTag != "" and tradeLongTouched and not longCompletedLatched and not longAmbiguousLatched and longStopHit and longTpHit
if longAmbiguousNow
    longAmbiguousLatched := true
if longTpHit and not longAmbiguousNow and not longAmbiguousLatched
    longCompletedLatched := true
bool longAmbiguous = currentLongSetupTag != "" and longAmbiguousLatched
bool longCompleted = currentLongSetupTag != "" and longCompletedLatched and not longAmbiguous
lastLongSetupTag := currentLongSetupTag
bool longInvalidated = not longAmbiguous and ((longStopHit and not longAmbiguousNow) or effectiveLongStructureInvalidated)
bool longManagedStale = longManagedLatchedState and not longCompleted and not longAmbiguous and not na(longSetupAge) and longSetupAge > expiryBarsEffective
bool longManaged = longManagedLatchedState and not longManagedStale and not longAmbiguous
bool longTouchedStale = tradeLongTouched and not longManagedLatchedState and not longCompleted and not longAmbiguous and not na(longSetupAge) and longSetupAge > expiryBarsEffective
bool longExpired = longExpiredUntouched or longTouchedStale
longExpired := longExpired or longManagedStale

float shortRisk = not na(tradeShortEntry) and not na(tradeShortStop) ? tradeShortStop - tradeShortEntry : na
float shortReward = not na(tradeShortEntry) and not na(activeShortTarget) ? tradeShortEntry - activeShortTarget : na
float shortRr = not na(shortRisk) and shortRisk > 0 and not na(shortReward) ? shortReward / shortRisk : na
bool shortPriceInZone = not na(tradeShortValidBottom) and close >= tradeShortValidBottom and close <= tradeShortValidTop
bool shortPriceNearZone = not na(tradeShortEntry) and math.abs(close - tradeShortEntry) <= atr * 0.25
int shortSetupAge = not na(tradeShortCreatedBar) ? bar_index - tradeShortCreatedBar : na
bool shortExpiredUntouched = not tradeShortTouched and not na(shortSetupAge) and shortSetupAge > expiryBarsEffective
bool shortChased = not tradeShortTouched and not na(tradeShortValidBottom) and close < tradeShortValidBottom - atr * setupChaseAtr
bool effectiveShortDirectional = displayExecBias == -1
bool effectiveShortSweepSeen = eng1_exe_bear_sweep
bool effectiveShortMssSeen = eng1_exe_bear_mss
bool effectiveShortDisplacementSeen = eng1_exe_bear_displacement
bool effectiveShortMssFresh = eng1_exe_bear_mss
bool effectiveShortStructureInvalidated = displayExecBias == 1 and (eng1_ctx_bull_breakout or eng1_ctx_bull_reversal or eng1_exe_bull_mss)
bool strictShortBiasPass = not strictModeEnabled or (displayExecBias == -1 and displayCtxBias == -1 and displayNarrBias != 1)
bool strictShortSweepPass = not strictModeEnabled or effectiveShortSweepSeen
bool strictShortMssPass = not strictModeEnabled or (effectiveShortMssSeen and effectiveShortMssFresh and effectiveShortDirectional)
bool strictShortPdPass = not strictModeEnabled or (not na(tradeShortValidTop) and not na(effectiveBearEquilibrium) and f_zoneMid(tradeShortValidTop, tradeShortValidBottom) > effectiveBearEquilibrium)
bool strictShortOtePass = not strictModeEnabled or (effectiveShortOteReady and f_zoneIntersects(tradeShortValidTop, tradeShortValidBottom, effectiveOteShortTop, effectiveOteShortBottom))
bool strictShortDolPass = not strictModeEnabled or shortQualifiedExternalDol
bool strictShortKillzonePass = not strictModeEnabled or strictKillzoneActive
bool strictShortContextPass = strictShortBiasPass and strictShortSweepPass and strictShortMssPass and strictShortPdPass and strictShortOtePass and strictShortDolPass
bool shortConfirmationPass = not strictModeEnabled or (strictShortContextPass and strictShortKillzonePass)
bool shortExecutionFreshPass = strictModeEnabled ? effectiveShortMssFresh : effectiveShortMssSeen
var string lastShortSetupTag = ""
var bool shortManagedLatched = false
var bool shortCompletedLatched = false
var bool shortAmbiguousLatched = false
string currentShortSetupTag = not na(tradeShortCreatedBar) ? tradeShortSetup + "|" + str.tostring(tradeShortCreatedBar) : ""
if currentShortSetupTag == ""
    shortManagedLatched := false
    shortCompletedLatched := false
    shortAmbiguousLatched := false
else if currentShortSetupTag != lastShortSetupTag
    shortManagedLatched := false
    shortCompletedLatched := false
    shortAmbiguousLatched := false
bool shortManagedHit = tradeShortTouched and not na(shortRisk) and low <= tradeShortEntry - shortRisk * setupManagedR
if shortManagedHit
    shortManagedLatched := true
bool shortManagedLatchedState = currentShortSetupTag != "" and shortManagedLatched
bool shortStopHit = not na(tradeShortStop) and high >= tradeShortStop
bool shortTpHit = tradeShortTouched and not na(activeShortTarget) and low <= activeShortTarget
bool shortAmbiguousNow = currentShortSetupTag != "" and tradeShortTouched and not shortCompletedLatched and not shortAmbiguousLatched and shortStopHit and shortTpHit
if shortAmbiguousNow
    shortAmbiguousLatched := true
if shortTpHit and not shortAmbiguousNow and not shortAmbiguousLatched
    shortCompletedLatched := true
bool shortAmbiguous = currentShortSetupTag != "" and shortAmbiguousLatched
bool shortCompleted = currentShortSetupTag != "" and shortCompletedLatched and not shortAmbiguous
lastShortSetupTag := currentShortSetupTag
bool shortInvalidated = not shortAmbiguous and ((shortStopHit and not shortAmbiguousNow) or effectiveShortStructureInvalidated)
bool shortManagedStale = shortManagedLatchedState and not shortCompleted and not shortAmbiguous and not na(shortSetupAge) and shortSetupAge > expiryBarsEffective
bool shortManaged = currentShortSetupTag != "" and shortManagedLatched and not shortManagedStale and not shortAmbiguous
bool shortTouchedStale = tradeShortTouched and not shortManagedLatchedState and not shortCompleted and not shortAmbiguous and not na(shortSetupAge) and shortSetupAge > expiryBarsEffective
bool shortExpired = shortExpiredUntouched or shortTouchedStale
shortExpired := shortExpired or shortManagedStale

// Keep setup scoring intentionally simple to reduce overtuning.
bool longBiasAligned = displayExecBias == 1
bool shortBiasAligned = displayExecBias == -1
bool longHtfAligned = displayCtxBias == 1 and displayNarrBias != -1
bool shortHtfAligned = displayCtxBias == -1 and displayNarrBias != 1
bool longDisplacementSeen = effectiveLongDisplacementSeen
bool shortDisplacementSeen = effectiveShortDisplacementSeen
bool longPoiConfirmPass = tradeLongIsFvg ? bullFvgZoneConfirmPass : tradeLongIsOb ? bullObZoneConfirmPass : false
bool shortPoiConfirmPass = tradeShortIsFvg ? bearFvgZoneConfirmPass : tradeShortIsOb ? bearObZoneConfirmPass : false
float longDepartureRange = not na(effectiveRangeHigh) and not na(effectiveRangeLow) ? effectiveRangeHigh - effectiveRangeLow : na
float shortDepartureRange = not na(effectiveRangeHigh) and not na(effectiveRangeLow) ? effectiveRangeHigh - effectiveRangeLow : na
var string lastLongQualityTag = ""
var int longResponseScoreSnapshot = 0
var int longDisplacementScoreSnapshot = 0
var int longAtrExpansionScoreSnapshot = 0
var string longQualityTierSnapshot = "-"
var string lastShortQualityTag = ""
var int shortResponseScoreSnapshot = 0
var int shortDisplacementScoreSnapshot = 0
var int shortAtrExpansionScoreSnapshot = 0
var string shortQualityTierSnapshot = "-"
if currentLongSetupTag == ""
    lastLongQualityTag := ""
    longResponseScoreSnapshot := 0
    longDisplacementScoreSnapshot := 0
    longAtrExpansionScoreSnapshot := 0
    longQualityTierSnapshot := "-"
else if currentLongSetupTag != lastLongQualityTag
    longResponseScoreSnapshot := f_zoneResponseScore(true, longPoiConfirmPass)
    longDisplacementScoreSnapshot := f_zoneDisplacementScore(longDisplacementSeen)
    longAtrExpansionScoreSnapshot := f_zoneAtrExpansionScore(longDepartureRange, atr)
    longQualityTierSnapshot := f_zoneQualityTier(true, longResponseScoreSnapshot, longDisplacementScoreSnapshot, longAtrExpansionScoreSnapshot)
    lastLongQualityTag := currentLongSetupTag
if currentShortSetupTag == ""
    lastShortQualityTag := ""
    shortResponseScoreSnapshot := 0
    shortDisplacementScoreSnapshot := 0
    shortAtrExpansionScoreSnapshot := 0
    shortQualityTierSnapshot := "-"
else if currentShortSetupTag != lastShortQualityTag
    shortResponseScoreSnapshot := f_zoneResponseScore(true, shortPoiConfirmPass)
    shortDisplacementScoreSnapshot := f_zoneDisplacementScore(shortDisplacementSeen)
    shortAtrExpansionScoreSnapshot := f_zoneAtrExpansionScore(shortDepartureRange, atr)
    shortQualityTierSnapshot := f_zoneQualityTier(true, shortResponseScoreSnapshot, shortDisplacementScoreSnapshot, shortAtrExpansionScoreSnapshot)
    lastShortQualityTag := currentShortSetupTag
string longExecutionState = f_setupExecutionState(not na(tradeLongEntry), longAmbiguous, longInvalidated, longExpired, longChased, longCompleted, longManaged, effectiveLongDirectional and effectiveLongSweepSeen and effectiveLongMssSeen, longConfirmationPass, longExecutionFreshPass, longDisplacementSeen, longPriceInZone, longPriceNearZone)
string shortExecutionState = f_setupExecutionState(not na(tradeShortEntry), shortAmbiguous, shortInvalidated, shortExpired, shortChased, shortCompleted, shortManaged, effectiveShortDirectional and effectiveShortSweepSeen and effectiveShortMssSeen, shortConfirmationPass, shortExecutionFreshPass, shortDisplacementSeen, shortPriceInZone, shortPriceNearZone)
string longSetupDisplay = f_setupQualityText(tradeLongSetup, not na(tradeLongEntry) ? longQualityTierSnapshot : "-", not na(tradeLongEntry))
string shortSetupDisplay = f_setupQualityText(tradeShortSetup, not na(tradeShortEntry) ? shortQualityTierSnapshot : "-", not na(tradeShortEntry))

float longConfidence = f_setupScore(not na(tradeLongEntry), longBiasAligned, longHtfAligned, longPriceInZone, longPriceNearZone, longRr, longChased, longExpired, longInvalidated)

float shortConfidence = f_setupScore(not na(tradeShortEntry), shortBiasAligned, shortHtfAligned, shortPriceInZone, shortPriceNearZone, shortRr, shortChased, shortExpired, shortInvalidated)

bool longSelectedVisualActive = not f_executionTerminal(longExecutionState)
bool shortSelectedVisualActive = not f_executionTerminal(shortExecutionState)
string preferredDirection = "Wait"
bool longPreferredReady = f_executionRiskVisible(longExecutionState)
bool shortPreferredReady = f_executionRiskVisible(shortExecutionState)
bool longPriorityCandidate = not na(tradeLongEntry) and not f_dashboardRetired(longExecutionState, longSetupAge, tradeLongTouched, expiryBarsEffective)
bool shortPriorityCandidate = not na(tradeShortEntry) and not f_dashboardRetired(shortExecutionState, shortSetupAge, tradeShortTouched, expiryBarsEffective)
if longPreferredReady and not shortPreferredReady
    preferredDirection := "Long"
else if shortPreferredReady and not longPreferredReady
    preferredDirection := "Short"
else if longPreferredReady and shortPreferredReady
    preferredDirection := "Balanced"

bool compactUseLong = preferredDirection == "Long"
if preferredDirection == "Short"
    compactUseLong := false
else if preferredDirection == "Balanced"
    if longPriorityCandidate and not shortPriorityCandidate
        compactUseLong := true
    else if shortPriorityCandidate and not longPriorityCandidate
        compactUseLong := false
    else if not na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := tradeLongCreatedBar >= tradeShortCreatedBar
    else if na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := false
else
    if longPriorityCandidate and not shortPriorityCandidate
        compactUseLong := true
    else if shortPriorityCandidate and not longPriorityCandidate
        compactUseLong := false
    else if not na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := tradeLongCreatedBar >= tradeShortCreatedBar
    else if na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := false

bool eng1BullContextTypeVisible = (tradeLongIsOb and showOb) or (tradeLongIsFvg and showFvg)
bool eng1BearContextTypeVisible = (tradeShortIsOb and showOb) or (tradeShortIsFvg and showFvg)
bool showEng1BullContextVisual = longSelectedVisualActive and tradeLongFromEng1 and eng1BullContextTypeVisible and f_zoneVisibleByMode(effectiveZoneDisplayMode, true, true, preferredDirection, compactUseLong)
bool showEng1BearContextVisual = shortSelectedVisualActive and tradeShortFromEng1 and eng1BearContextTypeVisible and f_zoneVisibleByMode(effectiveZoneDisplayMode, true, false, preferredDirection, compactUseLong)
string eng1BullContextBadge = f_executionStateBadge(longExecutionState, compactMode)
string eng1BearContextBadge = f_executionStateBadge(shortExecutionState, compactMode)
string eng1BullContextBaseLabel = tradeLongIsOb ? f_obLabelText(true, eng1_ctx_bull_reversal) : tradeLongIsFvg ? f_fvgLabelText(true) : ""
string eng1BearContextBaseLabel = tradeShortIsOb ? f_obLabelText(false, eng1_ctx_bear_reversal) : tradeShortIsFvg ? f_fvgLabelText(false) : ""
string eng1BullContextLabelText = eng1BullContextBaseLabel == "" ? "" : eng1BullContextBadge != "" ? eng1BullContextBaseLabel + " | " + eng1BullContextBadge : eng1BullContextBaseLabel
string eng1BearContextLabelText = eng1BearContextBaseLabel == "" ? "" : eng1BearContextBadge != "" ? eng1BearContextBaseLabel + " | " + eng1BearContextBadge : eng1BearContextBaseLabel
color eng1BullContextBorder = color.new(bullColor, longExecutionState == "Managed" ? 18 : 0)
color eng1BearContextBorder = color.new(bearColor, shortExecutionState == "Managed" ? 18 : 0)
color eng1BullContextFill = color.new(bullColor, f_executionSelectedFillAlpha(longExecutionState))
color eng1BearContextFill = color.new(bearColor, f_executionSelectedFillAlpha(shortExecutionState))
[eng1BullContextBoxTmp, eng1BullContextLineTmp, eng1BullContextLabelTmp] = f_syncEng1ContextVisual(eng1BullContextBox, eng1BullContextLine, eng1BullContextLabel, showEng1BullContextVisual, tradeLongCreatedBar, tradeLongValidTop, tradeLongValidBottom, tradeLongEntry, eng1BullContextLabelText, eng1BullContextBorder, eng1BullContextFill, tradeLongIsOb, tradeLongIsOb, longExecutionState)
[eng1BearContextBoxTmp, eng1BearContextLineTmp, eng1BearContextLabelTmp] = f_syncEng1ContextVisual(eng1BearContextBox, eng1BearContextLine, eng1BearContextLabel, showEng1BearContextVisual, tradeShortCreatedBar, tradeShortValidTop, tradeShortValidBottom, tradeShortEntry, eng1BearContextLabelText, eng1BearContextBorder, eng1BearContextFill, tradeShortIsOb, tradeShortIsOb, shortExecutionState)
eng1BullContextBox := eng1BullContextBoxTmp
eng1BullContextLine := eng1BullContextLineTmp
eng1BullContextLabel := eng1BullContextLabelTmp
eng1BearContextBox := eng1BearContextBoxTmp
eng1BearContextLine := eng1BearContextLineTmp
eng1BearContextLabel := eng1BearContextLabelTmp

string compactSetup = compactUseLong ? longSetupDisplay : shortSetupDisplay
string compactExecutionState = compactUseLong ? longExecutionState : shortExecutionState
float compactZoneTop = compactUseLong ? tradeLongValidTop : tradeShortValidTop
float compactZoneBottom = compactUseLong ? tradeLongValidBottom : tradeShortValidBottom
float compactEntry = compactUseLong ? tradeLongEntry : tradeShortEntry
float compactStop = compactUseLong ? tradeLongStop : tradeShortStop
float compactTarget = compactUseLong ? activeLongTarget : activeShortTarget
float compactRr = compactUseLong ? longRr : shortRr
float compactConfidence = compactUseLong ? longConfidence : shortConfidence
bool compactBalanced = preferredDirection == "Balanced"
bool compactWaiting = preferredDirection == "Wait"
bool compactNeutral = compactBalanced or compactWaiting
bool compactActionable = longPreferredReady or shortPreferredReady
bool compactContextOnly = compactNeutral and not compactActionable
bool longDashboardRetired = f_dashboardRetired(longExecutionState, longSetupAge, tradeLongTouched, expiryBarsEffective)
bool shortDashboardRetired = f_dashboardRetired(shortExecutionState, shortSetupAge, tradeShortTouched, expiryBarsEffective)
color compactAccent = compactNeutral ? color.new(neutralColor, 12) : compactUseLong ? color.new(bullColor, 12) : color.new(bearColor, 12)
bool compactCandidateHasSetup = not na(compactEntry)
bool compactCandidateRetired = compactUseLong ? longDashboardRetired : shortDashboardRetired
float bullStop = not na(tradeLongStop) ? tradeLongStop : not na(effectiveExecLiqLow) ? effectiveExecLiqLow - atr * stopAtrBuffer : na
float bearStop = not na(tradeShortStop) ? tradeShortStop : not na(effectiveExecLiqHigh) ? effectiveExecLiqHigh + atr * stopAtrBuffer : na

//------------------------------------------------------------------------------
// Zone visual policy matrix
// Fresh / live FVG, OB, Breaker:
//   Engine: keep if actionable
//   Full: show
//   Focused: show only selected active zone
//   Minimal: show only selected zone in preferred direction
// Failed OB:
//   Engine: temporary transition only
//   Full: show muted
//   Focused / Minimal: hide
// Retired FVG / deleted OB / swept EQH-EQL:
//   Engine: remove / deactivate
//   Visual: never show
// Liquidity targets:
//   Session/calendar liquidity stays engine-only
//   Chart uses session range boxes + extended H/L lines instead
// Context ranges:
//   Full / Focused: show
//   Minimal: keep only protected levels
//------------------------------------------------------------------------------
float longDashboardDol = longUsesExternalDolTarget ? longDolExternal : na
float shortDashboardDol = shortUsesExternalDolTarget ? shortDolExternal : na
primaryExternalDrawLevel = compactUseLong ? longDashboardDol : shortDashboardDol
targetEqHigh = f_preferredLevelMatch(effectiveExecEqHigh, compactBalanced, compactUseLong, activeLongTarget, activeShortTarget)
targetEqLow = f_preferredLevelMatch(effectiveExecEqLow, compactBalanced, compactUseLong, activeLongTarget, activeShortTarget)
showEqHighVisual = showLiquidity and not compactMode and f_targetVisualByMode(effectiveZoneDisplayMode, targetEqHigh)
showEqLowVisual = showLiquidity and not compactMode and f_targetVisualByMode(effectiveZoneDisplayMode, targetEqLow)
showProtectedHighVisual = showProtectedLevels and not na(effectiveProtectedHigh)
showProtectedLowVisual = showProtectedLevels and not na(effectiveProtectedLow)
showRangeVisual = showLiquidity and displayInternalRange and f_contextVisualByMode(effectiveZoneDisplayMode)
showOteVisual = strictShowOte and effectiveZoneDisplayMode != "Minimal"
oteActiveSummary = not na(effectiveOteLongTop) ? "OTE:L" : not na(effectiveOteShortTop) ? "OTE:S" : "OTE:-"
string modeStatusCore = "Eff " + effectiveZoneDisplayMode + " | " + mtfSummary + " | " + oteActiveSummary
string desktopModeStatus = modeStatusCore
string compactModeStatus = usagePreset + " | " + modeStatusCore
showHtfHighVisual = showHtf and not na(effectiveContextHigh)
showHtfLowVisual = showHtf and not na(effectiveContextLow)
showLongRiskVisual = showRisk and not compactMode and f_executionVisualByMode(effectiveZoneDisplayMode, f_executionRiskVisible(longExecutionState), preferredDirection, true, compactUseLong)
showShortRiskVisual = showRisk and not compactMode and f_executionVisualByMode(effectiveZoneDisplayMode, f_executionRiskVisible(shortExecutionState), preferredDirection, false, compactUseLong)

if effectiveZoneDisplayMode != "Full"
    showEqHighVisual := f_uniqueLevelVisual(showEqHighVisual, effectiveExecEqHigh, showHtfHighVisual, effectiveContextHigh, false, na, false, na, false, na, false, na)
    showEqLowVisual := f_uniqueLevelVisual(showEqLowVisual, effectiveExecEqLow, showHtfLowVisual, effectiveContextLow, false, na, false, na, false, na, false, na)

//------------------------------------------------------------------------------
// Plots
//------------------------------------------------------------------------------
eqHighLevel = f_horizontalLevel(effectiveExecEqHigh, showEqHighVisual)
eqLowLevel = f_horizontalLevel(effectiveExecEqLow, showEqLowVisual)
protectedHighLevel = f_horizontalLevel(effectiveProtectedHigh, showProtectedHighVisual)
protectedLowLevel = f_horizontalLevel(effectiveProtectedLow, showProtectedLowVisual)
internalHighLevel = f_horizontalLevel(effectiveRangeHigh, showRangeVisual)
internalLowLevel = f_horizontalLevel(effectiveRangeLow, showRangeVisual)
internalEqLevel = f_horizontalLevel(effectiveRangeEquilibrium, showRangeVisual)
htfStructureHighLevel = f_horizontalLevel(effectiveContextHigh, showHtfHighVisual)
htfStructureLowLevel = f_horizontalLevel(effectiveContextLow, showHtfLowVisual)
riskLongEntryLevel = f_horizontalLevel(tradeLongEntry, showLongRiskVisual)
riskShortEntryLevel = f_horizontalLevel(tradeShortEntry, showShortRiskVisual)
riskBullStopLevel = f_horizontalLevel(bullStop, showLongRiskVisual)
riskBearStopLevel = f_horizontalLevel(bearStop, showShortRiskVisual)
riskLongTargetLevel = f_horizontalLevel(activeLongTarget, showLongRiskVisual)
riskShortTargetLevel = f_horizontalLevel(activeShortTarget, showShortRiskVisual)
oteLongTopLevel = f_horizontalLevel(effectiveOteLongTop, showOteVisual)
oteLongBottomLevel = f_horizontalLevel(effectiveOteLongBottom, showOteVisual)
oteShortTopLevel = f_horizontalLevel(effectiveOteShortTop, showOteVisual)
oteShortBottomLevel = f_horizontalLevel(effectiveOteShortBottom, showOteVisual)
rightEdgeLabelTolerance = atr * 0.15
showShortStopRightLabel = showLiquidityRightLabels and showShortRiskVisual and not na(riskBearStopLevel)
showLongStopRightLabel = showLiquidityRightLabels and showLongRiskVisual and not na(riskBullStopLevel)
showHtfHighRightLabel = showLiquidityRightLabels and showHtfHighVisual and not f_levelsClose(htfStructureHighLevel, riskBearStopLevel, rightEdgeLabelTolerance)
showHtfLowRightLabel = showLiquidityRightLabels and showHtfLowVisual and not f_levelsClose(htfStructureLowLevel, riskBullStopLevel, rightEdgeLabelTolerance)
showProtectedHighRightLabel = showLiquidityRightLabels and showProtectedHighVisual and not f_levelsClose(protectedHighLevel, riskBearStopLevel, rightEdgeLabelTolerance) and not f_levelsClose(protectedHighLevel, htfStructureHighLevel, rightEdgeLabelTolerance)
showProtectedLowRightLabel = showLiquidityRightLabels and showProtectedLowVisual and not f_levelsClose(protectedLowLevel, riskBullStopLevel, rightEdgeLabelTolerance) and not f_levelsClose(protectedLowLevel, htfStructureLowLevel, rightEdgeLabelTolerance)

plot(eqHighLevel, "EQH Liquidity", color=color.new(liqHighColor, 12), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plot(eqLowLevel, "EQL Liquidity", color=color.new(liqLowColor, 12), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)

plot(protectedHighLevel, "Protected High", color=color.new(liqHighColor, 8), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
plot(protectedLowLevel, "Protected Low", color=color.new(liqLowColor, 8), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)

internalHighPlot = plot(internalHighLevel, "ICT Dealing Range High", color=color.new(color.silver, 35), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
internalLowPlot = plot(internalLowLevel, "ICT Dealing Range Low", color=color.new(color.silver, 35), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
internalEqPlot = plot(internalEqLevel, "ICT Equilibrium", color=decisionEqColor, linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
fill(internalHighPlot, internalEqPlot, color=showRangeVisual ? decisionPremiumFillColor : na)
fill(internalEqPlot, internalLowPlot, color=showRangeVisual ? decisionDiscountFillColor : na)

if barstate.islast
    protectedHighLabel := f_syncRightEdgeLabel(protectedHighLabel, protectedHighLevel, "Prot H", color.new(liqHighColor, 8), color.white, showProtectedHighRightLabel)
    protectedLowLabel := f_syncRightEdgeLabel(protectedLowLabel, protectedLowLevel, "Prot L", color.new(liqLowColor, 8), color.white, showProtectedLowRightLabel)
    htfHighLabel := f_syncRightEdgeLabel(htfHighLabel, htfStructureHighLevel, "Ctx H", color.new(color.fuchsia, 15), color.white, showHtfHighRightLabel)
    htfLowLabel := f_syncRightEdgeLabel(htfLowLabel, htfStructureLowLevel, "Ctx L", color.new(color.fuchsia, 15), color.white, showHtfLowRightLabel)
    longStopLabel := f_syncRightEdgeLabel(longStopLabel, riskBullStopLevel, "SL L", color.new(bearColor, 0), color.white, showLongStopRightLabel)
    shortStopLabel := f_syncRightEdgeLabel(shortStopLabel, riskBearStopLevel, "SL S", color.new(bullColor, 0), color.white, showShortStopRightLabel)

oteLongTopPlot = plot(oteLongTopLevel, "OTE Long Top", color=color.new(bullColor, 40), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
oteLongBottomPlot = plot(oteLongBottomLevel, "OTE Long Bottom", color=color.new(bullColor, 40), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
oteShortTopPlot = plot(oteShortTopLevel, "OTE Short Top", color=color.new(bearColor, 40), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
oteShortBottomPlot = plot(oteShortBottomLevel, "OTE Short Bottom", color=color.new(bearColor, 40), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
fill(oteLongTopPlot, oteLongBottomPlot, color=showOteVisual ? color.new(bullColor, 92) : na)
fill(oteShortTopPlot, oteShortBottomPlot, color=showOteVisual ? color.new(bearColor, 92) : na)

plot(htfStructureHighLevel, "Context Structure High", color=color.new(color.fuchsia, 15), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
plot(htfStructureLowLevel, "Context Structure Low", color=color.new(color.fuchsia, 15), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)

plot(riskLongEntryLevel, "Bullish Entry Cue", color=color.new(bullColor, 0), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskShortEntryLevel, "Bearish Entry Cue", color=color.new(bearColor, 0), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskBullStopLevel, "Bullish Stop Cue", color=color.new(bearColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskBearStopLevel, "Bearish Stop Cue", color=color.new(bullColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskLongTargetLevel, "Bullish TP Cue", color=color.new(liqHighColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskShortTargetLevel, "Bearish TP Cue", color=color.new(liqLowColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)

chartBackdrop = showTrendBackground and not compactMode ? color.new(displayExecBias == 1 ? bullColor : displayExecBias == -1 ? bearColor : neutralColor, 93) : na
bgcolor(chartBackdrop)

//------------------------------------------------------------------------------
// Dashboard
//------------------------------------------------------------------------------
var table dashboard = table.new(position.top_right, 4, 15, border_width=1)
var table dashboardCompact = table.new(position.bottom_right, 2, 11, border_width=1)

if barstate.islast and showDashboard and not compactDashboardMode
    table.clear(dashboardCompact, 0, 0, 1, 10)
    f_setCell(dashboard, 0, 0, "Field", color.white, panelHeaderBg)
    f_setCell(dashboard, 1, 0, "Market", color.white, panelHeaderBg)
    f_setCell(dashboard, 2, 0, "Long", color.white, color.new(bullColor, 5))
    f_setCell(dashboard, 3, 0, "Short", color.white, color.new(bearColor, 5))

    f_setCell(dashboard, 0, 1, "Exec", color.white, panelCellBg)
    f_setCell(dashboard, 1, 1, "Px " + f_formatLevel(close), color.white, panelCellBg)
    f_setCell(dashboard, 2, 1, longExecutionState, color.white, panelBullBg)
    f_setCell(dashboard, 3, 1, shortExecutionState, color.white, panelBearBg)

    f_setCell(dashboard, 0, 2, "Bias", color.white, panelCellBg)
    f_setCell(dashboard, 1, 2, f_biasSummary(displayExecBias, eng1_exec_valid or htfContextReady, displayCtxBias, displayNarrBias, eng1_exec_valid and eng1_narr_strength != "Flat" ? eng1_narr_strength : not eng1_exec_valid and narrativeHtfReady ? f_regimeStrengthText(displayNarrBias, narrativeClose, narrativeMomentumRef, narrativeAtr) : "Flat"), color.white, panelCellBg)
    f_setCell(dashboard, 2, 2, ((eng1_exec_valid or htfContextReady) ? f_alignmentShortText(true, displayExecBias, displayCtxBias) : "G") + " / " + f_regimeSideShortText(true, displayNarrBias, eng1_exec_valid and eng1_narr_strength != "Flat" ? eng1_narr_strength : not eng1_exec_valid and narrativeHtfReady ? f_regimeStrengthText(displayNarrBias, narrativeClose, narrativeMomentumRef, narrativeAtr) : "Flat"), color.white, panelBullBg)
    f_setCell(dashboard, 3, 2, ((eng1_exec_valid or htfContextReady) ? f_alignmentShortText(false, displayExecBias, displayCtxBias) : "G") + " / " + f_regimeSideShortText(false, displayNarrBias, eng1_exec_valid and eng1_narr_strength != "Flat" ? eng1_narr_strength : not eng1_exec_valid and narrativeHtfReady ? f_regimeStrengthText(displayNarrBias, narrativeClose, narrativeMomentumRef, narrativeAtr) : "Flat"), color.white, panelBearBg)

    f_setCell(dashboard, 0, 3, "Pref", color.white, panelCellBg)
    f_setCell(dashboard, 1, 3, f_preferredExecutionText(preferredDirection, longExecutionState, shortExecutionState, false), color.white, color.new(preferredDirection == "Long" ? bullColor : preferredDirection == "Short" ? bearColor : neutralColor, 15))
    f_setCell(dashboard, 2, 3, f_dashboardSetupText(longSetupDisplay, longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 3, f_dashboardSetupText(shortSetupDisplay, shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 4, "Z / E", color.white, panelCellBg)
    f_setCell(dashboard, 1, 4, "POI | trig", color.white, panelCellBg)
    f_setCell(dashboard, 2, 4, f_dashboardDetail(f_formatRange(tradeLongValidTop, tradeLongValidBottom) + " | " + f_formatLevel(tradeLongEntry), longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 4, f_dashboardDetail(f_formatRange(tradeShortValidTop, tradeShortValidBottom) + " | " + f_formatLevel(tradeShortEntry), shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 5, "SL / TP", color.white, panelCellBg)
    f_setCell(dashboard, 1, 5, f_dashboardMarketSummary(f_targetModeText(not na(activeLongTarget), longUsesExternalDolTarget, longTargetIsLiquidity), longDashboardRetired, f_targetModeText(not na(activeShortTarget), shortUsesExternalDolTarget, shortTargetIsLiquidity), shortDashboardRetired), color.white, panelCellBg)
    f_setCell(dashboard, 2, 5, f_dashboardDetail(f_formatLevel(tradeLongStop) + " | " + f_formatLevel(activeLongTarget), longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 5, f_dashboardDetail(f_formatLevel(tradeShortStop) + " | " + f_formatLevel(activeShortTarget), shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 6, "RR / Cf", color.white, panelCellBg)
    f_setCell(dashboard, 1, 6, "RR | conf", color.white, panelCellBg)
    f_setCell(dashboard, 2, 6, f_dashboardDetail(f_formatRr(longRr) + " | " + f_formatPercent(longConfidence), longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 6, f_dashboardDetail(f_formatRr(shortRr) + " | " + f_formatPercent(shortConfidence), shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 7, "Draw", color.white, panelCellBg)
    f_setCell(dashboard, 1, 7, "DOL", color.white, panelCellBg)
    f_setCell(dashboard, 2, 7, f_dashboardDetail(f_formatLevel(longDashboardDol), longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 7, f_dashboardDetail(f_formatLevel(shortDashboardDol), shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 8, "Life", color.white, panelCellBg)
    f_setCell(dashboard, 1, 8, "Age / touch", color.white, panelCellBg)
    f_setCell(dashboard, 2, 8, f_dashboardLifeText(f_lifecycleText(longSetupAge, tradeLongTouched), longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 8, f_dashboardLifeText(f_lifecycleText(shortSetupAge, tradeShortTouched), shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 9, "Sess/Cfm", color.white, panelCellBg)
    f_setCell(dashboard, 1, 9, liquiditySessionSummary + " | " + timezoneSummary + (strictModeEnabled ? " | Strict" : ""), color.white, color.new(strictModeEnabled ? color.teal : neutralColor, 15))
    f_setCell(dashboard, 2, 9, f_dashboardContextText(not na(tradeLongEntry) ? f_confirmationStateText(strictModeEnabled, strictLongSweepPass, strictLongMssPass, strictLongPdPass, strictLongOtePass, strictLongDolPass, strictLongKillzonePass, false) + " | " + f_setupPathText(true, tradeLongIsFvg, tradeLongIsOb, longUsesExternalDolTarget, false) : "-", longExecutionState, longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 9, f_dashboardContextText(not na(tradeShortEntry) ? f_confirmationStateText(strictModeEnabled, strictShortSweepPass, strictShortMssPass, strictShortPdPass, strictShortOtePass, strictShortDolPass, strictShortKillzonePass, false) + " | " + f_setupPathText(true, tradeShortIsFvg, tradeShortIsOb, shortUsesExternalDolTarget, false) : "-", shortExecutionState, shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 10, "Next", color.white, panelCellBg)
    f_setCell(dashboard, 1, 10, desktopModeStatus, color.white, panelCellBg)
    f_setCell(dashboard, 2, 10, not na(tradeLongEntry) ? f_entryActionText(longExecutionState) : f_eng1EntryActionText(effectiveLongDirectional, effectiveLongDirectional and effectiveLongSweepSeen and effectiveLongMssSeen and effectiveLongDisplacementSeen, true), color.white, panelBullBg)
    f_setCell(dashboard, 3, 10, not na(tradeShortEntry) ? f_entryActionText(shortExecutionState) : f_eng1EntryActionText(effectiveShortDirectional, effectiveShortDirectional and effectiveShortSweepSeen and effectiveShortMssSeen and effectiveShortDisplacementSeen, false), color.white, panelBearBg)
else if barstate.islast and showDashboard and compactDashboardMode
    table.clear(dashboard, 0, 0, 3, 10)
    f_setCell(dashboardCompact, 0, 0, "SMC Compact", color.white, panelHeaderBg)
    f_setCell(dashboardCompact, 1, 0, f_preferredExecutionText(preferredDirection, longExecutionState, shortExecutionState, true), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 1, "Biases", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 1, f_biasShort(displayExecBias) + "/" + ((eng1_exec_valid or htfContextReady) ? f_biasShort(displayCtxBias) : "Guard") + "/" + f_biasShort(displayNarrBias), color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 2, "Setup", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 2, compactBalanced ? "Both active" : compactWaiting and compactExecutionState == "Ambiguous" ? (compactUseLong ? f_dashboardSetupText(compactSetup, longDashboardRetired) : f_dashboardSetupText(compactSetup, shortDashboardRetired)) + " | Ambg" : compactWaiting and compactContextOnly and compactCandidateHasSetup and not compactCandidateRetired ? (compactUseLong ? f_dashboardSetupText(compactSetup, longDashboardRetired) : f_dashboardSetupText(compactSetup, shortDashboardRetired)) + " | Ctx" : compactWaiting ? "Scan both" : compactUseLong ? f_dashboardSetupText(compactSetup, longDashboardRetired) : f_dashboardSetupText(compactSetup, shortDashboardRetired), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 3, "Zone", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 3, compactNeutral ? "-" : compactUseLong ? f_dashboardDetail(f_formatRange(compactZoneTop, compactZoneBottom), longDashboardRetired) : f_dashboardDetail(f_formatRange(compactZoneTop, compactZoneBottom), shortDashboardRetired), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 4, "E / SL / TP", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 4, compactNeutral ? "-" : compactUseLong ? f_dashboardDetail(f_formatLevel(compactEntry) + " | " + f_formatLevel(compactStop) + " | " + f_formatLevel(compactTarget), longDashboardRetired) : f_dashboardDetail(f_formatLevel(compactEntry) + " | " + f_formatLevel(compactStop) + " | " + f_formatLevel(compactTarget), shortDashboardRetired), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 5, "Exec", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 5, compactBalanced ? "Mixed" : compactWaiting and compactExecutionState == "Ambiguous" ? f_executionStateCompact(compactExecutionState) : compactWaiting and compactContextOnly and compactCandidateHasSetup and not compactCandidateRetired ? "Ctx" : compactWaiting ? "Scan" : f_executionStateCompact(compactExecutionState), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 6, compactNeutral ? (compactContextOnly ? "Ctx L/S" : "Conf L/S") : "Conf", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 6, compactNeutral ? "L " + f_dashboardDetail(f_formatPercent(longConfidence), longDashboardRetired) + " / S " + f_dashboardDetail(f_formatPercent(shortConfidence), shortDashboardRetired) : compactUseLong ? f_dashboardDetail(f_formatPercent(compactConfidence), longDashboardRetired) : f_dashboardDetail(f_formatPercent(compactConfidence), shortDashboardRetired), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 7, "R / DOL", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 7, compactNeutral ? "-" : compactUseLong ? f_dashboardDetail(f_formatRr(compactRr) + " | " + f_formatLevel(primaryExternalDrawLevel), longDashboardRetired) : f_dashboardDetail(f_formatRr(compactRr) + " | " + f_formatLevel(primaryExternalDrawLevel), shortDashboardRetired), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 8, "Life", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 8, compactBalanced ? "Mixed" : compactWaiting and compactContextOnly and compactCandidateHasSetup and not compactCandidateRetired ? (compactUseLong ? f_dashboardLifeText(f_compactLifecycleText(compactUseLong, longSetupAge, tradeLongTouched, shortSetupAge, tradeShortTouched), longDashboardRetired) : f_dashboardLifeText(f_compactLifecycleText(compactUseLong, longSetupAge, tradeLongTouched, shortSetupAge, tradeShortTouched), shortDashboardRetired)) : compactWaiting ? "Scan" : compactUseLong ? f_dashboardLifeText(f_compactLifecycleText(compactUseLong, longSetupAge, tradeLongTouched, shortSetupAge, tradeShortTouched), longDashboardRetired) : f_dashboardLifeText(f_compactLifecycleText(compactUseLong, longSetupAge, tradeLongTouched, shortSetupAge, tradeShortTouched), shortDashboardRetired), color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 9, "Mode", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 9, compactModeStatus, color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 10, "Sessions", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 10, liquiditySessionSummary + " | " + timezoneSummary + (strictModeEnabled ? " | Strict" : ""), color.white, panelCellBg)
else if barstate.islast and not showDashboard
    table.clear(dashboardCompact, 0, 0, 1, 10)
    table.clear(dashboard, 0, 0, 3, 14)
