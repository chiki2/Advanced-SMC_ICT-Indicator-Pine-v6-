f_eng1_select_narrative_snapshot(string tf) =>
    int narrBias = 0
    float narrLiqHigh = na
    float narrLiqLow = na
    float narrBullSdTop = na
    float narrBullSdBottom = na
    int narrBullSdBar = na
    float narrBearSdTop = na
    float narrBearSdBottom = na
    int narrBearSdBar = na
    string narrStrength = "Flat"
    if tf == ENG1_TF_H1
        narrBias := eng1_h1_trend_bias
        narrLiqHigh := eng1_h1_eqh_active ? eng1_h1_eqh : eng1_h1_last_swing_high
        narrLiqLow := eng1_h1_eql_active ? eng1_h1_eql : eng1_h1_last_swing_low
        narrBullSdTop := eng1_h1_bull_ob_top
        narrBullSdBottom := eng1_h1_bull_ob_bottom
        narrBullSdBar := eng1_h1_bull_ob_bar
        narrBearSdTop := eng1_h1_bear_ob_top
        narrBearSdBottom := eng1_h1_bear_ob_bottom
        narrBearSdBar := eng1_h1_bear_ob_bar
        narrStrength := f_eng1_regime_strength_from_buffer(narrBias, eng1_buf_h1_close, eng1_buf_h1_high, eng1_buf_h1_low)
    else if tf == ENG1_TF_H4
        narrBias := eng1_h4_trend_bias
        narrLiqHigh := eng1_h4_eqh_active ? eng1_h4_eqh : eng1_h4_last_swing_high
        narrLiqLow := eng1_h4_eql_active ? eng1_h4_eql : eng1_h4_last_swing_low
        narrBullSdTop := eng1_h4_bull_ob_top
        narrBullSdBottom := eng1_h4_bull_ob_bottom
        narrBullSdBar := eng1_h4_bull_ob_bar
        narrBearSdTop := eng1_h4_bear_ob_top
        narrBearSdBottom := eng1_h4_bear_ob_bottom
        narrBearSdBar := eng1_h4_bear_ob_bar
        narrStrength := f_eng1_regime_strength_from_buffer(narrBias, eng1_buf_h4_close, eng1_buf_h4_high, eng1_buf_h4_low)
    else if tf == ENG1_TF_D1
        narrBias := eng1_d1_trend_bias
        narrLiqHigh := eng1_d1_eqh_active ? eng1_d1_eqh : eng1_d1_last_swing_high
        narrLiqLow := eng1_d1_eql_active ? eng1_d1_eql : eng1_d1_last_swing_low
        narrBullSdTop := eng1_d1_bull_ob_top
        narrBullSdBottom := eng1_d1_bull_ob_bottom
        narrBullSdBar := eng1_d1_bull_ob_bar
        narrBearSdTop := eng1_d1_bear_ob_top
        narrBearSdBottom := eng1_d1_bear_ob_bottom
        narrBearSdBar := eng1_d1_bear_ob_bar
        narrStrength := f_eng1_regime_strength_from_buffer(narrBias, eng1_buf_d1_close, eng1_buf_d1_high, eng1_buf_d1_low)
    bool narrNeedsFallback = na(narrLiqHigh) or na(narrLiqLow) or narrLiqHigh <= narrLiqLow
    if narrNeedsFallback
        [fallbackHigh, fallbackLow] = f_eng1_fallback_window_range(tf, 60)
        narrLiqHigh := fallbackHigh
        narrLiqLow := fallbackLow
    [narrBias, narrLiqHigh, narrLiqLow, narrBullSdTop, narrBullSdBottom, narrBullSdBar, narrBearSdTop, narrBearSdBottom, narrBearSdBar, narrStrength]

