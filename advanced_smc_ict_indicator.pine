        ctxBullFvgBottom := eng1_h1_bull_fvg_bottom
        ctxBullFvgBar := eng1_h1_bull_fvg_bar
        ctxBearObTop := eng1_h1_bear_ob_top
        ctxBearObBottom := eng1_h1_bear_ob_bottom
