    eng1_ctx_bull_ob_bar := eng1_h4_bull_ob_bar
    eng1_ctx_bull_fvg_top := eng1_h4_bull_fvg_top
    eng1_ctx_bull_fvg_bottom := eng1_h4_bull_fvg_bottom
