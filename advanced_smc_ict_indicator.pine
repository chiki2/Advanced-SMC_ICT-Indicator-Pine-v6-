targetEqLow = f_preferredLevelMatch(activeEql, compactBalanced, compactUseLong, activeLongTarget, activeShortTarget)
showEqHighVisual = showLiquidity and displayEqLiquidity and f_targetVisualByMode(effectiveZoneDisplayMode, targetEqHigh)
showEqLowVisual = showLiquidity and displayEqLiquidity and f_targetVisualByMode(effectiveZoneDisplayMode, targetEqLow)
showProtectedHighVisual = displayProtectedLevels and not na(protectedHigh)
showProtectedLowVisual = displayProtectedLevels and not na(protectedLow)
showRangeVisual = showLiquidity and displayDealingRange and f_contextVisualByMode(effectiveZoneDisplayMode)
showOteVisual = strictShowOte and effectiveZoneDisplayMode != "Minimal"
oteActiveSummary = not na(oteLongTop) ? "OTE:L" : not na(oteShortTop) ? "OTE:S" : "OTE:-"
string desktopModeStatus = effectiveModeSummary + " | " + mtfSummary + " | " + oteActiveSummary
string compactModeStatus = presetLabel + " | " + effectiveModeSummary + " | " + mtfSummary + " | " + oteActiveSummary
showHtfHighVisual = displayHtfLines and htfContextReady and not na(htfStructureHigh)
showHtfLowVisual = displayHtfLines and htfContextReady and not na(htfStructureLow)
showLongRiskVisual = displayRiskLines and f_executionVisualByMode(effectiveZoneDisplayMode, f_executionRiskVisible(longExecutionState), preferredDirection, true, compactUseLong)
showShortRiskVisual = displayRiskLines and f_executionVisualByMode(effectiveZoneDisplayMode, f_executionRiskVisible(shortExecutionState), preferredDirection, false, compactUseLong)

if effectiveZoneDisplayMode != "Full"
    showEqHighVisual := f_uniqueLevelVisual(showEqHighVisual, activeEqh, showHtfHighVisual, htfStructureHigh, false, na, false, na, false, na, false, na)
    showEqLowVisual := f_uniqueLevelVisual(showEqLowVisual, activeEql, showHtfLowVisual, htfStructureLow, false, na, false, na, false, na, false, na)

//------------------------------------------------------------------------------
// Plots
//------------------------------------------------------------------------------
eqHighLevel = f_horizontalLevel(activeEqh, showEqHighVisual)
eqLowLevel = f_horizontalLevel(activeEql, showEqLowVisual)
protectedHighLevel = f_horizontalLevel(protectedHigh, showProtectedHighVisual)
protectedLowLevel = f_horizontalLevel(protectedLow, showProtectedLowVisual)
internalHighLevel = f_horizontalLevel(activeRangeHigh, showRangeVisual)
internalLowLevel = f_horizontalLevel(activeRangeLow, showRangeVisual)
internalEqLevel = f_horizontalLevel(activeRangeEquilibrium, showRangeVisual)
htfStructureHighLevel = f_horizontalLevel(htfStructureHigh, showHtfHighVisual)
htfStructureLowLevel = f_horizontalLevel(htfStructureLow, showHtfLowVisual)
riskLongEntryLevel = f_horizontalLevel(tradeLongEntry, showLongRiskVisual)
riskShortEntryLevel = f_horizontalLevel(tradeShortEntry, showShortRiskVisual)
riskBullStopLevel = f_horizontalLevel(bullStop, showLongRiskVisual)
riskBearStopLevel = f_horizontalLevel(bearStop, showShortRiskVisual)
riskLongTargetLevel = f_horizontalLevel(activeLongTarget, showLongRiskVisual)
riskShortTargetLevel = f_horizontalLevel(activeShortTarget, showShortRiskVisual)
oteLongTopLevel = f_horizontalLevel(oteLongTop, showOteVisual)
oteLongBottomLevel = f_horizontalLevel(oteLongBottom, showOteVisual)
oteShortTopLevel = f_horizontalLevel(oteShortTop, showOteVisual)
oteShortBottomLevel = f_horizontalLevel(oteShortBottom, showOteVisual)
oteLongMid = not na(oteLongTop) and not na(oteLongBottom) ? f_zoneMid(oteLongTop, oteLongBottom) : na
oteShortMid = not na(oteShortTop) and not na(oteShortBottom) ? f_zoneMid(oteShortTop, oteShortBottom) : na
oteLongMidLevel = not na(oteLongTopLevel) and not na(oteLongBottomLevel) ? f_zoneMid(oteLongTopLevel, oteLongBottomLevel) : na
oteShortMidLevel = not na(oteShortTopLevel) and not na(oteShortBottomLevel) ? f_zoneMid(oteShortTopLevel, oteShortBottomLevel) : na
rightEdgeLabelTolerance = atr * 0.15
showShortStopRightLabel = displayLiquidityRightLabels and showShortRiskVisual and not na(riskBearStopLevel)
showLongStopRightLabel = displayLiquidityRightLabels and showLongRiskVisual and not na(riskBullStopLevel)
showHtfHighRightLabel = displayLiquidityRightLabels and showHtfHighVisual and not f_levelsClose(htfStructureHighLevel, riskBearStopLevel, rightEdgeLabelTolerance)
showHtfLowRightLabel = displayLiquidityRightLabels and showHtfLowVisual and not f_levelsClose(htfStructureLowLevel, riskBullStopLevel, rightEdgeLabelTolerance)
showProtectedHighRightLabel = displayLiquidityRightLabels and showProtectedHighVisual and not f_levelsClose(protectedHighLevel, riskBearStopLevel, rightEdgeLabelTolerance) and not f_levelsClose(protectedHighLevel, htfStructureHighLevel, rightEdgeLabelTolerance)
showProtectedLowRightLabel = displayLiquidityRightLabels and showProtectedLowVisual and not f_levelsClose(protectedLowLevel, riskBullStopLevel, rightEdgeLabelTolerance) and not f_levelsClose(protectedLowLevel, htfStructureLowLevel, rightEdgeLabelTolerance)

plotEqHigh = plot(eqHighLevel, "EQH Liquidity", color=color.new(liqHighColor, 12), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plotEqLow = plot(eqLowLevel, "EQL Liquidity", color=color.new(liqLowColor, 12), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)

protectedHighPlot = plot(protectedHighLevel, "Protected High", color=color.new(liqHighColor, 8), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
protectedLowPlot = plot(protectedLowLevel, "Protected Low", color=color.new(liqLowColor, 8), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)

internalHighPlot = plot(internalHighLevel, "ICT Dealing Range High", color=color.new(color.silver, 35), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
internalLowPlot = plot(internalLowLevel, "ICT Dealing Range Low", color=color.new(color.silver, 35), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
internalEqPlot = plot(internalEqLevel, "ICT Equilibrium", color=decisionEqColor, linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
fill(internalHighPlot, internalEqPlot, color=showRangeVisual ? decisionPremiumFillColor : na)
fill(internalEqPlot, internalLowPlot, color=showRangeVisual ? decisionDiscountFillColor : na)

if barstate.islast
    protectedHighLabel := f_syncRightEdgeLabel(protectedHighLabel, protectedHighLevel, "Prot H", color.new(liqHighColor, 8), color.white, showProtectedHighRightLabel)
    protectedLowLabel := f_syncRightEdgeLabel(protectedLowLabel, protectedLowLevel, "Prot L", color.new(liqLowColor, 8), color.white, showProtectedLowRightLabel)
    htfHighLabel := f_syncRightEdgeLabel(htfHighLabel, htfStructureHighLevel, "HTF H", color.new(color.fuchsia, 15), color.white, showHtfHighRightLabel)
    htfLowLabel := f_syncRightEdgeLabel(htfLowLabel, htfStructureLowLevel, "HTF L", color.new(color.fuchsia, 15), color.white, showHtfLowRightLabel)
    longStopLabel := f_syncRightEdgeLabel(longStopLabel, riskBullStopLevel, "SL L", color.new(bearColor, 0), color.white, showLongStopRightLabel)
    shortStopLabel := f_syncRightEdgeLabel(shortStopLabel, riskBearStopLevel, "SL S", color.new(bullColor, 0), color.white, showShortStopRightLabel)

oteLongTopPlot = plot(oteLongTopLevel, "OTE Long Top", color=color.new(bullColor, 40), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
oteLongBottomPlot = plot(oteLongBottomLevel, "OTE Long Bottom", color=color.new(bullColor, 40), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
oteShortTopPlot = plot(oteShortTopLevel, "OTE Short Top", color=color.new(bearColor, 40), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
oteShortBottomPlot = plot(oteShortBottomLevel, "OTE Short Bottom", color=color.new(bearColor, 40), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
fill(oteLongTopPlot, oteLongBottomPlot, color=showOteVisual ? color.new(bullColor, 92) : na)
fill(oteShortTopPlot, oteShortBottomPlot, color=showOteVisual ? color.new(bearColor, 92) : na)

plot(htfStructureHighLevel, "HTF Structure High", color=color.new(color.fuchsia, 15), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
plot(htfStructureLowLevel, "HTF Structure Low", color=color.new(color.fuchsia, 15), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)

plot(riskLongEntryLevel, "Bullish Entry Cue", color=color.new(bullColor, 0), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskShortEntryLevel, "Bearish Entry Cue", color=color.new(bearColor, 0), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskBullStopLevel, "Bullish Stop Cue", color=color.new(bearColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskBearStopLevel, "Bearish Stop Cue", color=color.new(bullColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskLongTargetLevel, "Bullish TP Cue", color=color.new(liqHighColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskShortTargetLevel, "Bearish TP Cue", color=color.new(liqLowColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)

chartBackdrop = displayTrendBackground ? color.new(activeBias == 1 ? bullColor : activeBias == -1 ? bearColor : neutralColor, 93) : na
bgcolor(chartBackdrop)

//------------------------------------------------------------------------------
// Dashboard
//------------------------------------------------------------------------------
var table dashboard = table.new(position.top_right, 4, 15, border_width=1)
var table dashboardCompact = table.new(position.bottom_right, 2, 11, border_width=1)

if barstate.islast and showDashboard and not compactDashboardMode
    table.clear(dashboardCompact, 0, 0, 1, 10)
    f_setCell(dashboard, 0, 0, "Field", color.white, panelHeaderBg)
    f_setCell(dashboard, 1, 0, "Market", color.white, panelHeaderBg)
    f_setCell(dashboard, 2, 0, "Long", color.white, color.new(bullColor, 5))
    f_setCell(dashboard, 3, 0, "Short", color.white, color.new(bearColor, 5))

    f_setCell(dashboard, 0, 1, "Exec", color.white, panelCellBg)
    f_setCell(dashboard, 1, 1, "Px " + f_formatLevel(close), color.white, panelCellBg)
    f_setCell(dashboard, 2, 1, longExecutionState, color.white, panelBullBg)
    f_setCell(dashboard, 3, 1, shortExecutionState, color.white, panelBearBg)

    f_setCell(dashboard, 0, 2, "Bias", color.white, panelCellBg)
    f_setCell(dashboard, 1, 2, f_biasSummary(activeBias, htfContextReady, htfBias, narrativeRegimeBias, regimeStrength), color.white, panelCellBg)
    f_setCell(dashboard, 2, 2, (htfContextReady ? f_alignmentShortText(true, activeBias, htfBias) : "G") + " / " + f_regimeSideShortText(true, narrativeRegimeBias, regimeStrength), color.white, panelBullBg)
    f_setCell(dashboard, 3, 2, (htfContextReady ? f_alignmentShortText(false, activeBias, htfBias) : "G") + " / " + f_regimeSideShortText(false, narrativeRegimeBias, regimeStrength), color.white, panelBearBg)

    f_setCell(dashboard, 0, 3, "Pref", color.white, panelCellBg)
    f_setCell(dashboard, 1, 3, preferredExecutionSummary, color.white, color.new(preferredDirection == "Long" ? bullColor : preferredDirection == "Short" ? bearColor : neutralColor, 15))
    f_setCell(dashboard, 2, 3, longDashboardSetupDisplay, color.white, panelBullBg)
    f_setCell(dashboard, 3, 3, shortDashboardSetupDisplay, color.white, panelBearBg)

    f_setCell(dashboard, 0, 4, "Z / E", color.white, panelCellBg)
    f_setCell(dashboard, 1, 4, "POI | trig", color.white, panelCellBg)
    f_setCell(dashboard, 2, 4, longZoneEntrySummary, color.white, panelBullBg)
    f_setCell(dashboard, 3, 4, shortZoneEntrySummary, color.white, panelBearBg)

    f_setCell(dashboard, 0, 5, "SL / TP", color.white, panelCellBg)
    f_setCell(dashboard, 1, 5, opTargetSummary, color.white, panelCellBg)
    f_setCell(dashboard, 2, 5, longRiskTargetSummary, color.white, panelBullBg)
    f_setCell(dashboard, 3, 5, shortRiskTargetSummary, color.white, panelBearBg)

    f_setCell(dashboard, 0, 6, "RR / Cf", color.white, panelCellBg)
    f_setCell(dashboard, 1, 6, "RR | conf", color.white, panelCellBg)
    f_setCell(dashboard, 2, 6, longRrConfSummary, color.white, panelBullBg)
    f_setCell(dashboard, 3, 6, shortRrConfSummary, color.white, panelBearBg)

    f_setCell(dashboard, 0, 7, "Draw", color.white, panelCellBg)
    f_setCell(dashboard, 1, 7, "DOL", color.white, panelCellBg)
    f_setCell(dashboard, 2, 7, longDrawTpSummary, color.white, panelBullBg)
    f_setCell(dashboard, 3, 7, shortDrawTpSummary, color.white, panelBearBg)

    f_setCell(dashboard, 0, 8, "Life", color.white, panelCellBg)
    f_setCell(dashboard, 1, 8, "Age / touch", color.white, panelCellBg)
    f_setCell(dashboard, 2, 8, longLifeSummary, color.white, panelBullBg)
    f_setCell(dashboard, 3, 8, shortLifeSummary, color.white, panelBearBg)

    f_setCell(dashboard, 0, 9, "Sess/Cfm", color.white, panelCellBg)
    f_setCell(dashboard, 1, 9, sessionConfirmMarketSummary, color.white, color.new(strictModeEnabled ? color.teal : neutralColor, 15))
    f_setCell(dashboard, 2, 9, longSessionConfirmSummary, color.white, panelBullBg)
    f_setCell(dashboard, 3, 9, shortSessionConfirmSummary, color.white, panelBearBg)

    f_setCell(dashboard, 0, 10, "Next", color.white, panelCellBg)
    f_setCell(dashboard, 1, 10, desktopModeStatus, color.white, panelCellBg)
    f_setCell(dashboard, 2, 10, f_entryActionText(longExecutionState), color.white, panelBullBg)
    f_setCell(dashboard, 3, 10, f_entryActionText(shortExecutionState), color.white, panelBearBg)
else if barstate.islast and showDashboard and compactDashboardMode
    table.clear(dashboard, 0, 0, 3, 10)
    f_setCell(dashboardCompact, 0, 0, "SMC Compact", color.white, panelHeaderBg)
    f_setCell(dashboardCompact, 1, 0, compactPreferredSummary, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 1, "Biases", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 1, f_biasShort(activeBias) + "/" + (htfContextReady ? f_biasShort(htfBias) : "Guard") + "/" + f_biasShort(narrativeRegimeBias), color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 2, "Setup", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 2, compactSetupDisplay, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 3, "Zone", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 3, compactZoneDisplay, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 4, "E / SL / TP", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 4, compactEntryTriplet, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 5, "Exec", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 5, compactStatusDisplay, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 6, compactMetricLabel, color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 6, compactMetricDisplay, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 7, "R / DOL", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 7, compactRrDrawDisplay, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 8, "Life", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 8, compactLifecycleDisplay, color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 9, "Mode", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 9, compactModeStatus, color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 10, "Sessions", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 10, sessionConfirmMarketSummary, color.white, panelCellBg)
else if barstate.islast and not showDashboard
    table.clear(dashboardCompact, 0, 0, 1, 10)
    table.clear(dashboard, 0, 0, 3, 14)
