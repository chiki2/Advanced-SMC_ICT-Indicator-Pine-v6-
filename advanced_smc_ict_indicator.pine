f_eng1_select_execution_levels(string tf) =>
    float exeLiqHigh = na
    float exeLiqLow = na
    if tf == ENG1_TF_M1
        exeLiqHigh := eng1_m1_eqh_active ? eng1_m1_eqh : eng1_m1_last_swing_high
        exeLiqLow := eng1_m1_eql_active ? eng1_m1_eql : eng1_m1_last_swing_low
    else if tf == ENG1_TF_M5
        exeLiqHigh := eng1_m5_eqh_active ? eng1_m5_eqh : eng1_m5_last_swing_high
        exeLiqLow := eng1_m5_eql_active ? eng1_m5_eql : eng1_m5_last_swing_low
    else if tf == ENG1_TF_M15
        exeLiqHigh := eng1_m15_eqh_active ? eng1_m15_eqh : eng1_m15_last_swing_high
        exeLiqLow := eng1_m15_eql_active ? eng1_m15_eql : eng1_m15_last_swing_low
    else if tf == ENG1_TF_M30
        exeLiqHigh := eng1_m30_eqh_active ? eng1_m30_eqh : eng1_m30_last_swing_high
        exeLiqLow := eng1_m30_eql_active ? eng1_m30_eql : eng1_m30_last_swing_low
