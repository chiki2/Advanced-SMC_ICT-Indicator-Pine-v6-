    eng1_ctx_bear_ob_top := eng1_h4_bear_ob_top
    eng1_ctx_bear_ob_bottom := eng1_h4_bear_ob_bottom
    eng1_ctx_bear_ob_entry := eng1_h4_bear_ob_entry
    eng1_ctx_bear_ob_bar := eng1_h4_bear_ob_bar
    eng1_ctx_bear_fvg_top := eng1_h4_bear_fvg_top
    eng1_ctx_bear_fvg_bottom := eng1_h4_bear_fvg_bottom
    eng1_ctx_bear_fvg_bar := eng1_h4_bear_fvg_bar
    eng1_ctx_liq_high := eng1_h4_eqh_active ? eng1_h4_eqh : eng1_h4_last_swing_high
    eng1_ctx_liq_low := eng1_h4_eql_active ? eng1_h4_eql : eng1_h4_last_swing_low
    eng1_ctx_liq_high_bar := eng1_h4_eqh_active ? eng1_h4_eqh_bar : eng1_h4_last_swing_high_bar
    eng1_ctx_liq_low_bar := eng1_h4_eql_active ? eng1_h4_eql_bar : eng1_h4_last_swing_low_bar
else if eng1_ctx_tf == ENG1_TF_D1
    eng1_ctx_trend_bias := eng1_d1_trend_bias
    eng1_ctx_bull_reversal := eng1_d1_bull_ob_breaker
    eng1_ctx_bear_reversal := eng1_d1_bear_ob_breaker
    eng1_ctx_bull_ob_breaker := eng1_d1_bull_ob_breaker
    eng1_ctx_bear_ob_breaker := eng1_d1_bear_ob_breaker
