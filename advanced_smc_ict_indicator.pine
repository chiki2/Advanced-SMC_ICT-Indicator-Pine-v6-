[eng1_m30_new_closed_bar_tmp, eng1_m30_last_closed_time_tmp] = f_eng1_update_ohlc_buffer(eng1_m30_active_tf, ENG1_TF_M30, eng1_m30_last_closed_time, eng1_buf_m30_time, eng1_buf_m30_open, eng1_buf_m30_high, eng1_buf_m30_low, eng1_buf_m30_close, ENG1_BUF_CAP)
[eng1_h1_new_closed_bar_tmp, eng1_h1_last_closed_time_tmp] = f_eng1_update_ohlc_buffer(eng1_h1_active_tf, ENG1_TF_H1, eng1_h1_last_closed_time, eng1_buf_h1_time, eng1_buf_h1_open, eng1_buf_h1_high, eng1_buf_h1_low, eng1_buf_h1_close, ENG1_BUF_CAP)
