//@version=6
indicator("Advanced SMC / ICT Indicator", shorttitle="Advanced SMC/ICT", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
groupPreset = "0. Presets"
usagePreset = input.string("Custom", "Usage preset", options=["Custom", "Intraday", "Android", "Strict ICT"], group=groupPreset)

groupStructure = "1. Market Structure"
showStructureLabels = input.bool(true, "Show HH / HL / LL / LH labels", group=groupStructure)
showBosChoch = input.bool(true, "Show BOS / CHOCH markers", group=groupStructure)
showIdm = input.bool(true, "Show inducement markers", group=groupStructure)
showTrendBackground = input.bool(true, "Tint background by current bias", group=groupStructure)
int swingLen = 3
int consolidationBars = 18
string breakMode = "Close Through"
int engineDisplacementLookback = 10

groupLiquidity = "2. Liquidity"
showLiquidity = input.bool(true, "Show liquidity pools", group=groupLiquidity)
showPrevSession = input.bool(true, "Show previous source high / low", group=groupLiquidity)
showHigherPeriodLiquidity = input.bool(true, "Show previous day / week / month high / low", group=groupLiquidity)
showInternalRange = input.bool(true, "Show internal range liquidity", group=groupLiquidity)
showSweeps = input.bool(true, "Show liquidity sweep markers", group=groupLiquidity)
string liquiditySessionMode = "Auto ICT"
string ictSessionTimezone = "America/New_York"
string asiaSessionWindow = "2000-0000"
string londonSessionWindow = "0100-0700"
string nyAmSessionWindow = "0700-1300"
string nyPmSessionWindow = "1300-1600"
// Keep engine liquidity families aligned with their visible source toggles.
bool usePrevSessionInEngine = showPrevSession
bool useHigherPeriodLiquidityInEngine = showHigherPeriodLiquidity
float equalToleranceAtr = 0.10

groupOb = "3. Order Blocks / Breakers"
showOb = input.bool(true, "Show order blocks", group=groupOb)
int obSearchBars = 12
int obValidationLookback = 8
float obImpulseAtr = 1.00
string obZoneMode = "Open-to-Wick"
string obEntryMode = "Midpoint"
int maxObZones = 12

groupFvg = "4. Fair Value Gaps"
showFvg = input.bool(true, "Show fair value gaps", group=groupFvg)
float fvgMinAtr = 0.15
int maxFvgZones = 16

groupHtf = "5. Higher Timeframe Context"
showHtf = input.bool(true, "Show higher timeframe structure", group=groupHtf)
bool stopOnInvalidTf = true
int htfSwingLen = 2

groupRisk = "6. Risk Cues"
showRisk = input.bool(false, "Show stop cues", group=groupRisk)
float stopAtrBuffer = 0.10

groupLifecycle = "7. Setup Lifecycle"
int setupFreshBars = 6
int setupExpiryBars = 25
float setupChaseAtr = 1.50
float setupManagedR = 1.00

groupStrict = "8. Strict ICT Entry"
strictIctMode = input.bool(false, "Enable Strict ICT Entry mode", group=groupStrict)
strictShowOte = input.bool(true, "Show OTE zone overlay", group=groupStrict)
string strictKillzoneSession = "0200-0500,0700-1000,1300-1600"
int strictMssLookback = 10

groupStyle = "9. Style"
showDashboard = input.bool(true, "Show context dashboard", group=groupStyle)
showProtectedLevels = input.bool(true, "Show protected high / low", group=groupStyle)
showKillzoneVisual = input.bool(true, "Shade killzone on chart", group=groupStyle)
showLiquidityRightLabels = input.bool(true, "Show right-edge liquidity labels", group=groupStyle)
zoneDisplayMode = input.string("Full", "Zone display mode", options=["Full", "Focused", "Minimal"], group=groupStyle)

groupMobile = "10. Mobile / Android"
androidCompactMode = input.bool(false, "Android compact mode", group=groupMobile)
bool mobileCompactDashboard = true
bool mobileCompactLabels = true
bool mobileHideStructureLabels = true
bool mobileHideSecondaryLiquidity = true
bool mobileHideEqLiquidity = true
bool mobileHideInternalRange = true
bool mobileHideLiquidityRightLabels = true
bool mobileHideHtfLines = true
bool mobileHideRiskLines = true
bool mobileHideTrendBackground = true
bool mobileHideKillzoneVisual = true

//------------------------------------------------------------------------------
// Styling and helpers
//------------------------------------------------------------------------------
bullColor = color.rgb(15, 156, 119)
bearColor = color.rgb(201, 76, 76)
neutralColor = color.rgb(128, 128, 128)
liqHighColor = color.rgb(44, 120, 200)
liqLowColor = color.rgb(230, 145, 56)
panelHeaderBg = color.new(color.black, 0)
panelCellBg = color.new(color.black, 10)
panelBullBg = color.new(bullColor, 20)
panelBearBg = color.new(bearColor, 20)
fvgBullColor = color.new(color.rgb(33, 150, 120), 82)
fvgBearColor = color.new(color.rgb(206, 81, 81), 82)
obBullColor = color.new(color.rgb(33, 150, 120), 82)
obBearColor = color.new(color.rgb(206, 81, 81), 82)
bbBullColor = color.new(color.rgb(33, 100, 180), 80)
bbBearColor = color.new(color.rgb(180, 110, 33), 80)
overlayLineDisplay = display.all - display.price_scale - display.status_line

atr = ta.atr(14)
bodyHigh = math.max(open, close)
bodyLow = math.min(open, close)
equalTolerance = atr * equalToleranceAtr
presetIntraday = usagePreset == "Intraday"
presetAndroid = usagePreset == "Android"
presetStrict = usagePreset == "Strict ICT"
presetLabel = usagePreset
strictModeEnabled = presetStrict or strictIctMode
compactMode = presetAndroid or androidCompactMode
compactDashboardMode = compactMode and (presetAndroid or mobileCompactDashboard)
dashboardEnabled = presetIntraday or presetAndroid or presetStrict ? true : showDashboard
showHtfEffective = presetIntraday or presetStrict ? true : showHtf
showRiskEffective = presetAndroid ? false : showRisk
showProtectedLevelsEffective = showProtectedLevels
showLiquidityRightLabelsEffective = presetAndroid ? false : showLiquidityRightLabels
showKillzoneVisualEffective = presetStrict ? true : showKillzoneVisual
showOteEffective = strictShowOte
displayStructureLabels = showStructureLabels and not (compactMode and mobileHideStructureLabels)
displayInternalRange = showInternalRange and not (compactMode and mobileHideInternalRange)
displayEqLiquidity = showLiquidity and not (compactMode and mobileHideEqLiquidity)
displaySweepMarkers = showLiquidity and showSweeps
displayTrendBackground = showTrendBackground and not (compactMode and mobileHideTrendBackground)
displayWeekMonthLiquidity = showHigherPeriodLiquidity and not (compactMode and mobileHideSecondaryLiquidity)
displayProtectedLevels = showProtectedLevelsEffective
displayDealingRange = displayInternalRange
displayLiquidityRightLabels = showLiquidityRightLabelsEffective and not (compactMode and mobileHideLiquidityRightLabels)
displayHtfLines = showHtfEffective and not (compactMode and mobileHideHtfLines)
displayRiskLines = showRiskEffective and not (compactMode and mobileHideRiskLines)
displayKillzoneVisual = showKillzoneVisualEffective and not (compactMode and mobileHideKillzoneVisual)
effectiveZoneDisplayMode = presetAndroid ? "Minimal" : (presetIntraday or presetStrict ? "Focused" : zoneDisplayMode)
maxStructureEventObjects = 80
maxPivotLabelObjects = 160

//------------------------------------------------------------------------------
// Stateful arrays for FVG / OB tracking
//------------------------------------------------------------------------------
var box[] fvgBoxes = array.new_box()
var float[] fvgTops = array.new_float()
var float[] fvgBottoms = array.new_float()
var bool[] fvgBull = array.new_bool()
var label[] fvgLabels = array.new_label()
var int[] fvgCreatedBars = array.new_int()
var bool[] fvgTouched = array.new_bool()

var box[] obBoxes = array.new_box()
var line[] obEntryLines = array.new_line()
var float[] obTops = array.new_float()
var float[] obBottoms = array.new_float()
var bool[] obBull = array.new_bool()
var bool[] obBreaker = array.new_bool()
var bool[] obFailed = array.new_bool()
var label[] obLabels = array.new_label()
var int[] obCreatedBars = array.new_int()
var bool[] obTouched = array.new_bool()
var float[] obEntries = array.new_float()
var int[] obFailureBars = array.new_int()
var int[] obLeftBars = array.new_int()
var float[] obOriginOpens = array.new_float()
var float[] obOriginHighs = array.new_float()
var float[] obOriginLows = array.new_float()
var line[] structureEventLines = array.new_line()
var label[] structureEventLabels = array.new_label()
var bool[] structureEventBull = array.new_bool()
var label[] pivotStructureLabels = array.new_label()
var bool[] pivotStructureIsHigh = array.new_bool()
var label prevSessionHighLabel = na
var label prevSessionLowLabel = na
var label prevDayHighLabel = na
var label prevDayLowLabel = na
var label prevWeekHighLabel = na
var label prevWeekLowLabel = na
var label prevMonthHighLabel = na
var label prevMonthLowLabel = na
var label eqHighLabel = na
var label eqLowLabel = na
var label protectedHighLabel = na
var label protectedLowLabel = na
var label internalHighLabel = na
var label internalLowLabel = na
var label internalEqLabel = na
var label oteLongLabel = na
var label oteShortLabel = na
var label htfHighLabel = na
var label htfLowLabel = na

f_breakUp(float level) =>
    breakMode == "Full Body Through" ? bodyLow > level : close > level

f_breakDown(float level) =>
    breakMode == "Full Body Through" ? bodyHigh < level : close < level

f_biasText(int bias) =>
    bias == 1 ? "Bullish" : bias == -1 ? "Bearish" : "Consolidation"

f_biasShort(int bias) =>
    bias == 1 ? "Bull" : bias == -1 ? "Bear" : "Range"

f_zoneMid(float zoneTop, float zoneBottom) =>
    (zoneTop + zoneBottom) * 0.5

f_fvgLabelText(bool isBull) =>
    compactMode and mobileCompactLabels ? (isBull ? "FVG+" : "FVG-") : (isBull ? "Bullish FVG" : "Bearish FVG")

f_obLabelText(bool isBull, bool isBreaker) =>
    compactMode and mobileCompactLabels ? (isBreaker ? (isBull ? "BRK+" : "BRK-") : (isBull ? "OB+" : "OB-")) : (isBreaker ? (isBull ? "Bullish Breaker" : "Bearish Breaker") : (isBull ? "Bullish OB" : "Bearish OB"))

f_formatLevel(float price) =>
    na(price) ? "-" : str.tostring(price, format.mintick)

f_levelMatches(float referenceLevel, float candidate) =>
    not na(referenceLevel) and not na(candidate) and math.abs(referenceLevel - candidate) <= syminfo.mintick * 0.5

f_uniqueLevelVisual(bool visible, float level, bool prior1Visible, float prior1, bool prior2Visible, float prior2, bool prior3Visible, float prior3, bool prior4Visible, float prior4, bool prior5Visible, float prior5) =>
    visible and not ((prior1Visible and f_levelMatches(level, prior1)) or (prior2Visible and f_levelMatches(level, prior2)) or (prior3Visible and f_levelMatches(level, prior3)) or (prior4Visible and f_levelMatches(level, prior4)) or (prior5Visible and f_levelMatches(level, prior5)))

f_preferredLevelMatch(float candidate, bool balancedState, bool useLongPreference, float longLevel, float shortLevel) =>
    balancedState ? (f_levelMatches(longLevel, candidate) or f_levelMatches(shortLevel, candidate)) : f_levelMatches(useLongPreference ? longLevel : shortLevel, candidate)

f_selectAbove(float base, float best, float candidate) =>
    float result = best
    if not na(base) and not na(candidate) and candidate > base
        if na(result) or candidate < result
            result := candidate
    result

f_selectBelow(float base, float best, float candidate) =>
    float result = best
    if not na(base) and not na(candidate) and candidate < base
        if na(result) or candidate > result
            result := candidate
    result

f_clamp(float value, float minValue, float maxValue) =>
    math.max(minValue, math.min(maxValue, value))

f_formatRange(float zoneTop, float zoneBottom) =>
    na(zoneTop) or na(zoneBottom) ? "-" : str.tostring(zoneBottom, format.mintick) + " - " + str.tostring(zoneTop, format.mintick)

f_formatPercent(float value) =>
    na(value) ? "-" : str.tostring(math.round(value)) + "%"

f_formatRr(float rr) =>
    na(rr) ? "-" : str.tostring(math.round(rr * 100.0) / 100.0) + "R"

f_alignmentText(bool isBull, int ltfBias, int higherBias) =>
    if isBull
        ltfBias == 1 and higherBias == 1 ? "Strong" : ltfBias == 1 or higherBias == 1 ? "Mixed" : "Counter"
    else
        ltfBias == -1 and higherBias == -1 ? "Strong" : ltfBias == -1 or higherBias == -1 ? "Mixed" : "Counter"

f_statusCompact(string statusText) =>
    statusText == "Valid now" ? "Valid" : statusText == "Strict Ready" ? "Ready" : statusText == "Invalidated" ? "Invalid" : statusText == "Standby" ? "Standby" : statusText == "Managed" ? "Mngd" : statusText == "Replaced" ? "Newer" : statusText == "Expired" ? "Exp" : statusText == "Chased" ? "Chased" : statusText == "Filtered" ? "Filter" : statusText == "Wait KZ" ? "WaitKZ" : statusText

f_zoneTouched(float zoneTop, float zoneBottom) =>
    not na(zoneTop) and not na(zoneBottom) and high >= zoneBottom and low <= zoneTop

f_zoneIntersects(float zoneTop, float zoneBottom, float refTop, float refBottom) =>
    not na(zoneTop) and not na(zoneBottom) and not na(refTop) and not na(refBottom) and math.max(zoneBottom, refBottom) <= math.min(zoneTop, refTop)

f_boolFlag(bool cond) =>
    cond ? "Y" : "N"

f_bodyShare(int shift) =>
    float candleRange = high[shift] - low[shift]
    candleRange > 0 ? math.abs(close[shift] - open[shift]) / candleRange : 0.0

f_legLowSince(int sourceBar, int maxBars) =>
    float result = na
    int barsCount = na(sourceBar) ? math.min(maxBars, bar_index + 1) : math.min(maxBars, bar_index - sourceBar + 1)
    if barsCount > 0
        result := low
        for i = 0 to barsCount - 1
            result := na(result) ? low[i] : math.min(result, low[i])
    result

f_legHighSince(int sourceBar, int maxBars) =>
    float result = na
    int barsCount = na(sourceBar) ? math.min(maxBars, bar_index + 1) : math.min(maxBars, bar_index - sourceBar + 1)
    if barsCount > 0
        result := high
        for i = 0 to barsCount - 1
            result := na(result) ? high[i] : math.max(result, high[i])
    result

f_inSessionWindow(string sessionWindow) =>
    not na(time(timeframe.period, sessionWindow, ictSessionTimezone))

f_updateSessionRange(bool inSession, bool newSession, bool sessionEnded, float runningHigh, float runningLow, float lastHigh, float lastLow) =>
    float nextRunningHigh = runningHigh
    float nextRunningLow = runningLow
    float nextLastHigh = lastHigh
    float nextLastLow = lastLow
    if newSession
        nextLastHigh := runningHigh
        nextLastLow := runningLow
        nextRunningHigh := high
        nextRunningLow := low
    else if inSession
        nextRunningHigh := na(runningHigh) ? high : math.max(runningHigh, high)
        nextRunningLow := na(runningLow) ? low : math.min(runningLow, low)
    if sessionEnded
        nextLastHigh := nextRunningHigh
        nextLastLow := nextRunningLow
    [nextRunningHigh, nextRunningLow, nextLastHigh, nextLastLow]

f_mergeSessionHigh(float levelA, float levelB) =>
    na(levelA) ? levelB : na(levelB) ? levelA : math.max(levelA, levelB)

f_mergeSessionLow(float levelA, float levelB) =>
    na(levelA) ? levelB : na(levelB) ? levelA : math.min(levelA, levelB)

f_ictMinHtf(float chartSeconds) =>
    na(chartSeconds) ? "" :
         chartSeconds <= timeframe.in_seconds("3") ? "15" :
         chartSeconds <= timeframe.in_seconds("15") ? "60" :
         chartSeconds <= timeframe.in_seconds("60") ? "240" :
         chartSeconds <= timeframe.in_seconds("240") ? "1D" :
         chartSeconds <= timeframe.in_seconds("1D") ? "1W" : ""

f_ictMaxHtf(float chartSeconds) =>
    na(chartSeconds) ? "" :
         chartSeconds <= timeframe.in_seconds("3") ? "60" :
         chartSeconds <= timeframe.in_seconds("15") ? "240" :
         chartSeconds <= timeframe.in_seconds("60") ? "1D" :
         chartSeconds <= timeframe.in_seconds("240") ? "1W" :
         chartSeconds <= timeframe.in_seconds("1D") ? "1M" : ""

f_rrPoints(float rr) =>
    na(rr) ? 0.0 : rr >= 2.0 ? 2.0 : rr >= 1.2 ? 1.0 : 0.0

f_nearestAbove(float entry, float level1, float level2, float level3, float level4, float level5, float level6, float level7) =>
    float target = na
    target := f_selectAbove(entry, target, level1)
    target := f_selectAbove(entry, target, level2)
    target := f_selectAbove(entry, target, level3)
    target := f_selectAbove(entry, target, level4)
    target := f_selectAbove(entry, target, level5)
    target := f_selectAbove(entry, target, level6)
    target := f_selectAbove(entry, target, level7)
    target

f_nearestBelow(float entry, float level1, float level2, float level3, float level4, float level5, float level6, float level7) =>
    float target = na
    target := f_selectBelow(entry, target, level1)
    target := f_selectBelow(entry, target, level2)
    target := f_selectBelow(entry, target, level3)
    target := f_selectBelow(entry, target, level4)
    target := f_selectBelow(entry, target, level5)
    target := f_selectBelow(entry, target, level6)
    target := f_selectBelow(entry, target, level7)
    target

f_levelChanged(float currentLevel, float previousLevel) =>
    na(currentLevel) != na(previousLevel) ? true : na(currentLevel) ? false : math.abs(currentLevel - previousLevel) > syminfo.mintick * 0.5

f_horizontalLevel(float level, bool enabled) =>
    float result = na
    if enabled and not na(level)
        bool changed = f_levelChanged(level, level[1])
        result := changed and not na(level[1]) ? na : level
    result

f_safeBarIndexX(int targetBar) =>
    math.max(targetBar, math.max(bar_index - 5000, 0))

f_syncRightEdgeLabel(label currentLabel, float level, string labelText, color labelColor, color textColor, bool enabled) =>
    label updatedLabel = currentLabel
    if enabled and not na(level)
        if na(updatedLabel)
            updatedLabel := label.new(x=bar_index, y=level, xloc=xloc.bar_index, text=labelText, style=label.style_label_left, color=labelColor, textcolor=textColor, size=size.tiny)
        else
            label.set_x(updatedLabel, bar_index)
            label.set_y(updatedLabel, level)
            label.set_text(updatedLabel, labelText)
            label.set_color(updatedLabel, labelColor)
            label.set_textcolor(updatedLabel, textColor)
            label.set_style(updatedLabel, label.style_label_left)
            label.set_size(updatedLabel, size.tiny)
    else if not na(updatedLabel)
        label.delete(updatedLabel)
        updatedLabel := na
    updatedLabel

f_setCell(table targetTable, int col, int row, string cellText, color textClr, color bgClr) =>
    table.cell(targetTable, col, row, cellText, text_color=textClr, bgcolor=bgClr)

f_lifecycleText(int setupAge, bool touched) =>
    (na(setupAge) ? "-" : str.tostring(setupAge) + "b") + " / " + (touched ? "Touched" : "Untouched")

f_compactLifecycleText(bool useLong, int longAge, bool longTouchedState, int shortAge, bool shortTouchedState) =>
    useLong ? (na(longAge) ? "-" : str.tostring(longAge) + "b") + "/" + (longTouchedState ? "T" : "U") : (na(shortAge) ? "-" : str.tostring(shortAge) + "b") + "/" + (shortTouchedState ? "T" : "U")

f_entryActionText(string statusText) =>
    statusText == "Strict Ready" or statusText == "Valid now" ? "Entry active" : "Wait confirmation"

f_biasSummary(int currentBias, bool htfReady, int higherBias) =>
    f_biasText(currentBias) + " / " + (htfReady ? f_biasText(higherBias) : "HTF Guard")

f_strictTimeSummary(bool strictModeEnabled, string htfSummary, string sessionSummary, bool kzActive) =>
    (strictModeEnabled ? "Mode ON | " : "Mode OFF | ") + htfSummary + " | " + sessionSummary + " | KZ " + (kzActive ? "On" : "Off")

f_zoneVisibleByMode(string mode, bool isSelected, bool isBull, string preferredDirection, bool useLongPreference) =>
    mode == "Full" ? true : mode == "Focused" or preferredDirection == "Balanced" ? isSelected : preferredDirection == "Wait" ? isSelected : useLongPreference ? (isBull and isSelected) : (not isBull and isSelected)

f_targetVisualByMode(string mode, bool isTarget) =>
    mode == "Full" ? true : isTarget

f_contextVisualByMode(string mode) =>
    mode != "Minimal"

f_strictChecklist(bool biasPass, bool sweepPass, bool mssPass, bool pdPass, bool otePass, bool kzPass, bool compactText) =>
    compactText ? "B" + f_boolFlag(biasPass) + " S" + f_boolFlag(sweepPass) + " M" + f_boolFlag(mssPass) + " P" + f_boolFlag(pdPass) + " O" + f_boolFlag(otePass) + " K" + f_boolFlag(kzPass) : "B:" + f_boolFlag(biasPass) + " S:" + f_boolFlag(sweepPass) + " M:" + f_boolFlag(mssPass) + " PD:" + f_boolFlag(pdPass) + " OTE:" + f_boolFlag(otePass) + " KZ:" + f_boolFlag(kzPass)

f_setupStatus(bool hasSetup, bool stopHit, bool structureInvalidated, bool replaced, bool expired, bool chased, bool managed, bool strictModeEnabled, bool strictContextPass, bool strictKillzonePass, bool priceInZone, bool priceNearZone, bool fresh) =>
    string status = "No setup"
    if hasSetup
        if stopHit or structureInvalidated
            status := "Invalidated"
        else if replaced
            status := "Replaced"
        else if expired
            status := "Expired"
        else if chased
            status := "Chased"
        else if managed
            status := "Managed"
        else if strictModeEnabled and not strictContextPass
            status := "Filtered"
        else if strictModeEnabled and not strictKillzonePass
            status := "Wait KZ"
        else if strictModeEnabled and (priceInZone or priceNearZone)
            status := "Strict Ready"
        else if priceInZone or priceNearZone
            status := "Valid now"
        else if fresh
            status := "Fresh"
        else
            status := "Standby"
    status

f_isActionable(string statusText) =>
    statusText != "No setup" and statusText != "Invalidated" and statusText != "Expired" and statusText != "Chased" and statusText != "Filtered"

f_setupScore(bool hasSetup, bool biasAligned, bool htfAligned, bool sweepSeen, bool displacementSeen, bool hasOb, bool hasFvg, bool priceInZone, bool priceNearZone, float rr, bool fresh, bool managed, bool strictModeEnabled, bool strictContextPass, bool strictKillzonePass, bool replaced, bool chased, bool expired, bool invalidated) =>
    float score = na
    if hasSetup
        float points = 1.0
        float maxPoints = 13.0
        points += biasAligned ? 2.0 : 0.0
        points += htfAligned ? 1.0 : 0.0
        points += sweepSeen ? 1.0 : 0.0
        points += displacementSeen ? 1.0 : 0.0
        points += hasOb ? 1.0 : hasFvg ? 1.0 : 0.0
        points += priceInZone ? 2.0 : priceNearZone ? 1.0 : 0.0
        points += f_rrPoints(rr)
        points += fresh ? 1.0 : 0.0
        points += managed ? 1.0 : 0.0
        points += strictModeEnabled and strictContextPass and strictKillzonePass ? 1.0 : 0.0
        points -= replaced ? 1.0 : 0.0
        points -= chased ? 2.0 : 0.0
        points -= expired ? 2.0 : 0.0
        points -= invalidated ? 4.0 : 0.0
        score := f_clamp(points / maxPoints * 100.0, 0.0, 100.0)
    score

f_tpProbability(float confidence, float rr, bool priceInZone, bool priceNearZone, bool managed, bool strictModeEnabled, bool strictContextPass, bool strictKillzonePass, bool chased, bool expired, bool invalidated) =>
    float probability = na
    if not na(confidence)
        probability := confidence
        probability += rr >= 2.0 ? 6.0 : rr >= 1.2 ? 3.0 : -6.0
        probability += managed ? 4.0 : priceInZone ? 3.0 : priceNearZone ? 1.0 : 0.0
        probability -= strictModeEnabled and (not strictContextPass or not strictKillzonePass) ? 10.0 : 0.0
        probability -= chased ? 12.0 : 0.0
        probability -= expired ? 14.0 : 0.0
        probability -= invalidated ? 25.0 : 0.0
        probability := f_clamp(probability, 5.0, 95.0)
    probability

chartTfLabel = timeframe.main_period
chartTfSeconds = timeframe.in_seconds()
ictMinHtfTf = f_ictMinHtf(chartTfSeconds)
ictMaxHtfTf = f_ictMaxHtf(chartTfSeconds)
ictChartTfValid = ictMinHtfTf != "" and ictMaxHtfTf != ""
effectiveHtfTf = ictChartTfValid ? ictMinHtfTf : timeframe.main_period
effectiveHtfSeconds = ictChartTfValid ? timeframe.in_seconds(effectiveHtfTf) : na
htfContextReady = ictChartTfValid and not na(effectiveHtfSeconds) and effectiveHtfSeconds > chartTfSeconds
tfPairInvalid = not ictChartTfValid

if stopOnInvalidTf and tfPairInvalid
    runtime.error("Invalid ICT chart timeframe: " + chartTfLabel + ". Use an execution timeframe from 1m up to 1D.")

if strictModeEnabled and not timeframe.isintraday
    runtime.error("Strict ICT killzone requires an intraday chart timeframe.")

f_trimFvg() =>
    if array.size(fvgBoxes) > maxFvgZones
        oldBox = array.shift(fvgBoxes)
        if not na(oldBox)
            box.delete(oldBox)
        oldLabel = array.shift(fvgLabels)
        if not na(oldLabel)
            label.delete(oldLabel)
        array.shift(fvgTops)
        array.shift(fvgBottoms)
        array.shift(fvgBull)
        array.shift(fvgCreatedBars)
        array.shift(fvgTouched)

f_trimOb() =>
    if array.size(obBoxes) > maxObZones
        oldBox = array.shift(obBoxes)
        if not na(oldBox)
            box.delete(oldBox)
        oldLine = array.shift(obEntryLines)
        if not na(oldLine)
            line.delete(oldLine)
        oldLabel = array.shift(obLabels)
        if not na(oldLabel)
            label.delete(oldLabel)
        array.shift(obTops)
        array.shift(obBottoms)
        array.shift(obBull)
        array.shift(obBreaker)
        array.shift(obFailed)
        array.shift(obCreatedBars)
        array.shift(obTouched)
        array.shift(obEntries)
        array.shift(obFailureBars)
        array.shift(obLeftBars)
        array.shift(obOriginOpens)
        array.shift(obOriginHighs)
        array.shift(obOriginLows)

f_trimStructureEvents() =>
    while array.size(structureEventBull) > maxStructureEventObjects
        oldLine = array.shift(structureEventLines)
        if not na(oldLine)
            line.delete(oldLine)
        oldLabel = array.shift(structureEventLabels)
        if not na(oldLabel)
            label.delete(oldLabel)
        array.shift(structureEventBull)

f_trimPivotLabels() =>
    while array.size(pivotStructureIsHigh) > maxPivotLabelObjects
        oldLabel = array.shift(pivotStructureLabels)
        if not na(oldLabel)
            label.delete(oldLabel)
        array.shift(pivotStructureIsHigh)

f_addPivotLabel(int pivotBar, float pivotPrice, string pivotText, bool isHigh) =>
    if displayStructureLabels
        pivotLabel = label.new(x=pivotBar, y=pivotPrice, xloc=xloc.bar_index, text=pivotText, style=isHigh ? label.style_label_down : label.style_label_up, color=color.new(isHigh ? liqHighColor : liqLowColor, 0), textcolor=color.white, size=size.tiny)
        array.push(pivotStructureLabels, pivotLabel)
        array.push(pivotStructureIsHigh, isHigh)
        f_trimPivotLabels()

f_drawStructureEvent(int fromBar, float level, string eventText, bool isBull) =>
    if showBosChoch and not na(fromBar)
        eventColor = isBull ? bullColor : bearColor
        fromShift = math.max(bar_index - fromBar, 0)
        if fromShift <= 5000
            fromTime = time[fromShift]
            eventLine = line.new(x1=fromTime, y1=level, x2=time, y2=level, xloc=xloc.bar_time, color=eventColor, width=2)
            eventLabel = label.new(x=time, y=level, text=eventText, xloc=xloc.bar_time, style=isBull ? label.style_label_down : label.style_label_up, color=eventColor, textcolor=color.white, size=size.small)
            array.push(structureEventLines, eventLine)
            array.push(structureEventLabels, eventLabel)
            array.push(structureEventBull, isBull)
            f_trimStructureEvents()

// Strict OB anchor: last opposing candle after the sweep but before the FVG/displacement leg.
f_findLastOpposingCandle(bool isBull, int sourceBar, int anchorBar, int lookback) =>
    int locatedShift = na
    int startShift = not na(anchorBar) ? math.max(1, bar_index - anchorBar + 1) : 1
    int endShift = na(sourceBar) ? math.min(lookback, bar_index) : math.min(lookback, bar_index - sourceBar)
    if endShift >= startShift
        for i = startShift to endShift
            if na(locatedShift)
                opposing = isBull ? close[i] < open[i] : close[i] > open[i]
                if opposing
                    locatedShift := i
    locatedShift

f_obBounds(bool isBull, int shift) =>
    float zoneTop = na
    float zoneBottom = na
    if obZoneMode == "Full Candle"
        zoneTop := high[shift]
        zoneBottom := low[shift]
    else if obZoneMode == "Open-to-Wick"
        zoneTop := isBull ? open[shift] : high[shift]
        zoneBottom := isBull ? low[shift] : open[shift]
    else
        zoneTop := math.max(open[shift], close[shift])
        zoneBottom := math.min(open[shift], close[shift])
    [math.max(zoneTop, zoneBottom), math.min(zoneTop, zoneBottom)]

f_obEntry(bool isBull, int shift, float zoneTop, float zoneBottom) =>
    float entry = na
    if obEntryMode == "Open"
        entry := open[shift]
    else if obEntryMode == "Wick"
        entry := isBull ? low[shift] : high[shift]
    else
        entry := (zoneTop + zoneBottom) * 0.5
    entry

f_obEntryFromMeta(bool isBull, float originOpen, float originHigh, float originLow, float zoneTop, float zoneBottom) =>
    float entry = na
    if obEntryMode == "Open"
        entry := originOpen
    else if obEntryMode == "Wick"
        entry := isBull ? originLow : originHigh
    else
        entry := (zoneTop + zoneBottom) * 0.5
    na(entry) ? (zoneTop + zoneBottom) * 0.5 : entry

f_ensureFvgVisual(int index) =>
    zoneBox = array.get(fvgBoxes, index)
    zoneLabel = array.get(fvgLabels, index)
    if showFvg and (na(zoneBox) or na(zoneLabel))
        zoneTop = array.get(fvgTops, index)
        zoneBottom = array.get(fvgBottoms, index)
        zoneBull = array.get(fvgBull, index)
        createdBar = array.get(fvgCreatedBars, index)
        leftBar = f_safeBarIndexX(createdBar - 2)
        safeCreatedBar = f_safeBarIndexX(createdBar)
        borderClr = zoneBull ? color.new(bullColor, 30) : color.new(bearColor, 30)
        fillClr = zoneBull ? fvgBullColor : fvgBearColor
        if na(zoneBox)
            zoneBox := box.new(left=leftBar, top=zoneTop, right=safeCreatedBar, bottom=zoneBottom, xloc=xloc.bar_index, extend=extend.right, bgcolor=fillClr, border_color=borderClr)
            array.set(fvgBoxes, index, zoneBox)
        if na(zoneLabel)
            zoneLabel := label.new(x=leftBar, y=f_zoneMid(zoneTop, zoneBottom), xloc=xloc.bar_index, text=f_fvgLabelText(zoneBull), style=label.style_label_left, color=color.new(borderClr, 0), textcolor=color.white, size=size.tiny)
            array.set(fvgLabels, index, zoneLabel)

f_ensureObVisual(int index) =>
    zoneBox = array.get(obBoxes, index)
    zoneLine = array.get(obEntryLines, index)
    zoneLabel = array.get(obLabels, index)
    if showOb and (na(zoneBox) or na(zoneLine) or na(zoneLabel))
        zoneTop = array.get(obTops, index)
        zoneBottom = array.get(obBottoms, index)
        zoneBull = array.get(obBull, index)
        zoneBreaker = array.get(obBreaker, index)
        zoneFailed = array.get(obFailed, index)
        zoneEntry = array.get(obEntries, index)
        leftBar = f_safeBarIndexX(array.get(obLeftBars, index))
        createdBar = f_safeBarIndexX(array.get(obCreatedBars, index))
        baseFill = zoneBreaker ? (zoneBull ? bbBullColor : bbBearColor) : (zoneBull ? obBullColor : obBearColor)
        baseBorder = zoneFailed ? (zoneBull ? color.new(bearColor, 35) : color.new(bullColor, 35)) : (zoneBull ? bullColor : bearColor)
        baseLabel = zoneFailed ? (compactMode and mobileCompactLabels ? "OB?" : "Failed OB") : f_obLabelText(zoneBull, zoneBreaker)
        if na(zoneBox)
            zoneBox := box.new(left=leftBar, top=zoneTop, right=createdBar, bottom=zoneBottom, xloc=xloc.bar_index, extend=extend.right, bgcolor=baseFill, border_color=baseBorder)
            array.set(obBoxes, index, zoneBox)
        if na(zoneLine)
            zoneLine := line.new(x1=leftBar, y1=zoneEntry, x2=createdBar, y2=zoneEntry, xloc=xloc.bar_index, extend=extend.right, color=baseBorder, style=zoneBreaker or zoneFailed ? line.style_dotted : line.style_dashed)
            array.set(obEntryLines, index, zoneLine)
        if na(zoneLabel)
            zoneLabel := label.new(x=leftBar, y=f_zoneMid(zoneTop, zoneBottom), xloc=xloc.bar_index, text=baseLabel, style=label.style_label_left, color=color.new(baseBorder, 0), textcolor=color.white, size=size.tiny)
            array.set(obLabels, index, zoneLabel)

f_addFvg(bool isBull, float zoneTop, float zoneBottom) =>
    borderClr = isBull ? color.new(bullColor, 30) : color.new(bearColor, 30)
    fillClr = isBull ? fvgBullColor : fvgBearColor
    box newBox = na
    label newLabel = na
    if showFvg
        newBox := box.new(left=bar_index - 2, top=zoneTop, right=bar_index, bottom=zoneBottom, xloc=xloc.bar_index, extend=extend.right, bgcolor=fillClr, border_color=borderClr)
        newLabel := label.new(x=bar_index - 2, y=f_zoneMid(zoneTop, zoneBottom), xloc=xloc.bar_index, text=f_fvgLabelText(isBull), style=label.style_label_left, color=color.new(borderClr, 0), textcolor=color.white, size=size.tiny)
    array.push(fvgBoxes, newBox)
    array.push(fvgLabels, newLabel)
    array.push(fvgTops, zoneTop)
    array.push(fvgBottoms, zoneBottom)
    array.push(fvgBull, isBull)
    array.push(fvgCreatedBars, bar_index)
    array.push(fvgTouched, false)
    f_trimFvg()

f_addOb(bool isBull, int shift) =>
    [zoneTop, zoneBottom] = f_obBounds(isBull, shift)
    entry = f_obEntry(isBull, shift, zoneTop, zoneBottom)
    leftBar = bar_index - shift
    zoneColor = isBull ? obBullColor : obBearColor
    borderClr = isBull ? bullColor : bearColor
    box newBox = na
    line newLine = na
    label newLabel = na
    if showOb
        newBox := box.new(left=leftBar, top=zoneTop, right=bar_index, bottom=zoneBottom, xloc=xloc.bar_index, extend=extend.right, bgcolor=zoneColor, border_color=borderClr)
        newLine := line.new(x1=leftBar, y1=entry, x2=bar_index, y2=entry, xloc=xloc.bar_index, extend=extend.right, color=borderClr, style=line.style_dashed)
        newLabel := label.new(x=leftBar, y=f_zoneMid(zoneTop, zoneBottom), xloc=xloc.bar_index, text=f_obLabelText(isBull, false), style=label.style_label_left, color=color.new(borderClr, 0), textcolor=color.white, size=size.tiny)
    array.push(obBoxes, newBox)
    array.push(obEntryLines, newLine)
    array.push(obLabels, newLabel)
    array.push(obTops, zoneTop)
    array.push(obBottoms, zoneBottom)
    array.push(obBull, isBull)
    array.push(obBreaker, false)
    array.push(obFailed, false)
    array.push(obCreatedBars, bar_index)
    array.push(obTouched, false)
    array.push(obEntries, entry)
    array.push(obFailureBars, na)
    array.push(obLeftBars, leftBar)
    array.push(obOriginOpens, open[shift])
    array.push(obOriginHighs, high[shift])
    array.push(obOriginLows, low[shift])
    f_trimOb()

//------------------------------------------------------------------------------
// Session liquidity tracking
//------------------------------------------------------------------------------
inAsiaSession = f_inSessionWindow(asiaSessionWindow)
newAsiaSession = inAsiaSession and not inAsiaSession[1]
asiaSessionEnded = not inAsiaSession and inAsiaSession[1]
inLondonSession = f_inSessionWindow(londonSessionWindow)
newLondonSession = inLondonSession and not inLondonSession[1]
londonSessionEnded = not inLondonSession and inLondonSession[1]
inNyAmSession = f_inSessionWindow(nyAmSessionWindow)
newNyAmSession = inNyAmSession and not inNyAmSession[1]
nyAmSessionEnded = not inNyAmSession and inNyAmSession[1]
inNyPmSession = f_inSessionWindow(nyPmSessionWindow)
newNyPmSession = inNyPmSession and not inNyPmSession[1]
nyPmSessionEnded = not inNyPmSession and inNyPmSession[1]

var float asiaSessionHigh = na
var float asiaSessionLow = na
var float londonSessionHigh = na
var float londonSessionLow = na
var float nyAmSessionHigh = na
var float nyAmSessionLow = na
var float nyPmSessionHigh = na
var float nyPmSessionLow = na
var float lastAsiaHigh = na
var float lastAsiaLow = na
var float lastLondonHigh = na
var float lastLondonLow = na
var float lastNyAmHigh = na
var float lastNyAmLow = na
var float lastNyPmHigh = na
var float lastNyPmLow = na
var float prevSessionHigh = na
var float prevSessionLow = na

[asiaSessionHighNext, asiaSessionLowNext, lastAsiaHighNext, lastAsiaLowNext] = f_updateSessionRange(inAsiaSession, newAsiaSession, asiaSessionEnded, asiaSessionHigh, asiaSessionLow, lastAsiaHigh, lastAsiaLow)
[londonSessionHighNext, londonSessionLowNext, lastLondonHighNext, lastLondonLowNext] = f_updateSessionRange(inLondonSession, newLondonSession, londonSessionEnded, londonSessionHigh, londonSessionLow, lastLondonHigh, lastLondonLow)
[nyAmSessionHighNext, nyAmSessionLowNext, lastNyAmHighNext, lastNyAmLowNext] = f_updateSessionRange(inNyAmSession, newNyAmSession, nyAmSessionEnded, nyAmSessionHigh, nyAmSessionLow, lastNyAmHigh, lastNyAmLow)
[nyPmSessionHighNext, nyPmSessionLowNext, lastNyPmHighNext, lastNyPmLowNext] = f_updateSessionRange(inNyPmSession, newNyPmSession, nyPmSessionEnded, nyPmSessionHigh, nyPmSessionLow, lastNyPmHigh, lastNyPmLow)
asiaSessionHigh := asiaSessionHighNext
asiaSessionLow := asiaSessionLowNext
lastAsiaHigh := lastAsiaHighNext
lastAsiaLow := lastAsiaLowNext
londonSessionHigh := londonSessionHighNext
londonSessionLow := londonSessionLowNext
lastLondonHigh := lastLondonHighNext
lastLondonLow := lastLondonLowNext
nyAmSessionHigh := nyAmSessionHighNext
nyAmSessionLow := nyAmSessionLowNext
lastNyAmHigh := lastNyAmHighNext
lastNyAmLow := lastNyAmLowNext
nyPmSessionHigh := nyPmSessionHighNext
nyPmSessionLow := nyPmSessionLowNext
lastNyPmHigh := lastNyPmHighNext
lastNyPmLow := lastNyPmLowNext

float lastNyCompositeHigh = f_mergeSessionHigh(lastNyAmHigh, lastNyPmHigh)
float lastNyCompositeLow = f_mergeSessionLow(lastNyAmLow, lastNyPmLow)
string currentSessionBlock = inAsiaSession ? "Asia" : inLondonSession ? "London" : inNyAmSession ? "New York AM" : inNyPmSession ? "New York PM" : "Inter-session"
string liquiditySessionLabel = inLondonSession ? "Asia" : inNyAmSession ? "London" : inNyPmSession ? "New York AM" : "New York Composite"
prevSessionHigh := inLondonSession ? lastAsiaHigh : inNyAmSession ? lastLondonHigh : inNyPmSession ? lastNyAmHigh : lastNyCompositeHigh
prevSessionLow := inLondonSession ? lastAsiaLow : inNyAmSession ? lastLondonLow : inNyPmSession ? lastNyAmLow : lastNyCompositeLow

prevDayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
prevDayLow = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)
prevWeekHigh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
prevWeekLow = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_off)
prevMonthHigh = request.security(syminfo.tickerid, "M", high[1], lookahead=barmerge.lookahead_off)
prevMonthLow = request.security(syminfo.tickerid, "M", low[1], lookahead=barmerge.lookahead_off)
enginePrevSessionHigh = usePrevSessionInEngine ? prevSessionHigh : na
enginePrevSessionLow = usePrevSessionInEngine ? prevSessionLow : na
enginePrevDayHigh = useHigherPeriodLiquidityInEngine ? prevDayHigh : na
enginePrevDayLow = useHigherPeriodLiquidityInEngine ? prevDayLow : na
enginePrevWeekHigh = useHigherPeriodLiquidityInEngine ? prevWeekHigh : na
enginePrevWeekLow = useHigherPeriodLiquidityInEngine ? prevWeekLow : na
enginePrevMonthHigh = useHigherPeriodLiquidityInEngine ? prevMonthHigh : na
enginePrevMonthLow = useHigherPeriodLiquidityInEngine ? prevMonthLow : na

//------------------------------------------------------------------------------
// Pivot-based market structure
//------------------------------------------------------------------------------
pivotHigh = ta.pivothigh(high, swingLen, swingLen)
pivotLow = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var int lastSwingHighBar = na
var float prevSwingHigh = na
var int prevSwingHighBar = na
var float lastSwingLow = na
var int lastSwingLowBar = na
var float prevSwingLow = na
var int prevSwingLowBar = na
var float latestEqh = na
var float latestEql = na
var bool latestEqhActive = false
var bool latestEqlActive = false
var bool lastHighBroken = false
var bool lastLowBroken = false

if not na(pivotHigh)
    pBar = bar_index - swingLen
    pPrice = pivotHigh
    structureText = na(lastSwingHigh) ? "SH" : math.abs(pPrice - lastSwingHigh) <= equalTolerance ? "EQH" : pPrice > lastSwingHigh ? "HH" : "LH"
    f_addPivotLabel(pBar, pPrice, structureText, true)
    if structureText == "EQH" and not na(lastSwingHighBar)
        latestEqh := math.max(pPrice, lastSwingHigh)
        latestEqhActive := true
    prevSwingHigh := lastSwingHigh
    prevSwingHighBar := lastSwingHighBar
    lastSwingHigh := pPrice
    lastSwingHighBar := pBar
    lastHighBroken := false

if not na(pivotLow)
    pBar = bar_index - swingLen
    pPrice = pivotLow
    structureText = na(lastSwingLow) ? "SL" : math.abs(pPrice - lastSwingLow) <= equalTolerance ? "EQL" : pPrice > lastSwingLow ? "HL" : "LL"
    f_addPivotLabel(pBar, pPrice, structureText, false)
    if structureText == "EQL" and not na(lastSwingLowBar)
        latestEql := math.min(pPrice, lastSwingLow)
        latestEqlActive := true
    prevSwingLow := lastSwingLow
    prevSwingLowBar := lastSwingLowBar
    lastSwingLow := pPrice
    lastSwingLowBar := pBar
    lastLowBroken := false

//------------------------------------------------------------------------------
// Liquidity sweeps, inducement, BOS / CHOCH
//------------------------------------------------------------------------------
activeEqh = latestEqhActive ? latestEqh : na
activeEql = latestEqlActive ? latestEql : na

sellSideSweep = (not na(lastSwingLow) and low < lastSwingLow and not f_breakDown(lastSwingLow)) or
     (not na(enginePrevSessionLow) and low < enginePrevSessionLow and close > enginePrevSessionLow) or
     (not na(enginePrevDayLow) and low < enginePrevDayLow and close > enginePrevDayLow) or
     (not na(enginePrevWeekLow) and low < enginePrevWeekLow and close > enginePrevWeekLow) or
     (not na(enginePrevMonthLow) and low < enginePrevMonthLow and close > enginePrevMonthLow) or
     (not na(activeEql) and low < activeEql and close > activeEql)

buySideSweep = (not na(lastSwingHigh) and high > lastSwingHigh and not f_breakUp(lastSwingHigh)) or
     (not na(enginePrevSessionHigh) and high > enginePrevSessionHigh and close < enginePrevSessionHigh) or
     (not na(enginePrevDayHigh) and high > enginePrevDayHigh and close < enginePrevDayHigh) or
     (not na(enginePrevWeekHigh) and high > enginePrevWeekHigh and close < enginePrevWeekHigh) or
     (not na(enginePrevMonthHigh) and high > enginePrevMonthHigh and close < enginePrevMonthHigh) or
     (not na(activeEqh) and high > activeEqh and close < activeEqh)

plotshape(displaySweepMarkers and sellSideSweep, title="Sell-side liquidity sweep", style=shape.triangleup, location=location.belowbar, color=bullColor, size=size.tiny, text="")
plotshape(displaySweepMarkers and buySideSweep, title="Buy-side liquidity sweep", style=shape.triangledown, location=location.abovebar, color=bearColor, size=size.tiny, text="")

if latestEqhActive and not na(latestEqh) and high > latestEqh
    latestEqhActive := false

if latestEqlActive and not na(latestEql) and low < latestEql
    latestEqlActive := false

var int lastSellSideSweepBar = na
var int lastBuySideSweepBar = na
var int bullSequenceSweepBar = na
var int bullSequenceFvgBar = na
var int bullSequenceDisplacementBar = na
var int bearSequenceSweepBar = na
var int bearSequenceFvgBar = na
var int bearSequenceDisplacementBar = na

if sellSideSweep
    lastSellSideSweepBar := bar_index
    bullSequenceSweepBar := bar_index
    bullSequenceFvgBar := na
    bullSequenceDisplacementBar := na
if buySideSweep
    lastBuySideSweepBar := bar_index
    bearSequenceSweepBar := bar_index
    bearSequenceFvgBar := na
    bearSequenceDisplacementBar := na

var int trendBias = 0
var int lastStructureBreakBar = na
var float protectedLow = na
var int protectedLowBar = na
var float protectedHigh = na
var int protectedHighBar = na
var int lastBullMssBar = na
var int lastBearMssBar = na

bullishIdm = trendBias == 1 and not na(prevSwingLow) and low < prevSwingLow and close > prevSwingLow and close > open and (na(protectedLow) or low > protectedLow)
bearishIdm = trendBias == -1 and not na(prevSwingHigh) and high > prevSwingHigh and close < prevSwingHigh and close < open and (na(protectedHigh) or high < protectedHigh)

plotshape(showIdm and bullishIdm, title="Bullish IDM", style=shape.circle, location=location.belowbar, size=size.tiny, color=color.new(bullColor, 0), text="")
plotshape(showIdm and bearishIdm, title="Bearish IDM", style=shape.circle, location=location.abovebar, size=size.tiny, color=color.new(bearColor, 0), text="")

bullBreak = not na(lastSwingHigh) and not lastHighBroken and f_breakUp(lastSwingHigh)
bearBreak = not na(lastSwingLow) and not lastLowBroken and f_breakDown(lastSwingLow)

var int lastBullFvgBar = na
var int lastBearFvgBar = na
var int lastBullDisplacementBar = na
var int lastBearDisplacementBar = na
var float bullLegLow = na
var float bullLegHigh = na
var int bullLegStartBar = na
var int bullLegEndBar = na
var int bullNarrativeStartBar = na
var int bullNarrativeEndBar = na
var bool bullLegHasSweep = false
var bool bullLegHasDisplacement = false
var bool bullLegHasMss = false
var float bullRangeHighState = na
var float bullRangeLowState = na
var float bullEquilibriumState = na
var float bullOteTopState = na
var float bullOteBottomState = na
var int bullOteCreatedBar = na
var bool bullOteMitigated = false
var bool bullOteInvalidated = false
var float bearLegLow = na
var float bearLegHigh = na
var int bearLegStartBar = na
var int bearLegEndBar = na
var int bearNarrativeStartBar = na
var int bearNarrativeEndBar = na
var bool bearLegHasSweep = false
var bool bearLegHasDisplacement = false
var bool bearLegHasMss = false
var float bearRangeHighState = na
var float bearRangeLowState = na
var float bearEquilibriumState = na
var float bearOteTopState = na
var float bearOteBottomState = na
var int bearOteCreatedBar = na
var bool bearOteMitigated = false
var bool bearOteInvalidated = false

legSearchBars = obSearchBars + obValidationLookback + 2

//------------------------------------------------------------------------------
// FVG detection and mitigation tracking
//------------------------------------------------------------------------------
bullDisplacementFvg = close[1] > open[1] and close[1] > high[2] and (high[1] - low[1]) >= atr * math.max(fvgMinAtr * 2.0, obImpulseAtr * 0.75) and f_bodyShare(1) >= 0.60
bearDisplacementFvg = close[1] < open[1] and close[1] < low[2] and (high[1] - low[1]) >= atr * math.max(fvgMinAtr * 2.0, obImpulseAtr * 0.75) and f_bodyShare(1) >= 0.60
bullFvg = low > high[2] and bullDisplacementFvg and (low - high[2]) >= atr * fvgMinAtr
bearFvg = high < low[2] and bearDisplacementFvg and (low[2] - high) >= atr * fvgMinAtr

if bullFvg
    lastBullFvgBar := bar_index
    lastBullDisplacementBar := bar_index - 1
    if not na(bullSequenceSweepBar) and (bar_index - bullSequenceSweepBar) <= obValidationLookback
        bullSequenceFvgBar := bar_index
        bullSequenceDisplacementBar := bar_index - 1
    f_addFvg(true, low, high[2])

if bearFvg
    lastBearFvgBar := bar_index
    lastBearDisplacementBar := bar_index - 1
    if not na(bearSequenceSweepBar) and (bar_index - bearSequenceSweepBar) <= obValidationLookback
        bearSequenceFvgBar := bar_index
        bearSequenceDisplacementBar := bar_index - 1
    f_addFvg(false, low[2], high)

if array.size(fvgBoxes) > 0
    for idx = 0 to array.size(fvgBoxes) - 1
        i = array.size(fvgBoxes) - 1 - idx
        zoneBox = array.get(fvgBoxes, i)
        zoneLabel = array.get(fvgLabels, i)
        zoneTop = array.get(fvgTops, i)
        zoneBottom = array.get(fvgBottoms, i)
        zoneBull = array.get(fvgBull, i)
        zoneTouched = array.get(fvgTouched, i)
        removeZone = false
        if f_zoneTouched(zoneTop, zoneBottom)
            array.set(fvgTouched, i, true)
            zoneTouched := true
        if zoneBull
            if low < zoneTop
                zoneTop := math.max(low, zoneBottom)
                array.set(fvgTops, i, zoneTop)
                if not na(zoneBox)
                    box.set_top(zoneBox, zoneTop)
            if low <= zoneBottom
                removeZone := true
        else
            if high > zoneBottom
                zoneBottom := math.min(high, zoneTop)
                array.set(fvgBottoms, i, zoneBottom)
                if not na(zoneBox)
                    box.set_bottom(zoneBox, zoneBottom)
            if high >= zoneTop
                removeZone := true
        if not na(zoneLabel)
            label.set_y(zoneLabel, f_zoneMid(zoneTop, zoneBottom))
        normalBorder = zoneBull ? color.new(bullColor, 30) : color.new(bearColor, 30)
        normalFill = zoneBull ? fvgBullColor : fvgBearColor
        touchedBorder = zoneBull ? color.new(bullColor, 55) : color.new(bearColor, 55)
        touchedFill = zoneBull ? color.new(bullColor, 90) : color.new(bearColor, 90)
        if not na(zoneBox)
            box.set_border_color(zoneBox, zoneTouched ? touchedBorder : normalBorder)
            box.set_bgcolor(zoneBox, zoneTouched ? touchedFill : normalFill)
        if not na(zoneLabel)
            label.set_color(zoneLabel, zoneTouched ? touchedBorder : normalBorder)
        if removeZone
            if not na(zoneBox)
                box.delete(zoneBox)
            if not na(zoneLabel)
                label.delete(zoneLabel)
            array.remove(fvgBoxes, i)
            array.remove(fvgLabels, i)
            array.remove(fvgTops, i)
            array.remove(fvgBottoms, i)
            array.remove(fvgBull, i)
            array.remove(fvgCreatedBars, i)
            array.remove(fvgTouched, i)

if not na(bullSequenceSweepBar) and (bar_index - bullSequenceSweepBar) > obValidationLookback
    bullSequenceSweepBar := na
    bullSequenceFvgBar := na
    bullSequenceDisplacementBar := na
else if not na(bullSequenceFvgBar) and (bar_index - bullSequenceFvgBar) > obValidationLookback
    bullSequenceFvgBar := na
    bullSequenceDisplacementBar := na

if not na(bearSequenceSweepBar) and (bar_index - bearSequenceSweepBar) > obValidationLookback
    bearSequenceSweepBar := na
    bearSequenceFvgBar := na
    bearSequenceDisplacementBar := na
else if not na(bearSequenceFvgBar) and (bar_index - bearSequenceFvgBar) > obValidationLookback
    bearSequenceFvgBar := na
    bearSequenceDisplacementBar := na

bullSequenceValid = not na(bullSequenceSweepBar) and not na(bullSequenceFvgBar) and (bar_index - bullSequenceSweepBar) <= obValidationLookback and (bar_index - bullSequenceFvgBar) <= obValidationLookback and bullSequenceFvgBar >= bullSequenceSweepBar
bearSequenceValid = not na(bearSequenceSweepBar) and not na(bearSequenceFvgBar) and (bar_index - bearSequenceSweepBar) <= obValidationLookback and (bar_index - bearSequenceFvgBar) <= obValidationLookback and bearSequenceFvgBar >= bearSequenceSweepBar
recentBullDisplacement = not na(bullSequenceDisplacementBar) and (bar_index - bullSequenceDisplacementBar) <= engineDisplacementLookback
recentBearDisplacement = not na(bearSequenceDisplacementBar) and (bar_index - bearSequenceDisplacementBar) <= engineDisplacementLookback
bullMssLevel = not na(protectedHigh) ? protectedHigh : lastSwingHigh
bearMssLevel = not na(protectedLow) ? protectedLow : lastSwingLow
bullMss = not na(bullMssLevel) and trendBias != 1 and f_breakUp(bullMssLevel) and bullSequenceValid and recentBullDisplacement
bearMss = not na(bearMssLevel) and trendBias != -1 and f_breakDown(bearMssLevel) and bearSequenceValid and recentBearDisplacement
bullBos = trendBias == 1 and bullBreak
bearBos = trendBias == -1 and bearBreak

if bullMss or bullBos
    bool resetBullLeg = bullMss
    int bullSourceBar = resetBullLeg ? (bullSequenceValid ? bullSequenceSweepBar : na(protectedLowBar) ? lastSwingLowBar : protectedLowBar) : bullLegStartBar
    float bullEventLevel = bullMss ? bullMssLevel : lastSwingHigh
    int bullEventBar = bullMss and not na(protectedHighBar) ? protectedHighBar : lastSwingHighBar
    f_drawStructureEvent(bullEventBar, bullEventLevel, bullMss ? "MSS" : "BOS", true)
    trendBias := 1
    lastStructureBreakBar := bar_index
    lastHighBroken := true
    if bullMss
        lastBullMssBar := bar_index
    bullLegStartBar := bullSourceBar
    if resetBullLeg
        bullLegLow := f_legLowSince(bullLegStartBar, bar_index + 1)
        bullLegHigh := f_legHighSince(bullLegStartBar, bar_index + 1)
        bullNarrativeStartBar := not na(bullSequenceSweepBar) ? bullSequenceSweepBar : bullLegStartBar
        bullNarrativeEndBar := bar_index
        protectedLow := bullLegLow
        protectedLowBar := bullLegStartBar
        bullRangeHighState := bullLegHigh
        bullRangeLowState := bullLegLow
        bullEquilibriumState := not na(bullLegHigh) and not na(bullLegLow) ? (bullLegHigh + bullLegLow) * 0.5 : na
    bullLegEndBar := bar_index
    bullLegHasSweep := resetBullLeg ? bullSequenceValid : (bullLegHasSweep or bullSequenceValid)
    bullLegHasDisplacement := resetBullLeg ? recentBullDisplacement : (bullLegHasDisplacement or recentBullDisplacement)
    bullLegHasMss := resetBullLeg ? bullMss : (bullLegHasMss or bullMss)
    if bullMss
        bearLegHasSweep := false
        bearLegHasDisplacement := false
        bearLegHasMss := false

if bearMss or bearBos
    bool resetBearLeg = bearMss
    int bearSourceBar = resetBearLeg ? (bearSequenceValid ? bearSequenceSweepBar : na(protectedHighBar) ? lastSwingHighBar : protectedHighBar) : bearLegStartBar
    float bearEventLevel = bearMss ? bearMssLevel : lastSwingLow
    int bearEventBar = bearMss and not na(protectedLowBar) ? protectedLowBar : lastSwingLowBar
    f_drawStructureEvent(bearEventBar, bearEventLevel, bearMss ? "MSS" : "BOS", false)
    trendBias := -1
    lastStructureBreakBar := bar_index
    lastLowBroken := true
    if bearMss
        lastBearMssBar := bar_index
    bearLegStartBar := bearSourceBar
    if resetBearLeg
        bearLegHigh := f_legHighSince(bearLegStartBar, bar_index + 1)
        bearLegLow := f_legLowSince(bearLegStartBar, bar_index + 1)
        bearNarrativeStartBar := not na(bearSequenceSweepBar) ? bearSequenceSweepBar : bearLegStartBar
        bearNarrativeEndBar := bar_index
        protectedHigh := bearLegHigh
        protectedHighBar := bearLegStartBar
        bearRangeHighState := bearLegHigh
        bearRangeLowState := bearLegLow
        bearEquilibriumState := not na(bearLegHigh) and not na(bearLegLow) ? (bearLegHigh + bearLegLow) * 0.5 : na
    bearLegEndBar := bar_index
    bearLegHasSweep := resetBearLeg ? bearSequenceValid : (bearLegHasSweep or bearSequenceValid)
    bearLegHasDisplacement := resetBearLeg ? recentBearDisplacement : (bearLegHasDisplacement or recentBearDisplacement)
    bearLegHasMss := resetBearLeg ? bearMss : (bearLegHasMss or bearMss)
    if bearMss
        bullLegHasSweep := false
        bullLegHasDisplacement := false
        bullLegHasMss := false

if not na(bullLegStartBar) and trendBias == 1
    bullLegLow := na(bullLegLow) ? low : math.min(bullLegLow, low)
    bullLegHigh := na(bullLegHigh) ? high : math.max(bullLegHigh, high)
    bullLegEndBar := bar_index

if not na(bearLegStartBar) and trendBias == -1
    bearLegHigh := na(bearLegHigh) ? high : math.max(bearLegHigh, high)
    bearLegLow := na(bearLegLow) ? low : math.min(bearLegLow, low)
    bearLegEndBar := bar_index

//------------------------------------------------------------------------------
// Order block qualification from a single strict leg: sweep -> displacement/FVG -> BOS
//------------------------------------------------------------------------------
obBullDisplacement = not na(bullSequenceDisplacementBar) and not na(bullSequenceSweepBar) and bullSequenceDisplacementBar >= bullSequenceSweepBar and (bar_index - bullSequenceDisplacementBar) <= obValidationLookback
obBearDisplacement = not na(bearSequenceDisplacementBar) and not na(bearSequenceSweepBar) and bearSequenceDisplacementBar >= bearSequenceSweepBar and (bar_index - bearSequenceDisplacementBar) <= obValidationLookback

if (bullMss or bullBos) and bullSequenceValid and obBullDisplacement
    obShift = f_findLastOpposingCandle(true, bullSequenceSweepBar, bullSequenceFvgBar, legSearchBars)
    if not na(obShift)
        f_addOb(true, obShift)

if (bearMss or bearBos) and bearSequenceValid and obBearDisplacement
    obShift = f_findLastOpposingCandle(false, bearSequenceSweepBar, bearSequenceFvgBar, legSearchBars)
    if not na(obShift)
        f_addOb(false, obShift)

if array.size(obBoxes) > 0
    for idx = 0 to array.size(obBoxes) - 1
        i = array.size(obBoxes) - 1 - idx
        zoneBox = array.get(obBoxes, i)
        zoneLine = array.get(obEntryLines, i)
        zoneLabel = array.get(obLabels, i)
        zoneTop = array.get(obTops, i)
        zoneBottom = array.get(obBottoms, i)
        zoneBull = array.get(obBull, i)
        zoneBreaker = array.get(obBreaker, i)
        zoneFailed = array.get(obFailed, i)
        zoneTouched = array.get(obTouched, i)
        zoneFailureBar = array.get(obFailureBars, i)
        deleteZone = false
        originOpen = array.get(obOriginOpens, i)
        originHigh = array.get(obOriginHighs, i)
        originLow = array.get(obOriginLows, i)

        if not na(zoneLabel)
            label.set_y(zoneLabel, f_zoneMid(zoneTop, zoneBottom))
        if f_zoneTouched(zoneTop, zoneBottom)
            array.set(obTouched, i, true)

        if zoneBull
            if zoneBreaker and close < zoneBottom and zoneTouched and (bearMss or bearBos)
                deleteZone := true
            else if not zoneBreaker and not zoneFailed and close < zoneBottom and zoneTouched and bearMss
                array.set(obFailed, i, true)
                array.set(obFailureBars, i, bar_index)
                array.set(obTouched, i, false)
                if not na(zoneBox)
                    box.set_bgcolor(zoneBox, color.new(bearColor, 90))
                    box.set_border_color(zoneBox, color.new(bearColor, 35))
                if not na(zoneLine)
                    line.set_color(zoneLine, color.new(bearColor, 20))
                    line.set_style(zoneLine, line.style_dotted)
                if not na(zoneLabel)
                    label.set_text(zoneLabel, compactMode and mobileCompactLabels ? "OB?" : "Failed OB")
                    label.set_color(zoneLabel, color.new(bearColor, 20))
            else if not zoneBreaker and zoneFailed and not na(zoneFailureBar) and bar_index > zoneFailureBar and trendBias == -1 and high >= zoneBottom
                array.set(obBull, i, false)
                array.set(obBreaker, i, true)
                array.set(obFailed, i, false)
                array.set(obCreatedBars, i, bar_index)
                array.set(obTouched, i, false)
                array.set(obFailureBars, i, na)
                float breakerEntry = f_obEntryFromMeta(false, originOpen, originHigh, originLow, zoneTop, zoneBottom)
                array.set(obEntries, i, breakerEntry)
                if not na(zoneBox)
                    box.set_bgcolor(zoneBox, bbBearColor)
                    box.set_border_color(zoneBox, color.new(bearColor, 0))
                if not na(zoneLine)
                    line.set_y1(zoneLine, breakerEntry)
                    line.set_y2(zoneLine, breakerEntry)
                    line.set_color(zoneLine, bearColor)
                    line.set_style(zoneLine, line.style_dotted)
                if not na(zoneLabel)
                    label.set_text(zoneLabel, f_obLabelText(false, true))
                    label.set_color(zoneLabel, bearColor)
        else
            if zoneBreaker and close > zoneTop and zoneTouched and (bullMss or bullBos)
                deleteZone := true
            else if not zoneBreaker and not zoneFailed and close > zoneTop and zoneTouched and bullMss
                array.set(obFailed, i, true)
                array.set(obFailureBars, i, bar_index)
                array.set(obTouched, i, false)
                if not na(zoneBox)
                    box.set_bgcolor(zoneBox, color.new(bullColor, 90))
                    box.set_border_color(zoneBox, color.new(bullColor, 35))
                if not na(zoneLine)
                    line.set_color(zoneLine, color.new(bullColor, 20))
                    line.set_style(zoneLine, line.style_dotted)
                if not na(zoneLabel)
                    label.set_text(zoneLabel, compactMode and mobileCompactLabels ? "OB?" : "Failed OB")
                    label.set_color(zoneLabel, color.new(bullColor, 20))
            else if not zoneBreaker and zoneFailed and not na(zoneFailureBar) and bar_index > zoneFailureBar and trendBias == 1 and low <= zoneTop
                array.set(obBull, i, true)
                array.set(obBreaker, i, true)
                array.set(obFailed, i, false)
                array.set(obCreatedBars, i, bar_index)
                array.set(obTouched, i, false)
                array.set(obFailureBars, i, na)
                float breakerEntry = f_obEntryFromMeta(true, originOpen, originHigh, originLow, zoneTop, zoneBottom)
                array.set(obEntries, i, breakerEntry)
                if not na(zoneBox)
                    box.set_bgcolor(zoneBox, bbBullColor)
                    box.set_border_color(zoneBox, color.new(bullColor, 0))
                if not na(zoneLine)
                    line.set_y1(zoneLine, breakerEntry)
                    line.set_y2(zoneLine, breakerEntry)
                    line.set_color(zoneLine, bullColor)
                    line.set_style(zoneLine, line.style_dotted)
                if not na(zoneLabel)
                    label.set_text(zoneLabel, f_obLabelText(true, true))
                    label.set_color(zoneLabel, bullColor)

        if not zoneBreaker and zoneFailed and not na(zoneFailureBar) and (bar_index - zoneFailureBar) > obValidationLookback
            deleteZone := true

        if deleteZone
            if not na(zoneBox)
                box.delete(zoneBox)
            if not na(zoneLine)
                line.delete(zoneLine)
            if not na(zoneLabel)
                label.delete(zoneLabel)
            array.remove(obBoxes, i)
            array.remove(obEntryLines, i)
            array.remove(obLabels, i)
            array.remove(obTops, i)
            array.remove(obBottoms, i)
            array.remove(obBull, i)
            array.remove(obBreaker, i)
            array.remove(obFailed, i)
            array.remove(obCreatedBars, i)
            array.remove(obTouched, i)
            array.remove(obEntries, i)
            array.remove(obFailureBars, i)
            array.remove(obLeftBars, i)
            array.remove(obOriginOpens, i)
            array.remove(obOriginHighs, i)
            array.remove(obOriginLows, i)

//------------------------------------------------------------------------------
// Higher timeframe structure context
//------------------------------------------------------------------------------
htfPivotHigh = request.security(syminfo.tickerid, effectiveHtfTf, ta.pivothigh(high, htfSwingLen, htfSwingLen), lookahead=barmerge.lookahead_off)
htfPivotLow = request.security(syminfo.tickerid, effectiveHtfTf, ta.pivotlow(low, htfSwingLen, htfSwingLen), lookahead=barmerge.lookahead_off)
htfClose = request.security(syminfo.tickerid, effectiveHtfTf, close, lookahead=barmerge.lookahead_off)

var float htfStructureHigh = na
var float htfStructureLow = na
var int htfBias = 0

if htfContextReady
    if not na(htfPivotHigh)
        htfStructureHigh := htfPivotHigh
    if not na(htfPivotLow)
        htfStructureLow := htfPivotLow
    if not na(htfStructureHigh) and htfClose > htfStructureHigh
        htfBias := 1
    else if not na(htfStructureLow) and htfClose < htfStructureLow
        htfBias := -1
else
    htfStructureHigh := na
    htfStructureLow := na
    htfBias := 0

activeBias = not na(lastStructureBreakBar) and (bar_index - lastStructureBreakBar) > consolidationBars ? 0 : trendBias
strictKillzoneActive = timeframe.isintraday and not na(time(timeframe.period, strictKillzoneSession, ictSessionTimezone))
liquiditySessionSummary = liquiditySessionMode + " | Now " + currentSessionBlock + " -> Prev " + liquiditySessionLabel
killzoneSummary = "KZ LDN/NY AM/NY PM | " + (strictKillzoneActive ? "On" : "Off")
timezoneSummary = "TZ NY (DST)"
bullDealingRangeHigh = bullLegHigh
bullDealingRangeLow = bullLegLow
bearDealingRangeHigh = bearLegHigh
bearDealingRangeLow = bearLegLow
bullDealingRangeSize = not na(bullDealingRangeHigh) and not na(bullDealingRangeLow) ? bullDealingRangeHigh - bullDealingRangeLow : na
bearDealingRangeSize = not na(bearDealingRangeHigh) and not na(bearDealingRangeLow) ? bearDealingRangeHigh - bearDealingRangeLow : na
bullEquilibrium = not na(bullDealingRangeHigh) and not na(bullDealingRangeLow) ? (bullDealingRangeHigh + bullDealingRangeLow) * 0.5 : na
bearEquilibrium = not na(bearDealingRangeHigh) and not na(bearDealingRangeLow) ? (bearDealingRangeHigh + bearDealingRangeLow) * 0.5 : na
bullRangeHighActive = not na(bullRangeHighState) ? bullRangeHighState : bullDealingRangeHigh
bullRangeLowActive = not na(bullRangeLowState) ? bullRangeLowState : bullDealingRangeLow
bearRangeHighActive = not na(bearRangeHighState) ? bearRangeHighState : bearDealingRangeHigh
bearRangeLowActive = not na(bearRangeLowState) ? bearRangeLowState : bearDealingRangeLow
bullEquilibriumActive = not na(bullEquilibriumState) ? bullEquilibriumState : bullEquilibrium
bearEquilibriumActive = not na(bearEquilibriumState) ? bearEquilibriumState : bearEquilibrium
bullOteRawTop = not na(bullDealingRangeSize) and bullDealingRangeSize > 0 ? bullDealingRangeHigh - bullDealingRangeSize * 0.62 : na
bullOteRawBottom = not na(bullDealingRangeSize) and bullDealingRangeSize > 0 ? bullDealingRangeHigh - bullDealingRangeSize * 0.79 : na
bearOteRawTop = not na(bearDealingRangeSize) and bearDealingRangeSize > 0 ? bearDealingRangeLow + bearDealingRangeSize * 0.79 : na
bearOteRawBottom = not na(bearDealingRangeSize) and bearDealingRangeSize > 0 ? bearDealingRangeLow + bearDealingRangeSize * 0.62 : na

if bullMss
    bullOteTopState := bullOteRawTop
    bullOteBottomState := bullOteRawBottom
    bullOteCreatedBar := bar_index
    bullOteMitigated := false
    bullOteInvalidated := false

if bearMss
    bullOteInvalidated := true

if bearMss
    bearOteTopState := bearOteRawTop
    bearOteBottomState := bearOteRawBottom
    bearOteCreatedBar := bar_index
    bearOteMitigated := false
    bearOteInvalidated := false

if bullMss
    bearOteInvalidated := true

if not bullOteMitigated and not bullOteInvalidated and not na(bullOteCreatedBar) and bar_index > bullOteCreatedBar and f_zoneTouched(bullOteTopState, bullOteBottomState)
    bullOteMitigated := true

if not bearOteMitigated and not bearOteInvalidated and not na(bearOteCreatedBar) and bar_index > bearOteCreatedBar and f_zoneTouched(bearOteTopState, bearOteBottomState)
    bearOteMitigated := true

oteLongTop = activeBias == 1 and not bullOteMitigated and not bullOteInvalidated ? bullOteTopState : na
oteLongBottom = activeBias == 1 and not bullOteMitigated and not bullOteInvalidated ? bullOteBottomState : na
oteShortTop = activeBias == -1 and not bearOteMitigated and not bearOteInvalidated ? bearOteTopState : na
oteShortBottom = activeBias == -1 and not bearOteMitigated and not bearOteInvalidated ? bearOteBottomState : na
activeRangeHigh = activeBias == 1 ? bullRangeHighActive : activeBias == -1 ? bearRangeHighActive : na
activeRangeLow = activeBias == 1 ? bullRangeLowActive : activeBias == -1 ? bearRangeLowActive : na
activeRangeEquilibrium = activeBias == 1 ? bullEquilibriumActive : activeBias == -1 ? bearEquilibriumActive : na
activeProtectedHigh = activeBias == -1 ? protectedHigh : na
activeProtectedLow = activeBias == 1 ? protectedLow : na

//------------------------------------------------------------------------------
// Risk cues from latest live zone or structure
//------------------------------------------------------------------------------
float latestBullFvgTop = na
float latestBullFvgBottom = na
float latestBearFvgTop = na
float latestBearFvgBottom = na
int latestBullFvgCreatedBar = na
int latestBearFvgCreatedBar = na
bool latestBullFvgTouched = false
bool latestBearFvgTouched = false
float fallbackBullFvgTop = na
float fallbackBullFvgBottom = na
float fallbackBearFvgTop = na
float fallbackBearFvgBottom = na
int fallbackBullFvgCreatedBar = na
int fallbackBearFvgCreatedBar = na
bool fallbackBullFvgTouched = false
bool fallbackBearFvgTouched = false

if array.size(fvgBoxes) > 0
    for idx = 0 to array.size(fvgBoxes) - 1
        i = array.size(fvgBoxes) - 1 - idx
        zoneTop = array.get(fvgTops, i)
        zoneBottom = array.get(fvgBottoms, i)
        zoneBull = array.get(fvgBull, i)
        zoneCreatedBar = array.get(fvgCreatedBars, i)
        bullLegMatch = na(bullLegStartBar) or zoneCreatedBar >= bullLegStartBar
        bearLegMatch = na(bearLegStartBar) or zoneCreatedBar >= bearLegStartBar
        bullNarrativeMatch = bullLegMatch and not na(bullNarrativeStartBar) and not na(bullNarrativeEndBar) and zoneCreatedBar >= bullNarrativeStartBar and zoneCreatedBar <= bullNarrativeEndBar
        bearNarrativeMatch = bearLegMatch and not na(bearNarrativeStartBar) and not na(bearNarrativeEndBar) and zoneCreatedBar >= bearNarrativeStartBar and zoneCreatedBar <= bearNarrativeEndBar
        if zoneBull and bullNarrativeMatch and na(latestBullFvgTop)
            latestBullFvgTop := zoneTop
            latestBullFvgBottom := zoneBottom
            latestBullFvgCreatedBar := zoneCreatedBar
            latestBullFvgTouched := array.get(fvgTouched, i)
        else if zoneBull and bullLegMatch and na(fallbackBullFvgTop)
            fallbackBullFvgTop := zoneTop
            fallbackBullFvgBottom := zoneBottom
            fallbackBullFvgCreatedBar := zoneCreatedBar
            fallbackBullFvgTouched := array.get(fvgTouched, i)
        if not zoneBull and bearNarrativeMatch and na(latestBearFvgTop)
            latestBearFvgTop := zoneTop
            latestBearFvgBottom := zoneBottom
            latestBearFvgCreatedBar := zoneCreatedBar
            latestBearFvgTouched := array.get(fvgTouched, i)
        else if not zoneBull and bearLegMatch and na(fallbackBearFvgTop)
            fallbackBearFvgTop := zoneTop
            fallbackBearFvgBottom := zoneBottom
            fallbackBearFvgCreatedBar := zoneCreatedBar
            fallbackBearFvgTouched := array.get(fvgTouched, i)

if na(latestBullFvgTop)
    latestBullFvgTop := fallbackBullFvgTop
    latestBullFvgBottom := fallbackBullFvgBottom
    latestBullFvgCreatedBar := fallbackBullFvgCreatedBar
    latestBullFvgTouched := fallbackBullFvgTouched

if na(latestBearFvgTop)
    latestBearFvgTop := fallbackBearFvgTop
    latestBearFvgBottom := fallbackBearFvgBottom
    latestBearFvgCreatedBar := fallbackBearFvgCreatedBar
    latestBearFvgTouched := fallbackBearFvgTouched

float latestBullZoneTop = na
float latestBullZoneBottom = na
float latestBullEntry = na
bool latestBullZoneIsBreaker = false
int latestBullZoneCreatedBar = na
bool latestBullZoneTouched = false
float latestBearZoneBottom = na
float latestBearZoneTop = na
float latestBearEntry = na
bool latestBearZoneIsBreaker = false
int latestBearZoneCreatedBar = na
bool latestBearZoneTouched = false
float fallbackBullZoneTop = na
float fallbackBullZoneBottom = na
float fallbackBullEntry = na
bool fallbackBullZoneIsBreaker = false
int fallbackBullZoneCreatedBar = na
bool fallbackBullZoneTouched = false
float fallbackBearZoneBottom = na
float fallbackBearZoneTop = na
float fallbackBearEntry = na
bool fallbackBearZoneIsBreaker = false
int fallbackBearZoneCreatedBar = na
bool fallbackBearZoneTouched = false

if array.size(obBoxes) > 0
    for idx = 0 to array.size(obBoxes) - 1
        i = array.size(obBoxes) - 1 - idx
        zoneTop = array.get(obTops, i)
        zoneBottom = array.get(obBottoms, i)
        zoneBull = array.get(obBull, i)
        zoneBreaker = array.get(obBreaker, i)
        zoneFailed = array.get(obFailed, i)
        zoneCreatedBar = array.get(obCreatedBars, i)
        bullLegMatch = na(bullLegStartBar) or zoneCreatedBar >= bullLegStartBar
        bearLegMatch = na(bearLegStartBar) or zoneCreatedBar >= bearLegStartBar
        bullNarrativeMatch = bullLegMatch and not na(bullNarrativeStartBar) and not na(bullNarrativeEndBar) and zoneCreatedBar >= bullNarrativeStartBar and zoneCreatedBar <= bullNarrativeEndBar + 1
        bearNarrativeMatch = bearLegMatch and not na(bearNarrativeStartBar) and not na(bearNarrativeEndBar) and zoneCreatedBar >= bearNarrativeStartBar and zoneCreatedBar <= bearNarrativeEndBar + 1
        if zoneBull and not zoneFailed and bullNarrativeMatch and na(latestBullZoneBottom)
            latestBullZoneTop := zoneTop
            latestBullZoneBottom := zoneBottom
            latestBullEntry := array.get(obEntries, i)
            latestBullZoneIsBreaker := zoneBreaker
            latestBullZoneCreatedBar := zoneCreatedBar
            latestBullZoneTouched := array.get(obTouched, i)
        else if zoneBull and not zoneFailed and bullLegMatch and na(fallbackBullZoneBottom)
            fallbackBullZoneTop := zoneTop
            fallbackBullZoneBottom := zoneBottom
            fallbackBullEntry := array.get(obEntries, i)
            fallbackBullZoneIsBreaker := zoneBreaker
            fallbackBullZoneCreatedBar := zoneCreatedBar
            fallbackBullZoneTouched := array.get(obTouched, i)
        if not zoneBull and not zoneFailed and bearNarrativeMatch and na(latestBearZoneTop)
            latestBearZoneBottom := zoneBottom
            latestBearZoneTop := zoneTop
            latestBearEntry := array.get(obEntries, i)
            latestBearZoneIsBreaker := zoneBreaker
            latestBearZoneCreatedBar := zoneCreatedBar
            latestBearZoneTouched := array.get(obTouched, i)
        else if not zoneBull and not zoneFailed and bearLegMatch and na(fallbackBearZoneTop)
            fallbackBearZoneBottom := zoneBottom
            fallbackBearZoneTop := zoneTop
            fallbackBearEntry := array.get(obEntries, i)
            fallbackBearZoneIsBreaker := zoneBreaker
            fallbackBearZoneCreatedBar := zoneCreatedBar
            fallbackBearZoneTouched := array.get(obTouched, i)

if na(latestBullZoneBottom)
    latestBullZoneTop := fallbackBullZoneTop
    latestBullZoneBottom := fallbackBullZoneBottom
    latestBullEntry := fallbackBullEntry
    latestBullZoneIsBreaker := fallbackBullZoneIsBreaker
    latestBullZoneCreatedBar := fallbackBullZoneCreatedBar
    latestBullZoneTouched := fallbackBullZoneTouched

if na(latestBearZoneTop)
    latestBearZoneBottom := fallbackBearZoneBottom
    latestBearZoneTop := fallbackBearZoneTop
    latestBearEntry := fallbackBearEntry
    latestBearZoneIsBreaker := fallbackBearZoneIsBreaker
    latestBearZoneCreatedBar := fallbackBearZoneCreatedBar
    latestBearZoneTouched := fallbackBearZoneTouched

bool bullObPdPass = not na(latestBullZoneTop) and not na(bullEquilibriumActive) and f_zoneMid(latestBullZoneTop, latestBullZoneBottom) < bullEquilibriumActive
bool bullFvgPdPass = not na(latestBullFvgTop) and not na(bullEquilibriumActive) and f_zoneMid(latestBullFvgTop, latestBullFvgBottom) < bullEquilibriumActive
bool bearObPdPass = not na(latestBearZoneTop) and not na(bearEquilibriumActive) and f_zoneMid(latestBearZoneTop, latestBearZoneBottom) > bearEquilibriumActive
bool bearFvgPdPass = not na(latestBearFvgTop) and not na(bearEquilibriumActive) and f_zoneMid(latestBearFvgTop, latestBearFvgBottom) > bearEquilibriumActive
bool bullObOtePass = f_zoneIntersects(latestBullZoneTop, latestBullZoneBottom, oteLongTop, oteLongBottom)
bool bullFvgOtePass = f_zoneIntersects(latestBullFvgTop, latestBullFvgBottom, oteLongTop, oteLongBottom)
bool bearObOtePass = f_zoneIntersects(latestBearZoneTop, latestBearZoneBottom, oteShortTop, oteShortBottom)
bool bearFvgOtePass = f_zoneIntersects(latestBearFvgTop, latestBearFvgBottom, oteShortTop, oteShortBottom)
bool preferBullOb = not na(latestBullEntry) and (not strictModeEnabled or (bullObPdPass and bullObOtePass))
bool preferBullFvg = not na(latestBullFvgTop) and not na(latestBullFvgBottom) and (not strictModeEnabled or (bullFvgPdPass and bullFvgOtePass))
bool preferBearOb = not na(latestBearEntry) and (not strictModeEnabled or (bearObPdPass and bearObOtePass))
bool preferBearFvg = not na(latestBearFvgTop) and not na(latestBearFvgBottom) and (not strictModeEnabled or (bearFvgPdPass and bearFvgOtePass))

float tradeLongEntry = na
float tradeLongStop = na
float tradeLongTarget = na
bool longTargetIsLiquidity = false
string tradeLongSetup = "Waiting"
float tradeLongValidTop = na
float tradeLongValidBottom = na
bool tradeLongIsOb = false
bool tradeLongIsFvg = false
int tradeLongCreatedBar = na
bool tradeLongTouched = false

if preferBullOb
    tradeLongEntry := latestBullEntry
    tradeLongStop := latestBullZoneBottom - atr * stopAtrBuffer
    tradeLongSetup := latestBullZoneIsBreaker ? "Bullish Breaker" : "Bullish OB"
    tradeLongValidTop := latestBullZoneTop
    tradeLongValidBottom := latestBullZoneBottom
    tradeLongIsOb := true
    tradeLongCreatedBar := latestBullZoneCreatedBar
    tradeLongTouched := latestBullZoneTouched
else if preferBullFvg
    tradeLongEntry := f_zoneMid(latestBullFvgTop, latestBullFvgBottom)
    tradeLongStop := latestBullFvgBottom - atr * stopAtrBuffer
    tradeLongSetup := "Bullish FVG"
    tradeLongValidTop := latestBullFvgTop
    tradeLongValidBottom := latestBullFvgBottom
    tradeLongIsFvg := true
    tradeLongCreatedBar := latestBullFvgCreatedBar
    tradeLongTouched := latestBullFvgTouched

if not na(tradeLongEntry)
    tradeLongTarget := f_nearestAbove(tradeLongEntry, lastSwingHigh, activeEqh, enginePrevSessionHigh, enginePrevDayHigh, enginePrevWeekHigh, enginePrevMonthHigh, htfStructureHigh)
    longTargetIsLiquidity := not na(tradeLongTarget)
    float tempLongRisk = not na(tradeLongStop) ? tradeLongEntry - tradeLongStop : na
    if na(tradeLongTarget) and not na(tempLongRisk) and tempLongRisk > 0
        tradeLongTarget := tradeLongEntry + tempLongRisk * 2.0

float tradeShortEntry = na
float tradeShortStop = na
float tradeShortTarget = na
bool shortTargetIsLiquidity = false
string tradeShortSetup = "Waiting"
float tradeShortValidTop = na
float tradeShortValidBottom = na
bool tradeShortIsOb = false
bool tradeShortIsFvg = false
int tradeShortCreatedBar = na
bool tradeShortTouched = false

if preferBearOb
    tradeShortEntry := latestBearEntry
    tradeShortStop := latestBearZoneTop + atr * stopAtrBuffer
    tradeShortSetup := latestBearZoneIsBreaker ? "Bearish Breaker" : "Bearish OB"
    tradeShortValidTop := latestBearZoneTop
    tradeShortValidBottom := latestBearZoneBottom
    tradeShortIsOb := true
    tradeShortCreatedBar := latestBearZoneCreatedBar
    tradeShortTouched := latestBearZoneTouched
else if preferBearFvg
    tradeShortEntry := f_zoneMid(latestBearFvgTop, latestBearFvgBottom)
    tradeShortStop := latestBearFvgTop + atr * stopAtrBuffer
    tradeShortSetup := "Bearish FVG"
    tradeShortValidTop := latestBearFvgTop
    tradeShortValidBottom := latestBearFvgBottom
    tradeShortIsFvg := true
    tradeShortCreatedBar := latestBearFvgCreatedBar
    tradeShortTouched := latestBearFvgTouched

if not na(tradeShortEntry)
    tradeShortTarget := f_nearestBelow(tradeShortEntry, lastSwingLow, activeEql, enginePrevSessionLow, enginePrevDayLow, enginePrevWeekLow, enginePrevMonthLow, htfStructureLow)
    shortTargetIsLiquidity := not na(tradeShortTarget)
    float tempShortRisk = not na(tradeShortStop) ? tradeShortStop - tradeShortEntry : na
    if na(tradeShortTarget) and not na(tempShortRisk) and tempShortRisk > 0
        tradeShortTarget := tradeShortEntry - tempShortRisk * 2.0

float longRisk = not na(tradeLongEntry) and not na(tradeLongStop) ? tradeLongEntry - tradeLongStop : na
float longReward = not na(tradeLongEntry) and not na(tradeLongTarget) ? tradeLongTarget - tradeLongEntry : na
float longRr = not na(longRisk) and longRisk > 0 and not na(longReward) ? longReward / longRisk : na
bool longPriceInZone = not na(tradeLongValidBottom) and close >= tradeLongValidBottom and close <= tradeLongValidTop
bool longPriceNearZone = not na(tradeLongEntry) and math.abs(close - tradeLongEntry) <= atr * 0.25
int longSetupAge = not na(tradeLongCreatedBar) ? bar_index - tradeLongCreatedBar : na
bool longExpired = not tradeLongTouched and not na(longSetupAge) and longSetupAge > setupExpiryBars
bool longChased = not tradeLongTouched and not na(tradeLongValidTop) and close > tradeLongValidTop + atr * setupChaseAtr
bool longStructureInvalidated = not na(tradeLongCreatedBar) and not na(lastBearMssBar) and lastBearMssBar > tradeLongCreatedBar
bool longManaged = tradeLongTouched and not na(longRisk) and high >= tradeLongEntry + longRisk * setupManagedR
bool longFresh = not tradeLongTouched and not na(longSetupAge) and longSetupAge <= setupFreshBars
bool strictLongBiasPass = not strictModeEnabled or (activeBias == 1 and htfContextReady and htfBias == 1)
bool strictLongSweepPass = not strictModeEnabled or bullLegHasSweep
bool strictLongMssFresh = not na(lastBullMssBar) and (bar_index - lastBullMssBar) <= strictMssLookback
bool strictLongMssPass = not strictModeEnabled or (bullLegHasMss and strictLongMssFresh and activeBias == 1)
bool strictLongPdPass = not strictModeEnabled or (not na(tradeLongValidTop) and not na(bullEquilibriumActive) and f_zoneMid(tradeLongValidTop, tradeLongValidBottom) < bullEquilibriumActive)
bool strictLongOtePass = not strictModeEnabled or f_zoneIntersects(tradeLongValidTop, tradeLongValidBottom, oteLongTop, oteLongBottom)
bool strictLongKillzonePass = not strictModeEnabled or strictKillzoneActive
bool strictLongContextPass = strictLongBiasPass and strictLongSweepPass and strictLongMssPass and strictLongPdPass and strictLongOtePass
string strictLongMap = strictModeEnabled ? f_strictChecklist(strictLongBiasPass, strictLongSweepPass, strictLongMssPass, strictLongPdPass, strictLongOtePass, strictLongKillzonePass, false) : "Off"
string strictLongMapCompact = strictModeEnabled ? f_strictChecklist(strictLongBiasPass, strictLongSweepPass, strictLongMssPass, strictLongPdPass, strictLongOtePass, strictLongKillzonePass, true) : "Off"
var string lastLongSetupTag = ""
string currentLongSetupTag = not na(tradeLongCreatedBar) ? tradeLongSetup + "|" + str.tostring(tradeLongCreatedBar) : ""
bool longReplaced = currentLongSetupTag != "" and lastLongSetupTag != "" and currentLongSetupTag != lastLongSetupTag
lastLongSetupTag := currentLongSetupTag
bool longInvalidated = (not na(tradeLongStop) and close <= tradeLongStop) or longStructureInvalidated
string longStatus = f_setupStatus(not na(tradeLongEntry), not na(tradeLongStop) and close <= tradeLongStop, longStructureInvalidated, longReplaced, longExpired, longChased, longManaged, strictModeEnabled, strictLongContextPass, strictLongKillzonePass, longPriceInZone, longPriceNearZone, longFresh)

float shortRisk = not na(tradeShortEntry) and not na(tradeShortStop) ? tradeShortStop - tradeShortEntry : na
float shortReward = not na(tradeShortEntry) and not na(tradeShortTarget) ? tradeShortEntry - tradeShortTarget : na
float shortRr = not na(shortRisk) and shortRisk > 0 and not na(shortReward) ? shortReward / shortRisk : na
bool shortPriceInZone = not na(tradeShortValidBottom) and close >= tradeShortValidBottom and close <= tradeShortValidTop
bool shortPriceNearZone = not na(tradeShortEntry) and math.abs(close - tradeShortEntry) <= atr * 0.25
int shortSetupAge = not na(tradeShortCreatedBar) ? bar_index - tradeShortCreatedBar : na
bool shortExpired = not tradeShortTouched and not na(shortSetupAge) and shortSetupAge > setupExpiryBars
bool shortChased = not tradeShortTouched and not na(tradeShortValidBottom) and close < tradeShortValidBottom - atr * setupChaseAtr
bool shortStructureInvalidated = not na(tradeShortCreatedBar) and not na(lastBullMssBar) and lastBullMssBar > tradeShortCreatedBar
bool shortManaged = tradeShortTouched and not na(shortRisk) and low <= tradeShortEntry - shortRisk * setupManagedR
bool shortFresh = not tradeShortTouched and not na(shortSetupAge) and shortSetupAge <= setupFreshBars
bool strictShortBiasPass = not strictModeEnabled or (activeBias == -1 and htfContextReady and htfBias == -1)
bool strictShortSweepPass = not strictModeEnabled or bearLegHasSweep
bool strictShortMssFresh = not na(lastBearMssBar) and (bar_index - lastBearMssBar) <= strictMssLookback
bool strictShortMssPass = not strictModeEnabled or (bearLegHasMss and strictShortMssFresh and activeBias == -1)
bool strictShortPdPass = not strictModeEnabled or (not na(tradeShortValidTop) and not na(bearEquilibriumActive) and f_zoneMid(tradeShortValidTop, tradeShortValidBottom) > bearEquilibriumActive)
bool strictShortOtePass = not strictModeEnabled or f_zoneIntersects(tradeShortValidTop, tradeShortValidBottom, oteShortTop, oteShortBottom)
bool strictShortKillzonePass = not strictModeEnabled or strictKillzoneActive
bool strictShortContextPass = strictShortBiasPass and strictShortSweepPass and strictShortMssPass and strictShortPdPass and strictShortOtePass
string strictShortMap = strictModeEnabled ? f_strictChecklist(strictShortBiasPass, strictShortSweepPass, strictShortMssPass, strictShortPdPass, strictShortOtePass, strictShortKillzonePass, false) : "Off"
string strictShortMapCompact = strictModeEnabled ? f_strictChecklist(strictShortBiasPass, strictShortSweepPass, strictShortMssPass, strictShortPdPass, strictShortOtePass, strictShortKillzonePass, true) : "Off"
var string lastShortSetupTag = ""
string currentShortSetupTag = not na(tradeShortCreatedBar) ? tradeShortSetup + "|" + str.tostring(tradeShortCreatedBar) : ""
bool shortReplaced = currentShortSetupTag != "" and lastShortSetupTag != "" and currentShortSetupTag != lastShortSetupTag
lastShortSetupTag := currentShortSetupTag
bool shortInvalidated = (not na(tradeShortStop) and close >= tradeShortStop) or shortStructureInvalidated
string shortStatus = f_setupStatus(not na(tradeShortEntry), not na(tradeShortStop) and close >= tradeShortStop, shortStructureInvalidated, shortReplaced, shortExpired, shortChased, shortManaged, strictModeEnabled, strictShortContextPass, strictShortKillzonePass, shortPriceInZone, shortPriceNearZone, shortFresh)

// Keep setup scoring intentionally simple to reduce overtuning.
bool longBiasAligned = activeBias == 1
bool shortBiasAligned = activeBias == -1
bool longHtfAligned = htfBias == 1
bool shortHtfAligned = htfBias == -1
bool longDisplacementSeen = bullLegHasDisplacement
bool shortDisplacementSeen = bearLegHasDisplacement

float longConfidence = f_setupScore(not na(tradeLongEntry), longBiasAligned, longHtfAligned, bullLegHasSweep, longDisplacementSeen, tradeLongIsOb, tradeLongIsFvg, longPriceInZone, longPriceNearZone, longRr, longFresh, longManaged, strictModeEnabled, strictLongContextPass, strictLongKillzonePass, longReplaced, longChased, longExpired, longInvalidated)
float longTpProbability = f_tpProbability(longConfidence, longRr, longPriceInZone, longPriceNearZone, longManaged, strictModeEnabled, strictLongContextPass, strictLongKillzonePass, longChased, longExpired, longInvalidated)

float shortConfidence = f_setupScore(not na(tradeShortEntry), shortBiasAligned, shortHtfAligned, bearLegHasSweep, shortDisplacementSeen, tradeShortIsOb, tradeShortIsFvg, shortPriceInZone, shortPriceNearZone, shortRr, shortFresh, shortManaged, strictModeEnabled, strictShortContextPass, strictShortKillzonePass, shortReplaced, shortChased, shortExpired, shortInvalidated)
float shortTpProbability = f_tpProbability(shortConfidence, shortRr, shortPriceInZone, shortPriceNearZone, shortManaged, strictModeEnabled, strictShortContextPass, strictShortKillzonePass, shortChased, shortExpired, shortInvalidated)

int selectedBullFvgBar = tradeLongIsFvg ? tradeLongCreatedBar : na
int selectedBearFvgBar = tradeShortIsFvg ? tradeShortCreatedBar : na
int selectedBullObBar = tradeLongIsOb ? tradeLongCreatedBar : na
int selectedBearObBar = tradeShortIsOb ? tradeShortCreatedBar : na
bool anyLiquidityTarget = (not na(tradeLongTarget) and longTargetIsLiquidity) or (not na(tradeShortTarget) and shortTargetIsLiquidity)
bool anyFallbackTarget = (not na(tradeLongTarget) and not longTargetIsLiquidity) or (not na(tradeShortTarget) and not shortTargetIsLiquidity)
string opTargetSummary = not anyLiquidityTarget and not anyFallbackTarget ? "-" : anyLiquidityTarget and anyFallbackTarget ? "Liquidity / 2R fallback" : anyLiquidityTarget ? "Nearest liquidity" : "Fallback 2R"

if array.size(pivotStructureLabels) > 0
    for idx = 0 to array.size(pivotStructureLabels) - 1
        i = array.size(pivotStructureLabels) - 1 - idx
        pivotLabel = array.get(pivotStructureLabels, i)
        pivotIsHigh = array.get(pivotStructureIsHigh, i)
        if not na(pivotLabel)
            label.set_color(pivotLabel, displayStructureLabels ? color.new(pivotIsHigh ? liqHighColor : liqLowColor, 0) : na)
            label.set_textcolor(pivotLabel, displayStructureLabels ? color.white : na)

if array.size(structureEventLines) > 0
    for idx = 0 to array.size(structureEventLines) - 1
        i = array.size(structureEventLines) - 1 - idx
        eventLine = array.get(structureEventLines, i)
        eventLabel = array.get(structureEventLabels, i)
        eventIsBull = array.get(structureEventBull, i)
        eventColor = eventIsBull ? bullColor : bearColor
        if not na(eventLine)
            line.set_color(eventLine, showBosChoch ? eventColor : na)
        if not na(eventLabel)
            label.set_color(eventLabel, showBosChoch ? eventColor : na)
            label.set_textcolor(eventLabel, showBosChoch ? color.white : na)

if array.size(fvgBoxes) > 0
    for idx = 0 to array.size(fvgBoxes) - 1
        i = array.size(fvgBoxes) - 1 - idx
        f_ensureFvgVisual(i)
        zoneBox = array.get(fvgBoxes, i)
        zoneLabel = array.get(fvgLabels, i)
        zoneBull = array.get(fvgBull, i)
        zoneCreatedBar = array.get(fvgCreatedBars, i)
        zoneTouched = array.get(fvgTouched, i)
        isSelected = (zoneBull and not na(selectedBullFvgBar) and zoneCreatedBar == selectedBullFvgBar) or (not zoneBull and not na(selectedBearFvgBar) and zoneCreatedBar == selectedBearFvgBar)
        if not showFvg
            if not na(zoneBox)
                box.set_border_color(zoneBox, na)
                box.set_bgcolor(zoneBox, na)
            if not na(zoneLabel)
                label.set_color(zoneLabel, na)
                label.set_textcolor(zoneLabel, na)
        else
            if not na(zoneBox)
                baseBorder = zoneBull ? color.new(bullColor, 30) : color.new(bearColor, 30)
                baseFill = zoneBull ? fvgBullColor : fvgBearColor
                touchedBorder = zoneBull ? color.new(bullColor, 55) : color.new(bearColor, 55)
                touchedFill = zoneBull ? color.new(bullColor, 90) : color.new(bearColor, 90)
                selectedBorder = zoneBull ? color.new(bullColor, 0) : color.new(bearColor, 0)
                selectedFill = zoneBull ? color.new(bullColor, 78) : color.new(bearColor, 78)
                box.set_border_color(zoneBox, isSelected ? selectedBorder : zoneTouched ? touchedBorder : baseBorder)
                box.set_bgcolor(zoneBox, isSelected ? selectedFill : zoneTouched ? touchedFill : baseFill)
            if not na(zoneLabel)
                if isSelected
                    label.set_x(zoneLabel, bar_index)
                label.set_color(zoneLabel, isSelected ? (zoneBull ? bullColor : bearColor) : zoneTouched ? (zoneBull ? color.new(bullColor, 55) : color.new(bearColor, 55)) : (zoneBull ? color.new(bullColor, 30) : color.new(bearColor, 30)))
                label.set_textcolor(zoneLabel, color.white)

if array.size(obBoxes) > 0
    for idx = 0 to array.size(obBoxes) - 1
        i = array.size(obBoxes) - 1 - idx
        f_ensureObVisual(i)
        zoneBox = array.get(obBoxes, i)
        zoneLine = array.get(obEntryLines, i)
        zoneLabel = array.get(obLabels, i)
        zoneBull = array.get(obBull, i)
        zoneBreaker = array.get(obBreaker, i)
        zoneFailed = array.get(obFailed, i)
        zoneCreatedBar = array.get(obCreatedBars, i)
        zoneLeftBar = array.get(obLeftBars, i)
        isSelected = (zoneBull and not zoneBreaker and not na(selectedBullObBar) and zoneCreatedBar == selectedBullObBar) or (not zoneBull and not zoneBreaker and not na(selectedBearObBar) and zoneCreatedBar == selectedBearObBar) or (zoneBull and zoneBreaker and not na(selectedBullObBar) and zoneCreatedBar == selectedBullObBar) or (not zoneBull and zoneBreaker and not na(selectedBearObBar) and zoneCreatedBar == selectedBearObBar)
        if not showOb
            if not na(zoneBox)
                box.set_border_color(zoneBox, na)
                box.set_bgcolor(zoneBox, na)
            if not na(zoneLine)
                line.set_color(zoneLine, na)
            if not na(zoneLabel)
                label.set_color(zoneLabel, na)
                label.set_textcolor(zoneLabel, na)
        else
            if not na(zoneBox)
                normalFill = zoneBreaker ? (zoneBull ? bbBullColor : bbBearColor) : (zoneBull ? obBullColor : obBearColor)
                normalBorder = zoneBull ? bullColor : bearColor
                selectedFill = zoneBreaker ? (zoneBull ? color.new(bullColor, 68) : color.new(bearColor, 68)) : (zoneBull ? color.new(bullColor, 72) : color.new(bearColor, 72))
                selectedBorder = zoneBull ? color.new(bullColor, 0) : color.new(bearColor, 0)
                failedFill = zoneBull ? color.new(bearColor, 90) : color.new(bullColor, 90)
                failedBorder = zoneBull ? color.new(bearColor, 35) : color.new(bullColor, 35)
                box.set_bgcolor(zoneBox, zoneFailed ? failedFill : isSelected ? selectedFill : normalFill)
                box.set_border_color(zoneBox, zoneFailed ? failedBorder : isSelected ? selectedBorder : color.new(normalBorder, 0))
            if not na(zoneLine)
                lineColor = zoneFailed ? (zoneBull ? color.new(bearColor, 20) : color.new(bullColor, 20)) : (zoneBull ? bullColor : bearColor)
                line.set_color(zoneLine, lineColor)
                line.set_style(zoneLine, zoneBreaker or zoneFailed ? line.style_dotted : line.style_dashed)
                line.set_width(zoneLine, isSelected ? 2 : 1)
            if not na(zoneLabel)
                if isSelected
                    label.set_x(zoneLabel, bar_index)
                label.set_color(zoneLabel, zoneFailed ? (zoneBull ? color.new(bearColor, 20) : color.new(bullColor, 20)) : isSelected ? (zoneBull ? bullColor : bearColor) : (zoneBull ? color.new(bullColor, 0) : color.new(bearColor, 0)))
                label.set_textcolor(zoneLabel, color.white)

string preferredDirection = "Wait"
bool longActionable = f_isActionable(longStatus)
bool shortActionable = f_isActionable(shortStatus)
if strictModeEnabled
    longActionable := longActionable and strictLongContextPass and strictLongKillzonePass
    shortActionable := shortActionable and strictShortContextPass and strictShortKillzonePass
if not na(longConfidence) or not na(shortConfidence)
    if na(shortConfidence) or (not na(longConfidence) and longConfidence > shortConfidence + 3.0)
        preferredDirection := longActionable ? "Long" : "Wait"
    else if na(longConfidence) or shortConfidence > longConfidence + 3.0
        preferredDirection := shortActionable ? "Short" : "Wait"
    else
        preferredDirection := "Balanced"

bool compactUseLong = preferredDirection == "Long" or (preferredDirection == "Balanced" and not na(longConfidence) and (na(shortConfidence) or longConfidence >= shortConfidence))
if preferredDirection == "Wait" and na(longConfidence) and not na(shortConfidence)
    compactUseLong := false

if effectiveZoneDisplayMode != "Full"
    if array.size(fvgBoxes) > 0
        for idx = 0 to array.size(fvgBoxes) - 1
            i = array.size(fvgBoxes) - 1 - idx
            zoneBox = array.get(fvgBoxes, i)
            zoneLabel = array.get(fvgLabels, i)
            zoneBull = array.get(fvgBull, i)
            zoneCreatedBar = array.get(fvgCreatedBars, i)
            isSelected = (zoneBull and not na(selectedBullFvgBar) and zoneCreatedBar == selectedBullFvgBar) or (not zoneBull and not na(selectedBearFvgBar) and zoneCreatedBar == selectedBearFvgBar)
            showZone = showFvg and f_zoneVisibleByMode(effectiveZoneDisplayMode, isSelected, zoneBull, preferredDirection, compactUseLong)
            if not showZone
                if not na(zoneBox)
                    box.set_border_color(zoneBox, na)
                    box.set_bgcolor(zoneBox, na)
                if not na(zoneLabel)
                    label.set_color(zoneLabel, na)
                    label.set_textcolor(zoneLabel, na)
            else if not na(zoneLabel)
                label.set_textcolor(zoneLabel, color.white)

    if array.size(obBoxes) > 0
        for idx = 0 to array.size(obBoxes) - 1
            i = array.size(obBoxes) - 1 - idx
            zoneBox = array.get(obBoxes, i)
            zoneLine = array.get(obEntryLines, i)
            zoneLabel = array.get(obLabels, i)
            zoneBull = array.get(obBull, i)
            zoneCreatedBar = array.get(obCreatedBars, i)
            isSelected = (zoneBull and not na(selectedBullObBar) and zoneCreatedBar == selectedBullObBar) or (not zoneBull and not na(selectedBearObBar) and zoneCreatedBar == selectedBearObBar)
            showZone = showOb and f_zoneVisibleByMode(effectiveZoneDisplayMode, isSelected, zoneBull, preferredDirection, compactUseLong)
            if not showZone
                if not na(zoneBox)
                    box.set_border_color(zoneBox, na)
                    box.set_bgcolor(zoneBox, na)
                if not na(zoneLine)
                    line.set_color(zoneLine, na)
                if not na(zoneLabel)
                    label.set_color(zoneLabel, na)
                    label.set_textcolor(zoneLabel, na)
            else if not na(zoneLabel)
                label.set_textcolor(zoneLabel, color.white)

string compactSetup = compactUseLong ? tradeLongSetup : tradeShortSetup
string compactStatus = compactUseLong ? longStatus : shortStatus
float compactZoneTop = compactUseLong ? tradeLongValidTop : tradeShortValidTop
float compactZoneBottom = compactUseLong ? tradeLongValidBottom : tradeShortValidBottom
float compactEntry = compactUseLong ? tradeLongEntry : tradeShortEntry
float compactStop = compactUseLong ? tradeLongStop : tradeShortStop
float compactTarget = compactUseLong ? tradeLongTarget : tradeShortTarget
float compactRr = compactUseLong ? longRr : shortRr
float compactConfidence = compactUseLong ? longConfidence : shortConfidence
float compactTpProbability = compactUseLong ? longTpProbability : shortTpProbability
bool compactBalanced = preferredDirection == "Balanced"
color compactAccent = compactBalanced ? color.new(neutralColor, 12) : compactUseLong ? color.new(bullColor, 12) : color.new(bearColor, 12)
string compactDirectionText = compactBalanced ? "Balanced" : preferredDirection == "Wait" ? "Wait" : compactUseLong ? "Long" : "Short"
string compactSetupDisplay = compactBalanced ? "Both active" : compactSetup
string compactZoneDisplay = compactBalanced ? "-" : f_formatRange(compactZoneTop, compactZoneBottom)
string compactEntryTriplet = compactBalanced ? "-" : f_formatLevel(compactEntry) + " | " + f_formatLevel(compactStop) + " | " + f_formatLevel(compactTarget)
string compactStatusDisplay = compactBalanced ? "Mixed" : f_statusCompact(compactStatus)
string compactConfTpLabel = compactBalanced ? "Conf L/S" : "Conf / TP"
string compactConfTpDisplay = compactBalanced ? "L " + f_formatPercent(longConfidence) + " / S " + f_formatPercent(shortConfidence) : f_formatPercent(compactConfidence) + " / " + f_formatPercent(compactTpProbability)
string compactLifecycleDisplay = compactBalanced ? "Mixed" : f_compactLifecycleText(compactUseLong, longSetupAge, tradeLongTouched, shortSetupAge, tradeShortTouched)
string compactRrDrawDisplay = "-"

bullStop = not na(tradeLongStop) ? tradeLongStop : not na(lastSwingLow) ? lastSwingLow - atr * stopAtrBuffer : na
bearStop = not na(tradeShortStop) ? tradeShortStop : not na(lastSwingHigh) ? lastSwingHigh + atr * stopAtrBuffer : na

//------------------------------------------------------------------------------
// Zone visual policy matrix
// Fresh / live FVG, OB, Breaker:
//   Engine: keep if actionable
//   Full: show
//   Focused: show only selected active zone
//   Minimal: show only selected zone in preferred direction
// Failed OB:
//   Engine: temporary transition only
//   Full: show muted
//   Focused / Minimal: hide
// Retired FVG / deleted OB / swept EQH-EQL:
//   Engine: remove / deactivate
//   Visual: never show
// Liquidity targets (session/day/week/month/EQH/EQL):
//   Full: show all active references
//   Focused / Minimal: show nearest selected target + one primary external draw
// Context ranges:
//   Full / Focused: show
//   Minimal: hide except protected level and active OTE
//------------------------------------------------------------------------------
longExternalDraw = longActionable and not na(tradeLongEntry) ? f_nearestAbove(tradeLongEntry, enginePrevDayHigh, enginePrevWeekHigh, enginePrevMonthHigh, htfStructureHigh, na, na, na) : na
shortExternalDraw = shortActionable and not na(tradeShortEntry) ? f_nearestBelow(tradeShortEntry, enginePrevDayLow, enginePrevWeekLow, enginePrevMonthLow, htfStructureLow, na, na, na) : na
primaryExternalDrawLevel = compactUseLong ? longExternalDraw : shortExternalDraw
compactRrDrawDisplay := compactBalanced ? "-" : f_formatRr(compactRr) + " | " + f_formatLevel(primaryExternalDrawLevel)
targetPrevSessionHigh = f_preferredLevelMatch(prevSessionHigh, compactBalanced, compactUseLong, tradeLongTarget, tradeShortTarget)
targetPrevSessionLow = f_preferredLevelMatch(prevSessionLow, compactBalanced, compactUseLong, tradeLongTarget, tradeShortTarget)
targetPrevDayHigh = f_preferredLevelMatch(prevDayHigh, compactBalanced, compactUseLong, tradeLongTarget, tradeShortTarget)
targetPrevDayLow = f_preferredLevelMatch(prevDayLow, compactBalanced, compactUseLong, tradeLongTarget, tradeShortTarget)
targetPrevWeekHigh = f_preferredLevelMatch(prevWeekHigh, compactBalanced, compactUseLong, tradeLongTarget, tradeShortTarget)
targetPrevWeekLow = f_preferredLevelMatch(prevWeekLow, compactBalanced, compactUseLong, tradeLongTarget, tradeShortTarget)
targetPrevMonthHigh = f_preferredLevelMatch(prevMonthHigh, compactBalanced, compactUseLong, tradeLongTarget, tradeShortTarget)
targetPrevMonthLow = f_preferredLevelMatch(prevMonthLow, compactBalanced, compactUseLong, tradeLongTarget, tradeShortTarget)
targetEqHigh = f_preferredLevelMatch(activeEqh, compactBalanced, compactUseLong, tradeLongTarget, tradeShortTarget)
targetEqLow = f_preferredLevelMatch(activeEql, compactBalanced, compactUseLong, tradeLongTarget, tradeShortTarget)
drawPrevDayHigh = f_preferredLevelMatch(prevDayHigh, compactBalanced, compactUseLong, longExternalDraw, shortExternalDraw)
drawPrevDayLow = f_preferredLevelMatch(prevDayLow, compactBalanced, compactUseLong, longExternalDraw, shortExternalDraw)
drawPrevWeekHigh = f_preferredLevelMatch(prevWeekHigh, compactBalanced, compactUseLong, longExternalDraw, shortExternalDraw)
drawPrevWeekLow = f_preferredLevelMatch(prevWeekLow, compactBalanced, compactUseLong, longExternalDraw, shortExternalDraw)
drawPrevMonthHigh = f_preferredLevelMatch(prevMonthHigh, compactBalanced, compactUseLong, longExternalDraw, shortExternalDraw)
drawPrevMonthLow = f_preferredLevelMatch(prevMonthLow, compactBalanced, compactUseLong, longExternalDraw, shortExternalDraw)
drawHtfHigh = f_preferredLevelMatch(htfStructureHigh, compactBalanced, compactUseLong, longExternalDraw, shortExternalDraw)
drawHtfLow = f_preferredLevelMatch(htfStructureLow, compactBalanced, compactUseLong, longExternalDraw, shortExternalDraw)

showPrevSessionHighVisual = showLiquidity and showPrevSession and f_targetVisualByMode(effectiveZoneDisplayMode, targetPrevSessionHigh)
showPrevSessionLowVisual = showLiquidity and showPrevSession and f_targetVisualByMode(effectiveZoneDisplayMode, targetPrevSessionLow)
showPrevDayHighVisual = showLiquidity and showHigherPeriodLiquidity and f_targetVisualByMode(effectiveZoneDisplayMode, targetPrevDayHigh or drawPrevDayHigh)
showPrevDayLowVisual = showLiquidity and showHigherPeriodLiquidity and f_targetVisualByMode(effectiveZoneDisplayMode, targetPrevDayLow or drawPrevDayLow)
showPrevWeekHighVisual = showLiquidity and displayWeekMonthLiquidity and f_targetVisualByMode(effectiveZoneDisplayMode, targetPrevWeekHigh or drawPrevWeekHigh)
showPrevWeekLowVisual = showLiquidity and displayWeekMonthLiquidity and f_targetVisualByMode(effectiveZoneDisplayMode, targetPrevWeekLow or drawPrevWeekLow)
showPrevMonthHighVisual = showLiquidity and displayWeekMonthLiquidity and f_targetVisualByMode(effectiveZoneDisplayMode, targetPrevMonthHigh or drawPrevMonthHigh)
showPrevMonthLowVisual = showLiquidity and displayWeekMonthLiquidity and f_targetVisualByMode(effectiveZoneDisplayMode, targetPrevMonthLow or drawPrevMonthLow)
showEqHighVisual = showLiquidity and displayEqLiquidity and f_targetVisualByMode(effectiveZoneDisplayMode, targetEqHigh)
showEqLowVisual = showLiquidity and displayEqLiquidity and f_targetVisualByMode(effectiveZoneDisplayMode, targetEqLow)
showProtectedHighVisual = displayProtectedLevels
showProtectedLowVisual = displayProtectedLevels
showRangeVisual = showLiquidity and displayDealingRange and f_contextVisualByMode(effectiveZoneDisplayMode)
showOteVisual = showOteEffective
showHtfHighVisual = displayHtfLines and htfContextReady and f_targetVisualByMode(effectiveZoneDisplayMode, drawHtfHigh)
showHtfLowVisual = displayHtfLines and htfContextReady and f_targetVisualByMode(effectiveZoneDisplayMode, drawHtfLow)

if effectiveZoneDisplayMode != "Full"
    showPrevMonthHighVisual := f_uniqueLevelVisual(showPrevMonthHighVisual, prevMonthHigh, showHtfHighVisual, htfStructureHigh, false, na, false, na, false, na, false, na)
    showPrevWeekHighVisual := f_uniqueLevelVisual(showPrevWeekHighVisual, prevWeekHigh, showHtfHighVisual, htfStructureHigh, showPrevMonthHighVisual, prevMonthHigh, false, na, false, na, false, na)
    showPrevDayHighVisual := f_uniqueLevelVisual(showPrevDayHighVisual, prevDayHigh, showHtfHighVisual, htfStructureHigh, showPrevMonthHighVisual, prevMonthHigh, showPrevWeekHighVisual, prevWeekHigh, false, na, false, na)
    showPrevSessionHighVisual := f_uniqueLevelVisual(showPrevSessionHighVisual, prevSessionHigh, showHtfHighVisual, htfStructureHigh, showPrevMonthHighVisual, prevMonthHigh, showPrevWeekHighVisual, prevWeekHigh, showPrevDayHighVisual, prevDayHigh, false, na)
    showEqHighVisual := f_uniqueLevelVisual(showEqHighVisual, activeEqh, showHtfHighVisual, htfStructureHigh, showPrevMonthHighVisual, prevMonthHigh, showPrevWeekHighVisual, prevWeekHigh, showPrevDayHighVisual, prevDayHigh, showPrevSessionHighVisual, prevSessionHigh)

    showPrevMonthLowVisual := f_uniqueLevelVisual(showPrevMonthLowVisual, prevMonthLow, showHtfLowVisual, htfStructureLow, false, na, false, na, false, na, false, na)
    showPrevWeekLowVisual := f_uniqueLevelVisual(showPrevWeekLowVisual, prevWeekLow, showHtfLowVisual, htfStructureLow, showPrevMonthLowVisual, prevMonthLow, false, na, false, na, false, na)
    showPrevDayLowVisual := f_uniqueLevelVisual(showPrevDayLowVisual, prevDayLow, showHtfLowVisual, htfStructureLow, showPrevMonthLowVisual, prevMonthLow, showPrevWeekLowVisual, prevWeekLow, false, na, false, na)
    showPrevSessionLowVisual := f_uniqueLevelVisual(showPrevSessionLowVisual, prevSessionLow, showHtfLowVisual, htfStructureLow, showPrevMonthLowVisual, prevMonthLow, showPrevWeekLowVisual, prevWeekLow, showPrevDayLowVisual, prevDayLow, false, na)
    showEqLowVisual := f_uniqueLevelVisual(showEqLowVisual, activeEql, showHtfLowVisual, htfStructureLow, showPrevMonthLowVisual, prevMonthLow, showPrevWeekLowVisual, prevWeekLow, showPrevDayLowVisual, prevDayLow, showPrevSessionLowVisual, prevSessionLow)

//------------------------------------------------------------------------------
// Plots
//------------------------------------------------------------------------------
prevSessionHighLevel = f_horizontalLevel(prevSessionHigh, showPrevSessionHighVisual)
prevSessionLowLevel = f_horizontalLevel(prevSessionLow, showPrevSessionLowVisual)
prevDayHighLevel = f_horizontalLevel(prevDayHigh, showPrevDayHighVisual)
prevDayLowLevel = f_horizontalLevel(prevDayLow, showPrevDayLowVisual)
prevWeekHighLevel = f_horizontalLevel(prevWeekHigh, showPrevWeekHighVisual)
prevWeekLowLevel = f_horizontalLevel(prevWeekLow, showPrevWeekLowVisual)
prevMonthHighLevel = f_horizontalLevel(prevMonthHigh, showPrevMonthHighVisual)
prevMonthLowLevel = f_horizontalLevel(prevMonthLow, showPrevMonthLowVisual)
eqHighLevel = f_horizontalLevel(activeEqh, showEqHighVisual)
eqLowLevel = f_horizontalLevel(activeEql, showEqLowVisual)
protectedHighLevel = f_horizontalLevel(activeProtectedHigh, showProtectedHighVisual)
protectedLowLevel = f_horizontalLevel(activeProtectedLow, showProtectedLowVisual)
internalHighLevel = f_horizontalLevel(activeRangeHigh, showRangeVisual)
internalLowLevel = f_horizontalLevel(activeRangeLow, showRangeVisual)
internalEqLevel = f_horizontalLevel(activeRangeEquilibrium, showRangeVisual)
htfStructureHighLevel = f_horizontalLevel(htfStructureHigh, showHtfHighVisual)
htfStructureLowLevel = f_horizontalLevel(htfStructureLow, showHtfLowVisual)
riskLongEntryLevel = f_horizontalLevel(tradeLongEntry, displayRiskLines)
riskShortEntryLevel = f_horizontalLevel(tradeShortEntry, displayRiskLines)
riskBullStopLevel = f_horizontalLevel(bullStop, displayRiskLines)
riskBearStopLevel = f_horizontalLevel(bearStop, displayRiskLines)
riskLongTargetLevel = f_horizontalLevel(tradeLongTarget, displayRiskLines)
riskShortTargetLevel = f_horizontalLevel(tradeShortTarget, displayRiskLines)
oteLongTopLevel = f_horizontalLevel(oteLongTop, showOteVisual)
oteLongBottomLevel = f_horizontalLevel(oteLongBottom, showOteVisual)
oteShortTopLevel = f_horizontalLevel(oteShortTop, showOteVisual)
oteShortBottomLevel = f_horizontalLevel(oteShortBottom, showOteVisual)
oteLongMid = not na(oteLongTop) and not na(oteLongBottom) ? f_zoneMid(oteLongTop, oteLongBottom) : na
oteShortMid = not na(oteShortTop) and not na(oteShortBottom) ? f_zoneMid(oteShortTop, oteShortBottom) : na
oteLongMidLevel = not na(oteLongTopLevel) and not na(oteLongBottomLevel) ? f_zoneMid(oteLongTopLevel, oteLongBottomLevel) : na
oteShortMidLevel = not na(oteShortTopLevel) and not na(oteShortBottomLevel) ? f_zoneMid(oteShortTopLevel, oteShortBottomLevel) : na

plotPrevSessionHigh = plot(prevSessionHighLevel, "Previous Source High", color=color.new(liqHighColor, 20), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plotPrevSessionLow = plot(prevSessionLowLevel, "Previous Source Low", color=color.new(liqLowColor, 20), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plotPrevDayHigh = plot(prevDayHighLevel, "PDH", color=color.new(liqHighColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plotPrevDayLow = plot(prevDayLowLevel, "PDL", color=color.new(liqLowColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plotPrevWeekHigh = plot(prevWeekHighLevel, "PWH", color=color.new(liqHighColor, 30), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plotPrevWeekLow = plot(prevWeekLowLevel, "PWL", color=color.new(liqLowColor, 30), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plotPrevMonthHigh = plot(prevMonthHighLevel, "PMH", color=color.new(liqHighColor, 55), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plotPrevMonthLow = plot(prevMonthLowLevel, "PML", color=color.new(liqLowColor, 55), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plotEqHigh = plot(eqHighLevel, "EQH Liquidity", color=color.new(liqHighColor, 12), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plotEqLow = plot(eqLowLevel, "EQL Liquidity", color=color.new(liqLowColor, 12), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)

protectedHighPlot = plot(protectedHighLevel, "Protected High", color=color.new(liqHighColor, 8), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
protectedLowPlot = plot(protectedLowLevel, "Protected Low", color=color.new(liqLowColor, 8), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)

internalHighPlot = plot(internalHighLevel, "ICT Dealing Range High", color=color.new(color.silver, 20), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
internalLowPlot = plot(internalLowLevel, "ICT Dealing Range Low", color=color.new(color.silver, 20), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
internalEqPlot = plot(internalEqLevel, "ICT Equilibrium", color=color.new(neutralColor, 20), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)

if barstate.islast
    prevSessionHighLabel := f_syncRightEdgeLabel(prevSessionHighLabel, prevSessionHighLevel, "Src H", color.new(liqHighColor, 5), color.white, displayLiquidityRightLabels and showPrevSessionHighVisual)
    prevSessionLowLabel := f_syncRightEdgeLabel(prevSessionLowLabel, prevSessionLowLevel, "Src L", color.new(liqLowColor, 5), color.white, displayLiquidityRightLabels and showPrevSessionLowVisual)
    prevDayHighLabel := f_syncRightEdgeLabel(prevDayHighLabel, prevDayHighLevel, "PDH", color.new(liqHighColor, 0), color.white, displayLiquidityRightLabels and showPrevDayHighVisual)
    prevDayLowLabel := f_syncRightEdgeLabel(prevDayLowLabel, prevDayLowLevel, "PDL", color.new(liqLowColor, 0), color.white, displayLiquidityRightLabels and showPrevDayLowVisual)
    prevWeekHighLabel := f_syncRightEdgeLabel(prevWeekHighLabel, prevWeekHighLevel, "PWH", color.new(liqHighColor, 20), color.white, displayLiquidityRightLabels and showPrevWeekHighVisual)
    prevWeekLowLabel := f_syncRightEdgeLabel(prevWeekLowLabel, prevWeekLowLevel, "PWL", color.new(liqLowColor, 20), color.white, displayLiquidityRightLabels and showPrevWeekLowVisual)
    prevMonthHighLabel := f_syncRightEdgeLabel(prevMonthHighLabel, prevMonthHighLevel, "PMH", color.new(liqHighColor, 35), color.white, displayLiquidityRightLabels and showPrevMonthHighVisual)
    prevMonthLowLabel := f_syncRightEdgeLabel(prevMonthLowLabel, prevMonthLowLevel, "PML", color.new(liqLowColor, 35), color.white, displayLiquidityRightLabels and showPrevMonthLowVisual)
    eqHighLabel := f_syncRightEdgeLabel(eqHighLabel, eqHighLevel, "EQH", color.new(liqHighColor, 12), color.white, displayLiquidityRightLabels and showEqHighVisual)
    eqLowLabel := f_syncRightEdgeLabel(eqLowLabel, eqLowLevel, "EQL", color.new(liqLowColor, 12), color.white, displayLiquidityRightLabels and showEqLowVisual)
    protectedHighLabel := f_syncRightEdgeLabel(protectedHighLabel, protectedHighLevel, "Prot H", color.new(liqHighColor, 8), color.white, displayLiquidityRightLabels and showProtectedHighVisual)
    protectedLowLabel := f_syncRightEdgeLabel(protectedLowLabel, protectedLowLevel, "Prot L", color.new(liqLowColor, 8), color.white, displayLiquidityRightLabels and showProtectedLowVisual)
    internalHighLabel := f_syncRightEdgeLabel(internalHighLabel, internalHighLevel, "Range H", color.new(color.silver, 10), color.black, displayLiquidityRightLabels and showRangeVisual)
    internalLowLabel := f_syncRightEdgeLabel(internalLowLabel, internalLowLevel, "Range L", color.new(color.silver, 10), color.black, displayLiquidityRightLabels and showRangeVisual)
    internalEqLabel := f_syncRightEdgeLabel(internalEqLabel, internalEqLevel, "EQ", color.new(neutralColor, 10), color.white, displayLiquidityRightLabels and showRangeVisual)
    oteLongLabel := f_syncRightEdgeLabel(oteLongLabel, oteLongMidLevel, "OTE L", color.new(bullColor, 20), color.white, displayLiquidityRightLabels and showOteVisual)
    oteShortLabel := f_syncRightEdgeLabel(oteShortLabel, oteShortMidLevel, "OTE S", color.new(bearColor, 20), color.white, displayLiquidityRightLabels and showOteVisual)
    htfHighLabel := f_syncRightEdgeLabel(htfHighLabel, htfStructureHighLevel, "HTF H", color.new(color.fuchsia, 15), color.white, displayLiquidityRightLabels and showHtfHighVisual)
    htfLowLabel := f_syncRightEdgeLabel(htfLowLabel, htfStructureLowLevel, "HTF L", color.new(color.fuchsia, 15), color.white, displayLiquidityRightLabels and showHtfLowVisual)

oteLongTopPlot = plot(oteLongTopLevel, "OTE Long Top", color=color.new(bullColor, 40), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
oteLongBottomPlot = plot(oteLongBottomLevel, "OTE Long Bottom", color=color.new(bullColor, 40), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
oteShortTopPlot = plot(oteShortTopLevel, "OTE Short Top", color=color.new(bearColor, 40), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
oteShortBottomPlot = plot(oteShortBottomLevel, "OTE Short Bottom", color=color.new(bearColor, 40), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
fill(oteLongTopPlot, oteLongBottomPlot, color=showOteVisual ? color.new(bullColor, 92) : na)
fill(oteShortTopPlot, oteShortBottomPlot, color=showOteVisual ? color.new(bearColor, 92) : na)

plot(htfStructureHighLevel, "HTF Structure High", color=color.new(color.fuchsia, 15), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
plot(htfStructureLowLevel, "HTF Structure Low", color=color.new(color.fuchsia, 15), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)

plot(riskLongEntryLevel, "Bullish Entry Cue", color=color.new(bullColor, 0), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskShortEntryLevel, "Bearish Entry Cue", color=color.new(bearColor, 0), linewidth=2, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskBullStopLevel, "Bullish Stop Cue", color=color.new(bearColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskBearStopLevel, "Bearish Stop Cue", color=color.new(bullColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskLongTargetLevel, "Bullish TP Cue", color=color.new(liqHighColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)
plot(riskShortTargetLevel, "Bearish TP Cue", color=color.new(liqLowColor, 0), linewidth=1, style=plot.style_linebr, display=overlayLineDisplay)

chartBackdrop = displayKillzoneVisual and strictKillzoneActive ? color.new(color.rgb(217, 172, 61), 88) : displayTrendBackground ? color.new(activeBias == 1 ? bullColor : activeBias == -1 ? bearColor : neutralColor, 93) : na
bgcolor(chartBackdrop)

//------------------------------------------------------------------------------
// Dashboard
//------------------------------------------------------------------------------
var table dashboard = table.new(position.top_right, 4, 15, border_width=1)
var table dashboardCompact = table.new(position.bottom_right, 2, 11, border_width=1)

if barstate.islast and dashboardEnabled and not compactDashboardMode
    table.clear(dashboardCompact, 0, 0, 1, 10)
    f_setCell(dashboard, 0, 0, "Field", color.white, panelHeaderBg)
    f_setCell(dashboard, 1, 0, "Market", color.white, panelHeaderBg)
    f_setCell(dashboard, 2, 0, "Long", color.white, color.new(bullColor, 5))
    f_setCell(dashboard, 3, 0, "Short", color.white, color.new(bearColor, 5))

    f_setCell(dashboard, 0, 1, "Current Px", color.white, panelCellBg)
    f_setCell(dashboard, 1, 1, f_formatLevel(close), color.white, panelCellBg)
    f_setCell(dashboard, 2, 1, longStatus, color.white, panelBullBg)
    f_setCell(dashboard, 3, 1, shortStatus, color.white, panelBearBg)

    f_setCell(dashboard, 0, 2, "Bias", color.white, panelCellBg)
    f_setCell(dashboard, 1, 2, f_biasSummary(activeBias, htfContextReady, htfBias), color.white, panelCellBg)
    f_setCell(dashboard, 2, 2, htfContextReady ? f_alignmentText(true, activeBias, htfBias) : "HTF Guard", color.white, panelBullBg)
    f_setCell(dashboard, 3, 2, htfContextReady ? f_alignmentText(false, activeBias, htfBias) : "HTF Guard", color.white, panelBearBg)

    f_setCell(dashboard, 0, 3, "Preferred", color.white, panelCellBg)
    f_setCell(dashboard, 1, 3, preferredDirection, color.white, color.new(preferredDirection == "Long" ? bullColor : preferredDirection == "Short" ? bearColor : neutralColor, 15))
    f_setCell(dashboard, 2, 3, tradeLongSetup, color.white, panelBullBg)
    f_setCell(dashboard, 3, 3, tradeShortSetup, color.white, panelBearBg)

    f_setCell(dashboard, 0, 4, "Valid Zone", color.white, panelCellBg)
    f_setCell(dashboard, 1, 4, "Entry Range", color.white, panelCellBg)
    f_setCell(dashboard, 2, 4, f_formatRange(tradeLongValidTop, tradeLongValidBottom), color.white, panelBullBg)
    f_setCell(dashboard, 3, 4, f_formatRange(tradeShortValidTop, tradeShortValidBottom), color.white, panelBearBg)

    f_setCell(dashboard, 0, 5, "Entry", color.white, panelCellBg)
    f_setCell(dashboard, 1, 5, "Trigger", color.white, panelCellBg)
    f_setCell(dashboard, 2, 5, f_formatLevel(tradeLongEntry), color.white, panelBullBg)
    f_setCell(dashboard, 3, 5, f_formatLevel(tradeShortEntry), color.white, panelBearBg)

    f_setCell(dashboard, 0, 6, "Stop Loss", color.white, panelCellBg)
    f_setCell(dashboard, 1, 6, "Zone / swing buffer", color.white, panelCellBg)
    f_setCell(dashboard, 2, 6, f_formatLevel(tradeLongStop), color.white, panelBearBg)
    f_setCell(dashboard, 3, 6, f_formatLevel(tradeShortStop), color.white, panelBullBg)

    f_setCell(dashboard, 0, 7, "Op Target", color.white, panelCellBg)
    f_setCell(dashboard, 1, 7, opTargetSummary, color.white, panelCellBg)
    f_setCell(dashboard, 2, 7, f_formatLevel(tradeLongTarget), color.white, color.new(liqHighColor, 20))
    f_setCell(dashboard, 3, 7, f_formatLevel(tradeShortTarget), color.white, color.new(liqLowColor, 20))

    f_setCell(dashboard, 0, 8, "Ext Draw", color.white, panelCellBg)
    f_setCell(dashboard, 1, 8, "Primary external", color.white, panelCellBg)
    f_setCell(dashboard, 2, 8, f_formatLevel(longExternalDraw), color.white, color.new(color.fuchsia, 20))
    f_setCell(dashboard, 3, 8, f_formatLevel(shortExternalDraw), color.white, color.new(color.fuchsia, 20))

    f_setCell(dashboard, 0, 9, "R:R", color.white, panelCellBg)
    f_setCell(dashboard, 1, 9, "Reward / risk", color.white, panelCellBg)
    f_setCell(dashboard, 2, 9, f_formatRr(longRr), color.white, panelBullBg)
    f_setCell(dashboard, 3, 9, f_formatRr(shortRr), color.white, panelBearBg)

    f_setCell(dashboard, 0, 10, "Confidence*", color.white, panelCellBg)
    f_setCell(dashboard, 1, 10, "Simple confluence", color.white, panelCellBg)
    f_setCell(dashboard, 2, 10, f_formatPercent(longConfidence), color.white, panelBullBg)
    f_setCell(dashboard, 3, 10, f_formatPercent(shortConfidence), color.white, panelBearBg)

    f_setCell(dashboard, 0, 11, "TP Prob*", color.white, panelCellBg)
    f_setCell(dashboard, 1, 11, "Rule-based model", color.white, panelCellBg)
    f_setCell(dashboard, 2, 11, f_formatPercent(longTpProbability), color.white, panelBullBg)
    f_setCell(dashboard, 3, 11, f_formatPercent(shortTpProbability), color.white, panelBearBg)

    f_setCell(dashboard, 0, 12, "Lifecycle", color.white, panelCellBg)
    f_setCell(dashboard, 1, 12, "Age / touch", color.white, panelCellBg)
    f_setCell(dashboard, 2, 12, f_lifecycleText(longSetupAge, tradeLongTouched), color.white, panelBullBg)
    f_setCell(dashboard, 3, 12, f_lifecycleText(shortSetupAge, tradeShortTouched), color.white, panelBearBg)

    f_setCell(dashboard, 0, 13, "Sessions / Time", color.white, panelCellBg)
    f_setCell(dashboard, 1, 13, "Preset " + presetLabel + " | Mode " + effectiveZoneDisplayMode + " | " + timezoneSummary, color.white, color.new(strictModeEnabled ? color.teal : neutralColor, 15))
    f_setCell(dashboard, 2, 13, liquiditySessionSummary + " | " + strictLongMap, color.white, panelBullBg)
    f_setCell(dashboard, 3, 13, killzoneSummary + " | " + strictShortMap, color.white, panelBearBg)

    f_setCell(dashboard, 0, 14, "Caution", color.white, panelCellBg)
    f_setCell(dashboard, 1, 14, "Rule-based only, not statistical certainty", color.white, panelCellBg)
    f_setCell(dashboard, 2, 14, f_entryActionText(longStatus), color.white, panelBullBg)
    f_setCell(dashboard, 3, 14, f_entryActionText(shortStatus), color.white, panelBearBg)
else if barstate.islast and dashboardEnabled and compactDashboardMode
    table.clear(dashboard, 0, 0, 3, 14)
    f_setCell(dashboardCompact, 0, 0, "SMC Mobile", color.white, panelHeaderBg)
    f_setCell(dashboardCompact, 1, 0, compactDirectionText + " | " + effectiveZoneDisplayMode, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 1, "Bias", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 1, f_biasShort(activeBias) + "/" + (htfContextReady ? f_biasShort(htfBias) : "Guard"), color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 2, "Setup", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 2, compactSetupDisplay, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 3, "Zone", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 3, compactZoneDisplay, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 4, "E / SL / TP", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 4, compactEntryTriplet, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 5, "Status", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 5, compactStatusDisplay, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 6, compactConfTpLabel, color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 6, compactConfTpDisplay, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 7, "R / Draw", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 7, compactRrDrawDisplay, color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 8, "Life", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 8, compactLifecycleDisplay, color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 9, "Mode", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 9, presetLabel + " | " + effectiveZoneDisplayMode, color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 10, "Sessions", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 10, liquiditySessionSummary + " | KZ:" + (strictKillzoneActive ? "Y" : "N"), color.white, panelCellBg)
else if barstate.islast and not dashboardEnabled
    table.clear(dashboardCompact, 0, 0, 1, 10)
    table.clear(dashboard, 0, 0, 3, 14)
