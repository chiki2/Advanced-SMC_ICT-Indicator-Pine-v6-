f_eng1_regime_strength_from_buffer(int bias, array<float> arrC, array<float> arrH, array<float> arrL) =>
    string strength = "Flat"
    int closeSize = array.size(arrC)
    if closeSize > 0
        float currentClose = array.get(arrC, 0)
        int refIdx = math.min(closeSize - 1, regimeMomentumLookbackBars)
        float refClose = array.get(arrC, refIdx)
        float atrApprox = f_eng1_avg_range(arrH, arrL, 14)
        strength := f_regimeStrengthText(bias, currentClose, refClose, atrApprox)
    strength

f_eng1_fallback_window_range(string tf, int lookback) =>
    float hi = na
    float lo = na
    if tf == ENG1_TF_M1
        hi := f_eng1_window_high(eng1_buf_m1_high, lookback)
