//@version=6
indicator("Advanced SMC / ICT Indicator", shorttitle="SMC/ICT", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
groupPreset = "0. Profile"
usagePreset = input.string("Standard", "Usage profile", options=["Standard", "Compact", "Strict Confirm"], group=groupPreset)

groupStructure = "1. Structure"
bool showTrendBackground = input.bool(true, "Tint background by current bias", group=groupStructure)
bool showMarketStructure = input.bool(true, "Show market structure labels (HH/HL/LH/LL, BOS/MSS)", group=groupStructure)
int structureSwingLen = input.int(3, "Structure swing length", minval=1, maxval=20, group=groupStructure)

groupLiquidity = "2. Liquidity"
bool showLiquidity = input.bool(true, "Show liquidity pools", group=groupLiquidity)
bool showInternalRange = input.bool(true, "Show internal range liquidity", group=groupLiquidity)
bool showSweeps = input.bool(true, "Show liquidity sweep markers (Full mode)", group=groupLiquidity)
// SessionWindow = normal market hours for Engine 2 range/liquidity drawings.
// IPDA strict windows use New York time because Engine 3 confirms time before
// price; normal session drawings stay UTC so chart/broker timezone changes do
// not move visual ranges.
string tradingSessionTimezone = "Etc/UTC"
string asiaSessionWindow = "0000-0900"
string londonSessionWindow = "0800-1700"
string nyAmSessionWindow = "1300-1700"
string nyPmSessionWindow = "1700-2200"
string ipdaTimeTimezone = "America/New_York"
string ipdaObservationSession = "0000-0800"
string ipdaAmKillzoneSession = "0830-1100"
string ipdaPmKillzoneSession = "1330-1600"
float equalToleranceAtr = 0.10

groupZones = "3. Zones"
bool showOb = input.bool(true, "Show order blocks", group=groupZones)
int obSearchBars = 12
int obValidationLookback = 8
float obImpulseAtr = 1.00

bool showFvg = input.bool(true, "Show fair value gaps", group=groupZones)
float fvgMinAtr = 0.15
bool strictShowOte = input.bool(true, "Show active OTE overlay (Full / Focused)", group=groupZones)
string zoneDisplayMode = input.string("Full", "Zone display mode", options=["Full", "Focused", "Minimal"], group=groupZones)

groupContext = "4. Context"
bool showHtf = input.bool(true, "Show active HTF draw levels", group=groupContext)
bool showProtectedLevels = input.bool(true, "Show active protected high / low", group=groupContext)
bool showSessionVisuals = input.bool(true, "Show trading sessions on chart (Full / intraday)", group=groupContext)
bool showLiquidityRightLabels = input.bool(true, "Show right-edge draw labels", group=groupContext)
int regimeMomentumLookbackBars = 20
float regimeStrongAtrThreshold = 1.0

groupRisk = "6. Risk"
bool showRisk = input.bool(false, "Show stop cues", group=groupRisk)
float stopAtrBuffer = 0.10

int setupFreshBars = 6
int setupExpiryBars = 25
float setupChaseAtr = 1.50
float setupManagedR = 1.00

int strictMssLookback = 10

groupDashboard = "5. Dashboard"
bool showDashboard = input.bool(true, "Show context dashboard", group=groupDashboard)
bool compactDashboardInput = input.bool(false, "Compact dashboard mode (Desktop presets only)", group=groupDashboard)

//------------------------------------------------------------------------------
// Styling and helpers
//------------------------------------------------------------------------------
bullColor = color.rgb(15, 156, 119)
bearColor = color.rgb(201, 76, 76)
neutralColor = color.rgb(128, 128, 128)
liqHighColor = color.rgb(44, 120, 200)
liqLowColor = color.rgb(230, 145, 56)
panelHeaderBg = color.new(color.black, 12)
panelCellBg = color.new(color.black, 18)
panelBullBg = color.new(color.rgb(36, 54, 48), 26)
panelBearBg = color.new(color.rgb(65, 44, 44), 26)
// Session visuals: keep soft, but readable across light/dark chart themes.
asiaSessionFillColor = color.new(color.rgb(165, 82, 72), 82)
asiaSessionBorderColor = color.new(color.rgb(198, 102, 91), 18)
londonSessionFillColor = color.new(color.rgb(55, 92, 160), 82)
londonSessionBorderColor = color.new(color.rgb(84, 126, 214), 18)
newYorkSessionFillColor = color.new(color.rgb(170, 152, 57), 82)
newYorkSessionBorderColor = color.new(color.rgb(208, 187, 79), 18)
decisionPremiumFillColor = color.new(color.rgb(177, 58, 58), 92)
decisionDiscountFillColor = color.new(color.rgb(33, 140, 96), 92)
decisionEqColor = color.new(color.rgb(65, 126, 214), 10)
int maxSessionVisuals = 4

atr = ta.atr(14)
profileCompact = usagePreset == "Compact"
profileStrict = usagePreset == "Strict Confirm"
strictModeEnabled = profileStrict
compactMode = profileCompact
compactDashboardMode = profileCompact or compactDashboardInput
effectiveZoneDisplayMode = profileCompact ? "Minimal" : zoneDisplayMode
// Engine 2 draw-state contract (MAIN_CONTRACT): keep centralized mode toggles
// so visual ownership is explicit and easy to audit.
string draw_mode = effectiveZoneDisplayMode
bool draw_full = draw_mode == "Full"
bool draw_focused = draw_mode == "Focused"
bool draw_minimal = draw_mode == "Minimal"
bool draw_show_sessions = showSessionVisuals and draw_full and timeframe.isintraday
bool draw_show_structure = showMarketStructure and draw_full and not compactMode
bool draw_show_sweeps = showSweeps and draw_full and not compactMode
bool draw_show_htf = showHtf
bool draw_show_protected = showProtectedLevels
bool draw_show_ote = strictShowOte and not draw_minimal
bool draw_show_right_labels = showLiquidityRightLabels
displayInternalRange = showInternalRange and not compactMode
displaySweepMarkers = showLiquidity and draw_show_sweeps

//------------------------------------------------------------------------------
// Stateful arrays for session visuals (history)
//------------------------------------------------------------------------------
var box[] sessionRangeBoxes = array.new_box()
var label[] sessionRangeLabels = array.new_label()
var string[] sessionRangeNames = array.new_string()
var line[] sessionRangeHighLines = array.new_line()
var line[] sessionRangeLowLines = array.new_line()
var label protectedHighLabel = na
var label protectedLowLabel = na
var label htfHighLabel = na
var label htfLowLabel = na
var label eqHighLabel = na
var label eqLowLabel = na
var label eng2DealEqLabel = na
var label longStopLabel = na
var label shortStopLabel = na
var label[] eng2StructureLabels = array.new_label()
var line[] eng2StructureLines = array.new_line()
// Internal vs Swing structure states (chart TF).
// Internal uses `structureSwingLen`. Swing uses 3x the length (major structure).
var float eng2StructLastHigh = na
var float eng2StructLastLow = na
var bool eng2StructHighBroken = false
var bool eng2StructLowBroken = false
var int eng2InternalTrend = 0
var float eng2SwingLastHigh = na
var float eng2SwingLastLow = na
var bool eng2SwingHighBroken = false
var bool eng2SwingLowBroken = false
var int eng2SwingTrend = 0
var float eng2InternalLastEventLevel = na
var int eng2InternalLastEventBar = na
var string eng2InternalLastEventText = ""
var float eng2SwingLastEventLevel = na
var int eng2SwingLastEventBar = na
var string eng2SwingLastEventText = ""
// Extra dedupe: keep a short history of broken levels so we don't spam BOS/MSS/CHoCH
// on the same price level across multiple pivots/retests.
var array<float> eng2SwingEventLevels = array.new_float()
var array<float> eng2InternalEventLevels = array.new_float()
// Keep a longer memory of broken levels so BOS/MSS/CHoCH don't respawn at the
// same price later just because the short dedupe buffer rolled over.
int eng2EventLevelCap = 160
var int eng2StructLastHighBar = na
var int eng2StructLastLowBar = na
var int eng2SwingLastHighBar = na
var int eng2SwingLastLowBar = na
// Active level lines (single-instance, no history clutter).
var line eng2BslLine = na
var line eng2SslLine = na
var line eng2ProtectedHighLine = na
var line eng2ProtectedLowLine = na
var line eng2CtxHighLine = na
var line eng2CtxLowLine = na
var line eng2RangeHighLine = na
var line eng2RangeLowLine = na
var line eng2RangeEqLine = na
var line eng2RangeQ25Line = na
var line eng2RangeQ75Line = na
var linefill eng2RangePremiumFill = na
var linefill eng2RangeDiscountFill = na
var line eng2OteLongTopLine = na
var line eng2OteLongBottomLine = na
var linefill eng2OteLongFill = na
var line eng2OteShortTopLine = na
var line eng2OteShortBottomLine = na
var linefill eng2OteShortFill = na
var line eng2RiskLongEntryLine = na
var line eng2RiskShortEntryLine = na
var line eng2RiskLongStopLine = na
var line eng2RiskShortStopLine = na
var line eng2RiskLongTargetLine = na
var line eng2RiskShortTargetLine = na

// Dealing range visual state (location layer).
// Derived from Engine 1 context snapshot so it stays aligned with the MTF chain.
var float eng2DealHigh = na
var float eng2DealLow = na
var int eng2DealLeftBar = na
var bool eng2DealBroken = false

var box eng2LongZoneBox = na
var line eng2LongZoneLine = na
var label eng2LongZoneLabel = na
var box eng2ShortZoneBox = na
var line eng2ShortZoneLine = na
var label eng2ShortZoneLabel = na
var box eng2CtxBullObBox = na
var label eng2CtxBullObLabel = na
var box eng2CtxBullFvgBox = na
var label eng2CtxBullFvgLabel = na
var box eng2CtxBearObBox = na
var label eng2CtxBearObLabel = na
var box eng2CtxBearFvgBox = na
var label eng2CtxBearFvgLabel = na
var box eng2LongHistoryBox = na
var box eng2ShortHistoryBox = na
var int eng2LongHistoryLeftBar = na
var int eng2LongHistoryRightBar = na
var float eng2LongHistoryTop = na
var float eng2LongHistoryBottom = na
var bool eng2LongHistoryIsOb = false
var bool eng2LongHistoryIsFvg = false
var string eng2LongHistoryTag = ""
var int eng2ShortHistoryLeftBar = na
var int eng2ShortHistoryRightBar = na
var float eng2ShortHistoryTop = na
var float eng2ShortHistoryBottom = na
var bool eng2ShortHistoryIsOb = false
var bool eng2ShortHistoryIsFvg = false
var string eng2ShortHistoryTag = ""
var box eng2NarrBullSdBox = na
var label eng2NarrBullSdLabel = na
var box eng2NarrBearSdBox = na
var label eng2NarrBearSdLabel = na
var label eng2NarrHighLabel = na
var label eng2NarrLowLabel = na
var box activeAsiaSessionBox = na
var label activeAsiaSessionLabel = na
var line activeAsiaSessionHighLine = na
var line activeAsiaSessionLowLine = na
var int activeAsiaSessionStartBar = na
var box activeLondonSessionBox = na
var label activeLondonSessionLabel = na
var line activeLondonSessionHighLine = na
var line activeLondonSessionLowLine = na
var int activeLondonSessionStartBar = na
var box activeNewYorkSessionBox = na
var label activeNewYorkSessionLabel = na
var line activeNewYorkSessionHighLine = na
var line activeNewYorkSessionLowLine = na
var int activeNewYorkSessionStartBar = na
var box activeNewYorkPmSessionBox = na
var label activeNewYorkPmSessionLabel = na
var line activeNewYorkPmSessionHighLine = na
var line activeNewYorkPmSessionLowLine = na
var int activeNewYorkPmSessionStartBar = na

f_biasShort(int bias) =>
    bias == 1 ? "Bull" : bias == -1 ? "Bear" : "Range"

f_structureSideText(int bias) =>
    bias == 1 ? "Bullish" : bias == -1 ? "Bearish" : "Range"

f_structureArrowText(int bias) =>
    bias == 1 ? "^" : bias == -1 ? "v" : "-"

f_structureTone(int bias) =>
    color.new(bias == 1 ? bullColor : bias == -1 ? bearColor : neutralColor, bias == 0 ? 35 : 12)

f_structureAlignmentText(int internalBias, int swingBias) =>
    internalBias != 0 and swingBias != 0 and internalBias == swingBias ? "Aligned " + f_structureSideText(internalBias) : internalBias != 0 and swingBias != 0 ? "Mixed" : "Building"

f_structureSignalText(string signalText, int signalBias, int signalBar) =>
    na(signalBar) or signalText == "" ? "-" : signalText + " " + f_biasShort(signalBias)

f_regimeStrengthShort(string regimeStrength) =>
    regimeStrength == "Strong" ? "Str" : regimeStrength == "Normal" ? "N" : regimeStrength == "Flat" ? "F" : regimeStrength

f_sessionCode(string sessionLabel) =>
    sessionLabel == "Asia" ? "AS" : sessionLabel == "London" ? "LDN" : sessionLabel == "New York AM" ? "NYA" : sessionLabel == "New York PM" ? "NYP" : sessionLabel == "New York Composite" ? "NYC" : sessionLabel == "Inter-session" ? "INT" : sessionLabel

f_regimeStrengthText(int regimeBias, float currentLevel, float referenceLevel, float atrLevel) =>
    regimeBias == 0 or na(currentLevel) or na(referenceLevel) or na(atrLevel) or atrLevel <= 0 ? "Flat" : math.abs(currentLevel - referenceLevel) >= atrLevel * regimeStrongAtrThreshold ? "Strong" : "Normal"

f_regimeSideText(bool isBull, int regimeBias, string regimeStrength) =>
    regimeBias == 0 ? "Flat" : isBull ? (regimeBias == 1 ? regimeStrength : "Counter") : (regimeBias == -1 ? regimeStrength : "Counter")

f_alignmentShortText(bool isBull, int ltfBias, int higherBias) =>
    if isBull
        ltfBias == 1 and higherBias == 1 ? "Str" : ltfBias == 1 or higherBias == 1 ? "Mix" : "Ctr"
    else
        ltfBias == -1 and higherBias == -1 ? "Str" : ltfBias == -1 or higherBias == -1 ? "Mix" : "Ctr"

f_regimeSideShortText(bool isBull, int regimeBias, string regimeStrength) =>
    string sideText = f_regimeSideText(isBull, regimeBias, regimeStrength)
    sideText == "Counter" ? "Ctr" : sideText == "Flat" ? "Flat" : f_regimeStrengthShort(sideText)

f_zoneMid(float zoneTop, float zoneBottom) =>
    (zoneTop + zoneBottom) * 0.5

f_fvgLabelText(bool isBull) =>
    compactMode ? (isBull ? "FVG+" : "FVG-") : (isBull ? "Bullish FVG" : "Bearish FVG")

f_obLabelText(bool isBull, bool isBreaker) =>
    compactMode ? (isBreaker ? (isBull ? "BRK+" : "BRK-") : (isBull ? "OB+" : "OB-")) : (isBreaker ? (isBull ? "Bullish Breaker" : "Bearish Breaker") : (isBull ? "Bullish OB" : "Bearish OB"))

f_formatLevel(float price) =>
    na(price) ? "-" : str.tostring(price, format.mintick)

f_levelMatches(float referenceLevel, float candidate) =>
    not na(referenceLevel) and not na(candidate) and math.abs(referenceLevel - candidate) <= syminfo.mintick * 0.5

f_uniqueLevelVisual(bool visible, float level, bool prior1Visible, float prior1, bool prior2Visible, float prior2, bool prior3Visible, float prior3, bool prior4Visible, float prior4, bool prior5Visible, float prior5) =>
    visible and not ((prior1Visible and f_levelMatches(level, prior1)) or (prior2Visible and f_levelMatches(level, prior2)) or (prior3Visible and f_levelMatches(level, prior3)) or (prior4Visible and f_levelMatches(level, prior4)) or (prior5Visible and f_levelMatches(level, prior5)))

f_preferredLevelMatch(float candidate, bool balancedState, bool useLongPreference, float longLevel, float shortLevel) =>
    balancedState ? (f_levelMatches(longLevel, candidate) or f_levelMatches(shortLevel, candidate)) : f_levelMatches(useLongPreference ? longLevel : shortLevel, candidate)

f_selectAbove(float base, float best, float candidate) =>
    float result = best
    if not na(base) and not na(candidate) and candidate > base
        if na(result) or candidate < result
            result := candidate
    result

f_selectBelow(float base, float best, float candidate) =>
    float result = best
    if not na(base) and not na(candidate) and candidate < base
        if na(result) or candidate > result
            result := candidate
    result

f_clamp(float value, float minValue, float maxValue) =>
    math.max(minValue, math.min(maxValue, value))

f_formatRange(float zoneTop, float zoneBottom) =>
    na(zoneTop) or na(zoneBottom) ? "-" : str.tostring(zoneBottom, format.mintick) + " - " + str.tostring(zoneTop, format.mintick)

f_dealingRangeStatusText(bool active, bool broken, bool sourceReady) =>
    active ? "Active" : broken ? "Broken" : sourceReady ? "Waiting" : "-"

f_dealingRangeZoneText(bool active, float price, float eqLevel) =>
    not active or na(price) or na(eqLevel) ? "-" : price > eqLevel ? "Premium" : price < eqLevel ? "Discount" : "EQ"

f_formatPercent(float value) =>
    na(value) ? "-" : str.tostring(math.round(value)) + "%"

f_formatRr(float rr) =>
    na(rr) ? "-" : rr > 10.0 ? ">10R" : str.tostring(math.round(rr * 100.0) / 100.0) + "R"

f_targetModeText(bool hasActiveTarget, bool usesExternalDolTarget, bool liquidityTarget) =>
    not hasActiveTarget ? "-" : usesExternalDolTarget ? "DOL" : liquidityTarget ? "Liq" : "2R"

f_zoneResponseScore(bool hasSetup, bool confirmPass) =>
    if not hasSetup
        0
    else if confirmPass
        2
    else
        1

f_zoneDisplacementScore(bool displacementSeen) =>
    displacementSeen ? 2 : 0

f_zoneAtrExpansionScore(float departureRange, float atrLevel) =>
    na(departureRange) or na(atrLevel) or atrLevel <= 0 ? 0 : departureRange >= atrLevel * 2.0 ? 2 : departureRange >= atrLevel ? 1 : 0

f_zoneQualityTier(bool hasSetup, int responseScore, int displacementScore, int atrExpansionScore) =>
    if not hasSetup
        "-"
    else
        int totalScore = responseScore + displacementScore + atrExpansionScore
        totalScore >= 5 ? "Q3" : totalScore >= 3 ? "Q2" : "Q1"

f_setupQualityText(string setupText, string qualityTier, bool hasSetup) =>
    not hasSetup or qualityTier == "-" ? setupText : setupText + " | " + qualityTier

f_zoneQualityLabelSuffix(string qualityTier) =>
    qualityTier == "-" ? "" : " | " + qualityTier

f_zoneQualityBorderAlpha(string qualityTier, string executionState) =>
    executionState == "Managed" ? 18 : qualityTier == "Q3" ? 0 : qualityTier == "Q2" ? 10 : qualityTier == "Q1" ? 26 : 12

f_zoneQualityBorderWidth(string qualityTier) =>
    qualityTier == "Q3" ? 3 : 2

f_timeToChartBar(int sourceTime) =>
    bool hasSourceTime = not na(sourceTime)
    bool crossed = hasSourceTime and time >= sourceTime and nz(time[1], time) < sourceTime
    int crossedBar = ta.valuewhen(crossed, bar_index, 0)
    int mappedBar = hasSourceTime ? crossedBar : na
    if hasSourceTime and na(mappedBar) and time >= sourceTime
        mappedBar := 0
    mappedBar

f_zoneTouchedSinceBar(float zoneTop, float zoneBottom, int createdBar, int maxScanBars) =>
    bool touched = false
    if not na(zoneTop) and not na(zoneBottom) and not na(createdBar) and createdBar <= bar_index
        int barsToScan = math.min(math.max(bar_index - createdBar, 0), math.max(maxScanBars, 0))
        for i = 0 to barsToScan
            if high[i] >= zoneBottom and low[i] <= zoneTop
                touched := true
                break
    touched

f_zoneIntersects(float zoneTop, float zoneBottom, float refTop, float refBottom) =>
    not na(zoneTop) and not na(zoneBottom) and not na(refTop) and not na(refBottom) and math.max(zoneBottom, refBottom) <= math.min(zoneTop, refTop)

f_inSessionWindow(string sessionWindow) =>
    not na(time(timeframe.period, sessionWindow, tradingSessionTimezone))

f_inIpdaWindow(string sessionWindow) =>
    timeframe.isintraday and not na(time(timeframe.period, sessionWindow, ipdaTimeTimezone))

f_updateSessionRange(bool inSession, bool newSession, float runningHigh, float runningLow) =>
    float nextRunningHigh = runningHigh
    float nextRunningLow = runningLow
    if newSession
        nextRunningHigh := high
        nextRunningLow := low
    else if inSession
        nextRunningHigh := na(runningHigh) ? high : math.max(runningHigh, high)
        nextRunningLow := na(runningLow) ? low : math.min(runningLow, low)
    [nextRunningHigh, nextRunningLow]

f_ictContextHtf(float chartSeconds) =>
    na(chartSeconds) ? "" :
         chartSeconds == timeframe.in_seconds("1") ? "15" :
         chartSeconds == timeframe.in_seconds("5") ? "15" :
         chartSeconds == timeframe.in_seconds("15") ? "60" :
         chartSeconds == timeframe.in_seconds("30") ? "240" : ""

f_ictNarrativeHtf(float chartSeconds) =>
    na(chartSeconds) ? "" :
         chartSeconds == timeframe.in_seconds("1") ? "60" :
         chartSeconds == timeframe.in_seconds("5") ? "240" :
         chartSeconds == timeframe.in_seconds("15") ? "240" :
         chartSeconds == timeframe.in_seconds("30") ? "1D" : ""

f_nearestAbove(float entry, float level1, float level2, float level3, float level4, float level5, float level6, float level7) =>
    float target = na
    target := f_selectAbove(entry, target, level1)
    target := f_selectAbove(entry, target, level2)
    target := f_selectAbove(entry, target, level3)
    target := f_selectAbove(entry, target, level4)
    target := f_selectAbove(entry, target, level5)
    target := f_selectAbove(entry, target, level6)
    target := f_selectAbove(entry, target, level7)
    target

f_nearestBelow(float entry, float level1, float level2, float level3, float level4, float level5, float level6, float level7) =>
    float target = na
    target := f_selectBelow(entry, target, level1)
    target := f_selectBelow(entry, target, level2)
    target := f_selectBelow(entry, target, level3)
    target := f_selectBelow(entry, target, level4)
    target := f_selectBelow(entry, target, level5)
    target := f_selectBelow(entry, target, level6)
    target := f_selectBelow(entry, target, level7)
    target

f_safeBarIndexX(int targetBar) =>
    math.max(targetBar, math.max(bar_index - 5000, 0))

f_trimLabels(label[] labelsArr, int cap) =>
    while array.size(labelsArr) > cap
        old = array.shift(labelsArr)
        if not na(old)
            label.delete(old)

f_pushLabel(label[] labelsArr, label newLabel, int cap) =>
    if not na(newLabel)
        array.push(labelsArr, newLabel)
        f_trimLabels(labelsArr, cap)

f_trimLines(line[] linesArr, int cap) =>
    while array.size(linesArr) > cap
        old = array.shift(linesArr)
        if not na(old)
            line.delete(old)

f_pushLine(line[] linesArr, line newLine, int cap) =>
    if not na(newLine)
        array.push(linesArr, newLine)
        f_trimLines(linesArr, cap)

f_syncRightEdgeLabel(label currentLabel, float level, string labelText, color labelColor, color textColor, bool enabled) =>
    label updatedLabel = currentLabel
    if enabled and not na(level)
        // Place labels slightly to the right of the last bar to avoid overlap with candles/zones.
        int xPos = bar_index + 1
        if na(updatedLabel)
            updatedLabel := label.new(x=xPos, y=level, xloc=xloc.bar_index, text=labelText, style=label.style_label_left, color=labelColor, textcolor=textColor, size=size.tiny)
        else
            label.set_x(updatedLabel, xPos)
            label.set_y(updatedLabel, level)
            label.set_text(updatedLabel, labelText)
            label.set_color(updatedLabel, labelColor)
            label.set_textcolor(updatedLabel, textColor)
            label.set_style(updatedLabel, label.style_label_left)
            label.set_size(updatedLabel, size.tiny)
    else if not na(updatedLabel)
        label.delete(updatedLabel)
        updatedLabel := na
    updatedLabel

f_eng2_active_right_bar(int targetBar) =>
    na(targetBar) ? na : math.min(targetBar, bar_index)

f_eng2_syncBoundedHLine(line currentLine, float level, color lineColor, int lineWidth, string lineStyle, bool enabled) =>
    line updatedLine = currentLine
    if enabled and not na(level)
        int x1 = f_safeBarIndexX(bar_index - 5000)
        if na(updatedLine)
            updatedLine := line.new(x1=x1, y1=level, x2=bar_index, y2=level, xloc=xloc.bar_index, extend=extend.none, color=lineColor, style=lineStyle, width=math.max(lineWidth, 1))
        else
            line.set_xy1(updatedLine, x1, level)
            line.set_xy2(updatedLine, bar_index, level)
            line.set_extend(updatedLine, extend.none)
            line.set_color(updatedLine, lineColor)
            line.set_style(updatedLine, lineStyle)
            line.set_width(updatedLine, math.max(lineWidth, 1))
    else if not na(updatedLine)
        line.delete(updatedLine)
        updatedLine := na
    updatedLine

// Horizontal segment (no extend) used for Engine 2 dealing range visuals.
f_eng2_syncSegmentHLine(line currentLine, int leftBar, int rightBar, float level, color lineColor, int lineWidth, string lineStyle, bool enabled) =>
    line updatedLine = currentLine
    if enabled and not na(level) and not na(leftBar) and not na(rightBar)
        int x1 = f_safeBarIndexX(leftBar)
        int x2 = f_safeBarIndexX(f_eng2_active_right_bar(rightBar))
        if x2 < x1
            int tmp = x1
            x1 := x2
            x2 := tmp
        if na(updatedLine)
            updatedLine := line.new(x1=x1, y1=level, x2=x2, y2=level, xloc=xloc.bar_index, extend=extend.none, color=lineColor, style=lineStyle, width=math.max(lineWidth, 1))
        else
            line.set_xy1(updatedLine, x1, level)
            line.set_xy2(updatedLine, x2, level)
            line.set_extend(updatedLine, extend.none)
            line.set_color(updatedLine, lineColor)
            line.set_style(updatedLine, lineStyle)
            line.set_width(updatedLine, math.max(lineWidth, 1))
    else if not na(updatedLine)
        line.delete(updatedLine)
        updatedLine := na
    updatedLine

f_eng2_syncLineFill(linefill currentFill, line lineA, line lineB, color fillColor, bool enabled) =>
    linefill updatedFill = currentFill
    if enabled and not na(lineA) and not na(lineB)
        if na(updatedFill)
            updatedFill := linefill.new(lineA, lineB, fillColor)
        else
            linefill.set_color(updatedFill, fillColor)
    else if not na(updatedFill)
        linefill.delete(updatedFill)
        updatedFill := na
    updatedFill

f_levelsClose(float levelA, float levelB, float tolerance) =>
    not na(levelA) and not na(levelB) and not na(tolerance) and math.abs(levelA - levelB) <= tolerance

f_normToTick(float level) =>
    not na(level) ? math.round_to_mintick(level) : na

f_eng2_level_seen(array<float> levelsArr, float level, float tolerance) =>
    bool seen = false
    int n = array.size(levelsArr)
    float normLevel = f_normToTick(level)
    if n > 0 and not na(normLevel) and not na(tolerance)
        for i = 0 to n - 1
            if f_levelsClose(array.get(levelsArr, i), normLevel, tolerance)
                seen := true
                break
    seen

f_eng2_level_remember(array<float> levelsArr, float level, int cap) =>
    float normLevel = f_normToTick(level)
    if not na(normLevel)
        array.unshift(levelsArr, normLevel)
        while array.size(levelsArr) > cap
            array.pop(levelsArr)
    true

f_sessionFillColor(string sessionName) =>
    sessionName == "Asia" ? asiaSessionFillColor : sessionName == "London" ? londonSessionFillColor : newYorkSessionFillColor

f_sessionBorderColor(string sessionName) =>
    sessionName == "Asia" ? asiaSessionBorderColor : sessionName == "London" ? londonSessionBorderColor : newYorkSessionBorderColor

f_sessionTextColor(string sessionName) =>
    // Slightly more opaque than lines so the session name stays readable.
    color.new(f_sessionBorderColor(sessionName), 8)

f_sessionLineColor(string sessionName, bool isHigh) =>
    color.new(f_sessionBorderColor(sessionName), isHigh ? 18 : 30)

f_setCell(table targetTable, int col, int row, string cellText, color textClr, color bgClr) =>
    table.cell(targetTable, col, row, cellText, text_color=textClr, bgcolor=bgClr, text_size=compactDashboardMode ? size.small : size.normal)

f_setCellSmall(table targetTable, int col, int row, string cellText, color textClr, color bgClr) =>
    table.cell(targetTable, col, row, cellText, text_color=textClr, bgcolor=bgClr, text_size=size.small)

f_lifecycleText(int setupAge, bool touched) =>
    (na(setupAge) ? "-" : str.tostring(setupAge) + "b") + " / " + (touched ? "Touched" : "Untouched")

f_compactLifecycleText(bool useLong, int longAge, bool longTouchedState, int shortAge, bool shortTouchedState) =>
    useLong ? (na(longAge) ? "-" : str.tostring(longAge) + "b") + "/" + (longTouchedState ? "T" : "U") : (na(shortAge) ? "-" : str.tostring(shortAge) + "b") + "/" + (shortTouchedState ? "T" : "U")

f_biasSummary(int execBias, bool ctxReady, int ctxBias, int narrBias, string narrStrength) =>
    // Display order is top-down for trader clarity: Narrative / Context / Execution.
    // Context can be Guarded when the HTF range is not ready yet.
    f_biasShort(narrBias) + "/" + (ctxReady ? f_biasShort(ctxBias) : "G") + "/" + f_biasShort(execBias) + " " + f_regimeStrengthShort(narrStrength)

f_draw_zone_visible(string mode, bool isSelected, bool isBull, string preferredDirection) =>
    if mode == "Full"
        true
    else if mode == "Focused"
        isSelected
    else
        preferredDirection == "Long" ? (isBull and isSelected) : preferredDirection == "Short" ? (not isBull and isSelected) : isSelected

f_draw_level_visible(string mode, bool isPrimary, bool isBull, string preferredDirection) =>
    if mode == "Full"
        true
    else if mode == "Focused"
        isPrimary
    else
        preferredDirection == "Long" ? (isBull and isPrimary) : preferredDirection == "Short" ? (not isBull and isPrimary) : isPrimary

f_executionVisualByMode(string mode, bool riskVisible, string preferredDirection, bool isLong, bool useLongPreference) =>
    if not riskVisible
        false
    else if mode == "Full"
        true
    else if preferredDirection == "Balanced"
        useLongPreference ? isLong : not isLong
    else if preferredDirection == "Long"
        isLong
    else if preferredDirection == "Short"
        not isLong
    else
        false

f_contextVisualByMode(string mode) =>
    mode != "Minimal"

f_ipdaCyclePhaseText(bool accumulationPhase, bool expansionPhase, bool retracementPhase, bool reversalPhase) =>
    reversalPhase ? "Reversal" : retracementPhase ? "Retracement" : expansionPhase ? "Expansion" : accumulationPhase ? "Accumulation" : "Delivery"

f_ipdaCyclePhaseShort(string phaseText) =>
    phaseText == "Accumulation" ? "Accum" : phaseText == "Expansion" ? "Exp" : phaseText == "Retracement" ? "Retr" : phaseText == "Reversal" ? "Rev" : "Deliv"

f_confirmationStateText(bool strictEnabled, bool timePass, bool biasPass, bool contextPass, bool sweepPass, bool mssPass, bool displacementPass, bool pdPass, bool otePass, bool dolPass, bool compactText) =>
    if not strictEnabled
        if not timePass
            compactText ? "Time" : "IPDA off-time"
        else if not biasPass
            compactText ? "Bias" : "Need IPDA bias"
        else if not contextPass
            compactText ? "Ctx" : "Need IPDA context"
        else if not sweepPass
            compactText ? "Raid" : "Need raid"
        else if not mssPass
            compactText ? "MSS" : "Need MSS"
        else if not displacementPass
            compactText ? "Exp" : "Need expansion"
        else if not dolPass
            compactText ? "DOL" : "Need DOL"
        else
            compactText ? "IPDA" : "IPDA Ready"
    else if not timePass
        compactText ? "Time" : "Need IPDA time"
    else if not biasPass
        compactText ? "Bias" : "Need Bias TF"
    else if not contextPass
        compactText ? "Ctx" : "Need Context TF"
    else if not sweepPass
        compactText ? "Raid" : "Need Raid"
    else if not mssPass
        compactText ? "MSS" : "Need MSS"
    else if not displacementPass
        compactText ? "Disp" : "Need Displacement"
    else if not (pdPass and otePass)
        compactText ? "PD" : "Need PD/OTE"
    else if not dolPass
        compactText ? "DOL" : "Need DOL"
    else
        compactText ? "Rdy" : "Ready"

f_setupPathText(bool hasSetup, bool isFvg, bool isOb, bool usesDolTarget, bool compactText) =>
    if not hasSetup
        "-"
    else
        string poiText = isFvg ? "FVG" : isOb ? "OB" : "POI"
        string dolText = usesDolTarget ? (compactText ? ">D" : " > DOL") : ""
        poiText + dolText

f_setupExecutionState(bool hasSetup, bool ambiguous, bool invalidated, bool expired, bool chased, bool completed, bool managed, bool baseContextPass, bool confirmationPass, bool mssFresh, bool displacementSeen, bool priceInZone, bool priceNearZone) =>
    not hasSetup ? "Waiting" : ambiguous ? "Ambiguous" : completed ? "Completed" : invalidated ? "Invalidated" : managed ? "Managed" : expired or chased ? "Expired" : not baseContextPass ? "Waiting" : not confirmationPass ? "Confirming" : mssFresh and displacementSeen ? (priceInZone or priceNearZone ? "Active" : "Armed") : "Waiting"

f_executionStateCompact(string stateText) =>
    stateText == "Ambiguous" ? "Ambg" : stateText == "Invalidated" ? "Invalid" : stateText == "Expired" ? "Exp" : stateText == "Managed" ? "Mngd" : stateText == "Completed" ? "Done" : stateText == "Confirming" ? "Cfm" : stateText

f_executionTerminal(string stateText) =>
    stateText == "Completed" or stateText == "Expired" or stateText == "Invalidated"

f_executionRiskVisible(string stateText) =>
    stateText == "Armed" or stateText == "Active" or stateText == "Managed" or stateText == "Ambiguous"

f_entryActionText(string statusText) =>
    statusText == "Active" ? "Entry active" : statusText == "Armed" ? "Monitor retest" : statusText == "Confirming" ? "Wait confirm" : statusText == "Managed" ? "Manage trade" : statusText == "Ambiguous" ? "Review candle" : statusText == "Completed" ? "Wait next setup" : statusText == "Expired" or statusText == "Invalidated" ? "Stand down" : "Wait confirmation"

f_ipdaNextActionText(bool hasSetup, string executionState, bool directionalReady, bool sweepSeen, bool mssSeen, bool displacementSeen, string phaseText, bool isBull) =>
    hasSetup ? f_entryActionText(executionState) : not directionalReady ? "Wait IPDA bias" : not sweepSeen ? "Wait raid" : not mssSeen ? "Wait MSS" : not displacementSeen ? "Wait expansion" : f_ipdaCyclePhaseShort(phaseText) + (isBull ? " long" : " short")

f_eng4_retired_state(string executionState, int setupAge, bool touched, int expiryBarsWindow) =>
    executionState == "Invalidated" or executionState == "Completed" or executionState == "Expired" or (touched and not na(setupAge) and setupAge > expiryBarsWindow and not f_executionRiskVisible(executionState) and executionState != "Confirming" and executionState != "Ambiguous")

f_timeNormalizedBars(int baseBars, int baselineTfSeconds, int currentTfSeconds, int minBars) =>
    float baselineDurationSeconds = float(baseBars) * baselineTfSeconds
    int(math.max(minBars, math.round(baselineDurationSeconds / currentTfSeconds)))

f_eng4_setup_text(string setupText, bool retired) =>
    retired ? "Retired" : setupText

f_eng4_detail_text(string valueText, bool retired) =>
    retired ? "-" : valueText

f_eng4_zone_text(float zoneTop, float zoneBottom, float entry, bool retired) =>
    retired or (na(zoneTop) and na(zoneBottom) and na(entry)) ? "-" : f_formatRange(zoneTop, zoneBottom) + " | " + f_formatLevel(entry)

f_eng4_risk_text(float stopLevel, float targetLevel, bool retired) =>
    retired or (na(stopLevel) and na(targetLevel)) ? "-" : f_formatLevel(stopLevel) + " | " + f_formatLevel(targetLevel)

f_eng4_plan_text(float entryLevel, float stopLevel, float targetLevel, bool retired) =>
    retired or (na(entryLevel) and na(stopLevel) and na(targetLevel)) ? "-" : f_formatLevel(entryLevel) + " | " + f_formatLevel(stopLevel) + " | " + f_formatLevel(targetLevel)

f_eng4_rr_text(float rrValue, float confidenceValue, bool retired) =>
    retired or (na(rrValue) and na(confidenceValue)) ? "-" : f_formatRr(rrValue) + " | " + f_formatPercent(confidenceValue)

f_eng4_rr_draw_text(float rrValue, float drawLevel, bool retired) =>
    retired or (na(rrValue) and na(drawLevel)) ? "-" : f_formatRr(rrValue) + " | " + f_formatLevel(drawLevel)

f_eng4_level_text(float level, bool retired) =>
    retired or na(level) ? "-" : f_formatLevel(level)

f_eng4_life_text(int setupAge, bool touched, bool retired) =>
    retired ? "Retired" : na(setupAge) and not touched ? "-" : f_lifecycleText(setupAge, touched)

f_eng4_context_text(string contextText, string executionState, bool retired) =>
    retired ? "Retired" : executionState == "Ambiguous" ? "Review candle" : executionState == "Managed" ? "Manage trade" : executionState == "Active" ? "Entry active" : executionState == "Armed" ? "Monitor retest" : contextText

f_eng4_market_summary(string longValue, bool longRetired, string shortValue, bool shortRetired) =>
    string effectiveLongValue = longRetired ? "-" : longValue
    string effectiveShortValue = shortRetired ? "-" : shortValue
    effectiveLongValue == effectiveShortValue ? effectiveLongValue : effectiveLongValue == "-" ? effectiveShortValue : effectiveShortValue == "-" ? effectiveLongValue : "Mixed"

f_eng4_session_text(string sessionSummary, string tzSummary, bool strictEnabled, string ipdaSummary) =>
    sessionSummary + " | " + tzSummary + " | " + (strictEnabled ? "Strict " : "IPDA ") + ipdaSummary

f_eng4_confirmation_text(bool hasSetup, bool strictEnabled, bool timePass, bool biasPass, bool contextPass, bool sweepPass, bool mssPass, bool displacementPass, bool pdPass, bool otePass, bool dolPass, bool isFvg, bool isOb, bool usesDolTarget, string executionState, bool retired) =>
    string confirmationText = hasSetup ? f_confirmationStateText(strictEnabled, timePass, biasPass, contextPass, sweepPass, mssPass, displacementPass, pdPass, otePass, dolPass, false) + " | " + f_setupPathText(true, isFvg, isOb, usesDolTarget, false) : "-"
    f_eng4_context_text(confirmationText, executionState, retired)

f_trimSessionVisuals(int keepCount) =>
    int cap = math.max(keepCount, 0)
    while array.size(sessionRangeBoxes) > cap
        box oldBox = array.shift(sessionRangeBoxes)
        label oldLabel = array.size(sessionRangeLabels) > 0 ? array.shift(sessionRangeLabels) : na
        if array.size(sessionRangeNames) > 0
            array.shift(sessionRangeNames)
        line oldHighLine = array.size(sessionRangeHighLines) > 0 ? array.shift(sessionRangeHighLines) : na
        line oldLowLine = array.size(sessionRangeLowLines) > 0 ? array.shift(sessionRangeLowLines) : na
        if not na(oldBox)
            box.delete(oldBox)
        if not na(oldLabel)
            label.delete(oldLabel)
        if not na(oldHighLine)
            line.delete(oldHighLine)
        if not na(oldLowLine)
            line.delete(oldLowLine)
    while array.size(sessionRangeLabels) > cap
        label extraLabel = array.shift(sessionRangeLabels)
        if not na(extraLabel)
            label.delete(extraLabel)
    while array.size(sessionRangeHighLines) > cap
        line extraHighLine = array.shift(sessionRangeHighLines)
        if not na(extraHighLine)
            line.delete(extraHighLine)
    while array.size(sessionRangeLowLines) > cap
        line extraLowLine = array.shift(sessionRangeLowLines)
        if not na(extraLowLine)
            line.delete(extraLowLine)
    while array.size(sessionRangeNames) > cap
        array.shift(sessionRangeNames)

f_draw_right_edge_label(label currentLabel, float level, string labelText, color labelColor, color textColor, bool enabled) =>
    f_syncRightEdgeLabel(currentLabel, level, labelText, labelColor, textColor, enabled)

f_draw_cleanup_hidden_objects() =>
    f_trimSessionVisuals(0)
    f_trimLabels(eng2StructureLabels, 0)
    f_trimLines(eng2StructureLines, 0)

f_addSessionVisual(string sessionName, int leftBar, float sessionHigh, float sessionLow) =>
    int safeLeftBar = f_safeBarIndexX(leftBar)
    color fillColor = f_sessionFillColor(sessionName)
    color borderColor = f_sessionBorderColor(sessionName)
    box newBox = box.new(left=safeLeftBar, top=sessionHigh, right=bar_index, bottom=sessionLow, xloc=xloc.bar_index, bgcolor=fillColor, border_color=borderColor, border_width=1)
    // Center label with a very soft backdrop so it's readable on both light and dark themes.
    label newLabel = label.new(x=f_safeBarIndexX(int(math.floor((safeLeftBar + bar_index) * 0.5))), y=f_zoneMid(sessionHigh, sessionLow), xloc=xloc.bar_index, text=sessionName, style=label.style_label_center, color=color.new(color.black, 86), textcolor=f_sessionTextColor(sessionName), size=size.small)
    line newHighLine = line.new(x1=safeLeftBar, y1=sessionHigh, x2=bar_index, y2=sessionHigh, xloc=xloc.bar_index, color=f_sessionLineColor(sessionName, true), width=1, style=line.style_solid)
    line newLowLine = line.new(x1=safeLeftBar, y1=sessionLow, x2=bar_index, y2=sessionLow, xloc=xloc.bar_index, color=f_sessionLineColor(sessionName, false), width=1, style=line.style_solid)
    array.push(sessionRangeBoxes, newBox)
    array.push(sessionRangeLabels, newLabel)
    array.push(sessionRangeNames, sessionName)
    array.push(sessionRangeHighLines, newHighLine)
    array.push(sessionRangeLowLines, newLowLine)
    f_trimSessionVisuals(maxSessionVisuals)
    [newBox, newLabel, newHighLine, newLowLine]

f_syncSessionVisual(box currentBox, label currentLabel, line currentHighLine, line currentLowLine, int leftBar, float sessionHigh, float sessionLow, string sessionName) =>
    if not na(currentBox) and not na(sessionHigh) and not na(sessionLow)
        int safeBoxLeftBar = f_safeBarIndexX(leftBar)
        box.set_left(currentBox, safeBoxLeftBar)
        box.set_right(currentBox, bar_index)
        box.set_top(currentBox, sessionHigh)
        box.set_bottom(currentBox, sessionLow)
    if not na(currentHighLine) and not na(sessionHigh)
        int safeHighLineLeftBar = f_safeBarIndexX(leftBar)
        line.set_xy1(currentHighLine, safeHighLineLeftBar, sessionHigh)
        line.set_xy2(currentHighLine, bar_index, sessionHigh)
        line.set_style(currentHighLine, line.style_solid)
    if not na(currentLowLine) and not na(sessionLow)
        int safeLowLineLeftBar = f_safeBarIndexX(leftBar)
        line.set_xy1(currentLowLine, safeLowLineLeftBar, sessionLow)
        line.set_xy2(currentLowLine, bar_index, sessionLow)
        line.set_style(currentLowLine, line.style_solid)
    if not na(currentLabel) and not na(sessionHigh) and not na(sessionLow)
        label.set_x(currentLabel, f_safeBarIndexX(int(math.floor((leftBar + bar_index) * 0.5))))
        label.set_y(currentLabel, f_zoneMid(sessionHigh, sessionLow))
        label.set_text(currentLabel, sessionName)
        label.set_style(currentLabel, label.style_label_center)
        label.set_color(currentLabel, color.new(color.black, 86))
        label.set_size(currentLabel, size.small)

f_eng2_syncActiveSession(bool visualsEnabled, bool inSession, bool newSession, bool sessionEnded, box currentBox, label currentLabel, line currentHighLine, line currentLowLine, int currentStartBar, string sessionName, float sessionHigh, float sessionLow) =>
    box nextBox = currentBox
    label nextLabel = currentLabel
    line nextHighLine = currentHighLine
    line nextLowLine = currentLowLine
    int nextStartBar = currentStartBar
    if newSession
        nextStartBar := bar_index
    if visualsEnabled and inSession and na(nextBox) and not na(sessionHigh) and not na(sessionLow)
        nextStartBar := na(nextStartBar) ? bar_index : nextStartBar
        [newBox, newLabel, newHighLine, newLowLine] = f_addSessionVisual(sessionName, nextStartBar, sessionHigh, sessionLow)
        nextBox := newBox
        nextLabel := newLabel
        nextHighLine := newHighLine
        nextLowLine := newLowLine
    if inSession and visualsEnabled
        f_syncSessionVisual(nextBox, nextLabel, nextHighLine, nextLowLine, nextStartBar, sessionHigh, sessionLow, sessionName)
    else if sessionEnded
        nextBox := na
        nextLabel := na
        nextHighLine := na
        nextLowLine := na
        nextStartBar := na
    [nextBox, nextLabel, nextHighLine, nextLowLine, nextStartBar]

f_draw_session_box(bool visualsEnabled, bool inSession, bool newSession, bool sessionEnded, box currentBox, label currentLabel, line currentHighLine, line currentLowLine, int currentStartBar, string sessionName, float sessionHigh, float sessionLow) =>
    f_eng2_syncActiveSession(visualsEnabled, inSession, newSession, sessionEnded, currentBox, currentLabel, currentHighLine, currentLowLine, currentStartBar, sessionName, sessionHigh, sessionLow)

f_draw_structure_markers(bool enabled, int labelCap, int lineCap) =>
    if not enabled
        f_trimLabels(eng2StructureLabels, 0)
        f_trimLines(eng2StructureLines, 0)
    else
        f_trimLabels(eng2StructureLabels, labelCap)
        f_trimLines(eng2StructureLines, lineCap)

f_executionStateBadge(string stateText, bool compactText) =>
    stateText == "Active" ? (compactText ? "ACT" : "Active") : stateText == "Armed" ? (compactText ? "ARM" : "Armed") : stateText == "Managed" ? (compactText ? "MNG" : "Managed") : stateText == "Ambiguous" ? (compactText ? "AMB" : "Ambiguous") : stateText == "Completed" ? (compactText ? "CMP" : "Completed") : ""

f_executionSelectedFillAlpha(string stateText) =>
    stateText == "Active" ? 62 : stateText == "Armed" ? 70 : stateText == "Managed" ? 84 : stateText == "Completed" ? 88 : 78

f_executionSelectedLineWidth(string stateText) =>
    stateText == "Active" ? 3 : stateText == "Armed" ? 2 : 1

f_preferredExecutionText(string preferredDirection, string longExecutionState, string shortExecutionState, bool compactText) =>
    string longStateText = compactText ? f_executionStateCompact(longExecutionState) : longExecutionState
    string shortStateText = compactText ? f_executionStateCompact(shortExecutionState) : shortExecutionState
    if preferredDirection == "Long"
        "Long | " + longStateText
    else if preferredDirection == "Short"
        "Short | " + shortStateText
    else if preferredDirection == "Balanced"
        compactText ? "Bal | L " + longStateText + " / S " + shortStateText : "Balanced | L " + longExecutionState + " / S " + shortExecutionState
    else if longExecutionState == "Ambiguous" and shortExecutionState != "Ambiguous"
        "Long | " + longStateText
    else if shortExecutionState == "Ambiguous" and longExecutionState != "Ambiguous"
        "Short | " + shortStateText
    else
        "Wait | Scan"

f_setupScore(bool hasSetup, bool biasAligned, bool htfAligned, bool priceInZone, bool priceNearZone, float rr, bool chased, bool expired, bool invalidated) =>
    float score = na
    if hasSetup
        if invalidated or expired
            score := 0.0
        else
            float points = 0.0
            float maxPoints = 4.0
            points += biasAligned ? 1.5 : 0.0
            points += htfAligned ? 1.0 : 0.0
            points += priceInZone ? 1.0 : priceNearZone ? 0.5 : 0.0
            points += na(rr) ? 0.0 : rr >= 2.0 ? 0.5 : rr >= 1.0 ? 0.25 : 0.0
            points -= chased ? 1.0 : 0.0
            score := f_clamp(points / maxPoints * 100.0, 0.0, 100.0)
    score

//------------------------------------------------------------------------------
// ENGINE 3 HELPERS (Setup + Lifecycle)
//------------------------------------------------------------------------------
f_eng3_select_context_poi(bool preferOb, bool preferFvg, bool obIsBreaker, float obTop, float obBottom, float obEntry, int obCreatedBar, bool obTouched, float fvgTop, float fvgBottom, int fvgCreatedBar, bool fvgTouched) =>
    bool selectedOb = preferOb and not na(obTop) and not na(obBottom) and not na(obEntry)
    bool selectedFvg = not selectedOb and preferFvg and not na(fvgTop) and not na(fvgBottom)
    bool poiValid = selectedOb or selectedFvg
    string poiType = selectedOb ? (obIsBreaker ? "Breaker" : "OB") : selectedFvg ? "FVG" : ""
    float poiTop = selectedOb ? obTop : selectedFvg ? fvgTop : na
    float poiBottom = selectedOb ? obBottom : selectedFvg ? fvgBottom : na
    float poiEntry = selectedOb ? obEntry : selectedFvg ? f_zoneMid(fvgTop, fvgBottom) : na
    int poiBar = selectedOb ? obCreatedBar : selectedFvg ? fvgCreatedBar : na
    bool poiTouched = selectedOb ? obTouched : selectedFvg ? fvgTouched : false
    [poiValid, poiType, poiTop, poiBottom, poiEntry, poiBar, poiTouched]

f_eng3_build_trade_plan(bool isBull, bool poiValid, string poiType, float poiTop, float poiBottom, float poiEntry, int poiCreatedBar, bool poiTouched, float atrLevel, float stopBuffer, float execLiqHigh, float execLiqLow, float execEqHigh, float execEqLow, float ctxHigh, float ctxLow) =>
    float entry = na
    float stop = na
    float target = na
    bool targetIsLiquidity = false
    string setup = "Waiting"
    float validTop = na
    float validBottom = na
    bool isOb = false
    bool isFvg = false
    int createdBar = na
    bool touched = false
    if poiValid
        bool isBreaker = poiType == "Breaker"
        isOb := poiType == "OB" or isBreaker
        isFvg := poiType == "FVG"
        entry := poiEntry
        stop := isBull ? poiBottom - atrLevel * stopBuffer : poiTop + atrLevel * stopBuffer
        setup := isBull ? (isBreaker ? "Bullish Breaker" : isOb ? "Bullish OB" : "Bullish FVG") : (isBreaker ? "Bearish Breaker" : isOb ? "Bearish OB" : "Bearish FVG")
        validTop := poiTop
        validBottom := poiBottom
        createdBar := poiCreatedBar
        touched := poiTouched
    if not na(entry)
        target := isBull ? f_nearestAbove(entry, execLiqHigh, execEqHigh, ctxHigh, na, na, na, na) : f_nearestBelow(entry, execLiqLow, execEqLow, ctxLow, na, na, na, na)
        targetIsLiquidity := not na(target)
        float risk = not na(stop) ? (isBull ? entry - stop : stop - entry) : na
        if na(target) and not na(risk) and risk > 0
            target := isBull ? entry + risk * 2.0 : entry - risk * 2.0
    [entry, stop, target, targetIsLiquidity, setup, validTop, validBottom, isOb, isFvg, createdBar, touched]

f_eng3_validate_narrative_side(bool bullSide, bool execValid, int narrBias, int ctxTrendBias, bool ctxBullReversal, bool ctxBearReversal) =>
    bool ctxNeutral = ctxTrendBias == 0 and not ctxBullReversal and not ctxBearReversal
    bullSide ? (execValid and narrBias != -1 and (ctxTrendBias == 1 or ctxBullReversal or ctxNeutral)) : (execValid and narrBias != 1 and (ctxTrendBias == -1 or ctxBearReversal or ctxNeutral))

f_eng3_validate_execution_side(bool sweepPass, bool mssPass, bool displacementPass, bool pdPass, bool otePass, bool dolPass, bool kzPass) =>
    sweepPass and mssPass and displacementPass and pdPass and otePass and dolPass and kzPass

f_eng3_select_poi_preference(bool strictEnabled, bool hasOb, bool hasFvg, bool obConfirmPass, bool fvgConfirmPass, bool obInZone, bool fvgInZone) =>
    bool preferOb = false
    bool preferFvg = false
    if strictEnabled
        // In strict ICT mode, prefer FVG first after the ERL sweep.
        if hasFvg and fvgConfirmPass
            preferFvg := true
        else if hasOb and obConfirmPass
            preferOb := true
        else
            preferFvg := hasFvg
            preferOb := not preferFvg and hasOb
    else
        // In standard mode, keep selection explicit and lean:
        // confirmed candidate wins; otherwise in-zone candidate wins; otherwise OB wins.
        bool fvgConfirmed = hasFvg and fvgConfirmPass
        bool obConfirmed = hasOb and obConfirmPass
        if fvgConfirmed and not obConfirmed
            preferFvg := true
        else if obConfirmed and not fvgConfirmed
            preferOb := true
        else if fvgInZone and not obInZone
            preferFvg := true
        else if obInZone and not fvgInZone
            preferOb := true
        else if hasOb
            preferOb := true
        else
            preferFvg := hasFvg
    [preferOb, preferFvg]

f_eng3_update_trade_lifecycle(string setupTag, string prevSetupTag, bool managedLatched, bool completedLatched, bool ambiguousLatched, bool touched, bool managedHit, bool stopHit, bool tpHit, bool structureInvalidated, int setupAge, int expiryBarsWindow) =>
    string nextPrevTag = prevSetupTag
    bool nextManagedLatched = managedLatched
    bool nextCompletedLatched = completedLatched
    bool nextAmbiguousLatched = ambiguousLatched
    if setupTag == ""
        nextPrevTag := ""
        nextManagedLatched := false
        nextCompletedLatched := false
        nextAmbiguousLatched := false
    else if setupTag != prevSetupTag
        nextManagedLatched := false
        nextCompletedLatched := false
        nextAmbiguousLatched := false
    if setupTag != "" and managedHit
        nextManagedLatched := true

    bool latchedState = setupTag != "" and nextManagedLatched
    bool ambiguousNow = setupTag != "" and touched and not nextCompletedLatched and not nextAmbiguousLatched and stopHit and tpHit
    if ambiguousNow
        nextAmbiguousLatched := true
    if setupTag != "" and tpHit and not ambiguousNow and not nextAmbiguousLatched
        nextCompletedLatched := true
    bool isAmbiguous = setupTag != "" and nextAmbiguousLatched
    bool isCompleted = setupTag != "" and nextCompletedLatched and not isAmbiguous
    bool invalidated = not isAmbiguous and ((stopHit and not ambiguousNow) or structureInvalidated)
    bool managedStale = latchedState and not isCompleted and not isAmbiguous and not na(setupAge) and setupAge > expiryBarsWindow
    bool isManaged = latchedState and not managedStale and not isAmbiguous
    bool touchedStale = touched and not latchedState and not isCompleted and not isAmbiguous and not na(setupAge) and setupAge > expiryBarsWindow
    bool expiredUntouched = not touched and not na(setupAge) and setupAge > expiryBarsWindow
    bool expired = expiredUntouched or touchedStale or managedStale

    nextPrevTag := setupTag
    [nextPrevTag, nextManagedLatched, nextCompletedLatched, nextAmbiguousLatched, isManaged, isCompleted, isAmbiguous, invalidated, expired]

//------------------------------------------------------------------------------
// ENGINE 1
// Closed-candle MTF buffer + snapshot contract.
//------------------------------------------------------------------------------
string TF_M1 = "1"
string TF_M5 = "5"
string TF_M15 = "15"
string TF_M30 = "30"
string TF_H1 = "60"
string TF_H4 = "240"
string TF_D1 = "1D"
string ENG1_TF_M1 = TF_M1
string ENG1_TF_M5 = TF_M5
string ENG1_TF_M15 = TF_M15
string ENG1_TF_M30 = TF_M30
string ENG1_TF_H1 = TF_H1
string ENG1_TF_H4 = TF_H4
string ENG1_TF_D1 = TF_D1
int ENG1_BUF_CAP = 300
int ENG1_SWING_LEN = 3
int ENG1_STRUCTURE_SCAN_CAP = 140
int ENG1_FVG_SCAN_CAP = 90
int ENG1_PD_LOOKBACK = 60

eng1_exec_tf = timeframe.main_period
eng1_ctx_tf = f_ictContextHtf(timeframe.in_seconds())
eng1_narr_tf = f_ictNarrativeHtf(timeframe.in_seconds())
eng1_exec_valid = eng1_ctx_tf != "" and eng1_narr_tf != ""

f_eng1_buf_push_int(array<int> buf, int value, int cap) =>
    if not na(value)
        array.unshift(buf, value)
        while array.size(buf) > cap
            array.pop(buf)

f_eng1_buf_push_float(array<float> buf, float value, int cap) =>
    if not na(value)
        array.unshift(buf, value)
        while array.size(buf) > cap
            array.pop(buf)

f_eng1_tf_closed_ohlc(string tf) =>
    [t, o, h, l, c] = request.security(syminfo.tickerid, tf, [time[1], open[1], high[1], low[1], close[1]], lookahead=barmerge.lookahead_off)
    [t, o, h, l, c]

f_eng1_update_ohlc_buffer(string tf, int lastClosedTime, array<int> arrT, array<float> arrO, array<float> arrH, array<float> arrL, array<float> arrC, int cap) =>
    [closedTime, closedOpen, closedHigh, closedLow, closedClose] = f_eng1_tf_closed_ohlc(tf)
    bool newClosed = not na(closedTime) and (na(lastClosedTime) or closedTime != lastClosedTime)
    int nextLastClosedTime = lastClosedTime
    if newClosed
        f_eng1_buf_push_int(arrT, closedTime, cap)
        f_eng1_buf_push_float(arrO, closedOpen, cap)
        f_eng1_buf_push_float(arrH, closedHigh, cap)
        f_eng1_buf_push_float(arrL, closedLow, cap)
        f_eng1_buf_push_float(arrC, closedClose, cap)
        nextLastClosedTime := closedTime
    [newClosed, nextLastClosedTime]

f_eng1_avg_range(array<float> arrH, array<float> arrL, int lookback) =>
    int sample = math.min(math.min(array.size(arrH), array.size(arrL)), lookback)
    float totalRange = 0.0
    if sample > 0
        for i = 0 to sample - 1
            totalRange += math.abs(array.get(arrH, i) - array.get(arrL, i))
    sample > 0 ? totalRange / sample : na

f_eng1_is_pivot_high(array<float> arrH, int pivotIdx, int swingLen) =>
    bool isPivot = pivotIdx >= swingLen and pivotIdx <= array.size(arrH) - 1 - swingLen
    if isPivot
        float center = array.get(arrH, pivotIdx)
        for offset = 1 to swingLen
            float newerHigh = array.get(arrH, pivotIdx - offset)
            float olderHigh = array.get(arrH, pivotIdx + offset)
            isPivot := isPivot and center > newerHigh and center >= olderHigh
    isPivot

f_eng1_is_pivot_low(array<float> arrL, int pivotIdx, int swingLen) =>
    bool isPivot = pivotIdx >= swingLen and pivotIdx <= array.size(arrL) - 1 - swingLen
    if isPivot
        float center = array.get(arrL, pivotIdx)
        for offset = 1 to swingLen
            float newerLow = array.get(arrL, pivotIdx - offset)
            float olderLow = array.get(arrL, pivotIdx + offset)
            isPivot := isPivot and center < newerLow and center <= olderLow
    isPivot

f_eng1_time_at_idx(array<int> arrT, int idx) =>
    int size = array.size(arrT)
    bool ok = not na(idx) and idx >= 0 and idx < size
    ok ? array.get(arrT, idx) : na

f_eng1_find_swings(array<float> arrH, array<float> arrL, int swingLen) =>
    float lastHigh = na
    int lastHighIdx = na
    float prevHigh = na
    int prevHighIdx = na
    float lastLow = na
    int lastLowIdx = na
    float prevLow = na
    int prevLowIdx = na
    int size = math.min(array.size(arrH), array.size(arrL))
    int maxPivotIdx = math.min(size - 1 - swingLen, ENG1_STRUCTURE_SCAN_CAP)
    if maxPivotIdx >= swingLen
        for idx = swingLen to maxPivotIdx
            bool foundHigh = f_eng1_is_pivot_high(arrH, idx, swingLen)
            bool foundLow = f_eng1_is_pivot_low(arrL, idx, swingLen)
            if foundHigh
                if na(lastHigh)
                    lastHigh := array.get(arrH, idx)
                    lastHighIdx := idx
                else if na(prevHigh)
                    prevHigh := array.get(arrH, idx)
                    prevHighIdx := idx
            if foundLow
                if na(lastLow)
                    lastLow := array.get(arrL, idx)
                    lastLowIdx := idx
                else if na(prevLow)
                    prevLow := array.get(arrL, idx)
                    prevLowIdx := idx
            if not na(lastHigh) and not na(prevHigh) and not na(lastLow) and not na(prevLow)
                break
    [lastHigh, lastHighIdx, prevHigh, prevHighIdx, lastLow, lastLowIdx, prevLow, prevLowIdx]

f_eng1_build_structure_liquidity(array<int> arrT, array<float> arrH, array<float> arrL, array<float> arrC, int swingLen) =>
    [lastHigh, lastHighIdx, prevHigh, prevHighIdx, lastLow, lastLowIdx, prevLow, prevLowIdx] = f_eng1_find_swings(arrH, arrL, swingLen)
    int lastHighBar = f_eng1_time_at_idx(arrT, lastHighIdx)
    int prevHighBar = f_eng1_time_at_idx(arrT, prevHighIdx)
    int lastLowBar = f_eng1_time_at_idx(arrT, lastLowIdx)
    int prevLowBar = f_eng1_time_at_idx(arrT, prevLowIdx)

    int trendBiasLocal = 0
    int closeSize = array.size(arrC)
    if closeSize > 0
        float latestClose = array.get(arrC, 0)
        if not na(lastHigh) and latestClose > lastHigh
            trendBiasLocal := 1
        else if not na(lastLow) and latestClose < lastLow
            trendBiasLocal := -1
        else if not na(lastHigh) and not na(prevHigh) and not na(lastLow) and not na(prevLow)
            bool higherHighs = lastHigh > prevHigh
            bool higherLows = lastLow > prevLow
            bool lowerHighs = lastHigh < prevHigh
            bool lowerLows = lastLow < prevLow
            trendBiasLocal := higherHighs and higherLows ? 1 : lowerHighs and lowerLows ? -1 : 0
        else if not na(lastHigh) and not na(lastLow)
            float swingMid = (lastHigh + lastLow) * 0.5
            trendBiasLocal := latestClose > swingMid ? 1 : latestClose < swingMid ? -1 : 0

    // Liquidity pools (EQH/EQL) derived from the latest two pivots.
    float eqh = na
    float eql = na
    int eqhBar = na
    int eqlBar = na
    bool eqhActive = false
    bool eqlActive = false
    float avgRange = f_eng1_avg_range(arrH, arrL, 20)
    float tolerance = na(avgRange) ? syminfo.mintick * 2.0 : math.max(avgRange * equalToleranceAtr, syminfo.mintick * 2.0)
    if not na(lastHigh) and not na(prevHigh) and not na(lastHighIdx) and not na(prevHighIdx) and math.abs(lastHigh - prevHigh) <= tolerance
        eqh := math.max(lastHigh, prevHigh)
        int eqhAnchorIdx = math.min(lastHighIdx, prevHighIdx)
        eqhBar := f_eng1_time_at_idx(arrT, eqhAnchorIdx)
        eqhActive := true
        if eqhAnchorIdx > 0
            for i = 0 to eqhAnchorIdx - 1
                eqhActive := eqhActive and array.get(arrH, i) <= eqh
    if not na(lastLow) and not na(prevLow) and not na(lastLowIdx) and not na(prevLowIdx) and math.abs(lastLow - prevLow) <= tolerance
        eql := math.min(lastLow, prevLow)
        int eqlAnchorIdx = math.min(lastLowIdx, prevLowIdx)
        eqlBar := f_eng1_time_at_idx(arrT, eqlAnchorIdx)
        eqlActive := true
        if eqlAnchorIdx > 0
            for i = 0 to eqlAnchorIdx - 1
                eqlActive := eqlActive and array.get(arrL, i) >= eql

    [lastHigh, lastHighBar, prevHigh, prevHighBar, lastLow, lastLowBar, prevLow, prevLowBar, trendBiasLocal, eqh, eqhBar, eql, eqlBar, eqhActive, eqlActive]

f_eng1_structure_break_signals(float lastHigh, float lastLow, int priorTrendBias, array<float> arrC) =>
    bool bullBos = false
    bool bearBos = false
    bool bullChoch = false
    bool bearChoch = false
    if array.size(arrC) > 0
        float latestClose = array.get(arrC, 0)
        bullBos := not na(lastHigh) and latestClose > lastHigh
        bearBos := not na(lastLow) and latestClose < lastLow
        bullChoch := bullBos and priorTrendBias == -1
        bearChoch := bearBos and priorTrendBias == 1
    [bullBos, bearBos, bullChoch, bearChoch]

f_eng1_build_liquidity_layers(float lastHigh, float prevHigh, float lastLow, float prevLow, float eqh, float eql, bool eqhActive, bool eqlActive) =>
    float erlHigh = eqhActive ? eqh : lastHigh
    float erlLow = eqlActive ? eql : lastLow
    float irlHigh = not na(lastHigh) and not na(prevHigh) ? math.min(lastHigh, prevHigh) : lastHigh
    float irlLow = not na(lastLow) and not na(prevLow) ? math.max(lastLow, prevLow) : lastLow
    bool irlInvalid = not na(irlHigh) and not na(irlLow) and irlHigh <= irlLow
    if irlInvalid
        irlHigh := erlHigh
        irlLow := erlLow
    [erlHigh, erlLow, irlHigh, irlLow]

f_eng1_window_high_safe(array<float> arrH, int lookback) =>
    int sample = math.min(array.size(arrH), lookback)
    float highest = na
    if sample > 0
        highest := array.get(arrH, 0)
        if sample > 1
            for i = 1 to sample - 1
                highest := math.max(highest, array.get(arrH, i))
    highest

f_eng1_window_low_safe(array<float> arrL, int lookback) =>
    int sample = math.min(array.size(arrL), lookback)
    float lowest = na
    if sample > 0
        lowest := array.get(arrL, 0)
        if sample > 1
            for i = 1 to sample - 1
                lowest := math.min(lowest, array.get(arrL, i))
    lowest

f_eng1_build_pd_arrays(array<float> arrH, array<float> arrL, int lookback) =>
    float rangeHigh = f_eng1_window_high_safe(arrH, lookback)
    float rangeLow = f_eng1_window_low_safe(arrL, lookback)
    float rangeSize = not na(rangeHigh) and not na(rangeLow) ? (rangeHigh - rangeLow) : na
    float equilibrium = not na(rangeHigh) and not na(rangeLow) ? (rangeHigh + rangeLow) * 0.5 : na
    float oteLongTop = not na(rangeSize) and rangeSize > 0 ? rangeHigh - rangeSize * 0.62 : na
    float oteLongBottom = not na(rangeSize) and rangeSize > 0 ? rangeHigh - rangeSize * 0.79 : na
    float oteShortTop = not na(rangeSize) and rangeSize > 0 ? rangeLow + rangeSize * 0.79 : na
    float oteShortBottom = not na(rangeSize) and rangeSize > 0 ? rangeLow + rangeSize * 0.62 : na
    [rangeHigh, rangeLow, equilibrium, oteLongTop, oteLongBottom, oteShortTop, oteShortBottom]

f_eng1_body_share(float candleOpen, float candleHigh, float candleLow, float candleClose) =>
    float candleRange = candleHigh - candleLow
    candleRange > 0 ? math.abs(candleClose - candleOpen) / candleRange : 0.0

f_eng1_break_up(float level, float candleClose) =>
    candleClose > level

f_eng1_break_down(float level, float candleClose) =>
    candleClose < level

f_eng1_window_high(array<float> arrH, int lookback) =>
    f_eng1_window_high_safe(arrH, lookback)

f_eng1_window_low(array<float> arrL, int lookback) =>
    f_eng1_window_low_safe(arrL, lookback)

f_eng1_segment_high(array<float> arrH, int startIdx, int endIdx) =>
    float highest = na
    int size = array.size(arrH)
    int fromIdx = math.max(0, startIdx)
    int toIdx = math.min(size - 1, endIdx)
    if size > 0 and fromIdx <= toIdx
        highest := array.get(arrH, fromIdx)
        if toIdx > fromIdx
            for i = fromIdx + 1 to toIdx
                highest := math.max(highest, array.get(arrH, i))
    highest

f_eng1_segment_low(array<float> arrL, int startIdx, int endIdx) =>
    float lowest = na
    int size = array.size(arrL)
    int fromIdx = math.max(0, startIdx)
    int toIdx = math.min(size - 1, endIdx)
    if size > 0 and fromIdx <= toIdx
        lowest := array.get(arrL, fromIdx)
        if toIdx > fromIdx
            for i = fromIdx + 1 to toIdx
                lowest := math.min(lowest, array.get(arrL, i))
    lowest

f_eng1_ob_bounds(bool isBull, float candleOpen, float candleHigh, float candleLow) =>
    float zoneTop = isBull ? candleOpen : candleHigh
    float zoneBottom = isBull ? candleLow : candleOpen
    [math.max(zoneTop, zoneBottom), math.min(zoneTop, zoneBottom)]

f_eng1_ob_entry_from_meta(float zoneTop, float zoneBottom) =>
    (zoneTop + zoneBottom) * 0.5

f_eng1_build_fvg(array<int> arrT, array<float> arrO, array<float> arrH, array<float> arrL, array<float> arrC) =>
    float bullTop = na
    float bullBottom = na
    int bullBar = na
    float bearTop = na
    float bearBottom = na
    int bearBar = na
    int size = math.min(array.size(arrT), math.min(array.size(arrO), math.min(array.size(arrH), math.min(array.size(arrL), array.size(arrC)))))
    if size >= 3
        float avgRange = f_eng1_avg_range(arrH, arrL, 20)
        float minGap = na(avgRange) ? syminfo.mintick * 4.0 : math.max(avgRange * fvgMinAtr, syminfo.mintick * 4.0)
        float displacementThreshold = na(avgRange) ? syminfo.mintick * 10.0 : math.max(avgRange * math.max(fvgMinAtr * 2.0, obImpulseAtr * 0.75), syminfo.mintick * 10.0)
        int maxRecentIdx = math.min(size - 3, ENG1_FVG_SCAN_CAP)
        // Performance note: keep this O(n). We track running extremes of newer bars
        // instead of validating candidates with nested loops.
        float runningMinLow = na
        float runningMaxHigh = na
        for recentIdx = 0 to maxRecentIdx
            int middleIdx = recentIdx + 1
            int olderIdx = recentIdx + 2
            float recentHigh = array.get(arrH, recentIdx)
            float recentLow = array.get(arrL, recentIdx)
            float middleOpen = array.get(arrO, middleIdx)
            float middleHigh = array.get(arrH, middleIdx)
            float middleLow = array.get(arrL, middleIdx)
            float middleClose = array.get(arrC, middleIdx)
            float olderHigh = array.get(arrH, olderIdx)
            float olderLow = array.get(arrL, olderIdx)
            bool middleBullDisp = middleClose > middleOpen and middleClose > olderHigh and (middleHigh - middleLow) >= displacementThreshold and f_eng1_body_share(middleOpen, middleHigh, middleLow, middleClose) >= 0.60
            bool middleBearDisp = middleClose < middleOpen and middleClose < olderLow and (middleHigh - middleLow) >= displacementThreshold and f_eng1_body_share(middleOpen, middleHigh, middleLow, middleClose) >= 0.60
            bool bullCandidate = na(bullTop) and recentLow > olderHigh and middleBullDisp and (recentLow - olderHigh) >= minGap
            bool bearCandidate = na(bearTop) and recentHigh < olderLow and middleBearDisp and (olderLow - recentHigh) >= minGap
            if bullCandidate
                float candidateTop = recentLow
                float candidateBottom = olderHigh
                bool candidateActive = true
                if not na(runningMinLow)
                    if runningMinLow <= candidateBottom
                        candidateActive := false
                    else if runningMinLow < candidateTop
                        candidateTop := math.max(runningMinLow, candidateBottom)
                if candidateActive
                    bullTop := candidateTop
                    bullBottom := candidateBottom
                    bullBar := array.get(arrT, recentIdx)
            if bearCandidate
                float candidateTop = olderLow
                float candidateBottom = recentHigh
                bool candidateActive = true
                if not na(runningMaxHigh)
                    if runningMaxHigh >= candidateTop
                        candidateActive := false
                    else if runningMaxHigh > candidateBottom
                        candidateBottom := math.min(runningMaxHigh, candidateTop)
                if candidateActive
                    bearTop := candidateTop
                    bearBottom := candidateBottom
                    bearBar := array.get(arrT, recentIdx)
            // Update running extremes after validating candidates.
            runningMinLow := na(runningMinLow) ? recentLow : math.min(runningMinLow, recentLow)
            runningMaxHigh := na(runningMaxHigh) ? recentHigh : math.max(runningMaxHigh, recentHigh)
            if not na(bullTop) and not na(bearTop)
                break
    [bullTop, bullBottom, bullBar, bearTop, bearBottom, bearBar]

f_eng1_build_ob(array<int> arrT, array<float> arrO, array<float> arrH, array<float> arrL, array<float> arrC) =>
    float bullTop = na
    float bullBottom = na
    float bullEntry = na
    int bullBar = na
    bool bullBreaker = false
    float bearTop = na
    float bearBottom = na
    float bearEntry = na
    int bearBar = na
    bool bearBreaker = false
    int size = math.min(array.size(arrT), math.min(array.size(arrO), math.min(array.size(arrH), math.min(array.size(arrL), array.size(arrC)))))
    if size >= 5
        float avgRange = f_eng1_avg_range(arrH, arrL, 20)
        float displacementThreshold = na(avgRange) ? syminfo.mintick * 10.0 : math.max(avgRange * obImpulseAtr, syminfo.mintick * 10.0)
        int searchCap = math.min(size - 2, obSearchBars + obValidationLookback + ENG1_SWING_LEN + 2)
        for idx = 1 to searchCap
            float obOpen = array.get(arrO, idx)
            float obHigh = array.get(arrH, idx)
            float obLow = array.get(arrL, idx)
            float obClose = array.get(arrC, idx)
            bool bearCandle = obClose < obOpen
            bool bullCandle = obClose > obOpen
            int olderStart = idx + 1
            int olderEnd = math.min(size - 1, idx + ENG1_SWING_LEN + 2)
            float priorHigh = f_eng1_segment_high(arrH, olderStart, olderEnd)
            float priorLow = f_eng1_segment_low(arrL, olderStart, olderEnd)
            bool bullSweepSeq = not na(priorLow) and obLow < priorLow
            bool bearSweepSeq = not na(priorHigh) and obHigh > priorHigh
            // Notes on "breaker":
            // - A bearish OB invalidated to the upside becomes a *bullish* breaker block (bullBreaker=true).
            // - A bullish OB invalidated to the downside becomes a *bearish* breaker block (bearBreaker=true).
            if bearCandle and bullSweepSeq and (na(bullTop) or na(bearTop))
                bool bullDispSeen = false
                bool bullBreakSeen = false
                bool bullInvalidated = false
                for step = 0 to idx - 1
                    int j = idx - 1 - step
                    float newerOpen = array.get(arrO, j)
                    float newerHigh = array.get(arrH, j)
                    float newerLow = array.get(arrL, j)
                    float newerClose = array.get(arrC, j)
                    float newerRange = newerHigh - newerLow
                    bool newerDisp = newerClose > newerOpen and newerRange >= displacementThreshold and f_eng1_body_share(newerOpen, newerHigh, newerLow, newerClose) >= 0.60
                    if newerDisp
                        bullDispSeen := true
                    if bullDispSeen and not na(priorHigh) and f_eng1_break_up(priorHigh, newerClose)
                        bullBreakSeen := true
                    if bullBreakSeen and f_eng1_break_down(obLow, newerClose)
                        bullInvalidated := true
                bool bullPattern = bullDispSeen and bullBreakSeen
                if bullPattern
                    [candidateTop, candidateBottom] = f_eng1_ob_bounds(true, obOpen, obHigh, obLow)
                    float candidateEntry = f_eng1_ob_entry_from_meta(candidateTop, candidateBottom)
                    int candidateBar = array.get(arrT, idx)
                    if bullInvalidated
                        if na(bearTop)
                            bearTop := candidateTop
                            bearBottom := candidateBottom
                            bearEntry := candidateEntry
                            bearBar := candidateBar
                            bearBreaker := true
                    else
                        if na(bullTop)
                            bullTop := candidateTop
                            bullBottom := candidateBottom
                            bullEntry := candidateEntry
                            bullBar := candidateBar
                            bullBreaker := false
            if bullCandle and bearSweepSeq and (na(bearTop) or na(bullTop))
                bool bearDispSeen = false
                bool bearBreakSeen = false
                bool bearInvalidated = false
                for step = 0 to idx - 1
                    int j = idx - 1 - step
                    float newerOpen = array.get(arrO, j)
                    float newerHigh = array.get(arrH, j)
                    float newerLow = array.get(arrL, j)
                    float newerClose = array.get(arrC, j)
                    float newerRange = newerHigh - newerLow
                    bool newerDisp = newerClose < newerOpen and newerRange >= displacementThreshold and f_eng1_body_share(newerOpen, newerHigh, newerLow, newerClose) >= 0.60
                    if newerDisp
                        bearDispSeen := true
                    if bearDispSeen and not na(priorLow) and f_eng1_break_down(priorLow, newerClose)
                        bearBreakSeen := true
                    if bearBreakSeen and f_eng1_break_up(obHigh, newerClose)
                        bearInvalidated := true
                bool bearPattern = bearDispSeen and bearBreakSeen
                if bearPattern
                    [candidateTop, candidateBottom] = f_eng1_ob_bounds(false, obOpen, obHigh, obLow)
                    float candidateEntry = f_eng1_ob_entry_from_meta(candidateTop, candidateBottom)
                    int candidateBar = array.get(arrT, idx)
                    if bearInvalidated
                        if na(bullTop)
                            bullTop := candidateTop
                            bullBottom := candidateBottom
                            bullEntry := candidateEntry
                            bullBar := candidateBar
                            bullBreaker := true
                    else
                        if na(bearTop)
                            bearTop := candidateTop
                            bearBottom := candidateBottom
                            bearEntry := candidateEntry
                            bearBar := candidateBar
                            bearBreaker := false
            if not na(bullTop) and not na(bearTop)
                break
    [bullTop, bullBottom, bullEntry, bullBar, bullBreaker, bearTop, bearBottom, bearEntry, bearBar, bearBreaker]

f_eng1_build_execution(float lastHigh, float lastLow, float protectedHigh, float protectedLow, array<float> arrO, array<float> arrH, array<float> arrL, array<float> arrC) =>
    bool bullSweep = false
    bool bearSweep = false
    bool bullDisplacement = false
    bool bearDisplacement = false
    bool bullMss = false
    bool bearMss = false
    float nextProtectedHigh = protectedHigh
    float nextProtectedLow = protectedLow
    int size = math.min(math.min(array.size(arrO), array.size(arrH)), math.min(array.size(arrL), array.size(arrC)))
    if size > 0
        float latestOpen = array.get(arrO, 0)
        float latestHigh = array.get(arrH, 0)
        float latestLow = array.get(arrL, 0)
        float latestClose = array.get(arrC, 0)
        float avgRange = f_eng1_avg_range(arrH, arrL, 20)
        float latestRange = latestHigh - latestLow
        float bodyShare = f_eng1_body_share(latestOpen, latestHigh, latestLow, latestClose)
        float displacementThreshold = na(avgRange) ? syminfo.mintick * 8.0 : math.max(avgRange * 1.10, syminfo.mintick * 8.0)
        bullSweep := not na(lastLow) and latestLow < lastLow and latestClose > lastLow
        bearSweep := not na(lastHigh) and latestHigh > lastHigh and latestClose < lastHigh
        bullDisplacement := latestClose > latestOpen and latestRange >= displacementThreshold and bodyShare >= 0.55
        bearDisplacement := latestClose < latestOpen and latestRange >= displacementThreshold and bodyShare >= 0.55
        float bullMssLevel = not na(protectedHigh) ? protectedHigh : lastHigh
        float bearMssLevel = not na(protectedLow) ? protectedLow : lastLow
        bullMss := bullDisplacement and not na(bullMssLevel) and f_eng1_break_up(bullMssLevel, latestClose)
        bearMss := bearDisplacement and not na(bearMssLevel) and f_eng1_break_down(bearMssLevel, latestClose)
        if bullSweep
            nextProtectedLow := f_eng1_window_low_safe(arrL, math.min(size, 4))
        if bearSweep
            nextProtectedHigh := f_eng1_window_high_safe(arrH, math.min(size, 4))
        if bullMss
            nextProtectedLow := f_eng1_window_low_safe(arrL, math.min(size, 6))
        if bearMss
            nextProtectedHigh := f_eng1_window_high_safe(arrH, math.min(size, 6))
    [bullSweep, bearSweep, bullDisplacement, bearDisplacement, bullMss, bearMss, nextProtectedHigh, nextProtectedLow]

