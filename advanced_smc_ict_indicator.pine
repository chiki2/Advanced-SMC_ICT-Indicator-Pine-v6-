// Index / chart mapping state.
int ENG1_CHART_INDEX_CAP = 5000
int ENG1_TIME_MAP_CACHE_CAP = 64
var int eng1_chart_first_bar_index = na
var array<int> eng1_chart_time_index = array.new_int()
var array<int> eng1_chart_bar_index = array.new_int()
if barstate.isfirst
    eng1_chart_first_bar_index := bar_index
if barstate.isnew
    array.push(eng1_chart_time_index, time)
    array.push(eng1_chart_bar_index, bar_index)
    if array.size(eng1_chart_time_index) > ENG1_CHART_INDEX_CAP
        array.shift(eng1_chart_time_index)
        array.shift(eng1_chart_bar_index)

//------------------------------------------------------------------------------
// Functions
//------------------------------------------------------------------------------
f_biasShort(int bias) =>
    bias == 1 ? "Bull" : bias == -1 ? "Bear" : "Range"

f_sessionCode(string sessionLabel) =>
    sessionLabel == "Asia" ? "AS" : sessionLabel == "London" ? "LDN" : sessionLabel == "New York" ? "NY" : sessionLabel == "Inter-session" ? "INT" : sessionLabel

f_zoneMid(float zoneTop, float zoneBottom) =>
    (zoneTop + zoneBottom) * 0.5

f_fvgLabelText(bool isBull) =>
    compactMode ? (isBull ? "FVG+ CE" : "FVG- CE") : (isBull ? "Bullish FVG + CE" : "Bearish FVG + CE")

f_obLabelText(bool isBull, bool isBreaker) =>
    compactMode ? (isBreaker ? (isBull ? "BRK+" : "BRK-") : (isBull ? "OB+" : "OB-")) : (isBreaker ? (isBull ? "Bullish Breaker" : "Bearish Breaker") : (isBull ? "Bullish OB" : "Bearish OB"))

f_formatLevel(float price) =>
    na(price) ? "-" : str.tostring(price, format.mintick)

f_poiLifecycleDisplayText(string poiLifecycle, string poiType) =>
    poiType == "FVG" and poiLifecycle == "Mitigated" ? "CE Mitigated" : poiLifecycle

f_levelMatches(float referenceLevel, float candidate) =>
    not na(referenceLevel) and not na(candidate) and math.abs(referenceLevel - candidate) <= levelMatchTolerance

f_uniqueLevelVisual(bool visible, float level, bool prior1Visible, float prior1, bool prior2Visible, float prior2, bool prior3Visible, float prior3, bool prior4Visible, float prior4, bool prior5Visible, float prior5) =>
    visible and not ((prior1Visible and f_levelMatches(level, prior1)) or (prior2Visible and f_levelMatches(level, prior2)) or (prior3Visible and f_levelMatches(level, prior3)) or (prior4Visible and f_levelMatches(level, prior4)) or (prior5Visible and f_levelMatches(level, prior5)))

f_preferredLevelMatch(float candidate, bool balancedState, bool useLongPreference, float longLevel, float shortLevel) =>
    balancedState ? (f_levelMatches(longLevel, candidate) or f_levelMatches(shortLevel, candidate)) : f_levelMatches(useLongPreference ? longLevel : shortLevel, candidate)

f_selectAbove(float base, float best, float candidate) =>
    float result = best
    if not na(base) and not na(candidate) and candidate > base
        if na(result) or candidate < result
            result := candidate
    result

f_selectBelow(float base, float best, float candidate) =>
    float result = best
    if not na(base) and not na(candidate) and candidate < base
        if na(result) or candidate > result
            result := candidate
    result

f_rangeLiquidityLabel(bool highSide) =>
    highSide ? "ERL BSL" : "ERL SSL"

f_zoneQualityTier(bool hasSetup, int responseScore, int displacementScore, int atrExpansionScore) =>
    if not hasSetup
        "-"
    else
        int totalScore = responseScore + displacementScore + atrExpansionScore
        totalScore >= 5 ? "Q3" : totalScore >= 3 ? "Q2" : "Q1"

f_eng3_target_liquidity_clear(float targetLevel, float execLiqLevel, float execEqLevel, float ctxLevel, bool usesExternalDol) =>
    usesExternalDol or f_levelMatches(targetLevel, execLiqLevel) or f_levelMatches(targetLevel, execEqLevel) or f_levelMatches(targetLevel, ctxLevel)

f_eng3_dynamic_signal_score(bool sweepPass, bool displacementPass, bool mssPass, bool fvgFormed, bool pdLocationPass, bool killzoneBonus, bool targetLiquidityClear, bool htfOppositeStrong, bool wrongPdLocation, bool fvgTooFarOrMitigated) =>
    // Hard gates decide validity before this helper. This score ranks the evidence path.
    int score = 0
    score += sweepPass ? 2 : 0
    score += displacementPass ? 2 : 0
    score += mssPass ? 2 : 0
    score += fvgFormed ? 1 : 0
    score += pdLocationPass ? 1 : 0
    score += killzoneBonus ? 1 : 0
    score += targetLiquidityClear ? 1 : 0
    score -= htfOppositeStrong ? 2 : 0
    score -= wrongPdLocation ? 2 : 0
    score -= fvgTooFarOrMitigated ? 2 : 0
    math.max(score, 0)

f_zoneQualityLabelSuffix(string qualityTier) =>
    qualityTier == "-" ? "" : " | " + qualityTier

f_zoneQualityBorderAlpha(string qualityTier, string executionState) =>
    executionState == "Managed" ? 18 : qualityTier == "Q3" ? 0 : qualityTier == "Q2" ? 10 : qualityTier == "Q1" ? 26 : 12

f_zoneQualityBorderWidth(string qualityTier) =>
    qualityTier == "Q3" ? 3 : 2

f_createdBarFallback(int createdBar) =>
    int firstChartBar = not na(eng1_chart_first_bar_index) ? eng1_chart_first_bar_index : 0
    not na(createdBar) ? createdBar : firstChartBar

f_createdBarFromTime(int sourceTime) =>
    var array<int> mappedSourceTimes = array.new_int()
    var array<int> mappedChartBars = array.new_int()
    int mappedBar = na
    if not na(sourceTime) and sourceTime <= time
        int cacheSize = array.size(mappedSourceTimes)
        if cacheSize > 0
            for cacheIdx = 0 to cacheSize - 1
                if na(mappedBar) and array.get(mappedSourceTimes, cacheIdx) == sourceTime
                    mappedBar := array.get(mappedChartBars, cacheIdx)
        if na(mappedBar)
            int chartIndexSize = array.size(eng1_chart_time_index)
            if chartIndexSize > 0
                int firstIndexedTime = array.get(eng1_chart_time_index, 0)
                int lastIndexedTime = array.get(eng1_chart_time_index, chartIndexSize - 1)
                if sourceTime >= firstIndexedTime and sourceTime <= lastIndexedTime
                    int lo = 0
                    int hi = chartIndexSize - 1
                    int foundIdx = chartIndexSize - 1
                    while lo <= hi
                        int mid = int(math.floor((lo + hi) * 0.5))
                        int midTime = array.get(eng1_chart_time_index, mid)
                        if midTime >= sourceTime
                            foundIdx := mid
                            hi := mid - 1
                        else
                            lo := mid + 1
                    mappedBar := array.get(eng1_chart_bar_index, foundIdx)
            if not na(mappedBar)
                array.push(mappedSourceTimes, sourceTime)
                array.push(mappedChartBars, mappedBar)
                if array.size(mappedSourceTimes) > ENG1_TIME_MAP_CACHE_CAP
                    array.shift(mappedSourceTimes)
                    array.shift(mappedChartBars)
    na(sourceTime) ? na : mappedBar

f_zoneIntersects(float zoneTop, float zoneBottom, float refTop, float refBottom) =>
    not na(zoneTop) and not na(zoneBottom) and not na(refTop) and not na(refBottom) and math.max(zoneBottom, refBottom) <= math.min(zoneTop, refTop)

f_inSessionWindow(string sessionWindow) =>
    not na(time(timeframe.period, sessionWindow, tradingSessionTimezone))

f_inIpdaWindow(string sessionWindow) =>
    timeframe.isintraday and not na(time(timeframe.period, sessionWindow, ipdaTimeTimezone))

f_updateSessionRange(bool inSession, bool newSession, float runningHigh, float runningLow) =>
    float nextRunningHigh = runningHigh
    float nextRunningLow = runningLow
    if newSession
        nextRunningHigh := high
        nextRunningLow := low
    else if inSession
        nextRunningHigh := na(runningHigh) ? high : math.max(runningHigh, high)
        nextRunningLow := na(runningLow) ? low : math.min(runningLow, low)
    [nextRunningHigh, nextRunningLow]

f_nearestAbove(float entry, float level1, float level2, float level3, float level4, float level5, float level6, float level7) =>
    float target = na
    target := f_selectAbove(entry, target, level1)
    target := f_selectAbove(entry, target, level2)
    target := f_selectAbove(entry, target, level3)
    target := f_selectAbove(entry, target, level4)
    target := f_selectAbove(entry, target, level5)
    target := f_selectAbove(entry, target, level6)
    target := f_selectAbove(entry, target, level7)
    target

f_nearestBelow(float entry, float level1, float level2, float level3, float level4, float level5, float level6, float level7) =>
    float target = na
    target := f_selectBelow(entry, target, level1)
    target := f_selectBelow(entry, target, level2)
    target := f_selectBelow(entry, target, level3)
    target := f_selectBelow(entry, target, level4)
    target := f_selectBelow(entry, target, level5)
    target := f_selectBelow(entry, target, level6)
    target := f_selectBelow(entry, target, level7)
    target

f_safeBarIndexX(int targetBar) =>
    math.max(targetBar, math.max(bar_index - ENG1_CHART_INDEX_CAP, 0))

f_eng2_active_right_bar(int targetBar) =>
    na(targetBar) ? na : math.min(targetBar, bar_index)

f_eng1_sync_invalid_tf_label(label currentLabel, bool validTf, string chartTfText, float highLevel, float atrLevel) =>
    label updatedLabel = currentLabel
    if not validTf and barstate.islast
        string msg = "SMC/ICT: Unsupported chart TF " + chartTfText + ". Use M1, M5, M15, or M30."
        float y = highLevel + atrLevel * 0.8
        int x = bar_index + 1
        if na(updatedLabel)
            updatedLabel := label.new(x=x, y=y, xloc=xloc.bar_index, yloc=yloc.price, text=msg, style=label.style_label_left, color=color.new(color.black, 0), textcolor=color.white, size=size.small)
        else
            label.set_x(updatedLabel, x)
            label.set_y(updatedLabel, y)
            label.set_text(updatedLabel, msg)
            label.set_style(updatedLabel, label.style_label_left)
            label.set_color(updatedLabel, color.new(color.black, 0))
            label.set_textcolor(updatedLabel, color.white)
            label.set_size(updatedLabel, size.small)
    else if validTf and not na(updatedLabel)
        label.delete(updatedLabel)
        updatedLabel := na
    updatedLabel

f_eng2_label_atr_offset(float multiplier) =>
    (not na(atr) and atr > 0 ? atr : syminfo.mintick * 100.0) * multiplier

f_eng2_label_array_collision(label[] labelsArr, int targetTime, float targetY, int timeTolerance, float priceTolerance) =>
    bool occupied = false
    int labelCount = array.size(labelsArr)
    int scanCount = math.min(labelCount, 48)
    if scanCount > 0
        for scanStep = 0 to scanCount - 1
            int labelIndex = labelCount - 1 - scanStep
            label existingLabel = array.get(labelsArr, labelIndex)
            if not na(existingLabel)
                int existingTime = label.get_x(existingLabel)
                float existingY = label.get_y(existingLabel)
                occupied := occupied or (math.abs(existingTime - targetTime) <= timeTolerance and math.abs(existingY - targetY) <= priceTolerance)
    occupied

f_eng2_resolve_label_y(int targetTime, float level, bool placeAbove, float laneMultiplier, bool includeSignalEvents) =>
    float resolvedY = placeAbove ? level + f_eng2_label_atr_offset(laneMultiplier) : level - f_eng2_label_atr_offset(laneMultiplier)
    int tfMs = int(math.max(nz(timeframe.in_seconds(), 60), 1) * 1000)
    int timeTolerance = int(math.max(tfMs * 0.75, 1))
    float priceTolerance = f_eng2_label_atr_offset(0.24)
    for bumpStep = 0 to 7
        bool occupied = f_eng2_label_array_collision(eng2InternalStructureNodeHistory, targetTime, resolvedY, timeTolerance, priceTolerance)
        occupied := occupied or f_eng2_label_array_collision(eng2InternalStructureEventHistory, targetTime, resolvedY, timeTolerance, priceTolerance)
        occupied := occupied or f_eng2_label_array_collision(eng2SwingStructureNodeHistory, targetTime, resolvedY, timeTolerance, priceTolerance)
        occupied := occupied or f_eng2_label_array_collision(eng2SwingStructureEventHistory, targetTime, resolvedY, timeTolerance, priceTolerance)
        if includeSignalEvents
            occupied := occupied or f_eng2_label_array_collision(eng2SignalEventLabelHistory, targetTime, resolvedY, timeTolerance, priceTolerance)
        if occupied
            float bump = f_eng2_label_atr_offset(0.22 * (bumpStep + 1))
            resolvedY := placeAbove ? resolvedY + bump : resolvedY - bump
    resolvedY

f_eng2_trim_label_history(label[] labelsArr, int cap) =>
    while array.size(labelsArr) > cap
        label oldLabel = array.shift(labelsArr)
        if not na(oldLabel)
            label.delete(oldLabel)
    true

f_eng2_trim_line_history(line[] linesArr, int cap) =>
    while array.size(linesArr) > cap
        line oldLine = array.shift(linesArr)
        if not na(oldLine)
            line.delete(oldLine)
    true

f_eng2_pushStructureNodeTime(label[] labelsArr, int sourceTime, float level, string labelText, color textColor, bool placeAbove, bool enabled, int cap, string labelSize, string lanePrefix) =>
    if enabled and not na(sourceTime) and not na(level) and labelText != ""
        float labelY = f_eng2_resolve_label_y(sourceTime, level, placeAbove, lanePrefix == "s" ? 0.52 : 0.20, false)
        label newLabel = label.new(x=sourceTime, y=labelY, xloc=xloc.bar_time, yloc=yloc.price, text=labelText, style=label.style_none, color=color.new(color.black, 100), textcolor=textColor, size=labelSize, textalign=text.align_center)
        array.push(labelsArr, newLabel)
        f_eng2_trim_label_history(labelsArr, cap)
    true

f_eng2_pushStructureEventTime(label[] labelsArr, line[] linesArr, int leftTime, int rightTime, float level, string eventText, color eventColor, string eventStyle, int lineWidth, bool labelAbove, bool enabled, int cap, string labelSize, string lanePrefix) =>
    bool validTimePair = not na(leftTime) and not na(rightTime)
    int minTimeSpan = int(math.max(nz(timeframe.in_seconds(), 60), 1) * 1000)
    int safeRightTime = validTimePair ? (rightTime > leftTime ? rightTime : leftTime + minTimeSpan) : na
    if enabled and validTimePair and not na(level) and eventText != ""
        int midTime = leftTime + int(math.round((safeRightTime - leftTime) * 0.5))
        float labelY = f_eng2_resolve_label_y(midTime, level, labelAbove, lanePrefix == "s" ? 0.76 : 0.36, false)
        line newLine = line.new(x1=leftTime, y1=level, x2=safeRightTime, y2=level, xloc=xloc.bar_time, extend=extend.none, color=eventColor, style=eventStyle, width=math.max(lineWidth, 1))
        label newLabel = label.new(x=midTime, y=labelY, xloc=xloc.bar_time, yloc=yloc.price, text=eventText, style=label.style_none, color=color.new(color.black, 100), textcolor=eventColor, size=labelSize, textalign=text.align_center)
        array.push(linesArr, newLine)
        array.push(labelsArr, newLabel)
        f_eng2_trim_line_history(linesArr, cap)
        f_eng2_trim_label_history(labelsArr, cap)
    true

f_eng2_extend_latest_structure_event(label[] labelsArr, line[] linesArr, int rightTime) =>
    bool updated = false
    int lineCount = array.size(linesArr)
    int labelCount = array.size(labelsArr)
    int minTimeSpan = int(math.max(nz(timeframe.in_seconds(), 60), 1) * 1000)
    if lineCount > 0 and labelCount > 0 and not na(rightTime)
        line latestLine = array.get(linesArr, lineCount - 1)
        label latestLabel = array.get(labelsArr, labelCount - 1)
        if not na(latestLine)
            int leftTime = line.get_x1(latestLine)
            int safeRightTime = rightTime > leftTime ? rightTime : leftTime + minTimeSpan
            line.set_x2(latestLine, safeRightTime)
            if not na(latestLabel)
                int midTime = leftTime + int(math.round((safeRightTime - leftTime) * 0.5))
                label.set_x(latestLabel, midTime)
            updated := true
    updated

f_is_pivot_high(array<float> arrH, int pivotIdx, int swingLen) =>
    bool isPivot = pivotIdx >= swingLen and pivotIdx <= array.size(arrH) - 1 - swingLen
    if isPivot
        float center = array.get(arrH, pivotIdx)
        for offset = 1 to swingLen
            float newerHigh = array.get(arrH, pivotIdx - offset)
            float olderHigh = array.get(arrH, pivotIdx + offset)
            isPivot := isPivot and center > newerHigh and center >= olderHigh
    isPivot

f_is_pivot_low(array<float> arrL, int pivotIdx, int swingLen) =>
    bool isPivot = pivotIdx >= swingLen and pivotIdx <= array.size(arrL) - 1 - swingLen
    if isPivot
        float center = array.get(arrL, pivotIdx)
        for offset = 1 to swingLen
            float newerLow = array.get(arrL, pivotIdx - offset)
            float olderLow = array.get(arrL, pivotIdx + offset)
            isPivot := isPivot and center < newerLow and center <= olderLow
    isPivot

f_trimStructureVisuals(int cap) =>
    if array.size(eng2InternalStructureNodeHistory) > cap or array.size(eng2InternalStructureEventHistory) > cap or array.size(eng2InternalStructureEventLineHistory) > cap or array.size(eng2SwingStructureNodeHistory) > cap or array.size(eng2SwingStructureEventHistory) > cap or array.size(eng2SwingStructureEventLineHistory) > cap
        f_eng2_trim_label_history(eng2InternalStructureNodeHistory, cap)
        f_eng2_trim_label_history(eng2InternalStructureEventHistory, cap)
        f_eng2_trim_line_history(eng2InternalStructureEventLineHistory, cap)
        f_eng2_trim_label_history(eng2SwingStructureNodeHistory, cap)
        f_eng2_trim_label_history(eng2SwingStructureEventHistory, cap)
        f_eng2_trim_line_history(eng2SwingStructureEventLineHistory, cap)
    true

f_eng2_backfill_structure_node(bool internalLayer, int nodeTime, float nodeLevel, string nodeText, bool isHigh, int cap) =>
    string layerPrefix = internalLayer ? "i" : "s"
    string labelSize = internalLayer ? size.small : size.normal
    color nodeColor = nodeText == "HH" or nodeText == "HL" ? color.new(bullColor, 0) : nodeText == "LH" or nodeText == "LL" ? color.new(bearColor, 0) : color.new(neutralColor, 0)
    if internalLayer
        f_eng2_pushStructureNodeTime(eng2InternalStructureNodeHistory, nodeTime, nodeLevel, layerPrefix + nodeText, nodeColor, isHigh, true, cap, labelSize, layerPrefix)
    else
        f_eng2_pushStructureNodeTime(eng2SwingStructureNodeHistory, nodeTime, nodeLevel, layerPrefix + nodeText, nodeColor, isHigh, true, cap, labelSize, layerPrefix)
    true

f_eng2_backfill_structure_event(bool internalLayer, int leftTime, int rightTime, float level, string eventText, int eventBias, int cap) =>
    string layerPrefix = internalLayer ? "i" : "s"
    string labelSize = internalLayer ? size.small : size.normal
    string eventStyle = internalLayer ? line.style_dotted : line.style_solid
    int eventWidth = internalLayer ? 1 : 2
    color eventColor = eventBias == 1 ? color.new(bullColor, 0) : color.new(bearColor, 0)
    if internalLayer
        f_eng2_pushStructureEventTime(eng2InternalStructureEventHistory, eng2InternalStructureEventLineHistory, leftTime, rightTime, level, layerPrefix + eventText, eventColor, eventStyle, eventWidth, eventBias == 1, true, cap, labelSize, layerPrefix)
    else
        f_eng2_pushStructureEventTime(eng2SwingStructureEventHistory, eng2SwingStructureEventLineHistory, leftTime, rightTime, level, layerPrefix + eventText, eventColor, eventStyle, eventWidth, eventBias == 1, true, cap, labelSize, layerPrefix)
    true

f_eng2_backfill_structure_from_buffer(bool internalLayer, array<int> arrT, array<float> arrH, array<float> arrL, array<float> arrC, int swingLen, int scanCap, int nodeCap, int eventCap) =>
    int n = math.min(math.min(math.min(array.size(arrT), array.size(arrH)), array.size(arrL)), array.size(arrC))
    int maxIdx = math.min(n - 1 - swingLen, scanCap)
    float lastHigh = na
    float lastLow = na
    int lastHighTime = na
    int lastLowTime = na
    int structureBias = 0
    if maxIdx >= swingLen
        int idx = maxIdx
        while idx >= 0
            if idx < n - 1
                float closeNow = array.get(arrC, idx)
                float closePrev = array.get(arrC, idx + 1)
                int eventTime = array.get(arrT, idx)
                bool bullBreak = not na(lastHigh) and not na(closePrev) and closePrev <= lastHigh and closeNow > lastHigh
                bool bearBreak = not na(lastLow) and not na(closePrev) and closePrev >= lastLow and closeNow < lastLow
                if bullBreak and not bearBreak
                    f_eng2_backfill_structure_event(internalLayer, lastHighTime, eventTime, lastHigh, structureBias == -1 ? "MSS" : "BOS", 1, eventCap)
                    structureBias := 1
                else if bearBreak and not bullBreak
                    f_eng2_backfill_structure_event(internalLayer, lastLowTime, eventTime, lastLow, structureBias == 1 ? "MSS" : "BOS", -1, eventCap)
                    structureBias := -1
            bool canPivot = idx >= swingLen and idx <= n - 1 - swingLen
            if canPivot and f_is_pivot_high(arrH, idx, swingLen)
                float pivotHigh = array.get(arrH, idx)
                int pivotTime = array.get(arrT, idx)
                string highText = na(lastHigh) or pivotHigh > lastHigh ? "HH" : "LH"
                f_eng2_backfill_structure_node(internalLayer, pivotTime, pivotHigh, highText, true, nodeCap)
                lastHigh := pivotHigh
                lastHighTime := pivotTime
            if canPivot and f_is_pivot_low(arrL, idx, swingLen)
                float pivotLow = array.get(arrL, idx)
                int pivotTime = array.get(arrT, idx)
                string lowText = na(lastLow) ? "LL" : pivotLow > lastLow ? "HL" : "LL"
                f_eng2_backfill_structure_node(internalLayer, pivotTime, pivotLow, lowText, false, nodeCap)
                lastLow := pivotLow
                lastLowTime := pivotTime
            idx -= 1
    true

f_eng2_syncBoundedHLine(line currentLine, float level, color lineColor, int lineWidth, string lineStyle, bool enabled) =>
    line updatedLine = currentLine
    if enabled and not na(level)
        int x1 = f_safeBarIndexX(bar_index - ENG1_CHART_INDEX_CAP)
        if na(updatedLine)
            updatedLine := line.new(x1=x1, y1=level, x2=bar_index, y2=level, xloc=xloc.bar_index, extend=extend.none, color=lineColor, style=lineStyle, width=math.max(lineWidth, 1))
        else
            line.set_xy1(updatedLine, x1, level)
            line.set_xy2(updatedLine, bar_index, level)
            line.set_color(updatedLine, lineColor)
            line.set_style(updatedLine, lineStyle)
            line.set_width(updatedLine, math.max(lineWidth, 1))
    else if not na(updatedLine)
        line.delete(updatedLine)
        updatedLine := na
    updatedLine

// Horizontal segment (no extend) used for Engine 2 dealing range visuals.
f_eng2_syncSegmentHLine(line currentLine, int leftBar, int rightBar, float level, color lineColor, int lineWidth, string lineStyle, bool enabled) =>
    line updatedLine = currentLine
    if enabled and not na(level) and not na(leftBar) and not na(rightBar)
        int x1 = f_safeBarIndexX(leftBar)
        int x2 = f_safeBarIndexX(f_eng2_active_right_bar(rightBar))
        if x2 < x1
            int tmp = x1
            x1 := x2
            x2 := tmp
        if na(updatedLine)
            updatedLine := line.new(x1=x1, y1=level, x2=x2, y2=level, xloc=xloc.bar_index, extend=extend.none, color=lineColor, style=lineStyle, width=math.max(lineWidth, 1))
        else
            line.set_xy1(updatedLine, x1, level)
            line.set_xy2(updatedLine, x2, level)
            line.set_color(updatedLine, lineColor)
            line.set_style(updatedLine, lineStyle)
            line.set_width(updatedLine, math.max(lineWidth, 1))
    else if not na(updatedLine)
        line.delete(updatedLine)
        updatedLine := na
    updatedLine

f_eng2_syncLineFill(linefill currentFill, line lineA, line lineB, color fillColor, bool enabled) =>
    linefill updatedFill = currentFill
    if enabled and not na(lineA) and not na(lineB)
        if na(updatedFill)
            updatedFill := linefill.new(lineA, lineB, fillColor)
        else
            linefill.set_color(updatedFill, fillColor)
    else if not na(updatedFill)
        linefill.delete(updatedFill)
        updatedFill := na
    updatedFill

f_levelsClose(float levelA, float levelB, float tolerance) =>
    not na(levelA) and not na(levelB) and not na(tolerance) and math.abs(levelA - levelB) <= tolerance

f_eng2_same_zone_visual(float topA, float bottomA, int barA, float topB, float bottomB, int barB) =>
    bool levelsReady = not na(topA) and not na(bottomA) and not na(topB) and not na(bottomB)
    float tolerance = math.max(atr * equalToleranceAtr, syminfo.mintick * 2.0)
    float aTop = levelsReady ? math.max(topA, bottomA) : na
    float aBottom = levelsReady ? math.min(topA, bottomA) : na
    float bTop = levelsReady ? math.max(topB, bottomB) : na
    float bBottom = levelsReady ? math.min(topB, bottomB) : na
    bool sameLevels = levelsReady and f_levelsClose(aTop, bTop, tolerance) and f_levelsClose(aBottom, bBottom, tolerance)
    bool bothAnchorsMissing = na(barA) and na(barB)
    bool anchorsClose = not na(barA) and not na(barB) and math.abs(barA - barB) <= 1
    bool sameAnchor = sameLevels and (bothAnchorsMissing or anchorsClose)
    sameLevels and sameAnchor

f_eng2_matches_history_zone(bool historyVisible, bool historyTypeMatches, float zoneTop, float zoneBottom, int zoneBar, float historyTop, float historyBottom, int historyLeftBar) =>
    bool levelsReady = not na(zoneTop) and not na(zoneBottom) and not na(historyTop) and not na(historyBottom)
    float tolerance = math.max(atr * equalToleranceAtr, syminfo.mintick * 2.0)
    bool sameLevels = levelsReady and f_levelsClose(math.max(zoneTop, zoneBottom), math.max(historyTop, historyBottom), tolerance) and f_levelsClose(math.min(zoneTop, zoneBottom), math.min(historyTop, historyBottom), tolerance)
    bool sameAnchor = not na(zoneBar) and not na(historyLeftBar) and math.abs(zoneBar - historyLeftBar) <= 1
    historyVisible and historyTypeMatches and (sameAnchor or sameLevels)

f_sessionFillColor(string sessionName) =>
    sessionName == "Asia" ? asiaSessionFillColor : sessionName == "London" ? londonSessionFillColor : newYorkSessionFillColor

f_sessionBorderColor(string sessionName) =>
    sessionName == "Asia" ? asiaSessionBorderColor : sessionName == "London" ? londonSessionBorderColor : newYorkSessionBorderColor

f_sessionTextColor(string sessionName) =>
    // Slightly more opaque than lines so the session name stays readable.
    color.new(f_sessionBorderColor(sessionName), 8)

f_sessionLineColor(string sessionName, bool isHigh) =>
    color.new(f_sessionBorderColor(sessionName), isHigh ? 18 : 30)

f_setCell(table targetTable, int col, int row, string cellText, color textClr, color bgClr) =>
    table.cell(targetTable, col, row, cellText, text_color=textClr, bgcolor=bgClr, text_size=compactDashboardMode ? size.tiny : size.small)

f_clearDashboardTable(table targetTable, int lastRow) =>
    table.clear(targetTable, 0, 0, 1, lastRow)

f_prepareDashboardTable(table activeTable, int activeLastRow, table inactiveTable, int inactiveLastRow) =>
    f_clearDashboardTable(inactiveTable, inactiveLastRow)
    f_clearDashboardTable(activeTable, activeLastRow)
    table.cell(activeTable, 0, 0, "", text_color=color.new(color.white, 100), bgcolor=color.new(color.black, 100), text_size=size.tiny)
    table.cell(activeTable, 1, 0, "", text_color=color.new(color.white, 100), bgcolor=color.new(color.black, 100), text_size=size.tiny)

f_draw_zone_visible(string mode, bool isSelected, bool isBull, string preferredDirection) =>
    if mode == "Full"
        true
    else if mode == "Focused"
        isSelected
    else
        preferredDirection == "Long" ? (isBull and isSelected) : preferredDirection == "Short" ? (not isBull and isSelected) : isSelected

f_draw_level_visible(string mode, bool isPrimary, bool isBull, string preferredDirection) =>
    if mode == "Full"
        true
    else if mode == "Focused"
        isPrimary
    else
        preferredDirection == "Long" ? (isBull and isPrimary) : preferredDirection == "Short" ? (not isBull and isPrimary) : isPrimary

f_executionVisualByMode(string mode, bool riskVisible, string preferredDirection, bool isLong, bool useLongPreference) =>
    if not riskVisible
        false
    else if mode == "Full"
        true
    else if preferredDirection == "Balanced"
        useLongPreference ? isLong : not isLong
    else if preferredDirection == "Long"
        isLong
    else if preferredDirection == "Short"
        not isLong
    else
        false

f_contextVisualByMode(string mode) =>
    mode != "Minimal"

f_setupExecutionState(bool hasSetup, bool ambiguous, bool invalidated, bool expired, bool chased, bool completed, bool managed, bool baseContextPass, bool confirmationPass, bool mssFresh, bool displacementSeen, bool priceInZone, bool priceNearZone) =>
    not hasSetup ? "Waiting" : ambiguous ? "Ambiguous" : completed ? "Completed" : invalidated ? "Invalidated" : managed ? "Managed" : expired or chased ? "Expired" : not baseContextPass ? "Waiting" : not confirmationPass ? "Confirming" : mssFresh and displacementSeen ? (priceInZone or priceNearZone ? "Active" : "Armed") : "Waiting"

f_executionTerminal(string stateText) =>
    stateText == "Completed" or stateText == "Expired" or stateText == "Invalidated"

f_executionRiskVisible(string stateText) =>
    stateText == "Armed" or stateText == "Active" or stateText == "Managed" or stateText == "Ambiguous"

f_eng4_compact_bias_token(int bias) =>
    bias == 1 ? "Bu" : bias == -1 ? "Be" : "Rg"

f_eng4_retired_state(string executionState, int setupAge, bool touched, int expiryBarsWindow) =>
    executionState == "Invalidated" or executionState == "Completed" or executionState == "Expired" or (touched and not na(setupAge) and setupAge > expiryBarsWindow and not f_executionRiskVisible(executionState) and executionState != "Confirming" and executionState != "Ambiguous")

f_timeNormalizedBars(int baseBars, int baselineTfSeconds, int currentTfSeconds, int minBars) =>
    int safeBaselineSeconds = na(baselineTfSeconds) or baselineTfSeconds <= 0 ? 300 : baselineTfSeconds
    int safeCurrentSeconds = na(currentTfSeconds) or currentTfSeconds <= 0 ? safeBaselineSeconds : currentTfSeconds
    float baselineDurationSeconds = float(baseBars) * safeBaselineSeconds
    int(math.max(minBars, math.round(baselineDurationSeconds / safeCurrentSeconds)))

f_trimSessionVisuals(int keepCount) =>
    int cap = math.max(keepCount, 0)
    if array.size(sessionRangeBoxes) > cap or array.size(sessionRangeLabels) > cap or array.size(sessionRangeHighLines) > cap or array.size(sessionRangeLowLines) > cap or array.size(sessionRangeNames) > cap
        while array.size(sessionRangeBoxes) > cap
            box oldBox = array.shift(sessionRangeBoxes)
            label oldLabel = array.size(sessionRangeLabels) > 0 ? array.shift(sessionRangeLabels) : na
            if array.size(sessionRangeNames) > 0
                array.shift(sessionRangeNames)
            line oldHighLine = array.size(sessionRangeHighLines) > 0 ? array.shift(sessionRangeHighLines) : na
            line oldLowLine = array.size(sessionRangeLowLines) > 0 ? array.shift(sessionRangeLowLines) : na
            if not na(oldBox)
                box.delete(oldBox)
            if not na(oldLabel)
                label.delete(oldLabel)
            if not na(oldHighLine)
                line.delete(oldHighLine)
            if not na(oldLowLine)
                line.delete(oldLowLine)
        while array.size(sessionRangeLabels) > cap
            label extraLabel = array.shift(sessionRangeLabels)
            if not na(extraLabel)
                label.delete(extraLabel)
        while array.size(sessionRangeHighLines) > cap
            line extraHighLine = array.shift(sessionRangeHighLines)
            if not na(extraHighLine)
                line.delete(extraHighLine)
        while array.size(sessionRangeLowLines) > cap
            line extraLowLine = array.shift(sessionRangeLowLines)
            if not na(extraLowLine)
                line.delete(extraLowLine)
        while array.size(sessionRangeNames) > cap
            array.shift(sessionRangeNames)
    true

f_eng2_syncSessionLane(bool visualsEnabled, bool inSession, bool newSession, bool sessionEnded, box currentBox, label currentLabel, line currentHighLine, line currentLowLine, int currentStartBar, string sessionName, float sessionHigh, float sessionLow) =>
    if visualsEnabled
        box nextBox = currentBox
        label nextLabel = currentLabel
        line nextHighLine = currentHighLine
        line nextLowLine = currentLowLine
        int nextStartBar = currentStartBar
        if newSession
            nextStartBar := bar_index
        if inSession and na(nextBox) and not na(sessionHigh) and not na(sessionLow)
            nextStartBar := na(nextStartBar) ? bar_index : nextStartBar
            int safeLeftBar = f_safeBarIndexX(nextStartBar)
            color fillColor = f_sessionFillColor(sessionName)
            color borderColor = f_sessionBorderColor(sessionName)
            nextBox := box.new(left=safeLeftBar, top=sessionHigh, right=bar_index, bottom=sessionLow, xloc=xloc.bar_index, bgcolor=fillColor, border_color=borderColor, border_width=1)
            nextLabel := label.new(x=f_safeBarIndexX(int(math.floor((safeLeftBar + bar_index) * 0.5))), y=f_zoneMid(sessionHigh, sessionLow), xloc=xloc.bar_index, text=sessionName, style=label.style_label_center, color=color.new(color.black, 86), textcolor=f_sessionTextColor(sessionName), size=size.small)
            nextHighLine := line.new(x1=safeLeftBar, y1=sessionHigh, x2=bar_index, y2=sessionHigh, xloc=xloc.bar_index, color=f_sessionLineColor(sessionName, true), width=1, style=line.style_solid)
            nextLowLine := line.new(x1=safeLeftBar, y1=sessionLow, x2=bar_index, y2=sessionLow, xloc=xloc.bar_index, color=f_sessionLineColor(sessionName, false), width=1, style=line.style_solid)
        if inSession
            if not na(nextBox) and not na(sessionHigh) and not na(sessionLow)
                int safeBoxLeftBar = f_safeBarIndexX(nextStartBar)
                box.set_left(nextBox, safeBoxLeftBar)
                box.set_right(nextBox, bar_index)
                box.set_top(nextBox, sessionHigh)
                box.set_bottom(nextBox, sessionLow)
            if not na(nextHighLine) and not na(sessionHigh)
                int safeHighLineLeftBar = f_safeBarIndexX(nextStartBar)
                line.set_xy1(nextHighLine, safeHighLineLeftBar, sessionHigh)
                line.set_xy2(nextHighLine, bar_index, sessionHigh)
            if not na(nextLowLine) and not na(sessionLow)
                int safeLowLineLeftBar = f_safeBarIndexX(nextStartBar)
                line.set_xy1(nextLowLine, safeLowLineLeftBar, sessionLow)
                line.set_xy2(nextLowLine, bar_index, sessionLow)
            if not na(nextLabel) and not na(sessionHigh) and not na(sessionLow)
                label.set_x(nextLabel, f_safeBarIndexX(int(math.floor((nextStartBar + bar_index) * 0.5))))
                label.set_y(nextLabel, f_zoneMid(sessionHigh, sessionLow))
        else if sessionEnded
            if not na(nextBox)
                array.push(sessionRangeBoxes, nextBox)
                array.push(sessionRangeLabels, nextLabel)
                array.push(sessionRangeNames, sessionName)
                array.push(sessionRangeHighLines, nextHighLine)
                array.push(sessionRangeLowLines, nextLowLine)
                f_trimSessionVisuals(ENG2_SESSION_HISTORY_CAP)
            nextBox := na
            nextLabel := na
            nextHighLine := na
            nextLowLine := na
            nextStartBar := na
        [nextBox, nextLabel, nextHighLine, nextLowLine, nextStartBar]
    else if not na(currentBox) or not na(currentLabel) or not na(currentHighLine) or not na(currentLowLine) or not na(currentStartBar)
        if not na(currentBox)
            box.delete(currentBox)
        if not na(currentLabel)
            label.delete(currentLabel)
        if not na(currentHighLine)
            line.delete(currentHighLine)
        if not na(currentLowLine)
            line.delete(currentLowLine)
        box nextBox = na
        label nextLabel = na
        line nextHighLine = na
        line nextLowLine = na
        int nextStartBar = na
        [nextBox, nextLabel, nextHighLine, nextLowLine, nextStartBar]
    else
        [currentBox, currentLabel, currentHighLine, currentLowLine, currentStartBar]

f_executionStateBadge(string stateText, bool compactText) =>
    stateText == "Active" ? (compactText ? "ACT" : "Active") : stateText == "Armed" ? (compactText ? "ARM" : "Armed") : stateText == "Managed" ? (compactText ? "MNG" : "Managed") : stateText == "Ambiguous" ? (compactText ? "AMB" : "Ambiguous") : stateText == "Completed" ? (compactText ? "CMP" : "Completed") : ""

f_executionSelectedFillAlpha(string stateText) =>
    stateText == "Active" ? 78 : stateText == "Armed" ? 82 : stateText == "Managed" ? 88 : stateText == "Completed" ? 92 : 86

f_executionSelectedLineWidth(string stateText) =>
    stateText == "Active" ? 3 : stateText == "Armed" ? 2 : 1

f_eng2_syncSetupZoneVisual(box currentBox, line currentLine, label currentLabel, bool enabled, int createdBar, float zoneTop, float zoneBottom, float zoneEntry, string labelText, string labelStyle, color borderColor, color fillColor, int borderWidth, bool showEntryLine, string executionState) =>
    box nextBox = currentBox
    line nextLine = currentLine
    label nextLabel = currentLabel
    if enabled and not na(zoneTop) and not na(zoneBottom)
        float safeTop = math.max(zoneTop, zoneBottom)
        float safeBottom = math.min(zoneTop, zoneBottom)
        int leftBar = math.min(f_safeBarIndexX(f_createdBarFallback(createdBar)), bar_index)
        int rightBar = bar_index
        if na(nextBox)
            nextBox := box.new(left=leftBar, top=safeTop, right=rightBar, bottom=safeBottom, xloc=xloc.bar_index, extend=extend.none, bgcolor=fillColor, border_color=borderColor)
        else
            box.set_left(nextBox, leftBar)
            box.set_right(nextBox, rightBar)
            box.set_top(nextBox, safeTop)
            box.set_bottom(nextBox, safeBottom)
            box.set_bgcolor(nextBox, fillColor)
            box.set_border_color(nextBox, borderColor)
        box.set_border_width(nextBox, borderWidth)
        if showEntryLine and not na(zoneEntry)
            if na(nextLine)
                nextLine := line.new(x1=leftBar, y1=zoneEntry, x2=rightBar, y2=zoneEntry, xloc=xloc.bar_index, extend=extend.none, color=borderColor, width=f_executionSelectedLineWidth(executionState), style=line.style_dotted)
            else
                line.set_x1(nextLine, leftBar)
                line.set_x2(nextLine, rightBar)
                line.set_y1(nextLine, zoneEntry)
                line.set_y2(nextLine, zoneEntry)
                line.set_extend(nextLine, extend.none)
                line.set_color(nextLine, borderColor)
                line.set_width(nextLine, f_executionSelectedLineWidth(executionState))
                line.set_style(nextLine, line.style_dotted)
        else if not na(nextLine)
            line.delete(nextLine)
            nextLine := na
        if labelText != ""
            int labelX = rightBar + (compactMode ? 0 : 1)
            string visualLabelSize = executionState == "Active" or executionState == "Armed" ? size.small : size.tiny
            if na(nextLabel)
                nextLabel := label.new(x=labelX, y=f_zoneMid(safeTop, safeBottom), xloc=xloc.bar_index, text=labelText, style=labelStyle, color=color.new(borderColor, 0), textcolor=color.white, size=visualLabelSize)
            else
                label.set_x(nextLabel, labelX)
                label.set_y(nextLabel, f_zoneMid(safeTop, safeBottom))
                label.set_text(nextLabel, labelText)
                label.set_style(nextLabel, labelStyle)
                label.set_color(nextLabel, color.new(borderColor, 0))
                label.set_textcolor(nextLabel, color.white)
                label.set_size(nextLabel, visualLabelSize)
        else if not na(nextLabel)
            label.delete(nextLabel)
            nextLabel := na
    else
        if not na(nextBox)
            box.delete(nextBox)
            nextBox := na
        if not na(nextLine)
            line.delete(nextLine)
            nextLine := na
        if not na(nextLabel)
            label.delete(nextLabel)
            nextLabel := na
    [nextBox, nextLine, nextLabel]

f_eng2_syncPassiveZoneVisual(box currentBox, label currentLabel, bool enabled, int createdBar, float zoneTop, float zoneBottom, color borderColor, color fillColor) =>
    box nextBox = currentBox
    label nextLabel = currentLabel
    if enabled and not na(zoneTop) and not na(zoneBottom)
        float safeTop = math.max(zoneTop, zoneBottom)
        float safeBottom = math.min(zoneTop, zoneBottom)
        int leftBar = math.min(f_safeBarIndexX(f_createdBarFallback(createdBar)), bar_index)
        int rightBar = bar_index
        if na(nextBox)
            nextBox := box.new(left=leftBar, top=safeTop, right=rightBar, bottom=safeBottom, xloc=xloc.bar_index, extend=extend.none, bgcolor=fillColor, border_color=borderColor, border_width=1)
        else
            box.set_left(nextBox, leftBar)
            box.set_right(nextBox, rightBar)
            box.set_top(nextBox, safeTop)
            box.set_bottom(nextBox, safeBottom)
            box.set_bgcolor(nextBox, fillColor)
            box.set_border_color(nextBox, borderColor)
        if not na(nextLabel)
            label.delete(nextLabel)
            nextLabel := na
    else
        if not na(nextBox)
            box.delete(nextBox)
            nextBox := na
        if not na(nextLabel)
            label.delete(nextLabel)
            nextLabel := na
    [nextBox, nextLabel]

// Narrative HTF S/D is time-anchored, not POI-owned. If the source HTF time is
// unavailable, draw from the first indexed chart time so valid context levels
// do not disappear while strict POI/DR mapping remains unchanged.
f_eng2_syncHtfSdVisual(box currentBox, label currentLabel, bool enabled, int sourceTime, float zoneTop, float zoneBottom, string labelText, color borderColor, color fillColor) =>
    box nextBox = currentBox
    label nextLabel = currentLabel
    if enabled and not na(zoneTop) and not na(zoneBottom)
        float safeTop = math.max(zoneTop, zoneBottom)
        float safeBottom = math.min(zoneTop, zoneBottom)
        int rightTime = time
        int fallbackLeftTime = array.size(eng1_chart_time_index) > 0 ? array.get(eng1_chart_time_index, 0) : rightTime
        int rawLeftTime = na(sourceTime) ? fallbackLeftTime : sourceTime
        int leftTime = math.min(rawLeftTime, rightTime)
        int tfMs = int(math.max(nz(timeframe.in_seconds(), 60), 1) * 1000)
        int labelTime = rightTime + tfMs
        if na(nextBox)
            nextBox := box.new(left=leftTime, top=safeTop, right=rightTime, bottom=safeBottom, xloc=xloc.bar_time, extend=extend.none, bgcolor=fillColor, border_color=borderColor, border_width=1)
        else
            box.set_left(nextBox, leftTime)
            box.set_right(nextBox, rightTime)
            box.set_top(nextBox, safeTop)
            box.set_bottom(nextBox, safeBottom)
            box.set_bgcolor(nextBox, fillColor)
            box.set_border_color(nextBox, borderColor)
        if labelText != ""
            if na(nextLabel)
                nextLabel := label.new(x=labelTime, y=f_zoneMid(safeTop, safeBottom), xloc=xloc.bar_time, yloc=yloc.price, text=labelText, style=label.style_label_right, color=color.new(borderColor, 0), textcolor=color.white, size=size.tiny)
            else
                label.set_x(nextLabel, labelTime)
                label.set_y(nextLabel, f_zoneMid(safeTop, safeBottom))
                label.set_text(nextLabel, labelText)
                label.set_color(nextLabel, color.new(borderColor, 0))
        else if not na(nextLabel)
            label.delete(nextLabel)
            nextLabel := na
    else
        if not na(nextBox)
            box.delete(nextBox)
            nextBox := na
        if not na(nextLabel)
            label.delete(nextLabel)
            nextLabel := na
    [nextBox, nextLabel]

f_eng2_syncHistoryZoneBox(box currentBox, bool enabled, int leftBar, int rightBar, float zoneTop, float zoneBottom, color borderColor, color fillColor, int borderWidth) =>
    box nextBox = currentBox
    if enabled and not na(leftBar) and not na(rightBar) and not na(zoneTop) and not na(zoneBottom)
        float safeTop = math.max(zoneTop, zoneBottom)
        float safeBottom = math.min(zoneTop, zoneBottom)
        int rawLeftBar = math.min(leftBar, rightBar)
        int rawRightBar = math.max(leftBar, rightBar)
        int safeLeftBar = math.min(f_safeBarIndexX(rawLeftBar), bar_index)
        int safeRightBar = math.max(safeLeftBar, f_safeBarIndexX(f_eng2_active_right_bar(rawRightBar)))
        if na(nextBox)
            nextBox := box.new(left=safeLeftBar, top=safeTop, right=safeRightBar, bottom=safeBottom, xloc=xloc.bar_index, extend=extend.none, bgcolor=fillColor, border_color=borderColor, border_width=borderWidth)
        else
            box.set_left(nextBox, safeLeftBar)
            box.set_right(nextBox, safeRightBar)
            box.set_top(nextBox, safeTop)
            box.set_bottom(nextBox, safeBottom)
            box.set_bgcolor(nextBox, fillColor)
            box.set_border_color(nextBox, borderColor)
            box.set_border_width(nextBox, borderWidth)
    else if not na(nextBox)
        box.delete(nextBox)
        nextBox := na
    nextBox

f_eng2_syncRightLevelLabel(label currentLabel, float level, string labelText, color labelColor, bool enabled) =>
    label updatedLabel = currentLabel
    if enabled and not na(level)
        int xPos = bar_index + (compactMode ? 1 : 2)
        if na(updatedLabel)
            updatedLabel := label.new(x=xPos, y=level, xloc=xloc.bar_index, text=labelText, style=label.style_label_left, color=labelColor, textcolor=color.white, size=size.tiny)
        else
            label.set_x(updatedLabel, xPos)
            label.set_y(updatedLabel, level)
            label.set_text(updatedLabel, labelText)
            label.set_color(updatedLabel, labelColor)
    else if not na(updatedLabel)
        label.delete(updatedLabel)
        updatedLabel := na
    updatedLabel

f_eng2_syncThinLevelLine(line currentLine, float level, color lineColor, string lineStyle, bool enabled) =>
    f_eng2_syncBoundedHLine(currentLine, level, lineColor, 1, lineStyle, enabled)

f_eng2_syncRiskLevelLine(line currentLine, float level, color lineColor, int lineWidth, bool enabled) =>
    f_eng2_syncBoundedHLine(currentLine, level, lineColor, lineWidth, line.style_solid, enabled)

f_eng2_signal_event_cap() =>
    int tfSeconds = timeframe.in_seconds()
    int cap = 10
    if freeSafeMode
        cap := draw_full ? (tfSeconds <= 60 ? 4 : tfSeconds <= 300 ? 5 : 6) : 5
    else if draw_full
        cap := tfSeconds <= 60 ? 8 : tfSeconds <= 300 ? 10 : 12
    cap

f_eng2_trim_signal_event_history(int cap) =>
    if array.size(eng2SignalEventLabelHistory) > cap
        f_eng2_trim_label_history(eng2SignalEventLabelHistory, cap)
    true

f_eng2_emitSignalEvent(bool enabled, int eventTime, float level, string eventText, color eventColor, bool labelAbove, float lanePrefix) =>
    if enabled and not na(level) and eventText != ""
        // Signal events are secondary to market structure in Full audit mode.
        // Keep their history tighter so structure labels keep priority.
        int eventCap = f_eng2_signal_event_cap()
        int labelTime = na(eventTime) ? time : eventTime
        float labelY = f_eng2_resolve_label_y(labelTime, level, labelAbove, lanePrefix, true)
        string labelStyle = labelAbove ? label.style_label_down : label.style_label_up
        label newLabel = label.new(x=labelTime, y=labelY, xloc=xloc.bar_time, yloc=yloc.price, text=eventText, style=labelStyle, color=eventColor, textcolor=color.white, size=size.tiny, textalign=text.align_center)
        array.push(eng2SignalEventLabelHistory, newLabel)
        f_eng2_trim_signal_event_history(eventCap)
    true

//------------------------------------------------------------------------------
// ENGINE 3 HELPERS (Setup + Lifecycle)
//------------------------------------------------------------------------------
f_eng3_poi_ce_touched(bool isBull, string poiType, float poiTop, float poiBottom, float poiEntry, float signalHigh, float signalLow) =>
    float ceLevel = poiType == "FVG" ? f_zoneMid(poiTop, poiBottom) : poiEntry
    not na(ceLevel) and (isBull ? not na(signalLow) and signalLow <= ceLevel : not na(signalHigh) and signalHigh >= ceLevel)

f_eng3_poi_full_filled(bool isBull, float poiTop, float poiBottom, float signalHigh, float signalLow) =>
    float safeTop = not na(poiTop) and not na(poiBottom) ? math.max(poiTop, poiBottom) : na
    float safeBottom = not na(poiTop) and not na(poiBottom) ? math.min(poiTop, poiBottom) : na
    not na(safeTop) and not na(safeBottom) and (isBull ? not na(signalLow) and signalLow <= safeBottom : not na(signalHigh) and signalHigh >= safeTop)

f_eng3_poi_invalidated(bool isBull, float poiTop, float poiBottom, float signalClose) =>
    float safeTop = not na(poiTop) and not na(poiBottom) ? math.max(poiTop, poiBottom) : na
    float safeBottom = not na(poiTop) and not na(poiBottom) ? math.min(poiTop, poiBottom) : na
    not na(safeTop) and not na(safeBottom) and not na(signalClose) and (isBull ? signalClose < safeBottom : signalClose > safeTop)

f_eng3_poi_lifecycle(bool poiValid, string poiType, bool poiTouched, bool mitigated, bool invalidated) =>
    not poiValid ? "No POI" : invalidated ? "Invalidated/Superseded" : mitigated ? "Mitigated" : poiType == "Breaker" ? "Inverted/Breaker" : poiTouched ? "Tapped" : "Fresh"

f_eng3_poi_actionable(string poiLifecycle) =>
    poiLifecycle == "Fresh" or poiLifecycle == "Tapped" or poiLifecycle == "Inverted/Breaker"

f_eng3_poi_identity(string sideText, string poiType, int poiBar, float poiTop, float poiBottom) =>
    poiType != "" and not na(poiBar) and not na(poiTop) and not na(poiBottom) ? sideText + "|" + poiType + "|" + str.tostring(poiBar) + "|" + str.tostring(poiTop) + "|" + str.tostring(poiBottom) : ""

f_eng3_poi_retire_reason(bool completed, bool invalidated, bool expired, bool chased, bool staleRetired) =>
    completed ? "Done" : invalidated ? "Invalid" : expired or chased ? "Expired" : staleRetired ? "Stale" : ""

f_eng3_setup_tag(string setupText, int setupBar, float validTop, float validBottom) =>
    not na(setupBar) ? setupText + "|" + str.tostring(setupBar) + "|" + str.tostring(validTop) + "|" + str.tostring(validBottom) : ""

f_eng3_select_context_poi(bool preferOb, bool preferFvg, bool obIsBreaker, float obTop, float obBottom, float obEntry, int obCreatedBar, bool obTouched, float fvgTop, float fvgBottom, int fvgCreatedBar, bool fvgTouched) =>
    bool selectedOb = preferOb and not na(obTop) and not na(obBottom) and not na(obEntry)
    bool selectedFvg = not selectedOb and preferFvg and not na(fvgTop) and not na(fvgBottom)
    bool poiValid = selectedOb or selectedFvg
    string poiType = selectedOb ? (obIsBreaker ? "Breaker" : "OB") : selectedFvg ? "FVG" : ""
    float poiTop = selectedOb ? obTop : selectedFvg ? fvgTop : na
    float poiBottom = selectedOb ? obBottom : selectedFvg ? fvgBottom : na
    float poiEntry = selectedOb ? obEntry : selectedFvg ? f_zoneMid(fvgTop, fvgBottom) : na
    int poiBar = selectedOb ? obCreatedBar : selectedFvg ? fvgCreatedBar : na
    bool poiTouched = selectedOb ? obTouched : selectedFvg ? fvgTouched : false
    [poiValid, poiType, poiTop, poiBottom, poiEntry, poiBar, poiTouched]

f_eng3_build_trade_plan(bool isBull, bool poiValid, string poiType, float poiTop, float poiBottom, float poiEntry, int poiCreatedBar, bool poiTouched, float sweepExtreme, float execLiqHigh, float execLiqLow, float execEqHigh, float execEqLow, float ctxHigh, float ctxLow) =>
    bool isBreaker = poiValid and poiType == "Breaker"
    bool isOb = poiValid and (poiType == "OB" or isBreaker)
    bool isFvg = poiValid and poiType == "FVG"
    float entry = poiValid ? poiEntry : na
    float zoneStop = poiValid ? (isBull ? poiBottom - atr * stopAtrBuffer : poiTop + atr * stopAtrBuffer) : na
    float sweepStop = isBull ? sweepExtreme - atr * stopAtrBuffer : sweepExtreme + atr * stopAtrBuffer
    float stop = strictModeEnabled and not na(sweepExtreme) ? (isBull ? math.min(zoneStop, sweepStop) : math.max(zoneStop, sweepStop)) : zoneStop
    float target = na
    string setup = poiValid ? (isBull ? (isBreaker ? "Bullish Breaker" : isOb ? "Bullish OB" : "Bullish FVG") : (isBreaker ? "Bearish Breaker" : isOb ? "Bearish OB" : "Bearish FVG")) : "Waiting"
    if not na(entry)
        target := isBull ? f_nearestAbove(entry, execLiqHigh, execEqHigh, ctxHigh, na, na, na, na) : f_nearestBelow(entry, execLiqLow, execEqLow, ctxLow, na, na, na, na)
        float risk = not na(stop) ? (isBull ? entry - stop : stop - entry) : na
        if na(target) and not na(risk) and risk > 0
            target := isBull ? entry + risk * 2.0 : entry - risk * 2.0
    [entry, stop, target, setup, poiValid ? poiTop : na, poiValid ? poiBottom : na, isOb, isFvg, poiValid ? poiCreatedBar : na, poiValid ? poiTouched : false]

f_eng3_validate_narrative_side(bool bullSide, bool execValid, int narrBias, int ctxTrendBias, bool ctxBullReversal, bool ctxBearReversal) =>
    bool ctxNeutral = ctxTrendBias == 0 and not ctxBullReversal and not ctxBearReversal
    bullSide ? (execValid and narrBias != -1 and (ctxTrendBias == 1 or ctxBullReversal or ctxNeutral)) : (execValid and narrBias != 1 and (ctxTrendBias == -1 or ctxBearReversal or ctxNeutral))

f_eng3_strict_pd_array_owned(bool poiIsFvg, int poiBar, int sweepAge, int mssAge, int displacementAge, int ownershipWindow) =>
    bool owned = false
    if not na(poiBar) and not na(sweepAge) and not na(mssAge) and not na(displacementAge)
        int poiAge = bar_index - poiBar
        int earlyExpansionAge = mssAge > displacementAge ? mssAge : displacementAge
        int lateExpansionAge = mssAge < displacementAge ? mssAge : displacementAge
        int safeWindow = ownershipWindow > 1 ? ownershipWindow : 1
        owned := poiAge >= 0 and sweepAge >= mssAge and sweepAge >= displacementAge and lateExpansionAge <= safeWindow and poiAge <= sweepAge + safeWindow and (poiIsFvg ? poiAge <= earlyExpansionAge + safeWindow : poiAge >= lateExpansionAge - safeWindow)
    owned

f_eng3_select_poi_preference(bool strictEnabled, bool hasOb, bool hasFvg, bool obConfirmPass, bool fvgConfirmPass, bool obInZone, bool fvgInZone, bool obStrictOwned, bool fvgStrictOwned) =>
    bool preferOb = false
    bool preferFvg = false
    if strictEnabled
        if hasFvg and fvgConfirmPass and fvgStrictOwned
            preferFvg := true
        else if hasOb and obConfirmPass and obStrictOwned
            preferOb := true
    else
        // In standard mode, keep selection explicit and lean:
        // confirmed candidate wins; otherwise in-zone candidate wins; otherwise OB wins.
        bool fvgConfirmed = hasFvg and fvgConfirmPass
        bool obConfirmed = hasOb and obConfirmPass
        if fvgConfirmed and not obConfirmed
            preferFvg := true
        else if obConfirmed and not fvgConfirmed
            preferOb := true
        else if fvgInZone and not obInZone
            preferFvg := true
        else if obInZone and not fvgInZone
            preferOb := true
        else if hasOb
            preferOb := true
        else
            preferFvg := hasFvg
    [preferOb, preferFvg]

f_eng3_update_trade_lifecycle(string setupTag, string prevSetupTag, bool managedLatched, bool completedLatched, bool ambiguousLatched, bool invalidatedLatched, bool touched, bool managedHit, bool stopHit, bool tpHit, bool structureInvalidated, int setupAge, int expiryBarsWindow) =>
    bool hasSetup = setupTag != ""
    bool nextManagedLatched = managedLatched
    bool nextCompletedLatched = completedLatched
    bool nextAmbiguousLatched = ambiguousLatched
    bool nextInvalidatedLatched = invalidatedLatched
    if not hasSetup
        nextManagedLatched := false
        nextCompletedLatched := false
        nextAmbiguousLatched := false
        nextInvalidatedLatched := false
    else if setupTag != prevSetupTag
        nextManagedLatched := false
        nextCompletedLatched := false
        nextAmbiguousLatched := false
        nextInvalidatedLatched := false
    if hasSetup and managedHit
        nextManagedLatched := true

    bool latchedState = hasSetup and nextManagedLatched
    bool ambiguousNow = hasSetup and touched and not nextCompletedLatched and not nextAmbiguousLatched and stopHit and tpHit
    if ambiguousNow
        nextAmbiguousLatched := true
    if hasSetup and tpHit and not ambiguousNow and not nextAmbiguousLatched
        nextCompletedLatched := true
    bool isAmbiguous = hasSetup and nextAmbiguousLatched
    bool isCompleted = hasSetup and nextCompletedLatched and not isAmbiguous
    bool invalidatedNow = hasSetup and not isAmbiguous and not isCompleted and ((stopHit and not ambiguousNow) or structureInvalidated)
    if invalidatedNow
        nextInvalidatedLatched := true
    bool invalidated = hasSetup and nextInvalidatedLatched and not isAmbiguous and not isCompleted
    bool managedStale = latchedState and not isCompleted and not isAmbiguous and not na(setupAge) and setupAge > expiryBarsWindow
    bool isManaged = latchedState and not managedStale and not isAmbiguous
    bool touchedStale = touched and not latchedState and not isCompleted and not isAmbiguous and not na(setupAge) and setupAge > expiryBarsWindow
    bool expiredUntouched = not touched and not na(setupAge) and setupAge > expiryBarsWindow
    bool expired = not invalidated and (expiredUntouched or touchedStale or managedStale)

    [setupTag, nextManagedLatched, nextCompletedLatched, nextAmbiguousLatched, nextInvalidatedLatched, isManaged, isCompleted, isAmbiguous, invalidated, expired]

//------------------------------------------------------------------------------
// ENGINE 1
// Closed-candle MTF buffer + snapshot contract.
//------------------------------------------------------------------------------
string TF_M1 = "1"
string TF_M5 = "5"
string TF_M15 = "15"
string TF_M30 = "30"
string TF_H1 = "60"
string TF_H4 = "240"
string TF_D1 = "1D"
string ENG1_TF_M1 = TF_M1
string ENG1_TF_M5 = TF_M5
string ENG1_TF_M15 = TF_M15
string ENG1_TF_M30 = TF_M30
string ENG1_TF_H1 = TF_H1
string ENG1_TF_H4 = TF_H4
string ENG1_TF_D1 = TF_D1
int ENG1_BUF_CAP = freeSafeMode ? 220 : 300
int ENG1_SWING_LEN = 3
int ENG1_STRUCTURE_SCAN_CAP = freeSafeMode ? 80 : 140

// MAIN_CONTRACT order 1: resolve TF mapping.
eng1_exec_tf = timeframe.main_period
int chartSeconds = timeframe.in_seconds()
eng1_ctx_tf = na(chartSeconds) ? "" : chartSeconds == timeframe.in_seconds("1") ? "15" : chartSeconds == timeframe.in_seconds("5") ? "15" : chartSeconds == timeframe.in_seconds("15") ? "60" : chartSeconds == timeframe.in_seconds("30") ? "240" : ""
eng1_narr_tf = na(chartSeconds) ? "" : chartSeconds == timeframe.in_seconds("1") ? "60" : chartSeconds == timeframe.in_seconds("5") ? "240" : chartSeconds == timeframe.in_seconds("15") ? "240" : chartSeconds == timeframe.in_seconds("30") ? "1D" : ""
eng1_exec_valid = eng1_ctx_tf != "" and eng1_narr_tf != ""
bool eng1_m1_active_tf = eng1_exec_valid and (eng1_exec_tf == ENG1_TF_M1 or eng1_ctx_tf == ENG1_TF_M1 or eng1_narr_tf == ENG1_TF_M1)
bool eng1_m5_active_tf = eng1_exec_valid and (eng1_exec_tf == ENG1_TF_M5 or eng1_ctx_tf == ENG1_TF_M5 or eng1_narr_tf == ENG1_TF_M5)
bool eng1_m15_active_tf = eng1_exec_valid and (eng1_exec_tf == ENG1_TF_M15 or eng1_ctx_tf == ENG1_TF_M15 or eng1_narr_tf == ENG1_TF_M15)
bool eng1_m30_active_tf = eng1_exec_valid and (eng1_exec_tf == ENG1_TF_M30 or eng1_ctx_tf == ENG1_TF_M30 or eng1_narr_tf == ENG1_TF_M30)
bool eng1_h1_active_tf = eng1_exec_valid and (eng1_exec_tf == ENG1_TF_H1 or eng1_ctx_tf == ENG1_TF_H1 or eng1_narr_tf == ENG1_TF_H1)
bool eng1_h4_active_tf = eng1_exec_valid and (eng1_exec_tf == ENG1_TF_H4 or eng1_ctx_tf == ENG1_TF_H4 or eng1_narr_tf == ENG1_TF_H4)
bool eng1_d1_active_tf = eng1_exec_valid and (eng1_exec_tf == ENG1_TF_D1 or eng1_ctx_tf == ENG1_TF_D1 or eng1_narr_tf == ENG1_TF_D1)

f_eng1_buf_push_float(array<float> buf, float value, int cap) =>
    if not na(value)
        array.unshift(buf, value)
        while array.size(buf) > cap
            array.pop(buf)

f_eng1_buf_float_at(array<float> buf, int offset) =>
    int size = array.size(buf)
    offset >= 0 and size > offset ? array.get(buf, offset) : na

f_eng1_buf_int_at(array<int> buf, int offset) =>
    int size = array.size(buf)
    offset >= 0 and size > offset ? array.get(buf, offset) : na

f_eng1_tf_closed_ohlc(string tf) =>
    [t, o, h, l, c] = request.security(syminfo.tickerid, tf, [time[1], open[1], high[1], low[1], close[1]], lookahead=barmerge.lookahead_off)
    [t, o, h, l, c]

f_prev_period_high_low(bool enabled, string tf) =>
    float periodHigh = na
    float periodLow = na
    if enabled
        [requestedHigh, requestedLow] = request.security(syminfo.tickerid, tf, [high[1], low[1]], lookahead=barmerge.lookahead_off)
        periodHigh := requestedHigh
        periodLow := requestedLow
    [periodHigh, periodLow]

f_eng1_update_ohlc_buffer(bool enabled, string tf, int lastClosedTime, array<int> arrT, array<float> arrO, array<float> arrH, array<float> arrL, array<float> arrC, int cap) =>
    bool newClosed = false
    int nextLastClosedTime = lastClosedTime
    if enabled
        [closedTime, closedOpen, closedHigh, closedLow, closedClose] = f_eng1_tf_closed_ohlc(tf)
        bool closedPayloadReady = not na(closedTime) and not na(closedOpen) and not na(closedHigh) and not na(closedLow) and not na(closedClose)
        newClosed := closedPayloadReady and (na(lastClosedTime) or closedTime != lastClosedTime)
        if newClosed
            array.unshift(arrT, closedTime)
            while array.size(arrT) > cap
                array.pop(arrT)
            f_eng1_buf_push_float(arrO, closedOpen, cap)
            f_eng1_buf_push_float(arrH, closedHigh, cap)
            f_eng1_buf_push_float(arrL, closedLow, cap)
            f_eng1_buf_push_float(arrC, closedClose, cap)
            nextLastClosedTime := closedTime
    [newClosed, nextLastClosedTime]

f_eng1_avg_range(array<float> arrH, array<float> arrL, int lookback) =>
    int sample = math.min(math.min(array.size(arrH), array.size(arrL)), lookback)
    float totalRange = 0.0
    if sample > 0
        for i = 0 to sample - 1
            totalRange += math.abs(array.get(arrH, i) - array.get(arrL, i))
    sample > 0 ? totalRange / sample : na

f_eng1_time_at_idx(array<int> arrT, int idx) =>
    int size = array.size(arrT)
    bool ok = not na(idx) and idx >= 0 and idx < size
    ok ? array.get(arrT, idx) : na

f_eng1_find_swings(array<float> arrH, array<float> arrL, int swingLen) =>
    float lastHigh = na
    int lastHighIdx = na
    float prevHigh = na
    int prevHighIdx = na
    float lastLow = na
    int lastLowIdx = na
    float prevLow = na
    int prevLowIdx = na
    int size = math.min(array.size(arrH), array.size(arrL))
    int maxPivotIdx = math.min(size - 1 - swingLen, ENG1_STRUCTURE_SCAN_CAP)
    if maxPivotIdx >= swingLen
        for idx = swingLen to maxPivotIdx
            bool foundHigh = f_is_pivot_high(arrH, idx, swingLen)
            bool foundLow = f_is_pivot_low(arrL, idx, swingLen)
            if foundHigh
                if na(lastHigh)
                    lastHigh := array.get(arrH, idx)
                    lastHighIdx := idx
                else if na(prevHigh)
                    prevHigh := array.get(arrH, idx)
                    prevHighIdx := idx
            if foundLow
                if na(lastLow)
                    lastLow := array.get(arrL, idx)
                    lastLowIdx := idx
                else if na(prevLow)
                    prevLow := array.get(arrL, idx)
                    prevLowIdx := idx
            if not na(lastHigh) and not na(prevHigh) and not na(lastLow) and not na(prevLow)
                break
    [lastHigh, lastHighIdx, prevHigh, prevHighIdx, lastLow, lastLowIdx, prevLow, prevLowIdx]

f_eng1_build_structure_liquidity(array<int> arrT, array<float> arrH, array<float> arrL, array<float> arrC, int swingLen) =>
    [lastHigh, lastHighIdx, prevHigh, prevHighIdx, lastLow, lastLowIdx, prevLow, prevLowIdx] = f_eng1_find_swings(arrH, arrL, swingLen)
    int lastHighBar = f_eng1_time_at_idx(arrT, lastHighIdx)
    int lastLowBar = f_eng1_time_at_idx(arrT, lastLowIdx)

    int structureBiasLocal = 0
    int closeSize = array.size(arrC)
    if closeSize > 0
        float latestClose = array.get(arrC, 0)
        if not na(lastHigh) and latestClose > lastHigh
            structureBiasLocal := 1
        else if not na(lastLow) and latestClose < lastLow
            structureBiasLocal := -1
        else if not na(lastHigh) and not na(prevHigh) and not na(lastLow) and not na(prevLow)
            bool higherHighs = lastHigh > prevHigh
            bool higherLows = lastLow > prevLow
            bool lowerHighs = lastHigh < prevHigh
            bool lowerLows = lastLow < prevLow
            structureBiasLocal := higherHighs and higherLows ? 1 : lowerHighs and lowerLows ? -1 : 0
        else if not na(lastHigh) and not na(lastLow)
            float swingMid = (lastHigh + lastLow) * 0.5
            structureBiasLocal := latestClose > swingMid ? 1 : latestClose < swingMid ? -1 : 0

    // Liquidity pools (EQH/EQL) derived from the latest two pivots.
    float eqh = na
    float eql = na
    int eqhBar = na
    int eqlBar = na
    bool eqhActive = false
    bool eqlActive = false
    float avgRange = f_eng1_avg_range(arrH, arrL, 20)
    float tolerance = na(avgRange) ? syminfo.mintick * 2.0 : math.max(avgRange * equalToleranceAtr, syminfo.mintick * 2.0)
    if not na(lastHigh) and not na(prevHigh) and not na(lastHighIdx) and not na(prevHighIdx) and math.abs(lastHigh - prevHigh) <= tolerance
        eqh := math.max(lastHigh, prevHigh)
        int eqhAnchorIdx = math.min(lastHighIdx, prevHighIdx)
        eqhBar := f_eng1_time_at_idx(arrT, eqhAnchorIdx)
        eqhActive := true
        if eqhAnchorIdx > 0
            for i = 0 to eqhAnchorIdx - 1
                eqhActive := eqhActive and array.get(arrH, i) <= eqh
                if not eqhActive
                    break
    if not na(lastLow) and not na(prevLow) and not na(lastLowIdx) and not na(prevLowIdx) and math.abs(lastLow - prevLow) <= tolerance
        eql := math.min(lastLow, prevLow)
        int eqlAnchorIdx = math.min(lastLowIdx, prevLowIdx)
        eqlBar := f_eng1_time_at_idx(arrT, eqlAnchorIdx)
        eqlActive := true
        if eqlAnchorIdx > 0
            for i = 0 to eqlAnchorIdx - 1
                eqlActive := eqlActive and array.get(arrL, i) >= eql
                if not eqlActive
                    break

    [lastHigh, lastHighBar, lastLow, lastLowBar, structureBiasLocal, eqh, eqhBar, eql, eqlBar, eqhActive, eqlActive]

f_eng1_structure_break_signals(float lastHigh, float lastLow, int priorStructureBias, array<float> arrC) =>
    bool bullBos = false
    bool bearBos = false
    bool bullChoch = false
    bool bearChoch = false
    if array.size(arrC) > 1
        float latestClose = array.get(arrC, 0)
        float prevClose = array.get(arrC, 1)
        bullBos := not na(lastHigh) and not na(prevClose) and prevClose <= lastHigh and latestClose > lastHigh
        bearBos := not na(lastLow) and not na(prevClose) and prevClose >= lastLow and latestClose < lastLow
        bullChoch := bullBos and priorStructureBias == -1
        bearChoch := bearBos and priorStructureBias == 1
    [bullBos, bearBos, bullChoch, bearChoch]

f_eng1_window_high_safe(array<float> arrH, int lookback) =>
    int sample = math.min(array.size(arrH), lookback)
    float highest = na
    if sample > 0
        highest := array.get(arrH, 0)
        if sample > 1
            for i = 1 to sample - 1
                highest := math.max(highest, array.get(arrH, i))
    highest

f_eng1_window_low_safe(array<float> arrL, int lookback) =>
    int sample = math.min(array.size(arrL), lookback)
    float lowest = na
    if sample > 0
        lowest := array.get(arrL, 0)
        if sample > 1
            for i = 1 to sample - 1
                lowest := math.min(lowest, array.get(arrL, i))
    lowest

f_eng1_body_share(float candleOpen, float candleHigh, float candleLow, float candleClose) =>
    float candleRange = candleHigh - candleLow
    candleRange > 0 ? math.abs(candleClose - candleOpen) / candleRange : 0.0

f_eng1_break_up(float level, float candleClose) =>
    candleClose > level

f_eng1_break_down(float level, float candleClose) =>
    candleClose < level

f_eng1_segment_high(array<float> arrH, int startIdx, int endIdx) =>
    float highest = na
    int size = array.size(arrH)
    int fromIdx = math.max(0, startIdx)
    int toIdx = math.min(size - 1, endIdx)
    if size > 0 and fromIdx <= toIdx
        highest := array.get(arrH, fromIdx)
        if toIdx > fromIdx
            for i = fromIdx + 1 to toIdx
                highest := math.max(highest, array.get(arrH, i))
    highest

f_eng1_segment_low(array<float> arrL, int startIdx, int endIdx) =>
    float lowest = na
    int size = array.size(arrL)
    int fromIdx = math.max(0, startIdx)
    int toIdx = math.min(size - 1, endIdx)
    if size > 0 and fromIdx <= toIdx
        lowest := array.get(arrL, fromIdx)
        if toIdx > fromIdx
            for i = fromIdx + 1 to toIdx
                lowest := math.min(lowest, array.get(arrL, i))
    lowest

f_eng1_ob_bounds(bool isBull, float candleOpen, float candleHigh, float candleLow) =>
    float zoneTop = isBull ? candleOpen : candleHigh
    float zoneBottom = isBull ? candleLow : candleOpen
    [math.max(zoneTop, zoneBottom), math.min(zoneTop, zoneBottom)]

f_eng1_ob_entry_from_meta(float zoneTop, float zoneBottom) =>
    (zoneTop + zoneBottom) * 0.5

f_eng1_build_fvg(array<int> arrT, array<float> arrO, array<float> arrH, array<float> arrL, array<float> arrC) =>
    float bullTop = na
    float bullBottom = na
    int bullBar = na
    float bearTop = na
    float bearBottom = na
    int bearBar = na
    int size = math.min(array.size(arrT), math.min(array.size(arrO), math.min(array.size(arrH), math.min(array.size(arrL), array.size(arrC)))))
    if size >= 3
        float avgRange = f_eng1_avg_range(arrH, arrL, 20)
        float minGap = na(avgRange) ? syminfo.mintick * 4.0 : math.max(avgRange * fvgMinAtr, syminfo.mintick * 4.0)
        float displacementThreshold = na(avgRange) ? syminfo.mintick * 10.0 : math.max(avgRange * math.max(fvgMinAtr * 2.0, obImpulseAtr * 0.75), syminfo.mintick * 10.0)
        int maxRecentIdx = math.min(size - 3, 90)
        // Performance note: keep this O(n). We track running extremes of newer bars
        // instead of validating candidates with nested loops.
        float runningMinLow = na
        float runningMaxHigh = na
        for recentIdx = 0 to maxRecentIdx
            int middleIdx = recentIdx + 1
            int olderIdx = recentIdx + 2
            float recentHigh = array.get(arrH, recentIdx)
            float recentLow = array.get(arrL, recentIdx)
            float middleOpen = array.get(arrO, middleIdx)
            float middleHigh = array.get(arrH, middleIdx)
            float middleLow = array.get(arrL, middleIdx)
            float middleClose = array.get(arrC, middleIdx)
            float olderHigh = array.get(arrH, olderIdx)
            float olderLow = array.get(arrL, olderIdx)
            bool middleBullDisp = middleClose > middleOpen and middleClose > olderHigh and (middleHigh - middleLow) >= displacementThreshold and f_eng1_body_share(middleOpen, middleHigh, middleLow, middleClose) >= 0.60
            bool middleBearDisp = middleClose < middleOpen and middleClose < olderLow and (middleHigh - middleLow) >= displacementThreshold and f_eng1_body_share(middleOpen, middleHigh, middleLow, middleClose) >= 0.60
            bool bullCandidate = na(bullTop) and recentLow > olderHigh and middleBullDisp and (recentLow - olderHigh) >= minGap
            bool bearCandidate = na(bearTop) and recentHigh < olderLow and middleBearDisp and (olderLow - recentHigh) >= minGap
            if bullCandidate
                float candidateTop = recentLow
                float candidateBottom = olderHigh
                bool candidateActive = true
                if not na(runningMinLow)
                    // Keep the original FVG boundary. A partial fill is tracked
                    // by Engine 3 touch state; only a full fill retires the zone.
                    if runningMinLow <= candidateBottom
                        candidateActive := false
                if candidateActive
                    bullTop := candidateTop
                    bullBottom := candidateBottom
                    bullBar := array.get(arrT, recentIdx)
            if bearCandidate
                float candidateTop = olderLow
                float candidateBottom = recentHigh
                bool candidateActive = true
                if not na(runningMaxHigh)
                    // Keep the original FVG boundary. A partial fill is tracked
                    // by Engine 3 touch state; only a full fill retires the zone.
                    if runningMaxHigh >= candidateTop
                        candidateActive := false
                if candidateActive
                    bearTop := candidateTop
                    bearBottom := candidateBottom
                    bearBar := array.get(arrT, recentIdx)
            // Update running extremes after validating candidates.
            runningMinLow := na(runningMinLow) ? recentLow : math.min(runningMinLow, recentLow)
            runningMaxHigh := na(runningMaxHigh) ? recentHigh : math.max(runningMaxHigh, recentHigh)
            if not na(bullTop) and not na(bearTop)
                break
    [bullTop, bullBottom, bullBar, bearTop, bearBottom, bearBar]

f_eng1_build_ob(array<int> arrT, array<float> arrO, array<float> arrH, array<float> arrL, array<float> arrC) =>
    float bullTop = na
    float bullBottom = na
    float bullEntry = na
    int bullBar = na
    bool bullBreaker = false
    int bullBreakerTime = na
    float bearTop = na
    float bearBottom = na
    float bearEntry = na
    int bearBar = na
    bool bearBreaker = false
    int bearBreakerTime = na
    int size = math.min(array.size(arrT), math.min(array.size(arrO), math.min(array.size(arrH), math.min(array.size(arrL), array.size(arrC)))))
    if size >= 5
        float avgRange = f_eng1_avg_range(arrH, arrL, 20)
        float displacementThreshold = na(avgRange) ? syminfo.mintick * 10.0 : math.max(avgRange * obImpulseAtr, syminfo.mintick * 10.0)
        int searchCap = math.min(size - 2, math.min(obSearchBars + obValidationLookback + ENG1_SWING_LEN + 2, 28))
        for idx = 1 to searchCap
            float obOpen = array.get(arrO, idx)
            float obHigh = array.get(arrH, idx)
            float obLow = array.get(arrL, idx)
            float obClose = array.get(arrC, idx)
            bool bearCandle = obClose < obOpen
            bool bullCandle = obClose > obOpen
            int olderStart = idx + 1
            int olderEnd = math.min(size - 1, idx + ENG1_SWING_LEN + 2)
            float priorHigh = f_eng1_segment_high(arrH, olderStart, olderEnd)
            float priorLow = f_eng1_segment_low(arrL, olderStart, olderEnd)
            bool bullSweepSeq = not na(priorLow) and obLow < priorLow
            bool bearSweepSeq = not na(priorHigh) and obHigh > priorHigh
            // Strict/IPDA keeps the liquidity-sweep requirement. Normal mode uses
            // the standard OB definition: last opposing candle + displacement + BOS.
            bool bullObSequencePass = bearCandle and (bullSweepSeq or not strictModeEnabled)
            bool bearObSequencePass = bullCandle and (bearSweepSeq or not strictModeEnabled)
            // Notes on "breaker":
            // - A bearish OB invalidated to the upside becomes a *bullish* breaker block (bullBreaker=true).
            // - A bullish OB invalidated to the downside becomes a *bearish* breaker block (bearBreaker=true).
            // - breakerTime stores the invalidation candle, while bullBar / bearBar keep the original OB candle.
            if bullObSequencePass and (na(bullTop) or na(bearTop))
                [bullZoneTop, bullZoneBottom] = f_eng1_ob_bounds(true, obOpen, obHigh, obLow)
                bool bullDispSeen = false
                bool bullBreakSeen = false
                bool bullInvalidated = false
                int bullInvalidatedTime = na
                bool bullMitigatedAfterBreak = false
                bool bullBreakerMitigated = false
                for step = 0 to idx - 1
                    int j = idx - 1 - step
                    float newerOpen = array.get(arrO, j)
                    float newerHigh = array.get(arrH, j)
                    float newerLow = array.get(arrL, j)
                    float newerClose = array.get(arrC, j)
                    float newerRange = newerHigh - newerLow
                    if bullInvalidated
                        if j > 0 and newerHigh >= bullZoneTop
                            bullBreakerMitigated := true
                    else
                        bool newerDisp = newerClose > newerOpen and newerRange >= displacementThreshold and f_eng1_body_share(newerOpen, newerHigh, newerLow, newerClose) >= 0.60
                        if newerDisp
                            bullDispSeen := true
                        if bullDispSeen and not na(priorHigh) and f_eng1_break_up(priorHigh, newerClose)
                            bullBreakSeen := true
                        if bullBreakSeen and f_eng1_break_down(bullZoneBottom, newerClose)
                            bullInvalidated := true
                            bullInvalidatedTime := array.get(arrT, j)
                        else if bullBreakSeen and j > 0 and newerLow <= bullZoneBottom
                            bullMitigatedAfterBreak := true
                    if bullMitigatedAfterBreak or bullBreakerMitigated
                        break
                bool bullPattern = bullDispSeen and bullBreakSeen and not bullMitigatedAfterBreak
                if bullPattern
                    float bullCandidateTop = bullZoneTop
                    float bullCandidateBottom = bullZoneBottom
                    float bullCandidateEntry = f_eng1_ob_entry_from_meta(bullCandidateTop, bullCandidateBottom)
                    int bullCandidateBar = array.get(arrT, idx)
                    if bullInvalidated and not bullBreakerMitigated
                        if na(bearTop)
                            bearTop := bullCandidateTop
                            bearBottom := bullCandidateBottom
                            bearEntry := bullCandidateEntry
                            bearBar := bullCandidateBar
                            bearBreaker := true
                            bearBreakerTime := bullInvalidatedTime
                    else if not bullInvalidated
                        if na(bullTop)
                            bullTop := bullCandidateTop
                            bullBottom := bullCandidateBottom
                            bullEntry := bullCandidateEntry
                            bullBar := bullCandidateBar
                            bullBreaker := false
            if bearObSequencePass and (na(bearTop) or na(bullTop))
                [bearZoneTop, bearZoneBottom] = f_eng1_ob_bounds(false, obOpen, obHigh, obLow)
                bool bearDispSeen = false
                bool bearBreakSeen = false
                bool bearInvalidated = false
                int bearInvalidatedTime = na
                bool bearMitigatedAfterBreak = false
                bool bearBreakerMitigated = false
                for step = 0 to idx - 1
                    int j = idx - 1 - step
                    float newerOpen = array.get(arrO, j)
                    float newerHigh = array.get(arrH, j)
                    float newerLow = array.get(arrL, j)
                    float newerClose = array.get(arrC, j)
                    float newerRange = newerHigh - newerLow
                    if bearInvalidated
                        if j > 0 and newerLow <= bearZoneBottom
                            bearBreakerMitigated := true
                    else
                        bool newerDisp = newerClose < newerOpen and newerRange >= displacementThreshold and f_eng1_body_share(newerOpen, newerHigh, newerLow, newerClose) >= 0.60
                        if newerDisp
                            bearDispSeen := true
                        if bearDispSeen and not na(priorLow) and f_eng1_break_down(priorLow, newerClose)
                            bearBreakSeen := true
                        if bearBreakSeen and f_eng1_break_up(bearZoneTop, newerClose)
                            bearInvalidated := true
                            bearInvalidatedTime := array.get(arrT, j)
                        else if bearBreakSeen and j > 0 and newerHigh >= bearZoneTop
                            bearMitigatedAfterBreak := true
                    if bearMitigatedAfterBreak or bearBreakerMitigated
                        break
                bool bearPattern = bearDispSeen and bearBreakSeen and not bearMitigatedAfterBreak
                if bearPattern
                    float bearCandidateTop = bearZoneTop
                    float bearCandidateBottom = bearZoneBottom
                    float bearCandidateEntry = f_eng1_ob_entry_from_meta(bearCandidateTop, bearCandidateBottom)
                    int bearCandidateBar = array.get(arrT, idx)
                    if bearInvalidated and not bearBreakerMitigated
                        if na(bullTop)
                            bullTop := bearCandidateTop
                            bullBottom := bearCandidateBottom
                            bullEntry := bearCandidateEntry
                            bullBar := bearCandidateBar
                            bullBreaker := true
                            bullBreakerTime := bearInvalidatedTime
                    else if not bearInvalidated
                        if na(bearTop)
                            bearTop := bearCandidateTop
                            bearBottom := bearCandidateBottom
                            bearEntry := bearCandidateEntry
                            bearBar := bearCandidateBar
                            bearBreaker := false
            if not na(bullTop) and not na(bearTop)
                break
    [bullTop, bullBottom, bullEntry, bullBar, bullBreaker, bullBreakerTime, bearTop, bearBottom, bearEntry, bearBar, bearBreaker, bearBreakerTime]

f_eng1_build_execution(float lastHigh, float lastLow, array<float> arrO, array<float> arrH, array<float> arrL, array<float> arrC) =>
    bool bullSweep = false
    bool bearSweep = false
    bool bullDisplacement = false
    bool bearDisplacement = false
    bool bullMss = false
    bool bearMss = false
    // Kept as downstream MSS-reference outputs, but no longer recursive state.
    float mssHighRef = lastHigh
    float mssLowRef = lastLow
    int size = math.min(math.min(array.size(arrO), array.size(arrH)), math.min(array.size(arrL), array.size(arrC)))
    if size > 0
        float latestOpen = array.get(arrO, 0)
        float latestHigh = array.get(arrH, 0)
        float latestLow = array.get(arrL, 0)
        float latestClose = array.get(arrC, 0)
        float avgRange = f_eng1_avg_range(arrH, arrL, 20)
        float latestRange = latestHigh - latestLow
        float bodyShare = f_eng1_body_share(latestOpen, latestHigh, latestLow, latestClose)
        float displacementThreshold = na(avgRange) ? syminfo.mintick * 8.0 : math.max(avgRange * 1.10, syminfo.mintick * 8.0)
        bullSweep := not na(lastLow) and latestLow < lastLow and latestClose > lastLow
        bearSweep := not na(lastHigh) and latestHigh > lastHigh and latestClose < lastHigh
        bullDisplacement := latestClose > latestOpen and latestRange >= displacementThreshold and bodyShare >= 0.55
        bearDisplacement := latestClose < latestOpen and latestRange >= displacementThreshold and bodyShare >= 0.55
        float bullMssLevel = mssHighRef
        float bearMssLevel = mssLowRef
        float prevClose = size > 1 ? array.get(arrC, 1) : na
        bullMss := bullDisplacement and not na(bullMssLevel) and not na(prevClose) and prevClose <= bullMssLevel and f_eng1_break_up(bullMssLevel, latestClose)
        bearMss := bearDisplacement and not na(bearMssLevel) and not na(prevClose) and prevClose >= bearMssLevel and f_eng1_break_down(bearMssLevel, latestClose)
    [bullSweep, bearSweep, bullDisplacement, bearDisplacement, bullMss, bearMss, mssHighRef, mssLowRef]

// Engine 1 raw buffers
var array<int> eng1_buf_m1_time = array.new_int()
var array<float> eng1_buf_m1_open = array.new_float()
var array<float> eng1_buf_m1_high = array.new_float()
var array<float> eng1_buf_m1_low = array.new_float()
var array<float> eng1_buf_m1_close = array.new_float()
var int eng1_m1_last_closed_time = na
var bool eng1_m1_new_closed_bar = false
var array<int> eng1_buf_m5_time = array.new_int()
var array<float> eng1_buf_m5_open = array.new_float()
var array<float> eng1_buf_m5_high = array.new_float()
var array<float> eng1_buf_m5_low = array.new_float()
var array<float> eng1_buf_m5_close = array.new_float()
var int eng1_m5_last_closed_time = na
var bool eng1_m5_new_closed_bar = false
var array<int> eng1_buf_m15_time = array.new_int()
var array<float> eng1_buf_m15_open = array.new_float()
var array<float> eng1_buf_m15_high = array.new_float()
var array<float> eng1_buf_m15_low = array.new_float()
var array<float> eng1_buf_m15_close = array.new_float()
var int eng1_m15_last_closed_time = na
var bool eng1_m15_new_closed_bar = false
var array<int> eng1_buf_m30_time = array.new_int()
var array<float> eng1_buf_m30_open = array.new_float()
var array<float> eng1_buf_m30_high = array.new_float()
var array<float> eng1_buf_m30_low = array.new_float()
var array<float> eng1_buf_m30_close = array.new_float()
var int eng1_m30_last_closed_time = na
var bool eng1_m30_new_closed_bar = false
var array<int> eng1_buf_h1_time = array.new_int()
var array<float> eng1_buf_h1_open = array.new_float()
var array<float> eng1_buf_h1_high = array.new_float()
var array<float> eng1_buf_h1_low = array.new_float()
var array<float> eng1_buf_h1_close = array.new_float()
var int eng1_h1_last_closed_time = na
var bool eng1_h1_new_closed_bar = false
var array<int> eng1_buf_h4_time = array.new_int()
var array<float> eng1_buf_h4_open = array.new_float()
var array<float> eng1_buf_h4_high = array.new_float()
var array<float> eng1_buf_h4_low = array.new_float()
var array<float> eng1_buf_h4_close = array.new_float()
var int eng1_h4_last_closed_time = na
var bool eng1_h4_new_closed_bar = false
var array<int> eng1_buf_d1_time = array.new_int()
var array<float> eng1_buf_d1_open = array.new_float()
var array<float> eng1_buf_d1_high = array.new_float()
var array<float> eng1_buf_d1_low = array.new_float()
var array<float> eng1_buf_d1_close = array.new_float()
var int eng1_d1_last_closed_time = na
var bool eng1_d1_new_closed_bar = false

f_eng1_select_exec_closed_ohlc(string tf) =>
    float closedOpen = na
    float closedHigh = na
    float closedLow = na
    float closedClose = na
    float prevClosedClose = na
    if tf == ENG1_TF_M1
        closedOpen := f_eng1_buf_float_at(eng1_buf_m1_open, 0)
        closedHigh := f_eng1_buf_float_at(eng1_buf_m1_high, 0)
        closedLow := f_eng1_buf_float_at(eng1_buf_m1_low, 0)
        closedClose := f_eng1_buf_float_at(eng1_buf_m1_close, 0)
        prevClosedClose := f_eng1_buf_float_at(eng1_buf_m1_close, 1)
    else if tf == ENG1_TF_M5
        closedOpen := f_eng1_buf_float_at(eng1_buf_m5_open, 0)
        closedHigh := f_eng1_buf_float_at(eng1_buf_m5_high, 0)
        closedLow := f_eng1_buf_float_at(eng1_buf_m5_low, 0)
        closedClose := f_eng1_buf_float_at(eng1_buf_m5_close, 0)
        prevClosedClose := f_eng1_buf_float_at(eng1_buf_m5_close, 1)
    else if tf == ENG1_TF_M15
        closedOpen := f_eng1_buf_float_at(eng1_buf_m15_open, 0)
        closedHigh := f_eng1_buf_float_at(eng1_buf_m15_high, 0)
        closedLow := f_eng1_buf_float_at(eng1_buf_m15_low, 0)
        closedClose := f_eng1_buf_float_at(eng1_buf_m15_close, 0)
        prevClosedClose := f_eng1_buf_float_at(eng1_buf_m15_close, 1)
    else if tf == ENG1_TF_M30
        closedOpen := f_eng1_buf_float_at(eng1_buf_m30_open, 0)
        closedHigh := f_eng1_buf_float_at(eng1_buf_m30_high, 0)
        closedLow := f_eng1_buf_float_at(eng1_buf_m30_low, 0)
        closedClose := f_eng1_buf_float_at(eng1_buf_m30_close, 0)
        prevClosedClose := f_eng1_buf_float_at(eng1_buf_m30_close, 1)
    // Engine 1 is the closed-candle owner. Do not fall back to the active chart
    // candle here; Engine 3/4 should wait until this buffer is ready.
    bool closedReady = not na(closedOpen) and not na(closedHigh) and not na(closedLow) and not na(closedClose)
    [closedReady ? closedOpen : na, closedReady ? closedHigh : na, closedReady ? closedLow : na, closedReady ? closedClose : na, closedReady ? prevClosedClose : na, closedReady]

