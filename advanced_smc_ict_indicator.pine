        ctxLiqLow := eng1_h1_eql_active ? eng1_h1_eql : eng1_h1_last_swing_low
    else if tf == ENG1_TF_H4
        ctxTrendBias := eng1_h4_trend_bias
        ctxBullReversal := eng1_h4_bull_ob_breaker
        ctxBearReversal := eng1_h4_bear_ob_breaker
        ctxBullObTop := eng1_h4_bull_ob_top
