    runtime.error("Invalid ICT execution timeframe: " + chartTfLabel + ". Use M1, M5, M15, or M30.")

f_eng2_syncSetupZoneVisual(box currentBox, line currentLine, label currentLabel, bool enabled, int createdBar, float zoneTop, float zoneBottom, float zoneEntry, string labelText, string labelStyle, color borderColor, color fillColor, int borderWidth, bool showEntryLine, string executionState) =>
    box nextBox = currentBox
    line nextLine = currentLine
    label nextLabel = currentLabel
    if enabled and not na(zoneTop) and not na(zoneBottom)
        int leftBar = f_safeBarIndexX(not na(createdBar) ? createdBar : bar_index)
        if na(nextBox)
            nextBox := box.new(left=leftBar, top=zoneTop, right=bar_index, bottom=zoneBottom, xloc=xloc.bar_index, extend=extend.right, bgcolor=fillColor, border_color=borderColor)
        else
            box.set_left(nextBox, leftBar)
            box.set_right(nextBox, bar_index)
            box.set_top(nextBox, zoneTop)
            box.set_bottom(nextBox, zoneBottom)
            box.set_bgcolor(nextBox, fillColor)
            box.set_border_color(nextBox, borderColor)
        box.set_border_width(nextBox, borderWidth)
        if showEntryLine and not na(zoneEntry)
            if na(nextLine)
                nextLine := line.new(x1=leftBar, y1=zoneEntry, x2=bar_index, y2=zoneEntry, xloc=xloc.bar_index, extend=extend.right, color=borderColor, width=f_executionSelectedLineWidth(executionState), style=line.style_dotted)
            else
                line.set_x1(nextLine, leftBar)
                line.set_x2(nextLine, bar_index)
                line.set_y1(nextLine, zoneEntry)
                line.set_y2(nextLine, zoneEntry)
                line.set_color(nextLine, borderColor)
                line.set_width(nextLine, f_executionSelectedLineWidth(executionState))
                line.set_style(nextLine, line.style_dotted)
        else if not na(nextLine)
            line.delete(nextLine)
            nextLine := na
        if labelText != ""
            if na(nextLabel)
                nextLabel := label.new(x=bar_index, y=f_zoneMid(zoneTop, zoneBottom), xloc=xloc.bar_index, text=labelText, style=labelStyle, color=color.new(borderColor, 0), textcolor=color.white, size=size.tiny)
            else
                label.set_x(nextLabel, bar_index)
                label.set_y(nextLabel, f_zoneMid(zoneTop, zoneBottom))
                label.set_text(nextLabel, labelText)
                label.set_style(nextLabel, labelStyle)
                label.set_color(nextLabel, color.new(borderColor, 0))
                label.set_textcolor(nextLabel, color.white)
                label.set_size(nextLabel, size.tiny)
        else if not na(nextLabel)
            label.delete(nextLabel)
            nextLabel := na
    else
        if not na(nextBox)
            box.delete(nextBox)
            nextBox := na
        if not na(nextLine)
            line.delete(nextLine)
            nextLine := na
        if not na(nextLabel)
            label.delete(nextLabel)
            nextLabel := na
    [nextBox, nextLine, nextLabel]

f_eng2_syncHistoryZoneBox(box currentBox, bool enabled, int leftBar, int rightBar, float zoneTop, float zoneBottom, color borderColor, color fillColor, int borderWidth) =>
    box nextBox = currentBox
    if enabled and not na(leftBar) and not na(rightBar) and not na(zoneTop) and not na(zoneBottom)
        int safeLeftBar = f_safeBarIndexX(leftBar)
        int safeRightBar = f_safeBarIndexX(rightBar)
        if na(nextBox)
            nextBox := box.new(left=safeLeftBar, top=zoneTop, right=safeRightBar, bottom=zoneBottom, xloc=xloc.bar_index, extend=extend.none, bgcolor=fillColor, border_color=borderColor)
        else
            box.set_left(nextBox, safeLeftBar)
            box.set_right(nextBox, safeRightBar)
            box.set_top(nextBox, zoneTop)
            box.set_bottom(nextBox, zoneBottom)
            box.set_bgcolor(nextBox, fillColor)
            box.set_border_color(nextBox, borderColor)
        box.set_border_width(nextBox, borderWidth)
    else if not na(nextBox)
        box.delete(nextBox)
        nextBox := na
    nextBox

//------------------------------------------------------------------------------
// Session liquidity tracking
//------------------------------------------------------------------------------
inAsiaSession = f_inSessionWindow(asiaSessionWindow)
newAsiaSession = inAsiaSession and not inAsiaSession[1]
asiaSessionEnded = not inAsiaSession and inAsiaSession[1]
inLondonSession = f_inSessionWindow(londonSessionWindow)
newLondonSession = inLondonSession and not inLondonSession[1]
londonSessionEnded = not inLondonSession and inLondonSession[1]
inNyAmSession = f_inSessionWindow(nyAmSessionWindow)
inNyPmSession = f_inSessionWindow(nyPmSessionWindow)
inNewYorkSessionVisual = inNyAmSession or inNyPmSession
newNewYorkSessionVisual = inNewYorkSessionVisual and not inNewYorkSessionVisual[1]
newYorkSessionVisualEnded = not inNewYorkSessionVisual and inNewYorkSessionVisual[1]

var float asiaSessionHigh = na
var float asiaSessionLow = na
var float londonSessionHigh = na
var float londonSessionLow = na
var float newYorkSessionVisualHigh = na
var float newYorkSessionVisualLow = na

[asiaSessionHighNext, asiaSessionLowNext] = f_updateSessionRange(inAsiaSession, newAsiaSession, asiaSessionHigh, asiaSessionLow)
[londonSessionHighNext, londonSessionLowNext] = f_updateSessionRange(inLondonSession, newLondonSession, londonSessionHigh, londonSessionLow)
asiaSessionHigh := asiaSessionHighNext
asiaSessionLow := asiaSessionLowNext
londonSessionHigh := londonSessionHighNext
londonSessionLow := londonSessionLowNext

if newNewYorkSessionVisual
    newYorkSessionVisualHigh := high
    newYorkSessionVisualLow := low
else if inNewYorkSessionVisual
    newYorkSessionVisualHigh := na(newYorkSessionVisualHigh) ? high : math.max(newYorkSessionVisualHigh, high)
    newYorkSessionVisualLow := na(newYorkSessionVisualLow) ? low : math.min(newYorkSessionVisualLow, low)

string currentSessionBlock = inAsiaSession ? "Asia" : inLondonSession ? "London" : inNyAmSession ? "New York AM" : inNyPmSession ? "New York PM" : "Inter-session"
string liquiditySessionLabel = inLondonSession ? "Asia" : inNyAmSession ? "London" : inNyPmSession ? "New York AM" : "New York Composite"

//------------------------------------------------------------------------------
// Session range visuals
//------------------------------------------------------------------------------
bool sessionVisualsEnabled = showSessionVisuals and not compactMode and effectiveZoneDisplayMode == "Full" and timeframe.isintraday

if not sessionVisualsEnabled and array.size(sessionRangeBoxes) > 0
    f_trimSessionVisuals(0)
    activeAsiaSessionBox := na
    activeAsiaSessionLabel := na
    activeAsiaSessionHighLine := na
    activeAsiaSessionLowLine := na
    activeAsiaSessionStartBar := na
    activeLondonSessionBox := na
    activeLondonSessionLabel := na
    activeLondonSessionHighLine := na
    activeLondonSessionLowLine := na
    activeLondonSessionStartBar := na
    activeNewYorkSessionBox := na
    activeNewYorkSessionLabel := na
    activeNewYorkSessionHighLine := na
    activeNewYorkSessionLowLine := na
    activeNewYorkSessionStartBar := na

[activeAsiaSessionBoxTmp, activeAsiaSessionLabelTmp, activeAsiaSessionHighLineTmp, activeAsiaSessionLowLineTmp, activeAsiaSessionStartBarTmp] = f_eng2_syncActiveSession(sessionVisualsEnabled, inAsiaSession, newAsiaSession, asiaSessionEnded, activeAsiaSessionBox, activeAsiaSessionLabel, activeAsiaSessionHighLine, activeAsiaSessionLowLine, activeAsiaSessionStartBar, "Asia", asiaSessionHigh, asiaSessionLow)
activeAsiaSessionBox := activeAsiaSessionBoxTmp
activeAsiaSessionLabel := activeAsiaSessionLabelTmp
activeAsiaSessionHighLine := activeAsiaSessionHighLineTmp
activeAsiaSessionLowLine := activeAsiaSessionLowLineTmp
activeAsiaSessionStartBar := activeAsiaSessionStartBarTmp

[activeLondonSessionBoxTmp, activeLondonSessionLabelTmp, activeLondonSessionHighLineTmp, activeLondonSessionLowLineTmp, activeLondonSessionStartBarTmp] = f_eng2_syncActiveSession(sessionVisualsEnabled, inLondonSession, newLondonSession, londonSessionEnded, activeLondonSessionBox, activeLondonSessionLabel, activeLondonSessionHighLine, activeLondonSessionLowLine, activeLondonSessionStartBar, "London", londonSessionHigh, londonSessionLow)
activeLondonSessionBox := activeLondonSessionBoxTmp
activeLondonSessionLabel := activeLondonSessionLabelTmp
activeLondonSessionHighLine := activeLondonSessionHighLineTmp
activeLondonSessionLowLine := activeLondonSessionLowLineTmp
activeLondonSessionStartBar := activeLondonSessionStartBarTmp

[activeNewYorkSessionBoxTmp, activeNewYorkSessionLabelTmp, activeNewYorkSessionHighLineTmp, activeNewYorkSessionLowLineTmp, activeNewYorkSessionStartBarTmp] = f_eng2_syncActiveSession(sessionVisualsEnabled, inNewYorkSessionVisual, newNewYorkSessionVisual, newYorkSessionVisualEnded, activeNewYorkSessionBox, activeNewYorkSessionLabel, activeNewYorkSessionHighLine, activeNewYorkSessionLowLine, activeNewYorkSessionStartBar, "New York", newYorkSessionVisualHigh, newYorkSessionVisualLow)
activeNewYorkSessionBox := activeNewYorkSessionBoxTmp
activeNewYorkSessionLabel := activeNewYorkSessionLabelTmp
activeNewYorkSessionHighLine := activeNewYorkSessionHighLineTmp
activeNewYorkSessionLowLine := activeNewYorkSessionLowLineTmp
activeNewYorkSessionStartBar := activeNewYorkSessionStartBarTmp

if sessionVisualsEnabled and array.size(sessionRangeBoxes) > 0
    for i = 0 to array.size(sessionRangeBoxes) - 1
        sessionBox = array.get(sessionRangeBoxes, i)
        sessionLabel = array.get(sessionRangeLabels, i)
        sessionName = array.get(sessionRangeNames, i)
        sessionHighLine = array.get(sessionRangeHighLines, i)
        sessionLowLine = array.get(sessionRangeLowLines, i)
        fillColor = f_sessionFillColor(sessionName)
        borderColor = f_sessionBorderColor(sessionName)
        textColor = f_sessionTextColor(sessionName)
        highLineColor = f_sessionLineColor(sessionName, true)
        lowLineColor = f_sessionLineColor(sessionName, false)
        if not na(sessionBox)
            box.set_bgcolor(sessionBox, fillColor)
            box.set_border_color(sessionBox, borderColor)
            box.set_border_width(sessionBox, 1)
        if not na(sessionHighLine)
            line.set_x2(sessionHighLine, bar_index)
            line.set_color(sessionHighLine, highLineColor)
        if not na(sessionLowLine)
            line.set_x2(sessionLowLine, bar_index)
            line.set_color(sessionLowLine, lowLineColor)
        if not na(sessionLabel)
            label.set_text(sessionLabel, sessionName)
            label.set_textcolor(sessionLabel, textColor)
            label.set_style(sessionLabel, label.style_label_center)
            label.set_color(sessionLabel, color.new(color.black, 86))
            label.set_size(sessionLabel, size.small)

//------------------------------------------------------------------------------
// Execution liquidity (Engine 1 owned)
//------------------------------------------------------------------------------
float effectiveExecLiqHigh = eng1_exe_liq_high
float effectiveExecLiqLow = eng1_exe_liq_low
float effectiveExecEqHigh = eng1_exe_eqh_active ? eng1_exe_eqh : na
float effectiveExecEqLow = eng1_exe_eql_active ? eng1_exe_eql : na

plotshape(displaySweepMarkers and eng1_exe_bull_sweep, title="Sell-side liquidity sweep", style=shape.triangleup, location=location.belowbar, color=bullColor, size=size.tiny, text="")
plotshape(displaySweepMarkers and eng1_exe_bear_sweep, title="Buy-side liquidity sweep", style=shape.triangledown, location=location.abovebar, color=bearColor, size=size.tiny, text="")

//------------------------------------------------------------------------------
// Market structure labels (chart TF, pivot-confirmed)
// Note: Engine 1 intentionally does not output BOS/CHOCH history yet to stay lean.
// This renderer provides trader-facing HH/HL/LH/LL + BOS/MSS markers without
// coupling setup ownership to legacy pivot loops.
//------------------------------------------------------------------------------
float eng2PivotHigh = ta.pivothigh(high, structureSwingLen, structureSwingLen)
float eng2PivotLow = ta.pivotlow(low, structureSwingLen, structureSwingLen)
bool eng2BullBos = ta.crossover(close, eng2StructLastHigh)
bool eng2BearBos = ta.crossunder(close, eng2StructLastLow)
bool eng2BullMssEvent = eng1_exe_bull_mss and not eng1_exe_bull_mss[1]
bool eng2BearMssEvent = eng1_exe_bear_mss and not eng1_exe_bear_mss[1]

// Follow MAIN_CONTRACT: structure labels are Full-mode only (no clutter in Focused/Minimal).
bool eng2StructureVisualsEnabled = showMarketStructure and not compactMode and effectiveZoneDisplayMode == "Full"
int eng2StructureLabelCap = 160
float eng2StructTol = math.max(atr * equalToleranceAtr, syminfo.mintick * 2.0)

// Make the toggle literal: when disabled, clear all structure labels.
if not eng2StructureVisualsEnabled and array.size(eng2StructureLabels) > 0
    f_trimLabels(eng2StructureLabels, 0)
    eng2StructLastHigh := na
    eng2StructLastLow := na
    eng2StructHighBroken := false
    eng2StructLowBroken := false

if eng2StructureVisualsEnabled and not na(eng2PivotHigh)
    int pivotBar = f_safeBarIndexX(bar_index - structureSwingLen)
    string pivotText = na(eng2StructLastHigh) ? "H" : math.abs(eng2PivotHigh - eng2StructLastHigh) <= eng2StructTol ? "EQH" : eng2PivotHigh > eng2StructLastHigh ? "HH" : "LH"
    color pivotTextColor = pivotText == "HH" ? bullColor : pivotText == "LH" ? bearColor : color.white
    label pivotLabel = label.new(x=pivotBar, y=eng2PivotHigh, xloc=xloc.bar_index, text=pivotText, style=label.style_label_down, color=color.new(color.black, 72), textcolor=pivotTextColor, size=size.tiny)
    f_pushLabel(eng2StructureLabels, pivotLabel, eng2StructureLabelCap)
    eng2StructLastHigh := eng2PivotHigh
    eng2StructHighBroken := false

if eng2StructureVisualsEnabled and not na(eng2PivotLow)
    int pivotBar = f_safeBarIndexX(bar_index - structureSwingLen)
    string pivotText = na(eng2StructLastLow) ? "L" : math.abs(eng2PivotLow - eng2StructLastLow) <= eng2StructTol ? "EQL" : eng2PivotLow < eng2StructLastLow ? "LL" : "HL"
    color pivotTextColor = pivotText == "LL" ? bearColor : pivotText == "HL" ? bullColor : color.white
    label pivotLabel = label.new(x=pivotBar, y=eng2PivotLow, xloc=xloc.bar_index, text=pivotText, style=label.style_label_up, color=color.new(color.black, 72), textcolor=pivotTextColor, size=size.tiny)
    f_pushLabel(eng2StructureLabels, pivotLabel, eng2StructureLabelCap)
    eng2StructLastLow := eng2PivotLow
    eng2StructLowBroken := false

if eng2StructureVisualsEnabled and eng2BullMssEvent and (not na(eng1_exe_protected_high) or not na(eng2StructLastHigh))
    float mssLevel = not na(eng1_exe_protected_high) ? eng1_exe_protected_high : eng2StructLastHigh
    label mssLabel = label.new(x=bar_index, y=mssLevel, xloc=xloc.bar_index, text="MSS", style=label.style_label_left, color=color.new(bullColor, 35), textcolor=color.white, size=size.tiny)
    f_pushLabel(eng2StructureLabels, mssLabel, eng2StructureLabelCap)
else if eng2StructureVisualsEnabled and eng2BullBos and not eng2BullMssEvent and not na(eng2StructLastHigh) and not eng2StructHighBroken
    label bosLabel = label.new(x=bar_index, y=eng2StructLastHigh, xloc=xloc.bar_index, text="BOS", style=label.style_label_left, color=color.new(bullColor, 50), textcolor=color.white, size=size.tiny)
    f_pushLabel(eng2StructureLabels, bosLabel, eng2StructureLabelCap)
    eng2StructHighBroken := true

if eng2StructureVisualsEnabled and eng2BearMssEvent and (not na(eng1_exe_protected_low) or not na(eng2StructLastLow))
    float mssLevel = not na(eng1_exe_protected_low) ? eng1_exe_protected_low : eng2StructLastLow
    label mssLabel = label.new(x=bar_index, y=mssLevel, xloc=xloc.bar_index, text="MSS", style=label.style_label_left, color=color.new(bearColor, 35), textcolor=color.white, size=size.tiny)
    f_pushLabel(eng2StructureLabels, mssLabel, eng2StructureLabelCap)
else if eng2StructureVisualsEnabled and eng2BearBos and not eng2BearMssEvent and not na(eng2StructLastLow) and not eng2StructLowBroken
    label bosLabel = label.new(x=bar_index, y=eng2StructLastLow, xloc=xloc.bar_index, text="BOS", style=label.style_label_left, color=color.new(bearColor, 50), textcolor=color.white, size=size.tiny)
    f_pushLabel(eng2StructureLabels, bosLabel, eng2StructureLabelCap)
    eng2StructLowBroken := true

//------------------------------------------------------------------------------
// Higher timeframe structure context (Engine 1 owned)
//------------------------------------------------------------------------------

int displayExecBias = f_eng1_select_execution_trend_bias(eng1_exec_tf)
int displayCtxBias = eng1_ctx_trend_bias
int displayNarrBias = eng1_narr_bias

bool eng1CtxRangeReady = eng1_exec_valid and not na(eng1_ctx_liq_high) and not na(eng1_ctx_liq_low) and eng1_ctx_liq_high > eng1_ctx_liq_low
float eng1CtxRangeHigh = eng1CtxRangeReady ? eng1_ctx_liq_high : na
float eng1CtxRangeLow = eng1CtxRangeReady ? eng1_ctx_liq_low : na
float eng1CtxRangeSize = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeLow : na
float eng1CtxEquilibrium = eng1CtxRangeReady ? (eng1CtxRangeHigh + eng1CtxRangeLow) * 0.5 : na
float eng1CtxOteLongTop = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeSize * 0.62 : na
float eng1CtxOteLongBottom = eng1CtxRangeReady ? eng1CtxRangeHigh - eng1CtxRangeSize * 0.79 : na
float eng1CtxOteShortTop = eng1CtxRangeReady ? eng1CtxRangeLow + eng1CtxRangeSize * 0.79 : na
float eng1CtxOteShortBottom = eng1CtxRangeReady ? eng1CtxRangeLow + eng1CtxRangeSize * 0.62 : na

strictKillzoneActive = timeframe.isintraday and not na(time(timeframe.period, strictKillzoneSession, ictSessionTimezone))
liquiditySessionSummary = "A-ICT " + f_sessionCode(currentSessionBlock) + ">" + f_sessionCode(liquiditySessionLabel)
timezoneSummary = "NY TZ"
mtfSummary = "TF " + chartTfLabel + "/" + eng1_ctx_tf + "/" + eng1_narr_tf
float effectiveProtectedHigh = eng1_exe_protected_high
float effectiveProtectedLow = eng1_exe_protected_low
float effectiveContextHigh = eng1CtxRangeHigh
float effectiveContextLow = eng1CtxRangeLow
float effectiveRangeHigh = eng1CtxRangeReady ? eng1CtxRangeHigh : na
float effectiveRangeLow = eng1CtxRangeReady ? eng1CtxRangeLow : na
float effectiveRangeEquilibrium = eng1CtxRangeReady ? eng1CtxEquilibrium : na
float effectiveOteLongTop = eng1CtxRangeReady and eng1_narr_bias != -1 and (eng1_ctx_trend_bias == 1 or eng1_ctx_bull_reversal) ? eng1CtxOteLongTop : na
float effectiveOteLongBottom = eng1CtxRangeReady and eng1_narr_bias != -1 and (eng1_ctx_trend_bias == 1 or eng1_ctx_bull_reversal) ? eng1CtxOteLongBottom : na
float effectiveOteShortTop = eng1CtxRangeReady and eng1_narr_bias != 1 and (eng1_ctx_trend_bias == -1 or eng1_ctx_bear_reversal) ? eng1CtxOteShortTop : na
float effectiveOteShortBottom = eng1CtxRangeReady and eng1_narr_bias != 1 and (eng1_ctx_trend_bias == -1 or eng1_ctx_bear_reversal) ? eng1CtxOteShortBottom : na
bool effectiveLongOteReady = not na(effectiveOteLongTop) and not na(effectiveOteLongBottom)
bool effectiveShortOteReady = not na(effectiveOteShortTop) and not na(effectiveOteShortBottom)

//------------------------------------------------------------------------------
// ENGINE 3 (SETUP ENGINE)
// Resolve context POI, validate execution confirmations, and manage lifecycle.
//------------------------------------------------------------------------------
int eng1ContextTouchScan = math.max(expiryBarsEffective, freshBarsEffective) + strictMssLookbackEffective + 10
bool eng1BullContextAllowed = f_eng3_validate_narrative_side(true, eng1_exec_valid, eng1_narr_bias, eng1_ctx_trend_bias, eng1_ctx_bull_reversal, eng1_ctx_bear_reversal)
bool eng1BearContextAllowed = f_eng3_validate_narrative_side(false, eng1_exec_valid, eng1_narr_bias, eng1_ctx_trend_bias, eng1_ctx_bull_reversal, eng1_ctx_bear_reversal)
bool eng1HasBullObContext = eng1BullContextAllowed and not na(eng1_ctx_bull_ob_entry)
bool eng1HasBullFvgContext = eng1BullContextAllowed and not na(eng1_ctx_bull_fvg_top) and not na(eng1_ctx_bull_fvg_bottom)
bool eng1HasBearObContext = eng1BearContextAllowed and not na(eng1_ctx_bear_ob_entry)
bool eng1HasBearFvgContext = eng1BearContextAllowed and not na(eng1_ctx_bear_fvg_top) and not na(eng1_ctx_bear_fvg_bottom)
int eng1BullObCreatedBarRaw = f_timeToChartBar(eng1_ctx_bull_ob_bar)
int eng1BullFvgCreatedBarRaw = f_timeToChartBar(eng1_ctx_bull_fvg_bar)
int eng1BearObCreatedBarRaw = f_timeToChartBar(eng1_ctx_bear_ob_bar)
int eng1BearFvgCreatedBarRaw = f_timeToChartBar(eng1_ctx_bear_fvg_bar)
int eng1BullObCreatedBar = not na(eng1_ctx_bull_ob_bar) ? nz(eng1BullObCreatedBarRaw, bar_index) : na
int eng1BullFvgCreatedBar = not na(eng1_ctx_bull_fvg_bar) ? nz(eng1BullFvgCreatedBarRaw, bar_index) : na
int eng1BearObCreatedBar = not na(eng1_ctx_bear_ob_bar) ? nz(eng1BearObCreatedBarRaw, bar_index) : na
int eng1BearFvgCreatedBar = not na(eng1_ctx_bear_fvg_bar) ? nz(eng1BearFvgCreatedBarRaw, bar_index) : na
bool eng1BullObTouched = f_zoneTouchedSinceBar(eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, eng1BullObCreatedBar, eng1ContextTouchScan)
bool eng1BullFvgTouched = f_zoneTouchedSinceBar(eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, eng1BullFvgCreatedBar, eng1ContextTouchScan)
bool eng1BearObTouched = f_zoneTouchedSinceBar(eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, eng1BearObCreatedBar, eng1ContextTouchScan)
bool eng1BearFvgTouched = f_zoneTouchedSinceBar(eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, eng1BearFvgCreatedBar, eng1ContextTouchScan)

// Context POI sources (Engine 1 owned). Keep them explicit so Engine 3 never
// accidentally pulls from execution-only state.
float ctxBullObTop = eng1HasBullObContext ? eng1_ctx_bull_ob_top : na
float ctxBullObBottom = eng1HasBullObContext ? eng1_ctx_bull_ob_bottom : na
float ctxBullObEntry = eng1HasBullObContext ? eng1_ctx_bull_ob_entry : na
bool ctxBullObBreaker = eng1HasBullObContext ? eng1_ctx_bull_reversal : false
int ctxBullObCreatedBar = eng1HasBullObContext ? eng1BullObCreatedBar : na
bool ctxBullObTouched = eng1HasBullObContext ? eng1BullObTouched : false
float ctxBullFvgTop = eng1HasBullFvgContext ? eng1_ctx_bull_fvg_top : na
float ctxBullFvgBottom = eng1HasBullFvgContext ? eng1_ctx_bull_fvg_bottom : na
int ctxBullFvgCreatedBar = eng1HasBullFvgContext ? eng1BullFvgCreatedBar : na
bool ctxBullFvgTouched = eng1HasBullFvgContext ? eng1BullFvgTouched : false

float ctxBearObTop = eng1HasBearObContext ? eng1_ctx_bear_ob_top : na
float ctxBearObBottom = eng1HasBearObContext ? eng1_ctx_bear_ob_bottom : na
float ctxBearObEntry = eng1HasBearObContext ? eng1_ctx_bear_ob_entry : na
bool ctxBearObBreaker = eng1HasBearObContext ? eng1_ctx_bear_reversal : false
int ctxBearObCreatedBar = eng1HasBearObContext ? eng1BearObCreatedBar : na
bool ctxBearObTouched = eng1HasBearObContext ? eng1BearObTouched : false
float ctxBearFvgTop = eng1HasBearFvgContext ? eng1_ctx_bear_fvg_top : na
float ctxBearFvgBottom = eng1HasBearFvgContext ? eng1_ctx_bear_fvg_bottom : na
int ctxBearFvgCreatedBar = eng1HasBearFvgContext ? eng1BearFvgCreatedBar : na
bool ctxBearFvgTouched = eng1HasBearFvgContext ? eng1BearFvgTouched : false

bool hasBullOb = eng1HasBullObContext
bool hasBullFvg = eng1HasBullFvgContext
bool hasBearOb = eng1HasBearObContext
bool hasBearFvg = eng1HasBearFvgContext

bool bullObPdPass = hasBullOb and not na(effectiveRangeEquilibrium) and f_zoneMid(ctxBullObTop, ctxBullObBottom) < effectiveRangeEquilibrium
bool bullFvgPdPass = hasBullFvg and not na(effectiveRangeEquilibrium) and f_zoneMid(ctxBullFvgTop, ctxBullFvgBottom) < effectiveRangeEquilibrium
bool bearObPdPass = hasBearOb and not na(effectiveRangeEquilibrium) and f_zoneMid(ctxBearObTop, ctxBearObBottom) > effectiveRangeEquilibrium
bool bearFvgPdPass = hasBearFvg and not na(effectiveRangeEquilibrium) and f_zoneMid(ctxBearFvgTop, ctxBearFvgBottom) > effectiveRangeEquilibrium
bool bullObOtePass = hasBullOb and effectiveLongOteReady and f_zoneIntersects(ctxBullObTop, ctxBullObBottom, effectiveOteLongTop, effectiveOteLongBottom)
bool bullFvgOtePass = hasBullFvg and effectiveLongOteReady and f_zoneIntersects(ctxBullFvgTop, ctxBullFvgBottom, effectiveOteLongTop, effectiveOteLongBottom)
bool bearObOtePass = hasBearOb and effectiveShortOteReady and f_zoneIntersects(ctxBearObTop, ctxBearObBottom, effectiveOteShortTop, effectiveOteShortBottom)
bool bearFvgOtePass = hasBearFvg and effectiveShortOteReady and f_zoneIntersects(ctxBearFvgTop, ctxBearFvgBottom, effectiveOteShortTop, effectiveOteShortBottom)

bool bullObZoneConfirmPass = bullObPdPass and bullObOtePass
bool bullFvgZoneConfirmPass = bullFvgPdPass and bullFvgOtePass
bool bearObZoneConfirmPass = bearObPdPass and bearObOtePass
bool bearFvgZoneConfirmPass = bearFvgPdPass and bearFvgOtePass
bool bullFvgInZone = hasBullFvg and close >= ctxBullFvgBottom and close <= ctxBullFvgTop
bool bullObInZone = hasBullOb and close >= ctxBullObBottom and close <= ctxBullObTop
bool bearFvgInZone = hasBearFvg and close >= ctxBearFvgBottom and close <= ctxBearFvgTop
bool bearObInZone = hasBearOb and close >= ctxBearObBottom and close <= ctxBearObTop

[preferBullOb, preferBullFvg] = f_eng3_select_poi_preference(strictModeEnabled, hasBullOb, hasBullFvg, bullObZoneConfirmPass, bullFvgZoneConfirmPass, bullObInZone, bullFvgInZone)
[preferBearOb, preferBearFvg] = f_eng3_select_poi_preference(strictModeEnabled, hasBearOb, hasBearFvg, bearObZoneConfirmPass, bearFvgZoneConfirmPass, bearObInZone, bearFvgInZone)

[tradeLongEntry, tradeLongStop, tradeLongTarget, longTargetIsLiquidity, tradeLongSetup, tradeLongValidTop, tradeLongValidBottom, tradeLongIsOb, tradeLongIsFvg, tradeLongCreatedBar, tradeLongTouched] = f_eng3_build_trade_plan(true, preferBullOb, preferBullFvg, ctxBullObTop, ctxBullObBottom, ctxBullObEntry, ctxBullObBreaker, ctxBullObCreatedBar, ctxBullObTouched, ctxBullFvgTop, ctxBullFvgBottom, ctxBullFvgCreatedBar, ctxBullFvgTouched, atr, stopAtrBuffer, effectiveExecLiqHigh, effectiveExecLiqLow, effectiveExecEqHigh, effectiveExecEqLow, effectiveContextHigh, effectiveContextLow)
[tradeShortEntry, tradeShortStop, tradeShortTarget, shortTargetIsLiquidity, tradeShortSetup, tradeShortValidTop, tradeShortValidBottom, tradeShortIsOb, tradeShortIsFvg, tradeShortCreatedBar, tradeShortTouched] = f_eng3_build_trade_plan(false, preferBearOb, preferBearFvg, ctxBearObTop, ctxBearObBottom, ctxBearObEntry, ctxBearObBreaker, ctxBearObCreatedBar, ctxBearObTouched, ctxBearFvgTop, ctxBearFvgBottom, ctxBearFvgCreatedBar, ctxBearFvgTouched, atr, stopAtrBuffer, effectiveExecLiqHigh, effectiveExecLiqLow, effectiveExecEqHigh, effectiveExecEqLow, effectiveContextHigh, effectiveContextLow)

float longDolExternal = not na(tradeLongEntry) ? f_nearestAbove(tradeLongEntry, effectiveContextHigh, na, na, na, na, na, na) : na
float shortDolExternal = not na(tradeShortEntry) ? f_nearestBelow(tradeShortEntry, effectiveContextLow, na, na, na, na, na, na) : na
bool longQualifiedExternalDol = not na(longDolExternal) and not na(tradeLongEntry) and not na(tradeLongStop) and tradeLongEntry > tradeLongStop and longDolExternal - tradeLongEntry >= tradeLongEntry - tradeLongStop
bool shortQualifiedExternalDol = not na(shortDolExternal) and not na(tradeShortEntry) and not na(tradeShortStop) and tradeShortStop > tradeShortEntry and tradeShortEntry - shortDolExternal >= tradeShortStop - tradeShortEntry
bool longUsesExternalDolTarget = strictModeEnabled and longQualifiedExternalDol
bool shortUsesExternalDolTarget = strictModeEnabled and shortQualifiedExternalDol
float activeLongTarget = longUsesExternalDolTarget ? longDolExternal : tradeLongTarget
float activeShortTarget = shortUsesExternalDolTarget ? shortDolExternal : tradeShortTarget

float longRisk = not na(tradeLongEntry) and not na(tradeLongStop) ? tradeLongEntry - tradeLongStop : na
float longReward = not na(tradeLongEntry) and not na(activeLongTarget) ? activeLongTarget - tradeLongEntry : na
float longRr = not na(longRisk) and longRisk > 0 and not na(longReward) ? longReward / longRisk : na
bool longPriceInZone = not na(tradeLongValidBottom) and close >= tradeLongValidBottom and close <= tradeLongValidTop
bool longPriceNearZone = not na(tradeLongEntry) and math.abs(close - tradeLongEntry) <= atr * 0.25
int longSetupAge = not na(tradeLongCreatedBar) ? bar_index - tradeLongCreatedBar : na
bool longChased = not tradeLongTouched and not na(tradeLongValidTop) and close > tradeLongValidTop + atr * setupChaseAtr
bool effectiveLongDirectional = displayExecBias == 1
bool effectiveLongSweepSeen = eng1_exe_bull_sweep
bool effectiveLongMssSeen = eng1_exe_bull_mss
bool effectiveLongDisplacementSeen = eng1_exe_bull_displacement
bool effectiveLongStructureInvalidated = displayExecBias == -1 and ((eng1_ctx_trend_bias == -1) or eng1_ctx_bear_reversal or eng1_exe_bear_mss)
bool strictLongBiasPass = not strictModeEnabled or (displayExecBias == 1 and displayCtxBias == 1 and displayNarrBias != -1)
bool strictLongSweepPass = not strictModeEnabled or effectiveLongSweepSeen
bool strictLongMssPass = not strictModeEnabled or (effectiveLongMssSeen and effectiveLongDirectional)
bool strictLongPdPass = not strictModeEnabled or (not na(tradeLongValidTop) and not na(effectiveRangeEquilibrium) and f_zoneMid(tradeLongValidTop, tradeLongValidBottom) < effectiveRangeEquilibrium)
bool strictLongOtePass = not strictModeEnabled or (effectiveLongOteReady and f_zoneIntersects(tradeLongValidTop, tradeLongValidBottom, effectiveOteLongTop, effectiveOteLongBottom))
bool strictLongDolPass = not strictModeEnabled or longQualifiedExternalDol
bool strictLongKillzonePass = not strictModeEnabled or strictKillzoneActive
bool strictLongContextPass = strictLongBiasPass and strictLongSweepPass and strictLongMssPass and strictLongPdPass and strictLongOtePass and strictLongDolPass
bool longConfirmationPass = not strictModeEnabled or (strictLongContextPass and strictLongKillzonePass)
bool longExecutionFreshPass = effectiveLongMssSeen
var string lastLongSetupTag = ""
var bool longManagedLatched = false
var bool longCompletedLatched = false
var bool longAmbiguousLatched = false
string currentLongSetupTag = not na(tradeLongCreatedBar) ? tradeLongSetup + "|" + str.tostring(tradeLongCreatedBar) : ""
bool longManagedHit = tradeLongTouched and not na(longRisk) and high >= tradeLongEntry + longRisk * setupManagedR
bool longStopHit = not na(tradeLongStop) and low <= tradeLongStop
bool longTpHit = tradeLongTouched and not na(activeLongTarget) and high >= activeLongTarget
[nextLastLongSetupTag, nextLongManagedLatched, nextLongCompletedLatched, nextLongAmbiguousLatched, longManaged, longCompleted, longAmbiguous, longInvalidated, longExpired] = f_eng3_update_trade_lifecycle(currentLongSetupTag, lastLongSetupTag, longManagedLatched, longCompletedLatched, longAmbiguousLatched, tradeLongTouched, longManagedHit, longStopHit, longTpHit, effectiveLongStructureInvalidated, longSetupAge, expiryBarsEffective)
lastLongSetupTag := nextLastLongSetupTag
longManagedLatched := nextLongManagedLatched
longCompletedLatched := nextLongCompletedLatched
longAmbiguousLatched := nextLongAmbiguousLatched

float shortRisk = not na(tradeShortEntry) and not na(tradeShortStop) ? tradeShortStop - tradeShortEntry : na
float shortReward = not na(tradeShortEntry) and not na(activeShortTarget) ? tradeShortEntry - activeShortTarget : na
float shortRr = not na(shortRisk) and shortRisk > 0 and not na(shortReward) ? shortReward / shortRisk : na
bool shortPriceInZone = not na(tradeShortValidBottom) and close >= tradeShortValidBottom and close <= tradeShortValidTop
bool shortPriceNearZone = not na(tradeShortEntry) and math.abs(close - tradeShortEntry) <= atr * 0.25
int shortSetupAge = not na(tradeShortCreatedBar) ? bar_index - tradeShortCreatedBar : na
bool shortChased = not tradeShortTouched and not na(tradeShortValidBottom) and close < tradeShortValidBottom - atr * setupChaseAtr
bool effectiveShortDirectional = displayExecBias == -1
bool effectiveShortSweepSeen = eng1_exe_bear_sweep
bool effectiveShortMssSeen = eng1_exe_bear_mss
bool effectiveShortDisplacementSeen = eng1_exe_bear_displacement
bool effectiveShortStructureInvalidated = displayExecBias == 1 and ((eng1_ctx_trend_bias == 1) or eng1_ctx_bull_reversal or eng1_exe_bull_mss)
bool strictShortBiasPass = not strictModeEnabled or (displayExecBias == -1 and displayCtxBias == -1 and displayNarrBias != 1)
bool strictShortSweepPass = not strictModeEnabled or effectiveShortSweepSeen
bool strictShortMssPass = not strictModeEnabled or (effectiveShortMssSeen and effectiveShortDirectional)
bool strictShortPdPass = not strictModeEnabled or (not na(tradeShortValidTop) and not na(effectiveRangeEquilibrium) and f_zoneMid(tradeShortValidTop, tradeShortValidBottom) > effectiveRangeEquilibrium)
bool strictShortOtePass = not strictModeEnabled or (effectiveShortOteReady and f_zoneIntersects(tradeShortValidTop, tradeShortValidBottom, effectiveOteShortTop, effectiveOteShortBottom))
bool strictShortDolPass = not strictModeEnabled or shortQualifiedExternalDol
bool strictShortKillzonePass = not strictModeEnabled or strictKillzoneActive
bool strictShortContextPass = strictShortBiasPass and strictShortSweepPass and strictShortMssPass and strictShortPdPass and strictShortOtePass and strictShortDolPass
bool shortConfirmationPass = not strictModeEnabled or (strictShortContextPass and strictShortKillzonePass)
bool shortExecutionFreshPass = effectiveShortMssSeen
var string lastShortSetupTag = ""
var bool shortManagedLatched = false
var bool shortCompletedLatched = false
var bool shortAmbiguousLatched = false
string currentShortSetupTag = not na(tradeShortCreatedBar) ? tradeShortSetup + "|" + str.tostring(tradeShortCreatedBar) : ""
bool shortManagedHit = tradeShortTouched and not na(shortRisk) and low <= tradeShortEntry - shortRisk * setupManagedR
bool shortStopHit = not na(tradeShortStop) and high >= tradeShortStop
bool shortTpHit = tradeShortTouched and not na(activeShortTarget) and low <= activeShortTarget
[nextLastShortSetupTag, nextShortManagedLatched, nextShortCompletedLatched, nextShortAmbiguousLatched, shortManaged, shortCompleted, shortAmbiguous, shortInvalidated, shortExpired] = f_eng3_update_trade_lifecycle(currentShortSetupTag, lastShortSetupTag, shortManagedLatched, shortCompletedLatched, shortAmbiguousLatched, tradeShortTouched, shortManagedHit, shortStopHit, shortTpHit, effectiveShortStructureInvalidated, shortSetupAge, expiryBarsEffective)
lastShortSetupTag := nextLastShortSetupTag
shortManagedLatched := nextShortManagedLatched
shortCompletedLatched := nextShortCompletedLatched
shortAmbiguousLatched := nextShortAmbiguousLatched

// Keep setup scoring intentionally simple to reduce overtuning.
bool longBiasAligned = displayExecBias == 1
bool shortBiasAligned = displayExecBias == -1
bool longHtfAligned = displayCtxBias == 1 and displayNarrBias != -1
bool shortHtfAligned = displayCtxBias == -1 and displayNarrBias != 1
bool longDisplacementSeen = effectiveLongDisplacementSeen
bool shortDisplacementSeen = effectiveShortDisplacementSeen
bool longPoiConfirmPass = tradeLongIsFvg ? bullFvgZoneConfirmPass : tradeLongIsOb ? bullObZoneConfirmPass : false
bool shortPoiConfirmPass = tradeShortIsFvg ? bearFvgZoneConfirmPass : tradeShortIsOb ? bearObZoneConfirmPass : false
float contextDepartureRange = not na(effectiveRangeHigh) and not na(effectiveRangeLow) ? effectiveRangeHigh - effectiveRangeLow : na
var string lastLongQualityTag = ""
var int longResponseScoreSnapshot = 0
var int longDisplacementScoreSnapshot = 0
var int longAtrExpansionScoreSnapshot = 0
var string longQualityTierSnapshot = "-"
var string lastShortQualityTag = ""
var int shortResponseScoreSnapshot = 0
var int shortDisplacementScoreSnapshot = 0
var int shortAtrExpansionScoreSnapshot = 0
var string shortQualityTierSnapshot = "-"
if currentLongSetupTag == ""
    lastLongQualityTag := ""
    longResponseScoreSnapshot := 0
    longDisplacementScoreSnapshot := 0
    longAtrExpansionScoreSnapshot := 0
    longQualityTierSnapshot := "-"
else if currentLongSetupTag != lastLongQualityTag
    longResponseScoreSnapshot := f_zoneResponseScore(true, longPoiConfirmPass)
    longDisplacementScoreSnapshot := f_zoneDisplacementScore(longDisplacementSeen)
    longAtrExpansionScoreSnapshot := f_zoneAtrExpansionScore(contextDepartureRange, atr)
    longQualityTierSnapshot := f_zoneQualityTier(true, longResponseScoreSnapshot, longDisplacementScoreSnapshot, longAtrExpansionScoreSnapshot)
    lastLongQualityTag := currentLongSetupTag
if currentShortSetupTag == ""
    lastShortQualityTag := ""
    shortResponseScoreSnapshot := 0
    shortDisplacementScoreSnapshot := 0
    shortAtrExpansionScoreSnapshot := 0
    shortQualityTierSnapshot := "-"
else if currentShortSetupTag != lastShortQualityTag
    shortResponseScoreSnapshot := f_zoneResponseScore(true, shortPoiConfirmPass)
    shortDisplacementScoreSnapshot := f_zoneDisplacementScore(shortDisplacementSeen)
    shortAtrExpansionScoreSnapshot := f_zoneAtrExpansionScore(contextDepartureRange, atr)
    shortQualityTierSnapshot := f_zoneQualityTier(true, shortResponseScoreSnapshot, shortDisplacementScoreSnapshot, shortAtrExpansionScoreSnapshot)
    lastShortQualityTag := currentShortSetupTag
string longExecutionState = f_setupExecutionState(not na(tradeLongEntry), longAmbiguous, longInvalidated, longExpired, longChased, longCompleted, longManaged, effectiveLongDirectional and effectiveLongSweepSeen and effectiveLongMssSeen, longConfirmationPass, longExecutionFreshPass, longDisplacementSeen, longPriceInZone, longPriceNearZone)
string shortExecutionState = f_setupExecutionState(not na(tradeShortEntry), shortAmbiguous, shortInvalidated, shortExpired, shortChased, shortCompleted, shortManaged, effectiveShortDirectional and effectiveShortSweepSeen and effectiveShortMssSeen, shortConfirmationPass, shortExecutionFreshPass, shortDisplacementSeen, shortPriceInZone, shortPriceNearZone)
string longSetupDisplay = f_setupQualityText(tradeLongSetup, not na(tradeLongEntry) ? longQualityTierSnapshot : "-", not na(tradeLongEntry))
string shortSetupDisplay = f_setupQualityText(tradeShortSetup, not na(tradeShortEntry) ? shortQualityTierSnapshot : "-", not na(tradeShortEntry))

float longConfidence = f_setupScore(not na(tradeLongEntry), longBiasAligned, longHtfAligned, longPriceInZone, longPriceNearZone, longRr, longChased, longExpired, longInvalidated)

float shortConfidence = f_setupScore(not na(tradeShortEntry), shortBiasAligned, shortHtfAligned, shortPriceInZone, shortPriceNearZone, shortRr, shortChased, shortExpired, shortInvalidated)

bool longSelectedVisualActive = not f_executionTerminal(longExecutionState)
bool shortSelectedVisualActive = not f_executionTerminal(shortExecutionState)
string preferredDirection = "Wait"
bool longPreferredReady = f_executionRiskVisible(longExecutionState)
bool shortPreferredReady = f_executionRiskVisible(shortExecutionState)
bool longPriorityCandidate = not na(tradeLongEntry) and not f_dashboardRetired(longExecutionState, longSetupAge, tradeLongTouched, expiryBarsEffective)
bool shortPriorityCandidate = not na(tradeShortEntry) and not f_dashboardRetired(shortExecutionState, shortSetupAge, tradeShortTouched, expiryBarsEffective)
if longPreferredReady and not shortPreferredReady
    preferredDirection := "Long"
else if shortPreferredReady and not longPreferredReady
    preferredDirection := "Short"
else if longPreferredReady and shortPreferredReady
    preferredDirection := "Balanced"

bool compactUseLong = preferredDirection == "Long"
if preferredDirection == "Short"
    compactUseLong := false
else if preferredDirection == "Balanced"
    if longPriorityCandidate and not shortPriorityCandidate
        compactUseLong := true
    else if shortPriorityCandidate and not longPriorityCandidate
        compactUseLong := false
    else if not na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := tradeLongCreatedBar >= tradeShortCreatedBar
    else if na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := false
else
    if longPriorityCandidate and not shortPriorityCandidate
        compactUseLong := true
    else if shortPriorityCandidate and not longPriorityCandidate
        compactUseLong := false
    else if not na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := tradeLongCreatedBar >= tradeShortCreatedBar
    else if na(tradeLongCreatedBar) and not na(tradeShortCreatedBar)
        compactUseLong := false

bool eng2LongZoneTypeVisible = (tradeLongIsOb and showOb) or (tradeLongIsFvg and showFvg)
bool eng2ShortZoneTypeVisible = (tradeShortIsOb and showOb) or (tradeShortIsFvg and showFvg)
bool showEng2LongLiveZone = longSelectedVisualActive and eng2LongZoneTypeVisible and f_zoneVisibleByMode(effectiveZoneDisplayMode, compactUseLong, true, preferredDirection, compactUseLong)
bool showEng2ShortLiveZone = shortSelectedVisualActive and eng2ShortZoneTypeVisible and f_zoneVisibleByMode(effectiveZoneDisplayMode, not compactUseLong, false, preferredDirection, compactUseLong)

bool longTerminalNow = f_executionTerminal(longExecutionState)
bool shortTerminalNow = f_executionTerminal(shortExecutionState)
bool longTerminalSnapshot = longTerminalNow and currentLongSetupTag != "" and eng2LongHistoryTag != currentLongSetupTag
bool shortTerminalSnapshot = shortTerminalNow and currentShortSetupTag != "" and eng2ShortHistoryTag != currentShortSetupTag
if longTerminalSnapshot
    eng2LongHistoryTag := currentLongSetupTag
    eng2LongHistoryLeftBar := nz(tradeLongCreatedBar, bar_index)
    eng2LongHistoryRightBar := bar_index
    eng2LongHistoryTop := tradeLongValidTop
    eng2LongHistoryBottom := tradeLongValidBottom
    eng2LongHistoryIsOb := tradeLongIsOb
    eng2LongHistoryIsFvg := tradeLongIsFvg
if shortTerminalSnapshot
    eng2ShortHistoryTag := currentShortSetupTag
    eng2ShortHistoryLeftBar := nz(tradeShortCreatedBar, bar_index)
    eng2ShortHistoryRightBar := bar_index
    eng2ShortHistoryTop := tradeShortValidTop
    eng2ShortHistoryBottom := tradeShortValidBottom
    eng2ShortHistoryIsOb := tradeShortIsOb
    eng2ShortHistoryIsFvg := tradeShortIsFvg

bool historyZonesEnabled = eng1_exec_valid and (showOb or showFvg) and not compactMode and effectiveZoneDisplayMode == "Full"
bool showEng2LongHistoryZone = historyZonesEnabled and eng2LongHistoryTag != "" and not na(eng2LongHistoryTop) and not na(eng2LongHistoryBottom) and ((eng2LongHistoryIsOb and showOb) or (eng2LongHistoryIsFvg and showFvg))
bool showEng2ShortHistoryZone = historyZonesEnabled and eng2ShortHistoryTag != "" and not na(eng2ShortHistoryTop) and not na(eng2ShortHistoryBottom) and ((eng2ShortHistoryIsOb and showOb) or (eng2ShortHistoryIsFvg and showFvg))
string eng1BullContextBadge = f_executionStateBadge(longExecutionState, compactMode)
string eng1BearContextBadge = f_executionStateBadge(shortExecutionState, compactMode)
string eng1BullContextBaseLabel = tradeLongIsOb ? f_obLabelText(true, eng1_ctx_bull_reversal) : tradeLongIsFvg ? f_fvgLabelText(true) : ""
string eng1BearContextBaseLabel = tradeShortIsOb ? f_obLabelText(false, eng1_ctx_bear_reversal) : tradeShortIsFvg ? f_fvgLabelText(false) : ""
string eng1BullContextLabelText = eng1BullContextBaseLabel == "" ? "" : eng1BullContextBadge != "" ? eng1BullContextBaseLabel + " | " + eng1BullContextBadge : eng1BullContextBaseLabel
string eng1BearContextLabelText = eng1BearContextBaseLabel == "" ? "" : eng1BearContextBadge != "" ? eng1BearContextBaseLabel + " | " + eng1BearContextBadge : eng1BearContextBaseLabel
color eng1BullContextBorder = color.new(bullColor, longExecutionState == "Managed" ? 18 : 0)
color eng1BearContextBorder = color.new(bearColor, shortExecutionState == "Managed" ? 18 : 0)
color eng1BullContextFill = color.new(bullColor, f_executionSelectedFillAlpha(longExecutionState))
color eng1BearContextFill = color.new(bearColor, f_executionSelectedFillAlpha(shortExecutionState))

// Context zones (Full mode): show the snapshot OB/FVG even when no setup is selected yet.
bool eng2ContextZonesEnabled = eng1_exec_valid and (showOb or showFvg) and not compactMode and effectiveZoneDisplayMode == "Full"
bool showEng2CtxBullOb = eng2ContextZonesEnabled and showOb and not na(eng1_ctx_bull_ob_top) and not na(eng1_ctx_bull_ob_bottom) and not (showEng2LongLiveZone and tradeLongIsOb)
bool showEng2CtxBullFvg = eng2ContextZonesEnabled and showFvg and not na(eng1_ctx_bull_fvg_top) and not na(eng1_ctx_bull_fvg_bottom) and not (showEng2LongLiveZone and tradeLongIsFvg)
bool showEng2CtxBearOb = eng2ContextZonesEnabled and showOb and not na(eng1_ctx_bear_ob_top) and not na(eng1_ctx_bear_ob_bottom) and not (showEng2ShortLiveZone and tradeShortIsOb)
bool showEng2CtxBearFvg = eng2ContextZonesEnabled and showFvg and not na(eng1_ctx_bear_fvg_top) and not na(eng1_ctx_bear_fvg_bottom) and not (showEng2ShortLiveZone and tradeShortIsFvg)
string eng2CtxBullObText = "Ctx " + (eng1_ctx_bull_reversal ? "BRK+" : "OB+")
string eng2CtxBearObText = "Ctx " + (eng1_ctx_bear_reversal ? "BRK-" : "OB-")
string eng2CtxBullFvgText = "Ctx FVG+"
string eng2CtxBearFvgText = "Ctx FVG-"
color eng2CtxBullObBorder = color.new(bullColor, 40)
color eng2CtxBearObBorder = color.new(bearColor, 40)
color eng2CtxBullFvgBorder = color.new(bullColor, 55)
color eng2CtxBearFvgBorder = color.new(bearColor, 55)
color eng2CtxBullObFill = color.new(bullColor, 92)
color eng2CtxBearObFill = color.new(bearColor, 92)
color eng2CtxBullFvgFill = color.new(bullColor, 95)
color eng2CtxBearFvgFill = color.new(bearColor, 95)
[eng2CtxBullObBoxTmp, eng2CtxBullObLineTmp, eng2CtxBullObLabelTmp] = f_eng2_syncSetupZoneVisual(eng2CtxBullObBox, na, eng2CtxBullObLabel, showEng2CtxBullOb, eng1BullObCreatedBar, eng1_ctx_bull_ob_top, eng1_ctx_bull_ob_bottom, na, eng2CtxBullObText, label.style_label_right, eng2CtxBullObBorder, eng2CtxBullObFill, 1, false, "Waiting")
[eng2CtxBullFvgBoxTmp, eng2CtxBullFvgLineTmp, eng2CtxBullFvgLabelTmp] = f_eng2_syncSetupZoneVisual(eng2CtxBullFvgBox, na, eng2CtxBullFvgLabel, showEng2CtxBullFvg, eng1BullFvgCreatedBar, eng1_ctx_bull_fvg_top, eng1_ctx_bull_fvg_bottom, na, eng2CtxBullFvgText, label.style_label_right, eng2CtxBullFvgBorder, eng2CtxBullFvgFill, 1, false, "Waiting")
[eng2CtxBearObBoxTmp, eng2CtxBearObLineTmp, eng2CtxBearObLabelTmp] = f_eng2_syncSetupZoneVisual(eng2CtxBearObBox, na, eng2CtxBearObLabel, showEng2CtxBearOb, eng1BearObCreatedBar, eng1_ctx_bear_ob_top, eng1_ctx_bear_ob_bottom, na, eng2CtxBearObText, label.style_label_right, eng2CtxBearObBorder, eng2CtxBearObFill, 1, false, "Waiting")
[eng2CtxBearFvgBoxTmp, eng2CtxBearFvgLineTmp, eng2CtxBearFvgLabelTmp] = f_eng2_syncSetupZoneVisual(eng2CtxBearFvgBox, na, eng2CtxBearFvgLabel, showEng2CtxBearFvg, eng1BearFvgCreatedBar, eng1_ctx_bear_fvg_top, eng1_ctx_bear_fvg_bottom, na, eng2CtxBearFvgText, label.style_label_right, eng2CtxBearFvgBorder, eng2CtxBearFvgFill, 1, false, "Waiting")
eng2CtxBullObBox := eng2CtxBullObBoxTmp
eng2CtxBullObLabel := eng2CtxBullObLabelTmp
eng2CtxBullFvgBox := eng2CtxBullFvgBoxTmp
eng2CtxBullFvgLabel := eng2CtxBullFvgLabelTmp
eng2CtxBearObBox := eng2CtxBearObBoxTmp
eng2CtxBearObLabel := eng2CtxBearObLabelTmp
eng2CtxBearFvgBox := eng2CtxBearFvgBoxTmp
eng2CtxBearFvgLabel := eng2CtxBearFvgLabelTmp

string eng2LongLabelStyle = tradeLongIsOb ? label.style_label_right : label.style_label_left
string eng2ShortLabelStyle = tradeShortIsOb ? label.style_label_right : label.style_label_left
[eng2LongZoneBoxTmp, eng2LongZoneLineTmp, eng2LongZoneLabelTmp] = f_eng2_syncSetupZoneVisual(eng2LongZoneBox, eng2LongZoneLine, eng2LongZoneLabel, showEng2LongLiveZone, tradeLongCreatedBar, tradeLongValidTop, tradeLongValidBottom, tradeLongEntry, eng1BullContextLabelText, eng2LongLabelStyle, eng1BullContextBorder, eng1BullContextFill, 2, tradeLongIsOb, longExecutionState)
[eng2ShortZoneBoxTmp, eng2ShortZoneLineTmp, eng2ShortZoneLabelTmp] = f_eng2_syncSetupZoneVisual(eng2ShortZoneBox, eng2ShortZoneLine, eng2ShortZoneLabel, showEng2ShortLiveZone, tradeShortCreatedBar, tradeShortValidTop, tradeShortValidBottom, tradeShortEntry, eng1BearContextLabelText, eng2ShortLabelStyle, eng1BearContextBorder, eng1BearContextFill, 2, tradeShortIsOb, shortExecutionState)
eng2LongZoneBox := eng2LongZoneBoxTmp
eng2LongZoneLine := eng2LongZoneLineTmp
eng2LongZoneLabel := eng2LongZoneLabelTmp
eng2ShortZoneBox := eng2ShortZoneBoxTmp
eng2ShortZoneLine := eng2ShortZoneLineTmp
eng2ShortZoneLabel := eng2ShortZoneLabelTmp

// History boxes should stay visible, but feel lighter than the live / selected zone.
color eng2LongHistoryBorder = color.new(bullColor, 80)
color eng2ShortHistoryBorder = color.new(bearColor, 80)
color eng2LongHistoryFill = color.new(bullColor, 98)
color eng2ShortHistoryFill = color.new(bearColor, 98)
eng2LongHistoryBox := f_eng2_syncHistoryZoneBox(eng2LongHistoryBox, showEng2LongHistoryZone, eng2LongHistoryLeftBar, eng2LongHistoryRightBar, eng2LongHistoryTop, eng2LongHistoryBottom, eng2LongHistoryBorder, eng2LongHistoryFill, 1)
eng2ShortHistoryBox := f_eng2_syncHistoryZoneBox(eng2ShortHistoryBox, showEng2ShortHistoryZone, eng2ShortHistoryLeftBar, eng2ShortHistoryRightBar, eng2ShortHistoryTop, eng2ShortHistoryBottom, eng2ShortHistoryBorder, eng2ShortHistoryFill, 1)

//------------------------------------------------------------------------------
// ENGINE 2 (SAFE INTEGRATION)
// Narrative zones: supply/demand from the narrative HTF snapshot.
// Full mode only to avoid clutter on execution charts.
//------------------------------------------------------------------------------
bool eng2NarrativeZonesEnabled = eng1_exec_valid and showHtf and showOb and not compactMode and effectiveZoneDisplayMode == "Full"
int eng2NarrBullSdCreatedBarRaw = f_timeToChartBar(eng1_narr_bull_sd_bar)
int eng2NarrBearSdCreatedBarRaw = f_timeToChartBar(eng1_narr_bear_sd_bar)
int eng2NarrBullSdCreatedBar = not na(eng1_narr_bull_sd_bar) ? nz(eng2NarrBullSdCreatedBarRaw, bar_index) : na
int eng2NarrBearSdCreatedBar = not na(eng1_narr_bear_sd_bar) ? nz(eng2NarrBearSdCreatedBarRaw, bar_index) : na
string eng2NarrBullSdText = compactMode ? "SD+" : "Narr SD+"
string eng2NarrBearSdText = compactMode ? "SD-" : "Narr SD-"
color eng2NarrBullBorder = color.new(bullColor, 38)
color eng2NarrBearBorder = color.new(bearColor, 38)
color eng2NarrBullFill = color.new(bullColor, 94)
color eng2NarrBearFill = color.new(bearColor, 94)
[eng2NarrBullSdBoxTmp, eng2NarrBullSdLineTmp, eng2NarrBullSdLabelTmp] = f_eng2_syncSetupZoneVisual(eng2NarrBullSdBox, na, eng2NarrBullSdLabel, eng2NarrativeZonesEnabled, eng2NarrBullSdCreatedBar, eng1_narr_bull_sd_top, eng1_narr_bull_sd_bottom, na, eng2NarrBullSdText, label.style_label_right, eng2NarrBullBorder, eng2NarrBullFill, 1, false, "Waiting")
[eng2NarrBearSdBoxTmp, eng2NarrBearSdLineTmp, eng2NarrBearSdLabelTmp] = f_eng2_syncSetupZoneVisual(eng2NarrBearSdBox, na, eng2NarrBearSdLabel, eng2NarrativeZonesEnabled, eng2NarrBearSdCreatedBar, eng1_narr_bear_sd_top, eng1_narr_bear_sd_bottom, na, eng2NarrBearSdText, label.style_label_right, eng2NarrBearBorder, eng2NarrBearFill, 1, false, "Waiting")
eng2NarrBullSdBox := eng2NarrBullSdBoxTmp
eng2NarrBullSdLabel := eng2NarrBullSdLabelTmp
eng2NarrBearSdBox := eng2NarrBearSdBoxTmp
eng2NarrBearSdLabel := eng2NarrBearSdLabelTmp

string compactSetup = compactUseLong ? longSetupDisplay : shortSetupDisplay
string compactExecutionState = compactUseLong ? longExecutionState : shortExecutionState
float compactZoneTop = compactUseLong ? tradeLongValidTop : tradeShortValidTop
float compactZoneBottom = compactUseLong ? tradeLongValidBottom : tradeShortValidBottom
float compactEntry = compactUseLong ? tradeLongEntry : tradeShortEntry
float compactStop = compactUseLong ? tradeLongStop : tradeShortStop
float compactTarget = compactUseLong ? activeLongTarget : activeShortTarget
float compactRr = compactUseLong ? longRr : shortRr
float compactConfidence = compactUseLong ? longConfidence : shortConfidence
bool compactBalanced = preferredDirection == "Balanced"
bool compactWaiting = preferredDirection == "Wait"
bool compactNeutral = compactBalanced or compactWaiting
bool compactActionable = longPreferredReady or shortPreferredReady
bool compactContextOnly = compactNeutral and not compactActionable
bool longDashboardRetired = f_dashboardRetired(longExecutionState, longSetupAge, tradeLongTouched, expiryBarsEffective)
bool shortDashboardRetired = f_dashboardRetired(shortExecutionState, shortSetupAge, tradeShortTouched, expiryBarsEffective)
color compactAccent = compactNeutral ? color.new(neutralColor, 12) : compactUseLong ? color.new(bullColor, 12) : color.new(bearColor, 12)
bool compactCandidateHasSetup = not na(compactEntry)
bool compactCandidateRetired = compactUseLong ? longDashboardRetired : shortDashboardRetired
float bullStop = not na(tradeLongStop) ? tradeLongStop : not na(effectiveExecLiqLow) ? effectiveExecLiqLow - atr * stopAtrBuffer : na
float bearStop = not na(tradeShortStop) ? tradeShortStop : not na(effectiveExecLiqHigh) ? effectiveExecLiqHigh + atr * stopAtrBuffer : na

//------------------------------------------------------------------------------
// Zone visual policy matrix
// Fresh / live FVG, OB, Breaker:
//   Engine: keep if actionable
//   Full: show
//   Focused: show only selected active zone
//   Minimal: show only selected zone in preferred direction
// Failed OB:
//   Engine: temporary transition only
//   Full: show muted
//   Focused / Minimal: hide
// Retired FVG / deleted OB / swept EQH-EQL:
//   Engine: remove / deactivate
//   Visual: never show
// Liquidity targets:
//   Session/calendar liquidity stays engine-only
//   Chart uses session range boxes + extended H/L lines instead
// Context ranges:
//   Full / Focused: show
//   Minimal: keep only protected levels
//------------------------------------------------------------------------------
float longDashboardDol = longUsesExternalDolTarget ? longDolExternal : na
float shortDashboardDol = shortUsesExternalDolTarget ? shortDolExternal : na
primaryExternalDrawLevel = compactUseLong ? longDashboardDol : shortDashboardDol
// BSL/SSL should reflect the current execution swing liquidity (not only EQH/EQL).
targetEqHigh = f_preferredLevelMatch(effectiveExecLiqHigh, compactBalanced, compactUseLong, activeLongTarget, activeShortTarget)
targetEqLow = f_preferredLevelMatch(effectiveExecLiqLow, compactBalanced, compactUseLong, activeLongTarget, activeShortTarget)
showEqHighVisual = showLiquidity and not compactMode and f_targetVisualByMode(effectiveZoneDisplayMode, targetEqHigh)
showEqLowVisual = showLiquidity and not compactMode and f_targetVisualByMode(effectiveZoneDisplayMode, targetEqLow)
showProtectedHighVisual = showProtectedLevels and not na(effectiveProtectedHigh)
showProtectedLowVisual = showProtectedLevels and not na(effectiveProtectedLow)
showRangeVisual = showLiquidity and displayInternalRange and f_contextVisualByMode(effectiveZoneDisplayMode)
showOteVisual = strictShowOte and effectiveZoneDisplayMode != "Minimal"
oteActiveSummary = not na(effectiveOteLongTop) ? "OTE:L" : not na(effectiveOteShortTop) ? "OTE:S" : "OTE:-"
string modeStatusCore = "Eff " + effectiveZoneDisplayMode + " | " + mtfSummary + " | " + oteActiveSummary
string desktopModeStatus = modeStatusCore
string compactModeStatus = usagePreset + " | " + modeStatusCore
showHtfHighVisual = showHtf and not na(effectiveContextHigh) and f_contextVisualByMode(effectiveZoneDisplayMode)
showHtfLowVisual = showHtf and not na(effectiveContextLow) and f_contextVisualByMode(effectiveZoneDisplayMode)
showLongRiskVisual = showRisk and not compactMode and f_executionVisualByMode(effectiveZoneDisplayMode, f_executionRiskVisible(longExecutionState), preferredDirection, true, compactUseLong)
showShortRiskVisual = showRisk and not compactMode and f_executionVisualByMode(effectiveZoneDisplayMode, f_executionRiskVisible(shortExecutionState), preferredDirection, false, compactUseLong)

if effectiveZoneDisplayMode != "Full"
    showEqHighVisual := f_uniqueLevelVisual(showEqHighVisual, effectiveExecLiqHigh, showHtfHighVisual, effectiveContextHigh, false, na, false, na, false, na, false, na)
    showEqLowVisual := f_uniqueLevelVisual(showEqLowVisual, effectiveExecLiqLow, showHtfLowVisual, effectiveContextLow, false, na, false, na, false, na, false, na)

//------------------------------------------------------------------------------
// Active Levels (single-instance lines)
// Keep these non-historical to avoid scattered segments when levels update.
//------------------------------------------------------------------------------
eqHighLevel = showEqHighVisual ? effectiveExecLiqHigh : na
eqLowLevel = showEqLowVisual ? effectiveExecLiqLow : na
protectedHighLevel = showProtectedHighVisual ? effectiveProtectedHigh : na
protectedLowLevel = showProtectedLowVisual ? effectiveProtectedLow : na
internalHighLevel = showRangeVisual ? effectiveRangeHigh : na
internalLowLevel = showRangeVisual ? effectiveRangeLow : na
internalEqLevel = showRangeVisual ? effectiveRangeEquilibrium : na
htfStructureHighLevel = showHtfHighVisual ? effectiveContextHigh : na
htfStructureLowLevel = showHtfLowVisual ? effectiveContextLow : na
riskLongEntryLevel = showLongRiskVisual ? tradeLongEntry : na
riskShortEntryLevel = showShortRiskVisual ? tradeShortEntry : na
riskBullStopLevel = showLongRiskVisual ? bullStop : na
riskBearStopLevel = showShortRiskVisual ? bearStop : na
riskLongTargetLevel = showLongRiskVisual ? activeLongTarget : na
riskShortTargetLevel = showShortRiskVisual ? activeShortTarget : na
oteLongTopLevel = showOteVisual ? effectiveOteLongTop : na
oteLongBottomLevel = showOteVisual ? effectiveOteLongBottom : na
oteShortTopLevel = showOteVisual ? effectiveOteShortTop : na
oteShortBottomLevel = showOteVisual ? effectiveOteShortBottom : na
rightEdgeLabelTolerance = atr * 0.15
showShortStopRightLabel = showLiquidityRightLabels and showShortRiskVisual and not na(riskBearStopLevel)
showLongStopRightLabel = showLiquidityRightLabels and showLongRiskVisual and not na(riskBullStopLevel)
showHtfHighRightLabel = showLiquidityRightLabels and showHtfHighVisual and not f_levelsClose(htfStructureHighLevel, riskBearStopLevel, rightEdgeLabelTolerance)
showHtfLowRightLabel = showLiquidityRightLabels and showHtfLowVisual and not f_levelsClose(htfStructureLowLevel, riskBullStopLevel, rightEdgeLabelTolerance)
showProtectedHighRightLabel = showLiquidityRightLabels and showProtectedHighVisual and not f_levelsClose(protectedHighLevel, riskBearStopLevel, rightEdgeLabelTolerance) and not f_levelsClose(protectedHighLevel, htfStructureHighLevel, rightEdgeLabelTolerance)
showProtectedLowRightLabel = showLiquidityRightLabels and showProtectedLowVisual and not f_levelsClose(protectedLowLevel, riskBullStopLevel, rightEdgeLabelTolerance) and not f_levelsClose(protectedLowLevel, htfStructureLowLevel, rightEdgeLabelTolerance)
showEqHighRightLabel = showLiquidityRightLabels and showEqHighVisual and not f_levelsClose(eqHighLevel, riskBearStopLevel, rightEdgeLabelTolerance) and not f_levelsClose(eqHighLevel, protectedHighLevel, rightEdgeLabelTolerance) and not f_levelsClose(eqHighLevel, htfStructureHighLevel, rightEdgeLabelTolerance)
showEqLowRightLabel = showLiquidityRightLabels and showEqLowVisual and not f_levelsClose(eqLowLevel, riskBullStopLevel, rightEdgeLabelTolerance) and not f_levelsClose(eqLowLevel, protectedLowLevel, rightEdgeLabelTolerance) and not f_levelsClose(eqLowLevel, htfStructureLowLevel, rightEdgeLabelTolerance)
showNarrHighRightLabel = showLiquidityRightLabels and showHtf and not compactMode and effectiveZoneDisplayMode == "Full" and not na(eng1_narr_liq_high) and not f_levelsClose(eng1_narr_liq_high, htfStructureHighLevel, rightEdgeLabelTolerance) and not f_levelsClose(eng1_narr_liq_high, protectedHighLevel, rightEdgeLabelTolerance) and not f_levelsClose(eng1_narr_liq_high, eqHighLevel, rightEdgeLabelTolerance)
showNarrLowRightLabel = showLiquidityRightLabels and showHtf and not compactMode and effectiveZoneDisplayMode == "Full" and not na(eng1_narr_liq_low) and not f_levelsClose(eng1_narr_liq_low, htfStructureLowLevel, rightEdgeLabelTolerance) and not f_levelsClose(eng1_narr_liq_low, protectedLowLevel, rightEdgeLabelTolerance) and not f_levelsClose(eng1_narr_liq_low, eqLowLevel, rightEdgeLabelTolerance)

if barstate.islast
    // Lines (single instance per level)
    eng2BslLine := f_syncHLine(eng2BslLine, eqHighLevel, color.new(liqHighColor, 12), 1, line.style_solid, showEqHighVisual)
    eng2SslLine := f_syncHLine(eng2SslLine, eqLowLevel, color.new(liqLowColor, 12), 1, line.style_solid, showEqLowVisual)
    eng2ProtectedHighLine := f_syncHLine(eng2ProtectedHighLine, protectedHighLevel, color.new(liqHighColor, 8), 2, line.style_solid, showProtectedHighVisual)
    eng2ProtectedLowLine := f_syncHLine(eng2ProtectedLowLine, protectedLowLevel, color.new(liqLowColor, 8), 2, line.style_solid, showProtectedLowVisual)
    eng2CtxHighLine := f_syncHLine(eng2CtxHighLine, htfStructureHighLevel, color.new(color.fuchsia, 15), 2, line.style_solid, showHtfHighVisual)
    eng2CtxLowLine := f_syncHLine(eng2CtxLowLine, htfStructureLowLevel, color.new(color.fuchsia, 15), 2, line.style_solid, showHtfLowVisual)

    eng2RangeHighLine := f_syncHLine(eng2RangeHighLine, internalHighLevel, color.new(color.silver, 35), 1, line.style_solid, showRangeVisual)
    eng2RangeLowLine := f_syncHLine(eng2RangeLowLine, internalLowLevel, color.new(color.silver, 35), 1, line.style_solid, showRangeVisual)
    eng2RangeEqLine := f_syncHLine(eng2RangeEqLine, internalEqLevel, decisionEqColor, 2, line.style_solid, showRangeVisual)
    eng2RangePremiumFill := f_syncLineFill(eng2RangePremiumFill, eng2RangeHighLine, eng2RangeEqLine, decisionPremiumFillColor, showRangeVisual)
    eng2RangeDiscountFill := f_syncLineFill(eng2RangeDiscountFill, eng2RangeEqLine, eng2RangeLowLine, decisionDiscountFillColor, showRangeVisual)

    eng2OteLongTopLine := f_syncHLine(eng2OteLongTopLine, oteLongTopLevel, color.new(bullColor, 40), 1, line.style_solid, showOteVisual)
    eng2OteLongBottomLine := f_syncHLine(eng2OteLongBottomLine, oteLongBottomLevel, color.new(bullColor, 40), 1, line.style_solid, showOteVisual)
    eng2OteLongFill := f_syncLineFill(eng2OteLongFill, eng2OteLongTopLine, eng2OteLongBottomLine, color.new(bullColor, 92), showOteVisual)
    eng2OteShortTopLine := f_syncHLine(eng2OteShortTopLine, oteShortTopLevel, color.new(bearColor, 40), 1, line.style_solid, showOteVisual)
    eng2OteShortBottomLine := f_syncHLine(eng2OteShortBottomLine, oteShortBottomLevel, color.new(bearColor, 40), 1, line.style_solid, showOteVisual)
    eng2OteShortFill := f_syncLineFill(eng2OteShortFill, eng2OteShortTopLine, eng2OteShortBottomLine, color.new(bearColor, 92), showOteVisual)

    eng2RiskLongEntryLine := f_syncHLine(eng2RiskLongEntryLine, riskLongEntryLevel, color.new(bullColor, 0), 2, line.style_solid, showLongRiskVisual)
    eng2RiskShortEntryLine := f_syncHLine(eng2RiskShortEntryLine, riskShortEntryLevel, color.new(bearColor, 0), 2, line.style_solid, showShortRiskVisual)
    eng2RiskLongStopLine := f_syncHLine(eng2RiskLongStopLine, riskBullStopLevel, color.new(bearColor, 0), 1, line.style_solid, showLongRiskVisual)
    eng2RiskShortStopLine := f_syncHLine(eng2RiskShortStopLine, riskBearStopLevel, color.new(bullColor, 0), 1, line.style_solid, showShortRiskVisual)
    eng2RiskLongTargetLine := f_syncHLine(eng2RiskLongTargetLine, riskLongTargetLevel, color.new(liqHighColor, 0), 1, line.style_solid, showLongRiskVisual)
    eng2RiskShortTargetLine := f_syncHLine(eng2RiskShortTargetLine, riskShortTargetLevel, color.new(liqLowColor, 0), 1, line.style_solid, showShortRiskVisual)

    // Right-edge labels
    eqHighLabel := f_syncRightEdgeLabel(eqHighLabel, eqHighLevel, "BSL", color.new(liqHighColor, 12), color.white, showEqHighRightLabel)
    eqLowLabel := f_syncRightEdgeLabel(eqLowLabel, eqLowLevel, "SSL", color.new(liqLowColor, 12), color.white, showEqLowRightLabel)
    protectedHighLabel := f_syncRightEdgeLabel(protectedHighLabel, protectedHighLevel, "Prot H", color.new(liqHighColor, 8), color.white, showProtectedHighRightLabel)
    protectedLowLabel := f_syncRightEdgeLabel(protectedLowLabel, protectedLowLevel, "Prot L", color.new(liqLowColor, 8), color.white, showProtectedLowRightLabel)
    htfHighLabel := f_syncRightEdgeLabel(htfHighLabel, htfStructureHighLevel, "Ctx H", color.new(color.fuchsia, 15), color.white, showHtfHighRightLabel)
    htfLowLabel := f_syncRightEdgeLabel(htfLowLabel, htfStructureLowLevel, "Ctx L", color.new(color.fuchsia, 15), color.white, showHtfLowRightLabel)
    eng2NarrHighLabel := f_syncRightEdgeLabel(eng2NarrHighLabel, eng1_narr_liq_high, "Nar H", color.new(color.silver, 55), color.white, showNarrHighRightLabel)
    eng2NarrLowLabel := f_syncRightEdgeLabel(eng2NarrLowLabel, eng1_narr_liq_low, "Nar L", color.new(color.silver, 55), color.white, showNarrLowRightLabel)
    longStopLabel := f_syncRightEdgeLabel(longStopLabel, riskBullStopLevel, "SL L", color.new(bearColor, 0), color.white, showLongStopRightLabel)
    shortStopLabel := f_syncRightEdgeLabel(shortStopLabel, riskBearStopLevel, "SL S", color.new(bullColor, 0), color.white, showShortStopRightLabel)

// Bias tint should follow the MTF narrative chain: Narrative -> Context -> Execution.
int backdropBias = displayNarrBias != 0 ? displayNarrBias : (eng1CtxRangeReady and displayCtxBias != 0 ? displayCtxBias : displayExecBias)
color backdropColor = backdropBias == 1 ? bullColor : backdropBias == -1 ? bearColor : neutralColor
// Keep bias tint subtle so it doesn't overpower zones/candles.
int backdropAlpha = backdropBias == 0 ? 95 : 92
chartBackdrop = showTrendBackground and not compactMode ? color.new(backdropColor, backdropAlpha) : na
bgcolor(chartBackdrop)

//------------------------------------------------------------------------------
// Dashboard
//------------------------------------------------------------------------------
var table dashboard = table.new(position.top_right, 4, 15, border_width=1)
var table dashboardCompact = table.new(position.bottom_right, 2, 11, border_width=1)

if barstate.islast and showDashboard and not compactDashboardMode
    table.clear(dashboardCompact, 0, 0, 1, 10)
    f_setCell(dashboard, 0, 0, "Field", color.white, panelHeaderBg)
    f_setCell(dashboard, 1, 0, "Market", color.white, panelHeaderBg)
    f_setCell(dashboard, 2, 0, "Long", color.white, color.new(bullColor, 5))
    f_setCell(dashboard, 3, 0, "Short", color.white, color.new(bearColor, 5))

    f_setCell(dashboard, 0, 1, "Exec", color.white, panelCellBg)
    f_setCell(dashboard, 1, 1, "Px " + f_formatLevel(close), color.white, panelCellBg)
    f_setCell(dashboard, 2, 1, longExecutionState, color.white, panelBullBg)
    f_setCell(dashboard, 3, 1, shortExecutionState, color.white, panelBearBg)

    f_setCell(dashboard, 0, 2, "Bias", color.white, panelCellBg)
    f_setCell(dashboard, 1, 2, f_biasSummary(displayExecBias, eng1CtxRangeReady, displayCtxBias, displayNarrBias, eng1_exec_valid ? eng1_narr_strength : "Flat"), color.white, panelCellBg)
    f_setCell(dashboard, 2, 2, (eng1CtxRangeReady ? f_alignmentShortText(true, displayExecBias, displayCtxBias) : "G") + " / " + f_regimeSideShortText(true, displayNarrBias, eng1_exec_valid ? eng1_narr_strength : "Flat"), color.white, panelBullBg)
    f_setCell(dashboard, 3, 2, (eng1CtxRangeReady ? f_alignmentShortText(false, displayExecBias, displayCtxBias) : "G") + " / " + f_regimeSideShortText(false, displayNarrBias, eng1_exec_valid ? eng1_narr_strength : "Flat"), color.white, panelBearBg)

    f_setCell(dashboard, 0, 3, "Pref", color.white, panelCellBg)
    f_setCell(dashboard, 1, 3, f_preferredExecutionText(preferredDirection, longExecutionState, shortExecutionState, false), color.white, color.new(preferredDirection == "Long" ? bullColor : preferredDirection == "Short" ? bearColor : neutralColor, 15))
    f_setCell(dashboard, 2, 3, f_dashboardSetupText(longSetupDisplay, longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 3, f_dashboardSetupText(shortSetupDisplay, shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 4, "Z / E", color.white, panelCellBg)
    f_setCell(dashboard, 1, 4, "POI | trig", color.white, panelCellBg)
    f_setCell(dashboard, 2, 4, f_dashboardDetail(f_formatRange(tradeLongValidTop, tradeLongValidBottom) + " | " + f_formatLevel(tradeLongEntry), longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 4, f_dashboardDetail(f_formatRange(tradeShortValidTop, tradeShortValidBottom) + " | " + f_formatLevel(tradeShortEntry), shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 5, "SL / TP", color.white, panelCellBg)
    f_setCell(dashboard, 1, 5, f_dashboardMarketSummary(f_targetModeText(not na(activeLongTarget), longUsesExternalDolTarget, longTargetIsLiquidity), longDashboardRetired, f_targetModeText(not na(activeShortTarget), shortUsesExternalDolTarget, shortTargetIsLiquidity), shortDashboardRetired), color.white, panelCellBg)
    f_setCell(dashboard, 2, 5, f_dashboardDetail(f_formatLevel(tradeLongStop) + " | " + f_formatLevel(activeLongTarget), longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 5, f_dashboardDetail(f_formatLevel(tradeShortStop) + " | " + f_formatLevel(activeShortTarget), shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 6, "RR / Cf", color.white, panelCellBg)
    f_setCell(dashboard, 1, 6, "RR | conf", color.white, panelCellBg)
    f_setCell(dashboard, 2, 6, f_dashboardDetail(f_formatRr(longRr) + " | " + f_formatPercent(longConfidence), longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 6, f_dashboardDetail(f_formatRr(shortRr) + " | " + f_formatPercent(shortConfidence), shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 7, "Draw", color.white, panelCellBg)
    f_setCell(dashboard, 1, 7, "DOL", color.white, panelCellBg)
    f_setCell(dashboard, 2, 7, f_dashboardDetail(f_formatLevel(longDashboardDol), longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 7, f_dashboardDetail(f_formatLevel(shortDashboardDol), shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 8, "Life", color.white, panelCellBg)
    f_setCell(dashboard, 1, 8, "Age / touch", color.white, panelCellBg)
    f_setCell(dashboard, 2, 8, f_dashboardLifeText(f_lifecycleText(longSetupAge, tradeLongTouched), longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 8, f_dashboardLifeText(f_lifecycleText(shortSetupAge, tradeShortTouched), shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 9, "Sess/Cfm", color.white, panelCellBg)
    f_setCell(dashboard, 1, 9, liquiditySessionSummary + " | " + timezoneSummary + (strictModeEnabled ? " | Strict" : ""), color.white, color.new(strictModeEnabled ? color.teal : neutralColor, 15))
    f_setCell(dashboard, 2, 9, f_dashboardContextText(not na(tradeLongEntry) ? f_confirmationStateText(strictModeEnabled, strictLongSweepPass, strictLongMssPass, strictLongPdPass, strictLongOtePass, strictLongDolPass, strictLongKillzonePass, false) + " | " + f_setupPathText(true, tradeLongIsFvg, tradeLongIsOb, longUsesExternalDolTarget, false) : "-", longExecutionState, longDashboardRetired), color.white, panelBullBg)
    f_setCell(dashboard, 3, 9, f_dashboardContextText(not na(tradeShortEntry) ? f_confirmationStateText(strictModeEnabled, strictShortSweepPass, strictShortMssPass, strictShortPdPass, strictShortOtePass, strictShortDolPass, strictShortKillzonePass, false) + " | " + f_setupPathText(true, tradeShortIsFvg, tradeShortIsOb, shortUsesExternalDolTarget, false) : "-", shortExecutionState, shortDashboardRetired), color.white, panelBearBg)

    f_setCell(dashboard, 0, 10, "Next", color.white, panelCellBg)
    f_setCell(dashboard, 1, 10, desktopModeStatus, color.white, panelCellBg)
    f_setCell(dashboard, 2, 10, not na(tradeLongEntry) ? f_entryActionText(longExecutionState) : f_eng1EntryActionText(effectiveLongDirectional, effectiveLongDirectional and effectiveLongSweepSeen and effectiveLongMssSeen and effectiveLongDisplacementSeen, true), color.white, panelBullBg)
    f_setCell(dashboard, 3, 10, not na(tradeShortEntry) ? f_entryActionText(shortExecutionState) : f_eng1EntryActionText(effectiveShortDirectional, effectiveShortDirectional and effectiveShortSweepSeen and effectiveShortMssSeen and effectiveShortDisplacementSeen, false), color.white, panelBearBg)
else if barstate.islast and showDashboard and compactDashboardMode
    table.clear(dashboard, 0, 0, 3, 10)
    f_setCell(dashboardCompact, 0, 0, "SMC Compact", color.white, panelHeaderBg)
    f_setCell(dashboardCompact, 1, 0, f_preferredExecutionText(preferredDirection, longExecutionState, shortExecutionState, true), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 1, "Biases", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 1, f_biasShort(displayExecBias) + "/" + (eng1CtxRangeReady ? f_biasShort(displayCtxBias) : "Guard") + "/" + f_biasShort(displayNarrBias), color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 2, "Setup", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 2, compactBalanced ? "Both active" : compactWaiting and compactExecutionState == "Ambiguous" ? (compactUseLong ? f_dashboardSetupText(compactSetup, longDashboardRetired) : f_dashboardSetupText(compactSetup, shortDashboardRetired)) + " | Ambg" : compactWaiting and compactContextOnly and compactCandidateHasSetup and not compactCandidateRetired ? (compactUseLong ? f_dashboardSetupText(compactSetup, longDashboardRetired) : f_dashboardSetupText(compactSetup, shortDashboardRetired)) + " | Ctx" : compactWaiting ? "Scan both" : compactUseLong ? f_dashboardSetupText(compactSetup, longDashboardRetired) : f_dashboardSetupText(compactSetup, shortDashboardRetired), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 3, "Zone", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 3, compactNeutral ? "-" : compactUseLong ? f_dashboardDetail(f_formatRange(compactZoneTop, compactZoneBottom), longDashboardRetired) : f_dashboardDetail(f_formatRange(compactZoneTop, compactZoneBottom), shortDashboardRetired), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 4, "E / SL / TP", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 4, compactNeutral ? "-" : compactUseLong ? f_dashboardDetail(f_formatLevel(compactEntry) + " | " + f_formatLevel(compactStop) + " | " + f_formatLevel(compactTarget), longDashboardRetired) : f_dashboardDetail(f_formatLevel(compactEntry) + " | " + f_formatLevel(compactStop) + " | " + f_formatLevel(compactTarget), shortDashboardRetired), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 5, "Exec", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 5, compactBalanced ? "Mixed" : compactWaiting and compactExecutionState == "Ambiguous" ? f_executionStateCompact(compactExecutionState) : compactWaiting and compactContextOnly and compactCandidateHasSetup and not compactCandidateRetired ? "Ctx" : compactWaiting ? "Scan" : f_executionStateCompact(compactExecutionState), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 6, compactNeutral ? (compactContextOnly ? "Ctx L/S" : "Conf L/S") : "Conf", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 6, compactNeutral ? "L " + f_dashboardDetail(f_formatPercent(longConfidence), longDashboardRetired) + " / S " + f_dashboardDetail(f_formatPercent(shortConfidence), shortDashboardRetired) : compactUseLong ? f_dashboardDetail(f_formatPercent(compactConfidence), longDashboardRetired) : f_dashboardDetail(f_formatPercent(compactConfidence), shortDashboardRetired), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 7, "R / DOL", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 7, compactNeutral ? "-" : compactUseLong ? f_dashboardDetail(f_formatRr(compactRr) + " | " + f_formatLevel(primaryExternalDrawLevel), longDashboardRetired) : f_dashboardDetail(f_formatRr(compactRr) + " | " + f_formatLevel(primaryExternalDrawLevel), shortDashboardRetired), color.white, compactAccent)
    f_setCell(dashboardCompact, 0, 8, "Life", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 8, compactBalanced ? "Mixed" : compactWaiting and compactContextOnly and compactCandidateHasSetup and not compactCandidateRetired ? (compactUseLong ? f_dashboardLifeText(f_compactLifecycleText(compactUseLong, longSetupAge, tradeLongTouched, shortSetupAge, tradeShortTouched), longDashboardRetired) : f_dashboardLifeText(f_compactLifecycleText(compactUseLong, longSetupAge, tradeLongTouched, shortSetupAge, tradeShortTouched), shortDashboardRetired)) : compactWaiting ? "Scan" : compactUseLong ? f_dashboardLifeText(f_compactLifecycleText(compactUseLong, longSetupAge, tradeLongTouched, shortSetupAge, tradeShortTouched), longDashboardRetired) : f_dashboardLifeText(f_compactLifecycleText(compactUseLong, longSetupAge, tradeLongTouched, shortSetupAge, tradeShortTouched), shortDashboardRetired), color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 9, "Mode", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 9, compactModeStatus, color.white, panelCellBg)
    f_setCell(dashboardCompact, 0, 10, "Sessions", color.white, panelCellBg)
    f_setCell(dashboardCompact, 1, 10, liquiditySessionSummary + " | " + timezoneSummary + (strictModeEnabled ? " | Strict" : ""), color.white, panelCellBg)
else if barstate.islast and not showDashboard
    table.clear(dashboardCompact, 0, 0, 1, 10)
    table.clear(dashboard, 0, 0, 3, 14)
