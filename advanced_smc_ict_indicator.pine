    eng1_ctx_bear_ob_breaker_time := array.get(eng1_ctx_bear_ob_breaker_time_by_tf, 4)
    eng1_ctx_bull_ob_top := eng1_d1_bull_ob_top
    eng1_ctx_bull_ob_bottom := eng1_d1_bull_ob_bottom
